                                    {
                                        "decimalPlaces": 0
                                    }
                                ],
                                "name": "value"
                            },
                            {
                                "shape": [
                                    "state",
                                    {
                                        "map": {
                                            "warning": [
                                                "Moderately Vulnerable"
                                            ],
                                            "unmonitored": [],
                                            "error": [
                                                "Highly Vulnerable"
                                            ],
                                            "success": [
