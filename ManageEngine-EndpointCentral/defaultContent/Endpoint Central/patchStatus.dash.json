                    "_type": "tile/data-stream",
                    "description": "KPI is 95%",
                    "monitor": {
                        "tileRollsUp": true,
                        "monitorType": "threshold",
                        "condition": {
                            "columns": [
                                "percent_not_missing_critical"
                            ],
                            "logic": {
                                "if": [
                                    {
                                        "<": [
                                            {
                                                "var": "top"
                                            },
                                            90
                                        ]
                                    },
                                    "error",
                                    {
                                        "<": [
                                            {
                                                "var": "top"
                                            },
                                            95
                                        ]
                                    },
                                    "warning"
                                ]
                            }
                        },
                        "_type": "simple",
                        "column": "percent_not_missing_critical",
                        "aggregation": "top",
                        "groupBy": "__group_by_none__",
                        "frequency": 5
