                            "sql": "SELECT \r\n\r\n\r\n    ROUND(\r\n        (\r\n            (\"system_summary.total_systems\" \r\n             - \"missing_patch_severity_summary.critical_count\")::DOUBLE\r\n            / \"system_summary.total_systems\"::DOUBLE\r\n        ) * 100,\r\n        0\r\n    ) AS percent_not_missing_critical\r\nFROM dataset1;"
                        },
                        "metadata": [
