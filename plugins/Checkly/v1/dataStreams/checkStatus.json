{
    "name": "checkStatus",
    "displayName": "Summary – Status",
    "tags": [
        "Summary"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "paging": {},
        "expandInnerObjects": true,
        "endpointPath": "check-statuses",
        "getArgs": [],
        "headers": []
    },
    "metadata": [
        {
            "shape": "string",
            "name": "name",
            "sourceId": "checkId",
            "sourceType": "check"
        },
        {
            "shape": "string",
            "name": "checkId"
        },
        {
            "name": "status",
            "valueExpression": "{{ $['isDegraded'] ? 'error' : 'success' }}",
            "shape": [
                "state",
                {
                    "map": {
                        "warning": [],
                        "unmonitored": [],
                        "error": [],
                        "success": [],
                        "unknown": []
                    }
                }
            ],
            "computed": true,
            "displayName": "Status"
        },
        {
            "pattern": ".*"
        }
    ],
    "timeframes": false
}