{
    "name": "availableMetrics",
    "displayName": "Available Metrics",
    "baseDataSourceName": "httpRequestUnscoped",
    "tags": [
        "Advanced"
    ],
    "ui": [
        {
            "type": "autocomplete",
            "name": "checkType",
            "label": "Check Type",
            "validation": {
                "required": true
            },
            "allowCustomValues": false,
            "isMulti": false,
            "data": {
                "source": "fixed",
                "values": [
                    {
                        "value": "API"
                    },
                    {
                        "value": "BROWSER"
                    },
                    {
                        "value": "HEARTBEAT"
                    },
                    {
                        "value": "ICMP"
                    },
                    {
                        "value": "MULTI_STEP"
                    },
                    {
                        "value": "TCP"
                    },
                    {
                        "value": "PLAYWRIGHT"
                    },
                    {
                        "value": "URL"
                    },
                    {
                        "value": "DNS"
                    }
                ]
            }
        }
    ]
    ,
    "config": {
        "httpMethod": "get",
        "paging": {
            "mode": "none"
        },
        "expandInnerObjects": true,
        "endpointPath": "analytics/metrics",
        "getArgs": [
            {
                "key": "checkType",
                "value": "{{checkType}}"
            }
        ],
        "headers": []
    },
    "metadata": [
        {
            "role": "value",
            "shape": "string",
            "name": "name"
        },
        {
            "pattern": ".*"
        }
    ],
    "timeframes": false,
    "visibility": {
        "type": "hidden"
    }
}