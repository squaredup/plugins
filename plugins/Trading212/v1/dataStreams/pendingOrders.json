            "displayName": "Instrument Currency",
            "shape": "string"
        },
        {
            "name": "type",
            "displayName": "Order Type",
            "shape": "string"
        },
        {
            "name": "side",
            "displayName": "Side",
            "shape": "string"
        },
        {
            "name": "status",
            "displayName": "Status",
