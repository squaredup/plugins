{
    "name": "regionEstimates",
    "displayName": "Region Estimates",
    "description": "Estimated annual sustainability metrics per cloud region, trended from provider-disclosed data",
    "tags": [
        "Sustainability",
        "Cloud"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "Cloud_Region_Metadata_estimate.csv",
        "paging": {
            "mode": "none"
        },
        "postRequestScript": "regionEstimates.js"
    },
    "matches": "none",
    "ui": [
        {
            "type": "objects",
            "name": "region",
            "label": "Cloud region (optional)",
            "matches": {
                "sourceType": {
                    "type": "oneOf",
                    "values": [
                        "Cloud Region"
                    ]
                }
            }
        }
    ],
    "metadata": [
        {
            "name": "year",
            "displayName": "Year",
            "shape": [
                "number",
                {
                    "thousandsSeparator": false
                }
            ]
        },
        {
            "name": "regionId",
            "displayName": "Region ID",
            "shape": "string",
            "visible": false
        },
        {
            "sourceId": "regionId",
            "sourceType": "Cloud Region",
            "name": "region"
        },
        {
            "name": "region",
            "displayName": "Region",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "provider",
            "displayName": "Provider",
            "shape": "string"
        },
        {
            "name": "location",
            "displayName": "Location",
            "shape": "string"
        },
        {
            "name": "cfeRegion",
            "displayName": "CFE Region",
            "shape": "string"
        },
        {
            "name": "emZoneId",
            "displayName": "Electricity Maps Zone",
            "shape": "string"
        },
        {
            "name": "wtRegionId",
            "displayName": "WattTime Region",
            "shape": "string"
        },
        {
            "name": "latitude",
            "displayName": "Latitude",
            "shape": [
                "number",
                {
                    "decimalPlaces": 4
                }
            ]
        },
        {
            "name": "longitude",
            "displayName": "Longitude",
            "shape": [
                "number",
                {
                    "decimalPlaces": 4
                }
            ]
        },
        {
            "name": "providerCfeHourly",
            "displayName": "Provider CFE (hourly)",
            "shape": [
                "percent",
                {
                    "asZeroToOne": true,
                    "decimalPlaces": 1
                }
            ]
        },
        {
            "name": "providerCfeAnnual",
            "displayName": "Provider CFE (annual)",
            "shape": [
                "percent",
                {
                    "asZeroToOne": true,
                    "decimalPlaces": 1
                }
            ]
        },
        {
            "name": "pue",
            "displayName": "PUE",
            "shape": [
                "number",
                {
                    "decimalPlaces": 2
                }
            ],
            "role": "value"
        },
        {
            "name": "wue",
            "displayName": "WUE (L/kWh)",
            "shape": [
                "number",
                {
                    "decimalPlaces": 2
                }
            ]
        },
        {
            "name": "providerCarbonIntensityMarketAnnual",
            "displayName": "Provider carbon intensity (market, annual) (gCO₂eq/kWh)",
            "shape": [
                "number",
                {
                    "decimalPlaces": 1
                }
            ]
        },
        {
            "name": "providerCarbonIntensityConsumptionHourly",
            "displayName": "Provider carbon intensity (consumption, hourly) (gCO₂eq/kWh)",
            "shape": [
                "number",
                {
                    "decimalPlaces": 1
                }
            ]
        },
        {
            "name": "gridCarbonIntensityConsumptionAnnual",
            "displayName": "Grid carbon intensity (consumption, annual) (gCO₂eq/kWh)",
            "shape": [
                "number",
                {
                    "decimalPlaces": 1
                }
            ]
        },
        {
            "name": "gridCarbonIntensityMarginalAnnual",
            "displayName": "Grid carbon intensity (marginal, annual) (gCO₂eq/kWh)",
            "shape": [
                "number",
                {
                    "decimalPlaces": 1
                }
            ]
        },
        {
            "name": "gridCarbonIntensityProductionAnnual",
            "displayName": "Grid carbon intensity (production, annual) (gCO₂eq/kWh)",
            "shape": [
                "number",
                {
                    "decimalPlaces": 1
                }
            ]
        },
        {
            "name": "gridCarbonIntensity",
            "displayName": "Grid carbon intensity (SCI-o) (gCO₂eq/kWh)",
            "shape": [
                "number",
                {
                    "decimalPlaces": 1
                }
            ]
        },
        {
            "name": "totalEnergyKwh",
            "visible": false,
            "displayName": "Total ICT energy (kWh)",
            "shape": [
                "number",
                {
                    "thousandsSeparator": true,
                    "decimalPlaces": 0
                }
            ]
        },
        {
            "name": "totalWaterInputLitres",
            "displayName": "Total water input (L)",
            "shape": [
                "number",
                {
                    "thousandsSeparator": true,
                    "decimalPlaces": 0
                }
            ]
        },
        {
            "name": "renewableEnergyKwh",
            "visible": false,
            "displayName": "Renewable energy (kWh)",
            "shape": [
                "number",
                {
                    "thousandsSeparator": true,
                    "decimalPlaces": 0
                }
            ]
        },
        {
            "name": "renewableEnergyGooKwh",
            "visible": false,
            "displayName": "Renewable energy (GoO/REC) (kWh)",
            "shape": [
                "number",
                {
                    "thousandsSeparator": true,
                    "decimalPlaces": 0
                }
            ]
        },
        {
            "name": "renewableEnergyPpaKwh",
            "visible": false,
            "displayName": "Renewable energy (PPA) (kWh)",
            "shape": [
                "number",
                {
                    "thousandsSeparator": true,
                    "decimalPlaces": 0
                }
            ]
        },
        {
            "name": "renewableEnergyOnsiteKwh",
            "visible": false,
            "displayName": "Renewable energy (on-site) (kWh)",
            "shape": [
                "number",
                {
                    "thousandsSeparator": true,
                    "decimalPlaces": 0
                }
            ]
        }
    ],
    "defaultShaping": {
        "sort": {
            "by": [
                [
                    "year",
                    "desc"
                ]
            ]
        }
    },
    "timeframes": false
}
