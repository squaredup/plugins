{
    "name": "regions",
    "displayName": "Regions",
    "description": "Cloud regions listed in the region metadata, one row per provider and region",
    "tags": [
        "Cloud"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "Cloud_Region_Metadata.csv",
        "paging": {
            "mode": "none"
        },
        "postRequestScript": "regions.js"
    },
    "matches": "none",
    "visibility": {
        "type": "hidden"
    },
    "metadata": [
        {
            "name": "regionId",
            "displayName": "Region ID",
            "shape": "string",
            "role": "id"
        },
        {
            "name": "name",
            "displayName": "Name",
            "shape": "string",
            "role": "label"
        },
        {
            "pattern": ".*"
        }
    ],
    "timeframes": false
}
