                "config": {
                    "_type": "tile/data-stream",
                    "title": "PUE by Year",
                    "description": "Not every provider publishes PUE for every region. If this tile shows no rows, no PUE has been reported for the selected region.",
                    "timeframe": "none",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[regionMetadata]}}",
                        "name": "regionMetadata",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "region": {
                                "variable": "{{variables.[Cloud Region]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Cloud Regions]}}"
                            }
                        },
                        "sql": "SELECT CAST(CAST(\"year\" AS INTEGER) AS VARCHAR) AS \"yearLabel\", \"pue\" FROM \"dataset\" WHERE \"pue\" IS NOT NULL ORDER BY \"year\""
                    },
                    "variables": [
                        "{{variables.[Cloud Region]}}"
                    ],
