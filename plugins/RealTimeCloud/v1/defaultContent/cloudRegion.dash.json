                "x": 0,
                "y": 5,
                "w": 4,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Region Estimates",
                    "description": "GSF’s own projections for the current year, trended from previous years’ reported data. These are estimates, not measurements.",
                    "timeframe": "none",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[regionEstimates]}}",
                        "name": "regionEstimates",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "region": {
                                "variable": "{{variables.[Cloud Region]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Cloud Regions]}}"
                            }
                        },
                        "sql": "SELECT CAST(CAST(\"year\" AS INTEGER) AS VARCHAR) AS \"yearLabel\", \"pue\", \"wue\", ROUND(\"gridCarbonIntensityConsumptionAnnual\", 0) AS \"gridCi\", ROUND(\"gridCarbonIntensityMarginalAnnual\", 0) AS \"marginalCi\", ROUND(\"providerCfeHourly\" * 100, 0) AS \"cfePct\" FROM \"dataset\" ORDER BY \"year\" DESC"
                    },
                    "variables": [
                        "{{variables.[Cloud Region]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "yearLabel",
                                        "title": "Year",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "gridCi",
                                        "title": "Grid CI (consumption)",
                                        "renderer": {
                                            "type": "number",
                                            "decimals": 0,
                                            "thresholds": [
                                                {
                                                    "to": 100,
                                                    "color": "#16A34A"
                                                },
                                                {
                                                    "to": 400,
                                                    "color": "#F59E0B"
                                                },
                                                {
                                                    "to": 100000,
                                                    "color": "#DC2626"
                                                }
                                            ]
                                        },
                                        "align": "right"
                                    },
                                    {
                                        "field": "marginalCi",
                                        "title": "Grid CI (marginal)",
                                        "renderer": {
                                            "type": "number",
                                            "decimals": 0
                                        },
                                        "align": "right"
                                    },
                                    {
                                        "field": "pue",
                                        "title": "PUE",
                                        "renderer": {
                                            "type": "number",
                                            "decimals": 2,
                                            "thresholds": [
                                                {
                                                    "to": 1.15,
                                                    "color": "#16A34A"
                                                },
                                                {
                                                    "to": 1.3,
                                                    "color": "#F59E0B"
                                                },
                                                {
                                                    "to": 100,
                                                    "color": "#DC2626"
                                                }
                                            ]
                                        },
                                        "align": "right"
                                    },
                                    {
                                        "field": "wue",
                                        "title": "WUE (L/kWh)",
                                        "renderer": {
                                            "type": "number",
                                            "decimals": 2,
                                            "thresholds": [
                                                {
                                                    "to": 0.5,
                                                    "color": "#16A34A"
                                                },
                                                {
                                                    "to": 1.0,
                                                    "color": "#F59E0B"
                                                },
                                                {
                                                    "to": 100,
                                                    "color": "#DC2626"
                                                }
                                            ]
                                        },
                                        "align": "right"
                                    },
                                    {
                                        "field": "cfePct",
                                        "title": "Hourly CFE",
                                        "renderer": {
                                            "type": "progress",
                                            "max": 100
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableCellPadding": 6,
                                "richTableAltRowColor": "rgba(148,163,184,0.08)"
                            }
                        }
                    }
                }
