                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Grid Carbon Intensity by Year",
                    "description": "",
                    "timeframe": "none",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[regionMetadata]}}",
                        "name": "regionMetadata",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "region": {
                                "variable": "{{variables.[Cloud Region]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Cloud Regions]}}"
                            }
                        },
                        "sql": "SELECT CAST(CAST(\"year\" AS INTEGER) AS VARCHAR) AS \"yearLabel\", ROUND(\"gridCarbonIntensityConsumptionAnnual\", 0) AS \"gridCi\" FROM \"dataset\" WHERE \"gridCarbonIntensityConsumptionAnnual\" IS NOT NULL ORDER BY \"year\""
                    },
                    "variables": [
                        "{{variables.[Cloud Region]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "yearLabel",
                                    "type": "nominal",
                                    "title": "Year"
                                },
                                "y": {
                                    "field": "gridCi",
                                    "type": "quantitative",
                                    "title": "gCO₂eq/kWh"
                                }
                            },
                            "style": {
                                "showLabels": true,
                                "cartesianBarBorderRadius": 6,
                                "cartesianShowHorizontalGridLines": false,
                                "cartesianColorRules": [
                                    {
                                        "lt": 100,
                                        "color": "#16A34A"
                                    },
                                    {
                                        "lt": 400,
                                        "color": "#F59E0B"
                                    },
                                    {
                                        "gte": 400,
                                        "color": "#DC2626"
                                    }
                                ]
                            }
                        }
                    }
                }
