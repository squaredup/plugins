{
    "displayName": "Queue receives messages from Worker",
    "source": {
        "types": "Cloudflare Queue"
    },
    "target": {
        "types": "Cloudflare Worker"
    },
    "conditions": [
        {
            "sourceProperty": "primaryProducerScript",
