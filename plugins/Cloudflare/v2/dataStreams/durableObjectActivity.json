{
    "name": "durableObjectActivity",
    "displayName": "Durable Object Activity",
    "description": "Active time, CPU time, storage operations, errors and memory for a Durable Object namespace",
    "tags": [
        "Compute",
        "Analytics"
    ],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "post",
        "endpointPath": "graphql",
        "headers": [
            {
                "key": "X-Rate-Limit-Type",
                "value": "account-based"
            }
        ],
        "postBody": {
            "query": "query($accountTag:string!,$start:Time!,$end:Time!,$namespaceId:string!){viewer{accounts(filter:{accountTag:$accountTag}){durableObjectsPeriodicGroups(limit:10000,filter:{namespaceId:$namespaceId,datetime_geq:$start,datetime_leq:$end},orderBy:[{{ (timeframe.unixEnd - timeframe.unixStart) <= 5400 ? 'datetimeMinute' : (timeframe.unixEnd - timeframe.unixStart) <= 46800 ? 'datetimeFiveMinutes' : (timeframe.unixEnd - timeframe.unixStart) <= 90000 ? 'datetimeFifteenMinutes' : (timeframe.unixEnd - timeframe.unixStart) <= 619200 ? 'datetimeHour' : (timeframe.unixEnd - timeframe.unixStart) <= 2764800 ? 'datetimeSixHours' : 'date' }}_ASC]){sum{activeTime cpuTime rowsRead rowsWritten storageReadUnits storageWriteUnits subrequests exceededCpuErrors exceededMemoryErrors fatalInternalErrors} max{activeWebsocketConnections memoryUsageBytes} dimensions{datetime: {{ (timeframe.unixEnd - timeframe.unixStart) <= 5400 ? 'datetimeMinute' : (timeframe.unixEnd - timeframe.unixStart) <= 46800 ? 'datetimeFiveMinutes' : (timeframe.unixEnd - timeframe.unixStart) <= 90000 ? 'datetimeFifteenMinutes' : (timeframe.unixEnd - timeframe.unixStart) <= 619200 ? 'datetimeHour' : (timeframe.unixEnd - timeframe.unixStart) <= 2764800 ? 'datetimeSixHours' : 'date' }} }}}}}",
            "variables": {
                "accountTag": "{{object.accountId}}",
                "namespaceId": "{{object.rawId}}",
                "start": "{{timeframe.start}}",
                "end": "{{timeframe.end}}"
            }
        },
        "postRequestScript": "graphqlRows.js",
        "errorHandling": {
            "type": "path",
            "realm": "payload",
            "path": "errors.0.message"
        }
    },
    "matches": {
        "sourceType": {
            "type": "oneOf",
            "values": [
                "Cloudflare Durable Object Namespace"
            ]
        }
    },
    "metadata": [
        {
            "name": "dimensions.datetime",
            "displayName": "Time",
            "shape": "date",
            "role": "timestamp"
        },
        {
            "name": "sum.activeTime",
            "displayName": "Active time (µs)",
            "shape": "number",
            "visible": false
        },
        {
            "name": "activeTimeMs",
            "displayName": "Active time",
            "computed": true,
            "valueExpression": "{{ $['sum.activeTime'] === undefined || $['sum.activeTime'] === null ? null : $['sum.activeTime'] / 1000 }}",
            "shape": "milliseconds"
        },
        {
            "name": "sum.cpuTime",
            "displayName": "CPU time (µs)",
            "shape": "number",
            "visible": false
        },
        {
            "name": "cpuTimeMs",
            "displayName": "CPU time",
            "computed": true,
            "valueExpression": "{{ $['sum.cpuTime'] === undefined || $['sum.cpuTime'] === null ? null : $['sum.cpuTime'] / 1000 }}",
            "shape": "milliseconds"
        },
        {
            "name": "sum.rowsRead",
            "displayName": "Rows read",
            "shape": "number"
        },
        {
            "name": "sum.rowsWritten",
            "displayName": "Rows written",
            "shape": "number"
        },
        {
            "name": "sum.storageReadUnits",
            "displayName": "Storage read units",
            "shape": "number"
        },
        {
            "name": "sum.storageWriteUnits",
            "displayName": "Storage write units",
            "shape": "number"
        },
        {
            "name": "sum.subrequests",
            "displayName": "Subrequests",
            "shape": "number"
        },
        {
            "name": "sum.exceededCpuErrors",
            "displayName": "CPU limit errors",
            "shape": "number"
        },
        {
            "name": "sum.exceededMemoryErrors",
            "displayName": "Memory limit errors",
            "shape": "number"
        },
        {
            "name": "sum.fatalInternalErrors",
            "displayName": "Internal errors",
            "shape": "number"
        },
        {
            "name": "max.activeWebsocketConnections",
            "displayName": "Peak WebSocket connections",
            "shape": "number"
        },
        {
            "name": "max.memoryUsageBytes",
            "displayName": "Peak memory",
            "shape": "bytes"
        }
    ],
    "timeframes": [
        "last1hour",
        "last12hours",
        "last24hours",
        "last7days",
        "last30days",
        "thisMonth",
        "lastMonth"
    ]
}
