{
    "name": "rumPageLoadTiming",
    "displayName": "Web Analytics Page Load Timing",
    "description": "P75 page load timing breakdown (DNS, connection, request, response, first contentful paint, page load) for a zone's hostnames",
    "tags": [
        "Zone",
        "Analytics"
    ],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "post",
        "endpointPath": "graphql",
        "postBody": {
            "query": "query($accountTag:string!,$start:Time!,$end:Time!,$hostFilter:string!){viewer{accounts(filter:{accountTag:$accountTag}){rumPerformanceEventsAdaptiveGroups(limit:10000,filter:{requestHost_like:$hostFilter,datetime_geq:$start,datetime_leq:$end},orderBy:[{{ (timeframe.unixEnd - timeframe.unixStart) <= 5400 ? 'datetimeMinute' : (timeframe.unixEnd - timeframe.unixStart) <= 46800 ? 'datetimeFiveMinutes' : (timeframe.unixEnd - timeframe.unixStart) <= 90000 ? 'datetimeFifteenMinutes' : (timeframe.unixEnd - timeframe.unixStart) <= 2764800 ? 'datetimeHour' : 'date' }}_ASC]){count sum{visits} quantiles{dnsTimeP75 connectionTimeP75 requestTimeP75 responseTimeP75 firstContentfulPaintP75 pageLoadTimeP75} dimensions{date: {{ (timeframe.unixEnd - timeframe.unixStart) <= 5400 ? 'datetimeMinute' : (timeframe.unixEnd - timeframe.unixStart) <= 46800 ? 'datetimeFiveMinutes' : (timeframe.unixEnd - timeframe.unixStart) <= 90000 ? 'datetimeFifteenMinutes' : (timeframe.unixEnd - timeframe.unixStart) <= 2764800 ? 'datetimeHour' : 'date' }} }}}}}",
            "variables": {
                "accountTag": "{{object.accountId}}",
                "hostFilter": "{{'%' + object.name}}",
                "start": "{{timeframe.start}}",
                "end": "{{timeframe.end}}"
            }
        },
        "postRequestScript": "graphqlRows.js",
        "errorHandling": {
            "type": "path",
            "realm": "payload",
            "path": "errors.0.message"
        }
    },
    "matches": {
        "sourceType": {
            "type": "oneOf",
            "values": [
                "Cloudflare Zone"
            ]
        }
    },
    "metadata": [
        {
            "name": "dimensions.date",
            "displayName": "Time",
            "shape": "date",
            "role": "timestamp"
        },
        {
            "name": "count",
            "displayName": "Page loads",
            "shape": "number",
            "role": "value"
        },
        {
            "name": "sum.visits",
            "displayName": "Visits",
            "shape": "number"
        },
        {
            "name": "dnsTime",
            "displayName": "DNS P75",
            "computed": true,
            "valueExpression": "{{ $['quantiles.dnsTimeP75'] === undefined || $['quantiles.dnsTimeP75'] === null ? null : $['quantiles.dnsTimeP75'] / 1000 }}",
            "shape": "milliseconds"
        },
        {
            "name": "connectionTime",
            "displayName": "Connection P75",
            "computed": true,
            "valueExpression": "{{ $['quantiles.connectionTimeP75'] === undefined || $['quantiles.connectionTimeP75'] === null ? null : $['quantiles.connectionTimeP75'] / 1000 }}",
            "shape": "milliseconds"
        },
        {
            "name": "requestTime",
            "displayName": "Request P75",
            "computed": true,
            "valueExpression": "{{ $['quantiles.requestTimeP75'] === undefined || $['quantiles.requestTimeP75'] === null ? null : $['quantiles.requestTimeP75'] / 1000 }}",
            "shape": "milliseconds"
        },
        {
            "name": "responseTime",
            "displayName": "Response P75",
            "computed": true,
            "valueExpression": "{{ $['quantiles.responseTimeP75'] === undefined || $['quantiles.responseTimeP75'] === null ? null : $['quantiles.responseTimeP75'] / 1000 }}",
            "shape": "milliseconds"
        },
        {
            "name": "firstContentfulPaint",
            "displayName": "First contentful paint P75",
            "computed": true,
            "valueExpression": "{{ $['quantiles.firstContentfulPaintP75'] === undefined || $['quantiles.firstContentfulPaintP75'] === null ? null : $['quantiles.firstContentfulPaintP75'] / 1000 }}",
            "shape": "milliseconds"
        },
        {
            "name": "pageLoadTime",
            "displayName": "Page load P75",
            "computed": true,
            "valueExpression": "{{ $['quantiles.pageLoadTimeP75'] === undefined || $['quantiles.pageLoadTimeP75'] === null ? null : $['quantiles.pageLoadTimeP75'] / 1000 }}",
            "shape": "milliseconds"
        },
        {
            "name": "quantiles.dnsTimeP75",
            "displayName": "dnsTimeP75",
            "shape": "number",
            "visible": false
        },
        {
            "name": "quantiles.connectionTimeP75",
            "displayName": "connectionTimeP75",
            "shape": "number",
            "visible": false
        },
        {
            "name": "quantiles.requestTimeP75",
            "displayName": "requestTimeP75",
            "shape": "number",
            "visible": false
        },
        {
            "name": "quantiles.responseTimeP75",
            "displayName": "responseTimeP75",
            "shape": "number",
            "visible": false
        },
        {
            "name": "quantiles.firstContentfulPaintP75",
            "displayName": "firstContentfulPaintP75",
            "shape": "number",
            "visible": false
        },
        {
            "name": "quantiles.pageLoadTimeP75",
            "displayName": "pageLoadTimeP75",
            "shape": "number",
            "visible": false
        }
    ],
    "timeframes": [
        "last1hour",
        "last12hours",
        "last24hours",
        "last7days",
        "last30days",
        "thisMonth",
        "lastMonth",
        "thisQuarter"
    ]
}
