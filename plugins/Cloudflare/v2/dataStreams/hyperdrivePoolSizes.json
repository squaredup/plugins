{
    "name": "hyperdrivePoolSizes",
    "displayName": "Hyperdrive Connection Pool",
    "description": "Connection pool size, free slots and waiting clients for a Hyperdrive config",
    "tags": [
        "Storage",
        "Analytics"
    ],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "post",
        "endpointPath": "graphql",
        "postBody": {
            "query": "query($accountTag:string!,$start:Time!,$end:Time!,$configId:string!){viewer{accounts(filter:{accountTag:$accountTag}){hyperdrivePoolSizesAdaptiveGroups(limit:10000,filter:{configId:$configId,datetime_geq:$start,datetime_leq:$end},orderBy:[{{ (timeframe.unixEnd - timeframe.unixStart) <= 46800 ? 'datetimeMinute' : (timeframe.unixEnd - timeframe.unixStart) <= 2764800 ? 'datetimeHour' : 'date' }}_ASC]){avg{currentPoolSize availablePoolSlots waitingClients} max{maxPoolSize waitingClients} dimensions{datetime: {{ (timeframe.unixEnd - timeframe.unixStart) <= 46800 ? 'datetimeMinute' : (timeframe.unixEnd - timeframe.unixStart) <= 2764800 ? 'datetimeHour' : 'date' }} }}}}}",
            "variables": {
                "accountTag": "{{object.accountId}}",
                "configId": "{{object.rawId}}",
                "start": "{{timeframe.start}}",
                "end": "{{timeframe.end}}"
            }
        },
        "postRequestScript": "graphqlRows.js",
        "errorHandling": {
            "type": "path",
            "realm": "payload",
            "path": "errors.0.message"
        }
    },
    "matches": {
        "sourceType": {
            "type": "oneOf",
            "values": [
                "Cloudflare Hyperdrive Config"
            ]
        }
    },
    "metadata": [
        {
            "name": "dimensions.datetime",
            "displayName": "Time",
            "shape": "date",
            "role": "timestamp"
        },
        {
            "name": "avg.currentPoolSize",
            "displayName": "Pool Size",
            "shape": "number",
            "role": "value",
            "decimalPlaces": 1
        },
        {
            "name": "avg.availablePoolSlots",
            "displayName": "Free Slots",
            "shape": "number",
            "decimalPlaces": 1
        },
        {
            "name": "avg.waitingClients",
            "displayName": "Waiting Clients",
            "shape": "number",
            "decimalPlaces": 1
        },
        {
            "name": "max.waitingClients",
            "displayName": "Peak Waiting Clients",
            "shape": "number"
        },
        {
            "name": "max.maxPoolSize",
            "displayName": "Pool Limit",
            "shape": "number"
        }
    ],
    "timeframes": [
        "last1hour",
        "last12hours",
        "last24hours",
        "last7days",
        "last30days",
        "thisMonth"
    ]
}
