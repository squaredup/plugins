{
    "name": "workerSubrequests",
    "displayName": "Worker Subrequests",
    "description": "Outbound subrequests made by a Worker script, with response time, grouped by a selectable dimension",
    "tags": [
        "Compute",
        "Analytics"
    ],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "post",
        "endpointPath": "graphql",
        "postBody": {
            "query": "query($accountTag:string!,$start:Time!,$end:Time!,$scriptName:string!){viewer{accounts(filter:{accountTag:$accountTag}){workersSubrequestsAdaptiveGroups(limit:10000,filter:{scriptName:$scriptName,datetime_geq:$start,datetime_leq:$end},orderBy:[sum_subrequests_DESC]){sum{subrequests requestBodySize responseBodySize} quantiles{timeToResponseUsP50 timeToResponseUsP99} dimensions{datetime: {{ (timeframe.unixEnd - timeframe.unixStart) <= 5400 ? 'datetimeFiveMinutes' : (timeframe.unixEnd - timeframe.unixStart) <= 46800 ? 'datetimeFifteenMinutes' : (timeframe.unixEnd - timeframe.unixStart) <= 90000 ? 'datetimeHour' : 'date' }} {{breakdown || 'hostname'}} }}}}}",
            "variables": {
                "accountTag": "{{object.accountId}}",
                "scriptName": "{{object.name}}",
                "start": "{{timeframe.start}}",
                "end": "{{timeframe.end}}"
            }
        },
        "postRequestScript": "graphqlRows.js",
        "errorHandling": {
            "type": "path",
            "realm": "payload",
            "path": "errors.0.message"
        }
    },
    "matches": {
        "sourceType": {
            "type": "oneOf",
            "values": [
                "Cloudflare Worker"
            ]
        }
    },
    "ui": [
        {
            "type": "choiceChips",
            "name": "breakdown",
            "label": "Breakdown",
            "required": true,
            "defaultValue": "hostname",
            "options": [
                {
                    "value": "hostname",
                    "label": "Host"
                },
                {
                    "value": "cacheStatus",
                    "label": "Cache Status"
                },
                {
                    "value": "httpResponseStatus",
                    "label": "Status Code"
                },
                {
                    "value": "requestOutcome",
                    "label": "Outcome"
                }
            ]
        }
    ],
    "metadata": [
        {
            "name": "dimensions.datetime",
            "displayName": "Time",
            "shape": "date",
            "role": "timestamp"
        },
        {
            "name": "breakdown",
            "displayName": "Breakdown",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "sum.subrequests",
            "displayName": "Subrequests",
            "shape": "number",
            "role": "value"
        },
        {
            "name": "sum.requestBodySize",
            "displayName": "Request Bytes",
            "shape": "bytes"
        },
        {
            "name": "sum.responseBodySize",
            "displayName": "Response Bytes",
            "shape": "bytes"
        },
        {
            "name": "quantiles.timeToResponseUsP50",
            "displayName": "Response time P50 (µs)",
            "shape": "number",
            "visible": false
        },
        {
            "name": "quantiles.timeToResponseUsP99",
            "displayName": "Response time P99 (µs)",
            "shape": "number",
            "visible": false
        },
        {
            "name": "responseTimeP50",
            "displayName": "Response Time P50",
            "computed": true,
            "valueExpression": "{{ $['quantiles.timeToResponseUsP50'] === undefined || $['quantiles.timeToResponseUsP50'] === null ? null : $['quantiles.timeToResponseUsP50'] / 1000 }}",
            "shape": "milliseconds"
        },
        {
            "name": "responseTimeP99",
            "displayName": "Response Time P99",
            "computed": true,
            "valueExpression": "{{ $['quantiles.timeToResponseUsP99'] === undefined || $['quantiles.timeToResponseUsP99'] === null ? null : $['quantiles.timeToResponseUsP99'] / 1000 }}",
            "shape": "milliseconds"
        }
    ],
    "timeframes": [
        "last1hour",
        "last12hours",
        "last24hours",
        "last7days",
        "last30days",
        "thisMonth",
        "lastMonth"
    ]
}
