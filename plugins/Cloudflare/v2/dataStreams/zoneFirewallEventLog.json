{
    "name": "zoneFirewallEventLog",
    "displayName": "Zone Firewall Event Log",
    "description": "Individual firewall events for a zone, newest first, optionally filtered by action and service (latest 1,000 events, up to 30 days on every plan)",
    "tags": [
        "Zone",
        "Security"
    ],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "post",
        "endpointPath": "graphql",
        "postBody": {
            "query": "query($zoneTag:string!,$filter:ZoneFirewallEventsAdaptiveFilter_InputObject){viewer{zones(filter:{zoneTag:$zoneTag}){firewallEventsAdaptive(limit:1000,filter:$filter,orderBy:[datetime_DESC]){datetime action source description ruleId rayName clientIP clientCountryName clientASNDescription clientRequestHTTPHost clientRequestHTTPMethodName clientRequestPath userAgent edgeResponseStatus}}}}",
            "variables": {
                "zoneTag": "{{object.rawId}}",
                "filter": "{{ Object.assign({ datetime_geq: new Date((timeframe.unixStart + 60) * 1000).toISOString(), datetime_leq: timeframe.end }, (typeof actions !== 'undefined' && actions ? [].concat(typeof actions === 'string' && actions.trim().charAt(0) === '[' ? JSON.parse(actions) : actions).map((v) => (v && v.value !== undefined ? v.value : v)).filter((v) => v) : []).length ? { action_in: (typeof actions !== 'undefined' && actions ? [].concat(typeof actions === 'string' && actions.trim().charAt(0) === '[' ? JSON.parse(actions) : actions).map((v) => (v && v.value !== undefined ? v.value : v)).filter((v) => v) : []) } : {}, (typeof sources !== 'undefined' && sources ? [].concat(typeof sources === 'string' && sources.trim().charAt(0) === '[' ? JSON.parse(sources) : sources).map((v) => (v && v.value !== undefined ? v.value : v)).filter((v) => v) : []).length ? { source_in: (typeof sources !== 'undefined' && sources ? [].concat(typeof sources === 'string' && sources.trim().charAt(0) === '[' ? JSON.parse(sources) : sources).map((v) => (v && v.value !== undefined ? v.value : v)).filter((v) => v) : []) } : {}) }}"
            }
        },
        "postRequestScript": "graphqlFlatRows.js",
        "errorHandling": {
            "type": "path",
            "realm": "payload",
            "path": "errors.0.message"
        }
    },
    "matches": {
        "sourceType": {
            "type": "oneOf",
            "values": [
                "Cloudflare Zone"
            ]
        }
    },
    "ui": [
        {
            "type": "autocomplete",
            "name": "actions",
            "label": "Action(s)",
            "isMulti": true,
            "isClearable": true,
            "data": {
                "source": "fixed",
                "values": [
                    {
                        "value": "block",
                        "label": "Block"
                    },
                    {
                        "value": "managed_challenge",
                        "label": "Managed Challenge"
                    },
                    {
                        "value": "challenge",
                        "label": "Interactive Challenge"
                    },
                    {
                        "value": "jschallenge",
                        "label": "JS Challenge"
                    },
                    {
                        "value": "connection_close",
                        "label": "Connection Close"
                    },
                    {
                        "value": "log",
                        "label": "Log"
                    },
                    {
                        "value": "skip",
                        "label": "Skip"
                    },
                    {
                        "value": "bypass",
                        "label": "Bypass"
                    },
                    {
                        "value": "allow",
                        "label": "Allow"
                    }
                ]
            }
        },
        {
            "type": "autocomplete",
            "name": "sources",
            "label": "Service(s)",
            "isMulti": true,
            "isClearable": true,
            "data": {
                "source": "fixed",
                "values": [
                    {
                        "value": "firewallManaged",
                        "label": "Managed Rules"
                    },
                    {
                        "value": "firewallCustom",
                        "label": "Custom Rules"
                    },
                    {
                        "value": "rateLimit",
                        "label": "Rate Limiting Rules"
                    },
                    {
                        "value": "l7ddos",
                        "label": "HTTP DDoS Protection"
                    },
                    {
                        "value": "botFight",
                        "label": "Bot Fight Mode"
                    },
                    {
                        "value": "botManagement",
                        "label": "Bot Management"
                    },
                    {
                        "value": "bic",
                        "label": "Browser Integrity Check"
                    },
                    {
                        "value": "securityLevel",
                        "label": "Security Level"
                    },
                    {
                        "value": "ip",
                        "label": "IP Access Rules"
                    },
                    {
                        "value": "ipRange",
                        "label": "IP Range Access Rules"
                    },
                    {
                        "value": "asn",
                        "label": "ASN Access Rules"
                    },
                    {
                        "value": "country",
                        "label": "Country Access Rules"
                    },
                    {
                        "value": "uaBlock",
                        "label": "User Agent Blocking"
                    },
                    {
                        "value": "zoneLockdown",
                        "label": "Zone Lockdown"
                    },
                    {
                        "value": "hot",
                        "label": "Hotlink Protection"
                    },
                    {
                        "value": "validation",
                        "label": "Request Validation"
                    },
                    {
                        "value": "apiShield",
                        "label": "API Shield"
                    },
                    {
                        "value": "dlp",
                        "label": "Data Loss Prevention"
                    }
                ]
            }
        }
    ],
    "metadata": [
        {
            "name": "datetime",
            "displayName": "Time",
            "shape": "date",
            "role": "timestamp"
        },
        {
            "name": "action",
            "displayName": "Action",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "actionState",
            "displayName": "Severity",
            "computed": true,
            "valueExpression": "{{ $['action'] }}",
            "shape": [
                "state",
                {
                    "map": {
                        "error": [
                            "block",
                            "drop",
                            "connection_close"
                        ],
                        "warning": [
                            "challenge",
                            "managed_challenge",
                            "jschallenge"
                        ],
                        "success": [
                            "allow",
                            "skip",
                            "log",
                            "bypass"
                        ]
                    }
                }
            ]
        },
        {
            "name": "source",
            "displayName": "Service",
            "shape": "string"
        },
        {
            "name": "description",
            "displayName": "Rule",
            "shape": "string"
        },
        {
            "name": "ruleId",
            "displayName": "Rule ID",
            "shape": "string",
            "visible": false
        },
        {
            "name": "clientIP",
            "displayName": "Client IP",
            "shape": "string"
        },
        {
            "name": "clientCountryName",
            "displayName": "Country",
            "shape": "string"
        },
        {
            "name": "clientASNDescription",
            "displayName": "ASN",
            "shape": "string"
        },
        {
            "name": "clientRequestHTTPHost",
            "displayName": "Host",
            "shape": "string"
        },
        {
            "name": "clientRequestHTTPMethodName",
            "displayName": "Method",
            "shape": "string"
        },
        {
            "name": "clientRequestPath",
            "displayName": "Path",
            "shape": "string"
        },
        {
            "name": "userAgent",
            "displayName": "User Agent",
            "shape": "string"
        },
        {
            "name": "edgeResponseStatus",
            "displayName": "Status Code",
            "shape": "number"
        },
        {
            "name": "rayName",
            "displayName": "Ray ID",
            "shape": "string"
        }
    ],
    "timeframes": [
        "last1hour",
        "last12hours",
        "last24hours",
        "last7days",
        "last30days"
    ]
}
