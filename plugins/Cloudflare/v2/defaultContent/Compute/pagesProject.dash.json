{
    "name": "Pages Project",
    "schemaVersion": "1.5",
    "timeframe": "none",
    "variables": [
        "{{variables.[Cloudflare Pages Project]}}"
    ],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "24e8166d-ea90-45bf-a4de-8df7dd9033a3",
                "x": 0,
                "y": 0,
                "w": 2,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Project Details",
                    "description": "",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "datastream-properties",
                        "name": "properties"
                    },
                    "timeframe": "none",
                    "scope": {
                        "scope": "{{scopes.[Cloudflare Pages Projects]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Cloudflare Pages Project]}}"
                    },
                    "variables": [
                        "{{variables.[Cloudflare Pages Project]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {},
                            "style": {
                                "richTableTranspose": true,
                                "richTableHiddenColumns": [
                                    "id",
                                    "label",
                                    "link",
                                    "links",
                                    "sourceId",
                                    "sourceName",
                                    "type"
                                ]
                            }
                        }
                    }
                }
            },
            {
                "i": "62a4eba1-b082-4a4d-b8d3-7bb6f3bab970",
                "x": 2,
                "y": 0,
                "w": 2,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Latest Deployments",
                    "description": "",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[pagesDeployments]}}",
                        "name": "pagesDeployments",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [
                                [
                                    "created_on",
                                    "desc"
                                ]
                            ],
                            "top": 8
                        }
                    },
                    "timeframe": "none",
                    "scope": {
                        "scope": "{{scopes.[Cloudflare Pages Projects]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Cloudflare Pages Project]}}"
                    },
                    "variables": [
                        "{{variables.[Cloudflare Pages Project]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "statusGrid",
                            "encoding": {
                                "label": {
                                    "field": "short_id",
                                    "type": "nominal"
                                },
                                "status": {
                                    "field": "status",
                                    "type": "nominal"
                                },
                                "link": {
                                    "field": "url",
                                    "type": "nominal"
                                }
                            },
                            "style": {
                                "statusGridColumnsPerRow": 4,
                                "statusGridSecondaryTemplate": "{{{{raw}}}}{{branch}}{{{{/raw}}}}"
                            }
                        }
                    }
                }
            },
            {
                "i": "92727f98-b5b9-42ec-b67c-6872f87afbe2",
                "x": 0,
                "y": 3,
                "w": 2,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Deployments by Status",
                    "description": "",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[pagesDeployments]}}",
                        "name": "pagesDeployments",
                        "pluginConfigId": "{{configId}}",
                        "group": {
                            "by": [
                                [
                                    "status",
                                    "uniqueValues"
                                ]
                            ],
                            "aggregate": [
                                {
                                    "type": "count"
                                }
                            ]
                        },
                        "sort": {
                            "by": [
                                [
                                    "count",
                                    "desc"
                                ]
                            ]
                        }
                    },
                    "timeframe": "none",
                    "scope": {
                        "scope": "{{scopes.[Cloudflare Pages Projects]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Cloudflare Pages Project]}}"
                    },
                    "variables": [
                        "{{variables.[Cloudflare Pages Project]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "pie",
                            "encoding": {
                                "label": {
                                    "field": "status_uniqueValues",
                                    "type": "nominal",
                                    "title": "Status"
                                },
                                "value": {
                                    "field": "count",
                                    "type": "quantitative",
                                    "aggregate": "sum",
                                    "title": "Count"
                                }
                            },
                            "style": {
                                "pieInnerRadius": 60,
                                "pieDonutCenterValue": "total",
                                "labelFontSize": 16,
                                "pieSort": "desc",
                                "pieLegendStyle": "table",
                                "mappedColors": {
                                    "critical": "#DE0038",
                                    "error": "#DE0038",
                                    "failed": "#DE0038",
                                    "failure": "#DE0038",
                                    "down": "#DE0038",
                                    "offline": "#DE0038",
                                    "unhealthy": "#DE0038",
                                    "high": "#DE0038",
                                    "warning": "#F59E0B",
                                    "warn": "#F59E0B",
                                    "medium": "#F59E0B",
                                    "moderate": "#F59E0B",
                                    "degraded": "#F59E0B",
                                    "partial": "#F59E0B",
                                    "ok": "#2BB660",
                                    "healthy": "#2BB660",
                                    "success": "#2BB660",
                                    "succeeded": "#2BB660",
                                    "passed": "#2BB660",
                                    "up": "#2BB660",
                                    "online": "#2BB660",
                                    "resolved": "#2BB660",
                                    "low": "#3B82F6",
                                    "info": "#3B82F6",
                                    "informational": "#3B82F6",
                                    "unknown": "#94A3B8",
                                    "unmonitored": "#94A3B8",
                                    "not monitored": "#94A3B8",
                                    "paused": "#94A3B8"
                                }
                            }
                        }
                    }
                }
            },
            {
                "i": "6dec82d4-05e1-4196-abd9-01ff6537d2b3",
                "x": 2,
                "y": 3,
                "w": 2,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Deployments by Environment",
                    "description": "",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[pagesDeployments]}}",
                        "name": "pagesDeployments",
                        "pluginConfigId": "{{configId}}",
                        "group": {
                            "by": [
                                [
                                    "environment",
                                    "uniqueValues"
                                ]
                            ],
                            "aggregate": [
                                {
                                    "type": "count"
                                }
                            ]
                        },
                        "sort": {
                            "by": [
                                [
                                    "count",
                                    "desc"
                                ]
                            ]
                        }
                    },
                    "timeframe": "none",
                    "scope": {
                        "scope": "{{scopes.[Cloudflare Pages Projects]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Cloudflare Pages Project]}}"
                    },
                    "variables": [
                        "{{variables.[Cloudflare Pages Project]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "pie",
                            "encoding": {
                                "label": {
                                    "field": "environment_uniqueValues",
                                    "type": "nominal",
                                    "title": "Environment"
                                },
                                "value": {
                                    "field": "count",
                                    "type": "quantitative",
                                    "aggregate": "sum",
                                    "title": "Count"
                                }
                            },
                            "style": {
                                "pieInnerRadius": 60,
                                "pieDonutCenterValue": "total",
                                "labelFontSize": 16,
                                "pieSort": "desc",
                                "pieLegendStyle": "table"
                            }
                        }
                    }
                }
            },
            {
                "i": "f5f618a9-bf99-4fee-b0e9-b1d8ac9d4c98",
                "x": 0,
                "y": 6,
                "w": 4,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Deployment History",
                    "description": "",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[pagesDeployments]}}",
                        "name": "pagesDeployments",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [
                                [
                                    "created_on",
                                    "desc"
                                ]
                            ]
                        }
                    },
                    "timeframe": "none",
                    "scope": {
                        "scope": "{{scopes.[Cloudflare Pages Projects]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Cloudflare Pages Project]}}"
                    },
                    "variables": [
                        "{{variables.[Cloudflare Pages Project]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "created_on",
                                        "title": "Created",
                                        "renderer": {
                                            "type": "date"
                                        }
                                    },
                                    {
                                        "field": "short_id",
                                        "title": "Deployment",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "environment",
                                        "title": "Environment",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "status[Expanded].rawState",
                                        "title": "Status",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "success": "#2BB660",
                                                "failure": "#DE0038",
                                                "canceled": "#DE0038",
                                                "skipped": "#F59E0B",
                                                "active": "#F59E0B",
                                                "building": "#F59E0B",
                                                "queued": "#F59E0B",
                                                "idle": "#94A3B8"
                                            }
                                        }
                                    },
                                    {
                                        "field": "branch",
                                        "title": "Branch",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "commitMessage",
                                        "title": "Commit Message",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "url",
                                        "title": "URL",
                                        "renderer": {
                                            "type": "link"
                                        }
                                    }
                                ]
                            }
                        }
                    }
                }
            }
        ]
    }
}
