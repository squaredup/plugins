{
    "name": "usersList",
    "displayName": "Users",
    "description": "Members of the Notion workspace",
    "tags": ["Users"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "users",
        "pathToData": "results",
        "expandInnerObjects": true,
        "paging": {
            "mode": "token",
            "pageSize": { "realm": "queryArg", "path": "page_size", "value": "100" },
            "in": { "realm": "payload", "path": "next_cursor" },
            "out": { "realm": "queryArg", "path": "start_cursor" }
        }
    },
    "matches": "none",
    "metadata": [
        { "name": "id", "displayName": "ID", "shape": "string", "role": "id", "visible": false },
        { "name": "name", "displayName": "Name", "shape": "string", "role": "label" },
        { "name": "type", "displayName": "Type", "shape": "string" },
        { "name": "person.email", "displayName": "Email", "shape": "string" },
        { "name": "avatar_url", "displayName": "Avatar URL", "shape": "url", "visible": false }
    ],
    "timeframes": false
}
