{
    "name": "sensorHistory",
    "displayName": "Sensor History",
    "description": "Historic channel readings for a sensor, one row per channel per interval",
    "tags": [
        "Monitoring",
        "Performance"
    ],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "historicdata.csv",
        "getArgs": [
            {
                "key": "id",
                "value": "{{object.rawId}}"
            },
            {
                "key": "sdate",
                "value": "{{ (function(){ var MAX = 30 * 86400000; var s = new Date(timeframe.start).getTime(); var e = new Date(timeframe.end).getTime(); if (e - s > MAX) { s = e - MAX; } return new Date(s - 12 * 3600000).toISOString().slice(0, 19).replace(/[T:]/g, '-'); })() }}"
            },
            {
                "key": "edate",
                "value": "{{ (function(){ var MAX = 30 * 86400000; var s = new Date(timeframe.start).getTime(); var e = new Date(timeframe.end).getTime(); if (e - s > MAX) { s = e - MAX; } return new Date(e + 14 * 3600000).toISOString().slice(0, 19).replace(/[T:]/g, '-'); })() }}"
            },
            {
                "key": "avg",
                "value": "{{ average || (new Date(timeframe.end) - new Date(timeframe.start) > 604800000 ? '3600' : '300') }}"
            }
        ],
        "postRequestScript": "sensorHistory.js"
    },
    "matches": {
        "sourceType": {
            "type": "oneOf",
            "values": [
                "Sensor"
            ]
        }
    },
    "ui": [
        {
            "type": "choiceChips",
            "name": "average",
            "label": "Averaging interval",
            "help": "How PRTG aggregates the readings. Left unset, the plugin uses 5-minute buckets, or hourly on ranges longer than seven days. **Raw** returns every individual reading — only practical over short timeframes.",
            "options": [
                {
                    "value": "0",
                    "label": "Raw"
                },
                {
                    "value": "300",
                    "label": "5 minutes"
                },
                {
                    "value": "3600",
                    "label": "1 hour"
                },
                {
                    "value": "86400",
                    "label": "1 day"
                }
            ],
            "tileEditorStep": [
                "Timeframe"
            ]
        }
    ],
    "metadata": [
        {
            "name": "timestamp",
            "displayName": "Time",
            "shape": "date",
            "role": "timestamp"
        },
        {
            "name": "channel",
            "displayName": "Channel",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "value",
            "displayName": "Value",
            "shape": "number",
            "role": "value"
        },
        {
            "name": "coverage",
            "displayName": "Coverage",
            "shape": [
                "percent",
                {
                    "decimalPlaces": 0
                }
            ]
        }
    ],
    "timeframes": [
        "last1hour",
        "last12hours",
        "last24hours",
        "last7days",
        "last30days"
    ],
    "defaultTimeframe": "dashboard"
}
