{
    "name": "Device",
    "schemaVersion": "1.5",
    "timeframe": "last24hours",
    "variables": [
        "{{variables.[Device]}}"
    ],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "1bb12b4c-8810-483b-8edd-51b352c6b16d",
                "x": 0,
                "y": 0,
                "w": 1,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Device Details",
                    "description": "Properties of this device as imported from PRTG",
                    "timeframe": "none",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "datastream-properties",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Devices]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Device]}}"
                    },
                    "variables": [
                        "{{variables.[Device]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {},
                            "style": {
                                "richTableTranspose": true,
                                "richTableCellPadding": 6
                            }
                        }
                    }
                }
            },
            {
                "i": "345f14f6-a2ea-4900-a118-0e8b88b0d4c9",
                "x": 1,
                "y": 0,
                "w": 3,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Sensors",
                    "description": "Every sensor on this device, highest priority first",
                    "timeframe": "none",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[containerSensors]}}",
                        "name": "containerSensors",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [
                                [
                                    "priority_raw",
                                    "desc"
                                ]
                            ]
                        }
                    },
                    "scope": {
                        "scope": "{{scopes.[Devices]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Device]}}"
                    },
                    "variables": [
                        "{{variables.[Device]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "status",
                                        "title": "",
                                        "renderer": {
                                            "type": "status",
                                            "showLabel": false
                                        },
                                        "width": 30
                                    },
                                    {
                                        "field": "name",
                                        "title": "Sensor",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "type",
                                        "title": "Type",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "lastvalue",
                                        "title": "Last Value",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "uptimePercent",
                                        "title": "Uptime",
                                        "renderer": {
                                            "type": "number",
                                            "decimals": 2,
                                            "suffix": "%"
                                        },
                                        "align": "right"
                                    },
                                    {
                                        "field": "lastCheck",
                                        "title": "Last Check",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    },
                                    {
                                        "field": "message_raw",
                                        "title": "Message",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableCellPadding": 6
                            }
                        }
                    }
                }
            },
            {
                "i": "62a62764-7448-46ca-b9de-8ca7990eb372",
                "x": 0,
                "y": 4,
                "w": 2,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Sensors by Status",
                    "description": "Share of sensors under this device in each state",
                    "timeframe": "none",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[containerSensors]}}",
                        "name": "containerSensors",
                        "pluginConfigId": "{{configId}}",
                        "group": {
                            "by": [
                                [
                                    "statusText",
                                    "uniqueValues"
                                ]
                            ],
                            "aggregate": [
                                {
                                    "type": "count"
                                }
                            ]
                        },
                        "sort": {
                            "by": [
                                [
                                    "count",
                                    "desc"
                                ]
                            ]
                        }
                    },
                    "scope": {
                        "scope": "{{scopes.[Devices]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Device]}}"
                    },
                    "variables": [
                        "{{variables.[Device]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "pie",
                            "encoding": {
                                "label": {
                                    "field": "statusText_uniqueValues",
                                    "type": "nominal",
                                    "title": "Status"
                                },
                                "value": {
                                    "field": "count",
                                    "type": "quantitative",
                                    "title": "Sensors"
                                }
                            },
                            "style": {
                                "pieInnerRadius": 60,
                                "pieDonutCenterValue": "total",
                                "pieLegendStyle": "table",
                                "mappedColors": {
                                    "Up": "#22c55e",
                                    "Warning": "#f5a524",
                                    "Unusual": "#8b5cf6",
                                    "Down": "#e5484d",
                                    "Down (Partial)": "#e5484d",
                                    "Down (Acknowledged)": "#b91c1c",
                                    "Paused": "#94a3b8",
                                    "Unknown": "#cbd5e1",
                                    "No Probe": "#94a3b8",
                                    "Not Licensed": "#94a3b8",
                                    "None": "#cbd5e1",
                                    "Scanning": "#3b82f6"
                                }
                            }
                        }
                    }
                }
            },
            {
                "i": "8764365c-0d8d-4629-b2f5-ea00fa313cc1",
                "x": 2,
                "y": 4,
                "w": 2,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Sensor Health",
                    "description": "Each sensor's state and last reading",
                    "timeframe": "none",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[containerSensors]}}",
                        "name": "containerSensors",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Devices]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Device]}}"
                    },
                    "variables": [
                        "{{variables.[Device]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "statusGrid",
                            "encoding": {
                                "label": {
                                    "field": "name",
                                    "type": "nominal"
                                },
                                "status": {
                                    "field": "status",
                                    "type": "nominal"
                                }
                            },
                            "style": {
                                "statusGridColumnsPerRow": 3,
                                "statusGridLabelWrap": true,
                                "statusGridSecondaryTemplate": "{{{{raw}}}}{{lastvalue}}{{{{/raw}}}}"
                            }
                        }
                    }
                }
            }
        ]
    }
}
