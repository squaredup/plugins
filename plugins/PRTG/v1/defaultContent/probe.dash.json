{
    "name": "Probe",
    "schemaVersion": "1.5",
    "timeframe": "last24hours",
    "variables": [
        "{{variables.[Probe]}}"
    ],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "baa06389-4177-4be5-8250-705039ec0be9",
                "x": 0,
                "y": 0,
                "w": 1,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Probe Details",
                    "description": "Properties of this probe as imported from PRTG",
                    "timeframe": "none",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "datastream-properties",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Probes]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Probe]}}"
                    },
                    "variables": [
                        "{{variables.[Probe]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {},
                            "style": {
                                "richTableTranspose": true,
                                "richTableCellPadding": 6
                            }
                        }
                    }
                }
            },
            {
                "i": "07606a01-c88f-4ceb-947c-c4a8f99cd53b",
                "x": 1,
                "y": 0,
                "w": 3,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Devices",
                    "description": "Devices under this probe, with the most sensors first",
                    "timeframe": "none",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[containerDevices]}}",
                        "name": "containerDevices",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [
                                [
                                    "totalsens_raw",
                                    "desc"
                                ]
                            ]
                        }
                    },
                    "scope": {
                        "scope": "{{scopes.[Probes]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Probe]}}"
                    },
                    "variables": [
                        "{{variables.[Probe]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "status",
                                        "title": "",
                                        "renderer": {
                                            "type": "status",
                                            "showLabel": false
                                        },
                                        "width": 30
                                    },
                                    {
                                        "field": "name",
                                        "title": "Device",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "host",
                                        "title": "Host",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "group",
                                        "title": "Group",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "totalsens_raw",
                                        "title": "Sensors",
                                        "renderer": {
                                            "type": "number"
                                        },
                                        "align": "right"
                                    },
                                    {
                                        "field": "downsens_raw",
                                        "title": "Down",
                                        "renderer": {
                                            "type": "number",
                                            "thresholds": [
                                                {
                                                    "to": 0,
                                                    "color": "#94a3b8"
                                                },
                                                {
                                                    "to": 1000000,
                                                    "color": "#e5484d"
                                                }
                                            ]
                                        },
                                        "align": "right"
                                    },
                                    {
                                        "field": "warnsens_raw",
                                        "title": "Warning",
                                        "renderer": {
                                            "type": "number",
                                            "thresholds": [
                                                {
                                                    "to": 0,
                                                    "color": "#94a3b8"
                                                },
                                                {
                                                    "to": 1000000,
                                                    "color": "#f5a524"
                                                }
                                            ]
                                        },
                                        "align": "right"
                                    }
                                ]
                            },
                            "style": {
                                "richTableCellPadding": 6
                            }
                        }
                    }
                }
            },
            {
                "i": "2357762b-9473-4786-b33f-5aa153f4c5b8",
                "x": 0,
                "y": 4,
                "w": 2,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Sensors by Status",
                    "description": "Share of sensors under this probe in each state",
                    "timeframe": "none",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[containerSensors]}}",
                        "name": "containerSensors",
                        "pluginConfigId": "{{configId}}",
                        "group": {
                            "by": [
                                [
                                    "statusText",
                                    "uniqueValues"
                                ]
                            ],
                            "aggregate": [
                                {
                                    "type": "count"
                                }
                            ]
                        },
                        "sort": {
                            "by": [
                                [
                                    "count",
                                    "desc"
                                ]
                            ]
                        }
                    },
                    "scope": {
                        "scope": "{{scopes.[Probes]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Probe]}}"
                    },
                    "variables": [
                        "{{variables.[Probe]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "pie",
                            "encoding": {
                                "label": {
                                    "field": "statusText_uniqueValues",
                                    "type": "nominal",
                                    "title": "Status"
                                },
                                "value": {
                                    "field": "count",
                                    "type": "quantitative",
                                    "title": "Sensors"
                                }
                            },
                            "style": {
                                "pieInnerRadius": 60,
                                "pieDonutCenterValue": "total",
                                "pieLegendStyle": "table",
                                "mappedColors": {
                                    "Up": "#22c55e",
                                    "Warning": "#f5a524",
                                    "Unusual": "#8b5cf6",
                                    "Down": "#e5484d",
                                    "Down (Partial)": "#e5484d",
                                    "Down (Acknowledged)": "#b91c1c",
                                    "Paused": "#94a3b8",
                                    "Unknown": "#cbd5e1",
                                    "No Probe": "#94a3b8",
                                    "Not Licensed": "#94a3b8",
                                    "None": "#cbd5e1",
                                    "Scanning": "#3b82f6"
                                }
                            }
                        }
                    }
                }
            },
            {
                "i": "69095342-c57d-45b7-b878-801fef0bb329",
                "x": 2,
                "y": 4,
                "w": 2,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Sensors Needing Attention",
                    "description": "Sensors under this probe that are not Up or Paused",
                    "timeframe": "none",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[containerSensors]}}",
                        "name": "containerSensors",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [
                                [
                                    "priority_raw",
                                    "desc"
                                ]
                            ]
                        },
                        "filter": {
                            "multiOperation": "and",
                            "filters": [
                                {
                                    "column": "statusText",
                                    "operation": "notequals",
                                    "value": "Up"
                                },
                                {
                                    "column": "statusText",
                                    "operation": "notequals",
                                    "value": "Paused"
                                }
                            ]
                        }
                    },
                    "scope": {
                        "scope": "{{scopes.[Probes]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Probe]}}"
                    },
                    "variables": [
                        "{{variables.[Probe]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "status",
                                        "title": "",
                                        "renderer": {
                                            "type": "status",
                                            "showLabel": false
                                        },
                                        "width": 30
                                    },
                                    {
                                        "field": "name",
                                        "title": "Sensor",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "device",
                                        "title": "Device",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "type",
                                        "title": "Type",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "lastvalue",
                                        "title": "Last Value",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "message_raw",
                                        "title": "Message",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableCellPadding": 6
                            }
                        }
                    }
                }
            }
        ]
    }
}
