{
    "name": "Sensor",
    "schemaVersion": "1.5",
    "timeframe": "last24hours",
    "variables": [
        "{{variables.[Sensor]}}"
    ],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "cbf63d04-ab31-4719-9d12-4508c228d203",
                "x": 0,
                "y": 0,
                "w": 1,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Sensor Details",
                    "description": "Properties of this sensor as imported from PRTG",
                    "timeframe": "none",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "datastream-properties",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Sensors]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Sensor]}}"
                    },
                    "variables": [
                        "{{variables.[Sensor]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {},
                            "style": {
                                "richTableTranspose": true,
                                "richTableCellPadding": 6
                            }
                        }
                    }
                }
            },
            {
                "i": "106790b9-2dbb-4c15-809f-fa7301be4eaa",
                "x": 1,
                "y": 0,
                "w": 3,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Channels",
                    "description": "The sensor's channels with their latest, minimum and maximum readings",
                    "timeframe": "none",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[sensorChannels]}}",
                        "name": "sensorChannels",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Sensors]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Sensor]}}"
                    },
                    "variables": [
                        "{{variables.[Sensor]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "name",
                                        "title": "Channel",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "lastValueFormatted",
                                        "title": "Last Value",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "minimum_raw",
                                        "title": "Minimum",
                                        "renderer": {
                                            "type": "number"
                                        },
                                        "align": "right"
                                    },
                                    {
                                        "field": "maximum_raw",
                                        "title": "Maximum",
                                        "renderer": {
                                            "type": "number"
                                        },
                                        "align": "right"
                                    }
                                ]
                            },
                            "style": {
                                "richTableCellPadding": 6
                            }
                        }
                    }
                }
            },
            {
                "i": "cd81bb9b-815f-4e70-95d0-6fdff5a3d1f2",
                "x": 0,
                "y": 4,
                "w": 4,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Channel History",
                    "description": "Readings for each channel over the dashboard timeframe. Gaps are periods with no data",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[sensorHistory]}}",
                        "name": "sensorHistory",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [
                                [
                                    "timestamp",
                                    "asc"
                                ]
                            ]
                        }
                    },
                    "scope": {
                        "scope": "{{scopes.[Sensors]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Sensor]}}"
                    },
                    "variables": [
                        "{{variables.[Sensor]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "line",
                            "encoding": {
                                "x": {
                                    "field": "timestamp",
                                    "type": "temporal"
                                },
                                "y": {
                                    "field": "value",
                                    "type": "quantitative",
                                    "title": "Value"
                                },
                                "series": {
                                    "field": "channel",
                                    "type": "nominal",
                                    "title": "Channel"
                                }
                            },
                            "style": {
                                "cartesianConnectNulls": false,
                                "legendPosition": "bottom"
                            }
                        }
                    }
                }
            }
        ]
    }
}
