{
    "steps": [
        {
            "name": "collections",
            "dataStream": { "name": "collections" },
            "timeframe": "none",
            "objectMapping": {
                "id": "name",
                "name": "displayName",
                "type": { "value": "Purview Collection" },
                "properties": [
                    "collectionName",
                    { "parentCollection": "parentCollectionName" },
                    "description"
                ]
            }
        },
        {
            "name": "dataSources",
            "dataStream": { "name": "listDataSources" },
            "timeframe": "none",
            "objectMapping": {
                "id": "name",
                "name": "name",
                "type": { "value": "Purview Data Source" },
                "properties": [
                    "kind",
                    "collection",
                    "endpoint",
                    "resourceGroup",
                    "subscriptionId"
                ]
            }
        },
        {
            "name": "governanceDomains",
            "dataStream": { "name": "governanceDomains" },
            "timeframe": "none",
            "objectMapping": {
                "id": "id",
                "name": "name",
                "type": { "value": "Purview Governance Domain" },
                "properties": [
                    "description",
                    "type",
                    "status"
                ]
            }
        },
        {
            "name": "scans",
            "dataStream": { "name": "dataSourceScans" },
            "scope": {
                "query": "g.V().has(\"sourceType\", \"Purview Data Source\")"
            },
            "dependsOn": ["dataSources"],
            "optional": true,
            "timeframe": "none",
            "objectMapping": {
                "id": "id",
                "name": "name",
                "type": { "value": "Purview Scan" },
                "properties": [
                    "kind",
                    "collection",
                    "dataSourceName"
                ]
            }
        }
    ]
}
