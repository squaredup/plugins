            "label": "Repository"
        },
        {
            "category": "documentation",
            "url": "https://github.com/squaredup/plugins/blob/main/plugins/OpenF1/v1/docs/README.md",
            "label": "Help adding this plugin"
        }
    ],
    "base": {
        "plugin": "WebAPI",
        "majorVersion": "1",
        "config": {
            "authMode": "none",
            "baseUrl": "https://api.openf1.org/v1"
