{
    "name": "Overview",
    "schemaVersion": "1.5",
    "timeframe": "none",
    "variables": [],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "bb9f3802-23ba-4b33-856b-4bb5733997c4",
                "x": 0,
                "y": 0,
                "w": 4,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Device Summary",
                    "description": "Devices enrolled in Intune, in total and for each main operating system",
                    "timeframe": "none",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[deviceSummary]}}",
                        "name": "deviceSummary",
                        "pluginConfigId": "{{configId}}"
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    {
                                        "field": "enrolledDeviceCount",
                                        "type": "quantitative",
                                        "title": "Enrolled Devices",
                                        "aggregate": "sum"
                                    },
                                    {
                                        "field": "deviceOperatingSystemSummary.windowsCount",
                                        "type": "quantitative",
                                        "title": "Windows",
                                        "aggregate": "sum"
                                    },
                                    {
                                        "field": "deviceOperatingSystemSummary.androidCount",
                                        "type": "quantitative",
                                        "title": "Android",
                                        "aggregate": "sum"
                                    },
                                    {
                                        "field": "deviceOperatingSystemSummary.iosCount",
                                        "type": "quantitative",
                                        "title": "iOS/iPadOS",
                                        "aggregate": "sum"
                                    },
                                    {
                                        "field": "deviceOperatingSystemSummary.macOSCount",
                                        "type": "quantitative",
                                        "title": "macOS",
                                        "aggregate": "sum"
                                    }
                                ]
                            },
                            "style": {
                                "scalarColumns": 5
                            }
                        }
                    }
                }
            },
