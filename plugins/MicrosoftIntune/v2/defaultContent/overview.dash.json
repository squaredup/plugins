                            "aggregate": [
                                {
                                    "type": "count"
                                }
                            ]
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "pie",
                            "encoding": {
                                "label": {
                                    "field": "complianceState_uniqueValues",
                                    "type": "nominal",
                                    "title": "Compliance State"
                                },
                                "value": {
                                    "field": "count",
                                    "type": "quantitative",
                                    "title": "Devices"
                                }
                            },
                            "style": {
                                "pieInnerRadius": 60,
                                "pieDonutCenterValue": "total",
                                "labelFontSize": 16,
                                "pieSort": "desc",
                                "mappedColors": {
                                    "compliant": "#16a34a",
                                    "inGracePeriod": "#f59e0b",
                                    "conflict": "#f59e0b",
                                    "configManager": "#f59e0b",
                                    "noncompliant": "#dc2626",
                                    "error": "#dc2626",
                                    "unknown": "#9ca3af",
                                    "success": "#16a34a",
                                    "warning": "#f59e0b"
                                }
                            }
                        }
                    }
                }
            },
            {
