                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Devices by Compliance State",
                    "description": "Managed devices grouped by their current compliance state",
                    "timeframe": "none",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[managedDevices]}}",
                        "name": "managedDevices",
                        "pluginConfigId": "{{configId}}",
                        "group": {
                            "by": [
                                [
                                    "complianceState",
                                    "uniqueValues"
                                ]
