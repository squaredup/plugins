{
    "name": "Enrollment and Apple Connectors",
    "schemaVersion": "1.5",
    "variables": [],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "758a0bc1-5b4c-47c5-ac29-163a5dce800a",
                "x": 0,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Apple Push Certificate",
                    "description": "Health and expiry of the Apple MDM push certificate",
                    "timeframe": "none",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[applePushCertificate]}}",
                        "name": "applePushCertificate",
                        "pluginConfigId": "{{configId}}"
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "statusGrid",
                            "encoding": {
                                "label": {
                                    "field": "appleIdentifier",
                                    "type": "nominal",
                                    "title": "Apple ID"
                                },
                                "status": {
                                    "field": "health",
                                    "type": "nominal",
                                    "title": "State"
                                }
                            },
                            "style": {
                                "statusGridColumnsPerRow": 1,
                                "statusGridLabelWrap": true,
                                "statusGridSecondaryTemplate": "{{{{raw}}}}Expires {{date expirationDateTime}}{{{{/raw}}}}"
                            }
                        }
                    }
                }
            },
            {
                "i": "d3e177d6-1274-41df-a47f-d189b30950c8",
                "x": 1,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Apple VPP Tokens",
                    "description": "Health and expiry of each Apple Volume Purchase Program token",
                    "timeframe": "none",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[appleVppTokens]}}",
                        "name": "appleVppTokens",
                        "pluginConfigId": "{{configId}}"
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "statusGrid",
                            "encoding": {
                                "label": {
                                    "field": "organizationName",
                                    "type": "nominal",
                                    "title": "Organization"
                                },
                                "status": {
                                    "field": "health",
                                    "type": "nominal",
                                    "title": "State"
                                }
                            },
                            "style": {
                                "statusGridColumnsPerRow": 1,
                                "statusGridLabelWrap": true,
                                "statusGridSecondaryTemplate": "{{{{raw}}}}Expires {{date expirationDateTime}}{{{{/raw}}}}"
                            }
                        }
                    }
                }
            },
            {
                "i": "6a744588-a7a7-49db-b63c-1ba988fcf375",
                "x": 2,
                "y": 0,
                "w": 2,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Apple Enrollment Tokens",
                    "description": "Health and expiry of each Apple Automated Device Enrollment token",
                    "timeframe": "none",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[appleEnrollmentTokens]}}",
                        "name": "appleEnrollmentTokens",
                        "pluginConfigId": "{{configId}}"
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "statusGrid",
                            "encoding": {
                                "label": {
                                    "field": "tokenName",
                                    "type": "nominal",
                                    "title": "Token"
                                },
                                "status": {
                                    "field": "health",
                                    "type": "nominal",
                                    "title": "State"
                                }
                            },
                            "style": {
                                "statusGridColumnsPerRow": 2,
                                "statusGridLabelWrap": true,
                                "statusGridSecondaryTemplate": "{{{{raw}}}}Expires {{date tokenExpirationDateTime}}{{{{/raw}}}}"
                            }
                        }
                    }
                }
            },
            {
                "i": "e27f7424-70f5-4953-9f80-175244023878",
                "x": 0,
                "y": 2,
                "w": 1,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Autopilot Devices by Enrollment State",
                    "description": "Windows Autopilot devices grouped by enrollment state",
                    "timeframe": "none",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[autopilotDevices]}}",
                        "name": "autopilotDevices",
                        "pluginConfigId": "{{configId}}",
                        "group": {
                            "by": [
                                [
                                    "enrollmentState",
                                    "uniqueValues"
                                ]
                            ],
                            "aggregate": [
                                {
                                    "type": "count"
                                }
                            ]
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "pie",
                            "encoding": {
                                "label": {
                                    "field": "enrollmentState_uniqueValues",
                                    "type": "nominal",
                                    "title": "Enrollment State"
                                },
                                "value": {
                                    "field": "count",
                                    "type": "quantitative",
                                    "title": "Devices"
                                }
                            },
                            "style": {
                                "pieInnerRadius": 60,
                                "pieDonutCenterValue": "total",
                                "labelFontSize": 16,
                                "pieSort": "desc",
                                "mappedColors": {
                                    "enrolled": "#16a34a",
                                    "pendingReset": "#f59e0b",
                                    "notContacted": "#f59e0b",
                                    "failed": "#dc2626",
                                    "blocked": "#dc2626",
                                    "unknown": "#9ca3af",
                                    "success": "#16a34a",
                                    "warning": "#f59e0b",
                                    "error": "#dc2626"
                                }
                            }
                        }
                    }
                }
            },
            {
                "i": "32fcc57f-7cc8-402e-8303-e4a3f5afa5c0",
                "x": 1,
                "y": 2,
                "w": 3,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Autopilot Devices",
                    "description": "Windows Autopilot device identities with their enrollment state and deployment profile assignment",
                    "timeframe": "none",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[autopilotDevices]}}",
                        "name": "autopilotDevices",
                        "pluginConfigId": "{{configId}}"
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "enrollmentState",
                                        "title": "Enrollment State",
                                        "renderer": {
                                            "type": "status"
                                        }
                                    },
                                    {
                                        "field": "serialNumber",
                                        "title": "Serial Number",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "manufacturer",
                                        "title": "Manufacturer",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "model",
                                        "title": "Model",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "groupTag",
                                        "title": "Group Tag",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "deploymentProfileAssignmentStatus",
                                        "title": "Profile Assignment",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "userPrincipalName",
                                        "title": "User Principal Name",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "lastContacted",
                                        "title": "Last Contacted",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    }
                                ]
                            }
                        }
                    }
                }
            },
            {
                "i": "e2cacd45-62db-4953-b64d-256881b162ed",
                "x": 0,
                "y": 5,
                "w": 4,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Autopilot Deployments",
                    "description": "Recent Windows Autopilot deployments with their outcome, duration and any failure details",
                    "timeframe": "none",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[autopilotDeployments]}}",
                        "name": "autopilotDeployments",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [
                                [
                                    "deploymentStartDateTime",
                                    "desc"
                                ]
                            ]
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "deploymentState",
                                        "title": "Deployment State",
                                        "renderer": {
                                            "type": "status"
                                        }
                                    },
                                    {
                                        "field": "managedDeviceName",
                                        "title": "Device Name",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "windowsAutopilotDeploymentProfileDisplayName",
                                        "title": "Deployment Profile",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "enrollmentType",
                                        "title": "Enrollment Type",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "deploymentStartDateTime",
                                        "title": "Deployment Start",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    },
                                    {
                                        "field": "totalDurationSeconds",
                                        "title": "Total Duration",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "enrollmentFailureDetails",
                                        "title": "Failure Details",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    }
                                ]
                            }
                        }
                    }
                }
            },
            {
                "i": "b5dbc52b-8a30-4af6-9bac-7311d736cbfb",
                "x": 0,
                "y": 9,
                "w": 4,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Enrollment Configurations",
                    "description": "Device enrollment restrictions, limits and Windows Hello settings, in priority order",
                    "timeframe": "none",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[enrollmentConfigurations]}}",
                        "name": "enrollmentConfigurations",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [
                                [
                                    "priority",
                                    "asc"
                                ]
                            ]
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "displayName",
                                        "title": "Name",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "type",
                                        "title": "Type",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "priority",
                                        "title": "Priority",
                                        "renderer": {
                                            "type": "number"
                                        },
                                        "align": "right"
                                    },
                                    {
                                        "field": "limit",
                                        "title": "Device Limit",
                                        "renderer": {
                                            "type": "number"
                                        },
                                        "align": "right"
                                    },
                                    {
                                        "field": "description",
                                        "title": "Description",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "lastModifiedDateTime",
                                        "title": "Last Modified",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    }
                                ]
                            }
                        }
                    }
                }
            }
        ]
    }
}
