                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "displayName",
                                        "title": "Profile",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "releaseDateDisplayName",
                                        "title": "Release",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "deployableContentDisplayName",
                                        "title": "Deployable Content",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "expeditedUpdateSettings.qualityUpdateRelease",
                                        "title": "Expedited Release",
                                        "renderer": {
