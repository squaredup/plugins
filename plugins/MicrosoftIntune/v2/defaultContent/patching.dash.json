                                        }
                                    },
                                    {
                                        "field": "expeditedUpdateSettings.daysUntilForcedReboot",
                                        "title": "Days Until Forced Reboot",
                                        "renderer": {
                                            "type": "number"
                                        },
                                        "align": "right"
                                    },
                                    {
                                        "field": "lastModifiedDateTime",
                                        "title": "Last Modified",
                                        "renderer": {
                                            "type": "date"
                                        }
                                    }
                                ]
                            }
                        }
                    }
                }
            },
            {
                "i": "2c08efe8-de5a-4e73-b340-213709925fa0",
                "x": 0,
                "y": 16,
                "w": 4,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Driver Update Profiles",
                    "description": "Windows driver update profiles with their approval type and inventory sync state, failed syncs first",
                    "timeframe": "none",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[driverUpdateProfiles]}}",
                        "name": "driverUpdateProfiles",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [
                                [
                                    "statusRank",
                                    "asc"
                                ],
                                [
                                    "displayName",
                                    "asc"
                                ]
                            ]
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "syncState",
                                        "title": "State",
                                        "renderer": {
                                            "type": "status"
                                        }
                                    },
                                    {
                                        "field": "displayName",
                                        "title": "Profile",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "approvalType",
                                        "title": "Approval Type",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "newUpdates",
                                        "title": "New Updates",
                                        "renderer": {
                                            "type": "number"
                                        },
                                        "align": "right"
                                    },
                                    {
                                        "field": "deviceReporting",
