{
    "name": "Compliance Policy",
    "schemaVersion": "1.5",
    "timeframe": "none",
    "variables": [
        "{{variables.[Compliance Policy]}}"
    ],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "df8cf225-de1a-4375-9e54-754a4f21baea",
                "x": 0,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Deployment State",
                    "description": "Overall deployment state of this compliance policy and when Intune last updated it",
                    "timeframe": "none",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[compliancePolicyOverview]}}",
                        "name": "compliancePolicyOverview",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Compliance Policies]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Compliance Policy]}}"
                    },
                    "variables": [
                        "{{variables.[Compliance Policy]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "statusGrid",
                            "encoding": {
                                "label": {
                                    "field": "policyName",
                                    "type": "nominal",
                                    "title": "Policy"
                                },
                                "status": {
                                    "field": "state",
                                    "type": "nominal",
                                    "title": "State"
                                }
                            },
                            "style": {
                                "statusGridColumnsPerRow": 1,
                                "statusGridLabelWrap": true,
                                "statusGridSecondaryTemplate": "{{{{raw}}}}Updated {{date lastUpdateDateTime}}{{{{/raw}}}}"
                            }
                        }
                    }
                }
            },
            {
                "i": "cc0abe20-10fa-435c-8324-fa4a0ea3eaa8",
                "x": 1,
                "y": 0,
                "w": 3,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Device Counts",
                    "description": "Devices in each deployment state for this compliance policy",
                    "timeframe": "none",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[compliancePolicyOverview]}}",
                        "name": "compliancePolicyOverview",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Compliance Policies]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Compliance Policy]}}"
                    },
                    "variables": [
                        "{{variables.[Compliance Policy]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    {
                                        "field": "successCount",
                                        "type": "quantitative",
                                        "title": "Succeeded",
                                        "aggregate": "sum"
                                    },
                                    {
                                        "field": "errorCount",
                                        "type": "quantitative",
                                        "title": "Errors",
                                        "aggregate": "sum"
                                    },
                                    {
                                        "field": "failedCount",
                                        "type": "quantitative",
                                        "title": "Failed",
                                        "aggregate": "sum"
                                    },
                                    {
                                        "field": "pendingCount",
                                        "type": "quantitative",
                                        "title": "Pending",
                                        "aggregate": "sum"
                                    },
                                    {
                                        "field": "notApplicableCount",
                                        "type": "quantitative",
                                        "title": "Not Applicable",
                                        "aggregate": "sum"
                                    }
                                ]
                            },
                            "style": {
                                "scalarColumns": 5
                            }
                        }
                    }
                }
            },
            {
                "i": "9e9bc1db-65d3-48a6-9504-d46776d64798",
                "x": 0,
                "y": 2,
                "w": 1,
                "h": 5,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Properties",
                    "description": "Properties imported for this compliance policy",
                    "timeframe": "none",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "datastream-properties",
                        "name": "properties",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Compliance Policies]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Compliance Policy]}}"
                    },
                    "variables": [
                        "{{variables.[Compliance Policy]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "platform",
                                        "title": "Platform",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "description",
                                        "title": "Description",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "version",
                                        "title": "Version",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "createdDateTime",
                                        "title": "Created",
                                        "renderer": {
                                            "type": "date"
                                        }
                                    },
                                    {
                                        "field": "lastModifiedDateTime",
                                        "title": "Last Modified",
                                        "renderer": {
                                            "type": "date"
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableTranspose": true,
                                "richTableCellPadding": 6,
                                "richTableWrapText": true
                            }
                        }
                    }
                }
            },
            {
                "i": "9dfbf7e4-c9a0-4115-b8da-41a8aa0bcce3",
                "x": 1,
                "y": 2,
                "w": 3,
                "h": 5,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Device Statuses",
                    "description": "Status of each device targeted by this compliance policy, problems first (unknown statuses are hidden)",
                    "timeframe": "none",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[compliancePolicyDeviceStatuses]}}",
                        "name": "compliancePolicyDeviceStatuses",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [
                                [
                                    "statusRank",
                                    "asc"
                                ]
                            ]
                        }
                    },
                    "scope": {
                        "scope": "{{scopes.[Compliance Policies]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Compliance Policy]}}"
                    },
                    "variables": [
                        "{{variables.[Compliance Policy]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "status",
                                        "title": "Status",
                                        "renderer": {
                                            "type": "status"
                                        }
                                    },
                                    {
                                        "field": "deviceName",
                                        "title": "Device",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "userName",
                                        "title": "User",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "userPrincipalName",
                                        "title": "User Principal Name",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "lastReportedDateTime",
                                        "title": "Last Reported",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    },
                                    {
                                        "field": "gracePeriodExpirationDateTime",
                                        "title": "Grace Period Ends",
                                        "renderer": {
                                            "type": "date"
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableRowHighlight": {
                                    "field": "status",
                                    "colors": {
                                        "nonCompliant": "rgba(239,68,68,0.12)",
                                        "error": "rgba(239,68,68,0.12)",
                                        "conflict": "rgba(245,158,11,0.12)",
                                        "warning": "rgba(245,158,11,0.12)"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        ]
    }
}
