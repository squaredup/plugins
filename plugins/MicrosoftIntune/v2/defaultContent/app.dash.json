{
    "name": "App",
    "schemaVersion": "1.5",
    "timeframe": "none",
    "variables": [
        "{{variables.[App]}}"
    ],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "dc921382-5c48-4168-b136-149479750b30",
                "x": 0,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Install State",
                    "description": "Overall install state of this app and how many devices failed to install it",
                    "timeframe": "none",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[appInstallSummary]}}",
                        "name": "appInstallSummary",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Apps]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[App]}}"
                    },
                    "variables": [
                        "{{variables.[App]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "statusGrid",
                            "encoding": {
                                "label": {
                                    "field": "appName",
                                    "type": "nominal",
                                    "title": "App"
                                },
                                "status": {
                                    "field": "state",
                                    "type": "nominal",
                                    "title": "State"
                                }
                            },
                            "style": {
                                "statusGridColumnsPerRow": 1,
                                "statusGridLabelWrap": true,
                                "statusGridSecondaryTemplate": "{{{{raw}}}}{{failedDeviceCount}} failed{{{{/raw}}}}"
                            }
                        }
                    }
                }
            },
            {
                "i": "f9cf344c-c05d-48b5-9327-d34b4657920e",
                "x": 1,
                "y": 0,
                "w": 3,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Device Counts",
                    "description": "Devices in each install status for this app",
                    "timeframe": "none",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[appInstallSummary]}}",
                        "name": "appInstallSummary",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Apps]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[App]}}"
                    },
                    "variables": [
                        "{{variables.[App]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    {
                                        "field": "installedDeviceCount",
                                        "type": "quantitative",
                                        "title": "Installed",
                                        "aggregate": "sum"
                                    },
                                    {
                                        "field": "failedDeviceCount",
                                        "type": "quantitative",
                                        "title": "Failed",
                                        "aggregate": "sum"
                                    },
                                    {
                                        "field": "pendingInstallDeviceCount",
                                        "type": "quantitative",
                                        "title": "Pending",
                                        "aggregate": "sum"
                                    },
                                    {
                                        "field": "notInstalledDeviceCount",
                                        "type": "quantitative",
                                        "title": "Not Installed",
                                        "aggregate": "sum"
                                    },
                                    {
                                        "field": "notApplicableDeviceCount",
                                        "type": "quantitative",
                                        "title": "Not Applicable",
                                        "aggregate": "sum"
                                    }
                                ]
                            },
                            "style": {
                                "scalarColumns": 5
                            }
                        }
                    }
                }
            },
            {
                "i": "29de6c08-5d74-456b-808a-0910b235d037",
                "x": 0,
                "y": 2,
                "w": 1,
                "h": 5,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Properties",
                    "description": "Properties imported for this app",
                    "timeframe": "none",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "datastream-properties",
                        "name": "properties",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Apps]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[App]}}"
                    },
                    "variables": [
                        "{{variables.[App]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "appType",
                                        "title": "App Type",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "platform",
                                        "title": "Platform",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "publisher",
                                        "title": "Publisher",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "version",
                                        "title": "Version",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "isAssigned",
                                        "title": "Assigned",
                                        "renderer": {
                                            "type": "boolean",
                                            "trueLabel": "Yes",
                                            "falseLabel": "No"
                                        }
                                    },
                                    {
                                        "field": "createdDateTime",
                                        "title": "Created",
                                        "renderer": {
                                            "type": "date"
                                        }
                                    },
                                    {
                                        "field": "lastModifiedDateTime",
                                        "title": "Last Modified",
                                        "renderer": {
                                            "type": "date"
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableTranspose": true,
                                "richTableCellPadding": 6,
                                "richTableWrapText": true
                            }
                        }
                    }
                }
            },
            {
                "i": "42926d4c-698a-4430-bed1-65a47cab92a3",
                "x": 1,
                "y": 2,
                "w": 3,
                "h": 5,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Device Statuses",
                    "description": "Install state of this app on each device it targets, failed installs first",
                    "timeframe": "none",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[appDeviceStatuses]}}",
                        "name": "appDeviceStatuses",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [
                                [
                                    "statusRank",
                                    "asc"
                                ],
                                [
                                    "deviceName",
                                    "asc"
                                ]
                            ]
                        }
                    },
                    "scope": {
                        "scope": "{{scopes.[Apps]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[App]}}"
                    },
                    "variables": [
                        "{{variables.[App]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "installState",
                                        "title": "Install State",
                                        "renderer": {
                                            "type": "status"
                                        }
                                    },
                                    {
                                        "field": "deviceName",
                                        "title": "Device",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "userPrincipalName",
                                        "title": "User Principal Name",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "platform",
                                        "title": "Platform",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "appVersion",
                                        "title": "App Version",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "installStateDetail",
                                        "title": "Install State Detail",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "errorCode",
                                        "title": "Error Code",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "lastModifiedDateTime",
                                        "title": "Last Modified",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableRowHighlight": {
                                    "field": "installState",
                                    "colors": {
                                        "failed": "rgba(239,68,68,0.12)",
                                        "uninstallFailed": "rgba(239,68,68,0.12)",
                                        "pendingInstall": "rgba(245,158,11,0.12)"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        ]
    }
}
