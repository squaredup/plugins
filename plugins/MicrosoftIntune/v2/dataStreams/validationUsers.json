{
    "name": "validationUsers",
    "displayName": "Validation - Users",
    "description": "Checks read access to users when Index users is on",
    "tags": ["Validation"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "{{ dataSource.indexUsers === true || dataSource.indexUsers === 'true' ? 'v1.0/users' : 'v1.0/deviceManagement/managedDevices' }}",
        "getArgs": [
            { "key": "$select", "value": "id" },
            { "key": "$top", "value": "1" }
        ],
        "paging": { "mode": "none" },
        "pathToData": "value",
        "errorHandling": { "type": "script", "script": "errorHandling/microsoftGraphApi.js" }
    },
    "matches": "none",
    "timeframes": false,
    "providesPluginDiagnostics": true,
    "visibility": { "type": "hidden" }
}
