{
    "name": "deviceAppStatuses",
    "displayName": "Device App Statuses",
    "description": "Install state and assignment intent of each app targeted at the selected managed device and its primary user (beta API)",
    "tags": ["Apps"],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "beta/users/{{object.userId}}/mobileAppIntentAndStates/{{object.rawId}}",
        "paging": { "mode": "none" },
        "postRequestScript": "deviceAppStatuses.js",
        "errorHandling": { "type": "script", "script": "errorHandling/microsoftGraphApi.js" }
    },
    "matches": { "sourceType": { "type": "oneOf", "values": ["Managed Device"] } },
    "metadata": [
        {
            "name": "installState",
            "displayName": "Install State",
            "shape": [
                "state",
                {
                    "map": {
                        "success": ["installed"],
                        "warning": ["pendingInstall"],
                        "error": ["failed", "uninstallFailed"],
                        "unknown": ["unknown", "notInstalled", "notApplicable"]
                    }
                }
            ]
        },
        {
            "name": "statusRank",
            "displayName": "Status Rank",
            "shape": "number",
            "visible": false
        },
        {
            "name": "appName",
            "displayName": "App",
            "shape": "string",
            "role": "label",
            "sourceId": "appId",
            "sourceType": "App"
        },
        {
            "name": "appId",
            "displayName": "App ID",
            "shape": "string",
            "visible": false
        },
        {
            "name": "appVersion",
            "displayName": "App Version",
            "shape": "string"
        },
        {
            "name": "intent",
            "displayName": "Assignment Intent",
            "shape": "string"
        },
        {
            "name": "deviceName",
            "displayName": "Managed Device",
            "shape": "string",
            "sourceId": "deviceId",
            "sourceType": "Managed Device"
        },
        {
            "name": "deviceId",
            "displayName": "Device ID",
            "shape": "string",
            "visible": false
        }
    ],
    "defaultShaping": { "sort": { "by": [["statusRank", "asc"], ["appName", "asc"]] } },
    "timeframes": false
}
