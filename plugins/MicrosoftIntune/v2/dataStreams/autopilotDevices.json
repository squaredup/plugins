{
    "name": "autopilotDevices",
    "displayName": "Autopilot Devices",
    "description": "Windows Autopilot device identities with their enrollment state, group tag and profile assignment",
    "tags": ["Enrollment"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "v1.0/deviceManagement/windowsAutopilotDeviceIdentities",
        "paging": {
            "mode": "nextUrl",
            "in": { "realm": "payload", "path": "@odata.nextLink" }
        },
        "pathToData": "value",
        "errorHandling": { "type": "script", "script": "errorHandling/microsoftGraphApi.js" }
    },
    "matches": "none",
    "metadata": [
        {
            "name": "enrollmentState",
            "displayName": "Enrollment State",
            "shape": [
                "state",
                {
                    "map": {
                        "success": ["enrolled"],
                        "warning": ["pendingReset", "notContacted"],
                        "error": ["failed", "blocked"],
                        "unknown": ["unknown"]
                    }
                }
            ]
        },
        {
            "name": "serialNumber",
            "displayName": "Serial Number",
            "shape": "string",
            "role": "label",
            "sourceId": "managedDeviceRef",
            "sourceType": "Managed Device"
        },
        { "name": "manufacturer", "displayName": "Manufacturer", "shape": "string" },
        { "name": "model", "displayName": "Model", "shape": "string" },
        { "name": "groupTag", "displayName": "Group Tag", "shape": "string" },
        {
            "name": "deploymentProfileAssignmentStatus",
            "displayName": "Profile Assignment",
            "shape": "string"
        },
        {
            "name": "profileAssigned",
            "displayName": "Profile Assigned",
            "shape": "date",
            "computed": true,
            "valueExpression": "{{ (() => { const v = $['deploymentProfileAssignedDateTime']; if (v === null || v === undefined || v === '' || (typeof v === 'object' && v.__isNone)) { return null; } const t = new Date(v).getTime(); return isNaN(t) || new Date(t).getUTCFullYear() <= 1901 ? null : new Date(t).toISOString(); })() }}"
        },
        {
            "name": "lastContacted",
            "displayName": "Last Contacted",
            "shape": "date",
            "computed": true,
            "valueExpression": "{{ (() => { const v = $['lastContactedDateTime']; if (v === null || v === undefined || v === '' || (typeof v === 'object' && v.__isNone)) { return null; } const t = new Date(v).getTime(); return isNaN(t) || new Date(t).getUTCFullYear() <= 1901 ? null : new Date(t).toISOString(); })() }}"
        },
        { "name": "userPrincipalName", "displayName": "User Principal Name", "shape": "string" },
        { "name": "addressableUserName", "displayName": "Addressable User Name", "shape": "string" },
        { "name": "purchaseOrderIdentifier", "displayName": "Purchase Order", "shape": "string" },
        { "name": "displayName", "displayName": "Display Name", "shape": "string" },
        {
            "name": "managedDeviceRef",
            "displayName": "Managed Device ID",
            "shape": "string",
            "computed": true,
            "visible": false,
            "valueExpression": "{{ (() => { const v = $['managedDeviceId']; const s = typeof v === 'string' ? v.trim() : ''; return s && !/^[0-]+$/.test(s) ? s : null; })() }}"
        },
        {
            "name": "entraDeviceId",
            "displayName": "Entra Device ID",
            "shape": "string",
            "computed": true,
            "visible": false,
            "valueExpression": "{{ (() => { const v = $['azureActiveDirectoryDeviceId']; const s = typeof v === 'string' ? v.trim() : ''; return s && !/^[0-]+$/.test(s) ? s : null; })() }}"
        },
        {
            "name": "deploymentProfileAssignedDateTime",
            "displayName": "Profile Assigned (Raw)",
            "shape": "date",
            "visible": false
        },
        { "name": "lastContactedDateTime", "displayName": "Last Contacted (Raw)", "shape": "date", "visible": false },
        { "name": "managedDeviceId", "displayName": "Managed Device ID (Raw)", "shape": "string", "visible": false },
        {
            "name": "azureActiveDirectoryDeviceId",
            "displayName": "Entra Device ID (Raw)",
            "shape": "string",
            "visible": false
        },
        { "name": "id", "displayName": "ID", "shape": "string", "visible": false }
    ],
    "defaultShaping": { "sort": { "by": [["serialNumber", "asc"]] } },
    "timeframes": false
}
