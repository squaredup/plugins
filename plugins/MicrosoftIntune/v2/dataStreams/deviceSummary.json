{
    "name": "deviceSummary",
    "displayName": "Device Summary",
    "description": "Number of enrolled devices in the tenant by enrollment type, operating system and Exchange access state (beta API)",
    "tags": ["Devices"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "beta/deviceManagement/managedDeviceOverview",
        "paging": { "mode": "none" },
        "expandInnerObjects": true,
        "errorHandling": { "type": "script", "script": "errorHandling/microsoftGraphApi.js" }
    },
    "matches": "none",
    "metadata": [
        { "name": "enrolledDeviceCount", "displayName": "Enrolled Devices", "shape": "number" },
        { "name": "mdmEnrolledCount", "displayName": "MDM Enrolled", "shape": "number" },
        { "name": "dualEnrolledDeviceCount", "displayName": "Dual Enrolled", "shape": "number" },
        { "name": "deviceOperatingSystemSummary.windowsCount", "displayName": "Windows", "shape": "number" },
        { "name": "deviceOperatingSystemSummary.androidCount", "displayName": "Android", "shape": "number" },
        { "name": "deviceOperatingSystemSummary.iosCount", "displayName": "iOS/iPadOS", "shape": "number" },
        { "name": "deviceOperatingSystemSummary.macOSCount", "displayName": "macOS", "shape": "number" },
        { "name": "deviceOperatingSystemSummary.linuxCount", "displayName": "Linux", "shape": "number" },
        { "name": "deviceOperatingSystemSummary.chromeOSCount", "displayName": "ChromeOS", "shape": "number" },
        { "name": "deviceOperatingSystemSummary.windowsMobileCount", "displayName": "Windows Mobile", "shape": "number" },
        { "name": "deviceOperatingSystemSummary.unknownCount", "displayName": "Unknown", "shape": "number" },
        { "name": "deviceOperatingSystemSummary.androidDeviceAdminCount", "displayName": "Android Device Administrator", "shape": "number" },
        { "name": "deviceOperatingSystemSummary.androidWorkProfileCount", "displayName": "Android Personal Work Profile", "shape": "number" },
        { "name": "deviceOperatingSystemSummary.androidCorporateWorkProfileCount", "displayName": "Android Corporate Work Profile", "shape": "number" },
        { "name": "deviceOperatingSystemSummary.androidFullyManagedCount", "displayName": "Android Fully Managed", "shape": "number" },
        { "name": "deviceOperatingSystemSummary.androidDedicatedCount", "displayName": "Android Dedicated", "shape": "number" },
        { "name": "deviceOperatingSystemSummary.aospUserAssociatedCount", "displayName": "AOSP User Associated", "shape": "number" },
        { "name": "deviceOperatingSystemSummary.aospUserlessCount", "displayName": "AOSP Userless", "shape": "number" },
        { "name": "deviceOperatingSystemSummary.configMgrDeviceCount", "displayName": "Configuration Manager", "shape": "number" },
        { "name": "deviceExchangeAccessStateSummary.allowedDeviceCount", "displayName": "Exchange Allowed", "shape": "number" },
        { "name": "deviceExchangeAccessStateSummary.blockedDeviceCount", "displayName": "Exchange Blocked", "shape": "number" },
        { "name": "deviceExchangeAccessStateSummary.quarantinedDeviceCount", "displayName": "Exchange Quarantined", "shape": "number" },
        { "name": "deviceExchangeAccessStateSummary.unknownDeviceCount", "displayName": "Exchange Unknown", "shape": "number" },
        { "name": "deviceExchangeAccessStateSummary.unavailableDeviceCount", "displayName": "Exchange Unavailable", "shape": "number" }
    ],
    "timeframes": false
}
