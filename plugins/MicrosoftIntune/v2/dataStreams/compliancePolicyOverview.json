{
    "name": "compliancePolicyOverview",
    "displayName": "Compliance Policy Overview",
    "description": "Device counts by status for the selected compliance policy",
    "tags": ["Compliance"],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "beta/deviceManagement/deviceCompliancePolicies/{{object.rawId}}/deviceStatusOverview",
        "paging": { "mode": "none" },
        "postRequestScript": "policyOverview.js",
        "errorHandling": { "type": "script", "script": "errorHandling/microsoftGraphApi.js" }
    },
    "matches": { "sourceType": { "type": "oneOf", "values": ["Compliance Policy"] } },
    "metadata": [
        {
            "name": "state",
            "displayName": "State",
            "shape": "state"
        },
        {
            "name": "policyName",
            "displayName": "Policy",
            "shape": "string",
            "role": "label",
            "sourceId": "policyId",
            "sourceType": "Compliance Policy"
        },
        {
            "name": "policyId",
            "displayName": "Policy ID",
            "shape": "string",
            "visible": false
        },
        {
            "name": "successCount",
            "displayName": "Succeeded",
            "shape": "number",
            "role": "value"
        },
        {
            "name": "errorCount",
            "displayName": "Errors",
            "shape": "number"
        },
        {
            "name": "failedCount",
            "displayName": "Failed",
            "shape": "number"
        },
        {
            "name": "pendingCount",
            "displayName": "Pending",
            "shape": "number"
        },
        {
            "name": "notApplicableCount",
            "displayName": "Not Applicable",
            "shape": "number"
        },
        {
            "name": "lastUpdateDateTime",
            "displayName": "Last Updated",
            "shape": "date"
        },
        {
            "name": "configurationVersion",
            "displayName": "Configuration Version",
            "shape": ["number", { "thousandsSeparator": false }]
        }
    ],
    "timeframes": false
}
