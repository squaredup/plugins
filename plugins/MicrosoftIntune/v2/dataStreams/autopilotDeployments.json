{
    "name": "autopilotDeployments",
    "displayName": "Autopilot Deployments",
    "description": "Windows Autopilot deployment results with their state, duration and failure details (beta API, recent deployments only)",
    "tags": ["Enrollment"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "beta/deviceManagement/autopilotEvents",
        "paging": {
            "mode": "nextUrl",
            "in": { "realm": "payload", "path": "@odata.nextLink" }
        },
        "pathToData": "value",
        "errorHandling": { "type": "script", "script": "errorHandling/microsoftGraphApi.js" }
    },
    "matches": "none",
    "metadata": [
        {
            "name": "deploymentState",
            "displayName": "Deployment State",
            "shape": [
                "state",
                {
                    "map": {
                        "success": ["success", "successOnRetry"],
                        "warning": ["inProgress", "successWithTimeout"],
                        "error": ["failure"],
                        "unknown": ["unknown", "notAttempted", "disabled"]
                    }
                }
            ]
        },
        {
            "name": "managedDeviceName",
            "displayName": "Device Name",
            "shape": "string",
            "role": "label",
            "sourceId": "deviceId",
            "sourceType": "Managed Device"
        },
        { "name": "deviceSerialNumber", "displayName": "Serial Number", "shape": "string" },
        {
            "name": "windowsAutopilotDeploymentProfileDisplayName",
            "displayName": "Deployment Profile",
            "shape": "string"
        },
        { "name": "enrollmentType", "displayName": "Enrollment Type", "shape": "string" },
        { "name": "userPrincipalName", "displayName": "User Principal Name", "shape": "string" },
        { "name": "osVersion", "displayName": "OS Version", "shape": "string" },
        { "name": "deploymentStartDateTime", "displayName": "Deployment Start", "shape": "date" },
        { "name": "deploymentEndDateTime", "displayName": "Deployment End", "shape": "date" },
        {
            "name": "totalDurationSeconds",
            "displayName": "Total Duration",
            "computed": true,
            "valueExpression": "{{ (() => { const m = /^P(?:([0-9]+)D)?(?:T(?:([0-9]+)H)?(?:([0-9]+)M)?(?:([0-9.]+)S)?)?$/.exec($['deploymentTotalDuration'] || ''); return m ? Number(m[1] || 0) * 86400 + Number(m[2] || 0) * 3600 + Number(m[3] || 0) * 60 + Number(m[4] || 0) : null; })() }}",
            "shape": ["seconds", { "formatDuration": true }]
        },
        {
            "name": "deviceSetupDurationSeconds",
            "displayName": "Device Setup Duration",
            "computed": true,
            "valueExpression": "{{ (() => { const m = /^P(?:([0-9]+)D)?(?:T(?:([0-9]+)H)?(?:([0-9]+)M)?(?:([0-9.]+)S)?)?$/.exec($['deviceSetupDuration'] || ''); return m ? Number(m[1] || 0) * 86400 + Number(m[2] || 0) * 3600 + Number(m[3] || 0) * 60 + Number(m[4] || 0) : null; })() }}",
            "shape": ["seconds", { "formatDuration": true }]
        },
        {
            "name": "accountSetupDurationSeconds",
            "displayName": "Account Setup Duration",
            "computed": true,
            "valueExpression": "{{ (() => { const m = /^P(?:([0-9]+)D)?(?:T(?:([0-9]+)H)?(?:([0-9]+)M)?(?:([0-9.]+)S)?)?$/.exec($['accountSetupDuration'] || ''); return m ? Number(m[1] || 0) * 86400 + Number(m[2] || 0) * 3600 + Number(m[3] || 0) * 60 + Number(m[4] || 0) : null; })() }}",
            "shape": ["seconds", { "formatDuration": true }]
        },
        { "name": "deviceSetupStatus", "displayName": "Device Setup Status", "shape": "string" },
        { "name": "accountSetupStatus", "displayName": "Account Setup Status", "shape": "string" },
        { "name": "enrollmentState", "displayName": "Enrollment State", "shape": "string" },
        { "name": "enrollmentFailureDetails", "displayName": "Failure Details", "shape": "string" },
        { "name": "deviceRegisteredDateTime", "displayName": "Registered", "shape": "date" },
        { "name": "eventDateTime", "displayName": "Event Time", "shape": "date" },
        { "name": "deploymentTotalDuration", "displayName": "Total Duration (ISO 8601)", "shape": "string", "visible": false },
        { "name": "deviceSetupDuration", "displayName": "Device Setup Duration (ISO 8601)", "shape": "string", "visible": false },
        { "name": "accountSetupDuration", "displayName": "Account Setup Duration (ISO 8601)", "shape": "string", "visible": false },
        { "name": "deviceId", "displayName": "Managed Device ID", "shape": "string", "visible": false },
        { "name": "id", "displayName": "ID", "shape": "string", "visible": false }
    ],
    "defaultShaping": { "sort": { "by": [["deploymentStartDateTime", "desc"]] } },
    "timeframes": false
}
