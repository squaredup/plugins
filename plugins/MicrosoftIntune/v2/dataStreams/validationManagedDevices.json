{
    "name": "validationManagedDevices",
    "displayName": "Validation - Managed Devices",
    "description": "Checks read access to managed devices",
    "tags": ["Validation"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "v1.0/deviceManagement/managedDevices",
        "getArgs": [
            { "key": "$select", "value": "id" },
            { "key": "$top", "value": "1" }
        ],
        "paging": { "mode": "none" },
        "pathToData": "value",
        "errorHandling": { "type": "script", "script": "errorHandling/microsoftGraphApi.js" }
    },
    "matches": "none",
    "timeframes": false,
    "providesPluginDiagnostics": true,
    "visibility": { "type": "hidden" }
}
