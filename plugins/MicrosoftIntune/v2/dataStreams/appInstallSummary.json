{
    "name": "appInstallSummary",
    "displayName": "App Install Summary",
    "description": "Device and user install counts by status for the selected app (beta report)",
    "tags": ["Apps"],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "post",
        "endpointPath": "beta/deviceManagement/reports/getAppStatusOverviewReport",
        "postBody": {
            "filter": "(ApplicationId eq '{{object.rawId}}')"
        },
        "paging": { "mode": "none" },
        "postRequestScript": "appInstallSummary.js",
        "errorHandling": { "type": "script", "script": "errorHandling/microsoftGraphApi.js" }
    },
    "matches": { "sourceType": { "type": "oneOf", "values": ["App"] } },
    "metadata": [
        {
            "name": "state",
            "displayName": "State",
            "shape": "state"
        },
        {
            "name": "appName",
            "displayName": "App",
            "shape": "string",
            "role": "label",
            "sourceId": "appId",
            "sourceType": "App"
        },
        {
            "name": "appId",
            "displayName": "App ID",
            "shape": "string",
            "visible": false
        },
        {
            "name": "installedDeviceCount",
            "displayName": "Installed Devices",
            "shape": "number",
            "role": "value"
        },
        {
            "name": "failedDeviceCount",
            "displayName": "Failed Devices",
            "shape": "number"
        },
        {
            "name": "pendingInstallDeviceCount",
            "displayName": "Pending Devices",
            "shape": "number"
        },
        {
            "name": "notInstalledDeviceCount",
            "displayName": "Not Installed Devices",
            "shape": "number"
        },
        {
            "name": "notApplicableDeviceCount",
            "displayName": "Not Applicable Devices",
            "shape": "number"
        },
        {
            "name": "installedUserCount",
            "displayName": "Installed Users",
            "shape": "number"
        },
        {
            "name": "failedUserCount",
            "displayName": "Failed Users",
            "shape": "number"
        },
        {
            "name": "pendingInstallUserCount",
            "displayName": "Pending Users",
            "shape": "number"
        },
        {
            "name": "notInstalledUserCount",
            "displayName": "Not Installed Users",
            "shape": "number"
        },
        {
            "name": "notApplicableUserCount",
            "displayName": "Not Applicable Users",
            "shape": "number"
        }
    ],
    "timeframes": false
}
