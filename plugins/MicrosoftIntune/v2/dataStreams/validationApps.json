{
    "name": "validationApps",
    "displayName": "Validation - Apps",
    "description": "Checks read access to app management data",
    "tags": ["Validation"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "v1.0/deviceAppManagement/vppTokens",
        "getArgs": [{ "key": "$select", "value": "id" }],
        "paging": { "mode": "none" },
        "pathToData": "value",
        "errorHandling": { "type": "script", "script": "errorHandling/microsoftGraphApi.js" }
    },
    "matches": "none",
    "timeframes": false,
    "providesPluginDiagnostics": true,
    "visibility": { "type": "hidden" }
}
