{
    "name": "featureUpdateProfiles",
    "displayName": "Feature Update Profiles",
    "description": "Windows feature update profiles with their target version, end of support date and rollout settings (beta API)",
    "tags": ["Patching"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "beta/deviceManagement/windowsFeatureUpdateProfiles",
        "getArgs": [
            {
                "key": "$select",
                "value": "id,displayName,description,featureUpdateVersion,endOfSupportDate,rolloutSettings,installLatestWindows10OnWindows11IneligibleDevice,installFeatureUpdatesOptional,createdDateTime,lastModifiedDateTime"
            }
        ],
        "paging": {
            "mode": "nextUrl",
            "in": { "realm": "payload", "path": "@odata.nextLink" }
        },
        "pathToData": "value",
        "expandInnerObjects": true,
        "errorHandling": { "type": "script", "script": "errorHandling/microsoftGraphApi.js" }
    },
    "matches": "none",
    "metadata": [
        {
            "name": "supportState",
            "displayName": "State",
            "computed": true,
            "valueExpression": "{{ (() => { const d = $['endOfSupportDate']; const t = d === null || d === undefined ? NaN : new Date(d).getTime(); if (isNaN(t) || new Date(t).getUTCFullYear() <= 1900) { return 'Unknown'; } const days = (t - Date.now()) / 86400000; return days < 0 ? 'End of support' : days <= 90 ? 'Ending soon' : 'Supported'; })() }}",
            "shape": [
                "state",
                {
                    "map": {
                        "success": ["Supported"],
                        "warning": ["Ending soon"],
                        "error": ["End of support"],
                        "unknown": ["Unknown"]
                    }
                }
            ]
        },
        {
            "name": "statusRank",
            "displayName": "Status Rank",
            "computed": true,
            "valueExpression": "{{ (() => { const d = $['endOfSupportDate']; const t = d === null || d === undefined ? NaN : new Date(d).getTime(); if (isNaN(t) || new Date(t).getUTCFullYear() <= 1900) { return 2; } const days = (t - Date.now()) / 86400000; return days < 0 ? 0 : days <= 90 ? 1 : 3; })() }}",
            "shape": "number",
            "visible": false
        },
        {
            "name": "displayName",
            "displayName": "Name",
            "shape": "string",
            "role": "label",
            "sourceId": "id",
            "sourceType": "Update Profile"
        },
        { "name": "featureUpdateVersion", "displayName": "Feature Update", "shape": "string" },
        {
            "name": "endOfSupport",
            "displayName": "End of Support",
            "shape": "date",
            "computed": true,
            "valueExpression": "{{ (() => { const d = $['endOfSupportDate']; const t = d === null || d === undefined ? NaN : new Date(d).getTime(); return isNaN(t) || new Date(t).getUTCFullYear() <= 1900 ? null : d; })() }}"
        },
        {
            "name": "daysUntilEndOfSupport",
            "displayName": "Days Until End of Support",
            "computed": true,
            "valueExpression": "{{ (() => { const d = $['endOfSupportDate']; const t = d === null || d === undefined ? NaN : new Date(d).getTime(); return isNaN(t) || new Date(t).getUTCFullYear() <= 1900 ? null : Math.floor((t - Date.now()) / 86400000); })() }}",
            "shape": ["number", { "decimalPlaces": 0 }]
        },
        {
            "name": "profileType",
            "displayName": "Profile Type",
            "shape": "string",
            "computed": true,
            "valueExpression": "Feature update"
        },
        { "name": "description", "displayName": "Description", "shape": "string" },
        { "name": "rolloutSettings.offerStartDateTimeInUTC", "displayName": "Rollout Start", "shape": "date" },
        { "name": "rolloutSettings.offerEndDateTimeInUTC", "displayName": "Rollout End", "shape": "date" },
        { "name": "rolloutSettings.offerIntervalInDays", "displayName": "Rollout Interval (Days)", "shape": "number" },
        {
            "name": "installLatestWindows10OnWindows11IneligibleDevice",
            "displayName": "Windows 10 on Ineligible Devices",
            "shape": "boolean"
        },
        { "name": "installFeatureUpdatesOptional", "displayName": "Optional Install", "shape": "boolean" },
        { "name": "createdDateTime", "displayName": "Created", "shape": "date" },
        { "name": "lastModifiedDateTime", "displayName": "Last Modified", "shape": "date" },
        { "name": "endOfSupportDate", "displayName": "End of Support (Raw)", "shape": "date", "visible": false },
        { "name": "id", "displayName": "ID", "shape": "string", "visible": false }
    ],
    "defaultShaping": { "sort": { "by": [["statusRank", "asc"], ["displayName", "asc"]] } },
    "timeframes": false
}
