{
    "name": "configurationProfileOverview",
    "displayName": "Configuration Profile Overview",
    "description": "Device counts by status for the selected configuration profile",
    "tags": ["Configuration"],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "beta/deviceManagement/deviceConfigurations/{{object.rawId}}/deviceStatusOverview",
        "paging": { "mode": "none" },
        "postRequestScript": "policyOverview.js",
        "errorHandling": { "type": "script", "script": "errorHandling/microsoftGraphApi.js" }
    },
    "matches": { "sourceType": { "type": "oneOf", "values": ["Configuration Profile"] } },
    "metadata": [
        {
            "name": "state",
            "displayName": "State",
            "shape": "state"
        },
        {
            "name": "policyName",
            "displayName": "Profile",
            "shape": "string",
            "role": "label",
            "sourceId": "policyId",
            "sourceType": "Configuration Profile"
        },
        {
            "name": "policyId",
            "displayName": "Profile ID",
            "shape": "string",
            "visible": false
        },
        {
            "name": "successCount",
            "displayName": "Succeeded",
            "shape": "number",
            "role": "value"
        },
        {
            "name": "errorCount",
            "displayName": "Errors",
            "shape": "number"
        },
        {
            "name": "failedCount",
            "displayName": "Failed",
            "shape": "number"
        },
        {
            "name": "pendingCount",
            "displayName": "Pending",
            "shape": "number"
        },
        {
            "name": "notApplicableCount",
            "displayName": "Not Applicable",
            "shape": "number"
        },
        {
            "name": "lastUpdateDateTime",
            "displayName": "Last Updated",
            "shape": "date"
        },
        {
            "name": "configurationVersion",
            "displayName": "Configuration Version",
            "shape": ["number", { "thousandsSeparator": false }]
        }
    ],
    "timeframes": false
}
