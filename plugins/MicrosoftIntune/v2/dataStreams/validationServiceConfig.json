{
    "name": "validationServiceConfig",
    "displayName": "Validation - Service Configuration",
    "description": "Checks read access to Autopilot and enrollment settings",
    "tags": ["Validation"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "v1.0/deviceManagement/deviceEnrollmentConfigurations",
        "getArgs": [{ "key": "$select", "value": "id" }],
        "paging": { "mode": "none" },
        "pathToData": "value",
        "errorHandling": { "type": "script", "script": "errorHandling/microsoftGraphApi.js" }
    },
    "matches": "none",
    "timeframes": false,
    "providesPluginDiagnostics": true,
    "visibility": { "type": "hidden" }
}
