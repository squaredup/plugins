{
    "name": "complianceSummary",
    "displayName": "Compliance Summary",
    "description": "Number of managed devices in each compliance state across the tenant",
    "tags": ["Compliance"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "v1.0/deviceManagement/deviceCompliancePolicyDeviceStateSummary",
        "paging": { "mode": "none" },
        "errorHandling": { "type": "script", "script": "errorHandling/microsoftGraphApi.js" }
    },
    "matches": "none",
    "metadata": [
        {
            "name": "compliantDeviceCount",
            "displayName": "Compliant",
            "shape": "number"
        },
        {
            "name": "nonCompliantDeviceCount",
            "displayName": "Not Compliant",
            "shape": "number"
        },
        {
            "name": "inGracePeriodCount",
            "displayName": "In Grace Period",
            "shape": "number"
        },
        {
            "name": "errorDeviceCount",
            "displayName": "Error",
            "shape": "number"
        },
        {
            "name": "conflictDeviceCount",
            "displayName": "Conflict",
            "shape": "number"
        },
        {
            "name": "remediatedDeviceCount",
            "displayName": "Remediated",
            "shape": "number"
        },
        {
            "name": "notApplicableDeviceCount",
            "displayName": "Not Applicable",
            "shape": "number"
        },
        {
            "name": "configManagerCount",
            "displayName": "Configuration Manager",
            "shape": "number"
        },
        {
            "name": "unknownDeviceCount",
            "displayName": "Unknown",
            "shape": "number"
        }
    ],
    "timeframes": false
}
