{
    "name": "microsoft-intune",
    "displayName": "Microsoft Intune",
    "version": "2.0.0",
    "author": {
        "name": "SquaredUp Labs",
        "type": "labs"
    },
    "description": "Monitor Intune managed devices, apps, compliance policies and configuration profiles.",
    "category": "Monitoring",
    "type": "hybrid",
    "schemaVersion": "2.1",
    "importNotSupported": false,
    "restrictedToPlatforms": [],
    "keywords": ["intune", "endpoint manager", "mdm", "device compliance", "configuration profiles", "microsoft", "apps", "windows update", "patching"],
    "objectTypes": ["Managed Device", "Compliance Policy", "Configuration Profile", "User", "App", "Update Profile"],
    "links": [
        {
            "category": "documentation",
            "url": "https://github.com/squaredup/plugins/blob/main/plugins/MicrosoftIntune/v2/docs/README.md",
            "label": "Help adding this plugin"
        },
        {
            "category": "source",
            "url": "https://github.com/squaredup/plugins/tree/main/plugins/MicrosoftIntune/v2",
            "label": "Repository"
        }
    ],
    "base": {
        "plugin": "WebAPI",
        "majorVersion": "1",
        "config": {
            "baseUrl": "https://graph.microsoft.com/",
            "authMode": "oauth2",
            "oauth2GrantType": "clientCredentials",
            "oauth2TokenUrl": "https://login.microsoftonline.com/{{tenantId}}/oauth2/v2.0/token",
            "oauth2ClientId": "{{clientId}}",
            "oauth2ClientSecret": "{{clientSecret}}",
            "oauth2ClientSecretLocationDuringAuth": "body",
            "oauth2Scope": "https://graph.microsoft.com/.default",
            "oauth2TokenExtraArgs": [
                { "key": "grant_type", "value": "client_credentials" },
                { "key": "scope", "value": "https://graph.microsoft.com/.default" }
            ],
            "oauth2TokenExtraHeaders": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "headers": [],
            "queryArgs": []
        }
    }
}
