{
    "name": "currencies",
    "displayName": "Currencies",
    "description": "Currencies with published reference rates, by ISO 4217 code",
    "tags": ["Rates"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/currencies",
        "getArgs": [
            { "key": "providers", "value": "ECB" }
        ],
        "postRequestScript": "currencies.js"
    },
    "matches": "none",
    "timeframes": false,
    "metadata": [
        { "name": "value", "displayName": "Code", "shape": "string", "role": "value" },
        { "name": "label", "displayName": "Currency", "shape": "string", "role": "label" }
    ],
    "visibility": {
        "type": "hidden"
    }
}
