                "moved": false,
                "static": false,
                "config": {
                    "dataStream": {
                        "name": "deployments",
                        "pluginConfigId": "{{configId}}",
                        "id": "{{dataStreams.[deployments]}}",
                        "sort": {
                            "by": [["created_byDay", "asc"]]
                        },
                        "group": {
                            "by": [
                                ["created", "byDay"],
                                ["state", "uniqueValues"]
                            ],
                            "aggregate": [
                                {
                                    "type": "count"
                                }
                            ]
                        }
                    },
                    "_type": "tile/data-stream",
                    "description": "Deployments per day, split by state",
                    "activePluginConfigIds": ["{{configId}}"],
                    "title": "Deployments per Day",
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "created_byDay",
                                    "type": "temporal",
                                    "title": "Created"
                                },
                                "y": {
                                    "field": "count",
                                    "type": "quantitative",
                                    "title": "Count"
                                },
                                "series": {
                                    "field": "state_uniqueValues",
                                    "type": "nominal",
                                    "title": "State"
                                }
                            },
                            "style": {
                                "legendPosition": "bottom",
                                "cartesianShowYAxisTitle": true,
                                "cartesianYAxisTitle": "Deployments",
                                "cartesianStack": "on",
                                "cartesianShowStackedTotals": true,
                                "mappedColors": {
                                    "Success": "#2BB660",
                                    "Error": "#F2164D"
                                }
                            }
                        }
                    }
