{
    "name": "Overview",
    "schemaVersion": "1.5",
    "timeframe": "last7days",
    "dashboard": {
        "_type": "layout/grid",
        "version": 95,
        "contents": [
            {
                "static": false,
                "w": 1,
                "moved": false,
                "h": 3,
                "x": 0,
                "y": 0,
                "i": "fa9e69dc-7d70-450b-b973-1a215df3a398",
                "z": 0,
                "config": {
                    "timeframe": "none",
                    "dataStream": {
                        "name": "projects",
                        "pluginConfigId": "{{configId}}",
                        "id": "{{dataStreams.[projects]}}",
                        "sort": {
                            "by": [["count", "desc"]]
                        },
                        "group": {
                            "by": [["framework", "uniqueValues"]],
                            "aggregate": [
                                {
                                    "type": "count"
                                }
                            ]
                        }
                    },
                    "_type": "tile/data-stream",
                    "description": "",
                    "activePluginConfigIds": ["{{configId}}"],
                    "title": "Projects by Framework",
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "pie",
                            "encoding": {
                                "label": {
                                    "field": "framework_uniqueValues",
                                    "type": "nominal",
                                    "title": "Framework"
                                },
                                "value": {
                                    "field": "count",
                                    "type": "quantitative",
                                    "aggregate": "sum",
                                    "title": "Count"
                                }
                            },
                            "style": {
                                "pieInnerRadius": 60,
                                "pieDonutCenterValue": "total",
                                "labelFontSize": 16,
                                "pieSort": "desc",
                                "pieLegendStyle": "table"
                            }
                        }
                    }
                }
            },
            {
                "static": false,
                "w": 3,
                "moved": false,
                "h": 3,
                "x": 1,
                "y": 0,
                "i": "3850d290-308d-44a1-81de-aeff5200d0ba",
                "z": 0,
                "config": {
                    "timeframe": "none",
                    "dataStream": {
                        "name": "projects",
                        "pluginConfigId": "{{configId}}",
                        "id": "{{dataStreams.[projects]}}",
                        "sort": {
                            "by": [["updatedAt", "desc"]]
                        }
                    },
                    "_type": "tile/data-stream",
                    "description": "",
                    "activePluginConfigIds": ["{{configId}}"],
                    "title": "Projects",
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "name",
                                        "title": "Name",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "framework",
                                        "title": "Framework",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "nodeVersion",
                                        "title": "Node Version",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "updatedAt",
                                        "title": "Updated",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    }
                                ]
                            }
                        }
                    }
                }
            },
            {
                "static": false,
                "w": 1,
                "moved": false,
                "h": 2,
                "x": 0,
                "y": 3,
                "i": "60fe71cb-be1f-4627-9eb7-c4aa7fe10feb",
                "z": 0,
                "config": {
                    "timeframe": "none",
                    "dataStream": {
                        "name": "domains",
                        "pluginConfigId": "{{configId}}",
                        "filter": {
                            "multiOperation": "and",
                            "filters": [
                                {
                                    "column": "verified",
                                    "operation": "equals",
                                    "value": "false"
                                }
                            ]
                        },
                        "id": "{{dataStreams.[domains]}}",
                        "group": {
                            "by": [],
                            "aggregate": [
                                {
                                    "type": "count"
                                }
                            ]
                        }
                    },
                    "_type": "tile/data-stream",
                    "description": "Domains that are not verified",
                    "activePluginConfigIds": ["{{configId}}"],
                    "title": "Unverified Domains",
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    {
                                        "field": "count",
                                        "type": "quantitative",
                                        "title": "Count"
                                    }
                                ]
                            },
                            "style": {
                                "scalarLabelText": "Unverified"
                            }
                        }
                    }
                }
            },
            {
