{
    "name": "Activity & Team",
    "schemaVersion": "1.5",
    "timeframe": "last7days",
    "dashboard": {
        "_type": "layout/grid",
        "version": 115,
        "contents": [
            {
                "static": false,
                "w": 3,
                "moved": false,
                "h": 3,
                "x": 0,
                "y": 0,
                "i": "4c0a11bb-6c6b-481b-951c-fe4586313ea4",
                "z": 0,
                "config": {
                    "dataStream": {
                        "name": "activity",
                        "pluginConfigId": "{{configId}}",
                        "id": "{{dataStreams.[activity]}}",
                        "sort": {
                            "by": [["createdAt", "desc"]]
                        }
                    },
                    "_type": "tile/data-stream",
                    "description": "Account events",
                    "activePluginConfigIds": ["{{configId}}"],
                    "title": "Recent Activity",
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "createdAt",
                                        "title": "Created",
                                        "renderer": {
                                            "type": "date"
                                        }
                                    },
                                    {
                                        "field": "type",
                                        "title": "Type",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "text",
                                        "title": "Summary",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "actor",
                                        "title": "Actor",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    }
                                ]
                            }
                        }
                    }
                }
            },
            {
                "static": false,
                "w": 1,
                "moved": false,
                "h": 3,
                "x": 3,
                "y": 0,
                "i": "9838709b-83d2-4542-85a7-6458352f4d93",
                "z": 0,
                "config": {
                    "timeframe": "none",
                    "dataStream": {
                        "name": "teamMembers",
                        "pluginConfigId": "{{configId}}",
                        "id": "{{dataStreams.[teamMembers]}}",
                        "sort": {
                            "by": [["name", "asc"]]
                        }
                    },
                    "scope": {
                        "query": "g.V().order().by('__name').hasNot('__canonicalType').has(\"__configId\", within(\"{{configId}}\")).or(__.has(\"sourceType\", \"Team\")).limit(500)",
                        "bindings": {},
                        "queryDetail": {}
                    },
                    "_type": "tile/data-stream",
                    "description": "Members of the configured team",
                    "activePluginConfigIds": ["{{configId}}"],
                    "title": "Team Roster",
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "username",
                                        "title": "Username",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "role",
                                        "title": "Role",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    }
                                ]
                            }
                        }
                    }
                }
            },
            {
                "static": false,
                "w": 4,
                "moved": false,
                "h": 2,
                "x": 0,
                "y": 6,
                "i": "fada223a-5939-4b55-bc61-3ef63deca7d2",
                "z": 0,
                "config": {
                    "timeframe": "none",
                    "dataStream": {
                        "name": "teams",
                        "pluginConfigId": "{{configId}}",
                        "id": "{{dataStreams.[teams]}}",
                        "sort": {
                            "by": [["name", "asc"]]
                        }
                    },
                    "_type": "tile/data-stream",
                    "description": "Teams accessible to the configured token",
                    "activePluginConfigIds": ["{{configId}}"],
                    "title": "Teams",
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "name",
                                        "title": "Name",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "slug",
                                        "title": "Slug",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "membership.role",
                                        "title": "Your Role",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "createdAt",
                                        "title": "Created",
                                        "renderer": {
                                            "type": "date"
                                        }
                                    }
                                ]
                            }
                        }
                    }
                }
            },
            {
                "static": false,
                "w": 4,
                "moved": false,
                "h": 3,
                "x": 0,
                "y": 3,
                "i": "34bbffe0-fdcd-479a-8c54-7757030d354a",
                "z": 0,
                "config": {
                    "dataStream": {
                        "name": "activity",
                        "pluginConfigId": "{{configId}}",
                        "id": "{{dataStreams.[activity]}}",
                        "sort": {},
                        "group": {
                            "by": [["createdAt", "byDay"]],
                            "aggregate": [
                                {
                                    "type": "count"
                                }
                            ]
                        }
                    },
                    "_type": "tile/data-stream",
                    "description": "",
                    "activePluginConfigIds": ["{{configId}}"],
                    "title": "Daily Activity",
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "line",
                            "encoding": {
                                "x": {
                                    "field": "createdAt_byDay",
                                    "type": "temporal",
                                    "title": "Created"
                                },
                                "y": {
                                    "field": "count",
                                    "type": "quantitative",
                                    "title": "Count"
                                }
                            },
                            "style": {
                                "cartesianYAxisRangeMode": "fit",
                                "cartesianSymbol": "none",
                                "cartesianAreaGradient": true
                            }
                        }
                    }
                }
            }
        ],
        "columns": 4
    }
}
