                            "data-stream-donut-chart": {
                                "valueColumn": "billedCost_sum",
                                "hideCenterValue": false,
                                "showValuesAsPercentage": false,
                                "legendPosition": "auto",
                                "legendMode": "table",
                                "labelColumn": "service_uniqueValues"
                            }
                        }
                    }
                }
