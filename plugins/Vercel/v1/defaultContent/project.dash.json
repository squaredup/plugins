                            "project": {
                                "variable": "{{variables.[Vercel Project]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Vercel Projects]}}"
                            }
                        },
                        "id": "{{dataStreams.[deployments]}}",
                        "sort": {
                            "by": [["created", "desc"]]
                        }
                    },
                    "_type": "tile/data-stream",
                    "description": "Deployments for this project",
                    "activePluginConfigIds": ["{{configId}}"],
                    "title": "Deployment History",
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "created",
                                        "title": "Created",
                                        "renderer": {
                                            "type": "date"
                                        }
                                    },
                                    {
                                        "field": "name",
                                        "title": "Name",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "state[Expanded].rawState",
                                        "title": "State",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "READY": "#2BB660",
                                                "ERROR": "#DE0038",
                                                "CANCELED": "#DE0038",
                                                "BUILDING": "#F59E0B",
                                                "QUEUED": "#F59E0B",
                                                "INITIALIZING": "#F59E0B",
                                                "DELETED": "#94A3B8"
                                            }
                                        }
                                    },
                                    {
                                        "field": "target",
                                        "title": "Target",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "creator",
                                        "title": "Creator",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "inspectorUrl",
                                        "title": "Inspector URL",
                                        "renderer": {
                                            "type": "link"
                                        }
                                    },
                                    {
                                        "field": "url",
                                        "title": "URL",
                                        "renderer": {
                                            "type": "link"
                                        }
                                    },
                                    {
                                        "field": "ready",
                                        "title": "Ready",
                                        "renderer": {
                                            "type": "date"
                                        }
                                    },
                                    {
                                        "field": "buildingAt",
                                        "title": "Building At",
                                        "renderer": {
                                            "type": "date"
                                        }
                                    },
                                    {
                                        "field": "createdAt",
                                        "title": "Created At",
                                        "renderer": {
                                            "type": "date"
                                        }
                                    }
                                ]
                            }
                        }
                    }
                }
            },
