{
    "name": "hosts",
    "displayName": "Hosts",
    "description": "Every host in the Checkmk site with its folder, host groups, labels and service names",
    "tags": ["Host", "Inventory"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/domain-types/host/collections/all",
        "getArgs": [
            { "key": "columns", "value": "name" },
            { "key": "columns", "value": "alias" },
            { "key": "columns", "value": "address" },
            { "key": "columns", "value": "groups" },
            { "key": "columns", "value": "labels" },
            { "key": "columns", "value": "filename" },
            { "key": "columns", "value": "services" }
        ],
        "postRequestScript": "hosts.js",
        "errorHandling": { "type": "script", "script": "errorHandling/checkmkError.js" }
    },
    "matches": "none",
    "visibility": { "type": "hidden" },
    "metadata": [
        { "name": "hostName", "displayName": "Host", "shape": "string", "role": "label" },
        { "name": "alias", "displayName": "Alias", "shape": "string" },
        { "name": "address", "displayName": "Address", "shape": "string" },
        { "name": "folder", "displayName": "Folder", "shape": "string" },
        { "name": "hostGroups", "displayName": "Host groups", "shape": ["array", { "itemShape": "string" }] },
        { "name": "hostLabels", "displayName": "Labels", "shape": ["array", { "itemShape": "string" }] },
        { "name": "serviceNames", "displayName": "Services", "shape": ["array", { "itemShape": "string" }] }
    ],
    "timeframes": false
}
