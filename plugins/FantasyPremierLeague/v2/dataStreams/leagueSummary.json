        "endpointPath": "leagues-classic/{{objects[0].leagueId}}/standings/",
        "pathToData": "standings.results",
        "getArgs": [],
        "headers": []
    },
    "baseDataSourceName": "httpRequestScopedSingle",
    "manualConfigApply": true,
    "rowPath": [],
    "metadata": [
        {
            "shape": [
                "number",
                {
                    "decimalPlaces": 0
                }
            ],
            "name": "event_total",
