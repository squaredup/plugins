                }
            ]
        },
        {
            "shape": [
                "number",
                {
                    "decimalPlaces": 0
                }
            ],
            "name": "last_rank"
        },
        {
            "shape": [
                "number",
                {
                    "decimalPlaces": 0
                }
            ],
            "name": "total",
            "displayName": "Total Points"
        },
        {
            "displayName": "Team Name",
            "name": "entry_name"
        },
        {
            "displayName": "Player Name",
            "name": "player_name"
        },
        {
            "name": "sourceId",
            "displayName": "Object ID",
            "shape": "string",
            "visible": false
        }
    ],
    "defaultShaping": {
        "sort": {
            "by": [
                [
                    "rank",
                    "asc"
                ]
            ]
        }
