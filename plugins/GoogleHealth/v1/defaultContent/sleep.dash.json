                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Sleep Sessions",
                    "description": "",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.sleepSessions}}",
                        "name": "sleepSessions",
                        "pluginConfigId": "{{configId}}"
                    },
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": [
                                    "date",
                                    "asleepHours",
                                    "efficiencyPct",
                                    "deepMin",
                                    "remMin",
                                    "lightMin",
                                    "awakeMin",
                                    "inBedMin",
                                    "startTime",
                                    "endTime"
                                ],
