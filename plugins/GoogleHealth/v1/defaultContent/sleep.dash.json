{
    "name": "Sleep",
    "schemaVersion": "1.5",
    "timeframe": "last7days",
    "dashboard": {
        "_type": "layout/grid",
        "columns": 12,
        "version": 1,
        "contents": [
            {
                "i": "8ae7ed39-75f9-477a-a1e1-9170a935c685",
                "x": 0,
                "y": 0,
                "w": 3,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Avg Sleep (h)",
                    "description": "",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.sleepSessions}}",
                        "name": "sleepSessions",
                        "pluginConfigId": "{{configId}}"
                    },
                    "monitor": {
                        "tileRollsUp": true,
                        "monitorType": "threshold",
                        "condition": {
                            "columns": [
                                "sleepPct"
                            ],
                            "logic": {
                                "if": [
                                    {
                                        ">=": [
                                            {
                                                "var": "mean"
                                            },
                                            100
                                        ]
                                    },
                                    "success",
                                    {
                                        ">=": [
                                            {
                                                "var": "mean"
                                            },
                                            75
                                        ]
                                    },
                                    "warning",
                                    "error"
                                ]
                            }
                        },
                        "_type": "simple",
                        "aggregation": "mean",
                        "groupBy": "__group_by_none__",
                        "frequency": 720
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "gauge",
                            "encoding": {
                                "value": {
                                    "field": "asleepHours",
                                    "type": "quantitative",
                                    "title": "Asleep (h)"
                                },
                                "max": {
                                    "field": "sleepGoalCol",
                                    "type": "quantitative",
                                    "title": "Sleep Goal (h)"
                                }
                            },
                            "style": {
                                "gaugeMin": 0,
                                "gaugeLabelText": "Avg Sleep (h)"
                            }
                        }
                    }
                }
            },
            {
                "i": "a8670004-fe48-40f4-8e48-98af68239e1d",
                "x": 3,
                "y": 0,
                "w": 9,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Sleep Duration",
                    "description": "",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.sleepSessions}}",
                        "name": "sleepSessions",
                        "pluginConfigId": "{{configId}}"
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "date",
                                    "type": "temporal",
                                    "title": "Date"
                                },
                                "y": {
                                    "field": "asleepHours",
                                    "type": "quantitative",
                                    "title": "Asleep (h)"
                                },
                                "series": {
                                    "field": "sleepGoalBand",
                                    "type": "nominal",
                                    "title": "Goal Progress"
                                }
                            },
                            "style": {
                                "legendPosition": "none",
                                "cartesianShowYAxisTitle": true,
                                "cartesianYAxisTitle": "Hours",
                                "cartesianStack": "on",
                                "mappedColors": {
                                    "Goal met": "#259A51",
                                    "Near goal": "#E18700",
                                    "Below goal": "#D0021B",
                                    "No goal": "#88898C"
                                }
                            }
                        }
                    }
                }
            },
            {
