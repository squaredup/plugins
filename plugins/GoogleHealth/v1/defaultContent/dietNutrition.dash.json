                "config": {
                    "_type": "tile/data-stream",
                    "title": "Calories by Meal",
                    "description": "",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.foodLog}}",
                        "name": "foodLog",
                        "pluginConfigId": "{{configId}}",
                        "group": {
                            "by": [
                                [
                                    "meal",
                                    "uniqueValues"
                                ]
                            ],
                            "aggregate": [
                                {
                                    "type": "sum",
                                    "names": [
                                        "calories"
                                    ]
                                },
                                {
                                    "type": "min",
                                    "names": [
                                        "mealOrder"
                                    ]
                                }
                            ]
                        },
                        "sort": {
                            "by": [
                                [
                                    "mealOrder_min",
                                    "asc"
                                ]
                            ]
                        }
                    },
