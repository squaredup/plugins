                    "monitor": {
                        "tileRollsUp": true,
                        "monitorType": "threshold",
                        "condition": {
                            "columns": [
                                "caloriesPct"
                            ],
                            "logic": {
                                "if": [
                                    {
                                        "<=": [
                                            {
                                                "var": "mean"
                                            },
                                            100
                                        ]
                                    },
                                    "success",
                                    {
                                        "<=": [
                                            {
                                                "var": "mean"
                                            },
                                            110
                                        ]
                                    },
                                    "warning",
                                    "error"
                                ]
                            }
                        },
                        "_type": "simple",
                        "aggregation": "mean",
                        "groupBy": "__group_by_none__",
                        "frequency": 720
                    },
                    "visualisation": {
                        "type": "data-stream-gauge",
                        "config": {
