                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Calories by Meal",
                    "description": "",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.foodLog}}",
                        "name": "foodLog",
                        "pluginConfigId": "{{configId}}",
                        "group": {
                            "by": [
                                [
                                    "meal",
                                    "uniqueValues"
                                ]
                            ],
                            "aggregate": [
                                {
                                    "type": "sum",
                                    "names": [
                                        "calories"
                                    ]
                                },
                                {
                                    "type": "min",
                                    "names": [
                                        "mealOrder"
                                    ]
                                }
                            ]
                        },
                        "sort": {
                            "by": [
                                [
                                    "mealOrder_min",
                                    "asc"
                                ]
                            ]
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "meal_uniqueValues",
                                    "type": "nominal",
                                    "title": "Meal"
                                },
                                "y": {
                                    "field": "calories_sum",
                                    "type": "quantitative",
                                    "title": "Calories (Sum)"
                                }
                            },
                            "style": {
                                "legendPosition": "none",
                                "cartesianShowXAxisTitle": true,
                                "cartesianShowYAxisTitle": true,
