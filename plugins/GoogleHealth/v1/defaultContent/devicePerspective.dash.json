{
    "name": "Device",
    "schemaVersion": "1.5",
    "timeframe": "none",
    "variables": ["{{variables.[Google Health Device]}}"],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 12,
        "version": 1,
        "contents": [
            {
                "i": "cab9c1b8-7e6c-411a-8460-53fa0667351c",
                "x": 0,
                "y": 0,
                "w": 6,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Details",
                    "description": "",
                    "timeframe": "none",
                    "variables": ["{{variables.[Google Health Device]}}"],
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "datastream-properties",
                        "name": "properties"
                    },
                    "scope": {
                        "scope": "{{scopes.[Google Health Devices]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Google Health Device]}}"
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {},
                            "style": {
                                "richTableTranspose": true
                            }
                        }
                    }
                }
            },
            {
                "i": "df1ac843-ef7f-4f6d-b6c8-1c13b8853d8c",
                "x": 6,
                "y": 0,
                "w": 6,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Paired Devices",
                    "description": "",
                    "timeframe": "none",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.pairedDevices}}",
                        "name": "pairedDevices",
                        "pluginConfigId": "{{configId}}"
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "deviceName",
                                        "title": "Device",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "deviceType",
                                        "title": "Type",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "batteryLevel",
                                        "title": "Battery",
                                        "renderer": {
                                            "type": "bar",
                                            "max": 100
                                        }
                                    },
                                    {
                                        "field": "batteryStatus[Expanded].rawState",
                                        "title": "Battery Status",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "High": "#2BB660",
                                                "Medium": "#2BB660",
                                                "Low": "#F59E0B",
                                                "Empty": "#DE0038"
                                            }
                                        }
                                    },
                                    {
                                        "field": "lastSyncTime",
                                        "title": "Last Sync",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    },
                                    {
                                        "field": "featureCount",
                                        "title": "Features",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "deviceId",
                                        "title": "Device ID",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "macAddress",
                                        "title": "MAC",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    }
                                ]
                            }
                        }
                    }
                }
            }
        ]
    }
}
