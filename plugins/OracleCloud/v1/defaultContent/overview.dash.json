                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Resources by Type",
                    "description": "The 10 most common resource types in the tenancy",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[resourceSearch]}}",
                        "name": "resourceSearch",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "query": "query all resources where lifeCycleState != 'TERMINATED' && lifeCycleState != 'DELETED'"
                        },
                        "group": {
                            "by": [
                                [
                                    "resourceType",
                                    "uniqueValues"
                                ]
                            ],
                            "aggregate": [
                                {
                                    "type": "count"
                                }
                            ]
                        },
                        "sort": {
                            "by": [
                                [
                                    "count",
                                    "desc"
                                ]
                            ],
                            "top": 10
                        }
                    },
                    "timeframe": "none",
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "resourceType_uniqueValues",
                                    "type": "nominal",
                                    "title": "Resource Type"
                                },
                                "y": {
                                    "field": "count",
                                    "type": "quantitative",
                                    "title": "Resources"
                                }
                            },
                            "style": {
                                "cartesianHorizontal": true,
                                "showLabels": true
                            }
                        }
                    }
                }
            },
