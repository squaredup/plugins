                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Database Tools Connections]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Database Tools Connection]}}"
                    },
                    "variables": [
                        "{{variables.[Database Tools Connection]}}"
                    ],
                    "timeframe": "none",
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "name",
                                        "title": "Name",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "resourceType",
                                        "title": "Resource Type",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "lifecycleState",
                                        "title": "State",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "region",
                                        "title": "Region",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "availabilityDomain",
                                        "title": "Availability Domain",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "compartmentId",
                                        "title": "Compartment OCID",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "ociTags",
                                        "title": "Tags",
                                        "renderer": {
                                            "type": "tag-list"
                                        }
                                    },
                                    {
                                        "field": "timeCreated",
                                        "title": "Created",
                                        "renderer": {
                                            "type": "date"
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableTranspose": true
                            }
                        }
                    }
                }
            }
        ]
    }
}
