[
    {
        "type": "markdown",
        "name": "intro",
        "content": "Connect with an OCI **API signing key**. In the OCI Console open **Profile → My profile → API keys → Add API key**, download the private key, and copy the values from the configuration preview shown after adding it."
    },
    {
        "type": "text",
        "name": "tenancyOcid",
        "label": "Tenancy OCID",
        "placeholder": "ocid1.tenancy.oc1..aaaa...",
        "help": "The `tenancy` value from the API key configuration preview.",
        "validation": {
            "required": true,
            "pattern": {
                "value": "^\\s*ocid1\\.tenancy\\.[a-z0-9]+\\.\\.[a-z0-9]+\\s*$",
                "message": "Enter a tenancy OCID (ocid1.tenancy...)"
            }
        }
    },
    {
        "type": "text",
        "name": "userOcid",
        "label": "User OCID",
        "placeholder": "ocid1.user.oc1..aaaa...",
        "help": "The `user` value from the API key configuration preview.",
        "validation": {
            "required": true,
            "pattern": {
                "value": "^\\s*ocid1\\.user\\.[a-z0-9]+\\.\\.[a-z0-9]+\\s*$",
                "message": "Enter a user OCID (ocid1.user...)"
            }
        }
    },
    {
        "type": "text",
        "name": "fingerprint",
        "label": "Key fingerprint",
        "placeholder": "12:34:56:78:9a:bc:de:f0:12:34:56:78:9a:bc:de:f0",
        "help": "The `fingerprint` value from the API key configuration preview.",
        "validation": {
            "required": true,
            "pattern": {
                "value": "^\\s*([0-9a-fA-F]{2}:){15}[0-9a-fA-F]{2}\\s*$",
                "message": "Enter the 16-byte key fingerprint (aa:bb:...)"
            }
        }
    },
    {
        "type": "password",
        "name": "privateKey",
        "label": "Private key",
        "allowEncryption": true,
        "placeholder": "-----BEGIN PRIVATE KEY----- ...",
        "help": "Paste the whole contents of the downloaded `.pem` private key file, including the `BEGIN` and `END` lines. Passphrase-protected keys aren't supported.",
        "validation": {
            "required": true
        }
    },
    {
        "type": "text",
        "name": "homeRegion",
        "label": "Home region",
        "placeholder": "us-ashburn-1",
        "help": "Your tenancy's home region identifier (the `region` value from the configuration preview, or the region shown first under **Tenancy details**). Identity and cost queries always go to the home region.",
        "validation": {
            "required": true,
            "pattern": {
                "value": "^\\s*[a-z]{2,3}-[a-z]+-\\d+\\s*$",
                "message": "Enter a region identifier such as us-ashburn-1"
            }
        }
    },
    {
