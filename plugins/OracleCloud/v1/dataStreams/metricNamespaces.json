{
    "name": "metricNamespaces",
    "displayName": "Metric Namespaces",
    "description": "OCI Monitoring metric namespaces that have data in a region",
    "tags": [
        "Metrics"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "ui": [
        {
            "type": "text",
            "name": "region",
            "label": "Region"
        }
    ],
    "config": {
        "httpMethod": "post",
        "endpointPath": "oci/telemetry/{{ [].concat(typeof region === 'undefined' || region === null ? [] : region).map((i) => (i && i.value !== undefined ? i.value : i)).filter((v) => v !== '' && v != null)[0] || 'home' }}/20180401/metrics/actions/listMetrics",
        "getArgs": [
            {
                "key": "compartmentId",
                "value": "{{dataSource.tenancyOcid.trim()}}"
            },
            {
                "key": "compartmentIdInSubtree",
                "value": "true"
            }
        ],
        "postBody": {
            "groupBy": [
                "namespace"
            ]
        },
        "paging": {
            "mode": "token",
            "pageSize": {
                "realm": "queryArg",
                "path": "limit",
                "value": "1000"
            },
            "in": {
                "realm": "header",
                "path": "opc-next-page"
            },
            "out": {
                "realm": "queryArg",
                "path": "page"
            }
        },
        "postRequestScript": "metricNamespaces.js",
        "errorHandling": {
            "type": "script",
            "script": "errorHandling/ociError.js"
        }
    },
    "matches": "none",
    "visibility": {
        "type": "hidden"
    },
    "metadata": [
        {
            "name": "label",
            "displayName": "Label",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "value",
            "displayName": "Value",
            "shape": "string",
            "role": "value",
            "visible": false
        }
    ],
    "timeframes": false
}
