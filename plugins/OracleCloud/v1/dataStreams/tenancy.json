{
    "name": "tenancy",
    "displayName": "Tenancy",
    "description": "The configured OCI tenancy's name, home region and description",
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "20160918/tenancies/{{dataSource.tenancyOcid.trim()}}",
        "errorHandling": { "type": "script", "script": "errorHandling/ociError.js" }
    },
    "matches": "none",
    "visibility": { "type": "hidden" },
    "metadata": [
        { "name": "id", "displayName": "Tenancy OCID", "shape": "string", "role": "id", "visible": false },
        { "name": "name", "displayName": "Tenancy", "shape": "string", "role": "label" },
        { "name": "homeRegionKey", "displayName": "Home Region Key", "shape": "string" },
        { "name": "description", "displayName": "Description", "shape": "string" }
    ],
    "timeframes": false
}
