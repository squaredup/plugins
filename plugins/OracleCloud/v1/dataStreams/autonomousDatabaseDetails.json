{
    "name": "autonomousDatabaseDetails",
    "displayName": "Autonomous Database Details",
    "description": "Current configuration and state of an OCI Autonomous Database",
    "tags": [
        "Database"
    ],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "oci/database/{{object.region}}/20160918/autonomousDatabases/{{object.rawId}}",
        "expandInnerObjects": true,
        "errorHandling": {
            "type": "script",
            "script": "errorHandling/ociError.js"
        }
    },
    "matches": {
        "sourceType": {
            "type": "equals",
            "value": "OCI Autonomous Database"
        }
    },
    "metadata": [
        {
            "name": "displayName",
            "displayName": "Name",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "lifecycleState",
            "displayName": "State",
            "shape": [
                "state",
                {
                    "map": {
                        "success": [
                            "AVAILABLE"
                        ],
                        "warning": [
                            "PROVISIONING",
                            "STARTING",
                            "STOPPING",
                            "UPDATING",
                            "SCALE_IN_PROGRESS",
                            "BACKUP_IN_PROGRESS",
                            "RESTORE_IN_PROGRESS",
                            "MAINTENANCE_IN_PROGRESS",
                            "AVAILABLE_NEEDS_ATTENTION"
                        ],
                        "error": [
                            "STOPPED",
                            "UNAVAILABLE",
                            "TERMINATED",
                            "RESTORE_FAILED"
                        ]
                    }
                }
            ]
        },
        {
            "name": "dbName",
            "displayName": "Database Name",
            "shape": "string"
        },
        {
            "name": "dbWorkload",
            "displayName": "Workload",
            "shape": "string"
        },
        {
            "name": "dbVersion",
            "displayName": "Version",
            "shape": "string"
        },
        {
            "name": "computeModel",
            "displayName": "Compute Model",
            "shape": "string"
        },
        {
            "name": "computeCount",
            "displayName": "Compute Count",
            "shape": "number"
        },
        {
            "name": "isAutoScalingEnabled",
            "displayName": "Compute Auto Scaling",
            "shape": "boolean"
        },
        {
            "name": "dataStorageSizeInTBs",
            "displayName": "Storage (TB)",
            "shape": "number"
        },
        {
            "name": "isFreeTier",
            "displayName": "Always Free",
            "shape": "boolean"
        },
        {
            "name": "licenseModel",
            "displayName": "License Model",
            "shape": "string"
        },
        {
            "name": "isDataGuardEnabled",
            "displayName": "Data Guard",
            "shape": "boolean"
        },
        {
            "name": "connectionUrls.sqlDevWebUrl",
            "displayName": "Database Actions",
            "shape": [
                "url",
                {
                    "label": "Open"
                }
            ]
        },
        {
            "name": "timeCreated",
            "displayName": "Created",
            "shape": "date"
        },
        {
            "name": "id",
            "displayName": "OCID",
            "shape": "string",
            "visible": false
        }
    ],
    "timeframes": false
}
