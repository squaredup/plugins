{
    "name": "compartments",
    "displayName": "Compartments",
    "description": "Active OCI compartments in the tenancy, including nested compartments",
    "tags": ["Compartments"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "20160918/compartments",
        "getArgs": [
            { "key": "compartmentId", "value": "{{dataSource.tenancyOcid.trim()}}" },
            { "key": "compartmentIdInSubtree", "value": "true" },
            { "key": "accessLevel", "value": "ANY" },
            { "key": "lifecycleState", "value": "ACTIVE" }
        ],
        "paging": {
            "mode": "token",
            "pageSize": { "realm": "queryArg", "path": "limit", "value": "1000" },
            "in": { "realm": "header", "path": "opc-next-page" },
            "out": { "realm": "queryArg", "path": "page" }
        },
        "errorHandling": { "type": "script", "script": "errorHandling/ociError.js" }
    },
    "matches": "none",
    "metadata": [
        { "name": "id", "displayName": "Compartment OCID", "shape": "string", "role": "id", "visible": false },
        { "name": "name", "displayName": "Compartment", "shape": "string", "role": "label" },
        { "name": "description", "displayName": "Description", "shape": "string" },
        { "name": "compartmentId", "displayName": "Parent Compartment OCID", "shape": "string", "visible": false },
        { "name": "lifecycleState", "displayName": "State", "shape": "string" },
        { "name": "timeCreated", "displayName": "Created", "shape": "date" }
    ],
    "timeframes": false
}
