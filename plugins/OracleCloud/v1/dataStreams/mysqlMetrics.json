{
    "name": "mysqlMetrics",
    "displayName": "MySQL DB System Metrics",
    "description": "MySQL DB System performance metrics over time from the OCI Monitoring namespace oci_mysql_database",
    "tags": [
        "Metrics",
        "Database"
    ],
    "baseDataSourceName": "httpRequestScopedSingle",
    "ui": [
        {
            "type": "autocomplete",
            "name": "metric",
            "label": "Metric",
            "isMulti": false,
            "allowCustomValues": true,
            "help": "Any metric in the `oci_mysql_database` namespace. Type a name to use one that isn't listed.",
            "defaultValue": "CPUUtilization",
            "data": {
                "source": "fixed",
                "values": [
                    {
                        "value": "CPUUtilization",
                        "label": "CPUUtilization"
                    },
                    {
                        "value": "MemoryUtilization",
                        "label": "MemoryUtilization"
                    },
                    {
                        "value": "ActiveConnections",
                        "label": "ActiveConnections"
                    },
                    {
                        "value": "CurrentConnections",
                        "label": "CurrentConnections"
                    },
                    {
                        "value": "Statements",
                        "label": "Statements"
                    },
                    {
                        "value": "StatementLatency",
                        "label": "StatementLatency"
                    },
                    {
                        "value": "DbVolumeUtilization",
                        "label": "DbVolumeUtilization"
                    },
                    {
                        "value": "DbVolumeReadBytes",
                        "label": "DbVolumeReadBytes"
                    },
                    {
                        "value": "DbVolumeWriteBytes",
                        "label": "DbVolumeWriteBytes"
                    },
                    {
                        "value": "NetworkReceiveBytes",
                        "label": "NetworkReceiveBytes"
                    },
                    {
                        "value": "NetworkTransmitBytes",
                        "label": "NetworkTransmitBytes"
                    }
                ]
            },
            "validation": {
                "required": true
            }
        },
        {
            "type": "choiceChips",
            "name": "statistic",
            "label": "Statistic",
            "defaultValue": "mean",
            "options": [
                {
                    "value": "mean",
                    "label": "mean"
                },
                {
                    "value": "max",
                    "label": "max"
                },
                {
                    "value": "min",
                    "label": "min"
                },
                {
                    "value": "sum",
                    "label": "sum"
                },
                {
                    "value": "count",
                    "label": "count"
                },
                {
                    "value": "rate",
                    "label": "rate"
                }
            ]
        }
    ],
    "config": {
        "httpMethod": "post",
        "endpointPath": "oci/telemetry/{{object.region}}/20180401/metrics/actions/summarizeMetricsData",
        "getArgs": [
            {
                "key": "compartmentId",
                "value": "{{object.compartmentId}}"
            }
        ],
        "postBody": {
            "namespace": "oci_mysql_database",
            "query": "{{ [].concat(typeof metric === 'undefined' || metric === null ? [] : metric).map((i) => (i && i.value !== undefined ? i.value : i))[0] || 'CPUUtilization' }}[auto]{resourceId = \"{{object.rawId}}\"}.{{ [].concat(typeof statistic === 'undefined' || statistic === null ? [] : statistic).map((i) => (i && i.value !== undefined ? i.value : i))[0] || 'mean' }}()",
            "startTime": "{{timeframe.start}}",
            "endTime": "{{timeframe.end}}"
        },
        "postRequestScript": "metricSeries.js",
        "errorHandling": {
            "type": "script",
            "script": "errorHandling/ociError.js"
        }
    },
    "matches": {
        "sourceType": {
            "type": "equals",
            "value": "OCI MySQL DB System"
        }
    },
    "metadata": [
        {
            "name": "timestamp",
            "displayName": "Time",
            "shape": "date",
            "role": "timestamp"
        },
        {
            "name": "value",
            "displayName": "Value",
            "shape": "number",
            "role": "value"
        },
        {
            "name": "series",
            "displayName": "Series",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "metric",
            "displayName": "Metric",
            "shape": "string"
        },
        {
            "name": "unit",
            "displayName": "Unit",
            "shape": "string",
            "visible": false
        },
        {
            "name": "resourceId",
            "displayName": "Resource OCID",
            "shape": "string",
            "visible": false
        }
    ],
    "timeframes": true
}
