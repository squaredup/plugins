{
    "name": "instanceDetails",
    "displayName": "Compute Instance Details",
    "description": "Current configuration and state of an OCI compute instance",
    "tags": [
        "Compute"
    ],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "oci/iaas/{{object.region}}/20160918/instances/{{object.rawId}}",
        "expandInnerObjects": true,
        "errorHandling": {
            "type": "script",
            "script": "errorHandling/ociError.js"
        }
    },
    "matches": {
        "sourceType": {
            "type": "equals",
            "value": "OCI Compute Instance"
        }
    },
    "metadata": [
        {
            "name": "displayName",
            "displayName": "Name",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "lifecycleState",
            "displayName": "State",
            "shape": [
                "state",
                {
                    "map": {
                        "success": [
                            "RUNNING"
                        ],
                        "warning": [
                            "STARTING",
                            "STOPPING",
                            "PROVISIONING",
                            "CREATING_IMAGE",
                            "MOVING"
                        ],
                        "error": [
                            "STOPPED",
                            "TERMINATING",
                            "TERMINATED"
                        ]
                    }
                }
            ]
        },
        {
            "name": "shape",
            "displayName": "Shape",
            "shape": "string"
        },
        {
            "name": "shapeConfig.ocpus",
            "displayName": "OCPUs",
            "shape": "number"
        },
        {
            "name": "shapeConfig.memoryInGBs",
            "displayName": "Memory (GB)",
            "shape": "number"
        },
        {
            "name": "shapeConfig.processorDescription",
            "displayName": "Processor",
            "shape": "string"
        },
        {
            "name": "availabilityDomain",
            "displayName": "Availability Domain",
            "shape": "string"
        },
        {
            "name": "faultDomain",
            "displayName": "Fault Domain",
            "shape": "string"
        },
        {
            "name": "region",
            "displayName": "Region",
            "shape": "string"
        },
        {
            "name": "launchMode",
            "displayName": "Launch Mode",
            "shape": "string"
        },
        {
            "name": "timeCreated",
            "displayName": "Created",
            "shape": "date"
        },
        {
            "name": "id",
            "displayName": "OCID",
            "shape": "string",
            "visible": false
        }
    ],
    "timeframes": false
}
