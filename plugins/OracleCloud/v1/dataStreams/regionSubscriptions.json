{
    "name": "regionSubscriptions",
    "displayName": "Region Subscriptions",
    "description": "OCI regions the tenancy subscribes to, limited to the regions chosen in the data source configuration",
    "tags": [
        "Regions"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "20160918/tenancies/{{dataSource.tenancyOcid.trim()}}/regionSubscriptions",
        "postRequestScript": "regionSubscriptions.js",
        "errorHandling": {
            "type": "script",
            "script": "errorHandling/ociError.js"
        }
    },
    "matches": "none",
    "metadata": [
        {
            "name": "regionName",
            "displayName": "Region",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "value",
            "displayName": "Region ID",
            "shape": "string",
            "role": "value",
            "computed": true,
            "valueExpression": "{{ $['regionName'] }}",
            "visible": false
        },
        {
            "name": "regionKey",
            "displayName": "Region Key",
            "shape": "string"
        },
        {
            "name": "isHomeRegion",
            "displayName": "Home Region",
            "shape": "boolean"
        },
        {
            "name": "status",
            "displayName": "Subscription Status",
            "shape": "string"
        },
        {
            "name": "sourceType",
            "displayName": "Type",
            "shape": "string",
            "visible": false,
            "computed": true,
            "valueExpression": "OCI Region"
        }
    ],
    "timeframes": false
}
