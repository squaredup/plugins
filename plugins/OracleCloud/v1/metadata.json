{
    "name": "oracle-cloud",
    "displayName": "Oracle Cloud Infrastructure",
    "version": "1.0.0",
    "author": { "name": "@vinbab", "type": "labs" },
    "description": "Monitor Oracle Cloud Infrastructure (OCI): resources across regions and compartments, Monitoring metrics (MQL), alarms, log search, audit, SQL queries on databases, Cloud Guard, cost and announcements.",
    "category": "Cloud Platforms",
    "type": "hybrid",
    "schemaVersion": "2.1",
    "importNotSupported": false,
    "restrictedToPlatforms": [],
    "keywords": [
        "oracle",
        "oci",
        "oracle cloud",
        "autonomous database",
        "mql",
        "monitoring",
        "logging",
        "sql",
        "database",
        "cloud guard",
        "cost"
    ],
    "objectTypes": [
        "OCI Region",
        "OCI Compartment",
        "OCI Compute Instance",
        "OCI Autonomous Database",
        "OCI DB System",
        "OCI Database",
        "OCI MySQL DB System",
        "OCI Bucket",
        "OCI Load Balancer",
        "OCI Network Load Balancer",
        "OCI VCN",
        "OCI Subnet",
        "OCI Block Volume",
        "OCI Boot Volume",
        "OCI OKE Cluster",
        "OCI Functions Application",
        "OCI Function",
        "OCI API Gateway",
        "OCI Stream",
        "OCI Log Group",
        "OCI Alarm",
        "OCI Database Tools Connection"
    ],
    "links": [
        {
            "category": "documentation",
            "url": "https://github.com/squaredup/plugins/blob/main/plugins/OracleCloud/v1/docs/README.md",
            "label": "Help adding this plugin"
        },
        {
            "category": "source",
            "url": "https://github.com/squaredup/plugins/tree/main/plugins/OracleCloud/v1",
            "label": "Repository"
        }
    ],
    "base": {
        "plugin": "WebAPI",
        "majorVersion": "1",
        "config": {
            "baseUrl": "https://identity.{{homeRegion.trim()}}.oci.{{realmDomain || 'oraclecloud.com'}}",
            "authMode": "none",
            "headers": [{ "key": "Accept", "value": "application/json" }],
            "queryArgs": [],
            "scriptingVariables": [
                { "key": "tenancyOcid", "value": "{{tenancyOcid}}" },
                { "key": "userOcid", "value": "{{userOcid}}" },
                { "key": "fingerprint", "value": "{{fingerprint}}" },
                { "key": "privateKey", "value": "{{privateKey}}" },
                { "key": "homeRegion", "value": "{{homeRegion}}" },
                { "key": "realmDomain", "value": "{{realmDomain || 'oraclecloud.com'}}" }
            ],
            "preRequestScript": "preRequest.js",
            "showScripting": true
        }
    }
}
