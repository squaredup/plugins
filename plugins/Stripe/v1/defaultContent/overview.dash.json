                "w": 4,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Money Movement Over Time",
                    "description": "",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[moneyMovement]}}",
                        "name": "moneyMovement",
                        "pluginConfigId": "{{configId}}",
                        "group": {
                            "by": [
                                ["created", "byDay"],
                                ["type", "uniqueValues"]
                            ],
                            "aggregate": [{ "type": "sum", "names": ["amount"] }]
                        },
                        "sort": { "by": [["created_byDay", "asc"]] }
                    },
                    "visualisation": {
                        "type": "data-stream-line-graph",
                        "config": {
                            "data-stream-line-graph": {
                                "xAxisColumn": "created_byDay",
                                "yAxisColumn": ["amount_sum"],
                                "seriesColumn": "type_uniqueValues",
                                "showLegend": true,
                                "legendPosition": "bottom",
                                "yAxisLabel": "Amount (minor units)",
                                "showYAxisLabel": true,
                                "showTrendLine": false
                            }
                        }
                    }
                }
            },
            {
                "i": "01d8df33-672e-4820-8923-30616d10b877",
