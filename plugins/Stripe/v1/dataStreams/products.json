{
    "name": "products",
    "displayName": "Products",
    "description": "Stripe products",
    "tags": ["Billing"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "products",
        "paging": {
            "mode": "token",
            "pageSize": { "realm": "queryArg", "path": "limit", "value": "100" },
            "in": { "realm": "payload", "path": "data.99.id" },
            "out": { "realm": "queryArg", "path": "starting_after" }
        },
        "pathToData": "data"
    },
    "matches": "none",
    "visibility": { "type": "hidden" },
    "metadata": [
        { "name": "id", "displayName": "ID", "shape": "string" },
        { "name": "name", "displayName": "Name", "shape": "string" },
        { "name": "active", "displayName": "Active", "shape": "boolean" },
        { "name": "description", "displayName": "Description", "shape": "string" },
        { "name": "created", "displayName": "Created", "shape": "date" },
        { "name": "updated", "displayName": "Updated", "shape": "date" }
    ],
    "timeframes": false
}
