{
    "name": "moneyMovement",
    "displayName": "Money Movement",
    "description": "Balance-affecting transactions, including charges, refunds, payouts, fees, and adjustments",
    "tags": ["Billing", "Finance"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "balance_transactions",
        "getArgs": [
            { "key": "created[gte]", "value": "{{timeframe.unixStart}}" },
            { "key": "created[lte]", "value": "{{timeframe.unixEnd}}" }
        ],
        "paging": {
            "mode": "token",
            "pageSize": { "realm": "queryArg", "path": "limit", "value": "100" },
            "in": { "realm": "payload", "path": "data.99.id" },
            "out": { "realm": "queryArg", "path": "starting_after" }
        },
        "pathToData": "data"
    },
    "matches": "none",
    "metadata": [
        { "name": "id", "displayName": "ID", "shape": "string", "role": "id" },
        {
            "name": "amount",
            "displayName": "Amount (minor units)",
            "shape": ["number", { "thousandsSeparator": true }],
            "role": "value"
        },
        { "name": "currency", "displayName": "Currency", "shape": "string" },
        {
            "name": "fee",
            "displayName": "Fee (minor units)",
            "shape": ["number", { "thousandsSeparator": true }]
        },
        {
            "name": "net",
            "displayName": "Net (minor units)",
            "shape": ["number", { "thousandsSeparator": true }]
        },
        {
            "name": "type",
            "displayName": "Type",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "status",
            "displayName": "Status",
            "shape": [
                "state",
                {
                    "map": {
                        "success": ["available"],
                        "warning": ["pending"],
                        "error": ["failed"]
                    }
                }
            ]
        },
        { "name": "created", "displayName": "Created", "shape": "date", "role": "timestamp" },
        { "name": "available_on", "displayName": "Available On", "shape": "date" },
        {
            "name": "description",
            "displayName": "Description",
            "shape": "string",
            "role": "description"
        }
    ],
    "timeframes": true
}
