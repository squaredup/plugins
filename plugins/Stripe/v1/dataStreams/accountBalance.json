{
    "name": "accountBalance",
    "displayName": "Balance",
    "description": "Current available and pending balance by currency, in each currency's smallest unit",
    "tags": ["Billing", "Finance"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "balance",
        "postRequestScript": "accountBalance.js"
    },
    "matches": "none",
    "metadata": [
        { "name": "type", "displayName": "Type", "shape": "string", "role": "label" },
        { "name": "currency", "displayName": "Currency", "shape": "string" },
        {
            "name": "amount",
            "displayName": "Amount (minor units)",
            "shape": ["number", { "thousandsSeparator": true }],
            "role": "value"
        }
    ],
    "timeframes": false
}
