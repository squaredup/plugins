{
    "name": "subscriptions",
    "displayName": "Subscriptions",
    "description": "Stripe subscriptions",
    "tags": ["Billing"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "subscriptions",
        "getArgs": [{ "key": "status", "value": "all" }],
        "paging": {
            "mode": "token",
            "pageSize": { "realm": "queryArg", "path": "limit", "value": "100" },
            "in": { "realm": "payload", "path": "data.99.id" },
            "out": { "realm": "queryArg", "path": "starting_after" }
        },
        "pathToData": "data"
    },
    "matches": "none",
    "visibility": { "type": "hidden" },
    "metadata": [
        { "name": "id", "displayName": "ID", "shape": "string" },
        { "name": "customer", "displayName": "Customer ID", "shape": "string" },
        {
            "name": "status",
            "displayName": "Status",
            "shape": [
                "state",
                {
                    "map": {
                        "success": ["active", "trialing"],
                        "warning": ["past_due", "unpaid", "incomplete", "paused"],
                        "error": ["canceled", "incomplete_expired"]
                    }
                }
            ]
        },
        { "name": "created", "displayName": "Created", "shape": "date" },
        { "name": "start_date", "displayName": "Start Date", "shape": "date" },
        { "name": "cancel_at_period_end", "displayName": "Cancels at Period End", "shape": "boolean" },
        { "name": "canceled_at", "displayName": "Canceled At", "shape": "date" }
    ],
    "timeframes": false
}
