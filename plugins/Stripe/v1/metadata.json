{
    "name": "stripe",
    "displayName": "Stripe",
    "version": "1.2.0",
    "author": {
        "name": "@andrewmumblebee",
        "type": "community"
    },
    "description": "Monitor Stripe customers, subscriptions, and products, plus balance, payments, invoices, payouts, and disputes.",
    "category": "Analytics",
    "type": "hybrid",
    "schemaVersion": "2.1",
    "importNotSupported": false,
    "restrictedToPlatforms": [],
    "keywords": ["stripe", "payments", "billing", "subscriptions", "invoices", "revenue"],
    "objectTypes": ["Stripe Customer", "Stripe Subscription", "Stripe Product"],
    "links": [
        {
            "category": "documentation",
            "url": "https://github.com/squaredup/plugins/blob/main/plugins/Stripe/v1/docs/README.md",
            "label": "Help adding this plugin"
        },
        {
            "category": "source",
            "url": "https://github.com/squaredup/plugins/tree/main/plugins/Stripe/v1",
            "label": "Repository"
        }
    ],
    "base": {
        "plugin": "WebAPI",
        "majorVersion": "1",
        "config": {
            "baseUrl": "https://api.stripe.com/v1",
            "authMode": "none",
            "headers": [
                { "key": "Authorization", "value": "Bearer {{apiKey}}" },
                { "key": "Stripe-Version", "value": "2026-06-24.dahlia" }
            ],
            "queryArgs": []
        }
    }
}
