{
    "name": "sensorImport",
    "displayName": "Sensor Import",
    "description": "Every sensor, when Import sensors is turned on in the data source (otherwise none)",
    "tags": [
        "Sensor"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "visibility": {
        "type": "hidden"
    },
    "config": {
        "httpMethod": "get",
        "endpointPath": "{{ String(dataSource.importSensors) === 'true' ? 'v1/devices/sensors' : 'v1/deviceGroups/top/guid' }}",
        "postRequestScript": "sensors.js",
        "errorHandling": {
            "type": "script",
            "script": "errorHandling/dceError.js"
        }
    },
    "matches": "none",
    "metadata": [
        {
            "name": "label",
            "displayName": "Sensor",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "category",
            "displayName": "Category",
            "shape": "string"
        },
        {
            "name": "units",
            "displayName": "Units",
            "shape": "string",
            "role": "unitLabel"
        },
        {
            "name": "kind",
            "displayName": "Kind",
            "shape": "string"
        },
        {
            "name": "sensorType",
            "displayName": "Sensor Type",
            "shape": "string"
        },
        {
            "name": "location",
            "displayName": "Location",
            "shape": "string"
        },
        {
            "name": "guid",
            "displayName": "Sensor ID",
            "shape": "string",
            "role": "id",
            "visible": false
        },
        {
            "name": "deviceGuid",
            "displayName": "Device ID",
            "shape": "string",
            "visible": false
        }
    ],
    "timeframes": false
}
