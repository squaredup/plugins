{
    "name": "deviceSensorHistory",
    "displayName": "Device Sensor History",
    "description": "Readings over the timeframe from the sensors of the selected devices that match the given names and kinds (their environmental sensors if neither is given)",
    "tags": ["Sensor", "Power", "Environment"],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "v1/devices/{{encodeURIComponent(object.rawId)}}/sensors",
        "paging": { "mode": "nextUrl", "in": { "realm": "payload", "path": "nextPageUrl" } },
        "postRequestScript": "sensorHistory.js",
        "errorHandling": { "type": "script", "script": "errorHandling/dceError.js" }
    },
    "matches": {
        "sourceType": { "type": "oneOf", "values": ["Device"] }
    },
    "ui": [
        {
            "type": "autocomplete",
            "name": "sensorName",
            "label": "Sensor name(s) (optional)",
            "isMulti": true,
            "isClearable": true,
            "allowCustomValues": true,
            "data": {
                "source": "fixed",
                "values": [
                    { "value": "Battery Capacity Remaining", "label": "Battery Capacity Remaining" },
                    { "value": "Battery Time Remaining", "label": "Battery Time Remaining" },
                    { "value": "Output Load", "label": "Output Load" },
                    { "value": "Battery Temperature", "label": "Battery Temperature" },
                    { "value": "Battery Voltage", "label": "Battery Voltage" },
                    { "value": "Input Voltage", "label": "Input Voltage" },
                    { "value": "Output Voltage", "label": "Output Voltage" },
                    { "value": "Output Current", "label": "Output Current" },
                    { "value": "Input Frequency", "label": "Input Frequency" },
                    { "value": "Output Frequency", "label": "Output Frequency" },
                    { "value": "UPS Operation Mode", "label": "UPS Operation Mode" },
                    { "value": "Battery Status", "label": "Battery Status" }
                ]
            }
        },
        {
            "type": "autocomplete",
            "name": "kind",
            "label": "Sensor kind(s) (optional)",
            "isMulti": true,
            "isClearable": true,
            "allowCustomValues": true,
            "data": {
                "source": "fixed",
                "values": [
                    { "value": "TEMPERATURE", "label": "Temperature" },
                    { "value": "DIFF_TEMP", "label": "Temperature difference" },
                    { "value": "HUMIDITY", "label": "Humidity" },
                    { "value": "DEW_POINT", "label": "Dew point" },
                    { "value": "AIRFLOW", "label": "Airflow" },
                    { "value": "CURRENT", "label": "Current" },
                    { "value": "AMP_DETECTOR", "label": "Current (amp detector)" },
                    { "value": "VOLTAGE", "label": "Voltage" },
                    { "value": "POWER_WATTS", "label": "Power (W)" },
                    { "value": "POWER_KWATTS", "label": "Power (kW)" },
                    { "value": "POWER_VA", "label": "Apparent power (VA)" },
                    { "value": "POWER_KVA", "label": "Apparent power (kVA)" },
                    { "value": "ENERGY_KWH", "label": "Energy (kWh)" },
                    { "value": "KWATT_HOUR", "label": "Energy (kW hour)" },
                    { "value": "DOOR", "label": "Door" },
                    { "value": "MOTION_SENSOR", "label": "Motion" },
                    { "value": "DRY_CONTACT", "label": "Dry contact" },
                    { "value": "COMMUNICATION_SENSOR", "label": "Communication" },
                    { "value": "STATE", "label": "State" },
                    { "value": "NUMBER", "label": "Number" }
                ]
            }
        }
    ],
    "metadata": [
        { "name": "time", "displayName": "Time", "shape": "date", "role": "timestamp" },
        { "name": "value", "displayName": "Value", "shape": "number", "role": "value" },
        { "name": "series", "displayName": "Sensor", "shape": "string", "role": "label" },
        { "name": "units", "displayName": "Units", "shape": "string", "role": "unitLabel" },
        { "name": "category", "displayName": "Category", "shape": "string" },
        { "name": "valueText", "displayName": "Reading", "shape": "string" },
        {
            "name": "severityText",
            "displayName": "Status",
            "shape": [
                "state",
                {
                    "map": {
                        "success": ["Information", "Informational", "Normal", "OK", "Ok", "None"],
                        "warning": ["Warning"],
                        "error": ["Error", "Critical", "Failure"]
                    }
                }
            ]
        },
        { "name": "sensorLabel", "displayName": "Sensor Name", "shape": "string" },
        { "sourceId": "deviceGuid", "sourceType": "Device", "name": "deviceLabel", "displayName": "Device", "shape": "string" },
        { "name": "kind", "displayName": "Kind", "shape": "string" },
        { "name": "sensorGuid", "displayName": "Sensor ID", "shape": "string", "visible": false },
        { "name": "deviceGuid", "displayName": "Device ID", "shape": "string", "visible": false }
    ],
    "timeframes": ["last1hour", "last12hours", "last24hours", "last7days", "last30days"]
}
