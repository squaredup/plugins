{
    "name": "deviceGroups",
    "displayName": "Device Groups",
    "description": "All device groups with their current status and device count",
    "tags": ["Device Group", "Inventory"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "v1/deviceGroups",
        "errorHandling": { "type": "script", "script": "errorHandling/dceError.js" }
    },
    "matches": "none",
    "metadata": [
        { "sourceId": "isxcGuid", "sourceType": "Device Group", "name": "name", "displayName": "Device Group", "shape": "string", "role": "label" },
        {
            "name": "severityText",
            "displayName": "Status",
            "shape": [
                "state",
                {
                    "map": {
                        "success": ["Information", "Informational", "Normal", "OK", "None"],
                        "warning": ["Warning"],
                        "error": ["Error", "Critical", "Failure"]
                    }
                }
            ]
        },
        { "name": "deviceCount", "displayName": "Devices", "shape": "number", "role": "value" },
        { "name": "parentName", "displayName": "Parent Group", "sourceId": "parentIsxcGuid", "sourceType": "Device Group", "objectPropertyPath": "name" },
        { "name": "isxcGuid", "displayName": "Device Group ID", "shape": "string", "role": "id", "visible": false },
        { "name": "parentIsxcGuid", "displayName": "Parent Group ID", "shape": "string", "visible": false },
        { "name": "severity", "displayName": "Severity Level", "shape": "number", "visible": false }
    ],
    "timeframes": false
}
