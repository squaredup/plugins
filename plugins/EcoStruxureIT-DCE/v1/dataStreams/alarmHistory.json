{
    "name": "alarmHistory",
    "displayName": "Alarm History",
    "description": "Alarms resolved within the timeframe, optionally filtered by device (across all devices, the last 24 hours at most)",
    "tags": [
        "Alerts",
        "Device"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "{{ typeof device !== 'undefined' && Array.isArray(device) && device.length === 1 ? 'v1/devices/' + encodeURIComponent([].concat(device[0].rawId)[0]) + '/alarms/history' : 'v1/alarms/history' }}",
        "getArgs": [
            {
                "key": "startTime",
                "value": "{{ typeof device !== 'undefined' && Array.isArray(device) && device.length === 1 ? String(new Date(timeframe.start).getTime()) : null }}"
            },
            {
                "key": "endTime",
                "value": "{{ typeof device !== 'undefined' && Array.isArray(device) && device.length === 1 ? String(new Date(timeframe.end).getTime()) : null }}"
            },
            {
                "key": "startDateTime",
                "value": "{{ typeof device !== 'undefined' && Array.isArray(device) && device.length === 1 ? null : String(Math.max(new Date(timeframe.start).getTime(), new Date(timeframe.end).getTime() - 86400000)) }}"
            },
            {
                "key": "endDateTime",
                "value": "{{ typeof device !== 'undefined' && Array.isArray(device) && device.length === 1 ? null : String(new Date(timeframe.end).getTime()) }}"
            }
        ],
        "postRequestScript": "alarms.js",
        "errorHandling": {
            "type": "script",
            "script": "errorHandling/dceError.js"
        }
    },
    "matches": "none",
    "ui": [
        {
            "type": "objects",
            "name": "device",
            "label": "Device(s) (optional)",
            "matches": {
                "sourceType": {
                    "type": "oneOf",
                    "values": [
                        "Device"
                    ]
                }
            }
        }
    ],
    "metadata": [
        {
            "name": "description",
            "displayName": "Alarm",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "category",
            "displayName": "Category",
            "shape": "string"
        },
        {
            "name": "statusText",
            "displayName": "Status Text",
            "shape": "string"
        },
        {
            "name": "severityText",
            "displayName": "Severity",
            "shape": [
                "state",
                {
                    "map": {
                        "error": [
                            "Critical",
                            "Failure",
                            "Error"
                        ],
                        "warning": [
                            "Warning"
                        ],
                        "unknown": [
                            "Information",
                            "Informational"
                        ]
                    }
                }
            ]
        },
        {
            "name": "startTime",
            "displayName": "Started",
            "shape": "date",
            "role": "timestamp"
        },
        {
            "name": "resolveTime",
            "displayName": "Resolved",
            "shape": "date"
        },
        {
            "name": "durationSeconds",
            "displayName": "Duration",
            "shape": [
                "seconds",
                {
                    "formatDuration": true
                }
            ]
        },
        {
            "name": "deviceName",
            "displayName": "Device",
            "sourceId": "deviceGuid",
            "sourceType": "Device",
            "objectPropertyPath": "name"
        },
        {
            "name": "recommendedAction",
            "displayName": "Recommended Action",
            "shape": "string"
        },
        {
            "name": "hidden",
            "displayName": "Hidden",
            "shape": "boolean"
        },
        {
            "name": "alarmAlertSuppressed",
            "displayName": "Alerts Suppressed",
            "shape": "boolean"
        },
        {
            "name": "manuallyResolvable",
            "displayName": "Manually Resolvable",
            "shape": "boolean",
            "visible": false
        },
        {
            "name": "commentCount",
            "displayName": "Comments",
            "shape": "number",
            "visible": false
        },
        {
            "name": "severity",
            "displayName": "Severity Level",
            "shape": "number",
            "visible": false
        },
        {
            "name": "isxcGuid",
            "displayName": "Alarm ID",
            "shape": "string",
            "role": "id",
            "visible": false
        },
        {
            "name": "deviceGuid",
            "displayName": "Device ID",
            "sourceId": "deviceGuid",
            "sourceType": "Device",
            "shape": "string",
            "visible": false
        },
        {
            "name": "sensorGuid",
            "displayName": "Sensor ID",
            "shape": "string",
            "visible": false
        }
    ],
    "defaultShaping": {
        "sort": {
            "by": [
                [
                    "startTime",
                    "desc"
                ]
            ]
        }
    },
    "timeframes": true
}
