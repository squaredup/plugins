{
    "name": "deviceGroupDevices",
    "displayName": "Device Group Devices",
    "description": "Devices in the selected device group, including devices in its sub-groups",
    "tags": ["Device", "Device Group"],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "v1/deviceGroups/{{encodeURIComponent(object.rawId)}}/devices",
        "errorHandling": { "type": "script", "script": "errorHandling/dceError.js" }
    },
    "matches": {
        "sourceType": { "type": "oneOf", "values": ["Device Group"] }
    },
    "metadata": [
        { "sourceId": "isxcGuid", "sourceType": "Device", "name": "label", "displayName": "Device", "shape": "string", "role": "label" },
        {
            "name": "severityText",
            "displayName": "Status",
            "shape": [
                "state",
                {
                    "map": {
                        "success": ["Information", "Informational", "Normal", "OK", "None"],
                        "warning": ["Warning"],
                        "error": ["Error", "Critical", "Failure"]
                    }
                }
            ]
        },
        { "name": "type", "displayName": "Type", "shape": "string" },
        { "name": "model", "displayName": "Model", "shape": "string" },
        { "name": "hostname", "displayName": "Hostname", "shape": "string" },
        { "name": "ipAddress", "displayName": "IP Address", "shape": "string" },
        { "name": "location", "displayName": "Location", "shape": "string" },
        { "name": "serialNumber", "displayName": "Serial Number", "shape": "string" },
        { "name": "inMaintenance", "displayName": "In Maintenance", "shape": "boolean" },
        { "name": "isxcGuid", "displayName": "Device ID", "shape": "string", "role": "id", "visible": false },
        { "name": "severity", "displayName": "Severity Level", "shape": "number", "visible": false }
    ],
    "timeframes": false
}
