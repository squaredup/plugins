{
    "name": "Sensor",
    "schemaVersion": "1.5",
    "timeframe": "last24hours",
    "variables": [
        "{{variables.[Sensor]}}"
    ],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "1a85d2c1-46b6-4a08-905f-147a99e07339",
                "x": 0,
                "y": 0,
                "w": 1,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Properties",
                    "description": "",
                    "timeframe": "none",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "datastream-properties",
                        "name": "properties"
                    },
                    "scope": {
                        "scope": "{{scopes.[Sensors]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Sensor]}}"
                    },
                    "variables": [
                        "{{variables.[Sensor]}}"
                    ],
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": true
                            }
                        }
                    }
                }
            },
            {
                "i": "5006ffec-2a62-4e19-8f5d-03216ffa96ce",
                "x": 1,
                "y": 0,
                "w": 3,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Sensor History",
                    "description": "",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[sensorHistory]}}",
                        "name": "sensorHistory",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Sensors]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Sensor]}}"
                    },
                    "variables": [
                        "{{variables.[Sensor]}}"
                    ],
                    "visualisation": {
                        "type": "data-stream-line-graph",
                        "config": {
                            "data-stream-line-graph": {
                                "xAxisColumn": "time",
                                "yAxisColumn": [
                                    "value"
                                ],
                                "seriesColumn": "series",
                                "showLegend": false,
                                "legendPosition": "bottom",
                                "yAxisLabel": "",
                                "showYAxisLabel": false,
                                "showTrendLine": false
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "line",
                            "encoding": {
                                "x": {
                                    "field": "time",
                                    "type": "temporal",
                                    "title": "Time"
                                },
                                "y": {
                                    "field": "value",
                                    "type": "quantitative",
                                    "title": "Value"
                                }
                            },
                            "style": {
                                "cartesianAreaGradient": true,
                                "cartesianYAxisUnitColumn": "units",
                                "cartesianYAxisRangeMode": "fit"
                            }
                        }
                    }
                }
            },
            {
                "i": "a1ea7336-590f-47a0-82a3-2698c4de9e97",
                "x": 0,
                "y": 4,
                "w": 4,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Readings",
                    "description": "Readings in the timeframe, including state sensors such as doors and contacts that the graph can't plot. Over long timeframes some readings and state changes may be averaged or left out to stay within the row limit.",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[sensorHistory]}}",
                        "name": "sensorHistory",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [
                                [
                                    "time",
                                    "desc"
                                ]
                            ]
                        }
                    },
                    "scope": {
                        "scope": "{{scopes.[Sensors]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Sensor]}}"
                    },
                    "variables": [
                        "{{variables.[Sensor]}}"
                    ],
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": [
                                    "time",
                                    "valueText",
                                    "severityText",
                                    "units"
                                ],
                                "hiddenColumns": [
                                    "value",
                                    "series",
                                    "sensorLabel",
                                    "deviceLabel",
                                    "kind"
                                ]
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "time",
                                        "title": "Time",
                                        "renderer": {
                                            "type": "date"
                                        }
                                    },
                                    {
                                        "field": "valueText",
                                        "title": "Reading",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "units",
                                        "title": "Units",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "statusText",
                                        "title": "Status",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "OK": "#2fb344",
                                                "Normal": "#2fb344",
                                                "None": "#2fb344",
                                                "Information": "#2fb344",
                                                "Informational": "#2fb344",
                                                "Warning": "#f59f00",
                                                "Error": "#d63939",
                                                "Critical": "#d63939",
                                                "Failure": "#d63939"
                                            }
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableRowHighlight": {
                                    "field": "statusText",
                                    "colors": {
                                        "Warning": "rgba(245,159,0,0.12)",
                                        "Error": "rgba(214,57,57,0.12)",
                                        "Critical": "rgba(214,57,57,0.12)",
                                        "Failure": "rgba(214,57,57,0.12)"
                                    }
                                },
                                "richTableSort": {
                                    "field": "time",
                                    "direction": "desc"
                                }
                            }
                        }
                    }
                }
            }
        ]
    }
}
