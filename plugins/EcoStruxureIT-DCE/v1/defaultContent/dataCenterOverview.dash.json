                    "visualisation": {
                        "type": "data-stream-bar-chart",
                        "config": {
                            "data-stream-bar-chart": {
                                "xAxisData": "startTime_byDay",
                                "yAxisData": [
                                    "count"
                                ],
                                "xAxisGroup": "severityText_uniqueValues",
                                "xAxisLabel": "",
                                "yAxisLabel": "Alarms",
                                "showXAxisLabel": false,
                                "showYAxisLabel": true,
                                "showLegend": true,
                                "legendPosition": "bottom",
                                "showGrid": true,
                                "horizontalLayout": "vertical",
                                "displayMode": "actual",
                                "showTotals": true,
                                "showValue": false,
                                "grouping": false,
                                "range": {
                                    "type": "auto"
                                }
                            }
                        }
                    }
                }
