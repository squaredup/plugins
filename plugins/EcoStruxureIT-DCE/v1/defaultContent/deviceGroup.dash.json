{
    "name": "Device Group",
    "schemaVersion": "1.5",
    "timeframe": "none",
    "variables": [
        "{{variables.[Device Group]}}"
    ],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "dcccef89-6a4c-4a94-b3e8-349194170dbc",
                "x": 0,
                "y": 0,
                "w": 1,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Properties",
                    "description": "",
                    "timeframe": "none",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "datastream-properties",
                        "name": "properties"
                    },
                    "scope": {
                        "scope": "{{scopes.[Device Groups]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Device Group]}}"
                    },
                    "variables": [
                        "{{variables.[Device Group]}}"
                    ],
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": true
                            }
                        }
                    }
                }
            },
            {
                "i": "dd120dd0-e1f0-42fc-a488-14f350ff949e",
                "x": 1,
                "y": 0,
                "w": 1,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Alarm Summary",
                    "description": "",
                    "timeframe": "none",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[alarmSummary]}}",
                        "name": "alarmSummary",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "deviceGroup": {
                                "variable": "{{variables.[Device Group]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Device Groups]}}"
                            }
                        }
                    },
                    "variables": [
                        "{{variables.[Device Group]}}"
                    ],
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": true,
                                "columnOrder": [
                                    "status",
                                    "criticalAlarmCount",
                                    "warningAlarmCount",
                                    "infoAlarmCount",
                                    "totalAlarmCount"
                                ],
                                "hiddenColumns": [
                                    "deviceGroupName"
                                ]
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    {
                                        "field": "criticalAlarmCount",
                                        "type": "quantitative",
                                        "title": "Critical",
                                        "aggregate": "sum"
                                    },
                                    {
                                        "field": "warningAlarmCount",
                                        "type": "quantitative",
                                        "title": "Warning",
                                        "aggregate": "sum"
                                    },
                                    {
                                        "field": "infoAlarmCount",
                                        "type": "quantitative",
                                        "title": "Informational",
                                        "aggregate": "sum"
                                    },
                                    {
                                        "field": "totalAlarmCount",
                                        "type": "quantitative",
                                        "title": "Total",
                                        "aggregate": "sum"
                                    }
                                ]
                            },
                            "style": {
                                "scalarColumns": 2
                            }
                        }
                    }
                }
            },
            {
                "i": "f0aaf1f2-a8b6-4be2-9554-56be51911800",
                "x": 2,
                "y": 0,
                "w": 2,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Active Alarms",
                    "description": "Active alarms on devices in this group and its sub-groups",
                    "timeframe": "none",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[alarms]}}",
                        "name": "alarms",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "deviceGroup": {
                                "variable": "{{variables.[Device Group]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Device Groups]}}"
                            }
                        }
                    },
                    "variables": [
                        "{{variables.[Device Group]}}"
                    ],
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": [
                                    "severityText",
                                    "description",
                                    "deviceName",
                                    "startTime",
                                    "durationSeconds"
                                ],
                                "hiddenColumns": [
                                    "deviceName",
                                    "hidden",
                                    "alarmAlertSuppressed"
                                ]
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "statusText",
                                        "title": "Severity",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "OK": "#2fb344",
                                                "Normal": "#2fb344",
                                                "None": "#2fb344",
                                                "Information": "#2fb344",
                                                "Informational": "#2fb344",
                                                "Warning": "#f59f00",
                                                "Error": "#d63939",
                                                "Critical": "#d63939",
                                                "Failure": "#d63939"
                                            }
                                        }
                                    },
                                    {
                                        "field": "category",
                                        "title": "Category",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "Environmental": "#1c7ed6",
                                                "Power": "#7048e8",
                                                "Other": "#868e96"
                                            }
                                        }
                                    },
                                    {
                                        "field": "description",
                                        "title": "Alarm",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "deviceName",
                                        "title": "Device",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "startTime",
                                        "title": "Started",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableSort": {
                                    "field": "startTime",
                                    "direction": "desc"
                                }
                            }
                        }
                    }
                }
            },
            {
                "i": "1b35a20c-ed9c-4f99-9b6e-c7e7d786e347",
                "x": 0,
                "y": 4,
                "w": 4,
                "h": 5,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Devices",
                    "description": "",
                    "timeframe": "none",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[deviceGroupDevices]}}",
                        "name": "deviceGroupDevices",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Device Groups]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Device Group]}}"
                    },
                    "variables": [
                        "{{variables.[Device Group]}}"
                    ],
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": [
                                    "label",
                                    "severityText",
                                    "type",
                                    "model",
                                    "hostname",
                                    "ipAddress",
                                    "location",
                                    "serialNumber",
                                    "inMaintenance"
                                ]
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "label",
                                        "title": "Device",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "statusText",
                                        "title": "Status",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "OK": "#2fb344",
                                                "Normal": "#2fb344",
                                                "None": "#2fb344",
                                                "Information": "#2fb344",
                                                "Informational": "#2fb344",
                                                "Warning": "#f59f00",
                                                "Error": "#d63939",
                                                "Critical": "#d63939",
                                                "Failure": "#d63939"
                                            }
                                        }
                                    },
                                    {
                                        "field": "type",
                                        "title": "Type",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "model",
                                        "title": "Model",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "location",
                                        "title": "Location",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "ipAddress",
                                        "title": "IP Address",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "hostname",
                                        "title": "Hostname",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "serialNumber",
                                        "title": "Serial Number",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "inMaintenance",
                                        "title": "In Maintenance",
                                        "renderer": {
                                            "type": "boolean",
                                            "trueLabel": "Yes",
                                            "falseLabel": "No",
                                            "trueColor": "#f59f00",
                                            "falseColor": "#868e96"
                                        },
                                        "align": "center"
                                    }
                                ]
                            },
                            "style": {
                                "richTableRowHighlight": {
                                    "field": "statusText",
                                    "colors": {
                                        "Warning": "rgba(245,159,0,0.12)",
                                        "Error": "rgba(214,57,57,0.12)",
                                        "Critical": "rgba(214,57,57,0.12)",
                                        "Failure": "rgba(214,57,57,0.12)"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        ]
    }
}
