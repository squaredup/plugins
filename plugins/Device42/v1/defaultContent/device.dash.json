{
    "name": "Device",
    "schemaVersion": "1.5",
    "timeframe": "last30days",
    "variables": [
        "{{variables.[Device42 Device]}}"
    ],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "ad2a5df0-04c1-4fc9-be29-9f7d3bd372d8",
                "x": 0,
                "y": 0,
                "w": 2,
                "h": 6,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Device Details",
                    "description": "Identity, operating system and hardware of this device",
                    "timeframe": "none",
                    "variables": [
                        "{{variables.[Device42 Device]}}"
                    ],
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[devices]}}",
                        "name": "devices",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "building": [],
                            "customer": [],
                            "rack": [],
                            "device": {
                                "variable": "{{variables.[Device42 Device]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Device42 Devices]}}"
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "name",
                                        "title": "Device",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "type",
                                        "title": "Type",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "subtype",
                                        "title": "Subtype",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "os",
                                        "title": "Operating System",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "os_version",
                                        "title": "OS Version",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "hardware_model",
                                        "title": "Hardware Model",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "manufacturer",
                                        "title": "Manufacturer",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "serial_no",
                                        "title": "Serial Number",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "asset_no",
                                        "title": "Asset Number",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "cpus",
                                        "title": "CPUs",
                                        "renderer": {
                                            "type": "number"
                                        },
                                        "align": "right"
                                    },
                                    {
                                        "field": "cores_per_cpu",
                                        "title": "Cores per CPU",
                                        "renderer": {
                                            "type": "number"
                                        },
                                        "align": "right"
                                    },
                                    {
                                        "field": "memory",
                                        "title": "Memory",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableTranspose": true,
                                "richTableWrapText": true
                            }
                        }
                    }
                }
            },
            {
                "i": "e76a1768-e7d2-42a7-9f0c-6b09b8e04d01",
                "x": 2,
                "y": 0,
                "w": 2,
                "h": 6,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Location and Service",
                    "description": "Where this device is, who it belongs to, its addresses and when Device42 last saw it",
                    "timeframe": "none",
                    "variables": [
                        "{{variables.[Device42 Device]}}"
                    ],
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[devices]}}",
                        "name": "devices",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "building": [],
                            "customer": [],
                            "rack": [],
                            "device": {
                                "variable": "{{variables.[Device42 Device]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Device42 Devices]}}"
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "customer",
                                        "title": "Customer",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "building",
                                        "title": "Building",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "room",
                                        "title": "Room",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "rack",
                                        "title": "Rack",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "rack_position",
                                        "title": "Rack Position (U)",
                                        "renderer": {
                                            "type": "number"
                                        },
                                        "align": "right"
                                    },
                                    {
                                        "field": "virtual_host",
                                        "title": "Virtual Host",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "service_level",
                                        "title": "Service Level",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "in_service",
                                        "title": "In Service",
                                        "renderer": {
                                            "type": "boolean"
                                        }
                                    },
                                    {
                                        "field": "ip_addresses",
                                        "title": "IP Addresses",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "first_added",
                                        "title": "First Added",
                                        "renderer": {
                                            "type": "date"
                                        }
                                    },
                                    {
                                        "field": "last_edited",
                                        "title": "Last Edited",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    },
                                    {
                                        "field": "last_discovered",
                                        "title": "Last Discovered",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableTranspose": true,
                                "richTableWrapText": true
                            }
                        }
                    }
                }
            }
        ]
    }
}
