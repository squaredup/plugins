{
    "name": "Rack",
    "schemaVersion": "1.5",
    "timeframe": "last30days",
    "variables": [
        "{{variables.[Device42 Rack]}}"
    ],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "c23b30ae-2120-453b-b1ab-c2af086ee0ba",
                "x": 0,
                "y": 0,
                "w": 1,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Devices",
                    "description": "Devices mounted in this rack",
                    "timeframe": "none",
                    "variables": [
                        "{{variables.[Device42 Rack]}}"
                    ],
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[deviceSummary]}}",
                        "name": "deviceSummary",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "building": [],
                            "customer": [],
                            "rack": {
                                "variable": "{{variables.[Device42 Rack]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Device42 Racks]}}"
                            },
                            "groupBy": "type"
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    {
                                        "field": "devices",
                                        "type": "quantitative",
                                        "title": "Devices",
                                        "aggregate": "sum"
                                    }
                                ]
                            },
                            "style": {
                                "scalarLabelPosition": "none"
                            }
                        }
                    }
                }
            },
            {
                "i": "cfc20aa6-49c3-43c9-aa50-3b75c9611abd",
                "x": 1,
                "y": 0,
                "w": 1,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Devices by Type",
                    "description": "Devices in this rack by Device42 type",
                    "timeframe": "none",
                    "variables": [
                        "{{variables.[Device42 Rack]}}"
                    ],
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[deviceSummary]}}",
                        "name": "deviceSummary",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "building": [],
                            "customer": [],
                            "rack": {
                                "variable": "{{variables.[Device42 Rack]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Device42 Racks]}}"
                            },
                            "groupBy": "type"
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "pie",
                            "encoding": {
                                "label": {
                                    "field": "category",
                                    "type": "nominal",
                                    "title": "Type"
                                },
                                "value": {
                                    "field": "devices",
                                    "type": "quantitative",
                                    "title": "Devices",
                                    "aggregate": "sum"
                                }
                            },
                            "style": {
                                "pieInnerRadius": 60,
                                "pieDonutCenterValue": "total",
                                "labelFontSize": 16,
                                "pieSort": "desc"
                            }
                        }
                    }
                }
            },
            {
                "i": "bf87d27e-3bb6-43bc-a979-49db8c7f25d8",
                "x": 2,
                "y": 0,
                "w": 2,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Devices by Hardware Model",
                    "description": "The 10 hardware models with the most devices in this rack",
                    "timeframe": "none",
                    "variables": [
                        "{{variables.[Device42 Rack]}}"
                    ],
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[deviceSummary]}}",
                        "name": "deviceSummary",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "building": [],
                            "customer": [],
                            "rack": {
                                "variable": "{{variables.[Device42 Rack]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Device42 Racks]}}"
                            },
                            "groupBy": "hardwareModel"
                        },
                        "filter": {
                            "multiOperation": "and",
                            "filters": [
                                {
                                    "column": "category",
                                    "operation": "notequals",
                                    "value": "(no hardware model)"
                                }
                            ]
                        },
                        "sort": {
                            "by": [
                                [
                                    "devices",
                                    "desc"
                                ]
                            ],
                            "top": 10
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "category",
                                    "type": "nominal",
                                    "title": "Hardware Model"
                                },
                                "y": {
                                    "field": "devices",
                                    "type": "quantitative",
                                    "title": "Devices"
                                }
                            },
                            "style": {
                                "cartesianHorizontal": true,
                                "showLabels": true
                            }
                        }
                    }
                }
            },
            {
                "i": "dc33b8a5-5675-402c-8b2a-a77e306beb51",
                "x": 0,
                "y": 3,
                "w": 4,
                "h": 6,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Devices in Rack",
                    "description": "Devices in this rack, from the top rack unit down",
                    "timeframe": "none",
                    "variables": [
                        "{{variables.[Device42 Rack]}}"
                    ],
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[devices]}}",
                        "name": "devices",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "building": [],
                            "customer": [],
                            "rack": {
                                "variable": "{{variables.[Device42 Rack]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Device42 Racks]}}"
                            },
                            "device": []
                        },
                        "sort": {
                            "by": [
                                [
                                    "rack_position",
                                    "desc"
                                ]
                            ]
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "rack_position",
                                        "title": "Rack Position (U)",
                                        "renderer": {
                                            "type": "number"
                                        },
                                        "align": "right"
                                    },
                                    {
                                        "field": "name",
                                        "title": "Device",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "type",
                                        "title": "Type",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "hardware_model",
                                        "title": "Hardware Model",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "manufacturer",
                                        "title": "Manufacturer",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "serial_no",
                                        "title": "Serial Number",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "os",
                                        "title": "Operating System",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "customer",
                                        "title": "Customer",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "service_level",
                                        "title": "Service Level",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "in_service",
                                        "title": "In Service",
                                        "renderer": {
                                            "type": "boolean"
                                        }
                                    },
                                    {
                                        "field": "last_discovered",
                                        "title": "Last Discovered",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableSort": {
                                    "field": "rack_position",
                                    "direction": "desc"
                                }
                            }
                        }
                    }
                }
            }
        ]
    }
}
