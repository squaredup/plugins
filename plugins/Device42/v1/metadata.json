{
    "name": "device42",
    "displayName": "Device42",
    "version": "1.0.0",
    "author": {
        "name": "@shawn149",
        "type": "community"
    },
    "description": "Track devices, data center capacity, IP subnets, hardware lifecycle and business applications from your Device42 CMDB.",
    "category": "Infrastructure",
    "type": "hybrid",
    "schemaVersion": "2.1",
    "importNotSupported": false,
    "restrictedToPlatforms": [],
    "keywords": [
        "device42",
        "cmdb",
        "dcim",
        "ipam",
        "asset",
        "inventory",
        "data center",
        "rack",
        "subnet",
        "freshworks"
    ],
    "objectTypes": ["Device", "Building", "Room", "Rack", "Customer", "Business Application"],
    "links": [
        {
            "category": "documentation",
            "url": "https://github.com/squaredup/plugins/blob/main/plugins/Device42/v1/docs/README.md",
            "label": "Help adding this plugin"
        },
        {
            "category": "source",
            "url": "https://github.com/squaredup/plugins/tree/main/plugins/Device42/v1",
            "label": "Repository"
        }
    ],
    "screenshots": [
        "https://github.com/squaredup/plugins/blob/main/plugins/Device42/v1/screenshots/overview.png",
        "https://github.com/squaredup/plugins/blob/main/plugins/Device42/v1/screenshots/building.png",
        "https://github.com/squaredup/plugins/blob/main/plugins/Device42/v1/screenshots/rack.png",
        "https://github.com/squaredup/plugins/blob/main/plugins/Device42/v1/screenshots/customer.png"
    ],
    "base": {
        "plugin": "WebAPI",
        "majorVersion": "1",
        "config": {
            "baseUrl": "{{serverUrl.trim().replace(/[/]+$/, '')}}",
            "authMode": "none",
            "headers": [
                {
                    "key": "Accept",
                    "value": "application/json"
                }
            ],
            "queryArgs": [],
            "scriptingVariables": [
                {
                    "key": "apiClientKey",
                    "value": "{{apiClientKey}}"
                },
                {
                    "key": "apiClientSecret",
                    "value": "{{apiClientSecret}}"
                }
            ],
            "preRequestScript": "preRequest.js",
            "showScripting": true
        }
    }
}
