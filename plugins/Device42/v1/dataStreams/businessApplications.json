{
    "name": "businessApplications",
    "displayName": "Business Applications",
    "description": "Business applications in Device42, with criticality, service level, owners and data sensitivity",
    "tags": ["Application", "Inventory"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/api/1.0/businessapps/",
        "pathToData": "businessapps",
        "paging": {
            "mode": "offset",
            "pageSize": { "realm": "queryArg", "path": "limit", "value": "500" },
            "offset": {
                "mode": "row",
                "rowCountIn": { "realm": "payloadArraySize", "path": "businessapps" },
                "base": 0
            },
            "out": { "realm": "queryArg", "path": "offset" }
        },
        "errorHandling": { "type": "path", "realm": "payload", "path": "msg" }
    },
    "matches": "none",
    "metadata": [
        { "name": "name", "displayName": "Business Application", "shape": "string", "role": "label", "sourceId": "businessapp_id", "sourceType": "Business Application" },
        { "name": "businessapp_id", "displayName": "Application ID", "shape": ["number", { "thousandsSeparator": false }], "role": "id", "visible": false },
        { "name": "criticality", "displayName": "Criticality", "shape": "string" },
        { "name": "app_type", "displayName": "Type", "shape": "string" },
        { "name": "service_level", "displayName": "Service Level", "shape": "string" },
        { "name": "cust_owner", "displayName": "Customer", "shape": "string" },
        { "name": "business_app_owner", "displayName": "Business Owner", "shape": "string" },
        { "name": "technical_app_owner", "displayName": "Technical Owner", "shape": "string" },
        { "name": "is_contains_pii", "displayName": "Contains PII", "shape": "string" },
        { "name": "is_internet_accessible", "displayName": "Internet Accessible", "shape": "string" },
        { "name": "migration_group", "displayName": "Migration Group", "shape": "string" },
        { "name": "description", "displayName": "Description", "shape": "string" },
        { "name": "last_changed", "displayName": "Last Changed", "shape": "date" }
    ],
    "timeframes": false
}
