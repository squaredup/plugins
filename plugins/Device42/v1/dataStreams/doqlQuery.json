{
    "name": "doqlQuery",
    "displayName": "DOQL Query",
    "description": "Results of a Device42 Object Query Language (DOQL) query that you write",
    "tags": [
        "Query"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "manualConfigApply": true,
    "config": {
        "httpMethod": "get",
        "endpointPath": "/services/data/v1.0/query/",
        "getArgs": [
            {
                "key": "query",
                "value": "{{query}}"
            },
            {
                "key": "output_type",
                "value": "json"
            }
        ],
        "paging": {
            "mode": "none"
        },
        "errorHandling": {
            "type": "path",
            "realm": "payload",
            "path": "msg"
        }
    },
    "matches": "none",
    "ui": [
        {
            "type": "code",
            "name": "query",
            "label": "DOQL query",
            "language": "sql",
            "defaultValue": "select name, type, os_name, service_level from view_device_v2 order by name limit 100",
            "help": "Write a read-only SQL query against the [DOQL views](https://docs.device42.com/reports/device42-doql/). Results are limited to what the API client's owner can see.",
            "validation": {
                "required": true
            }
        }
    ],
    "metadata": [
        {
            "pattern": ".*"
        }
    ],
    "timeframes": false
}
