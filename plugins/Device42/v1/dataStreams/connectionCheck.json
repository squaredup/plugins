{
    "name": "connectionCheck",
    "displayName": "Connection Check",
    "description": "One building from Device42, enough to confirm the URL and API client work",
    "tags": ["Data Center"],
    "visibility": { "type": "hidden" },
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/api/1.0/buildings/",
        "getArgs": [{ "key": "limit", "value": "1" }],
        "pathToData": "buildings",
        "paging": { "mode": "none" },
        "errorHandling": { "type": "path", "realm": "payload", "path": "msg" }
    },
    "matches": "none",
    "metadata": [
        { "name": "name", "displayName": "Building", "shape": "string", "role": "label" },
        { "name": "building_id", "displayName": "Building ID", "shape": ["number", { "thousandsSeparator": false }], "role": "id" }
    ],
    "timeframes": false
}
