{
    "name": "racks",
    "displayName": "Racks",
    "description": "Racks in Device42, with their location, size and free rack units",
    "tags": ["Data Center", "Capacity"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/api/1.0/racks/",
        "getArgs": [
            {
                "key": "building",
                "value": "{{[].concat(building || []).map((o) => [].concat(o.name)[0]).filter(Boolean)[0] || null}}"
            }
        ],
        "pathToData": "racks",
        "paging": {
            "mode": "offset",
            "pageSize": { "realm": "queryArg", "path": "limit", "value": "500" },
            "offset": {
                "mode": "row",
                "rowCountIn": { "realm": "payloadArraySize", "path": "racks" },
                "base": 0
            },
            "out": { "realm": "queryArg", "path": "offset" }
        },
        "errorHandling": { "type": "path", "realm": "payload", "path": "msg" }
    },
    "matches": "none",
    "ui": [
        {
            "type": "objects",
            "name": "building",
            "label": "Building (optional)",
            "matches": { "sourceType": { "type": "oneOf", "values": ["Building"] } }
        }
    ],
    "metadata": [
        { "name": "name", "displayName": "Rack", "shape": "string", "role": "label", "sourceId": "rack_id", "sourceType": "Rack" },
        { "name": "rack_id", "displayName": "Rack ID", "shape": ["number", { "thousandsSeparator": false }], "role": "id", "visible": false },
        { "name": "building", "displayName": "Building", "shape": "string" },
        { "name": "room", "displayName": "Room", "shape": "string" },
        { "name": "row", "displayName": "Row", "shape": "string" },
        { "name": "size", "displayName": "Size (U)", "shape": "number" },
        { "name": "available_u", "displayName": "Free (U)", "shape": "number" },
        {
            "name": "used_u",
            "displayName": "Used (U)",
            "shape": "number",
            "computed": true,
            "valueExpression": "{{ Number($['size']) > 0 ? Number($['size']) - Number($['available_u'] || 0) : null }}"
        },
        {
            "name": "utilization",
            "displayName": "Utilization",
            "shape": ["percent", { "decimalPlaces": 0 }],
            "role": "value",
            "computed": true,
            "valueExpression": "{{ Number($['size']) > 0 ? Math.round(((Number($['size']) - Number($['available_u'] || 0)) / Number($['size'])) * 1000) / 10 : null }}"
        },
        { "name": "manufacturer", "displayName": "Manufacturer", "shape": "string" },
        { "name": "asset_no", "displayName": "Asset Number", "shape": "string" }
    ],
    "timeframes": false
}
