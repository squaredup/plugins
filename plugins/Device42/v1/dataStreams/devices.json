            "shape": "number",
            "visible": false
        },
        {
            "name": "ram_size_type",
            "displayName": "Memory Unit",
            "shape": "string",
            "visible": false
        },
        {
            "name": "memory",
            "displayName": "Memory",
            "shape": "string",
            "computed": true,
            "valueExpression": "{{ typeof $['ram'] === 'number' && $['ram'] > 0 ? $['ram'] + (typeof $['ram_size_type'] === 'string' ? ' ' + $['ram_size_type'] : '') : null }}"
        },
        {
            "name": "ip_addresses",
            "displayName": "IP Addresses",
            "shape": [
                "array",
                {
                    "itemShape": "string"
                }
            ]
        },
        {
            "name": "first_added",
            "displayName": "First Added",
            "shape": "date"
        },
        {
            "name": "last_edited",
            "displayName": "Last Edited",
            "shape": "date"
        },
        {
            "name": "last_discovered",
            "displayName": "Last Discovered",
            "shape": "date"
        }
    ],
    "timeframes": false
}
