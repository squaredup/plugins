            "sourceType": "Rack"
        },
        {
            "name": "rack_position",
            "displayName": "Rack Position (U)",
            "shape": "number"
        },
        {
            "name": "virtual_host",
            "displayName": "Virtual Host",
            "shape": "string"
        },
        {
            "name": "cpus",
            "displayName": "CPUs",
            "shape": "number"
        },
        {
            "name": "cores_per_cpu",
            "displayName": "Cores per CPU",
            "shape": "number"
        },
        {
