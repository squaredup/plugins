{
    "name": "devices",
    "displayName": "Devices",
    "description": "Devices in Device42 with their hardware, operating system and location, up to 2,000 rows sorted by name",
    "tags": [
        "Device",
        "Inventory"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/services/data/v1.0/query/",
        "getArgs": [
            {
                "key": "query",
                "value": "{{ (() => { const ids = (sel) => [].concat(sel || []).map((o) => Number([].concat(o.rawId)[0])).filter((n) => Number.isInteger(n)); const where = []; const b = ids(typeof building === 'undefined' ? [] : building); if (b.length) where.push('d.calculated_building_fk in (' + b.join(',') + ')'); const c = ids(typeof customer === 'undefined' ? [] : customer); if (c.length) where.push('d.customer_fk in (' + c.join(',') + ')'); const r = ids(typeof rack === 'undefined' ? [] : rack); if (r.length) where.push('d.calculated_rack_fk in (' + r.join(',') + ')'); const t = [].concat(typeof deviceType === 'undefined' ? [] : deviceType).map((x) => (x && x.value) || x)[0] || ''; if (['physical', 'virtual', 'cluster', 'blade', 'other', 'unknown'].includes(t)) where.push(\"d.type = '\" + t + \"'\"); const dv = ids(typeof device === 'undefined' ? [] : device); if (dv.length) where.push('d.device_pk in (' + dv.join(',') + ')'); return 'select d.device_pk as device_id, d.name, d.type, coalesce(d.physicalsubtype, d.virtualsubtype) as subtype,' + ' d.os_name as os, d.os_version, h.name as hardware_model, v.name as manufacturer, d.serial_no,' + ' d.in_service, d.service_level, c.name as customer, d.calculated_building_fk as building_id, b.name as building,' + ' d.calculated_room_fk as room_id, r.name as room, d.calculated_rack_fk as rack_id, k.name as rack, d.start_at as rack_position,' + ' vh.name as virtual_host,' + (dv.length ? ' d.total_cpus as cpus, d.core_per_cpu as cores_per_cpu, d.ram, d.ram_size_type, d.asset_no, d.first_added, d.last_edited,' : ' null as cpus, null as cores_per_cpu, null as ram, null as ram_size_type, null as asset_no, null as first_added, null as last_edited,') + (dv.length ? ' (select array_to_json(array_agg(host(i.ip_address) order by i.ip_address))::text from view_ipaddress_v1 i where i.device_fk = d.device_pk)' : ' null') + ' as ip_addresses,' + ' d.last_discovered' + ' from view_device_v2 d left join view_hardware_v2 h on h.hardware_pk = d.hardware_fk left join view_vendor_v1 v on v.vendor_pk = h.vendor_fk left join view_customer_v1 c on c.customer_pk = d.customer_fk left join view_building_v1 b on b.building_pk = d.calculated_building_fk left join view_room_v1 r on r.room_pk = d.calculated_room_fk left join view_rack_v1 k on k.rack_pk = d.calculated_rack_fk left join view_device_v2 vh on vh.device_pk = d.virtual_host_device_fk' + (where.length ? ' where ' + where.join(' and ') : '') + ' order by d.name limit 2000'; })() }}"
            },
            {
                "key": "output_type",
                "value": "json"
            }
        ],
        "paging": {
            "mode": "none"
        },
        "errorHandling": {
            "type": "path",
            "realm": "payload",
            "path": "msg"
        }
    },
    "matches": "none",
    "ui": [
        {
            "type": "choiceChips",
            "name": "deviceType",
            "label": "Device type (optional)",
            "options": [
                {
                    "value": "physical",
                    "label": "Physical"
                },
                {
                    "value": "virtual",
                    "label": "Virtual"
                },
                {
                    "value": "cluster",
                    "label": "Cluster"
                },
                {
                    "value": "blade",
                    "label": "Blade"
                },
                {
                    "value": "other",
                    "label": "Other"
                }
            ]
        },
        {
            "type": "objects",
            "name": "building",
            "label": "Building (optional)",
            "matches": {
                "sourceType": {
                    "type": "oneOf",
                    "values": [
                        "Building"
                    ]
                }
            }
        },
        {
            "type": "objects",
            "name": "customer",
            "label": "Customer (optional)",
            "matches": {
                "sourceType": {
                    "type": "oneOf",
                    "values": [
                        "Customer"
                    ]
                }
            }
        },
        {
            "type": "objects",
            "name": "rack",
            "label": "Rack (optional)",
            "matches": {
                "sourceType": {
                    "type": "oneOf",
                    "values": [
                        "Rack"
                    ]
                }
            }
        },
        {
            "type": "objects",
            "name": "device",
            "label": "Device (optional)",
            "matches": {
                "sourceType": {
                    "type": "oneOf",
                    "values": [
                        "Device"
                    ]
                }
            }
        }
    ],
    "metadata": [
        {
            "name": "name",
            "displayName": "Device",
            "shape": "string",
            "role": "label",
            "sourceId": "device_id",
            "sourceType": "Device"
        },
        {
            "name": "device_id",
            "displayName": "Device ID",
            "shape": [
                "number",
                {
                    "thousandsSeparator": false
                }
            ],
            "role": "id",
            "visible": false
        },
        {
            "name": "type",
            "displayName": "Type",
            "shape": "string"
        },
        {
            "name": "subtype",
            "displayName": "Subtype",
            "shape": "string"
        },
        {
            "name": "os",
            "displayName": "Operating System",
            "shape": "string"
        },
        {
            "name": "os_version",
            "displayName": "OS Version",
            "shape": "string"
        },
        {
            "name": "hardware_model",
            "displayName": "Hardware Model",
            "shape": "string"
        },
        {
            "name": "manufacturer",
            "displayName": "Manufacturer",
            "shape": "string"
        },
        {
            "name": "serial_no",
            "displayName": "Serial Number",
            "shape": "string"
        },
        {
            "name": "asset_no",
            "displayName": "Asset Number",
            "shape": "string"
        },
        {
            "name": "in_service",
            "displayName": "In Service",
            "shape": "boolean"
        },
        {
            "name": "service_level",
            "displayName": "Service Level",
            "shape": "string"
        },
        {
            "name": "customer",
            "displayName": "Customer",
            "shape": "string"
        },
        {
            "name": "building_id",
            "displayName": "Building ID",
            "shape": [
                "number",
                {
                    "thousandsSeparator": false
                }
            ],
            "visible": false
        },
        {
            "name": "building",
            "displayName": "Building",
            "shape": "string",
            "sourceId": "building_id",
            "sourceType": "Building"
        },
        {
            "name": "room_id",
            "displayName": "Room ID",
            "shape": [
                "number",
                {
                    "thousandsSeparator": false
                }
            ],
            "visible": false
        },
        {
            "name": "room",
            "displayName": "Room",
            "shape": "string",
            "sourceId": "room_id",
