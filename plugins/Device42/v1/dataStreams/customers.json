{
    "name": "customers",
    "displayName": "Customers",
    "description": "Customers (departments or tenants) defined in Device42, with contact details",
    "tags": ["Inventory"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/api/1.0/customers/",
        "pathToData": "Customers",
        "paging": {
            "mode": "offset",
            "pageSize": { "realm": "queryArg", "path": "limit", "value": "500" },
            "offset": {
                "mode": "row",
                "rowCountIn": { "realm": "payloadArraySize", "path": "Customers" },
                "base": 0
            },
            "out": { "realm": "queryArg", "path": "offset" }
        },
        "errorHandling": { "type": "path", "realm": "payload", "path": "msg" }
    },
    "matches": "none",
    "metadata": [
        { "name": "name", "displayName": "Customer", "shape": "string", "role": "label", "sourceId": "id", "sourceType": "Customer" },
        { "name": "id", "displayName": "Customer ID", "shape": ["number", { "thousandsSeparator": false }], "role": "id", "visible": false },
        { "name": "contact_info", "displayName": "Contact", "shape": "string" },
        { "name": "manager", "displayName": "Manager", "shape": "string" },
        { "name": "notes", "displayName": "Notes", "shape": "string" }
    ],
    "timeframes": false
}
