{
    "name": "deviceList",
    "displayName": "Device List",
    "description": "Every device in Device42 with its type, operating system, hardware and location, fetched page by page",
    "tags": [
        "Device",
        "Inventory"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/api/1.0/devices/all/",
        "getArgs": [
            {
                "key": "include_cols",
                "value": "device_id,name,type,os,hw_model,manufacturer,serial_no,in_service,service_level,customer,building,room,rack"
            }
        ],
        "pathToData": "Devices",
        "paging": {
            "mode": "offset",
            "pageSize": {
                "realm": "queryArg",
                "path": "limit",
                "value": "1000"
            },
            "offset": {
                "mode": "row",
                "rowCountIn": {
                    "realm": "payloadArraySize",
                    "path": "Devices"
                },
                "base": 0
            },
            "out": {
                "realm": "queryArg",
                "path": "offset"
            }
        },
        "errorHandling": {
            "type": "path",
            "realm": "payload",
            "path": "msg"
        }
    },
    "matches": "none",
    "metadata": [
        {
            "name": "name",
            "displayName": "Device",
            "shape": "string",
            "role": "label",
            "sourceId": "device_id",
            "sourceType": "Device"
        },
        {
            "name": "device_id",
            "displayName": "Device ID",
            "shape": [
                "number",
                {
                    "thousandsSeparator": false
                }
            ],
            "role": "id",
            "visible": false
        },
        {
            "name": "type",
            "displayName": "Type",
            "shape": "string"
        },
        {
            "name": "os",
            "displayName": "Operating System",
            "shape": "string"
        },
        {
            "name": "hw_model",
            "displayName": "Hardware Model",
            "shape": "string"
        },
        {
            "name": "manufacturer",
            "displayName": "Manufacturer",
            "shape": "string"
        },
        {
            "name": "serial_no",
            "displayName": "Serial Number",
            "shape": "string"
        },
        {
            "name": "in_service",
            "displayName": "In Service",
            "shape": "boolean"
        },
        {
            "name": "service_level",
            "displayName": "Service Level",
            "shape": "string"
        },
        {
            "name": "customer",
            "displayName": "Customer",
            "shape": "string"
        },
        {
            "name": "building",
            "displayName": "Building",
            "shape": "string"
        },
        {
            "name": "room",
            "displayName": "Room",
            "shape": "string"
        },
        {
            "name": "rack",
            "displayName": "Rack",
            "shape": "string"
        }
    ],
    "timeframes": false,
    "visibility": {
        "type": "hidden"
    }
}
