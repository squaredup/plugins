{
    "name": "buildings",
    "displayName": "Buildings",
    "description": "Buildings in Device42, with address and contact details",
    "tags": ["Data Center", "Inventory"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/api/1.0/buildings/",
        "pathToData": "buildings",
        "paging": {
            "mode": "offset",
            "pageSize": { "realm": "queryArg", "path": "limit", "value": "500" },
            "offset": {
                "mode": "row",
                "rowCountIn": { "realm": "payloadArraySize", "path": "buildings" },
                "base": 0
            },
            "out": { "realm": "queryArg", "path": "offset" }
        },
        "errorHandling": { "type": "path", "realm": "payload", "path": "msg" }
    },
    "matches": "none",
    "metadata": [
        { "name": "name", "displayName": "Building", "shape": "string", "role": "label", "sourceId": "building_id", "sourceType": "Building" },
        { "name": "building_id", "displayName": "Building ID", "shape": ["number", { "thousandsSeparator": false }], "role": "id", "visible": false },
        { "name": "address", "displayName": "Address", "shape": "string" },
        { "name": "contact_name", "displayName": "Contact", "shape": "string" },
        { "name": "contact_phone", "displayName": "Contact Phone", "shape": "string" }
    ],
    "timeframes": false
}
