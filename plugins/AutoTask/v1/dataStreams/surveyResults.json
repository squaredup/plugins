{
    "name": "surveyResults",
    "displayName": "Survey Results",
    "description": "Survey results submitted within the selected timeframe",
    "tags": ["surveys"],
    "baseDataSourceName": "httpRequestUnscoped",
    "timeframes": ["last24hours", "last7days", "last30days", "thisMonth", "lastMonth", "thisQuarter", "lastQuarter", "thisYear"],
    "config": {
        "httpMethod": "get",
        "expandInnerObjects": true,
        "endpointPath": "atservicesrest/v1.0/SurveyResults/query?search={\"MaxRecords\":500,\"filter\":[{\"op\":\"gte\",\"field\":\"createDate\",\"value\":\"{{timeframe.start}}\"},{\"op\":\"lte\",\"field\":\"createDate\",\"value\":\"{{timeframe.end}}\"}]}",
        "pathToData": "items",
        "paging": {
            "mode": "nextUrl",
            "pageSize": { "realm": "none" },
            "in": {
                "realm": "payload",
                "path": "pageDetails.nextPageUrl"
            }
        }
    },
    "metadata": [
        { "name": "id", "displayName": "ID", "shape": "string", "visible": false },
        { "pattern": ".*" }
    ]
}
