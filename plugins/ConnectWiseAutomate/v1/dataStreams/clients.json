{
    "name": "clients",
    "displayName": "Client List",
    "description": "Automate clients, one row per client (import only)",
    "tags": [
        "Organization"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "clients",
        "getArgs": [
            {
                "key": "orderBy",
                "value": "Id asc"
            }
        ],
        "expandInnerObjects": true,
        "paging": {
            "mode": "offset",
            "pageSize": {
                "realm": "queryArg",
                "path": "pageSize",
                "value": "500"
            },
            "offset": {
                "mode": "page",
                "rowCountIn": {
                    "realm": "payloadArraySize",
                    "path": "."
                },
                "base": 1
            },
            "out": {
                "realm": "queryArg",
                "path": "page"
            }
        }
    },
    "matches": "none",
    "metadata": [
        {
            "pattern": ".*"
        }
    ],
    "timeframes": false,
    "visibility": {
        "type": "hidden"
    }
}
