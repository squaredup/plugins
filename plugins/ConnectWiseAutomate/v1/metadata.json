{
    "name": "connectwise-automate",
    "displayName": "ConnectWise Automate",
    "version": "1.0.0",
    "author": { "name": "@Deenk", "type": "community" },
    "description": "Monitor computers, clients, locations, network devices and tickets managed by ConnectWise Automate.",
    "category": "Monitoring",
    "type": "hybrid",
    "schemaVersion": "2.1",
    "importNotSupported": false,
    "restrictedToPlatforms": [],
    "keywords": ["rmm", "msp", "connectwise", "automate", "labtech", "agents", "endpoints"],
    "objectTypes": ["Client", "Location", "Computer", "Network Device"],
    "links": [
        {
            "category": "documentation",
            "url": "https://github.com/squaredup/plugins/blob/main/plugins/ConnectWiseAutomate/v1/docs/README.md",
            "label": "Help adding this plugin"
        },
        {
            "category": "source",
            "url": "https://github.com/squaredup/plugins/tree/main/plugins/ConnectWiseAutomate/v1",
            "label": "Repository"
        }
    ],
    "base": {
        "plugin": "WebAPI",
        "majorVersion": "1",
        "config": {
            "baseUrl": "{{serverUrl}}/cwa/api/v1",
            "authMode": "none",
            "headers": [{ "key": "Accept", "value": "application/json" }],
            "queryArgs": [],
            "scriptingVariables": [
                { "key": "serverUrl", "value": "{{serverUrl}}" },
                { "key": "username", "value": "{{username}}" },
                { "key": "password", "value": "{{password}}" },
                { "key": "clientId", "value": "{{clientId}}" }
            ],
            "preRequestScript": "preRequest.js",
            "showScripting": true
        }
    }
}
