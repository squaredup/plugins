{
    "name": "internetSpeed",
    "displayName": "Internet speed",
    "description": "Internet download and upload speed tests measured by a collector",
    "tags": ["Network", "Performance"],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/agent/{{object.rawId}}/history/network/speed",
        "paging": { "mode": "none" },
        "postRequestScript": "internetSpeed.js",
        "getArgs": [
            { "key": "from", "value": "{{timeframe.start}}" },
            { "key": "to", "value": "{{timeframe.end}}" }
        ],
        "headers": []
    },
    "matches": { "sourceType": { "type": "oneOf", "values": ["Collector"] } },
    "metadata": [
        { "name": "timestamp", "displayName": "Time", "shape": "date", "role": "timestamp" },
        { "name": "downloadBps", "displayName": "Download", "shape": "bitspersecondmetric", "role": "value" },
        { "name": "uploadBps", "displayName": "Upload", "shape": "bitspersecondmetric" }
    ],
    "timeframes": true
}
