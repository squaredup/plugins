{
    "name": "deviceLatency",
    "displayName": "Device latency",
    "description": "Round trip delay baseline, latest median and packet loss for each device on a collector",
    "tags": ["Network", "Performance"],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/agent/{{object.rawId}}/device/rtd",
        "paging": { "mode": "none" },
        "postRequestScript": "deviceLatency.js",
        "getArgs": [],
        "headers": []
    },
    "matches": { "sourceType": { "type": "oneOf", "values": ["Collector"] } },
    "metadata": [
        {
            "name": "deviceName",
            "displayName": "Device",
            "sourceId": "deviceSourceId",
            "sourceType": "Device",
            "objectPropertyPath": "name",
            "role": "label"
        },
        { "name": "latestMedian", "displayName": "Latest median", "shape": ["milliseconds", { "decimalPlaces": 1 }], "role": "value" },
        { "name": "avgMedian", "displayName": "Baseline median", "shape": ["milliseconds", { "decimalPlaces": 1 }] },
        { "name": "avgMin", "displayName": "Baseline minimum", "shape": ["milliseconds", { "decimalPlaces": 1 }] },
        { "name": "avgMax", "displayName": "Baseline maximum", "shape": ["milliseconds", { "decimalPlaces": 1 }] },
        { "name": "packetLoss", "displayName": "Packet loss", "shape": ["percent", { "decimalPlaces": 1 }] },
        { "name": "timestamp", "displayName": "Last sample", "shape": "date" },
        { "name": "deviceSourceId", "displayName": "Device source ID", "shape": "string", "visible": false }
    ],
    "timeframes": false
}
