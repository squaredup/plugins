{
    "name": "deviceEvents",
    "displayName": "Device state history",
    "description": "Device up, down, created and IP address change events",
    "tags": ["Events", "Device"],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/agent/{{object.agentId}}/device/{{object.deviceId}}/history/network/event",
        "paging": { "mode": "none" },
        "getArgs": [
            { "key": "from", "value": "{{timeframe.start}}" },
            { "key": "to", "value": "{{timeframe.end}}" }
        ],
        "headers": []
    },
    "matches": { "sourceType": { "type": "oneOf", "values": ["Device"] } },
    "metadata": [
        { "name": "timestamp", "displayName": "Time", "shape": "date", "role": "timestamp" },
        { "name": "type", "displayName": "Event", "shape": "string", "role": "label" },
        { "name": "details", "displayName": "Details", "shape": "json" }
    ],
    "timeframes": true
}
