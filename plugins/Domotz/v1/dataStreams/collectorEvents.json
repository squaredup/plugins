{
    "name": "collectorEvents",
    "displayName": "Collector connectivity events",
    "description": "Collector connection lost and recovered events",
    "tags": ["Events", "Network"],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/agent/{{object.rawId}}/history/network/event",
        "paging": { "mode": "none" },
        "getArgs": [
            { "key": "from", "value": "{{timeframe.start}}" },
            { "key": "to", "value": "{{timeframe.end}}" }
        ],
        "headers": []
    },
    "matches": { "sourceType": { "type": "oneOf", "values": ["Collector"] } },
    "metadata": [
        { "name": "timestamp", "displayName": "Time", "shape": "date", "role": "timestamp" },
        { "name": "type", "displayName": "Event", "shape": "string", "role": "label" }
    ],
    "timeframes": true
}
