{
    "name": "domotz",
    "displayName": "Domotz",
    "version": "1.0.0",
    "author": {
        "name": "@JackTSquppy",
        "type": "community"
    },
    "description": "Monitor client network health, device outages, internet speed and alerts across your Domotz collectors.",
    "category": "Network",
    "type": "hybrid",
    "schemaVersion": "2.1",
    "importNotSupported": false,
    "restrictedToPlatforms": [],
    "keywords": [
        "domotz",
        "network monitoring",
        "msp",
        "collector",
        "device",
        "alerts",
        "uptime",
        "internet speed"
    ],
    "objectTypes": ["Organization", "Collector", "Device"],
    "links": [
        {
            "category": "documentation",
            "url": "https://github.com/squaredup/plugins/blob/main/plugins/Domotz/v1/docs/README.md",
            "label": "Help adding this plugin"
        },
        {
            "category": "source",
            "url": "https://github.com/squaredup/plugins/tree/main/plugins/Domotz/v1",
            "label": "Repository"
        }
    ],
    "base": {
        "plugin": "WebAPI",
        "majorVersion": "1",
        "config": {
            "baseUrl": "{{region}}",
            "authMode": "none",
            "queryArgs": [],
            "headers": [
                { "key": "X-Api-Key", "value": "{{apiKey}}" },
                { "key": "Accept", "value": "application/json" }
            ]
        }
    }
}
