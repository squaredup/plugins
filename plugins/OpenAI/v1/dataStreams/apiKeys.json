{
    "name": "apiKeys",
    "displayName": "API Keys",
    "description": "API keys in the selected projects, with owner and when each key was last used",
    "tags": [
        "Projects",
        "API Keys"
    ],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "v1/organization/projects/{{object.rawId}}/api_keys",
        "getArgs": [],
        "paging": {
            "mode": "token",
            "pageSize": {
                "realm": "queryArg",
                "path": "limit",
                "value": "100"
            },
            "in": {
                "realm": "payload",
                "path": "last_id"
            },
            "out": {
                "realm": "queryArg",
                "path": "after"
            }
        },
        "pathToData": "data",
        "postRequestScript": "apiKeys.js"
    },
    "matches": {
        "sourceType": {
            "type": "oneOf",
            "values": [
                "Project"
            ]
        }
    },
    "metadata": [
        {
            "name": "id",
            "displayName": "Key ID",
            "shape": "string"
        },
        {
            "name": "name",
            "displayName": "API Key",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "redacted_value",
            "displayName": "Key hint",
            "shape": "string"
        },
        {
            "name": "projectId",
            "displayName": "Project ID",
            "shape": "string",
            "visible": false
        },
        {
            "name": "project",
            "displayName": "Project",
            "sourceId": "projectId",
            "sourceType": "Project",
            "objectPropertyPath": "name"
        },
        {
            "name": "created_at",
            "displayName": "Created",
            "shape": "date"
        },
        {
            "name": "last_used_at",
            "displayName": "Last used",
            "shape": "date"
        },
        {
            "name": "ownerType",
            "displayName": "Owner type",
            "shape": "string"
        },
        {
            "name": "ownerName",
            "displayName": "Owner",
            "shape": "string"
        },
        {
            "name": "ownerEmail",
            "displayName": "Owner email",
            "shape": "string"
        }
    ],
    "timeframes": false
}
