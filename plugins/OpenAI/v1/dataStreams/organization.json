{
    "name": "organization",
    "displayName": "Organization",
    "description": "Lightweight check that the Admin API key can read the organization (returns the first project)",
    "tags": [
        "Organization"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "v1/organization/projects",
        "getArgs": [
            {
                "key": "limit",
                "value": "1"
            }
        ],
        "paging": {
            "mode": "none"
        },
        "pathToData": "data"
    },
    "matches": "none",
    "visibility": {
        "type": "hidden"
    },
    "metadata": [
        {
            "name": "id",
            "displayName": "Project ID",
            "shape": "string"
        },
        {
            "name": "name",
            "displayName": "Project",
            "shape": "string",
            "role": "label"
        },
        {
            "pattern": ".*"
        }
    ],
    "timeframes": false
}
