{
    "name": "projects",
    "displayName": "Projects",
    "description": "All projects in the organization, including archived ones",
    "tags": [
        "Organization",
        "Projects"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "v1/organization/projects",
        "getArgs": [
            {
                "key": "include_archived",
                "value": "true"
            }
        ],
        "paging": {
            "mode": "token",
            "pageSize": {
                "realm": "queryArg",
                "path": "limit",
                "value": "100"
            },
            "in": {
                "realm": "payload",
                "path": "last_id"
            },
            "out": {
                "realm": "queryArg",
                "path": "after"
            }
        },
        "pathToData": "data",
        "postRequestScript": "projects.js"
    },
    "matches": "none",
    "metadata": [
        {
            "name": "id",
            "displayName": "Project ID",
            "shape": "string"
        },
        {
            "name": "name",
            "displayName": "Project",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "status",
            "displayName": "Status",
            "shape": "string"
        },
        {
            "name": "created_at",
            "displayName": "Created",
            "shape": "date"
        },
        {
            "name": "archived_at",
            "displayName": "Archived",
            "shape": "date"
        },
        {
            "name": "residency",
            "displayName": "Data residency",
            "shape": "string"
        }
    ],
    "timeframes": false
}
