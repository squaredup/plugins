                                                    "workspace": "{{workspaceId}}",
                                                    "variable": "{{variables.[Project]}}"
                                                }
                                            }
                                        },
                                        "variables": [
                                            "{{variables.[Project]}}"
                                        ]
                                    }
                                }
                            ]
                        },
                        "metadata": [
                            {
                                "name": "day",
                                "shape": [
                                    "date",
                                    {
                                        "format": "dd MMM"
                                    }
                                ]
                            },
                            {
                                "name": "spend",
                                "shape": [
                                    "currency",
                                    {
                                        "code": "USD",
                                        "decimalPlaces": 2,
                                        "thousandsSeparator": true
                                    }
                                ]
                            },
                            {
                                "pattern": ".*"
                            }
                        ]
                    },
                    "variables": [
                        "{{variables.[Project]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "day",
                                    "type": "temporal",
                                    "title": "Day"
                                },
                                "y": {
                                    "field": "spend",
                                    "type": "quantitative",
                                    "title": "Spend"
                                },
                                "series": {
                                    "field": "model",
                                    "type": "nominal",
                                    "title": "Model"
                                }
                            },
                            "style": {
                                "cartesianStack": "on",
                                "legendPosition": "bottom"
                            }
                        }
                    }
                }
