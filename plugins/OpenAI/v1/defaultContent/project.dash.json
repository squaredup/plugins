                    "dataStream": {
                        "id": "datastream-sql",
                        "dataSourceConfig": {
                            "version": "2.0",
                            "sql": "WITH s AS (SELECT \"project_id\", SUM(\"amount\") AS spend FROM \"cost\" GROUP BY 1)\nSELECT SUM(COALESCE(s.spend, 0)) * 100.0 / NULLIF(SUM(lim.\"limit\"), 0) AS \"budgetUsed\"\nFROM \"spendLimits\" lim LEFT JOIN s ON s.\"project_id\" = lim.\"projectId\"",
