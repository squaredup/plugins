                "config": {
                    "_type": "tile/data-stream",
                    "title": "Spend Per Day By Model",
                    "description": "Six biggest model families; the rest are grouped as Other.",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "datastream-sql",
                        "dataSourceConfig": {
                            "version": "2.0",
                            "sql": "WITH f AS (SELECT STRFTIME(DATE_TRUNC('day', \"date\"), '%Y-%m-%dT%H:%M:%SZ') AS b, COALESCE(NULLIF(\"modelFamily\", ''), \"category\") AS fam, \"amount\" AS v FROM \"cost\"),\nr AS (SELECT fam, ROW_NUMBER() OVER (ORDER BY SUM(v) DESC) AS rn FROM f GROUP BY fam)\nSELECT f.b AS \"day\", CASE WHEN r.rn <= 6 THEN f.fam ELSE 'Other' END AS \"model\", SUM(f.v) AS \"spend\"\nFROM f JOIN r USING (fam)\nGROUP BY 1, 2\nORDER BY 1",
                            "tables": [
                                {
                                    "tableName": "cost",
                                    "config": {
                                        "activePluginConfigIds": [
                                            "{{configId}}"
                                        ],
                                        "dataStream": {
                                            "id": "{{dataStreams.[cost]}}",
                                            "name": "cost",
                                            "pluginConfigId": "{{configId}}",
                                            "dataSourceConfig": {
                                                "project": {
