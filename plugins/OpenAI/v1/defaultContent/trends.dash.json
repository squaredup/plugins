                                    "config": {
                                        "activePluginConfigIds": [
                                            "{{configId}}"
                                        ],
                                        "dataStream": {
                                            "id": "{{dataStreams.[usage]}}",
                                            "name": "usage",
                                            "pluginConfigId": "{{configId}}"
                                        }
                                    }
                                }
                            ]
