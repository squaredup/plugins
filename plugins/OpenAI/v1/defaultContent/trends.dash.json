                "config": {
                    "_type": "tile/data-stream",
                    "title": "Cost Per 1K Tokens",
                    "description": "Chat & text spend divided by completion tokens, per week.",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "datastream-sql",
                        "dataSourceConfig": {
                            "version": "2.0",
                            "sql": "WITH c AS (SELECT STRFTIME(DATE_TRUNC('week', \"date\"), '%Y-%m-%dT%H:%M:%SZ') AS w, SUM(\"amount\") AS spend FROM \"cost\" WHERE \"category\" = 'Chat & text' GROUP BY 1),\nu AS (SELECT STRFTIME(DATE_TRUNC('week', \"date\"), '%Y-%m-%dT%H:%M:%SZ') AS w, SUM(\"input_tokens\") + SUM(\"output_tokens\") AS tokens FROM \"usage\" GROUP BY 1)\nSELECT c.w AS \"week\", c.spend * 1000.0 / NULLIF(u.tokens, 0) AS \"costPer1K\"\nFROM c JOIN u USING (w)\nORDER BY 1",
                            "tables": [
                                {
                                    "tableName": "cost",
                                    "config": {
                                        "activePluginConfigIds": [
                                            "{{configId}}"
                                        ],
                                        "dataStream": {
                                            "id": "{{dataStreams.[cost]}}",
                                            "name": "cost",
                                            "pluginConfigId": "{{configId}}"
                                        }
                                    }
