                                        "title": "This month"
                                    },
                                    {
                                        "field": "lastMonth",
                                        "type": "quantitative",
                                        "title": "Last month"
                                    },
                                    {
                                        "field": "change",
                                        "type": "quantitative",
                                        "title": "Change (like for like)"
                                    }
                                ]
                            },
                            "style": {
                                "scalarColumns": 1
                            }
                        }
                    }
                }
