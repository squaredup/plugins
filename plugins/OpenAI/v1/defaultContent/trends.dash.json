                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Month Over Month Spend",
                    "description": "Change compares this month so far with the same days of last month.",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "datastream-sql",
                        "dataSourceConfig": {
                            "version": "2.0",
                            "sql": "WITH t AS (SELECT SUM(\"amount\") AS v FROM \"thisMonth\"),\nl AS (SELECT SUM(\"amount\") AS v FROM \"lastMonth\"),\nltd AS (SELECT SUM(\"amount\") AS v FROM \"lastMonth\" WHERE EXTRACT(day FROM \"date\") <= EXTRACT(day FROM CURRENT_DATE))\nSELECT t.v AS \"thisMonth\", l.v AS \"lastMonth\", (t.v - ltd.v) * 100.0 / NULLIF(ltd.v, 0) AS \"change\"\nFROM t, l, ltd",
                            "tables": [
                                {
                                    "tableName": "thisMonth",
                                    "config": {
                                        "activePluginConfigIds": [
                                            "{{configId}}"
                                        ],
                                        "timeframe": "thisMonth",
                                        "dataStream": {
                                            "id": "{{dataStreams.[cost]}}",
                                            "name": "cost",
                                            "pluginConfigId": "{{configId}}"
                                        }
                                    }
                                },
                                {
                                    "tableName": "lastMonth",
                                    "config": {
                                        "activePluginConfigIds": [
                                            "{{configId}}"
                                        ],
                                        "timeframe": "lastMonth",
                                        "dataStream": {
                                            "id": "{{dataStreams.[cost]}}",
                                            "name": "cost",
                                            "pluginConfigId": "{{configId}}"
                                        }
                                    }
                                }
                            ]
                        },
                        "metadata": [
                            {
                                "name": "thisMonth",
                                "shape": [
                                    "currency",
                                    {
                                        "code": "USD",
                                        "decimalPlaces": 2,
                                        "thousandsSeparator": true
                                    }
                                ]
                            },
                            {
                                "name": "lastMonth",
                                "shape": [
                                    "currency",
                                    {
                                        "code": "USD",
                                        "decimalPlaces": 2,
                                        "thousandsSeparator": true
                                    }
                                ]
                            },
                            {
                                "name": "change",
                                "shape": [
                                    "percent",
                                    {
                                        "decimalPlaces": 1
                                    }
                                ]
                            },
                            {
                                "pattern": ".*"
                            }
                        ]
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    {
                                        "field": "thisMonth",
