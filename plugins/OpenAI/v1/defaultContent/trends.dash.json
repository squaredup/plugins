                "config": {
                    "_type": "tile/data-stream",
                    "title": "Spend Per Week By Model",
                    "description": "Six biggest model families; the rest are grouped as Other.",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "datastream-sql",
                        "dataSourceConfig": {
                            "version": "2.0",
                            "sql": "WITH f AS (SELECT STRFTIME(DATE_TRUNC('week', \"date\"), '%Y-%m-%dT%H:%M:%SZ') AS b, COALESCE(NULLIF(\"modelFamily\", ''), \"category\") AS fam, \"amount\" AS v FROM \"cost\"),\nr AS (SELECT fam, ROW_NUMBER() OVER (ORDER BY SUM(v) DESC) AS rn FROM f GROUP BY fam)\nSELECT f.b AS \"week\", CASE WHEN r.rn <= 6 THEN f.fam ELSE 'Other' END AS \"model\", SUM(f.v) AS \"spend\"\nFROM f JOIN r USING (fam)\nGROUP BY 1, 2\nORDER BY 1",
                            "tables": [
                                {
                                    "tableName": "cost",
                                    "config": {
                                        "activePluginConfigIds": [
                                            "{{configId}}"
                                        ],
                                        "dataStream": {
                                            "id": "{{dataStreams.[cost]}}",
                                            "name": "cost",
                                            "pluginConfigId": "{{configId}}"
                                        }
                                    }
                                }
                            ]
                        },
                        "metadata": [
                            {
                                "name": "week",
                                "shape": [
                                    "date",
                                    {
                                        "format": "dd MMM"
                                    }
                                ]
                            },
                            {
                                "name": "spend",
                                "shape": [
                                    "currency",
                                    {
                                        "code": "USD",
                                        "decimalPlaces": 2,
                                        "thousandsSeparator": true
                                    }
                                ]
                            },
                            {
                                "pattern": ".*"
                            }
                        ]
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "week",
                                    "type": "temporal",
                                    "title": "Week"
                                },
                                "y": {
                                    "field": "spend",
                                    "type": "quantitative",
                                    "title": "Spend"
                                },
                                "series": {
                                    "field": "model",
                                    "type": "nominal",
                                    "title": "Model"
                                }
                            },
                            "style": {
                                "cartesianStack": "on",
                                "legendPosition": "bottom"
                            }
                        }
                    }
                }
            },
            {
                "i": "58856ba1-e01d-4e78-abe9-486825be6841",
                "x": 8,
