                "config": {
                    "_type": "tile/data-stream",
                    "title": "Cache Hit Rate",
                    "description": "Share of input tokens served from the prompt cache.",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "datastream-sql",
                        "dataSourceConfig": {
                            "version": "2.0",
                            "sql": "SELECT SUM(\"input_cached_tokens\") * 100.0 / NULLIF(SUM(\"input_tokens\"), 0) AS \"cacheHitRate\" FROM \"usage\"",
                            "tables": [
                                {
                                    "tableName": "usage",
                                    "config": {
                                        "activePluginConfigIds": [
                                            "{{configId}}"
                                        ],
