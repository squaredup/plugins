                "config": {
                    "_type": "tile/data-stream",
                    "title": "Tokens Per Day By Model",
                    "description": "",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "datastream-sql",
                        "dataSourceConfig": {
                            "version": "2.0",
                            "sql": "WITH f AS (SELECT STRFTIME(DATE_TRUNC('day', \"date\"), '%Y-%m-%dT%H:%M:%SZ') AS b, REGEXP_REPLACE(\"model\", '-\\d{4}-\\d{2}-\\d{2}$', '') AS fam, \"input_tokens\" + \"output_tokens\" AS v FROM \"usage\"),\nr AS (SELECT fam, ROW_NUMBER() OVER (ORDER BY SUM(v) DESC) AS rn FROM f GROUP BY fam)\nSELECT f.b AS \"day\", CASE WHEN r.rn <= 6 THEN f.fam ELSE 'Other' END AS \"model\", SUM(f.v) AS \"tokens\"\nFROM f JOIN r USING (fam)\nGROUP BY 1, 2\nORDER BY 1",
                            "tables": [
                                {
                                    "tableName": "usage",
                                    "config": {
                                        "activePluginConfigIds": [
                                            "{{configId}}"
                                        ],
                                        "dataStream": {
                                            "id": "{{dataStreams.[usage]}}",
                                            "name": "usage",
                                            "pluginConfigId": "{{configId}}",
                                            "dataSourceConfig": {
                                                "apiKey": {
                                                    "scope": "{{scopes.[API Keys]}}",
                                                    "workspace": "{{workspaceId}}",
                                                    "variable": "{{variables.[API Key]}}"
                                                }
                                            }
                                        },
                                        "variables": [
                                            "{{variables.[API Key]}}"
                                        ]
                                    }
                                }
                            ]
                        },
                        "metadata": [
                            {
                                "name": "day",
                                "shape": [
                                    "date",
                                    {
                                        "format": "dd MMM"
                                    }
                                ]
                            },
                            {
                                "name": "tokens",
                                "shape": [
                                    "number",
                                    {
                                        "decimalPlaces": 0,
                                        "thousandsSeparator": true
                                    }
                                ]
                            },
                            {
                                "pattern": ".*"
                            }
                        ]
                    },
                    "variables": [
                        "{{variables.[API Key]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "day",
                                    "type": "temporal",
                                    "title": "Day"
                                },
                                "y": {
                                    "field": "tokens",
                                    "type": "quantitative",
                                    "title": "Tokens"
                                },
                                "series": {
                                    "field": "model",
                                    "type": "nominal",
                                    "title": "Model"
                                }
                            },
                            "style": {
                                "cartesianStack": "on",
                                "legendPosition": "bottom"
                            }
                        }
                    }
                }
