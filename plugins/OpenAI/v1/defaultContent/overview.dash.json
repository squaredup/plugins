                            "sql": "SELECT STRFTIME(DATE_TRUNC('day', \"date\"), '%Y-%m-%dT%H:%M:%SZ') AS \"day\", 'Input' AS \"direction\", SUM(\"input_tokens\") AS \"tokens\" FROM \"usage\" GROUP BY 1\nUNION ALL\nSELECT STRFTIME(DATE_TRUNC('day', \"date\"), '%Y-%m-%dT%H:%M:%SZ') AS \"day\", 'Output' AS \"direction\", SUM(\"output_tokens\") AS \"tokens\" FROM \"usage\" GROUP BY 1\nORDER BY 1",
