                    "activePluginConfigIds": ["{{configId}}"],
                    "timeframe": "none",
                    "variables": ["{{variables.[Device]}}"],
                    "dataStream": {
                        "id": "{{dataStreams.deviceAssets}}",
                        "name": "deviceAssets",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [["category", "asc"]]
                        }
                    },
                    "scope": {
                        "scope": "{{scopes.[Devices]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Device]}}"
