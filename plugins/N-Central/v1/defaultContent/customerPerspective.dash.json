                    "title": "Active Issues by Service Type",
                    "description": "",
                    "activePluginConfigIds": ["{{configId}}"],
                    "timeframe": "none",
                    "variables": ["{{variables.[Customer]}}"],
                    "dataStream": {
                        "id": "{{dataStreams.activeIssues}}",
                        "name": "activeIssues",
                        "pluginConfigId": "{{configId}}",
                        "group": {
                            "by": [["serviceType", "uniqueValues"]],
                            "aggregate": [{ "type": "count" }]
                        }
                    },
                    "scope": {
                        "scope": "{{scopes.[Customers]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Customer]}}"
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "pie",
                            "encoding": {
                                "label": {
                                    "field": "serviceType_uniqueValues",
                                    "type": "nominal",
                                    "title": "Service Type"
                                },
                                "value": {
                                    "field": "count",
                                    "type": "quantitative",
                                    "aggregate": "sum",
                                    "title": "Count"
                                }
                            },
                            "style": {
                                "pieInnerRadius": 60,
                                "pieDonutCenterValue": "total",
                                "labelFontSize": 16,
                                "pieSort": "desc",
                                "pieLegendStyle": "table"
                            }
                        }
                    }
                }
            },
