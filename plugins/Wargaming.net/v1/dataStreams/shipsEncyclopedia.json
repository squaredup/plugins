{
    "name": "shipsEncyclopedia",
    "displayName": "Encyclopedia Ships",
    "description": "Every ship in the World of Warships encyclopedia with tier, nation and type",
    "tags": ["Encyclopedia", "Ship"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "api.worldofwarships.{{dataSource.realm}}/wows/encyclopedia/ships/",
        "getArgs": [
            { "key": "fields", "value": "ship_id,name,tier,nation,type,is_premium" },
            { "key": "limit", "value": "100" }
        ],
        "paging": {
            "mode": "token",
            "in": { "realm": "payload", "path": "meta.page" },
            "out": { "realm": "queryArg", "path": "page_no" }
        },
        "postRequestScript": "shipsEncyclopedia.js",
        "errorHandling": { "type": "path", "realm": "payload", "path": "error.message" }
    },
    "matches": "none",
    "visibility": { "type": "hidden" },
    "metadata": [
        { "name": "ship_id", "displayName": "Ship ID", "shape": "string", "visible": false },
        { "name": "name", "displayName": "Name", "shape": "string", "role": "label" },
        { "name": "tier", "displayName": "Tier", "shape": "number" },
        { "name": "nation", "displayName": "Nation", "shape": "string" },
        { "name": "type", "displayName": "Type", "shape": "string" },
        { "name": "is_premium", "displayName": "Premium", "shape": "boolean" }
    ],
    "timeframes": false
}
