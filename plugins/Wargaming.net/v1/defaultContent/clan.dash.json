{
    "name": "Clan",
    "schemaVersion": "1.5",
    "variables": ["{{variables.[Clan]}}"],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "31c41a08-2453-4d66-8900-f9a243bad4e3",
                "x": 0,
                "y": 0,
                "w": 2,
                "h": 5,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Clan Details",
