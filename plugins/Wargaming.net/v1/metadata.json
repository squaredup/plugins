{
    "name": "wargaming",
    "displayName": "Wargaming.net",
    "version": "1.0.0",
    "author": {
        "name": "@AnEvilPenguin",
        "type": "community"
    },
    "description": "Monitor World of Tanks, World of Warships and World of Warplanes players, clans, and encyclopedias using the Wargaming.net Public API.",
    "category": "Fun",
    "type": "hybrid",
    "schemaVersion": "2.1",
    "importNotSupported": false,
    "restrictedToPlatforms": [],
    "keywords": [
        "wargaming.net",
        "wargaming",
        "world of tanks",
        "world of warships",
        "world of warplanes",
        "wot",
        "wows",
        "wowp",
        "gaming",
        "tanks",
        "clan"
    ],
    "objectTypes": ["Player", "Clan", "WoT Vehicle", "WoWs Ship", "WoWp Aircraft"],
    "links": [
        {
            "category": "documentation",
            "url": "https://github.com/squaredup/plugins/blob/main/plugins/Wargaming.net/v1/docs/README.md",
            "label": "Help adding this plugin"
        },
        {
            "category": "source",
            "url": "https://github.com/squaredup/plugins/tree/main/plugins/Wargaming.net/v1",
            "label": "Repository"
        }
    ],
    "base": {
        "plugin": "WebAPI",
        "majorVersion": "1",
        "config": {
            "baseUrl": "https://api.worldoftanks.{{realm}}/",
            "authMode": "none",
            "headers": [],
            "queryArgs": [
                {
                    "key": "application_id",
                    "value": "{{applicationId}}"
                }
            ]
        }
    }
}
