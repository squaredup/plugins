{
    "name": "environmentCapacity",
    "displayName": "Environment Credit Allocations",
    "description": "Capacity allocated to each environment, by currency",
    "tags": [
        "Capacity",
        "Environment"
    ],
    "baseDataSourceName": "httpRequestScoped",
    "config": {
        "httpMethod": "get",
        "baseUrl": "https://api.powerplatform.com",
        "endpointPath": "licensing/tenantCapacity/currencyReports",
        "getArgs": [
            {
                "key": "api-version",
                "value": "2024-10-01"
            }
        ],
        "postRequestScript": "environmentCapacity.js"
    },
    "matches": {
        "sourceType": {
            "type": "oneOf",
            "values": [
                "Environment"
            ]
        }
    },
    "timeframes": false,
    "metadata": [
        {
            "name": "environmentName",
            "displayName": "Environment",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "environmentId",
            "displayName": "Environment ID",
            "shape": "string",
            "visible": false
        },
        {
            "name": "currency",
            "displayName": "Currency",
            "shape": "string"
        },
        {
            "name": "allocated",
            "displayName": "Allocated",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0
                }
            ]
        },
        {
            "name": "currencyType",
            "displayName": "Currency type",
            "shape": "string",
            "visible": false
        }
    ]
}
