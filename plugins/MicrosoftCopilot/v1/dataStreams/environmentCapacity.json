{
    "name": "environmentCapacity",
    "displayName": "Environment Credit Allocations",
    "description": "Capacity allocated to the environment, by currency",
    "tags": [
        "Capacity",
        "Environment"
    ],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "powerplatform/licensing/environments/{{object.rawId}}/allocations",
        "getArgs": [
            {
                "key": "api-version",
                "value": "2024-10-01"
            }
        ],
        "postRequestScript": "environmentCapacity.js",
        "errorHandling": {
            "type": "script",
            "script": "errorHandling/environmentCapacity.js"
        }
    },
    "matches": {
        "sourceType": {
            "type": "oneOf",
            "values": [
                "Environment"
            ]
        }
    },
    "timeframes": false,
    "metadata": [
        {
            "name": "environmentName",
            "displayName": "Environment",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "environmentId",
            "displayName": "Environment ID",
            "shape": "string",
            "visible": false
        },
        {
            "name": "currency",
            "displayName": "Currency",
            "shape": "string"
        },
        {
            "name": "allocated",
            "displayName": "Allocated",
            "shape": "number"
        },
        {
            "name": "currencyType",
            "displayName": "Currency type",
            "shape": "string",
            "visible": false
        }
    ]
}
