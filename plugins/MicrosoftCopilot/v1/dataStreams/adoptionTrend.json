{
    "name": "adoptionTrend",
    "displayName": "Copilot Adoption Trend",
    "description": "Daily enabled and active Copilot users by app",
    "tags": [
        "Adoption",
        "Usage"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "graph/beta/copilot/reports/getMicrosoft365CopilotUserCountTrend(period='{{period || 'D28'}}')",
        "postRequestScript": "adoptionTrend.js"
    },
    "matches": "none",
    "timeframes": false,
    "ui": [
        {
            "type": "radio",
            "name": "period",
            "label": "Period",
            "defaultValue": "D28",
            "options": [
                {
                    "value": "D7",
                    "label": "7 days"
                },
                {
                    "value": "D28",
                    "label": "28 days"
                },
                {
                    "value": "D90",
                    "label": "90 days"
                },
                {
                    "value": "D180",
                    "label": "180 days"
                }
            ]
        }
    ],
    "metadata": [
        {
            "name": "reportDate",
            "displayName": "Date",
            "shape": "date",
            "role": "timestamp"
        },
        {
            "name": "app",
            "displayName": "App",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "enabledUsers",
            "displayName": "Enabled users",
            "shape": "number"
        },
        {
            "name": "activeUsers",
            "displayName": "Active users",
            "shape": "number"
        },
        {
            "name": "promptsSubmitted",
            "displayName": "Prompts submitted",
            "shape": "number"
        }
    ]
}
