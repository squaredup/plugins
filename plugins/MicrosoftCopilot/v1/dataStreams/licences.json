{
    "name": "licences",
    "displayName": "Copilot Licences",
    "description": "Copilot licences purchased and assigned in the tenant",
    "tags": [
        "Licence"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "v1.0/subscribedSkus",
        "postRequestScript": "licences.js"
    },
    "matches": "none",
    "timeframes": false,
    "metadata": [
        {
            "name": "skuPartNumber",
            "displayName": "SKU",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "skuId",
            "displayName": "SKU ID",
            "shape": "guid",
            "visible": false
        },
        {
            "name": "purchased",
            "displayName": "Purchased",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0
                }
            ]
        },
        {
            "name": "assigned",
            "displayName": "Assigned",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0
                }
            ]
        },
        {
            "name": "available",
            "displayName": "Available",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0
                }
            ]
        },
        {
            "name": "utilisation",
            "displayName": "Utilisation",
            "shape": [
                "percent",
                {
                    "decimalPlaces": 1
                }
            ]
        },
        {
            "name": "suspended",
            "displayName": "Suspended",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0
                }
            ]
        },
        {
            "name": "warning",
            "displayName": "Warning",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0
                }
            ]
        },
        {
            "name": "capabilityStatus",
            "displayName": "Capability status",
            "shape": "string"
        },
        {
            "name": "copilotPlans",
            "displayName": "Copilot service plans",
            "shape": [
                "array",
                {
                    "itemShape": "string"
                }
            ]
        }
    ]
}
