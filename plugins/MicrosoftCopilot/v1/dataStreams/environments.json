{
    "name": "environments",
    "displayName": "Environments",
    "description": "Power Platform environments, where Copilot Studio agents are built",
    "tags": ["Environment"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "bap/providers/Microsoft.BusinessAppPlatform/scopes/admin/environments",
        "pathToData": "value",
        "expandInnerObjects": true,
        "getArgs": [{ "key": "api-version", "value": "2021-04-01" }],
        "paging": {
            "mode": "nextUrl",
            "in": { "realm": "payload", "path": "nextLink" }
        }
    },
    "matches": "none",
    "timeframes": false,
    "visibility": { "type": "hidden" },
    "metadata": [
        { "name": "name", "displayName": "Environment ID", "shape": "string", "visible": false },
        { "name": "properties.displayName", "displayName": "Name", "shape": "string", "role": "label" },
        { "name": "properties.environmentSku", "displayName": "Type", "shape": "string" },
        { "name": "location", "displayName": "Geography", "shape": "string" },
        { "name": "properties.azureRegion", "displayName": "Azure region", "shape": "string" },
        { "name": "properties.isDefault", "displayName": "Default", "shape": "boolean" },
        { "name": "properties.states.management.id", "displayName": "Status", "shape": "string" },
        { "name": "properties.linkedEnvironmentMetadata.instanceUrl", "displayName": "Dataverse URL", "shape": "url" },
        { "name": "properties.createdTime", "displayName": "Created", "shape": "date" }
    ]
}
