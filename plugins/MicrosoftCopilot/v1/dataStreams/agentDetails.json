{
    "name": "agentDetails",
    "displayName": "Agent Usage",
    "description": "Active users, sessions, run time and exceptions over the last 30 days, last use and sharing for an agent in the Microsoft Agent 365 registry (needs Microsoft Agent 365)",
    "tags": [
        "Agents",
        "Adoption"
    ],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "v1.0/copilot/admin/catalog/packages/{{object.rawId}}",
        "postRequestScript": "agentDetails.js"
    },
    "matches": {
        "sourceType": {
            "type": "oneOf",
            "values": [
                "Agent"
            ]
        }
    },
    "timeframes": false,
    "metadata": [
        {
            "name": "displayName",
            "displayName": "Agent",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "activeUsers",
            "displayName": "Active users (30 days)",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0
                }
            ]
        },
        {
            "name": "totalSessions",
            "displayName": "Sessions (30 days)",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0
                }
            ]
        },
        {
            "name": "totalRunTimeInHours",
            "displayName": "Run time, hours (30 days)",
            "shape": [
                "number",
                {
                    "decimalPlaces": 1
                }
            ]
        },
        {
            "name": "lastUsedDateTime",
            "displayName": "Last used",
            "shape": "date"
        },
        {
            "name": "daysSinceUsed",
            "displayName": "Days since used",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0
                }
            ]
        },
        {
            "name": "exceptions",
            "displayName": "Exceptions (30 days)",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0
                }
            ]
        },
        {
            "name": "sensitivity",
            "displayName": "Sensitivity",
            "shape": "string"
        },
        {
            "name": "categories",
            "displayName": "Categories",
            "shape": [
                "array",
                {
                    "itemShape": "string"
                }
            ]
        },
        {
            "name": "sharedWithCount",
            "displayName": "Shared with (users and groups)",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0
                }
            ]
        },
        {
            "name": "allowedCount",
            "displayName": "Allowed users and groups",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0
                }
            ]
        },
        {
            "name": "longDescription",
            "displayName": "Description",
            "shape": "string"
        },
        {
            "name": "id",
            "displayName": "Package ID",
            "shape": "string",
            "visible": false
        }
    ]
}
