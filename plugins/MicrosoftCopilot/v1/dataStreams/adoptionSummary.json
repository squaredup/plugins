{
    "name": "adoptionSummary",
    "displayName": "Copilot Adoption",
    "description": "Enabled and active Copilot users by app over the chosen period",
    "tags": ["Adoption", "Usage"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "graph/beta/copilot/reports/getMicrosoft365CopilotUserCountSummary(period='{{period || 'D28'}}')",
        "postRequestScript": "adoptionSummary.js"
    },
    "matches": "none",
    "timeframes": false,
    "ui": [
        {
            "type": "radio",
            "name": "period",
            "label": "Period",
            "defaultValue": "D28",
            "options": [
                { "value": "D7", "label": "7 days" },
                { "value": "D28", "label": "28 days" },
                { "value": "D90", "label": "90 days" },
                { "value": "D180", "label": "180 days" }
            ]
        }
    ],
    "metadata": [
        { "name": "app", "displayName": "App", "shape": "string", "role": "label" },
        { "name": "enabledUsers", "displayName": "Enabled users", "shape": "number" },
        { "name": "activeUsers", "displayName": "Active users", "shape": "number" },
        { "name": "activeRate", "displayName": "Active rate", "shape": ["percent", { "decimalPlaces": 1 }] },
        { "name": "totalPrompts", "displayName": "Total prompts", "shape": "number" },
        { "name": "averagePrompts", "displayName": "Average prompts per user", "shape": ["number", { "decimalPlaces": 1 }] },
        { "name": "periodDays", "displayName": "Period (days)", "shape": "number" },
        { "name": "reportRefreshDate", "displayName": "Report refresh date", "shape": "date" }
    ]
}
