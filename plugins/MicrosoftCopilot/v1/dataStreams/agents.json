{
    "name": "agents",
    "displayName": "Agents",
    "description": "Agents in the Microsoft Agent 365 registry, with type, platform, publisher, availability, blocking and owners (needs Microsoft Agent 365)",
    "tags": [
        "Agents",
        "Governance"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "v1.0/copilot/admin/catalog/packages",
        "postRequestScript": "agents.js",
        "paging": {
            "mode": "nextUrl",
            "pageSize": {
                "realm": "none"
            },
            "in": {
                "realm": "payload",
                "path": "@odata.nextLink"
            }
        }
    },
    "matches": "none",
    "timeframes": false,
    "ui": [
        {
            "type": "objects",
            "name": "agents",
            "label": "Agent (optional)",
            "matches": {
                "sourceType": {
                    "type": "oneOf",
                    "values": [
                        "Agent"
                    ]
                }
            }
        }
    ],
    "metadata": [
        {
            "name": "displayName",
            "displayName": "Agent",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "ownershipState",
            "displayName": "Ownership state",
            "shape": [
                "state",
                {
                    "map": {
                        "success": [
                            "success"
                        ],
                        "error": [
                            "error"
                        ]
                    }
                }
            ]
        },
        {
            "name": "ownershipStatus",
            "displayName": "Ownership",
            "shape": "string"
        },
        {
            "name": "agentType",
            "displayName": "Type",
            "shape": "string"
        },
        {
            "name": "platform",
            "displayName": "Platform",
            "shape": "string"
        },
        {
            "name": "publisher",
            "displayName": "Publisher",
            "shape": "string"
        },
        {
            "name": "availableTo",
            "displayName": "Available to",
            "shape": "string"
        },
        {
            "name": "deployedTo",
            "displayName": "Deployed to",
            "shape": "string"
        },
        {
            "name": "isBlocked",
            "displayName": "Blocked",
            "shape": "boolean"
        },
        {
            "name": "ownerIds",
            "displayName": "Owners",
            "shape": [
                "array",
                {
                    "itemShape": "string"
                }
            ],
            "sourceType": "User",
            "sourceLookup": {
                "property": "entraObjectId"
            }
        },
        {
            "name": "ownerCount",
            "displayName": "Owner count",
            "shape": "number"
        },
        {
            "name": "createdDateTime",
            "displayName": "Created",
            "shape": "date"
        },
        {
            "name": "lastModifiedDateTime",
            "displayName": "Last updated",
            "shape": "date"
        },
        {
            "name": "daysSinceModified",
            "displayName": "Days since updated",
            "shape": "number"
        },
        {
            "name": "elementTypes",
            "displayName": "Element types",
            "shape": [
                "array",
                {
                    "itemShape": "string"
                }
            ]
        },
        {
            "name": "supportedHosts",
            "displayName": "Supported hosts",
            "shape": [
                "array",
                {
                    "itemShape": "string"
                }
            ]
        },
        {
            "name": "shortDescription",
            "displayName": "Description",
            "shape": "string"
        },
        {
            "name": "version",
            "displayName": "Version",
            "shape": "string"
        },
        {
            "name": "appId",
            "displayName": "App ID",
            "shape": "string",
            "visible": false
        },
        {
            "name": "id",
            "displayName": "Package ID",
            "shape": "string",
            "visible": false
        }
    ]
}
