{
    "name": "aiAppPermissions",
    "displayName": "AI App Permissions",
    "description": "Permissions held by AI apps people sign in to with Microsoft Entra: delegated grants for all users or individual users, and application permissions, with the API each is granted on and whether it goes beyond sign-in",
    "tags": [
        "Security",
        "Governance"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "beta/reports/getAzureADApplicationSignInSummary(period='D30')",
        "postRequestScript": "aiAppPermissions.js"
    },
    "matches": "none",
    "timeframes": false,
    "metadata": [
        {
            "name": "appDisplayName",
            "displayName": "App",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "aiVendor",
            "displayName": "AI vendor",
            "shape": "string"
        },
        {
            "name": "publisher",
            "displayName": "Publisher",
            "shape": "string"
        },
        {
            "name": "verifiedPublisher",
            "displayName": "Verified publisher",
            "shape": "boolean"
        },
        {
            "name": "resource",
            "displayName": "Granted on",
            "shape": "string"
        },
        {
            "name": "permissionType",
            "displayName": "Permission type",
            "shape": "string"
        },
        {
            "name": "grantedTo",
            "displayName": "Granted to",
            "shape": "string"
        },
        {
            "name": "userDisplayName",
            "displayName": "User",
            "shape": "string"
        },
        {
            "name": "userPrincipalName",
            "displayName": "User principal name",
            "shape": "string"
        },
        {
            "name": "permissions",
            "displayName": "Permissions",
            "shape": [
                "array",
                {
                    "itemShape": "string"
                }
            ]
        },
        {
            "name": "beyondSignIn",
            "displayName": "Access beyond sign-in",
            "shape": "boolean"
        },
        {
            "name": "principalId",
            "displayName": "User ID",
            "shape": "string",
            "visible": false
        },
        {
            "name": "appId",
            "displayName": "Application (client) ID",
            "shape": "string",
            "visible": false
        }
    ]
}
