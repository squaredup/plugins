{
    "name": "Copilot User",
    "schemaVersion": "1.5",
    "timeframe": "none",
    "variables": [
        "{{variables.[Copilot User]}}"
    ],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "d103ff83-c267-44ea-8620-895caddcbe1d",
                "x": 0,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "title": "Copilot Activity",
                    "description": "Active in the last 7 days (green), idle for more than 7 days (amber), or idle for more than 28 days or never used (red)",
                    "timeframe": "none",
                    "variables": [
                        "{{variables.[Copilot User]}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[userActivity]}}",
                        "name": "userActivity",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "period": "D28",
                            "users": {
                                "variable": "{{variables.[Copilot User]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Copilot Users]}}"
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "statusGrid",
                            "encoding": {
                                "label": {
                                    "field": "displayName",
                                    "type": "nominal",
                                    "title": "Name"
                                },
                                "status": {
                                    "field": "activityState",
                                    "type": "nominal",
                                    "title": "Activity"
                                },
                                "value": {
                                    "field": "lastUsed",
                                    "type": "nominal",
                                    "title": "Last used"
                                }
                            },
                            "style": {
                                "statusGridColumnsPerRow": 1,
                                "statusGridLabelWrap": true,
                                "labelFontSize": 16,
                                "secondaryFontSize": 12
                            }
                        }
                    }
                }
            },
            {
                "i": "425c8683-6f66-553d-b3a3-e22076044687",
                "x": 1,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "title": "Active Days",
                    "description": "Days in the last 28 on which this user used Copilot in any app",
                    "timeframe": "none",
                    "variables": [
                        "{{variables.[Copilot User]}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[userActivity]}}",
                        "name": "userActivity",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "period": "D28",
                            "users": {
                                "variable": "{{variables.[Copilot User]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Copilot Users]}}"
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "ringGrid",
                            "encoding": {
                                "value": {
                                    "field": "activeDays",
                                    "type": "quantitative"
                                }
                            },
                            "style": {
                                "ringGridMax": 28,
                                "ringGridTrackWidth": 10,
                                "ringGridThresholds": [
                                    {
                                        "to": 0.15,
                                        "color": "#f59e0b"
                                    },
                                    {
                                        "to": 1,
                                        "color": "#22c55e"
                                    }
                                ]
                            }
                        }
                    }
                }
            },
            {
                "i": "861a1e31-e58c-4754-94fc-535a489123ed",
                "x": 2,
                "y": 0,
                "w": 2,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "title": "Usage (28 Days)",
                    "description": "Prompts this user submitted to Copilot in the last 28 days, and days since they last used it",
                    "timeframe": "none",
                    "variables": [
                        "{{variables.[Copilot User]}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[userActivity]}}",
                        "name": "userActivity",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "period": "D28",
                            "users": {
                                "variable": "{{variables.[Copilot User]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Copilot Users]}}"
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    {
                                        "field": "promptsSubmitted",
                                        "type": "quantitative",
                                        "title": "Prompts submitted"
                                    },
                                    {
                                        "field": "daysSinceLastActivity",
                                        "type": "quantitative",
                                        "title": "Days since last use"
                                    }
                                ]
                            },
                            "style": {
                                "scalarColumns": 2
                            }
                        }
                    }
                }
            },
            {
                "i": "eb1b900e-5c32-4cf9-8dc1-e6e26224b822",
                "x": 0,
                "y": 2,
                "w": 2,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "title": "User Details",
                    "description": "The user's Entra ID profile",
                    "timeframe": "none",
                    "dataStream": {
                        "id": "datastream-properties",
                        "name": "properties",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Copilot Users]}}",
                        "variable": "{{variables.[Copilot User]}}",
                        "workspace": "{{workspaceId}}"
                    },
                    "variables": [
                        "{{variables.[Copilot User]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "userPrincipalName",
                                        "title": "User principal name",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "mail",
                                        "title": "Email",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "jobTitle",
                                        "title": "Job title",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "department",
                                        "title": "Department",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "officeLocation",
                                        "title": "Office",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "country",
                                        "title": "Country",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "accountEnabled",
                                        "title": "Account enabled",
                                        "renderer": {
                                            "type": "boolean",
                                            "trueLabel": "Yes",
                                            "falseLabel": "No",
                                            "trueColor": "#16a34a",
                                            "falseColor": "#dc2626"
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableCellPadding": 6,
                                "richTableTranspose": true
                            }
                        }
                    }
                }
            },
            {
                "i": "4640a3f2-063d-4353-b7bb-012ee5a2c3a7",
                "x": 2,
                "y": 2,
                "w": 2,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "title": "Last Used by App",
                    "description": "When this user last used Copilot in each Microsoft 365 app. Blank means never in the reporting window",
                    "timeframe": "none",
                    "variables": [
                        "{{variables.[Copilot User]}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[userActivity]}}",
                        "name": "userActivity",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "period": "D28",
                            "users": {
                                "variable": "{{variables.[Copilot User]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Copilot Users]}}"
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "copilotChatLastActivityDate",
                                        "title": "Copilot Chat",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    },
                                    {
                                        "field": "teamsLastActivityDate",
                                        "title": "Teams",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    },
                                    {
                                        "field": "outlookLastActivityDate",
                                        "title": "Outlook",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    },
                                    {
                                        "field": "wordLastActivityDate",
                                        "title": "Word",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    },
                                    {
                                        "field": "excelLastActivityDate",
                                        "title": "Excel",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    },
                                    {
                                        "field": "powerPointLastActivityDate",
                                        "title": "PowerPoint",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    },
                                    {
                                        "field": "oneNoteLastActivityDate",
                                        "title": "OneNote",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    },
                                    {
                                        "field": "loopLastActivityDate",
                                        "title": "Loop",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    },
                                    {
                                        "field": "reportRefreshDate",
                                        "title": "Report refreshed",
                                        "renderer": {
                                            "type": "date"
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableCellPadding": 6,
                                "richTableTranspose": true
                            }
                        }
                    }
                }
            }
        ]
    }
}
