            {
                "i": "beb384bc-63e5-4410-a64a-308285195c6f",
                "x": 0,
                "y": 11,
                "w": 4,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "activePluginConfigIds": [],
                    "title": "Possible Leavers",
                    "description": "Copilot seats whose user hasn't signed in to Microsoft Entra for 30 days or whose account is disabled, from live sign-in data. Needs AuditLog.Read.All and Microsoft Entra ID P1 or P2",
                    "timeframe": "none",
                    "dataStream": {
                        "id": "datastream-sql",
                        "dataSourceConfig": {
                            "version": "2.0",
                            "sql": "SELECT s.\"displayName\", s.\"userPrincipalName\", CASE WHEN s.\"accountEnabled\" = false THEN 'Account disabled' ELSE 'No recent sign-in' END AS \"reason\", s.\"lastSignInDateTime\", DATE_DIFF('day', CAST(s.\"lastSignInDateTime\" AS TIMESTAMP), CAST(NOW() AS TIMESTAMP)) AS \"daysSinceSignIn\", a.\"lastActivityDate\" FROM \"signins\" s LEFT JOIN \"activity\" a ON LOWER(a.\"userPrincipalName\") = LOWER(s.\"userPrincipalName\") WHERE s.\"accountEnabled\" = false OR s.\"lastSignInDateTime\" IS NULL OR CAST(s.\"lastSignInDateTime\" AS TIMESTAMP) < NOW() - INTERVAL 30 DAY ORDER BY \"daysSinceSignIn\" DESC NULLS FIRST",
                            "tables": [
                                {
                                    "tableName": "signins",
                                    "config": {
                                        "activePluginConfigIds": [
                                            "{{configId}}"
                                        ],
                                        "dataStream": {
                                            "id": "{{dataStreams.[userSignIns]}}",
                                            "name": "userSignIns"
                                        },
                                        "timeframe": "none"
                                    }
