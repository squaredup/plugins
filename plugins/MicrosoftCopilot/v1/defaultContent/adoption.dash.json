                "x": 2,
                "y": 5,
                "w": 2,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "activePluginConfigIds": [],
                    "title": "Seats to Review",
                    "description": "Licensed users who haven't used Copilot for more than 7 days, have never used it, or whose account is disabled, with their department. Candidates for training or for reclaiming the licence",
                    "timeframe": "none",
                    "dataStream": {
                        "id": "datastream-sql",
                        "dataSourceConfig": {
                            "version": "2.0",
                            "sql": "SELECT \"displayName\", \"department\", \"seatStatus\", \"lastActivityDate\", \"daysSinceLastActivity\" FROM \"activity\" WHERE \"seatStatus\" <> 'Active' AND (\"department\" IS NULL OR CAST(\"department\" AS VARCHAR) NOT LIKE 'Object not found%') ORDER BY \"daysSinceLastActivity\" DESC NULLS FIRST",
                            "tables": [
