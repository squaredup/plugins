            {
                "i": "0ae0d24a-25fa-4c3c-9fb6-67ea729bc256",
                "x": 0,
                "y": 8,
                "w": 2,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "activePluginConfigIds": [],
                    "title": "Adoption by Department",
                    "description": "Copilot seats per department, the share used in the last 28 days, and prompts per seat over 28 days. Department comes from Microsoft Entra ID through the imported Copilot Users",
                    "timeframe": "none",
                    "dataStream": {
                        "id": "datastream-sql",
                        "dataSourceConfig": {
                            "version": "2.0",
                            "sql": "SELECT COALESCE(NULLIF(TRIM(CASE WHEN CAST(\"department\" AS VARCHAR) LIKE 'Object not found%' THEN NULL ELSE \"department\" END), ''), '(No department)') AS \"department\", COUNT(*) AS \"seats\", CAST(ROUND(100.0 * SUM(CASE WHEN \"daysSinceLastActivity\" <= 28 THEN 1 ELSE 0 END) / COUNT(*), 0) AS DOUBLE) AS \"activePct\", CAST(ROUND(SUM(\"promptsSubmitted\") * 1.0 / COUNT(*), 1) AS DOUBLE) AS \"promptsPerSeat\" FROM \"activity\" WHERE CAST(\"department\" AS VARCHAR) NOT LIKE 'Object not found%' OR \"department\" IS NULL GROUP BY 1 ORDER BY 2 DESC",
                            "tables": [
                                {
                                    "tableName": "activity",
                                    "config": {
                                        "activePluginConfigIds": [
                                            "{{configId}}"
                                        ],
                                        "dataStream": {
                                            "id": "{{dataStreams.[userActivity]}}",
                                            "name": "userActivity",
                                            "dataSourceConfig": {
                                                "period": "D28"
                                            }
                                        },
                                        "timeframe": "none"
                                    }
                                }
                            ]
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "department",
                                        "title": "Department",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "seats",
                                        "title": "Seats",
                                        "renderer": {
                                            "type": "number"
                                        },
                                        "align": "right",
                                        "width": 100
                                    },
                                    {
                                        "field": "activePct",
                                        "title": "Active % (28d)",
                                        "renderer": {
                                            "type": "bar",
                                            "max": 100,
                                            "suffix": "%",
                                            "thresholds": [
                                                {
                                                    "to": 49,
                                                    "color": "#ef4444"
                                                },
                                                {
                                                    "to": 74,
                                                    "color": "#f59e0b"
                                                },
                                                {
                                                    "to": 100,
                                                    "color": "#22c55e"
                                                }
                                            ]
                                        }
                                    },
                                    {
                                        "field": "promptsPerSeat",
                                        "title": "Prompts / seat",
                                        "renderer": {
                                            "type": "number",
                                            "decimals": 1
                                        },
                                        "align": "right",
                                        "width": 140
                                    }
                                ]
                            },
                            "style": {
                                "richTableSort": {
                                    "field": "seats",
                                    "direction": "desc"
                                }
                            }
                        }
                    }
                }
            },
