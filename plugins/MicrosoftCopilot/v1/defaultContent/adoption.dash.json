                    "title": "Seats to Reclaim",
                    "description": "Licensed users idle for more than 28 days, who have never used Copilot, or whose account is disabled: candidates for reclaiming the licence",
                    "timeframe": "none",
                    "dataStream": {
                        "id": "datastream-sql",
                        "dataSourceConfig": {
                            "version": "2.0",
                            "sql": "SELECT COALESCE(SUM(CASE WHEN \"seatStatus\" IN ('Idle', 'Never used', 'Account disabled') THEN 1 ELSE 0 END), 0) AS \"reclaim\", COUNT(*) AS \"seats\" FROM \"activity\" WHERE (\"department\" IS NULL OR CAST(\"department\" AS VARCHAR) NOT LIKE 'Object not found%')",
