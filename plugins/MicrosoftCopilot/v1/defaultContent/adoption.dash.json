                "w": 2,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "activePluginConfigIds": [],
                    "title": "Seats by Status",
                    "description": "Copilot-licensed users by seat status: Active (used in the last 7 days), Low use (8–28 days), Idle (over 28 days), Never used, or Account disabled",
                    "timeframe": "none",
                    "dataStream": {
                        "id": "datastream-sql",
                        "dataSourceConfig": {
                            "version": "2.0",
                            "sql": "SELECT \"seatStatus\" AS \"status\", COUNT(*) AS \"users\" FROM \"activity\" WHERE (\"department\" IS NULL OR CAST(\"department\" AS VARCHAR) NOT LIKE 'Object not found%') GROUP BY 1",
                            "tables": [
                                {
                                    "tableName": "activity",
                                    "config": {
                                        "activePluginConfigIds": [
                                            "{{configId}}"
                                        ],
                                        "dataStream": {
