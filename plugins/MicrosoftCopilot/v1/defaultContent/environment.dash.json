{
    "name": "Environment",
    "schemaVersion": "1.5",
    "timeframe": "none",
    "variables": [
        "{{variables.[Copilot Environment]}}"
    ],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "fa354534-6766-4c88-9b70-29735ff5596f",
                "x": 0,
                "y": 0,
                "w": 2,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "title": "Environment Details",
                    "description": "The Power Platform environment: type, region, state and Dataverse URL",
                    "timeframe": "none",
                    "dataStream": {
                        "id": "datastream-properties",
                        "name": "properties",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Copilot Environments]}}",
                        "variable": "{{variables.[Copilot Environment]}}",
                        "workspace": "{{workspaceId}}"
                    },
                    "variables": [
                        "{{variables.[Copilot Environment]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "environmentType",
                                        "title": "Type",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "Production": "#6366f1",
                                                "Sandbox": "#14b8a6",
                                                "Developer": "#8b5cf6",
                                                "Trial": "#d97706",
                                                "Default": "#2563eb"
                                            },
                                            "defaultColor": "#64748b"
                                        }
                                    },
                                    {
                                        "field": "isDefault",
                                        "title": "Default environment",
                                        "renderer": {
                                            "type": "boolean",
                                            "trueLabel": "Yes",
                                            "falseLabel": "No",
                                            "trueColor": "#2563eb",
                                            "falseColor": "#64748b"
                                        }
                                    },
                                    {
                                        "field": "status",
                                        "title": "State",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "Ready": "#16a34a",
                                                "NotSpecified": "#64748b"
                                            },
                                            "defaultColor": "#d97706"
                                        }
                                    },
                                    {
                                        "field": "geography",
                                        "title": "Geography",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "azureRegion",
                                        "title": "Azure region",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "createdTime",
                                        "title": "Created",
                                        "renderer": {
                                            "type": "date"
                                        }
                                    },
                                    {
                                        "field": "dataverseUrl",
                                        "title": "Dataverse",
                                        "renderer": {
                                            "type": "link"
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableCellPadding": 6,
                                "richTableTranspose": true
                            }
                        }
                    }
                }
            },
            {
                "i": "2cef0e01-2415-4927-9967-a27b5863241f",
                "x": 2,
                "y": 0,
                "w": 2,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "title": "Credit Allocations",
                    "description": "Capacity allocated to this environment from the tenant, by currency. Developer and some legacy environments cannot hold Copilot Credit allocations",
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[environmentCapacity]}}",
                        "name": "environmentCapacity",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Copilot Environments]}}",
                        "variable": "{{variables.[Copilot Environment]}}",
                        "workspace": "{{workspaceId}}"
                    },
                    "variables": [
                        "{{variables.[Copilot Environment]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    {
                                        "field": "allocated",
                                        "type": "quantitative",
                                        "title": "Allocated"
                                    }
                                ],
                                "label": {
                                    "field": "currency",
                                    "type": "nominal",
                                    "title": "Currency"
                                }
                            },
                            "style": {}
                        }
                    }
                }
            }
        ]
    }
}
