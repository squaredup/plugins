{
    "name": "Agent",
    "schemaVersion": "1.5",
    "timeframe": "none",
    "variables": [
        "{{variables.[Copilot Agent]}}"
    ],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "aa5035f5-fb6d-4a48-8674-1639c6d8c478",
                "x": 0,
                "y": 0,
                "w": 2,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "title": "Agent Details",
                    "description": "The agent's entry in the Microsoft Agent 365 registry",
                    "timeframe": "none",
                    "dataStream": {
                        "id": "datastream-properties",
                        "name": "properties",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Copilot Agents]}}",
                        "variable": "{{variables.[Copilot Agent]}}",
                        "workspace": "{{workspaceId}}"
                    },
                    "variables": [
                        "{{variables.[Copilot Agent]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "agentType",
                                        "title": "Type",
                                        "renderer": {
                                            "type": "badge",
                                            "defaultColor": "#3b82f6"
                                        }
                                    },
                                    {
                                        "field": "platform",
                                        "title": "Platform",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "publisher",
                                        "title": "Publisher",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "ownershipStatus",
                                        "title": "Ownership",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "OK": "#22c55e",
                                                "No owner": "#ef4444"
                                            }
                                        }
                                    },
                                    {
                                        "field": "ownerCount",
                                        "title": "Owners",
                                        "renderer": {
                                            "type": "number"
                                        }
                                    },
                                    {
                                        "field": "availableTo",
                                        "title": "Available to",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "deployedTo",
                                        "title": "Deployed to",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "isBlocked",
                                        "title": "Blocked",
                                        "renderer": {
                                            "type": "boolean",
                                            "trueLabel": "Yes",
                                            "falseLabel": "No",
                                            "trueColor": "#d97706",
                                            "falseColor": "#64748b"
                                        }
                                    },
                                    {
                                        "field": "createdDateTime",
                                        "title": "Created",
                                        "renderer": {
                                            "type": "date"
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableCellPadding": 6,
                                "richTableTranspose": true
                            }
                        }
                    }
                }
            },
            {
                "i": "7932b0ad-9d85-48a2-942a-e61841f40df7",
                "x": 2,
                "y": 0,
                "w": 2,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "title": "Usage",
                    "description": "Active users and sessions over the last 30 days, and days since the agent was last used, from the Agent 365 registry",
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[agentDetails]}}",
                        "name": "agentDetails",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Copilot Agents]}}",
                        "variable": "{{variables.[Copilot Agent]}}",
                        "workspace": "{{workspaceId}}"
                    },
                    "variables": [
                        "{{variables.[Copilot Agent]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    {
                                        "field": "activeUsers",
                                        "type": "quantitative",
                                        "title": "Active users"
                                    },
                                    {
                                        "field": "totalSessions",
                                        "type": "quantitative",
                                        "title": "Sessions"
                                    },
                                    {
                                        "field": "daysSinceUsed",
                                        "type": "quantitative",
                                        "title": "Days since used"
                                    }
                                ]
                            },
                            "style": {
                                "scalarColumns": 3
                            }
                        }
                    }
                }
            },
            {
                "i": "b3d99177-b6dc-4280-a6bc-7fd430e927a1",
                "x": 2,
                "y": 2,
                "w": 2,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "title": "Reach",
                    "description": "How many users and groups the agent is shared with or allowed for, and its run time and exceptions over the last 30 days",
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[agentDetails]}}",
                        "name": "agentDetails",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Copilot Agents]}}",
                        "variable": "{{variables.[Copilot Agent]}}",
                        "workspace": "{{workspaceId}}"
                    },
                    "variables": [
                        "{{variables.[Copilot Agent]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    {
                                        "field": "sharedWithCount",
                                        "type": "quantitative",
                                        "title": "Shared with"
                                    },
                                    {
                                        "field": "allowedCount",
                                        "type": "quantitative",
                                        "title": "Allowed for"
                                    },
                                    {
                                        "field": "totalRunTimeInHours",
                                        "type": "quantitative",
                                        "title": "Run time (hours)"
                                    },
                                    {
                                        "field": "exceptions",
                                        "type": "quantitative",
                                        "title": "Exceptions"
                                    }
                                ]
                            },
                            "style": {
                                "scalarColumns": 4
                            }
                        }
                    }
                }
            }
        ]
    }
}
