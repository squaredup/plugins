                                    {
                                        "field": "availableTo",
                                        "title": "Available to",
                                        "renderer": {
                                            "type": "text"
                                        },
                                        "width": 125
                                    },
                                    {
                                        "field": "deployedTo",
                                        "title": "Deployed to",
                                        "renderer": {
                                            "type": "text"
                                        },
                                        "width": 125
