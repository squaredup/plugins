            {
                "i": "d7d38ab8-b6e2-485c-8d40-a97016b4d0d0",
                "x": 3,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "activePluginConfigIds": [],
                    "title": "New This Month",
                    "description": "Agents created in the last 30 days",
                    "timeframe": "none",
                    "dataStream": {
                        "id": "datastream-sql",
                        "dataSourceConfig": {
                            "version": "2.0",
                            "sql": "SELECT COUNT(*) AS \"created\" FROM \"agents\" WHERE \"createdDateTime\" >= NOW() - INTERVAL 30 DAY",
                            "tables": [
                                {
                                    "tableName": "agents",
                                    "config": {
                                        "activePluginConfigIds": [
                                            "{{configId}}"
                                        ],
                                        "dataStream": {
                                            "id": "{{dataStreams.[agents]}}",
                                            "name": "agents"
                                        },
                                        "timeframe": "none"
                                    }
                                }
                            ]
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    {
                                        "field": "created",
                                        "type": "quantitative",
                                        "title": "Created in 30 days"
                                    }
                                ]
                            }
                        }
                    }
                }
            },
            {
                "i": "0384aecc-3240-4ea6-bf93-b2dd014681f9",
                "x": 0,
                "y": 2,
                "w": 2,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "activePluginConfigIds": [],
                    "title": "Agents by Platform",
                    "description": "Agents in the registry by the platform they were built on and their type",
                    "timeframe": "none",
                    "dataStream": {
                        "id": "datastream-sql",
                        "dataSourceConfig": {
                            "version": "2.0",
                            "sql": "SELECT COALESCE(\"platform\", '(Unknown)') AS \"platform\", COALESCE(\"agentType\", '(Unknown)') AS \"type\", COUNT(*) AS \"agents\" FROM \"agents\" GROUP BY 1, 2 ORDER BY 3 DESC",
                            "tables": [
                                {
                                    "tableName": "agents",
                                    "config": {
                                        "activePluginConfigIds": [
                                            "{{configId}}"
                                        ],
                                        "dataStream": {
                                            "id": "{{dataStreams.[agents]}}",
                                            "name": "agents"
                                        },
                                        "timeframe": "none"
                                    }
                                }
                            ]
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "platform",
                                    "type": "nominal",
                                    "title": "Platform"
                                },
                                "y": {
                                    "field": "agents",
                                    "type": "quantitative",
                                    "title": "Agents",
                                    "aggregate": "sum"
                                },
                                "series": {
                                    "field": "type",
                                    "type": "nominal",
                                    "title": "Type"
                                }
                            },
                            "style": {
                                "cartesianHorizontal": true,
                                "cartesianStack": "on",
                                "cartesianBarBorderRadius": 2,
                                "legendPosition": "bottom",
                                "cartesianYAxisDecimalPlaces": 0
                            }
                        }
                    }
                }
            },
            {
                "i": "cf7e9640-f816-464e-9d9f-85568d146346",
                "x": 2,
                "y": 2,
                "w": 2,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "activePluginConfigIds": [],
                    "title": "New Agents per Week",
                    "description": "Agents added to the registry each week",
                    "timeframe": "none",
                    "dataStream": {
                        "id": "datastream-sql",
                        "dataSourceConfig": {
                            "version": "2.0",
                            "sql": "SELECT CAST(DATE_TRUNC('week', CAST(\"createdDateTime\" AS TIMESTAMP)) AS TIMESTAMP) AS \"week\", COUNT(*) AS \"agents\" FROM \"agents\" WHERE \"createdDateTime\" IS NOT NULL GROUP BY 1 ORDER BY 1",
                            "tables": [
                                {
                                    "tableName": "agents",
                                    "config": {
                                        "activePluginConfigIds": [
                                            "{{configId}}"
                                        ],
                                        "dataStream": {
                                            "id": "{{dataStreams.[agents]}}",
                                            "name": "agents"
                                        },
                                        "timeframe": "none"
                                    }
                                }
                            ]
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "week",
                                    "type": "temporal",
                                    "title": "Week"
                                },
                                "y": {
                                    "field": "agents",
                                    "type": "quantitative",
                                    "title": "New agents",
                                    "aggregate": "sum"
                                }
                            },
                            "style": {
                                "cartesianBarBorderRadius": 2,
                                "cartesianTrendLine": true,
                                "cartesianYAxisDecimalPlaces": 0,
                                "colors": [
                                    "#3b82f6"
                                ]
                            }
                        }
                    }
                }
            },
            {
                "i": "d8dfb32a-1ace-4240-a826-980fa6d0bcdc",
                "x": 0,
                "y": 5,
                "w": 4,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "activePluginConfigIds": [],
                    "title": "Agents Needing Attention",
                    "description": "Agents with no owner, or that are blocked, with who they're available to",
                    "timeframe": "none",
                    "dataStream": {
                        "id": "datastream-sql",
                        "dataSourceConfig": {
                            "version": "2.0",
                            "sql": "SELECT \"ownershipState\", \"displayName\", \"ownershipStatus\", CASE WHEN \"isBlocked\" THEN 'Blocked' ELSE '' END AS \"blocked\", \"platform\", \"publisher\", \"availableTo\", \"ownerCount\", \"lastModifiedDateTime\" FROM \"agents\" WHERE \"ownershipStatus\" <> 'OK' OR \"isBlocked\" ORDER BY \"ownershipStatus\", \"displayName\"",
                            "tables": [
                                {
                                    "tableName": "agents",
                                    "config": {
                                        "activePluginConfigIds": [
                                            "{{configId}}"
                                        ],
                                        "dataStream": {
                                            "id": "{{dataStreams.[agents]}}",
                                            "name": "agents"
                                        },
                                        "timeframe": "none"
                                    }
                                }
                            ]
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "ownershipState",
                                        "title": "",
                                        "renderer": {
                                            "type": "status",
                                            "showLabel": false
                                        },
                                        "width": 32
                                    },
                                    {
                                        "field": "displayName",
                                        "title": "Agent",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "ownershipStatus",
                                        "title": "Ownership",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "OK": "#22c55e",
                                                "No owner": "#ef4444"
                                            }
                                        },
                                        "width": 120
                                    },
                                    {
                                        "field": "blocked",
                                        "title": "Blocked",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "Blocked": "#f59e0b"
                                            }
                                        },
                                        "width": 100
                                    },
                                    {
                                        "field": "platform",
                                        "title": "Platform",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "publisher",
                                        "title": "Publisher",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "availableTo",
                                        "title": "Available to",
                                        "renderer": {
                                            "type": "text"
                                        },
                                        "width": 125
                                    },
                                    {
                                        "field": "ownerCount",
                                        "title": "Owners",
                                        "renderer": {
                                            "type": "number"
                                        },
                                        "align": "right",
                                        "width": 95
                                    },
                                    {
                                        "field": "lastModifiedDateTime",
                                        "title": "Last updated",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        },
                                        "width": 130
                                    }
                                ]
                            },
                            "style": {
                                "richTableHideCount": false
                            }
                        }
                    }
                }
            },
