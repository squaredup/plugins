{
    "name": "microsoft-copilot",
    "displayName": "Microsoft Copilot",
    "version": "1.0.0",
    "author": {
        "name": "SquaredUp Labs",
        "type": "labs"
    },
    "description": "Track Microsoft 365 Copilot adoption and licence use, Copilot Studio credit capacity, and Copilot spend.",
    "category": "Monitoring",
    "type": "cloud",
    "schemaVersion": "2.1",
    "importNotSupported": false,
    "restrictedToPlatforms": [],
    "keywords": [
        "copilot",
        "copilot studio",
        "microsoft 365",
        "microsoft",
        "ai",
        "agents",
        "adoption",
        "licences",
        "credits",
        "cost"
    ],
    "objectTypes": ["User", "Environment"],
    "links": [
        {
            "category": "documentation",
            "url": "https://github.com/squaredup/plugins/blob/main/plugins/MicrosoftCopilot/v1/docs/README.md",
            "label": "Help adding this plugin"
        },
        {
            "category": "source",
            "url": "https://github.com/squaredup/plugins/tree/main/plugins/MicrosoftCopilot/v1",
            "label": "Repository"
        }
    ],
    "base": {
        "plugin": "WebAPI",
        "majorVersion": "1",
        "config": {
            "baseUrl": "https://login.microsoftonline.com/",
            "authMode": "none",
            "headers": [],
            "queryArgs": [],
            "showScripting": true,
            "scriptingVariables": [
                { "key": "tenantId", "value": "{{tenantId}}" },
                { "key": "clientId", "value": "{{clientId}}" },
                { "key": "clientSecret", "value": "{{clientSecret}}" }
            ],
            "preRequestScript": "preRequest.js"
        }
    }
}
