[
    {
        "type": "text",
        "name": "tenantId",
        "label": "Directory (tenant) ID",
        "placeholder": "00000000-0000-0000-0000-000000000000",
        "validation": {
            "required": true,
            "pattern": {
                "value": "/^\\s*[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\\s*$/iu",
                "message": "Enter the directory (tenant) ID, a GUID like 00000000-0000-0000-0000-000000000000"
            }
        }
    },
    {
        "type": "text",
        "name": "clientId",
        "label": "Application (client) ID",
        "placeholder": "00000000-0000-0000-0000-000000000000",
        "validation": {
            "required": true,
            "pattern": {
                "value": "/^\\s*[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\\s*$/iu",
                "message": "Enter the application (client) ID, a GUID like 00000000-0000-0000-0000-000000000000"
            }
        }
    },
    {
        "type": "password",
        "name": "clientSecret",
        "label": "Client secret",
        "placeholder": "Enter a client secret",
        "validation": {
            "required": true
        }
    },
    {
        "type": "text",
        "name": "costScope",
        "label": "Cost Management scope",
        "placeholder": "/subscriptions/00000000-0000-0000-0000-000000000000",
        "validation": {
            "pattern": {
                "value": "/^/(?:subscriptions/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?:/resourceGroups/[\\p{L}\\p{N}_().-]{0,89}[\\p{L}\\p{N}_()-])?|providers/Microsoft\\.Management/managementGroups/[a-z0-9](?:[a-z0-9_().-]{0,88}[a-z0-9_()-])?|providers/Microsoft\\.Billing/billingAccounts/[^/\\s?#]+(?:/(?:departments|enrollmentAccounts|customers)/[^/\\s?#]+|/billingProfiles/[^/\\s?#]+(?:/invoiceSections/[^/\\s?#]+)?)?)$/iu",
                "message": "Enter a scope path starting with /subscriptions/ or /providers/, e.g. /subscriptions/00000000-0000-0000-0000-000000000000 or /providers/Microsoft.Billing/billingAccounts/12345678, with no trailing slash"
            }
        },
        "help": "Enables the Copilot spend data stream. Accepts a subscription, resource group, management group or billing account scope. See [Cost Management scopes](https://learn.microsoft.com/en-us/azure/cost-management-billing/costs/understand-work-scopes)."
    }
]
