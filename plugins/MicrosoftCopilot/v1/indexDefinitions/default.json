{
    "steps": [
        {
            "name": "users",
            "dataStream": { "name": "users" },
            "timeframe": "none",
            "objectMapping": {
                "id": "id",
                "name": "displayName",
                "type": { "value": "User" },
                "properties": [
                    "userPrincipalName",
                    "mail",
                    "department",
                    "jobTitle",
                    "officeLocation",
                    "country",
                    "accountEnabled"
                ]
            }
        },
        {
            "name": "environments",
            "dataStream": { "name": "environments" },
            "timeframe": "none",
            "objectMapping": {
                "id": "name",
                "name": "properties.displayName",
                "type": { "value": "Environment" },
                "properties": [
                    { "environmentType": "properties.environmentSku" },
                    { "geography": "location" },
                    { "azureRegion": "properties.azureRegion" },
                    { "isDefault": "properties.isDefault" },
                    { "status": "properties.states.management.id" },
                    { "dataverseUrl": "properties.linkedEnvironmentMetadata.instanceUrl" },
                    { "createdTime": "properties.createdTime" }
                ]
            }
        }
    ]
}
