{
    "steps": [
        {
            "name": "users",
            "dataStream": {
                "name": "users"
            },
            "timeframe": "none",
            "objectMapping": {
                "id": "userPrincipalName",
                "name": "displayName",
                "type": {
                    "value": "User"
                },
                "properties": [
                    "userPrincipalName",
                    {
                        "entraObjectId": "id"
                    },
                    "mail",
                    "department",
                    "jobTitle",
                    "officeLocation",
                    "country",
                    "accountEnabled"
                ]
            }
        },
        {
            "name": "environments",
            "dataStream": {
                "name": "environments"
            },
            "optional": true,
            "timeframe": "none",
            "objectMapping": {
                "id": "name",
                "name": "properties.displayName",
                "type": {
                    "value": "Environment"
                },
                "properties": [
                    {
                        "environmentType": "properties.environmentSku"
                    },
                    {
                        "geography": "location"
                    },
                    {
                        "azureRegion": "properties.azureRegion"
                    },
                    {
                        "isDefault": "properties.isDefault"
                    },
                    {
                        "status": "properties.states.management.id"
                    },
                    {
                        "dataverseUrl": "properties.linkedEnvironmentMetadata.instanceUrl"
                    },
                    {
                        "createdTime": "properties.createdTime"
                    }
                ]
            }
        },
        {
            "name": "agents",
            "dataStream": {
                "name": "agents"
            },
            "optional": true,
            "timeframe": "none",
            "objectMapping": {
                "id": "id",
                "name": "displayName",
                "type": {
                    "value": "Agent"
                },
                "properties": [
                    "agentType",
                    "platform",
                    "publisher",
                    "availableTo",
                    "deployedTo",
                    "isBlocked",
                    "ownershipStatus",
                    "ownerIds",
                    "ownerCount",
                    "createdDateTime",
                    "appId"
                ]
            }
        }
    ]
}
