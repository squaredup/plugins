{
    "name": "advancedHuntingQuery",
    "displayName": "Advanced Hunting Query",
    "description": "Runs a KQL query to look for threats in your environment (needs advanced hunting, such as Defender for Endpoint Plan 2 or Defender for Office 365 Plan 2)",
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "post",
        "errorHandling": {
            "type": "script",
            "script": "errorHandling/microsoftGraphApi.js"
        },
        "paging": {
            "mode": "none"
        },
        "expandInnerObjects": true,
        "endpointPath": "runHuntingQuery",
        "postBody": {
            "Query": "{{query}}",
            "Timespan": "{{timeframe.enum != \"none\" ? `${timeframe.start}/${timeframe.end}` : \"\" }}"
        },
        "pathToData": "results",
        "getArgs": [],
        "headers": []
    },
    "timeframes": [
        "last1hour",
        "last12hours",
        "last24hours",
        "last7days",
        "last30days",
        "thisMonth",
        "thisQuarter",
        "thisYear",
        "lastMonth",
        "lastQuarter",
        "lastYear"
    ],
    "supportsNoneTimeframe": true,
    "providesPluginDiagnostics": true,
    "manualConfigApply": true,
    "tags": [],
    "ui": [
        {
            "name": "query",
            "language": "kusto",
            "label": "Query",
            "type": "code",
            "validation": {
                "required": true
            }
        }
    ]
}