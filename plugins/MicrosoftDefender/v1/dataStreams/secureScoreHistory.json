{
    "name": "secureScoreHistory",
    "displayName": "Secure Score History",
    "description": "Retrieves the current tenant's Secure Score data from the past 90 days",
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "errorHandling": {
            "type": "default"
        },
        "paging": {
            "mode": "offset",
            "pageSize": {
                "realm": {
                    "value": "queryArg",
                    "label": "Query parameter"
                },
                "path": "$top",
                "value": "100"
            },
            "offset": {
                "rowCountIn": {
                    "realm": {
                        "value": "payloadArraySize",
                        "label": "Body array size"
                    },
                    "path": "value"
                },
                "mode": "row",
                "base": "0"
            },
            "out": {
                "realm": {
                    "value": "queryArg",
                    "label": "queryArg"
                },
                "path": "$skip"
            }
        },
        "expandInnerObjects": true,
        "endpointPath": "secureScores",
        "pathToData": "value",
        "getArgs": [],
        "headers": []
    },
    "providesPluginDiagnostics": true,
    "timeframes": false,
    "tags": []
}