{
    "name": "report",
    "displayName": "Report",
    "description": "Rows of a Report Builder report, with the report's own columns (including custom attributes)",
    "tags": ["Reports"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "api/reports/{{typeof report === 'undefined' || !report ? 0 : Array.isArray(report) ? (report[0] && report[0].value) || 0 : report}}",
        "getArgs": [{ "key": "withData", "value": "true" }],
        "paging": { "mode": "none" },
        "postRequestScript": "report.js",
        "errorHandling": {
            "type": "script",
            "script": "errorHandling/report.js"
        }
    },
    "matches": "none",
    "manualConfigApply": true,
    "ui": [
        {
            "type": "autocomplete",
            "name": "report",
            "label": "Report",
            "help": "Build the report in TeamDynamix Report Builder, adding custom attributes as columns. Only reports the TeamDynamix admin service account can see are listed. A report ID can also be typed in.",
            "allowCustomValues": true,
            "data": {
                "source": "dataStream",
                "dataStreamName": "reports",
                "dataSourceConfig": {}
            },
            "validation": { "required": true }
        }
    ],
    "metadata": [],
    "timeframes": ["none"],
    "supportsNoneTimeframe": true,
    "defaultTimeframe": "none"
}
