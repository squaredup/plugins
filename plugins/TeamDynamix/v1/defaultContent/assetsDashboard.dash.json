                                    "critical": "#DE0038",
                                    "error": "#DE0038",
                                    "failed": "#DE0038",
                                    "failure": "#DE0038",
                                    "down": "#DE0038",
                                    "offline": "#DE0038",
                                    "unhealthy": "#DE0038",
                                    "high": "#DE0038",
                                    "warning": "#F59E0B",
                                    "warn": "#F59E0B",
                                    "medium": "#F59E0B",
                                    "moderate": "#F59E0B",
                                    "degraded": "#F59E0B",
                                    "partial": "#F59E0B",
                                    "ok": "#2BB660",
                                    "healthy": "#2BB660",
                                    "success": "#2BB660",
                                    "succeeded": "#2BB660",
                                    "passed": "#2BB660",
                                    "up": "#2BB660",
