                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Assets by Status",
                    "description": "",
                    "timeframe": "none",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[assets]}}",
                        "name": "assets",
                        "pluginConfigId": "{{configId}}",
                        "config": { "inService": "all" },
                        "group": {
                            "by": [["statusName", "uniqueValues"]],
                            "aggregate": [{ "type": "count" }]
                        },
                        "sort": { "by": [["count", "desc"]] }
                    },
