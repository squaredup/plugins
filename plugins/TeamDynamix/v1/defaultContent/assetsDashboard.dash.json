                                "x": {
                                    "field": "manufacturerName_uniqueValues",
                                    "type": "nominal",
                                    "title": "Manufacturer"
                                },
                                "y": {
                                    "field": "count",
                                    "type": "quantitative",
                                    "title": "Count"
                                }
                            },
                            "style": {
                                "legendPosition": "none",
                                "cartesianShowYAxisTitle": true,
