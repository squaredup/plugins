                "config": {
                    "_type": "tile/data-stream",
                    "title": "Usage Hours by Service",
                    "description": "Billable hours per service code for the selected timeframe",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[charges]}}",
                        "name": "charges",
                        "pluginConfigId": "{{configId}}",
                        "group": {
                            "by": [["code", "uniqueValues"]],
                            "aggregate": [{ "type": "sum", "names": ["num_hours"] }]
                        },
                        "sort": {
                            "by": [["num_hours_sum", "desc"]]
                        }
                    },
                    "visualisation": {
                        "type": "data-stream-bar-chart",
                        "config": {
                            "data-stream-bar-chart": {
                                "xAxisData": "code_uniqueValues",
                                "yAxisData": ["num_hours_sum"],
                                "xAxisGroup": "none",
                                "xAxisLabel": "Service",
                                "yAxisLabel": "Usage Hours",
                                "showXAxisLabel": true,
                                "showYAxisLabel": true,
                                "showLegend": false,
                                "legendPosition": "bottom",
                                "showGrid": true,
                                "horizontalLayout": "vertical",
                                "displayMode": "actual",
                                "showTotals": false,
                                "showValue": false,
                                "grouping": false,
                                "range": { "type": "auto" }
                            }
                        }
                    }
                }
