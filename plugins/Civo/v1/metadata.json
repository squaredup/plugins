{
    "name": "civo",
    "displayName": "Civo",
    "version": "1.2.0",
    "author": { "name": "Dan Watts", "type": "community" },
    "description": "Monitor your Civo managed Kubernetes platform in SquaredUp — clusters, instances, volumes, object stores and networks, plus account quota and usage.",
    "category": "Cloud Platforms",
    "type": "hybrid",
    "schemaVersion": "2.1",
    "importNotSupported": false,
    "restrictedToPlatforms": [],
    "keywords": ["civo", "kubernetes", "k3s", "cloud", "containers", "infrastructure"],
    "objectTypes": [
        "Civo Cluster",
        "Civo Instance",
        "Civo Volume",
        "Civo Object Store",
        "Civo Network"
    ],
    "links": [
        {
            "category": "documentation",
            "url": "https://github.com/squaredup/plugins/blob/main/plugins/Civo/v1/docs/README.md",
            "label": "Help adding this plugin"
        },
        {
            "category": "source",
            "url": "https://github.com/squaredup/plugins/tree/main/plugins/Civo",
            "label": "Repository"
        }
    ],
    "base": {
        "plugin": "WebAPI",
        "majorVersion": "1",
        "config": {
            "baseUrl": "https://api.civo.com/v2",
            "authMode": "none",
            "headers": [
                { "key": "Authorization", "value": "Bearer {{apiKey}}" }
            ],
            "queryArgs": []
        }
    }
}
