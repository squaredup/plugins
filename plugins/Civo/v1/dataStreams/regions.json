{
    "name": "regions",
    "displayName": "Regions",
    "description": "Civo regions available to the account and their capabilities",
    "tags": ["Region"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/regions",
        "expandInnerObjects": true
    },
    "matches": "none",
    "metadata": [
        { "name": "code", "displayName": "Code", "shape": "string", "role": "label" },
        { "name": "name", "displayName": "Name", "shape": "string" },
        { "name": "country_name", "displayName": "Country", "shape": "string" },
        { "name": "type", "displayName": "Type", "shape": "string" },
        { "name": "default", "displayName": "Default", "shape": "boolean" },
        { "name": "out_of_capacity", "displayName": "Out of capacity", "shape": "boolean" },
        { "name": "features.iaas", "displayName": "IaaS", "shape": "boolean" },
        { "name": "features.kubernetes", "displayName": "Kubernetes", "shape": "boolean" },
        { "pattern": ".*" }
    ],
    "timeframes": false
}
