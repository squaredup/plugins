{
    "name": "charges",
    "displayName": "Usage & Billing",
    "description": "Metered usage charge line-items across the account for the selected timeframe",
    "tags": ["Billing"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/charges",
        "getArgs": [
            { "key": "from", "value": "{{timeframe.start}}" },
            { "key": "to", "value": "{{timeframe.end}}" }
        ],
        "postRequestScript": "charges.js"
    },
    "matches": "none",
    "metadata": [
        { "name": "label", "displayName": "Resource Name", "shape": "string", "role": "label" },
        { "name": "code", "displayName": "Service Code", "shape": "string" },
        { "name": "region", "displayName": "Region", "shape": "string" },
        { "name": "num_hours", "displayName": "Billable Hours", "shape": "number", "role": "value" },
        { "name": "size_gb", "displayName": "Size (GB)", "shape": "gigabytes" },
        { "name": "from", "displayName": "From", "shape": "date" },
        { "name": "to", "displayName": "To", "shape": "date" },
        { "name": "product_id", "displayName": "Resource ID", "shape": "string", "visible": false },
        { "name": "estimatedCost", "displayName": "Est. Cost (USD)", "shape": ["currency", { "code": "usd", "decimalPlaces": 2 }] },
        { "pattern": ".*" }
    ],
    "timeframes": ["last24hours", "last7days", "last30days", "thisMonth", "lastMonth"]
}
