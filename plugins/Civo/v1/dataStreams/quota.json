{
    "name": "quota",
    "displayName": "Quota",
    "description": "Account-wide resource quota showing usage and limits per resource type",
    "tags": ["Quota"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/quota",
        "postRequestScript": "quota.js"
    },
    "matches": "none",
    "metadata": [
        { "name": "resource", "displayName": "Resource", "shape": "string", "role": "label" },
        { "name": "usage", "displayName": "Usage", "shape": "number", "role": "value" },
        { "name": "limit", "displayName": "Limit", "shape": "number" },
        { "name": "percentUsed", "displayName": "% Used", "shape": "percent" }
    ],
    "timeframes": false
}
