{
    "name": "maintenance",
    "displayName": "Scheduled Maintenance",
    "description": "Splunk Cloud Platform maintenance windows, upcoming, in progress and completed",
    "tags": ["Status", "Maintenance"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "scheduled-maintenances.json",
        "paging": {
            "mode": "none"
        },
        "postRequestScript": "maintenance.js"
    },
    "matches": "none",
    "metadata": [
        {
            "name": "id",
            "displayName": "ID",
            "shape": "string",
            "role": "id",
            "visible": false
        },
        {
            "name": "name",
            "displayName": "Maintenance",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "status",
            "displayName": "Status",
            "shape": "string"
        },
        {
            "name": "phase",
            "displayName": "Phase",
            "shape": "string"
        },
        {
            "name": "state",
            "displayName": "State",
            "shape": "state"
        },
        {
            "name": "components",
            "displayName": "Components",
            "shape": ["array", { "itemShape": "string" }]
        },
        {
            "name": "scheduledFor",
            "displayName": "Scheduled start",
            "shape": "date",
            "role": "timestamp"
        },
        {
            "name": "scheduledUntil",
            "displayName": "Scheduled end",
            "shape": "date"
        },
        {
            "name": "durationMinutes",
            "displayName": "Planned duration",
            "shape": "minutes"
        },
        {
            "name": "description",
            "displayName": "Description",
            "shape": "string"
        },
        {
            "name": "link",
            "displayName": "Link",
            "shape": ["url", { "label": "View maintenance" }],
            "role": "link"
        }
    ],
    "defaultShaping": {
        "sort": {
            "by": [["scheduledFor", "desc"]]
        }
    },
    "timeframes": true,
    "supportsNoneTimeframe": true,
    "defaultTimeframe": "none"
}
