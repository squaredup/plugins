{
    "name": "overallStatus",
    "displayName": "Overall Status",
    "description": "Current overall status of Splunk Cloud Platform with counts of affected components, active incidents and maintenance",
    "tags": ["Status", "Incidents"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "summary.json",
        "paging": {
            "mode": "none"
        },
        "postRequestScript": "overallStatus.js"
    },
    "matches": "none",
    "metadata": [
        {
            "name": "status",
            "displayName": "Status",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "state",
            "displayName": "State",
            "shape": "state"
        },
        {
            "name": "indicator",
            "displayName": "Indicator",
            "shape": "string"
        },
        {
            "name": "componentsAffected",
            "displayName": "Components affected",
            "shape": ["number", { "decimalPlaces": 0 }]
        },
        {
            "name": "activeIncidents",
            "displayName": "Active incidents",
            "shape": ["number", { "decimalPlaces": 0 }]
        },
        {
            "name": "activeMaintenance",
            "displayName": "Active maintenance",
            "shape": ["number", { "decimalPlaces": 0 }]
        },
        {
            "name": "upcomingMaintenance",
            "displayName": "Upcoming maintenance",
            "shape": ["number", { "decimalPlaces": 0 }]
        },
        {
            "name": "updatedAt",
            "displayName": "Updated",
            "shape": "date"
        },
        {
            "name": "link",
            "displayName": "Status page",
            "shape": ["url", { "label": "Open status page" }],
            "role": "link"
        }
    ],
    "timeframes": false
}
