{
    "name": "componentStatus",
    "displayName": "Component Status",
    "description": "Current status of each Splunk Cloud Platform component, one row per component",
    "tags": ["Status"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "components.json",
        "paging": {
            "mode": "none"
        },
        "postRequestScript": "componentStatus.js"
    },
    "matches": "none",
    "metadata": [
        {
            "name": "id",
            "displayName": "ID",
            "shape": "string",
            "role": "id",
            "visible": false
        },
        {
            "name": "name",
            "displayName": "Component",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "group",
            "displayName": "Group",
            "shape": "string"
        },
        {
            "name": "status",
            "displayName": "Status",
            "shape": "string"
        },
        {
            "name": "state",
            "displayName": "State",
            "shape": "state"
        },
        {
            "name": "severity",
            "displayName": "Severity",
            "shape": "number",
            "visible": false
        },
        {
            "name": "updatedAt",
            "displayName": "Status changed",
            "shape": "date"
        }
    ],
    "defaultShaping": {
        "sort": {
            "by": [
                ["severity", "desc"],
                ["name", "asc"]
            ]
        }
    },
    "timeframes": false
}
