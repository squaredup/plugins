{
    "name": "incidents",
    "displayName": "Incidents",
    "description": "Splunk Cloud Platform incidents, one row per incident (or per affected component), with impact, timing and the latest update",
    "tags": ["Status", "Incidents"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "incidents.json",
        "paging": {
            "mode": "none"
        },
        "postRequestScript": "incidents.js"
    },
    "matches": "none",
    "ui": [
        {
            "type": "toggle",
            "name": "oneRowPerComponent",
            "label": "One row per affected component",
            "defaultValue": false,
            "help": "Splits an incident that affects several components into one row per component, so tiles can group by component. When off, each incident is one row."
        }
    ],
    "metadata": [
        {
            "name": "id",
            "displayName": "ID",
            "shape": "string",
            "role": "id",
            "visible": false
        },
        {
            "name": "name",
            "displayName": "Incident",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "impact",
            "displayName": "Impact",
            "shape": "string"
        },
        {
            "name": "worstComponentStatus",
            "displayName": "Worst component status",
            "shape": "string"
        },
        {
            "name": "status",
            "displayName": "Status",
            "shape": "string"
        },
        {
            "name": "phase",
            "displayName": "Phase",
            "shape": "string"
        },
        {
            "name": "state",
            "displayName": "State",
            "shape": "state"
        },
        {
            "name": "components",
            "displayName": "Components",
            "shape": ["array", { "itemShape": "string" }]
        },
        {
            "name": "startedAt",
            "displayName": "Started",
            "shape": "date",
            "role": "timestamp"
        },
        {
            "name": "resolvedAt",
            "displayName": "Resolved",
            "shape": "date"
        },
        {
            "name": "updatedAt",
            "displayName": "Last updated",
            "shape": "date"
        },
        {
            "name": "timeToResolveMinutes",
            "displayName": "Time to resolve",
            "shape": "minutes"
        },
        {
            "name": "updateCount",
            "displayName": "Updates",
            "shape": ["number", { "decimalPlaces": 0 }]
        },
        {
            "name": "latestUpdate",
            "displayName": "Latest update",
            "shape": "string"
        },
        {
            "name": "link",
            "displayName": "Link",
            "shape": ["url", { "label": "View incident" }],
            "role": "link"
        }
    ],
    "defaultShaping": {
        "sort": {
            "by": [["startedAt", "desc"]]
        }
    },
    "timeframes": true,
    "supportsNoneTimeframe": true,
    "defaultTimeframe": "none"
}
