{
    "name": "Maintenance",
    "schemaVersion": "1.5",
    "timeframe": "none",
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "8232c571-5f9b-4a8b-9d28-948ade88f1d5",
                "x": 0,
                "y": 0,
                "w": 2,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Upcoming Windows",
                    "description": "",
                    "timeframe": "none",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[maintenance]}}",
                        "name": "maintenance",
                        "pluginConfigId": "{{configId}}",
                        "filter": {
                            "multiOperation": "and",
                            "filters": [
                                {
                                    "column": "phase",
                                    "operation": "equals",
                                    "value": "Upcoming"
                                }
                            ]
                        },
                        "group": {
                            "by": [],
                            "aggregate": [
                                {
                                    "type": "count"
                                }
                            ]
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    {
                                        "field": "count",
                                        "type": "quantitative",
                                        "title": "Upcoming Windows"
                                    }
                                ]
                            },
                            "style": {
                                "scalarLabelPosition": "none"
                            }
                        }
                    }
                }
            },
            {
                "i": "e9a58300-3a46-48aa-98e4-6a983a250451",
                "x": 2,
                "y": 0,
                "w": 2,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Windows in Progress",
                    "description": "",
                    "timeframe": "none",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[maintenance]}}",
                        "name": "maintenance",
                        "pluginConfigId": "{{configId}}",
                        "filter": {
                            "multiOperation": "and",
                            "filters": [
                                {
                                    "column": "phase",
                                    "operation": "equals",
                                    "value": "Active"
                                }
                            ]
                        },
                        "group": {
                            "by": [],
                            "aggregate": [
                                {
                                    "type": "count"
                                }
                            ]
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    {
                                        "field": "count",
                                        "type": "quantitative",
                                        "title": "Windows in Progress"
                                    }
                                ]
                            },
                            "style": {
                                "scalarLabelPosition": "none"
                            }
                        }
                    }
                }
            },
            {
                "i": "35736294-799d-40c1-bb2d-df112cb8f6bb",
                "x": 0,
                "y": 2,
                "w": 4,
                "h": 5,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Maintenance Windows",
                    "description": "Every maintenance window on record",
                    "timeframe": "none",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[maintenance]}}",
                        "name": "maintenance",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [
                                [
                                    "scheduledFor",
                                    "desc"
                                ]
                            ]
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "name",
                                        "title": "Maintenance",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "status",
                                        "title": "Status",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "Scheduled": "#3b82f6",
                                                "In progress": "#f59e0b",
                                                "Verifying": "#f59e0b",
                                                "Completed": "#22c55e"
                                            }
                                        }
                                    },
                                    {
                                        "field": "scheduledFor",
                                        "title": "Scheduled Start",
                                        "renderer": {
                                            "type": "date"
                                        }
                                    },
                                    {
                                        "field": "scheduledUntil",
                                        "title": "Scheduled End",
                                        "renderer": {
                                            "type": "date"
                                        }
                                    },
                                    {
                                        "field": "durationMinutes",
                                        "title": "Planned Duration",
                                        "renderer": {
                                            "type": "number",
                                            "decimals": 0,
                                            "suffix": " min"
                                        },
                                        "align": "right"
                                    },
                                    {
                                        "field": "components",
                                        "title": "Components",
                                        "renderer": {
                                            "type": "tag-list",
                                            "separator": ","
                                        }
                                    },
                                    {
                                        "field": "link",
                                        "title": "Link",
                                        "renderer": {
                                            "type": "link"
                                        }
                                    }
                                ]
                            },
                            "style": {}
                        }
                    }
                }
            }
        ]
    }
}
