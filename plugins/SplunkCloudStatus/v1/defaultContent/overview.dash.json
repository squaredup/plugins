{
    "name": "Overview",
    "schemaVersion": "1.5",
    "timeframe": "thisYear",
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "9627297a-9b18-4746-906d-6a38b0115250",
                "x": 0,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Overall Status",
                    "description": "",
                    "timeframe": "none",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[overallStatus]}}",
                        "name": "overallStatus",
                        "pluginConfigId": "{{configId}}"
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    {
                                        "field": "status",
                                        "type": "nominal",
                                        "title": "Overall Status"
                                    }
                                ]
                            },
                            "style": {
                                "scalarLabelPosition": "none"
                            }
                        }
                    }
                }
            },
            {
                "i": "39b16c7c-d844-4131-af7f-0f14ad076644",
                "x": 1,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Components Affected",
                    "description": "",
                    "timeframe": "none",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[overallStatus]}}",
                        "name": "overallStatus",
                        "pluginConfigId": "{{configId}}"
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    {
                                        "field": "componentsAffected",
                                        "type": "quantitative",
                                        "title": "Components Affected"
                                    }
                                ]
                            },
                            "style": {
                                "scalarLabelPosition": "none"
                            }
                        }
                    }
                }
            },
            {
                "i": "cfd58279-ec37-48d9-a6c4-7b3e4c5ebeb2",
                "x": 2,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Active Incidents",
                    "description": "",
                    "timeframe": "none",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[overallStatus]}}",
                        "name": "overallStatus",
                        "pluginConfigId": "{{configId}}"
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    {
                                        "field": "activeIncidents",
                                        "type": "quantitative",
                                        "title": "Active Incidents"
                                    }
                                ]
                            },
                            "style": {
                                "scalarLabelPosition": "none"
                            }
                        }
                    }
                }
            },
            {
                "i": "f58a66ba-a51b-4dd6-b49e-43f93c3120fa",
                "x": 3,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Upcoming Maintenance",
                    "description": "",
                    "timeframe": "none",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[overallStatus]}}",
                        "name": "overallStatus",
                        "pluginConfigId": "{{configId}}"
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    {
                                        "field": "upcomingMaintenance",
                                        "type": "quantitative",
                                        "title": "Upcoming Maintenance"
                                    }
                                ]
                            },
                            "style": {
                                "scalarLabelPosition": "none"
                            }
                        }
                    }
                }
            },
            {
                "i": "98627a60-240a-437b-97da-5430ad275de4",
                "x": 0,
                "y": 2,
                "w": 2,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Component Status",
                    "description": "Current status of each Splunk Cloud Platform component",
                    "timeframe": "none",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[componentStatus]}}",
                        "name": "componentStatus",
                        "pluginConfigId": "{{configId}}"
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "statusGrid",
                            "encoding": {
                                "label": {
                                    "field": "name",
                                    "type": "nominal"
                                },
                                "status": {
                                    "field": "state",
                                    "type": "nominal"
                                },
                                "group": {
                                    "field": "group",
                                    "type": "nominal"
                                }
                            },
                            "style": {
                                "statusGridColumnsPerRow": 2,
                                "statusGridSecondaryTemplate": "{{{{raw}}}}{{status}}{{{{/raw}}}}"
                            }
                        }
                    }
                }
            },
            {
                "i": "64fba396-b701-4163-abc5-8204bca36566",
                "x": 2,
                "y": 2,
                "w": 2,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Incidents Per Month",
                    "description": "Incidents started in each month of the dashboard timeframe",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[incidents]}}",
                        "name": "incidents",
                        "pluginConfigId": "{{configId}}",
                        "group": {
                            "by": [
                                [
                                    "startedAt",
                                    "byMonth"
                                ]
                            ],
                            "aggregate": [
                                {
                                    "type": "count"
                                }
                            ]
                        },
                        "sort": {
                            "by": [
                                [
                                    "startedAt_byMonth",
                                    "asc"
                                ]
                            ]
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "startedAt_byMonth",
                                    "type": "temporal",
                                    "title": "Month"
                                },
                                "y": {
                                    "field": "count",
                                    "type": "quantitative",
                                    "title": "Incidents"
                                }
                            },
                            "style": {
                                "cartesianBarBorderRadius": 4
                            }
                        }
                    }
                }
            },
            {
                "i": "242fc251-5592-421e-b9e5-706b589c2134",
                "x": 0,
                "y": 6,
                "w": 2,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Active Incidents",
                    "description": "Incidents that are still open",
                    "timeframe": "none",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[incidents]}}",
                        "name": "incidents",
                        "pluginConfigId": "{{configId}}",
                        "filter": {
                            "multiOperation": "and",
                            "filters": [
                                {
                                    "column": "phase",
                                    "operation": "equals",
                                    "value": "Active"
                                }
                            ]
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "name",
                                        "title": "Incident",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "impact",
                                        "title": "Impact",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "Critical": "#ef4444",
                                                "Major": "#f97316",
                                                "Minor": "#f59e0b",
                                                "None": "#9ca3af"
                                            }
                                        }
                                    },
                                    {
                                        "field": "worstComponentStatus",
                                        "title": "Worst Component Status",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "Major outage": "#ef4444",
                                                "Partial outage": "#f97316",
                                                "Degraded performance": "#f59e0b",
                                                "Operational": "#22c55e"
                                            }
                                        }
                                    },
                                    {
                                        "field": "components",
                                        "title": "Components",
                                        "renderer": {
                                            "type": "tag-list",
                                            "separator": ","
                                        }
                                    },
                                    {
                                        "field": "startedAt",
                                        "title": "Started",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    },
                                    {
                                        "field": "link",
                                        "title": "Link",
                                        "renderer": {
                                            "type": "link"
                                        }
                                    }
                                ]
                            },
                            "style": {}
                        }
                    }
                }
            },
            {
                "i": "3639c21c-23a9-42f1-8984-16801531b2f0",
                "x": 2,
                "y": 6,
                "w": 2,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Upcoming Maintenance",
                    "description": "Maintenance windows that have not finished yet",
                    "timeframe": "none",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[maintenance]}}",
                        "name": "maintenance",
                        "pluginConfigId": "{{configId}}",
                        "filter": {
                            "multiOperation": "and",
                            "filters": [
                                {
                                    "column": "phase",
                                    "operation": "notequals",
                                    "value": "Completed"
                                }
                            ]
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "name",
                                        "title": "Maintenance",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "status",
                                        "title": "Status",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "scheduledFor",
                                        "title": "Scheduled Start",
                                        "renderer": {
                                            "type": "date"
                                        }
                                    },
                                    {
                                        "field": "durationMinutes",
                                        "title": "Planned Duration",
                                        "renderer": {
                                            "type": "number",
                                            "decimals": 0,
                                            "suffix": " min"
                                        },
                                        "align": "right"
                                    },
                                    {
                                        "field": "link",
                                        "title": "Link",
                                        "renderer": {
                                            "type": "link"
                                        }
                                    }
                                ]
                            },
                            "style": {}
                        }
                    }
                }
            }
        ]
    }
}
