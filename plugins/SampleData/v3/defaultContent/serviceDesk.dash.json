            {
                "i": "35d30824-de6a-4ff6-bb05-aa3fc0f6c436",
                "x": 0,
                "y": 2,
                "w": 2,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Tickets by Day and Hour",
                    "description": "When tickets are opened, by day and hour (UTC)",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[tickets]}}",
                        "name": "tickets",
                        "pluginConfigId": "{{configId}}",
                        "sql": "SELECT STRFTIME(\"d\", '%a %d %b') AS \"day\", \"h\" AS \"hour\", COUNT(*) AS \"tickets\" FROM (SELECT DATE_TRUNC('day', \"openedAt\") AS \"d\", STRFTIME(\"openedAt\", '%H:00') AS \"h\" FROM \"dataset\") GROUP BY \"d\", \"h\" ORDER BY \"d\", \"h\"",
                        "metadata": [
                            {
                                "name": "day",
                                "displayName": "Day"
                            },
                            {
                                "name": "hour",
                                "displayName": "Hour (UTC)"
                            },
                            {
                                "name": "tickets",
                                "displayName": "Tickets",
                                "shape": [
                                    "number",
                                    {
                                        "decimalPlaces": 0,
                                        "thousandsSeparator": true
                                    }
                                ]
                            },
                            {
                                "pattern": ".*"
                            }
                        ]
                    },
                    "scope": {
                        "scope": "{{scopes.[Customers]}}",
                        "workspace": "{{workspaceId}}"
                    },
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "heatmap",
                            "encoding": {
                                "x": {
                                    "field": "day",
                                    "type": "nominal",
                                    "title": "Day"
                                },
                                "y": {
                                    "field": "hour",
                                    "type": "nominal",
                                    "title": "Hour (UTC)"
                                },
                                "color": {
                                    "field": "tickets",
                                    "type": "quantitative",
                                    "title": "Tickets"
                                }
                            },
                            "style": {
                                "colorScheme": "squaredUpBlue",
                                "heatmapCellBorderWidth": 1
                            }
                        }
                    }
                }
            },
