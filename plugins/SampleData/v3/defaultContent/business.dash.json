                    "dataStream": {
                        "id": "{{dataStreams.[businessMetrics]}}",
                        "name": "businessMetrics",
                        "pluginConfigId": "{{configId}}",
                        "sql": "SELECT ROUND(100.0 * SUM(\"orders\") / NULLIF(SUM(\"visitors\"), 0), 2) AS \"conversionRatePercent\" FROM \"dataset\"",
