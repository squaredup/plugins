            {
                "i": "afd5ea56-402a-41ea-8a03-83dd80c569e8",
                "x": 0,
                "y": 13,
                "w": 4,
                "h": 5,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Budget Status by Service",
                    "description": "Month-to-date spend against budget for each service",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "thisMonth",
                    "dataStream": {
                        "id": "{{dataStreams.[cloudCost]}}",
                        "name": "cloudCost",
                        "pluginConfigId": "{{configId}}",
                        "sql": "SELECT \"service\", \"team\", SUM(\"costUsd\") AS \"costUsd\", SUM(\"budgetUsd\") AS \"budgetUsd\", ROUND(100.0 * SUM(\"costUsd\") / NULLIF(SUM(\"budgetUsd\"), 0), 1) AS \"budgetUsedPercent\", CASE WHEN SUM(\"costUsd\") > SUM(\"budgetUsd\") THEN 'error' WHEN SUM(\"costUsd\") > 0.95 * SUM(\"budgetUsd\") THEN 'warning' ELSE 'success' END AS \"state\" FROM \"dataset\" GROUP BY \"service\", \"team\" ORDER BY \"budgetUsedPercent\" DESC",
                        "metadata": [
                            {
                                "name": "service",
                                "displayName": "Service"
                            },
                            {
                                "name": "team",
                                "displayName": "Team"
                            },
                            {
                                "name": "costUsd",
                                "displayName": "Spend",
                                "shape": [
                                    "usd",
                                    {
                                        "decimalPlaces": 0
                                    }
                                ]
                            },
                            {
                                "name": "budgetUsd",
                                "displayName": "Budget",
                                "shape": [
                                    "usd",
                                    {
                                        "decimalPlaces": 0
                                    }
                                ]
                            },
                            {
                                "name": "budgetUsedPercent",
                                "displayName": "Budget used",
                                "shape": [
                                    "percent",
                                    {
                                        "decimalPlaces": 1
                                    }
                                ]
                            },
                            {
                                "name": "state",
                                "displayName": "State",
                                "shape": "state"
                            },
                            {
                                "pattern": ".*"
                            }
                        ]
                    },
                    "scope": {
                        "scope": "{{scopes.[Services]}}",
                        "workspace": "{{workspaceId}}"
                    },
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": [
                                    "service",
                                    "team",
                                    "costUsd",
                                    "budgetUsd",
                                    "budgetUsedPercent",
                                    "state"
                                ],
                                "hiddenColumns": []
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "service",
                                        "title": "Service",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "team",
                                        "title": "Team",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "costUsd",
                                        "title": "Spend",
                                        "align": "right",
                                        "renderer": {
                                            "type": "number",
                                            "decimals": 0,
                                            "prefix": "$"
                                        }
                                    },
                                    {
                                        "field": "budgetUsd",
                                        "title": "Budget",
                                        "align": "right",
                                        "renderer": {
                                            "type": "number",
                                            "decimals": 0,
                                            "prefix": "$"
                                        }
                                    },
                                    {
                                        "field": "budgetUsedPercent",
                                        "title": "Budget used",
                                        "renderer": {
                                            "type": "progress",
                                            "max": 100
                                        }
                                    },
                                    {
                                        "field": "state",
                                        "title": "State",
                                        "renderer": {
                                            "type": "status"
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableRowHighlight": {
                                    "field": "state",
                                    "colors": {
                                        "error": "rgba(214,57,57,0.15)",
                                        "warning": "rgba(245,159,0,0.15)"
                                    }
                                }
                            }
                        }
                    },
                    "monitor": {
                        "_type": "simple",
                        "tileRollsUp": true,
                        "monitorType": "state",
                        "column": "state",
                        "aggregation": "top",
                        "condition": {
                            "columns": [
                                "state"
                            ]
                        },
                        "frequency": 180
                    }
                }
            }
        ]
    }
