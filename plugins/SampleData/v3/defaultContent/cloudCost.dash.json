                        "sql": "SELECT COUNT(*) AS \"overBudget\" FROM (SELECT \"service\", SUM(\"costUsd\") AS \"cost\", SUM(\"budgetUsd\") AS \"budget\" FROM \"dataset\" GROUP BY \"service\") WHERE \"cost\" > \"budget\"",
