                                "stateColumn": "state",
                                "linkColumn": "none",
                                "columns": 4
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "statusGrid",
                            "encoding": {
                                "label": {
                                    "field": "host",
                                    "type": "nominal",
                                    "title": "Host"
                                },
                                "status": {
                                    "field": "state",
                                    "type": "nominal",
                                    "title": "State"
                                },
                                "group": {
                                    "field": "region",
