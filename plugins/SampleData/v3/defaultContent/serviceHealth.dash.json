                                    "title": "Region"
                                },
                                "value": {
                                    "field": "diskPercent",
                                    "type": "quantitative",
                                    "title": "Disk used"
                                }
                            },
                            "style": {
                                "statusGridColumnsPerRow": 8
                            }
                        }
                    },
                    "monitor": {
                        "_type": "simple",
                        "tileRollsUp": true,
                        "monitorType": "state",
                        "column": "state",
                        "aggregation": "top",
                        "condition": {
                            "columns": [
                                "state"
                            ]
                        },
                        "frequency": 15
                    }
                }
            }
        ]
    }
}
