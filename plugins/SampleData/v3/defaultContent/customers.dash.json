{
    "name": "Customers & SLAs",
    "schemaVersion": "1.5",
    "timeframe": "last7days",
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "ce6f6b96-8982-4ba1-8a4f-f1ae63ca8979",
                "x": 0,
                "y": 0,
                "w": 4,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Customer Summary",
                    "description": "",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[customerSla]}}",
                        "name": "customerSla",
                        "pluginConfigId": "{{configId}}",
                        "group": {
                            "by": [],
                            "aggregate": [
                                {
                                    "type": "count"
                                },
                                {
                                    "type": "sum",
                                    "names": [
                                        "mrrUsd"
                                    ]
                                },
                                {
                                    "type": "mean",
                                    "names": [
                                        "csat"
                                    ]
                                },
                                {
                                    "type": "sum",
                                    "names": [
                                        "openTickets"
                                    ]
                                }
                            ]
                        }
                    },
                    "scope": {
                        "scope": "{{scopes.[Customers]}}",
                        "workspace": "{{workspaceId}}"
                    },
                    "visualisation": {
                        "type": "data-stream-scalar",
                        "config": {
                            "data-stream-scalar": {
                                "value": "count",
                                "comparisonColumn": "none",
                                "label": "Customers"
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    {
                                        "field": "count",
                                        "type": "quantitative",
                                        "title": "Customers"
                                    },
                                    {
                                        "field": "mrrUsd_sum",
                                        "type": "quantitative",
                                        "title": "MRR from these customers"
                                    },
                                    {
                                        "field": "csat_mean",
                                        "type": "quantitative",
                                        "title": "Average CSAT (out of 5)"
                                    },
                                    {
                                        "field": "openTickets_sum",
                                        "type": "quantitative",
                                        "title": "Open tickets"
                                    }
                                ]
                            },
                            "style": {
                                "scalarColumns": 4
                            }
                        }
                    }
                }
            },
            {
                "i": "5df4d82b-ed2e-4d50-8435-335be8fafe35",
                "x": 0,
                "y": 2,
                "w": 2,
                "h": 5,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Customer Locations",
                    "description": "Customer locations, coloured by SLA state",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[customerSla]}}",
                        "name": "customerSla",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Customers]}}",
                        "workspace": "{{workspaceId}}"
                    },
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "geoMap",
                            "encoding": {
                                "latitude": {
                                    "field": "latitude",
                                    "type": "quantitative"
                                },
                                "longitude": {
                                    "field": "longitude",
                                    "type": "quantitative"
                                },
                                "label": {
                                    "field": "customer",
                                    "type": "nominal",
                                    "title": "Customer"
                                },
                                "status": {
                                    "field": "state",
                                    "type": "nominal",
                                    "title": "SLA state"
                                },
                                "details": [
                                    {
                                        "field": "plan",
                                        "type": "nominal",
                                        "title": "Plan"
                                    },
                                    {
                                        "field": "city",
                                        "type": "nominal",
                                        "title": "City"
                                    },
                                    {
                                        "field": "mrrUsd",
                                        "type": "quantitative",
                                        "title": "MRR"
                                    },
                                    {
                                        "field": "slaActualPercent",
                                        "type": "quantitative",
                                        "title": "SLA (30 days)"
                                    },
                                    {
                                        "field": "openTickets",
                                        "type": "quantitative",
                                        "title": "Open tickets"
                                    }
                                ]
                            },
                            "style": {
                                "geoMapBase": "world",
                                "geoMapSymbol": "pin",
                                "geoMapPointSize": 16,
                                "geoMapZoomControls": true,
                                "geoMapWheelZoom": false,
                                "showLabels": false
                            }
                        }
                    }
                }
            },
            {
                "i": "86c59788-a06f-4376-836f-6a3283c24524",
                "x": 2,
                "y": 2,
                "w": 2,
                "h": 5,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Customer SLA Health",
                    "description": "SLA state of each customer: red is below target, amber is close to target or low CSAT",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[customerSla]}}",
                        "name": "customerSla",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Customers]}}",
                        "workspace": "{{workspaceId}}"
                    },
                    "visualisation": {
                        "type": "data-stream-blocks",
                        "config": {
                            "data-stream-blocks": {
                                "labelColumn": "customer",
                                "stateColumn": "state",
                                "linkColumn": "none",
                                "columns": 4
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "statusGrid",
                            "encoding": {
                                "label": {
                                    "field": "customer",
                                    "type": "nominal",
                                    "title": "Customer"
                                },
                                "status": {
                                    "field": "state",
                                    "type": "nominal",
                                    "title": "SLA state"
                                },
                                "group": {
                                    "field": "plan",
                                    "type": "nominal",
                                    "title": "Plan"
                                }
                            },
                            "style": {
                                "statusGridColumnsPerRow": 4,
                                "statusGridSecondaryTemplate": "SLA {{slaActualPercent}}"
                            }
                        }
                    },
                    "monitor": {
                        "_type": "simple",
                        "tileRollsUp": true,
                        "monitorType": "state",
                        "column": "state",
                        "aggregation": "top",
                        "condition": {
                            "columns": [
                                "state"
                            ]
                        },
                        "frequency": 15
                    }
                }
            },
            {
                "i": "258a2040-ce31-422d-bf63-7ecfe626c6b6",
                "x": 0,
                "y": 7,
                "w": 2,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Customer Satisfaction",
                    "description": "CSAT score out of 5 for each customer",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[customerSla]}}",
                        "name": "customerSla",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [
                                [
                                    "csat",
                                    "asc"
                                ]
                            ]
                        }
                    },
                    "scope": {
                        "scope": "{{scopes.[Customers]}}",
                        "workspace": "{{workspaceId}}"
                    },
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "ringGrid",
                            "encoding": {
                                "value": {
                                    "field": "csat",
                                    "type": "quantitative",
                                    "title": "CSAT"
                                },
                                "label": {
                                    "field": "customer",
                                    "type": "nominal",
                                    "title": "Customer"
                                }
                            },
                            "style": {
                                "ringGridMax": 5,
                                "ringGridColumnsPerRow": 5,
                                "ringGridThresholds": [
                                    {
                                        "to": 0.8,
                                        "color": "#d63939"
                                    },
                                    {
                                        "to": 0.88,
                                        "color": "#f59f00"
                                    },
                                    {
                                        "to": 1,
                                        "color": "#2fb344"
                                    }
                                ]
                            }
                        }
                    }
                }
            },
            {
                "i": "7481f385-a1e5-4ca7-9486-7b2a03af134f",
                "x": 2,
                "y": 7,
                "w": 2,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "MRR vs Satisfaction",
                    "description": "Each bubble is a customer, sized by seats",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[customerSla]}}",
                        "name": "customerSla",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Customers]}}",
                        "workspace": "{{workspaceId}}"
                    },
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scatter",
                            "encoding": {
                                "x": {
                                    "field": "csat",
                                    "type": "quantitative",
                                    "title": "CSAT"
                                },
                                "y": {
                                    "field": "mrrUsd",
                                    "type": "quantitative",
                                    "title": "MRR"
                                },
                                "size": {
                                    "field": "seats",
                                    "type": "quantitative",
                                    "title": "Seats"
                                },
                                "series": {
                                    "field": "plan",
                                    "type": "nominal",
                                    "title": "Plan"
                                }
                            },
                            "style": {
                                "legendPosition": "bottom",
                                "cartesianShowXAxisTitle": true,
                                "cartesianShowYAxisTitle": true,
                                "cartesianTooltipTemplate": "{{customer}}: CSAT {{csat}}, MRR {{mrrUsd}}"
                            }
                        }
                    }
                }
            },
            {
                "i": "ef8aabfd-b943-4903-9807-bc35d750a65c",
                "x": 0,
                "y": 11,
                "w": 4,
                "h": 5,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Customer Accounts",
                    "description": "",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[customerSla]}}",
                        "name": "customerSla",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Customers]}}",
                        "workspace": "{{workspaceId}}"
                    },
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": [
                                    "customer",
                                    "plan",
                                    "city",
                                    "mrrUsd",
                                    "seats",
                                    "slaTargetPercent",
                                    "slaActualPercent",
                                    "openTickets",
                                    "csat",
                                    "renewalDate",
                                    "state"
                                ],
                                "hiddenColumns": [
                                    "customerId",
                                    "country",
                                    "latitude",
                                    "longitude"
                                ]
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "customer",
                                        "title": "Customer",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "plan",
                                        "title": "Plan",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "Enterprise": "#7048e8",
                                                "Business": "#206bc4",
                                                "Starter": "#9ba3af"
                                            }
                                        }
                                    },
                                    {
                                        "field": "city",
                                        "title": "City",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "mrrUsd",
                                        "title": "MRR",
                                        "renderer": {
                                            "type": "bar",
                                            "color": "#206bc4"
                                        }
                                    },
                                    {
                                        "field": "seats",
                                        "title": "Seats",
                                        "align": "right",
                                        "renderer": {
                                            "type": "number"
                                        }
                                    },
                                    {
                                        "field": "slaTargetPercent",
                                        "title": "SLA target",
                                        "align": "right",
                                        "renderer": {
                                            "type": "number",
                                            "decimals": 2,
                                            "suffix": "%"
                                        }
                                    },
                                    {
                                        "field": "slaActualPercent",
                                        "title": "SLA (30 days)",
                                        "align": "right",
                                        "renderer": {
                                            "type": "number",
                                            "decimals": 3,
                                            "suffix": "%"
                                        }
                                    },
                                    {
                                        "field": "openTickets",
                                        "title": "Open tickets",
                                        "align": "right",
                                        "renderer": {
                                            "type": "number"
                                        }
                                    },
                                    {
                                        "field": "csat",
                                        "title": "CSAT",
                                        "align": "right",
                                        "renderer": {
                                            "type": "number",
                                            "decimals": 1,
                                            "thresholds": [
                                                {
                                                    "to": 4.0,
                                                    "color": "#d63939"
                                                },
                                                {
                                                    "to": 4.4,
                                                    "color": "#f59f00"
                                                },
                                                {
                                                    "to": 5,
                                                    "color": "#2fb344"
                                                }
                                            ]
                                        }
                                    },
                                    {
                                        "field": "renewalDate",
                                        "title": "Renewal",
                                        "renderer": {
                                            "type": "date"
                                        }
                                    },
                                    {
                                        "field": "state",
                                        "title": "SLA state",
                                        "renderer": {
                                            "type": "status"
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableRowHighlight": {
                                    "field": "state",
                                    "colors": {
                                        "error": "rgba(214,57,57,0.15)",
                                        "warning": "rgba(245,159,0,0.15)"
                                    }
                                },
                                "richTableSort": {
                                    "field": "mrrUsd",
                                    "direction": "desc"
                                }
                            }
                        }
                    }
                }
            }
        ]
    }
}
