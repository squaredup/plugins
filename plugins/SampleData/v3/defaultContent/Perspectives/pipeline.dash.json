                "config": {
                    "_type": "tile/data-stream",
                    "title": "Deployment Log",
                    "description": "",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[deployments]}}",
                        "name": "deployments",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [
                                [
                                    "timestamp",
                                    "desc"
                                ]
