            {
                "i": "7ffe4a1d-3acb-4f05-a8d7-0fc13640bedc",
                "x": 2,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Change Failure Rate",
                    "description": "",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[deployments]}}",
                        "name": "deployments",
                        "pluginConfigId": "{{configId}}",
                        "sql": "SELECT ROUND(100.0 * SUM(CASE WHEN \"changeFailure\" THEN 1 ELSE 0 END) / NULLIF(COUNT(*), 0), 1) AS \"changeFailureRate\" FROM \"dataset\"",
                        "metadata": [
                            {
                                "name": "changeFailureRate",
                                "displayName": "Change failure rate",
                                "shape": [
                                    "percent",
                                    {
                                        "decimalPlaces": 1
                                    }
                                ]
                            },
                            {
                                "pattern": ".*"
                            }
                        ]
                    },
                    "scope": {
                        "scope": "{{scopes.[Pipelines]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Pipeline]}}"
                    },
                    "variables": [
                        "{{variables.[Pipeline]}}"
                    ],
                    "visualisation": {
                        "type": "data-stream-scalar",
                        "config": {
                            "data-stream-scalar": {
                                "value": "changeFailureRate",
                                "comparisonColumn": "none",
                                "label": "Deployments that caused a failure"
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    {
                                        "field": "changeFailureRate",
                                        "type": "quantitative",
                                        "title": "Deployments that caused a failure"
                                    }
                                ]
                            }
                        }
                    }
                }
            },
