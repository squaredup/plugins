                    "scope": {
                        "scope": "{{scopes.[Pipelines]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Pipeline]}}"
                    },
                    "variables": [
                        "{{variables.[Pipeline]}}"
                    ],
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": [
                                    "timestamp",
                                    "version",
                                    "status",
                                    "changeFailure",
                                    "state",
                                    "durationMinutes",
                                    "leadTimeHours",
                                    "timeToRestoreMinutes"
                                ],
                                "hiddenColumns": [
                                    "deploymentId",
                                    "pipelineId",
                                    "pipeline",
                                    "service",
                                    "team",
                                    "tool"
                                ]
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "timestamp",
                                        "title": "Finished",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    },
                                    {
                                        "field": "version",
                                        "title": "Version",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "status",
                                        "title": "Status",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "Succeeded": "#2fb344",
                                                "Failed": "#d63939"
                                            }
                                        }
                                    },
                                    {
                                        "field": "changeFailure",
                                        "title": "Caused a failure",
                                        "renderer": {
                                            "type": "boolean",
                                            "trueLabel": "Yes",
                                            "falseLabel": "No",
                                            "trueColor": "#d63939",
                                            "falseColor": "#9ba3af"
                                        }
                                    },
                                    {
                                        "field": "state",
                                        "title": "State",
                                        "renderer": {
                                            "type": "status"
                                        }
                                    },
                                    {
                                        "field": "durationMinutes",
                                        "title": "Duration",
                                        "align": "right",
                                        "renderer": {
                                            "type": "number",
                                            "decimals": 1,
                                            "suffix": " min"
                                        }
                                    },
                                    {
                                        "field": "leadTimeHours",
                                        "title": "Lead time",
                                        "align": "right",
                                        "renderer": {
                                            "type": "number",
                                            "decimals": 1,
                                            "suffix": " h"
                                        }
                                    },
                                    {
                                        "field": "timeToRestoreMinutes",
                                        "title": "Time to restore",
                                        "align": "right",
                                        "renderer": {
                                            "type": "number",
                                            "decimals": 0,
                                            "suffix": " min"
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableRowHighlight": {
                                    "field": "state",
                                    "colors": {
                                        "error": "rgba(214,57,57,0.15)",
                                        "warning": "rgba(245,159,0,0.15)"
                                    }
                                },
                                "richTableSort": {
                                    "field": "timestamp",
                                    "direction": "desc"
                                }
                            }
                        }
                    }
                }
            }
        ]
