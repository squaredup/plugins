                "w": 2,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Deployments per Day",
                    "description": "",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[deployments]}}",
                        "name": "deployments",
                        "pluginConfigId": "{{configId}}",
                        "group": {
                            "by": [
                                [
                                    "timestamp",
                                    "byDay"
                                ],
                                [
                                    "status",
                                    "uniqueValues"
                                ]
                            ],
                            "aggregate": [
                                {
                                    "type": "count"
                                }
                            ]
                        },
                        "sort": {
                            "by": [
                                [
                                    "timestamp_byDay",
                                    "asc"
                                ]
                            ]
                        }
                    },
                    "scope": {
                        "scope": "{{scopes.[Pipelines]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Pipeline]}}"
                    },
                    "variables": [
                        "{{variables.[Pipeline]}}"
                    ],
                    "visualisation": {
                        "type": "data-stream-bar-chart",
                        "config": {
                            "data-stream-bar-chart": {
                                "xAxisData": "timestamp_byDay",
                                "yAxisData": [
                                    "count"
                                ],
                                "xAxisGroup": "status_uniqueValues",
                                "xAxisLabel": "",
                                "yAxisLabel": "",
                                "showXAxisLabel": false,
                                "showYAxisLabel": false,
                                "showLegend": true,
                                "legendPosition": "bottom",
                                "showGrid": true,
                                "horizontalLayout": "vertical",
                                "displayMode": "stacked",
                                "showTotals": false,
                                "showValue": false,
                                "grouping": true,
                                "range": {
                                    "type": "auto"
                                }
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "timestamp_byDay",
                                    "type": "temporal",
                                    "title": "Day"
                                },
                                "y": {
                                    "field": "count",
                                    "type": "quantitative",
                                    "title": "Deployments"
                                },
                                "series": {
                                    "field": "status_uniqueValues",
                                    "type": "nominal",
                                    "title": "Status"
                                }
                            },
                            "style": {
                                "cartesianStack": "on",
                                "legendPosition": "bottom",
                                "mappedColors": {
                                    "Succeeded": "#2fb344",
                                    "Failed": "#d63939"
                                }
                            }
                        }
                    }
                }
