                        "config": {
                            "data-stream-bar-chart": {
                                "xAxisData": "date_byDay",
                                "yAxisData": [
                                    "costUsd_sum"
                                ],
                                "xAxisGroup": "category_uniqueValues",
                                "xAxisLabel": "",
                                "yAxisLabel": "",
                                "showXAxisLabel": false,
                                "showYAxisLabel": false,
