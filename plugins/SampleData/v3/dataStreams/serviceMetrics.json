{
    "name": "serviceMetrics",
    "displayName": "Service Metrics",
    "description": "Latency, throughput, error rate and health over time for each service",
    "tags": [
        "Performance",
        "Health"
    ],
    "baseDataSourceName": "httpRequestScoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "model.json",
        "postRequestScript": "serviceMetrics.js"
    },
    "matches": {
        "sourceType": {
            "type": "oneOf",
            "values": [
                "Service"
            ]
        }
    },
    "metadata": [
        {
            "name": "timestamp",
            "displayName": "Time",
            "shape": "date",
            "role": "timestamp"
        },
        {
            "name": "serviceId",
            "visible": false
        },
        {
            "name": "service",
            "displayName": "Service",
            "role": "label"
        },
        {
            "name": "latencyP95Ms",
            "displayName": "Latency p95",
            "shape": "milliseconds"
        },
        {
            "name": "requestsPerMin",
            "displayName": "Requests/min",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0,
                    "thousandsSeparator": true
                }
            ]
        },
        {
            "name": "errorRatePercent",
            "displayName": "Error rate",
            "shape": [
                "percent",
                {
                    "decimalPlaces": 2
                }
            ]
        },
        {
            "name": "state",
            "displayName": "State",
            "shape": "state"
        },
        {
            "sourceId": "serviceId",
            "sourceType": "Service",
            "name": "service"
        }
    ],
    "timeframes": true
}
