{
    "name": "hostPerformance",
    "displayName": "Host Performance",
    "description": "CPU, memory, disk and network usage over time for each host",
    "tags": [
        "Infrastructure",
        "Performance"
    ],
    "baseDataSourceName": "httpRequestScoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "model.json",
        "postRequestScript": "hostPerformance.js"
    },
    "matches": {
        "sourceType": {
            "type": "oneOf",
            "values": [
                "Host"
            ]
        }
    },
    "metadata": [
        {
            "name": "timestamp",
            "displayName": "Time",
            "shape": "date",
            "role": "timestamp"
        },
        {
            "name": "hostId",
            "visible": false
        },
        {
            "name": "host",
            "displayName": "Host",
            "role": "label"
        },
        {
            "name": "service",
            "displayName": "Service"
        },
        {
            "name": "cpuPercent",
            "displayName": "CPU",
            "shape": [
                "percent",
                {
                    "decimalPlaces": 1
                }
            ]
        },
        {
            "name": "memoryPercent",
            "displayName": "Memory",
            "shape": [
                "percent",
                {
                    "decimalPlaces": 1
                }
            ]
        },
        {
            "name": "diskPercent",
            "displayName": "Disk used",
            "shape": [
                "percent",
                {
                    "decimalPlaces": 1
                }
            ]
        },
        {
            "name": "networkMbps",
            "displayName": "Network",
            "shape": "megabitspersecond"
        },
        {
            "sourceId": "hostId",
            "sourceType": "Host",
            "name": "host"
        }
    ],
    "timeframes": true
}
