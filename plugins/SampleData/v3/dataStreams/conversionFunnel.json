{
    "name": "conversionFunnel",
    "displayName": "Conversion Funnel",
    "description": "Visitor to paid-customer conversion stages for the selected timeframe",
    "tags": [
        "Business",
        "Analytics"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "model.json",
        "postRequestScript": "conversionFunnel.js"
    },
    "matches": "none",
    "defaultShaping": {
        "sort": {
            "by": [
                [
                    "order",
                    "asc"
                ]
            ]
        }
    },
    "metadata": [
        {
            "name": "order",
            "displayName": "Order",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0,
                    "thousandsSeparator": true
                }
            ],
            "visible": false
        },
        {
            "name": "stage",
            "displayName": "Stage",
            "role": "label"
        },
        {
            "name": "count",
            "displayName": "Count",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0,
                    "thousandsSeparator": true
                }
            ]
        }
    ],
    "timeframes": true
}
