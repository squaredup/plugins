{
    "name": "customerSla",
    "displayName": "Customer SLAs",
    "description": "Current SLA attainment, satisfaction and account details for each customer",
    "tags": [
        "Customers",
        "SLA"
    ],
    "baseDataSourceName": "httpRequestScoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "model.json",
        "postRequestScript": "customerSla.js"
    },
    "matches": {
        "sourceType": {
            "type": "oneOf",
            "values": [
                "Customer"
            ]
        }
    },
    "defaultShaping": {
        "sort": {
            "by": [
                [
                    "customer",
                    "asc"
                ]
            ]
        }
    },
    "metadata": [
        {
            "name": "customerId",
            "visible": false
        },
        {
            "name": "customer",
            "displayName": "Customer",
            "role": "label"
        },
        {
            "name": "state",
            "displayName": "State",
            "shape": "state"
        },
        {
            "name": "plan",
            "displayName": "Plan"
        },
        {
            "name": "city",
            "displayName": "City"
        },
        {
            "name": "country",
            "displayName": "Country"
        },
        {
            "name": "latitude",
            "displayName": "Latitude",
            "shape": [
                "number",
                {
                    "decimalPlaces": 4,
                    "thousandsSeparator": true
                }
            ],
            "visible": false
        },
        {
            "name": "longitude",
            "displayName": "Longitude",
            "shape": [
                "number",
                {
                    "decimalPlaces": 4,
                    "thousandsSeparator": true
                }
            ],
            "visible": false
        },
        {
            "name": "mrrUsd",
            "displayName": "MRR",
            "shape": [
                "usd",
                {
                    "decimalPlaces": 0
                }
            ]
        },
        {
            "name": "seats",
            "displayName": "Seats",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0,
                    "thousandsSeparator": true
                }
            ]
        },
        {
            "name": "slaTargetPercent",
            "displayName": "SLA target",
            "shape": [
                "percent",
                {
                    "decimalPlaces": 2
                }
            ]
        },
        {
            "name": "slaActualPercent",
            "displayName": "SLA (30 days)",
            "shape": [
                "percent",
                {
                    "decimalPlaces": 2
                }
            ]
        },
        {
            "name": "openTickets",
            "displayName": "Open tickets",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0,
                    "thousandsSeparator": true
                }
            ]
        },
        {
            "name": "csat",
            "displayName": "CSAT",
            "shape": [
                "number",
                {
                    "decimalPlaces": 1,
                    "thousandsSeparator": true
                }
            ]
        },
        {
            "name": "renewalDate",
            "displayName": "Renewal date",
            "shape": [
                "date",
                {
                    "format": "dd MMM yyyy"
                }
            ]
        },
        {
            "sourceId": "customerId",
            "sourceType": "Customer",
            "name": "customer"
        }
    ],
    "timeframes": false
}
