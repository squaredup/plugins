{
    "name": "businessMetrics",
    "displayName": "Business Metrics",
    "description": "Visitors, signups, orders, order value and recurring revenue over time",
    "tags": [
        "Business",
        "Analytics"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "model.json",
        "postRequestScript": "businessMetrics.js"
    },
    "matches": "none",
    "metadata": [
        {
            "name": "timestamp",
            "displayName": "Time",
            "shape": "date",
            "role": "timestamp"
        },
        {
            "name": "visitors",
            "displayName": "Visitors",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0,
                    "thousandsSeparator": true
                }
            ]
        },
        {
            "name": "signups",
            "displayName": "Signups",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0,
                    "thousandsSeparator": true
                }
            ]
        },
        {
            "name": "orders",
            "displayName": "Orders",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0,
                    "thousandsSeparator": true
                }
            ]
        },
        {
            "name": "orderValueUsd",
            "displayName": "Order value",
            "shape": [
                "usd",
                {
                    "decimalPlaces": 2
                }
            ]
        },
        {
            "name": "conversionRatePercent",
            "displayName": "Conversion rate",
            "shape": [
                "percent",
                {
                    "decimalPlaces": 2
                }
            ]
        },
        {
            "name": "mrrUsd",
            "displayName": "MRR",
            "shape": [
                "usd",
                {
                    "decimalPlaces": 0
                }
            ]
        }
    ],
    "timeframes": true
}
