{
    "name": "tickets",
    "displayName": "Tickets",
    "description": "Service desk tickets with priority, status and SLA outcome",
    "tags": [
        "Service Management",
        "Tickets"
    ],
    "baseDataSourceName": "httpRequestScoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "model.json",
        "postRequestScript": "tickets.js"
    },
    "matches": {
        "sourceType": {
            "type": "oneOf",
            "values": [
                "Customer",
                "Service"
            ]
        }
    },
    "metadata": [
        {
            "name": "ticketId",
            "displayName": "Ticket"
        },
        {
            "name": "openedAt",
            "displayName": "Opened",
            "shape": "date",
            "role": "timestamp"
        },
        {
            "name": "customerId",
            "visible": false
        },
        {
            "name": "customer",
            "displayName": "Customer",
            "role": "label"
        },
        {
            "name": "plan",
            "displayName": "Plan"
        },
        {
            "name": "priority",
            "displayName": "Priority"
        },
        {
            "name": "category",
            "displayName": "Category"
        },
        {
            "name": "service",
            "displayName": "Service"
        },
        {
            "name": "team",
            "displayName": "Assigned team"
        },
        {
            "name": "status",
            "displayName": "Status"
        },
        {
            "name": "resolutionMinutes",
            "displayName": "Resolution time",
            "shape": [
                "minutes",
                {
                    "formatDuration": true
                }
            ]
        },
        {
            "name": "slaTargetMinutes",
            "displayName": "SLA target",
            "shape": [
                "minutes",
                {
                    "formatDuration": true
                }
            ]
        },
        {
            "name": "slaBreached",
            "displayName": "SLA breached",
            "shape": "boolean"
        },
        {
            "name": "slaState",
            "displayName": "SLA",
            "shape": "state"
        },
        {
            "sourceId": "customerId",
            "sourceType": "Customer",
            "name": "customer"
        }
    ],
    "timeframes": true
}
