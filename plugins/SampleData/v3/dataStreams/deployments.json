{
    "name": "deployments",
    "displayName": "Deployments",
    "description": "Production deployments with outcome, duration and lead time (DORA metrics)",
    "tags": [
        "DevOps",
        "CI/CD"
    ],
    "baseDataSourceName": "httpRequestScoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "model.json",
        "postRequestScript": "deployments.js"
    },
    "matches": {
        "sourceType": {
            "type": "oneOf",
            "values": [
                "Pipeline"
            ]
        }
    },
    "metadata": [
        {
            "name": "timestamp",
            "displayName": "Finished",
            "shape": "date",
            "role": "timestamp"
        },
        {
            "name": "deploymentId",
            "displayName": "Deployment ID",
            "visible": false
        },
        {
            "name": "pipelineId",
            "visible": false
        },
        {
            "name": "pipeline",
            "displayName": "Pipeline",
            "role": "label"
        },
        {
            "name": "service",
            "displayName": "Service"
        },
        {
            "name": "team",
            "displayName": "Team"
        },
        {
            "name": "tool",
            "displayName": "CI/CD tool"
        },
        {
            "name": "version",
            "displayName": "Version"
        },
        {
            "name": "status",
            "displayName": "Status"
        },
        {
            "name": "state",
            "displayName": "State",
            "shape": "state"
        },
        {
            "name": "changeFailure",
            "displayName": "Caused a failure",
            "shape": "boolean"
        },
        {
            "name": "durationMinutes",
            "displayName": "Duration",
            "shape": [
                "minutes",
                {
                    "formatDuration": true
                }
            ]
        },
        {
            "name": "leadTimeHours",
            "displayName": "Lead time (hours)",
            "shape": [
                "number",
                {
                    "decimalPlaces": 1,
                    "thousandsSeparator": true
                }
            ]
        },
        {
            "name": "timeToRestoreMinutes",
            "displayName": "Time to restore",
            "shape": [
                "minutes",
                {
                    "formatDuration": true
                }
            ]
        },
        {
            "sourceId": "pipelineId",
            "sourceType": "Pipeline",
            "name": "pipeline"
        }
    ],
    "timeframes": true
}
