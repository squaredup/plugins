{
    "name": "serviceDependencies",
    "displayName": "Service Dependencies",
    "description": "Request flow between services and the health of each downstream service",
    "tags": [
        "Topology"
    ],
    "baseDataSourceName": "httpRequestScoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "model.json",
        "postRequestScript": "serviceDependencies.js"
    },
    "matches": {
        "sourceType": {
            "type": "oneOf",
            "values": [
                "Service"
            ]
        }
    },
    "metadata": [
        {
            "name": "source",
            "displayName": "From"
        },
        {
            "name": "target",
            "displayName": "To"
        },
        {
            "name": "requestsPerMin",
            "displayName": "Requests/min",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0,
                    "thousandsSeparator": true
                }
            ]
        },
        {
            "name": "targetErrorRatePercent",
            "displayName": "Downstream error rate",
            "shape": [
                "percent",
                {
                    "decimalPlaces": 2
                }
            ]
        },
        {
            "name": "state",
            "displayName": "Downstream state",
            "shape": "state"
        }
    ],
    "timeframes": false
}
