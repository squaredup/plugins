{
    "name": "cloudCost",
    "displayName": "Cloud Cost",
    "description": "Daily cloud spend and budget by service and cost category",
    "tags": [
        "Cost",
        "FinOps"
    ],
    "baseDataSourceName": "httpRequestScoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "model.json",
        "postRequestScript": "cloudCost.js"
    },
    "matches": {
        "sourceType": {
            "type": "oneOf",
            "values": [
                "Service"
            ]
        }
    },
    "metadata": [
        {
            "name": "date",
            "displayName": "Date",
            "shape": [
                "date",
                {
                    "format": "dd MMM yyyy"
                }
            ],
            "role": "timestamp"
        },
        {
            "name": "serviceId",
            "visible": false
        },
        {
            "name": "service",
            "displayName": "Service",
            "role": "label"
        },
        {
            "name": "team",
            "displayName": "Team"
        },
        {
            "name": "provider",
            "displayName": "Cloud provider"
        },
        {
            "name": "category",
            "displayName": "Category"
        },
        {
            "name": "costUsd",
            "displayName": "Cost",
            "shape": [
                "usd",
                {
                    "decimalPlaces": 2
                }
            ]
        },
        {
            "name": "budgetUsd",
            "displayName": "Budget",
            "shape": [
                "usd",
                {
                    "decimalPlaces": 2
                }
            ]
        },
        {
            "sourceId": "serviceId",
            "sourceType": "Service",
            "name": "service"
        }
    ],
    "timeframes": [
        "last7days",
        "last30days",
        "thisMonth",
        "lastMonth",
        "thisQuarter",
        "lastQuarter"
    ]
}
