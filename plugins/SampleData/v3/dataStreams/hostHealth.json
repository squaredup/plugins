{
    "name": "hostHealth",
    "displayName": "Host Health",
    "description": "Current resource usage and health for each host",
    "tags": [
        "Infrastructure",
        "Health"
    ],
    "baseDataSourceName": "httpRequestScoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "model.json",
        "postRequestScript": "hostHealth.js"
    },
    "matches": {
        "sourceType": {
            "type": "oneOf",
            "values": [
                "Host",
                "Service"
            ]
        }
    },
    "defaultShaping": {
        "sort": {
            "by": [
                [
                    "host",
                    "asc"
                ]
            ]
        }
    },
    "metadata": [
        {
            "name": "hostId",
            "visible": false
        },
        {
            "name": "host",
            "displayName": "Host",
            "role": "label"
        },
        {
            "name": "state",
            "displayName": "State",
            "shape": "state"
        },
        {
            "name": "service",
            "displayName": "Service"
        },
        {
            "name": "region",
            "displayName": "Region"
        },
        {
            "name": "provider",
            "displayName": "Cloud provider"
        },
        {
            "name": "os",
            "displayName": "Operating system"
        },
        {
            "name": "size",
            "displayName": "Instance size"
        },
        {
            "name": "latitude",
            "displayName": "Latitude",
            "shape": [
                "number",
                {
                    "decimalPlaces": 4,
                    "thousandsSeparator": true
                }
            ],
            "visible": false
        },
        {
            "name": "longitude",
            "displayName": "Longitude",
            "shape": [
                "number",
                {
                    "decimalPlaces": 4,
                    "thousandsSeparator": true
                }
            ],
            "visible": false
        },
        {
            "name": "cpuPercent",
            "displayName": "CPU",
            "shape": [
                "percent",
                {
                    "decimalPlaces": 1
                }
            ]
        },
        {
            "name": "memoryPercent",
            "displayName": "Memory",
            "shape": [
                "percent",
                {
                    "decimalPlaces": 1
                }
            ]
        },
        {
            "name": "diskPercent",
            "displayName": "Disk used",
            "shape": [
                "percent",
                {
                    "decimalPlaces": 1
                }
            ]
        },
        {
            "name": "uptimeDays",
            "displayName": "Uptime (days)",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0,
                    "thousandsSeparator": true
                }
            ]
        },
        {
            "sourceId": "hostId",
            "sourceType": "Host",
            "name": "host"
        }
    ],
    "timeframes": false
}
