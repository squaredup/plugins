{
    "name": "serviceHealth",
    "displayName": "Service Health",
    "description": "Current health, golden signals and SLO error budget for each service",
    "tags": [
        "Health",
        "SLO"
    ],
    "baseDataSourceName": "httpRequestScoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "model.json",
        "postRequestScript": "serviceHealth.js"
    },
    "matches": {
        "sourceType": {
            "type": "oneOf",
            "values": [
                "Service"
            ]
        }
    },
    "defaultShaping": {
        "sort": {
            "by": [
                [
                    "service",
                    "asc"
                ]
            ]
        }
    },
    "metadata": [
        {
            "name": "serviceId",
            "visible": false
        },
        {
            "name": "service",
            "displayName": "Service",
            "role": "label"
        },
        {
            "name": "state",
            "displayName": "State",
            "shape": "state"
        },
        {
            "name": "team",
            "displayName": "Team"
        },
        {
            "name": "tier",
            "displayName": "Tier"
        },
        {
            "name": "region",
            "displayName": "Region"
        },
        {
            "name": "provider",
            "displayName": "Cloud provider"
        },
        {
            "name": "latitude",
            "displayName": "Latitude",
            "shape": [
                "number",
                {
                    "decimalPlaces": 4,
                    "thousandsSeparator": true
                }
            ],
            "visible": false
        },
        {
            "name": "longitude",
            "displayName": "Longitude",
            "shape": [
                "number",
                {
                    "decimalPlaces": 4,
                    "thousandsSeparator": true
                }
            ],
            "visible": false
        },
        {
            "name": "latencyP95Ms",
            "displayName": "Latency p95",
            "shape": "milliseconds"
        },
        {
            "name": "requestsPerMin",
            "displayName": "Requests/min",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0,
                    "thousandsSeparator": true
                }
            ]
        },
        {
            "name": "errorRatePercent",
            "displayName": "Error rate",
            "shape": [
                "percent",
                {
                    "decimalPlaces": 2
                }
            ]
        },
        {
            "name": "availabilityPercent",
            "displayName": "Availability (30 days)",
            "shape": [
                "percent",
                {
                    "decimalPlaces": 3
                }
            ]
        },
        {
            "name": "sloTargetPercent",
            "displayName": "SLO target",
            "shape": [
                "percent",
                {
                    "decimalPlaces": 2
                }
            ]
        },
        {
            "name": "errorBudgetRemainingPercent",
            "displayName": "Error budget remaining",
            "shape": [
                "percent",
                {
                    "decimalPlaces": 1
                }
            ]
        },
        {
            "name": "hosts",
            "displayName": "Hosts",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0,
                    "thousandsSeparator": true
                }
            ]
        },
        {
            "sourceId": "serviceId",
            "sourceType": "Service",
            "name": "service"
        }
    ],
    "timeframes": false
}
