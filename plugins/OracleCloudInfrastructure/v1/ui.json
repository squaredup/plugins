[
    {
        "type": "text",
        "name": "tenancyOcid",
        "label": "Tenancy OCID",
        "placeholder": "ocid1.tenancy.oc1..aaaaaaaa...",
        "validation": {
            "required": true,
            "pattern": {
                "value": "^\\s*ocid1\\.tenancy\\.[^\\s]+\\s*$",
