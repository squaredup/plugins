            }
        }
    },
    {
        "type": "text",
        "name": "userOcid",
        "label": "User OCID",
        "placeholder": "ocid1.user.oc1..aaaaaaaa...",
        "validation": {
            "required": true,
            "pattern": {
                "value": "^\\s*ocid1\\.user\\.[^\\s]+\\s*$",
                "message": "Enter a user OCID, starting ocid1.user."
            }
        }
    },
    {
        "type": "text",
        "name": "fingerprint",
        "label": "Fingerprint",
        "placeholder": "12:34:56:78:90:ab:cd:ef:12:34:56:78:90:ab:cd:ef",
        "help": "Shown next to the API key under **API keys** on the user's details page in the OCI Console.",
        "validation": {
            "required": true,
            "pattern": {
                "value": "^\\s*([0-9a-fA-F]{2}:){15}[0-9a-fA-F]{2}\\s*$",
                "message": "Enter the 16-pair fingerprint, e.g. 12:34:...:ef"
            }
        }
    },
    {
        "type": "password",
        "name": "privateKey",
        "label": "Private key",
        "allowEncryption": true,
        "placeholder": "-----BEGIN PRIVATE KEY----- ... -----END PRIVATE KEY-----",
        "help": "Paste the whole private key file downloaded when the API key was added, including the BEGIN and END lines. Passphrase-protected keys are not supported.",
        "validation": {
            "required": true
        }
    },
