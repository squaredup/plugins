{
    "steps": [
        {
            "name": "tenancy",
            "dataStream": {
                "name": "tenancy"
            },
            "timeframe": "none",
            "objectMapping": {
                "id": "id",
                "name": "name",
                "type": {
                    "value": "Compartment"
                },
                "properties": [
                    {
                        "description": "description"
                    },
                    {
                        "isRoot": "isRoot"
                    }
                ]
            }
        },
        {
            "name": "compartments",
            "dataStream": {
                "name": "compartments"
            },
            "timeframe": "none",
            "objectMapping": {
                "id": "id",
                "name": "name",
                "type": {
                    "value": "Compartment"
                },
                "properties": [
                    "description",
                    "lifecycleState",
                    "timeCreated",
                    {
                        "parentCompartmentId": "compartmentId"
                    }
                ]
            }
        },
        {
            "name": "regions",
            "dataStream": {
                "name": "regions"
            },
            "timeframe": "none",
            "objectMapping": {
                "id": "regionName",
                "name": "regionName",
                "type": {
                    "value": "Region"
                },
                "properties": [
                    "regionKey",
                    "status",
                    "isHomeRegion"
                ]
            }
        },
        {
            "name": "resources",
            "dataStream": {
                "name": "resources"
            },
            "scope": {
                "query": "g.V().has(\"sourceType\", \"Region\").has(\"status\", \"READY\")"
            },
            "timeframe": "none",
            "objectMapping": {
                "id": "identifier",
                "name": "displayName",
                "type": "sourceType",
                "properties": [
                    "resourceType",
                    "region",
                    "compartmentId",
                    "availabilityDomain",
                    "lifecycleState",
                    "timeCreated",
                    "freeformTags",
                    "definedTags"
                ]
            },
            "optional": true,
            "dependsOn": [
                "regions"
            ]
        }
    ]
}
