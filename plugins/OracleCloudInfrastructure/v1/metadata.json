{
    "name": "oracle-cloud-infra",
    "displayName": "Oracle Cloud Infrastructure",
    "version": "1.0.0",
    "author": {
        "name": "SquaredUp Labs",
        "type": "labs"
    },
    "description": "Monitor your Oracle Cloud Infrastructure tenancy, with resource inventory, performance metrics, alarms, cost and budgets.",
    "category": "Cloud Platforms",
    "type": "hybrid",
    "schemaVersion": "2.1",
    "importNotSupported": false,
    "restrictedToPlatforms": [],
    "keywords": [
        "oracle",
        "oci",
        "oracle cloud",
        "cloud",
        "compute",
        "autonomous database",
        "load balancer",
        "monitoring",
        "metrics",
        "alarms",
        "cost",
        "billing",
        "budgets"
    ],
    "objectTypes": [
        "Region",
        "Compartment",
        "Compute Instance",
        "Block Volume",
        "Boot Volume",
        "VCN",
        "Subnet",
        "Load Balancer",
        "Network Load Balancer",
        "Autonomous Database",
        "DB System",
        "Bucket",
        "Kubernetes Cluster",
        "File System",
        "Functions Application",
        "Function"
    ],
    "links": [
        {
            "category": "documentation",
            "url": "https://github.com/squaredup/plugins/blob/main/plugins/OracleCloudInfrastructure/v1/docs/README.md",
            "label": "Help adding this plugin"
        },
        {
            "category": "source",
            "url": "https://github.com/squaredup/plugins/tree/main/plugins/OracleCloudInfrastructure/v1",
            "label": "Repository"
        }
    ],
    "base": {
        "plugin": "WebAPI",
        "majorVersion": "1",
        "config": {
            "baseUrl": "https://identity.{{ [].concat(homeRegion).map((r) => (r && r.value) || r)[0].trim().toLowerCase() }}.oci.oraclecloud.com",
            "authMode": "none",
            "headers": [],
            "queryArgs": [],
            "showScripting": true,
            "scriptingVariables": [
                { "key": "tenancyOcid", "value": "{{ tenancyOcid.trim() }}" },
                { "key": "userOcid", "value": "{{ userOcid.trim() }}" },
                { "key": "fingerprint", "value": "{{ fingerprint.trim() }}" },
                { "key": "privateKey", "value": "{{ privateKey }}" },
                { "key": "homeRegion", "value": "{{ [].concat(homeRegion).map((r) => (r && r.value) || r)[0].trim().toLowerCase() }}" }
            ],
            "preRequestScript": "preRequest.js"
        }
    }
}
