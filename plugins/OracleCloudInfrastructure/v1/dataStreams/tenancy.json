{
    "name": "tenancy",
    "displayName": "Tenancy",
    "description": "Name, home region and root compartment of the configured tenancy",
    "tags": [
        "Account"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "visibility": {
        "type": "hidden"
    },
    "config": {
        "httpMethod": "get",
        "endpointPath": "identity/home/20160918/tenancies/{{dataSource.tenancyOcid.trim()}}",
        "paging": {
            "mode": "none"
        }
    },
    "metadata": [
        {
            "name": "id",
            "displayName": "OCID",
            "shape": "string",
            "role": "id"
        },
        {
            "name": "name",
            "displayName": "Name",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "description",
            "displayName": "Description",
            "shape": "string"
        },
        {
            "name": "homeRegionKey",
            "displayName": "Home region key",
            "shape": "string"
        },
        {
            "name": "isRoot",
            "displayName": "Root compartment",
            "computed": true,
            "valueExpression": "{{ true }}",
            "shape": "boolean"
        }
    ],
    "timeframes": false,
    "matches": "none"
}
