{
    "name": "compartments",
    "displayName": "Compartments",
    "description": "Active compartments in the tenancy, including nested compartments",
    "tags": [
        "Account"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "identity/home/20160918/compartments",
        "getArgs": [
            {
                "key": "compartmentId",
                "value": "{{dataSource.tenancyOcid.trim()}}"
            },
            {
                "key": "compartmentIdInSubtree",
                "value": "true"
            },
            {
                "key": "accessLevel",
                "value": "ACCESSIBLE"
            },
            {
                "key": "lifecycleState",
                "value": "ACTIVE"
            }
        ],
        "paging": {
            "mode": "token",
            "pageSize": {
                "realm": "queryArg",
                "path": "limit",
                "value": "1000"
            },
            "in": {
                "realm": "header",
                "path": "opc-next-page"
            },
            "out": {
                "realm": "queryArg",
                "path": "page"
            }
        }
    },
    "metadata": [
        {
            "name": "id",
            "displayName": "OCID",
            "shape": "string",
            "role": "id",
            "visible": false
        },
        {
            "name": "name",
            "displayName": "Name",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "description",
            "displayName": "Description",
            "shape": "string"
        },
        {
            "name": "compartmentId",
            "displayName": "Parent compartment OCID",
            "shape": "string",
            "visible": false
        },
        {
            "name": "parentCompartment",
            "displayName": "Parent compartment",
            "sourceId": "compartmentId",
            "sourceType": "Compartment",
            "objectPropertyPath": "name"
        },
        {
            "name": "lifecycleState",
            "displayName": "State",
            "shape": [
                "state",
                {
                    "map": {
                        "success": [
                            "ACTIVE"
                        ],
                        "warning": [
                            "CREATING",
                            "DELETING"
                        ],
                        "error": [
                            "DELETED"
                        ]
                    }
                }
            ]
        },
        {
            "name": "timeCreated",
            "displayName": "Created",
            "shape": "date"
        }
    ],
    "timeframes": false,
    "matches": "none"
}
