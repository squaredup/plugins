{
    "name": "instanceDetails",
    "displayName": "Instance Details",
    "description": "Live configuration and state of a compute instance (shape, OCPUs, memory, placement and image)",
    "tags": [
        "Infrastructure"
    ],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "iaas/{{object.region}}/20160918/instances/{{object.rawId}}",
        "paging": {
            "mode": "none"
        },
        "expandInnerObjects": true
    },
    "matches": {
        "sourceType": {
            "type": "oneOf",
            "values": [
                "Compute Instance"
            ]
        }
    },
    "metadata": [
        {
            "name": "id",
            "displayName": "OCID",
            "shape": "string",
            "role": "id",
            "visible": false
        },
        {
            "name": "displayName",
            "displayName": "Name",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "lifecycleState",
            "displayName": "State",
            "shape": [
                "state",
                {
                    "map": {
                        "success": [
                            "RUNNING"
                        ],
                        "warning": [
                            "STOPPED",
                            "STOPPING",
                            "STARTING",
                            "PROVISIONING",
                            "CREATING_IMAGE",
                            "MOVING",
                            "TERMINATING"
                        ],
                        "error": [
                            "TERMINATED"
                        ]
                    }
                }
            ]
        },
        {
            "name": "shape",
            "displayName": "Shape",
            "shape": "string"
        },
        {
            "name": "shapeConfig.ocpus",
            "displayName": "OCPUs",
            "shape": "number"
        },
        {
            "name": "shapeConfig.memoryInGBs",
            "displayName": "Memory",
            "shape": "gigabytes"
        },
        {
            "name": "shapeConfig.processorDescription",
            "displayName": "Processor",
            "shape": "string"
        },
        {
            "name": "shapeConfig.networkingBandwidthInGbps",
            "displayName": "Network bandwidth (Gbps)",
            "shape": "number"
        },
        {
            "name": "region",
            "displayName": "Region",
            "shape": "string"
        },
        {
            "name": "availabilityDomain",
            "displayName": "Availability domain",
            "shape": "string"
        },
        {
            "name": "faultDomain",
            "displayName": "Fault domain",
            "shape": "string"
        },
        {
            "name": "compartmentId",
            "displayName": "Compartment OCID",
            "shape": "string",
            "visible": false
        },
        {
            "name": "compartment",
            "displayName": "Compartment",
            "sourceId": "compartmentId",
            "sourceType": "Compartment",
            "objectPropertyPath": "name"
        },
        {
            "name": "imageId",
            "displayName": "Image OCID",
            "shape": "string"
        },
        {
            "name": "launchMode",
            "displayName": "Launch mode",
            "shape": "string"
        },
        {
            "name": "timeCreated",
            "displayName": "Created",
            "shape": "date"
        }
    ],
    "timeframes": false
}
