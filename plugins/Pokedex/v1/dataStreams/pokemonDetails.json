{
    "name": "pokemonDetails",
    "displayName": "Pokémon Details",
    "description": "Current attributes for a Pokémon including height, weight, types and abilities",
    "tags": ["Pokémon"],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "pokemon/{{object.pokemonId}}",
        "postRequestScript": "pokemonDetails.js"
    },
    "matches": {
        "sourceType": { "type": "oneOf", "values": ["Pokemon"] }
    },
    "metadata": [
        { "name": "height", "displayName": "Height (dm)", "shape": "number" },
        { "name": "weight", "displayName": "Weight (hg)", "shape": "number" },
        { "name": "baseExperience", "displayName": "Base Experience", "shape": "number" },
        { "name": "types", "displayName": "Types", "shape": "string" },
        { "name": "abilities", "displayName": "Abilities", "shape": "string" },
        { "name": "hiddenAbility", "displayName": "Hidden Ability", "shape": "string" }
    ],
    "timeframes": false
}
