{
    "name": "pokemonList",
    "displayName": "Pokémon List",
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "pokemon",
        "paging": {
            "mode": "nextUrl",
            "pageSize": {
                "realm": "queryArg",
                "path": "limit",
                "value": "200"
            },
            "in": {
                "realm": "payload",
                "path": "next"
            }
        },
        "postRequestScript": "pokemonList.js"
    },
    "matches": "none",
    "visibility": { "type": "hidden" },
    "metadata": [
        { "name": "sourceId", "shape": "string", "visible": false },
        { "name": "name", "displayName": "Name", "shape": "string" },
        { "name": "pokemonId", "displayName": "ID", "shape": "string" }
    ],
    "timeframes": false
}
