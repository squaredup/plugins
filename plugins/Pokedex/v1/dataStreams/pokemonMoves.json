{
    "name": "pokemonMoves",
    "displayName": "Moves",
    "description": "Moves a Pokémon can learn across all game versions",
    "tags": ["Pokémon"],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "pokemon/{{object.pokemonId}}",
        "postRequestScript": "pokemonMoves.js"
    },
    "matches": {
        "sourceType": { "type": "oneOf", "values": ["Pokemon"] }
    },
    "metadata": [
        { "name": "move", "displayName": "Move", "shape": "string", "role": "label" },
        { "name": "method", "displayName": "Learn Method", "shape": "string" },
        { "name": "level", "displayName": "Level", "shape": "number" }
    ],
    "timeframes": false
}
