{
    "name": "pokemonStats",
    "displayName": "Base Stats",
    "description": "Base stat values for a Pokémon",
    "tags": ["Pokémon"],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "pokemon/{{object.pokemonId}}",
        "postRequestScript": "pokemonStats.js"
    },
    "matches": {
        "sourceType": { "type": "oneOf", "values": ["Pokemon"] }
    },
    "metadata": [
        { "name": "stat", "displayName": "Stat", "shape": "string", "role": "label" },
        { "name": "value", "displayName": "Value", "shape": "number", "role": "value" }
    ],
    "timeframes": false
}
