{
    "name": "typeDamageRelations",
    "displayName": "Type Damage Relations",
    "description": "Type effectiveness showing damage multipliers for attacking and defending",
    "tags": ["Type"],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "type/{{object.typeId}}",
        "postRequestScript": "typeDamageRelations.js"
    },
    "matches": {
        "sourceType": { "type": "oneOf", "values": ["Pokemon Type"] }
    },
    "metadata": [
        { "name": "type", "displayName": "Type", "shape": "string", "role": "label" },
        { "name": "relation", "displayName": "Relation", "shape": "string" },
        { "name": "multiplier", "displayName": "Multiplier", "shape": "string" }
    ],
    "timeframes": false
}
