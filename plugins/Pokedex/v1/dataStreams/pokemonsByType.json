{
    "name": "pokemonsByType",
    "displayName": "Pokémon by Type",
    "description": "All Pokémon that have a given type",
    "tags": ["Type"],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "type/{{object.typeId}}",
        "postRequestScript": "pokemonsByType.js"
    },
    "matches": {
        "sourceType": { "type": "oneOf", "values": ["Pokemon Type"] }
    },
    "metadata": [
        { "name": "name", "displayName": "Pokémon", "shape": "string", "role": "label" },
        { "name": "pokemonId", "shape": "string", "visible": false },
        { "name": "slot", "displayName": "Type Slot", "shape": "number" },
        { "name": "name", "sourceId": "pokemonId", "sourceType": "Pokemon" }
    ],
    "timeframes": false
}
