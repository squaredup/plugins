{
    "name": "Event Type",
    "schemaVersion": "1.5",
    "timeframe": "last30days",
    "variables": ["{{variables.[Amplitude Event Type]}}"],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "4b94c2a0-5067-485d-985b-22feff45dea5",
                "x": 0,
                "y": 0,
                "w": 1,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Event Type Details",
                    "description": "",
                    "timeframe": "none",
                    "variables": ["{{variables.[Amplitude Event Type]}}"],
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "datastream-properties",
                        "name": "properties",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Amplitude Event Types]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Amplitude Event Type]}}"
                    },
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": true,
                                "columnOrder": ["name", "description", "category", "is_active"],
                                "hiddenColumns": ["id", "link", "links", "label", "sourceId", "sourceType"]
                            }
                        }
                    }
                }
            },
            {
                "i": "7cf3f9d6-6b24-471d-b20e-2372d587dfc5",
                "x": 1,
                "y": 0,
                "w": 3,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Event Count History",
                    "description": "",
                    "variables": ["{{variables.[Amplitude Event Type]}}"],
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[eventCountHistory]}}",
                        "name": "eventCountHistory",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "metric": "totals"
                        }
                    },
                    "scope": {
                        "scope": "{{scopes.[Amplitude Event Types]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Amplitude Event Type]}}"
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "line",
                            "encoding": {
                                "x": {
                                    "field": "date",
                                    "type": "temporal",
                                    "title": "Date"
                                },
                                "y": {
                                    "field": "eventCount",
                                    "type": "quantitative",
                                    "title": "Event Count"
                                }
                            },
                            "style": {
                                "legendPosition": "none",
                                "cartesianShowYAxisTitle": true,
                                "cartesianYAxisTitle": "Events",
                                "cartesianYAxisRangeMode": "fit",
                                "cartesianSymbol": "none",
                                "cartesianAreaGradient": true
                            }
                        }
                    }
                }
            },
            {
                "i": "48ad4c07-009b-4a9a-95ea-336fefdcd761",
                "x": 0,
                "y": 3,
                "w": 4,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Event Breakdown by Property",
                    "description": "",
                    "variables": ["{{variables.[Amplitude Event Type]}}"],
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[eventCountHistory]}}",
                        "name": "eventCountHistory",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "metric": "totals"
                        },
                        "group": {
                            "by": [["groupValue", "uniqueValues"]],
                            "aggregate": [{ "type": "sum", "names": ["eventCount"] }]
                        },
                        "sort": { "by": [["eventCount_sum", "desc"]], "top": 10 }
                    },
                    "scope": {
                        "scope": "{{scopes.[Amplitude Event Types]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Amplitude Event Type]}}"
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "groupValue_uniqueValues",
                                    "type": "nominal",
                                    "title": "Property Value"
                                },
                                "y": {
                                    "field": "eventCount_sum",
                                    "type": "quantitative",
                                    "title": "Event Count (Sum)"
                                }
                            },
                            "style": {
                                "legendPosition": "none",
                                "cartesianShowXAxisTitle": true,
                                "cartesianShowYAxisTitle": true
                            }
                        }
                    }
                }
            }
        ]
    }
}
