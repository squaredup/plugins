{
    "name": "Cohort",
    "schemaVersion": "1.5",
    "timeframe": "last30days",
    "variables": ["{{variables.[Amplitude Cohort]}}"],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
