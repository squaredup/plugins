{
    "name": "clusterCheck",
    "displayName": "Cluster Check",
    "description": "A single cluster, used to check the Prism Central connection and credentials",
    "tags": ["Clusters"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/clustermgmt/v4.0/config/clusters",
        "getArgs": [{ "key": "$limit", "value": "1" }],
        "pathToData": "data"
    },
    "matches": "none",
    "visibility": { "type": "hidden" },
    "metadata": [
        { "name": "extId", "displayName": "ID", "shape": "string", "role": "id" },
        { "name": "name", "displayName": "Name", "shape": "string", "role": "label" }
    ],
    "timeframes": false
}
