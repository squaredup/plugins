[
    {
        "type": "url",
        "name": "prismCentralUrl",
        "label": "Prism Central URL",
        "placeholder": "https://prism-central.example.com:9440",
        "help": "Requires Prism Central 2024.3 or later. Use the Prism Central address, not a cluster's Prism Element.",
        "validation": {
            "required": true,
            "pattern": {
                "value": "^https?://[^\\s]+$",
                "message": "Enter the full URL of Prism Central, including https:// and the port"
            }
        }
    },
    {
        "type": "radio",
        "name": "authMode",
        "label": "Authentication",
        "defaultValue": "apiKey",
        "validation": { "required": true },
        "options": [
            { "label": "API key (service account)", "value": "apiKey" },
            { "label": "Username and password", "value": "basic" }
        ]
    },
    {
        "type": "fieldGroup",
        "visible": { "authMode": "apiKey" },
        "fields": [
            {
                "type": "password",
                "name": "apiKey",
                "label": "API key",
                "placeholder": "Enter the service account's API key",
                "validation": { "required": true }
            }
        ]
    },
    {
        "type": "fieldGroup",
        "visible": { "authMode": "basic" },
        "fields": [
            {
                "type": "text",
                "name": "username",
                "label": "Username",
                "placeholder": "Enter the Prism Central username",
                "validation": { "required": true }
            },
            {
                "type": "password",
                "name": "password",
                "label": "Password",
                "placeholder": "Enter the Prism Central password",
                "validation": { "required": true }
            }
        ]
    }
]
