{
    "name": "nutanix",
    "displayName": "Nutanix",
    "version": "1.0.0",
    "author": { "name": "@shawn149", "type": "community" },
    "description": "Monitor the health, capacity and performance of Nutanix clusters, hosts, VMs and storage containers managed by Prism Central.",
    "category": "Infrastructure",
    "type": "hybrid",
    "schemaVersion": "2.1",
    "importNotSupported": false,
    "restrictedToPlatforms": [],
    "keywords": ["nutanix", "prism central", "ahv", "hci", "hyperconverged", "virtualization", "hypervisor", "infrastructure", "storage"],
    "objectTypes": ["Cluster", "Host", "VM", "Storage Container"],
    "links": [
        {
            "category": "documentation",
            "url": "https://github.com/squaredup/plugins/blob/main/plugins/Nutanix/v1/docs/README.md",
            "label": "Help adding this plugin"
        },
        {
            "category": "source",
            "url": "https://github.com/squaredup/plugins",
            "label": "Repository"
        }
    ],
    "base": {
        "plugin": "WebAPI",
        "majorVersion": "1",
        "config": {
            "baseUrl": "{{prismCentralUrl.trim().replace(/[/]+$/, '')}}/api",
            "authMode": "{{authMode === 'basic' ? 'basic' : 'none'}}",
            "basicAuthUsername": "{{authMode === 'basic' ? username : undefined}}",
            "basicAuthPassword": "{{authMode === 'basic' ? password : undefined}}",
            "headers": [
                {
                    "key": "X-ntnx-api-key",
                    "value": "{{authMode === 'apiKey' ? apiKey.trim() : undefined}}"
                }
            ],
            "queryArgs": []
        }
    }
}
