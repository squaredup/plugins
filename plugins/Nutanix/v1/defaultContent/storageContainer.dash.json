                "config": {
                    "_type": "tile/data-stream",
                    "title": "Open Alerts",
                    "description": "Unresolved alerts raised on this storage container, critical first",
                    "timeframe": "none",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "variables": [
                        "{{variables.[Nutanix Storage Container]}}"
                    ],
                    "dataStream": {
                        "id": "datastream-sql",
                        "dataSourceConfig": {
                            "version": "2.0",
                            "sql": "SELECT CASE \"severity[Expanded].rawState\" WHEN 'CRITICAL' THEN 'Critical' WHEN 'WARNING' THEN 'Warning' ELSE 'Info' END AS \"severity\", \"title\" AS \"alert\", \"sourceEntityName\" AS \"entity\", \"sourceEntityType\" AS \"entityType\", \"clusterName\" AS \"cluster\", \"creationTime\" AS \"raised\", \"possibleCause\" AS \"cause\", \"message\", \"resolution\", CASE \"severity[Expanded].rawState\" WHEN 'CRITICAL' THEN 1 WHEN 'WARNING' THEN 2 ELSE 3 END AS \"rank\" FROM \"alerts\" ORDER BY \"rank\", \"creationTime\" DESC",
                            "tables": [
                                {
                                    "tableName": "alerts",
                                    "config": {
                                        "variables": [
                                            "{{variables.[Nutanix Storage Container]}}"
                                        ],
                                        "activePluginConfigIds": [
                                            "{{configId}}"
                                        ],
                                        "dataStream": {
                                            "id": "{{dataStreams.[alerts]}}",
                                            "name": "alerts",
                                            "pluginConfigId": "{{configId}}",
                                            "dataSourceConfig": {
                                                "entity": {
                                                    "variable": "{{variables.[Nutanix Storage Container]}}",
                                                    "workspace": "{{workspaceId}}",
                                                    "scope": "{{scopes.[Nutanix Storage Containers]}}"
                                                }
                                            }
                                        },
                                        "timeframe": "none"
                                    }
                                }
                            ]
                        },
