                "config": {
                    "_type": "tile/data-stream",
                    "title": "Open Alerts",
                    "description": "Unresolved alerts raised on this host, critical first",
                    "timeframe": "none",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "variables": [
                        "{{variables.[Nutanix Host]}}"
                    ],
                    "dataStream": {
                        "id": "datastream-sql",
                        "dataSourceConfig": {
                            "version": "2.0",
                            "sql": "SELECT CASE \"severity[Expanded].rawState\" WHEN 'CRITICAL' THEN 'Critical' WHEN 'WARNING' THEN 'Warning' ELSE 'Info' END AS \"severity\", \"title\" AS \"alert\", \"sourceEntityName\" AS \"entity\", \"sourceEntityType\" AS \"entityType\", \"clusterName\" AS \"cluster\", \"creationTime\" AS \"raised\", \"possibleCause\" AS \"cause\", \"message\", \"resolution\", CASE \"severity[Expanded].rawState\" WHEN 'CRITICAL' THEN 1 WHEN 'WARNING' THEN 2 ELSE 3 END AS \"rank\" FROM \"alerts\" ORDER BY \"rank\", \"creationTime\" DESC",
                            "tables": [
                                {
                                    "tableName": "alerts",
                                    "config": {
                                        "variables": [
                                            "{{variables.[Nutanix Host]}}"
                                        ],
                                        "activePluginConfigIds": [
                                            "{{configId}}"
                                        ],
                                        "dataStream": {
                                            "id": "{{dataStreams.[alerts]}}",
                                            "name": "alerts",
                                            "pluginConfigId": "{{configId}}",
                                            "dataSourceConfig": {
                                                "entity": {
                                                    "variable": "{{variables.[Nutanix Host]}}",
                                                    "workspace": "{{workspaceId}}",
                                                    "scope": "{{scopes.[Nutanix Hosts]}}"
                                                }
                                            }
                                        },
                                        "timeframe": "none"
                                    }
                                }
                            ]
                        },
                        "metadata": [
                            {
                                "name": "raised",
                                "shape": "date"
                            },
                            {
                                "pattern": ".*"
                            }
                        ]
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "severity",
                                        "title": "Severity",
                                        "renderer": {
                                            "type": "status"
                                        },
                                        "width": 110
                                    },
                                    {
                                        "field": "alert",
                                        "title": "Alert",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "entity",
                                        "title": "Affected",
