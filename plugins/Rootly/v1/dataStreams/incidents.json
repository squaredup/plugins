{
    "name": "incidents",
    "description": "Incidents in the selected timeframe, optionally limited to selected services, teams, functionalities or environments",
    "tags": ["Incidents"],
    "config": {
        "httpMethod": "get",
        "paging": {
            "mode": "offset",
            "pageSize": {
                "realm": "queryArg",
                "path": "page[size]",
                "value": "200"
            },
            "offset": {
                "rowCountIn": {
                    "realm": "payloadArraySize",
                    "path": "data"
                },
                "mode": "page",
                "base": "1"
            },
            "out": {
                "realm": "queryArg",
                "path": "page[number]"
            }
        },
        "expandInnerObjects": true,
        "endpointPath": "incidents",
        "getArgs": [
            {
                "key": "filter[{{timestampField}}][gte]",
                "value": "{{{timeframe.start}}}"
            },
            {
                "key": "filter[{{timestampField}}][lte]",
                "value": "{{{timeframe.end}}}"
            }
        ],
        "postRequestScript": "incidents.js",
        "headers": []
    },
    "manualConfigApply": true,
    "rowPath": [],
    "metadata": [
        {
            "shape": "string",
            "name": "id"
        },
        {
            "name": "services",
            "displayName": "Services",
            "shape": ["array", { "itemShape": "string" }]
        },
        {
            "name": "teams",
            "displayName": "Teams",
            "shape": ["array", { "itemShape": "string" }]
        },
        {
            "name": "functionalities",
            "displayName": "Functionalities",
            "shape": ["array", { "itemShape": "string" }]
        },
        {
            "name": "environments",
            "displayName": "Environments",
            "shape": ["array", { "itemShape": "string" }]
        },
        {
            "pattern": ".*"
        }
    ],
    "timeframes": [
        "last1hour",
        "last12hours",
        "last24hours",
        "last7days",
        "last30days",
        "thisMonth",
        "thisQuarter",
        "thisYear",
        "lastMonth",
        "lastQuarter",
        "lastYear"
    ],
    "displayName": "Incidents",
    "baseDataSourceName": "httpRequestUnscoped",
    "matches": "none",
    "ui": [
        {
            "help": "Select which timestamp field Rootly should filter by.",
            "defaultValue": "created_at",
            "name": "timestampField",
            "options": [
                {
                    "value": "created_at",
                    "label": "Created"
                },
                {
                    "value": "updated_at",
                    "label": "Updated"
                },
                {
                    "value": "started_at",
                    "label": "Started"
                },
                {
                    "value": "detected_at",
                    "label": "Detected"
                },
                {
                    "value": "acknowledged_at",
                    "label": "Acknowledged"
                },
                {
                    "value": "mitigated_at",
                    "label": "Mitigated"
                },
                {
                    "value": "resolved_at",
                    "label": "Resolved"
                },
                {
                    "value": "closed_at",
                    "label": "Closed"
                }
            ],
            "label": "Timestamp field",
            "type": "radio",
            "validation": {
                "required": true
            }
        },
        {
            "type": "objects",
            "name": "catalogItems",
            "label": "Service, team, functionality or environment (optional)",
            "matches": {
                "sourceType": { "type": "oneOf", "values": ["Service", "Team", "Functionality", "Environment"] }
            }
        }
    ]
}