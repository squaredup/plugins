{
    "name": "environments",
    "displayName": "Environments",
    "description": "All environments in the Rootly catalog, one row per environment",
    "tags": ["Catalog"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "environments",
        "expandInnerObjects": true,
        "pathToData": "data",
        "paging": {
            "mode": "offset",
            "pageSize": { "realm": "queryArg", "path": "page[size]", "value": "100" },
            "offset": {
                "mode": "page",
                "rowCountIn": { "realm": "payloadArraySize", "path": "data" },
                "base": 1
            },
            "out": { "realm": "queryArg", "path": "page[number]" }
        }
    },
    "matches": "none",
    "metadata": [
        { "name": "id", "displayName": "ID", "shape": "string", "visible": false },
        { "name": "attributes.name", "displayName": "Name", "shape": "string", "role": "label" },
        { "name": "attributes.slug", "displayName": "Slug", "shape": "string" },
        { "name": "attributes.description", "displayName": "Description", "shape": "string" },
        { "name": "attributes.created_at", "displayName": "Created", "shape": "date" },
        { "name": "attributes.updated_at", "displayName": "Updated", "shape": "date" }
    ],
    "timeframes": false
}
