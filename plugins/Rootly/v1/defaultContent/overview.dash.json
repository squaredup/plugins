                                    "asc"
                                ]
                            ]
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "created_at_byDay",
                                    "type": "temporal",
                                    "title": "Day"
                                },
                                "y": {
                                    "field": "count",
                                    "type": "quantitative",
                                    "title": "Incidents"
                                },
                                "series": {
                                    "field": "severity_uniqueValues",
                                    "type": "nominal"
                                }
                            },
                            "style": {
                                "cartesianStack": "on",
                                "legendPosition": "bottom",
                                "cartesianBarBorderRadius": 2,
