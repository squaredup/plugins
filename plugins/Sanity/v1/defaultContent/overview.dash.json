                "config": {
                    "_type": "tile/data-stream",
                    "title": "Datasets",
                    "description": "",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[datasetStats]}}",
                        "name": "datasetStats",
                        "pluginConfigId": "{{configId}}",
                        "group": {
                            "by": [],
                            "aggregate": [{ "type": "count" }]
                        }
                    },
                    "scope": {
                        "scope": "{{scopes.[Datasets]}}",
                        "workspace": "{{workspaceId}}"
                    },
                    "timeframe": "none",
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    {
                                        "field": "count",
                                        "type": "quantitative",
                                        "title": "Count"
                                    }
                                ]
                            },
                            "style": {
                                "scalarLabelText": "datasets"
                            }
                        }
                    }
                }
            },
            {
                "i": "4f9fef20-3a30-425f-b119-16e796901d7c",
                "x": 2,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Documents",
                    "description": "",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[datasetStats]}}",
                        "name": "datasetStats",
                        "pluginConfigId": "{{configId}}",
                        "group": {
                            "by": [],
                            "aggregate": [
                                {
                                    "type": "sum",
                                    "names": ["documents.count.value"]
                                }
                            ]
                        }
                    },
                    "scope": {
                        "scope": "{{scopes.[Datasets]}}",
                        "workspace": "{{workspaceId}}"
                    },
                    "timeframe": "none",
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    {
                                        "field": "documents.count.value_sum",
                                        "type": "quantitative",
                                        "title": "Documents (Sum)"
                                    }
                                ]
                            },
                            "style": {
                                "scalarLabelText": "documents"
                            }
                        }
                    }
                }
            },
            {
                "i": "d5b7371a-9142-4ff5-9996-a3d18a7b23eb",
                "x": 3,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "JSON Stored",
                    "description": "",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[datasetStats]}}",
                        "name": "datasetStats",
                        "pluginConfigId": "{{configId}}",
                        "group": {
                            "by": [],
                            "aggregate": [
                                {
                                    "type": "sum",
                                    "names": ["documents.jsonSizeSum.value"]
                                }
                            ]
                        }
                    },
                    "scope": {
                        "scope": "{{scopes.[Datasets]}}",
                        "workspace": "{{workspaceId}}"
                    },
                    "timeframe": "none",
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    {
                                        "field": "documents.jsonSizeSum.value_sum",
                                        "type": "quantitative",
                                        "title": "JSON Size (Sum)"
                                    }
                                ]
                            },
                            "style": {
                                "scalarLabelText": "JSON stored"
                            }
                        }
                    }
                }
            },
            {
                "i": "15f9e81f-7215-40be-bad0-7e7e09d0516d",
                "x": 0,
                "y": 2,
                "w": 4,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "All Projects",
                    "description": "Every project in the organization. Add a project's API token under Project API tokens to bring its datasets and members into SquaredUp.",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[allProjects]}}",
                        "name": "allProjects",
                        "pluginConfigId": "{{configId}}"
                    },
                    "timeframe": "none",
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "displayName",
                                        "title": "Name",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "tokenStatus[Expanded].rawState",
                                        "title": "Token Status",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "configured": "#2BB660",
                                                "missing": "#DE0038"
                                            }
                                        }
                                    },
                                    {
                                        "field": "id",
                                        "title": "Project ID",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    }
                                ]
                            }
                        }
                    }
                }
            },
            {
                "i": "b559b8ba-3a0a-4307-8b1b-b0351902a729",
                "x": 0,
                "y": 4,
                "w": 2,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Documents by Dataset",
                    "description": "",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[datasetStats]}}",
                        "name": "datasetStats",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [["documents.count.value", "desc"]],
                            "top": 20
                        }
                    },
                    "scope": {
                        "scope": "{{scopes.[Datasets]}}",
                        "workspace": "{{workspaceId}}"
                    },
                    "timeframe": "none",
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "dataset",
                                    "type": "nominal",
                                    "title": "Dataset"
                                },
                                "y": {
                                    "field": "documents.count.value",
                                    "type": "quantitative",
                                    "title": "Documents"
                                }
                            },
                            "style": {
                                "legendPosition": "none",
                                "cartesianShowXAxisTitle": true,
                                "cartesianShowYAxisTitle": true,
                                "cartesianYAxisTitle": "Documents",
                                "cartesianHorizontal": true
                            }
                        }
                    }
                }
            },
            {
                "i": "147db02e-9f70-4db9-bff2-fd8264cd5921",
                "x": 2,
                "y": 4,
                "w": 2,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Dataset Limit Usage",
                    "description": "How close each dataset is to its plan limits.",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[datasetStats]}}",
                        "name": "datasetStats",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [["fieldsPctOfLimit", "desc"]]
                        }
                    },
                    "scope": {
                        "scope": "{{scopes.[Datasets]}}",
                        "workspace": "{{workspaceId}}"
                    },
                    "timeframe": "none",
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "dataset",
                                        "title": "Dataset",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "fieldsPctOfLimit",
                                        "title": "Fields (% of limit)",
                                        "renderer": {
                                            "type": "bar",
                                            "max": 100
                                        }
                                    },
                                    {
                                        "field": "documentsPctOfLimit",
                                        "title": "Documents (% of limit)",
                                        "renderer": {
                                            "type": "bar",
                                            "max": 100
                                        }
                                    },
                                    {
                                        "field": "jsonSizePctOfLimit",
                                        "title": "JSON Size (% of limit)",
                                        "renderer": {
                                            "type": "bar",
                                            "max": 100
                                        }
                                    },
                                    {
                                        "field": "releasesPctOfLimit",
                                        "title": "Releases (% of limit)",
                                        "renderer": {
                                            "type": "bar",
                                            "max": 100
                                        }
                                    },
                                    {
                                        "field": "documents.count.value",
                                        "title": "Documents",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "documents.count.limit",
                                        "title": "Document Limit",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "fields.count.value",
                                        "title": "Fields",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "fields.count.limit",
                                        "title": "Field Limit",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "documents.jsonSizeSum.value",
                                        "title": "JSON Size",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "documents.jsonSizeSum.limit",
                                        "title": "JSON Size Limit",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    }
                                ]
                            }
                        }
                    }
                }
            }
        ]
    }
}
