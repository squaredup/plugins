{
    "name": "Overview",
    "schemaVersion": "1.5",
    "timeframe": "none",
    "variables": [],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "2b4c4986-e339-4565-b8b4-b9d35fb33c46",
                "x": 0,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Monitored Projects",
                    "description": "Only projects with a configured API token are indexed.",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[listProjects]}}",
                        "name": "listProjects",
                        "pluginConfigId": "{{configId}}",
                        "group": {
                            "by": [],
                            "aggregate": [{ "type": "count" }]
                        }
                    },
                    "timeframe": "none",
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    {
                                        "field": "count",
                                        "type": "quantitative",
                                        "title": "Count"
                                    }
                                ]
                            },
                            "style": {
                                "scalarLabelText": "projects"
                            }
                        }
                    }
                }
            },
            {
                "i": "90206f76-3975-4a65-9c93-b452b19331a0",
