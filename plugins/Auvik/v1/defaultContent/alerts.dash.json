                                    },
                                    {
                                        "color": "#22c55e",
                                        "to": 1
                                    }
                                ],
                                "ringGridTrackWidth": 10
                            }
                        }
                    }
                },
                "h": 2,
                "i": "afd81d29-65f4-40e6-8709-360090ffe3b1",
