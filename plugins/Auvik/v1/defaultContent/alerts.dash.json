            {
                "config": {
                    "_type": "tile/data-stream",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[alerts]}}",
                        "name": "alerts",
                        "pluginConfigId": "{{configId}}",
                        "sql": "WITH a AS (SELECT * FROM \"dataset\" WHERE \"entityType\" = 'Device' AND \"entityName\" IS NOT NULL AND \"entityName\" NOT LIKE 'Object not found%' AND \"entityName\" NOT LIKE 'No % value'), ids AS (SELECT \"entityName\", \"entityId\", ROW_NUMBER() OVER (PARTITION BY \"entityName\" ORDER BY \"entityId\") AS rn, COUNT(*) OVER (PARTITION BY \"entityName\") AS dup FROM (SELECT DISTINCT \"entityName\", \"entityId\" FROM a)), top AS (SELECT \"entityId\", COUNT(*) AS total FROM a GROUP BY 1 ORDER BY total DESC LIMIT 8) SELECT CASE WHEN i.dup > 1 THEN a.\"entityName\" || ' #' || i.rn ELSE a.\"entityName\" END AS \"device\", UPPER(SUBSTR(a.\"severity[Expanded].rawState\", 1, 1)) || SUBSTR(a.\"severity[Expanded].rawState\", 2) AS \"severity\", CAST(COUNT(*) AS DOUBLE) AS \"alerts\" FROM a JOIN ids i ON a.\"entityId\" = i.\"entityId\" JOIN top t ON a.\"entityId\" = t.\"entityId\" GROUP BY ALL ORDER BY MAX(t.total) DESC, \"device\", MIN(a.\"severityLevel\")"
                    },
                    "description": "Devices that raised the most alerts in the timeframe, by severity",
                    "title": "Noisiest Devices",
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
