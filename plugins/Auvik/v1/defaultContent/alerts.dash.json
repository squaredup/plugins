                        "sql": "SELECT COUNT(*) FILTER (WHERE \"status[Expanded].rawState\" = 'Open') AS \"open\", COUNT(*) FILTER (WHERE \"status[Expanded].rawState\" = 'Open' AND \"severity[Expanded].rawState\" IN ('critical', 'emergency')) AS \"critical\" FROM \"dataset\""
                    },
                    "description": "Alerts raised in the last 30 days that are still open, and how many are critical or emergency",
                    "timeframe": "last30days",
                    "title": "Needs Attention",
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    {
                                        "aggregate": "sum",
                                        "field": "open",
                                        "title": "Open",
                                        "type": "quantitative"
                                    },
                                    {
                                        "aggregate": "sum",
                                        "field": "critical",
                                        "title": "Critical",
                                        "type": "quantitative"
                                    }
                                ]
                            },
                            "style": {
                                "scalarColumns": 2,
                                "scalarValueColor": "#f59e0b"
                            }
                        }
                    }
                },
                "h": 2,
                "i": "d04dae3e-5b94-4dda-9946-b2aef128dee1",
