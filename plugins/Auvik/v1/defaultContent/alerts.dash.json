            {
                "config": {
                    "_type": "tile/data-stream",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[alerts]}}",
                        "name": "alerts",
                        "pluginConfigId": "{{configId}}",
                        "sql": "WITH r AS (SELECT CAST(EPOCH(\"resolvedOn\") - EPOCH(\"detectedOn\") AS DOUBLE) AS secs FROM \"dataset\" WHERE \"resolvedOn\" IS NOT NULL), m AS (SELECT AVG(secs) AS mean_s, MEDIAN(secs) AS median_s FROM r) SELECT (SELECT COUNT(*) FROM \"dataset\") AS \"raised\", (SELECT COUNT(*) FROM \"dataset\" WHERE \"status[Expanded].rawState\" = 'Resolved') AS \"resolved\", CASE WHEN m.mean_s IS NULL THEN '-' WHEN m.mean_s < 3600 THEN CAST(CAST(ROUND(m.mean_s / 60) AS BIGINT) AS VARCHAR) || 'm' WHEN m.mean_s < 86400 THEN CAST(CAST(FLOOR(m.mean_s / 3600) AS BIGINT) AS VARCHAR) || 'h ' || CAST(CAST(FLOOR((m.mean_s % 3600) / 60) AS BIGINT) AS VARCHAR) || 'm' ELSE CAST(CAST(FLOOR(m.mean_s / 86400) AS BIGINT) AS VARCHAR) || 'd ' || CAST(CAST(FLOOR((m.mean_s % 86400) / 3600) AS BIGINT) AS VARCHAR) || 'h' END AS \"mttr\", CASE WHEN m.median_s IS NULL THEN '-' WHEN m.median_s < 3600 THEN CAST(CAST(ROUND(m.median_s / 60) AS BIGINT) AS VARCHAR) || 'm' WHEN m.median_s < 86400 THEN CAST(CAST(FLOOR(m.median_s / 3600) AS BIGINT) AS VARCHAR) || 'h ' || CAST(CAST(FLOOR((m.median_s % 3600) / 60) AS BIGINT) AS VARCHAR) || 'm' ELSE CAST(CAST(FLOOR(m.median_s / 86400) AS BIGINT) AS VARCHAR) || 'd ' || CAST(CAST(FLOOR((m.median_s % 86400) / 3600) AS BIGINT) AS VARCHAR) || 'h' END AS \"median\" FROM m"
                    },
                    "description": "Alerts raised and cleared in the timeframe, with the mean and median time it took to clear them",
                    "title": "Alert Flow",
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    {
                                        "aggregate": "sum",
                                        "field": "raised",
                                        "title": "Raised",
                                        "type": "quantitative"
                                    },
                                    {
                                        "aggregate": "sum",
                                        "field": "resolved",
                                        "title": "Resolved",
                                        "type": "quantitative"
                                    },
                                    {
                                        "field": "mttr",
                                        "title": "Mean time to resolve",
                                        "type": "nominal"
                                    },
                                    {
                                        "field": "median",
                                        "title": "Median time to resolve",
                                        "type": "nominal"
                                    }
                                ]
                            },
                            "style": {
                                "scalarColumns": 4
                            }
                        }
                    }
                },
                "h": 2,
                "i": "8bf37e2e-2087-4df7-bdd6-06b031e9b8a9",
                "moved": false,
