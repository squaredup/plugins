            {
                "config": {
                    "_type": "tile/data-stream",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[alerts]}}",
                        "name": "alerts",
                        "pluginConfigId": "{{configId}}",
                        "sql": "WITH d AS (SELECT * FROM (VALUES (1, 'Mon'), (2, 'Tue'), (3, 'Wed'), (4, 'Thu'), (5, 'Fri'), (6, 'Sat'), (7, 'Sun')) t(dn, day)), h AS (SELECT CAST(range AS BIGINT) AS hr FROM range(0, 24)), a AS (SELECT ISODOW(\"detectedOn\") AS dn, HOUR(\"detectedOn\") AS hr, COUNT(*) AS n FROM \"dataset\" GROUP BY ALL) SELECT d.day AS \"day\", LPAD(CAST(h.hr AS VARCHAR), 2, '0') AS \"hour\", CAST(COALESCE(a.n, 0) AS DOUBLE) AS \"alerts\" FROM d CROSS JOIN h LEFT JOIN a ON a.dn = d.dn AND a.hr = h.hr ORDER BY d.dn DESC, h.hr"
                    },
                    "description": "Alerts raised over the last 30 days by hour of day and day of week (UTC), to spot noisy schedules such as backups or scans",
                    "timeframe": "last30days",
                    "title": "When Alerts Fire",
                    "vizSpec": {
