            {
                "config": {
                    "_type": "tile/data-stream",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[alerts]}}",
                        "name": "alerts",
                        "pluginConfigId": "{{configId}}",
                        "sql": "WITH b AS (SELECT * FROM (VALUES (1, 'Under 15m', 0, 900), (2, '15m to 1h', 900, 3600), (3, '1h to 4h', 3600, 14400), (4, '4h to 1d', 14400, 86400), (5, '1d to 3d', 86400, 259200), (6, 'Over 3d', 259200, 1000000000)) t(ord, bucket, lo, hi)), r AS (SELECT CAST(EPOCH(\"resolvedOn\") - EPOCH(\"detectedOn\") AS DOUBLE) AS secs FROM \"dataset\" WHERE \"resolvedOn\" IS NOT NULL) SELECT b.bucket AS \"bucket\", CAST(COUNT(r.secs) AS DOUBLE) AS \"alerts\" FROM b LEFT JOIN r ON r.secs >= b.lo AND r.secs < b.hi GROUP BY b.ord, b.bucket ORDER BY b.ord"
                    },
                    "description": "How long the alerts that cleared in the timeframe stayed open",
