                        "dataSourceConfig": {
                            "sql": "SELECT UPPER(SUBSTR(a.\"severity[Expanded].rawState\", 1, 1)) || SUBSTR(a.\"severity[Expanded].rawState\", 2) AS \"severity\", a.\"name\" AS \"alert\", CASE WHEN a.\"entityName\" IS NULL OR a.\"entityName\" LIKE 'Object not found%' OR a.\"entityName\" LIKE 'No % value' THEN '-' ELSE a.\"entityName\" END AS \"affected\", TRIM(REGEXP_REPLACE(a.\"description\", '[[:space:]]+', ' ', 'g')) AS \"details\", COALESCE(t.\"name\", a.\"tenantName\") AS \"site\", a.\"detectedOn\" AS \"raised\", a.\"tickets\" AS \"tickets\", a.\"link\" AS \"link\" FROM \"alerts\" a LEFT JOIN \"tenants\" t ON t.\"id\" = a.\"tenantId\" WHERE a.\"status[Expanded].rawState\" = 'Open' ORDER BY a.\"severityLevel\", a.\"detectedOn\" DESC",
                            "tables": [
