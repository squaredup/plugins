            {
                "config": {
                    "_type": "tile/data-stream",
                    "dataStream": {
                        "dataSourceConfig": {
                            "sql": "WITH a AS (SELECT \"tenantId\", COUNT(*) AS raised, COUNT(*) FILTER (WHERE \"status[Expanded].rawState\" = 'Open') AS open, COUNT(*) FILTER (WHERE \"status[Expanded].rawState\" = 'Open' AND \"severity[Expanded].rawState\" IN ('critical', 'emergency')) AS critical FROM \"alerts\" GROUP BY 1) SELECT t.\"name\" AS \"site\", CASE WHEN COALESCE(a.critical, 0) > 0 THEN 'error' WHEN COALESCE(a.open, 0) > 0 THEN 'warning' ELSE 'success' END AS \"health\", COALESCE(a.open, 0) AS \"open\", COALESCE(a.critical, 0) AS \"critical\", COALESCE(a.raised, 0) AS \"raised\" FROM \"tenants\" t LEFT JOIN a ON a.\"tenantId\" = t.\"id\" WHERE t.\"tenantType\" = 'client' ORDER BY \"critical\" DESC, \"open\" DESC, \"raised\" DESC",
                            "tables": [
                                {
                                    "config": {
