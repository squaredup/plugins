                                "cartesianHorizontal": true,
                                "cartesianShowHorizontalGridLines": false,
                                "cartesianShowStackedTotals": true,
                                "cartesianStack": "on",
                                "legendPosition": "bottom",
                                "mappedColors": {
                                    "Critical": "#ef4444",
                                    "Emergency": "#b91c1c",
                                    "Info": "#3b82f6",
                                    "Warning": "#f59e0b"
                                }
                            }
                        }
                    }
                },
                "h": 3,
