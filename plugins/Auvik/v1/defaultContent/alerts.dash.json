            {
                "config": {
                    "_type": "tile/data-stream",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[alerts]}}",
                        "name": "alerts",
                        "pluginConfigId": "{{configId}}",
                        "sql": "WITH top AS (SELECT \"name\", COUNT(*) AS total FROM \"dataset\" GROUP BY 1 ORDER BY total DESC, \"name\" LIMIT 8) SELECT a.\"name\" AS \"alert\", UPPER(SUBSTR(a.\"severity[Expanded].rawState\", 1, 1)) || SUBSTR(a.\"severity[Expanded].rawState\", 2) AS \"severity\", CAST(COUNT(*) AS DOUBLE) AS \"alerts\" FROM \"dataset\" a JOIN top t ON a.\"name\" = t.\"name\" GROUP BY ALL ORDER BY MAX(t.total) DESC, \"alert\", MIN(a.\"severityLevel\")"
                    },
