                    "dataStream": {
                        "id": "{{dataStreams.[alerts]}}",
                        "name": "alerts",
                        "pluginConfigId": "{{configId}}",
                        "sql": "SELECT STRFTIME(DATE_TRUNC('day', \"detectedOn\"), '%Y-%m-%dT%H:%M:%SZ') AS \"day\", UPPER(SUBSTR(\"severity[Expanded].rawState\", 1, 1)) || SUBSTR(\"severity[Expanded].rawState\", 2) AS \"severity\", CAST(COUNT(*) AS DOUBLE) AS \"alerts\" FROM \"dataset\" GROUP BY ALL ORDER BY \"day\", MIN(\"severityLevel\")"
                    },
                    "description": "Alerts raised each day in the timeframe, stacked by severity",
