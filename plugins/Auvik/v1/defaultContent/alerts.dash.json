                            "sql": "SELECT UPPER(SUBSTR(a.\"severity[Expanded].rawState\", 1, 1)) || SUBSTR(a.\"severity[Expanded].rawState\", 2) AS \"severity\", a.\"name\" AS \"alert\", CASE WHEN a.\"entityName\" IS NULL OR a.\"entityName\" LIKE 'Object not found%' OR a.\"entityName\" LIKE 'No % value' THEN '-' ELSE a.\"entityName\" END AS \"affected\", COALESCE(t.\"name\", a.\"tenantName\") AS \"site\", a.\"detectedOn\" AS \"raised\", a.\"resolvedOn\" AS \"cleared\", CASE WHEN CAST(EPOCH(a.\"resolvedOn\") - EPOCH(a.\"detectedOn\") AS DOUBLE) IS NULL THEN '-' WHEN CAST(EPOCH(a.\"resolvedOn\") - EPOCH(a.\"detectedOn\") AS DOUBLE) < 3600 THEN CAST(CAST(ROUND(CAST(EPOCH(a.\"resolvedOn\") - EPOCH(a.\"detectedOn\") AS DOUBLE) / 60) AS BIGINT) AS VARCHAR) || 'm' WHEN CAST(EPOCH(a.\"resolvedOn\") - EPOCH(a.\"detectedOn\") AS DOUBLE) < 86400 THEN CAST(CAST(FLOOR(CAST(EPOCH(a.\"resolvedOn\") - EPOCH(a.\"detectedOn\") AS DOUBLE) / 3600) AS BIGINT) AS VARCHAR) || 'h ' || CAST(CAST(FLOOR((CAST(EPOCH(a.\"resolvedOn\") - EPOCH(a.\"detectedOn\") AS DOUBLE) % 3600) / 60) AS BIGINT) AS VARCHAR) || 'm' ELSE CAST(CAST(FLOOR(CAST(EPOCH(a.\"resolvedOn\") - EPOCH(a.\"detectedOn\") AS DOUBLE) / 86400) AS BIGINT) AS VARCHAR) || 'd ' || CAST(CAST(FLOOR((CAST(EPOCH(a.\"resolvedOn\") - EPOCH(a.\"detectedOn\") AS DOUBLE) % 86400) / 3600) AS BIGINT) AS VARCHAR) || 'h' END AS \"duration\", CAST(EPOCH(a.\"resolvedOn\") - EPOCH(a.\"detectedOn\") AS DOUBLE) / 60 AS \"minutes\", a.\"link\" AS \"link\" FROM \"alerts\" a LEFT JOIN \"tenants\" t ON t.\"id\" = a.\"tenantId\" WHERE a.\"status[Expanded].rawState\" = 'Resolved' ORDER BY COALESCE(a.\"resolvedOn\", a.\"detectedOn\") DESC",
