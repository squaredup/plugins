            {
                "config": {
                    "_type": "tile/data-stream",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[alerts]}}",
                        "name": "alerts",
                        "pluginConfigId": "{{configId}}",
                        "sql": "SELECT ROUND(CAST(COUNT(*) FILTER (WHERE \"status[Expanded].rawState\" = 'Resolved') AS DOUBLE) * 100 / NULLIF(COUNT(*), 0), 1) AS \"cleared\", CAST(COUNT(*) FILTER (WHERE \"status[Expanded].rawState\" = 'Resolved') AS VARCHAR) || ' of ' || CAST(COUNT(*) AS VARCHAR) || ' cleared' AS \"detail\" FROM \"dataset\""
                    },
                    "description": "Share of the alerts raised in the timeframe that have since cleared",
                    "title": "Cleared Rate",
