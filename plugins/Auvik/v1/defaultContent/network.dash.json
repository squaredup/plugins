                        "group": {
                            "aggregate": [
                                {
                                    "type": "count"
                                }
                            ],
                            "by": [
                                [
                                    "deviceType",
                                    "uniqueValues"
                                ]
                            ]
                        },
                        "id": "{{dataStreams.[devices]}}",
                        "name": "devices",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [
                                [
                                    "count",
                                    "desc"
                                ]
                            ],
                            "top": 10
                        }
                    },
                    "description": "How many devices of each type Auvik has found on this network",
                    "timeframe": "none",
                    "title": "Device Types",
                    "variables": [
                        "{{variables.[Auvik Network]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "deviceType_uniqueValues",
                                    "title": "Device type",
                                    "type": "nominal"
                                },
                                "y": {
                                    "aggregate": "sum",
                                    "field": "count",
                                    "title": "Devices",
                                    "type": "quantitative"
                                }
                            },
                            "style": {
                                "cartesianBarBorderRadius": 4,
                                "cartesianColorRules": [
                                    {
                                        "color": "#8b5cf6",
                                        "gte": 5
                                    },
                                    {
                                        "color": "#6366f1",
                                        "gte": 0
                                    }
                                ],
                                "cartesianHorizontal": true,
                                "cartesianShowHorizontalGridLines": false,
                                "showLabels": true
                            }
                        }
                    }
