                        "sort": {
                            "by": [
                                [
                                    "detectedOn",
                                    "desc"
                                ]
                            ]
                        }
                    },
                    "description": "Alerts raised on this network in the last 30 days, newest first. Click a row to open the alert in Auvik",
                    "timeframe": "last30days",
                    "title": "Alerts on This Network",
                    "variables": [
                        "{{variables.[Auvik Network]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "severity[Expanded].rawState",
                                        "renderer": {
                                            "colors": {
                                                "Critical": "#ef4444",
                                                "Emergency": "#b91c1c",
                                                "Info": "#2563eb",
                                                "Warning": "#d97706"
                                            },
                                            "type": "badge"
                                        },
                                        "title": "Severity",
                                        "width": 110
                                    },
                                    {
                                        "field": "name",
                                        "renderer": {
                                            "type": "text"
                                        },
                                        "title": "Alert"
                                    },
                                    {
                                        "field": "entityName",
                                        "renderer": {
                                            "type": "text"
                                        },
                                        "title": "Affected"
                                    },
                                    {
                                        "field": "status[Expanded].rawState",
                                        "renderer": {
                                            "colors": {
                                                "Open": "#dc2626",
                                                "Paused": "#64748b",
                                                "Resolved": "#16a34a"
                                            },
                                            "type": "badge"
                                        },
                                        "title": "Status",
                                        "width": 100
                                    },
                                    {
                                        "field": "detectedOn",
                                        "renderer": {
                                            "relative": true,
                                            "type": "date"
                                        },
                                        "title": "Raised"
                                    },
                                    {
                                        "field": "resolvedOn",
                                        "renderer": {
                                            "relative": true,
                                            "type": "date"
                                        },
                                        "title": "Cleared"
                                    }
                                ]
                            },
                            "style": {
                                "richTableCellPadding": 6,
                                "richTableRowHighlight": {
                                    "colors": {
                                        "Open": "rgba(239,68,68,0.08)"
                                    },
                                    "field": "status[Expanded].rawState"
                                },
                                "richTableRowLinkField": "link"
                            }
                        }
                    }
                },
