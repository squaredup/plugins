                                    "type": "count"
                                }
                            ],
                            "by": [
                                [
                                    "vendorName",
                                    "uniqueValues"
                                ]
                            ]
                        },
                        "id": "{{dataStreams.[devices]}}",
                        "name": "devices",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [
                                [
                                    "count",
                                    "desc"
                                ]
                            ],
                            "top": 10
                        }
