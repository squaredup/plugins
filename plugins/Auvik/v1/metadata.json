{
    "name": "auvik",
    "displayName": "Auvik",
    "version": "1.0.0",
    "author": {
        "name": "SquaredUp Labs",
        "type": "labs"
    },
    "description": "Monitor your Auvik-managed networks, with device status, performance metrics, alerts, hardware health and warranty coverage.",
    "category": "Network",
    "type": "hybrid",
    "schemaVersion": "2.1",
    "importNotSupported": false,
    "restrictedToPlatforms": [],
    "keywords": [
        "auvik",
        "network",
        "network monitoring",
        "rmm",
        "msp",
        "switch",
        "router",
        "firewall",
        "snmp",
        "bandwidth",
        "warranty"
    ],
    "objectTypes": [
        "Tenant",
        "Device",
        "Network"
    ],
    "links": [
        {
            "category": "documentation",
            "url": "https://github.com/squaredup/plugins/blob/main/plugins/Auvik/v1/docs/README.md",
            "label": "Help adding this plugin"
        },
        {
            "category": "source",
            "url": "https://github.com/squaredup/plugins/tree/main/plugins/Auvik/v1",
            "label": "Repository"
        }
    ],
    "base": {
        "plugin": "WebAPI",
        "majorVersion": "1",
        "config": {
            "baseUrl": "https://auvikapi.{{ [].concat(region || 'us1').map((r) => (r && r.value) || r)[0].trim().toLowerCase() }}.my.auvik.com/v1/",
            "authMode": "basic",
            "basicAuthUsername": "{{ username.trim() }}",
            "basicAuthPassword": "{{ apiKey.trim() }}",
            "headers": [],
            "queryArgs": []
        }
    }
}
