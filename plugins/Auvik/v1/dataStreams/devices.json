    "metadata": [
        {
            "name": "id",
            "displayName": "Device ID",
            "shape": "string",
            "visible": false
        },
        {
            "name": "name",
            "displayName": "Name",
            "shape": "string",
            "role": "label",
            "sourceId": "id",
            "sourceType": "Device"
        },
        {
            "name": "onlineStatus",
            "displayName": "Status",
            "shape": [
                "state",
                {
                    "map": {
                        "success": [
                            "online"
                        ],
                        "error": [
                            "offline",
                            "unreachable",
                            "lowerLayerDown"
                        ],
                        "warning": [
                            "dormant",
                            "testing"
                        ],
                        "unmonitored": [
                            "notPresent"
                        ],
                        "unknown": [
                            "unknown"
                        ]
                    }
                }
            ]
        },
        {
            "name": "deviceType",
            "displayName": "Type",
            "shape": "string",
            "formatExpression": "{{ ($['deviceType'] || '').replace(/([a-z0-9])([A-Z])/g, '$1 $2').replace(/^./, (c) => c.toUpperCase()) }}"
        },
        {
            "name": "vendorName",
            "displayName": "Vendor",
            "shape": "string"
        },
        {
            "name": "makeModel",
