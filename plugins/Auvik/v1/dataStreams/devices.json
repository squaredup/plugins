{
    "name": "devices",
    "displayName": "Devices",
    "description": "Discovered devices with online status, make and model, software, IP addresses, networks and discovery status",
    "tags": [
        "Inventory",
        "Network",
        "Status"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "inventory/device/info{{ (typeof device !== 'undefined' && device && device.length === 1 ? device.flatMap((o) => o.rawId)[0] : null) ? '/' + (typeof device !== 'undefined' && device && device.length === 1 ? device.flatMap((o) => o.rawId)[0] : null) : '' }}",
        "getArgs": [
            {
                "key": "include",
                "value": "deviceDetail"
            },
            {
                "key": "fields[deviceDetail]",
                "value": "discoveryStatus,manageStatus"
            },
            {
                "key": "tenants",
                "value": "{{ (typeof device !== 'undefined' && device && device.length === 1 ? device.flatMap((o) => o.rawId)[0] : null) ? null : ((typeof tenant !== 'undefined' && tenant && tenant.length) ? tenant.flatMap((o) => o.rawId).join(',') : ((dataSource.tenantScope === 'selected' && dataSource.tenantIds || []).map((o) => String(o.value).trim()).join(',') || null)) }}"
            },
            {
                "key": "filter[networks]",
                "value": "{{ (typeof device !== 'undefined' && device && device.length === 1 ? device.flatMap((o) => o.rawId)[0] : null) ? null : ((typeof network !== 'undefined' && network && network.length) ? network.flatMap((o) => o.rawId).join(',') : null) }}"
            },
            {
                "key": "filter[deviceType]",
                "value": "{{ (typeof device !== 'undefined' && device && device.length === 1 ? device.flatMap((o) => o.rawId)[0] : null) ? null : ((typeof deviceType !== 'undefined' && deviceType) ? (Array.isArray(deviceType) ? (deviceType[0] && (deviceType[0].value || deviceType[0])) : deviceType) || null : null) }}"
            },
            {
                "key": "filter[onlineStatus]",
                "value": "{{ (typeof device !== 'undefined' && device && device.length === 1 ? device.flatMap((o) => o.rawId)[0] : null) ? null : ((typeof onlineStatus !== 'undefined' && onlineStatus) ? onlineStatus : null) }}"
            }
        ],
        "paging": {
            "mode": "nextUrl",
            "pageSize": {
                "realm": "queryArg",
                "path": "page[first]",
                "value": "500"
            },
            "in": {
                "realm": "payload",
                "path": "links.next"
            }
        },
        "postRequestScript": "devices.js"
    },
    "ui": [
        {
            "type": "objects",
            "name": "device",
            "label": "Device(s)",
            "matches": {
                "sourceType": {
                    "type": "oneOf",
