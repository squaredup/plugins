{
    "name": "usage",
    "displayName": "Usage",
    "description": "Billable device days, client days, monitored servers and workstations, and SaaS Management users for each tenant in the timeframe",
    "tags": [
        "Billing",
        "Usage"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "billing/usage/client",
        "getArgs": [
            {
                "key": "filter[fromDate]",
                "value": "{{ timeframe.start.slice(0, 10) }}"
            },
            {
                "key": "filter[thruDate]",
                "value": "{{ timeframe.end.slice(0, 10) }}"
            },
            {
                "key": "tenants",
                "value": "{{ (typeof tenant !== 'undefined' && tenant && tenant.length) ? tenant.flatMap((o) => o.rawId).join(',') : ((dataSource.tenantScope === 'selected' && dataSource.tenantIds || '').replace(/[ ]/g, '') || null) }}"
            }
        ],
        "paging": {
            "mode": "none"
        },
        "postRequestScript": "usage.js"
    },
    "ui": [
        {
            "type": "objects",
            "name": "tenant",
            "label": "Tenant(s)",
            "matches": {
                "sourceType": {
                    "type": "oneOf",
                    "values": [
                        "Tenant"
                    ]
                }
            }
        }
    ],
    "metadata": [
        {
            "name": "id",
            "displayName": "Usage ID",
            "shape": "string",
            "visible": false
        },
        {
            "name": "tenantName",
            "displayName": "Tenant",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "billableDays",
            "displayName": "Billable days",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0,
                    "thousandsSeparator": true
                }
            ],
            "role": "value"
        },
        {
            "name": "deviceDays",
            "displayName": "Device days",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0,
                    "thousandsSeparator": true
                }
            ]
        },
        {
            "name": "averageDevices",
            "displayName": "Average devices",
            "shape": [
                "number",
                {
                    "decimalPlaces": 1,
                    "thousandsSeparator": true
                }
            ]
        },
        {
            "name": "clientDays",
            "displayName": "Client days",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0,
                    "thousandsSeparator": true
                }
            ]
        },
        {
            "name": "maxMonitoredServers",
