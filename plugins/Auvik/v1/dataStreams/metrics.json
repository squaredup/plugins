                    ]
                }
            }
        },
        {
            "type": "choiceChips",
            "name": "granularity",
            "label": "Granularity",
            "defaultValue": "auto",
            "help": "**Auto** uses minute data for up to 12 hours on a single device, or up to 1 hour across many, then hourly data, then daily. Auvik limits minute data to 1 day and hourly data to 31 days per query, so a finer granularity than the timeframe allows is coarsened automatically.",
            "options": [
                {
                    "value": "auto",
                    "label": "Auto"
                },
                {
                    "value": "minute",
                    "label": "Minute"
                },
                {
                    "value": "hour",
                    "label": "Hour"
                },
                {
                    "value": "day",
                    "label": "Day"
                }
            ]
        }
    ],
    "metadata": [
        {
            "name": "timestamp",
            "displayName": "Time",
            "shape": "date",
            "role": "timestamp"
        },
        {
            "name": "label",
            "displayName": "Series",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "value",
            "displayName": "Value",
            "shape": [
                "number",
                {
                    "decimalPlaces": 2,
                    "thousandsSeparator": true
                }
            ],
            "role": "value",
            "formatExpression": "{{ $['value'] === null || $['value'] === undefined ? '' : (Math.round($['value'] * 100) / 100).toLocaleString() + ($['unit'] ? ' ' + $['unit'] : '') }}"
        },
        {
            "name": "unit",
            "displayName": "Unit",
            "shape": "string",
            "role": "unitLabel"
        },
        {
            "name": "metric",
            "displayName": "Metric",
