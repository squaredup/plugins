{
    "name": "metrics",
    "displayName": "Metrics",
    "description": "Performance time series for devices, interfaces, hardware components and internet connection checks, one row per data point and series",
    "tags": [
        "Performance",
        "Network"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "stat/{{ (typeof metric !== 'undefined' && metric ? (Array.isArray(metric) ? (metric[0] && (metric[0].value || metric[0])) : metric) : null) || 'device/cpuUtilization' }}",
        "getArgs": [
            {
                "key": "filter[fromTime]",
                "value": "{{ new Date(Math.max(timeframe.unixStart, timeframe.unixEnd - [86400, 2678400, 31536000][((h, g, one) => Math.max(h <= 24 ? 0 : h <= 744 ? 1 : 2, ['minute', 'hour', 'day'].indexOf(g) < 0 ? (one ? (h <= 12 ? 0 : h <= 744 ? 1 : 2) : (h <= 1 ? 0 : h <= 168 ? 1 : 2)) : ['minute', 'hour', 'day'].indexOf(g)))((timeframe.unixEnd - timeframe.unixStart) / 3600, typeof granularity !== 'undefined' && granularity ? granularity : 'auto', typeof device !== 'undefined' && !!device && device.length === 1)]) * 1000).toISOString() }}"
            },
            {
                "key": "filter[thruTime]",
                "value": "{{ timeframe.end }}"
            },
            {
                "key": "filter[interval]",
                "value": "{{ ['minute', 'hour', 'day'][((h, g, one) => Math.max(h <= 24 ? 0 : h <= 744 ? 1 : 2, ['minute', 'hour', 'day'].indexOf(g) < 0 ? (one ? (h <= 12 ? 0 : h <= 744 ? 1 : 2) : (h <= 1 ? 0 : h <= 168 ? 1 : 2)) : ['minute', 'hour', 'day'].indexOf(g)))((timeframe.unixEnd - timeframe.unixStart) / 3600, typeof granularity !== 'undefined' && granularity ? granularity : 'auto', typeof device !== 'undefined' && !!device && device.length === 1)] }}"
            },
            {
                "key": "filter[deviceId]",
                "value": "{{ ((typeof metric !== 'undefined' && metric ? (Array.isArray(metric) ? (metric[0] && (metric[0].value || metric[0])) : metric) : null) || 'device/cpuUtilization').indexOf('device') === 0 ? (typeof device !== 'undefined' && device && device.length === 1 ? device.flatMap((o) => o.rawId)[0] : null) : null }}"
            },
            {
                "key": "filter[parentDevice]",
                "value": "{{ ['interface', 'component'].includes(((typeof metric !== 'undefined' && metric ? (Array.isArray(metric) ? (metric[0] && (metric[0].value || metric[0])) : metric) : null) || 'device/cpuUtilization').split('/')[0]) ? (typeof device !== 'undefined' && device && device.length === 1 ? device.flatMap((o) => o.rawId)[0] : null) : null }}"
            },
            {
                "key": "filter[omitUndiscovered]",
                "value": "{{ ((typeof metric !== 'undefined' && metric ? (Array.isArray(metric) ? (metric[0] && (metric[0].value || metric[0])) : metric) : null) || 'device/cpuUtilization').indexOf('deviceAvailability') === 0 ? 'true' : null }}"
            },
            {
                "key": "tenants",
                "value": "{{ (typeof tenant !== 'undefined' && tenant && tenant.length) ? tenant.flatMap((o) => o.rawId).join(',') : ((dataSource.tenantScope === 'selected' && dataSource.tenantIds || []).map((o) => String(o.value).trim()).join(',') || null) }}"
            }
        ],
        "paging": {
            "mode": "nextUrl",
            "pageSize": {
                "realm": "queryArg",
                "path": "page[first]",
                "value": "100"
            },
            "in": {
                "realm": "payload",
                "path": "links.next"
            }
        },
        "postRequestScript": "metrics.js"
    },
    "matches": "none",
    "ui": [
        {
