                        "group": {
                            "by": [["style_type", "uniqueValues"]],
                            "aggregate": [{ "type": "count" }]
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "pie",
                            "encoding": {
                                "label": {
                                    "field": "style_type_uniqueValues",
                                    "type": "nominal",
                                    "title": "Type"
                                },
                                "value": {
                                    "field": "count",
                                    "type": "quantitative",
                                    "aggregate": "sum",
                                    "title": "Count"
                                }
                            },
                            "style": {
                                "pieInnerRadius": 60,
                                "pieDonutCenterValue": "total",
                                "labelFontSize": 16,
                                "pieSort": "desc",
                                "pieLegendStyle": "table",
                                "pieLabels": "nameAndPercent"
                            }
                        }
                    }
                }
