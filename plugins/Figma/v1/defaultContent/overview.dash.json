                    "title": "Top Component Creators",
                    "description": "",
                    "timeframe": "none",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[teamComponents]}}",
                        "name": "teamComponents",
                        "pluginConfigId": "{{configId}}",
                        "group": {
                            "by": [["user.handle", "uniqueValues"]],
                            "aggregate": [{ "type": "count" }]
                        },
                        "sort": { "by": [["count", "desc"]], "top": 10 }
