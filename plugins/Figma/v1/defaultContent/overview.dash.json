                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "user.handle_uniqueValues",
                                    "type": "nominal",
                                    "title": "Created By"
                                },
                                "y": {
                                    "field": "count",
                                    "type": "quantitative",
                                    "title": "Count"
                                }
                            },
                            "style": {
                                "legendPosition": "none",
                                "cartesianShowXAxisTitle": true,
                                "cartesianShowYAxisTitle": true
                            }
                        }
                    }
                }
