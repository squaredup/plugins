                                        }
                                    },
                                    {
                                        "field": "updated_at",
                                        "title": "Updated",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    },
                                    {
                                        "field": "fileUrl",
                                        "title": "Open in Figma",
