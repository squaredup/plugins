{
    "name": "File Explorer",
    "schemaVersion": "1.5",
    "timeframe": "last24hours",
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "879f0ba8-5500-40c7-abcf-700f2eeb949b",
                "x": 0,
                "y": 0,
                "w": 4,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "File Summary",
                    "description": "Pick a project and a file to see its details",
                    "timeframe": "none",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[fileSummary]}}",
                        "name": "fileSummary",
                        "pluginConfigId": "{{configId}}"
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "name",
                                        "title": "Name",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "folder_name",
                                        "title": "Folder",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "last_touched_at",
                                        "title": "Last Touched",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    },
                                    {
                                        "field": "creator.handle",
                                        "title": "Created By",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "last_touched_by.handle",
                                        "title": "Last Touched By",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "thumbnail_url",
                                        "title": "Thumbnail",
                                        "renderer": {
                                            "type": "link"
                                        }
                                    },
                                    {
                                        "field": "editorType",
                                        "title": "Editor Type",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "version",
                                        "title": "Version",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "link_access",
                                        "title": "Link Access",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "role",
                                        "title": "Your Role",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "url",
                                        "title": "Open in Figma",
                                        "renderer": {
                                            "type": "link"
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableTranspose": true
                            }
                        }
                    }
                }
            },
            {
                "i": "050c42c8-d3f8-4f84-9c03-e41adb4432ff",
                "x": 0,
                "y": 4,
                "w": 2,
                "h": 6,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Version History",
                    "description": "",
                    "timeframe": "none",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[fileVersions]}}",
                        "name": "fileVersions",
                        "pluginConfigId": "{{configId}}"
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "versionName",
                                        "title": "Version",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "created_at",
                                        "title": "Created",
                                        "renderer": {
                                            "type": "date"
                                        }
                                    },
                                    {
                                        "field": "user.handle",
                                        "title": "Created By",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    }
                                ]
                            }
                        }
                    }
                }
            },
            {
                "i": "d90d070c-2800-4229-b237-4272cc3b8187",
                "x": 2,
                "y": 4,
                "w": 2,
                "h": 6,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Comments",
                    "description": "",
                    "timeframe": "none",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[fileComments]}}",
                        "name": "fileComments",
                        "pluginConfigId": "{{configId}}"
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "message",
                                        "title": "Message",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "user.handle",
                                        "title": "Author",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "created_at",
                                        "title": "Created",
                                        "renderer": {
                                            "type": "date"
                                        }
                                    },
                                    {
                                        "field": "resolved_at",
                                        "title": "Resolved",
                                        "renderer": {
                                            "type": "date"
                                        }
                                    },
                                    {
                                        "field": "isReply",
                                        "title": "Is Reply",
                                        "renderer": {
                                            "type": "boolean",
                                            "trueLabel": "Yes",
                                            "falseLabel": "No",
                                            "trueColor": "inherit",
                                            "falseColor": "inherit"
                                        }
                                    }
                                ]
                            }
                        }
                    }
                }
            }
        ]
    }
}
