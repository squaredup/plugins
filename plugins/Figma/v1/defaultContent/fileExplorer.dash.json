                "config": {
                    "_type": "tile/data-stream",
                    "title": "Comments",
                    "description": "",
                    "timeframe": "none",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[fileComments]}}",
                        "name": "fileComments",
                        "pluginConfigId": "{{configId}}"
