                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Version History",
                    "description": "",
                    "timeframe": "none",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[fileVersions]}}",
                        "name": "fileVersions",
                        "pluginConfigId": "{{configId}}"
