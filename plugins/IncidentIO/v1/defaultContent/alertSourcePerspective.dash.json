{
    "name": "Alert Source",
    "schemaVersion": "1.5",
    "timeframe": "last7days",
    "variables": ["{{variables.[Alert Source]}}"],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "88d76e96-8593-4540-b5fc-a5828854bed2",
                "x": 0,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Firing Alerts",
                    "description": "Alerts from this source currently firing, regardless of when they started",
                    "activePluginConfigIds": ["{{configId}}"],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[alerts]}}",
                        "name": "alerts",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "alertSource": {
                                "variable": "{{variables.[Alert Source]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Alert Sources]}}"
                            },
                            "status": "firing"
                        },
                        "group": { "by": [], "aggregate": [{ "type": "count" }] }
                    },
                    "variables": ["{{variables.[Alert Source]}}"],
                    "visualisation": {
                        "type": "data-stream-scalar",
                        "config": {
                            "data-stream-scalar": {
                                "value": "count",
                                "comparisonColumn": "none",
                                "label": "Firing Alerts"
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [{ "field": "count", "type": "quantitative", "title": "Firing Alerts" }]
                            },
                            "style": { "scalarLabelPosition": "none" }
                        }
                    }
                }
            },
            {
                "i": "185dd750-6144-4d6f-8a13-3cf66983b80d",
                "x": 1,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Alerts",
                    "description": "Alerts from this source created in the timeframe",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[alerts]}}",
                        "name": "alerts",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "alertSource": {
                                "variable": "{{variables.[Alert Source]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Alert Sources]}}"
                            }
                        },
                        "group": { "by": [], "aggregate": [{ "type": "count" }] }
                    },
                    "variables": ["{{variables.[Alert Source]}}"],
                    "visualisation": {
                        "type": "data-stream-scalar",
                        "config": {
                            "data-stream-scalar": { "value": "count", "comparisonColumn": "none", "label": "Alerts" }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": { "values": [{ "field": "count", "type": "quantitative", "title": "Alerts" }] },
                            "style": { "scalarLabelPosition": "none" }
                        }
                    }
                }
            },
            {
                "i": "4c300f98-18a5-48c2-bf82-770da5461494",
                "x": 2,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Resolved Alerts",
                    "description": "Alerts from this source created in the timeframe and since resolved",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[alerts]}}",
                        "name": "alerts",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "alertSource": {
                                "variable": "{{variables.[Alert Source]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Alert Sources]}}"
                            }
                        },
                        "filter": {
                            "multiOperation": "and",
                            "filters": [{ "column": "status", "operation": "equals", "value": "resolved" }]
                        },
                        "group": { "by": [], "aggregate": [{ "type": "count" }] }
                    },
                    "variables": ["{{variables.[Alert Source]}}"],
                    "visualisation": {
                        "type": "data-stream-scalar",
                        "config": {
                            "data-stream-scalar": {
                                "value": "count",
                                "comparisonColumn": "none",
                                "label": "Resolved Alerts"
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [{ "field": "count", "type": "quantitative", "title": "Resolved Alerts" }]
                            },
                            "style": { "scalarLabelPosition": "none" }
                        }
                    }
                }
            },
            {
                "i": "af321eb7-e2e8-46ab-b996-920c9cdff662",
                "x": 3,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Avg Alert Duration",
                    "description": "Average minutes from creation to resolution (or now, if still firing)",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[alerts]}}",
                        "name": "alerts",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "alertSource": {
                                "variable": "{{variables.[Alert Source]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Alert Sources]}}"
                            }
                        },
                        "filter": {
                            "multiOperation": "and",
                            "filters": [{ "column": "durationMinutes", "operation": "notempty" }]
                        },
                        "group": { "by": [], "aggregate": [{ "type": "mean", "names": ["durationMinutes"] }] }
                    },
                    "variables": ["{{variables.[Alert Source]}}"],
                    "visualisation": {
                        "type": "data-stream-scalar",
                        "config": {
                            "data-stream-scalar": {
                                "value": "durationMinutes_mean",
                                "comparisonColumn": "none",
                                "label": "minutes"
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    { "field": "durationMinutes_mean", "type": "quantitative", "title": "minutes" }
                                ]
                            }
                        }
                    }
                }
            },
            {
                "i": "678ef3ee-0fae-43e2-9463-3afa36c2b24f",
                "x": 0,
                "y": 2,
                "w": 3,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Alerts Over Time",
                    "description": "Alerts from this source per day, firing vs resolved",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[alerts]}}",
                        "name": "alerts",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "alertSource": {
                                "variable": "{{variables.[Alert Source]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Alert Sources]}}"
                            }
                        },
                        "group": {
                            "by": [["created_at", "byDay"], ["status", "uniqueValues"]],
                            "aggregate": [{ "type": "count" }]
                        },
                        "sort": { "by": [["created_at_byDay", "asc"]] }
                    },
                    "variables": ["{{variables.[Alert Source]}}"],
                    "visualisation": {
                        "type": "data-stream-bar-chart",
                        "config": {
                            "data-stream-bar-chart": {
                                "xAxisData": "created_at_byDay",
                                "yAxisData": ["count"],
                                "xAxisGroup": "none",
                                "xAxisLabel": "",
                                "yAxisLabel": "",
                                "showXAxisLabel": true,
                                "showYAxisLabel": true,
                                "showLegend": false,
                                "legendPosition": "bottom",
                                "showGrid": true,
                                "horizontalLayout": "vertical",
                                "displayMode": "actual",
                                "showTotals": false,
                                "showValue": false,
                                "grouping": false,
                                "range": { "type": "auto" }
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": { "field": "created_at_byDay", "type": "temporal", "title": "Day" },
                                "y": { "field": "count", "type": "quantitative", "title": "Alerts" },
                                "series": { "field": "status_uniqueValues", "type": "nominal" }
                            },
                            "style": {
                                "cartesianStack": "on",
                                "legendPosition": "bottom",
                                "cartesianBarBorderRadius": 2,
                                "mappedColors": { "firing": "#ef4444", "resolved": "#22c55e" }
                            }
                        }
                    }
                }
            },
            {
                "i": "69a39765-9ec4-4677-a2b8-fa785ae759e2",
                "x": 3,
                "y": 2,
                "w": 1,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Noisiest Alerts",
                    "description": "Alert titles raised most often by this source",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[alerts]}}",
                        "name": "alerts",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "alertSource": {
                                "variable": "{{variables.[Alert Source]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Alert Sources]}}"
                            }
                        },
                        "group": { "by": [["title", "uniqueValues"]], "aggregate": [{ "type": "count" }] },
                        "sort": { "by": [["count", "desc"]], "top": 5 }
                    },
                    "variables": ["{{variables.[Alert Source]}}"],
                    "visualisation": {
                        "type": "data-stream-bar-chart",
                        "config": {
                            "data-stream-bar-chart": {
                                "xAxisData": "title_uniqueValues",
                                "yAxisData": ["count"],
                                "xAxisGroup": "none",
                                "xAxisLabel": "",
                                "yAxisLabel": "",
                                "showXAxisLabel": true,
                                "showYAxisLabel": true,
                                "showLegend": false,
                                "legendPosition": "bottom",
                                "showGrid": true,
                                "horizontalLayout": "horizontal",
                                "displayMode": "actual",
                                "showTotals": false,
                                "showValue": false,
                                "grouping": false,
                                "range": { "type": "auto" }
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": { "field": "title_uniqueValues", "type": "nominal" },
                                "y": { "field": "count", "type": "quantitative", "title": "Alerts" }
                            },
                            "style": { "cartesianHorizontal": true, "cartesianBarBorderRadius": 2 }
                        }
                    }
                }
            },
            {
                "i": "308c7121-9ffc-4b9a-a024-f6806eb0ea6c",
                "x": 0,
                "y": 6,
                "w": 4,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Recent Alerts",
                    "description": "Alerts from this source created in the timeframe, newest first",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[alerts]}}",
                        "name": "alerts",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "alertSource": {
                                "variable": "{{variables.[Alert Source]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Alert Sources]}}"
                            }
                        },
                        "sort": { "by": [["created_at", "desc"]] }
                    },
                    "variables": ["{{variables.[Alert Source]}}"],
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": [
                                    "alertState",
                                    "title",
                                    "status",
                                    "created_at",
                                    "resolved_at",
                                    "durationMinutes",
                                    "source_url"
                                ]
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "alertState",
                                        "title": "State",
                                        "renderer": { "type": "status", "showLabel": false },
                                        "width": 60
                                    },
                                    { "field": "title", "title": "Alert", "renderer": { "type": "text" } },
                                    {
                                        "field": "status",
                                        "title": "Status",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": { "firing": "#ef4444", "resolved": "#22c55e" }
                                        }
                                    },
                                    {
                                        "field": "created_at",
                                        "title": "Created",
                                        "renderer": { "type": "date", "relative": true }
                                    },
                                    { "field": "resolved_at", "title": "Resolved", "renderer": { "type": "date" } },
                                    {
                                        "field": "durationMinutes",
                                        "title": "Duration",
                                        "renderer": { "type": "number", "decimals": 0, "suffix": " min" },
                                        "align": "right"
                                    },
                                    { "field": "source_url", "title": "Source", "renderer": { "type": "link" } }
                                ]
                            },
                            "style": {
                                "richTableCellPadding": 6,
                                "richTableRowHighlight": {
                                    "field": "status",
                                    "colors": { "firing": "rgba(239,68,68,0.10)" }
                                }
                            }
                        }
                    }
                }
            },
            {
                "i": "2a05628d-eeae-446f-97ab-7d59e682d34c",
                "x": 0,
                "y": 10,
                "w": 4,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Properties",
                    "description": "",
                    "activePluginConfigIds": ["{{configId}}"],
                    "timeframe": "none",
                    "dataStream": { "id": "datastream-properties", "name": "properties" },
                    "scope": {
                        "scope": "{{scopes.[Alert Sources]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Alert Source]}}"
                    },
                    "variables": ["{{variables.[Alert Source]}}"],
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": true,
                                "columnOrder": ["name"],
                                "hiddenColumns": ["id", "links", "link", "type", "sourceId", "sourceType", "label"]
                            }
                        }
                    }
                }
            }
        ]
    }
}
