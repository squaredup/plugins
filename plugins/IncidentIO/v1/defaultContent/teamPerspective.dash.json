                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Duration Metrics by Severity",
                    "description": "Average of each duration metric for this team’s incidents, in hours",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[incidentDurationMetrics]}}",
