                "w": 2,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Team Incidents Over Time",
                    "description": "Incidents involving this team per day, by severity",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[incidents]}}",
                        "name": "incidents",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "team": {
                                "variable": "{{variables.[Team]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Teams]}}"
                            }
                        },
                        "group": {
                            "by": [["created_at", "byDay"], ["severity.name", "uniqueValues"]],
                            "aggregate": [{ "type": "count" }]
                        },
                        "sort": { "by": [["created_at_byDay", "asc"]] }
                    },
                    "variables": ["{{variables.[Team]}}"],
                    "visualisation": {
                        "type": "data-stream-bar-chart",
                        "config": {
                            "data-stream-bar-chart": {
                                "xAxisData": "created_at_byDay",
                                "yAxisData": ["count"],
                                "xAxisGroup": "none",
                                "xAxisLabel": "",
                                "yAxisLabel": "",
                                "showXAxisLabel": true,
                                "showYAxisLabel": true,
                                "showLegend": false,
                                "legendPosition": "bottom",
                                "showGrid": true,
                                "horizontalLayout": "vertical",
                                "displayMode": "actual",
                                "showTotals": false,
                                "showValue": false,
                                "grouping": false,
                                "range": { "type": "auto" }
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": { "field": "created_at_byDay", "type": "temporal", "title": "Day" },
                                "y": { "field": "count", "type": "quantitative", "title": "Incidents" },
                                "series": { "field": "severity.name_uniqueValues", "type": "nominal" }
                            },
                            "style": {
                                "cartesianStack": "on",
                                "legendPosition": "bottom",
                                "cartesianBarBorderRadius": 2,
                                "mappedColors": { "Critical": "#ef4444", "Major": "#f59e0b", "Minor": "#3b82f6" }
                            }
                        }
                    }
                }
            },
            {
                "i": "d70d9f92-cee0-4138-826d-673c48d39889",
