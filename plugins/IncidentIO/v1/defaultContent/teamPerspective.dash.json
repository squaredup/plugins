                                "x": { "field": "severity_uniqueValues", "type": "nominal", "title": "Severity" },
                                "y": { "field": "valueHours_mean", "type": "quantitative", "title": "Avg hours" },
                                "series": { "field": "metricName_uniqueValues", "type": "nominal" }
                            },
                            "style": { "legendPosition": "bottom", "cartesianBarBorderRadius": 2 }
                        }
                    }
                }
            },
            {
