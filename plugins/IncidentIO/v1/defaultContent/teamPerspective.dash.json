                                "variable": "{{variables.[Team]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Teams]}}"
                            }
                        },
                        "group": {
                            "by": [["severity", "uniqueValues"], ["metricName", "uniqueValues"]],
