                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Open Public Incidents",
                    "description": "Public incidents on this page that are not yet resolved",
                    "activePluginConfigIds": ["{{configId}}"],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[statusPageIncidents]}}",
                        "name": "statusPageIncidents",
                        "pluginConfigId": "{{configId}}",
                        "filter": {
                            "multiOperation": "and",
                            "filters": [{ "column": "incidentStatus", "operation": "notequals", "value": "resolved" }]
                        },
                        "group": { "by": [], "aggregate": [{ "type": "count" }] }
                    },
                    "scope": {
                        "scope": "{{scopes.[Status Pages]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Status Page]}}"
                    },
                    "variables": ["{{variables.[Status Page]}}"],
                    "visualisation": {
                        "type": "data-stream-scalar",
                        "config": {
                            "data-stream-scalar": {
                                "value": "count",
                                "comparisonColumn": "none",
                                "label": "Open Public Incidents"
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    { "field": "count", "type": "quantitative", "title": "Open Public Incidents" }
                                ]
                            },
                            "style": { "scalarLabelPosition": "none" }
                        }
                    }
                }
            },
