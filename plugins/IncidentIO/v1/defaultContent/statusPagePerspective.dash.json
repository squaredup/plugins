            {
                "i": "ac32a92c-f3f4-44d2-b922-0b4ba5442002",
                "x": 2,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Avg Public Incident Duration",
                    "description": "Average minutes from publishing to resolution for resolved public incidents",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[statusPageIncidents]}}",
                        "name": "statusPageIncidents",
                        "pluginConfigId": "{{configId}}",
                        "filter": {
                            "multiOperation": "and",
                            "filters": [{ "column": "durationMinutes", "operation": "notempty" }]
                        },
                        "group": { "by": [], "aggregate": [{ "type": "mean", "names": ["durationMinutes"] }] }
                    },
                    "scope": {
                        "scope": "{{scopes.[Status Pages]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Status Page]}}"
                    },
                    "variables": ["{{variables.[Status Page]}}"],
                    "visualisation": {
                        "type": "data-stream-scalar",
                        "config": {
                            "data-stream-scalar": {
                                "value": "durationMinutes_mean",
                                "comparisonColumn": "none",
                                "label": "minutes"
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    { "field": "durationMinutes_mean", "type": "quantitative", "title": "minutes" }
                                ]
                            }
                        }
                    }
                }
            },
