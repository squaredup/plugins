            {
                "i": "ee31161f-4dc2-49e0-a8fb-c41b71d5b5dc",
                "x": 0,
                "y": 2,
                "w": 4,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Public Incidents",
                    "description": "Public incidents that had an impact in the timeframe, newest first",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[statusPageIncidents]}}",
                        "name": "statusPageIncidents",
                        "pluginConfigId": "{{configId}}",
                        "sort": { "by": [["publishedAt", "desc"]] }
                    },
                    "scope": {
                        "scope": "{{scopes.[Status Pages]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Status Page]}}"
                    },
                    "variables": ["{{variables.[Status Page]}}"],
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": [
                                    "statusState",
                                    "name",
                                    "incidentStatus",
                                    "worstImpact",
                                    "publishedAt",
                                    "resolvedAt",
                                    "durationMinutes",
                                    "latestUpdate"
                                ]
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "statusState",
                                        "title": "State",
                                        "renderer": { "type": "status", "showLabel": false },
                                        "width": 60
                                    },
                                    { "field": "name", "title": "Incident", "renderer": { "type": "text" } },
                                    {
                                        "field": "incidentStatus",
                                        "title": "Status",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "investigating": "#ef4444",
                                                "identified": "#ef4444",
                                                "monitoring": "#f59e0b",
                                                "resolved": "#22c55e"
                                            }
                                        }
                                    },
                                    {
                                        "field": "worstImpact",
                                        "title": "Worst Impact",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "degraded_performance": "#f59e0b",
                                                "partial_outage": "#f97316",
                                                "full_outage": "#ef4444"
                                            }
                                        }
                                    },
                                    {
                                        "field": "publishedAt",
                                        "title": "Published",
                                        "renderer": { "type": "date", "relative": true }
                                    },
                                    { "field": "resolvedAt", "title": "Resolved", "renderer": { "type": "date" } },
                                    {
                                        "field": "durationMinutes",
                                        "title": "Duration",
                                        "renderer": { "type": "number", "decimals": 0, "suffix": " min" },
                                        "align": "right"
                                    },
                                    {
                                        "field": "latestUpdate",
                                        "title": "Latest Update",
                                        "renderer": { "type": "text" }
                                    }
                                ]
                            },
                            "style": { "richTableCellPadding": 6, "richTableWrapText": true }
                        }
                    }
                }
            },
            {
                "i": "2eff6eaf-090e-4b07-a222-ff42df4170d0",
                "x": 0,
                "y": 6,
                "w": 2,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Public Incidents Over Time",
                    "description": "Public incidents per day, by worst component impact",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[statusPageIncidents]}}",
                        "name": "statusPageIncidents",
                        "pluginConfigId": "{{configId}}",
                        "group": {
                            "by": [["publishedAt", "byDay"], ["worstImpact", "uniqueValues"]],
                            "aggregate": [{ "type": "count" }]
                        },
                        "sort": { "by": [["publishedAt_byDay", "asc"]] }
                    },
                    "scope": {
                        "scope": "{{scopes.[Status Pages]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Status Page]}}"
                    },
                    "variables": ["{{variables.[Status Page]}}"],
                    "visualisation": {
                        "type": "data-stream-bar-chart",
                        "config": {
                            "data-stream-bar-chart": {
                                "xAxisData": "publishedAt_byDay",
                                "yAxisData": ["count"],
                                "xAxisGroup": "none",
                                "xAxisLabel": "",
                                "yAxisLabel": "",
                                "showXAxisLabel": true,
                                "showYAxisLabel": true,
                                "showLegend": false,
                                "legendPosition": "bottom",
                                "showGrid": true,
                                "horizontalLayout": "vertical",
                                "displayMode": "actual",
                                "showTotals": false,
                                "showValue": false,
                                "grouping": false,
                                "range": { "type": "auto" }
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": { "field": "publishedAt_byDay", "type": "temporal", "title": "Day" },
                                "y": { "field": "count", "type": "quantitative", "title": "Incidents" },
                                "series": { "field": "worstImpact_uniqueValues", "type": "nominal" }
                            },
                            "style": {
                                "cartesianStack": "on",
                                "legendPosition": "bottom",
                                "cartesianBarBorderRadius": 2,
                                "mappedColors": {
                                    "degraded_performance": "#f59e0b",
                                    "partial_outage": "#f97316",
                                    "full_outage": "#ef4444"
                                }
                            }
                        }
                    }
                }
            },
            {
                "i": "ed83587e-e7bc-476a-a2b1-48506e26a15e",
                "x": 2,
                "y": 6,
                "w": 2,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Components",
                    "description": "Components on this status page. Open a component for its availability",
                    "activePluginConfigIds": ["{{configId}}"],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[statusPageComponents]}}",
                        "name": "statusPageComponents",
                        "pluginConfigId": "{{configId}}",
                        "sort": { "by": [["groupName", "asc"]] }
                    },
                    "scope": {
                        "scope": "{{scopes.[Status Pages]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Status Page]}}"
                    },
                    "variables": ["{{variables.[Status Page]}}"],
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": ["name", "groupName", "subPageName", "hidden"]
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    { "field": "name", "title": "Component", "renderer": { "type": "text" } },
                                    { "field": "groupName", "title": "Group", "renderer": { "type": "text" } },
                                    { "field": "subPageName", "title": "Sub-page", "renderer": { "type": "text" } },
                                    {
                                        "field": "hidden",
                                        "title": "Hidden",
                                        "renderer": { "type": "boolean", "trueLabel": "Yes", "falseLabel": "No" }
                                    }
                                ]
                            },
                            "style": { "richTableCellPadding": 6 }
                        }
                    }
                }
            },
            {
                "i": "70034ee1-0219-4148-8a6e-567c0f67ba48",
