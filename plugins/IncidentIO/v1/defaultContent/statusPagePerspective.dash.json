{
    "name": "Status Page",
    "schemaVersion": "1.5",
    "timeframe": "last30days",
    "variables": ["{{variables.[Status Page]}}"],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
