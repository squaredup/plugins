{
    "name": "Status Page Component",
    "schemaVersion": "1.5",
    "timeframe": "last30days",
    "variables": ["{{variables.[Status Page Component]}}"],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "a7e279a1-a199-4435-9fdc-fef92b517b40",
                "x": 0,
                "y": 0,
                "w": 2,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Availability",
                    "description": "Availability of this component over the timeframe, as published on its status page. Scale starts at 90%",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[componentAvailability]}}",
                        "name": "componentAvailability",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Status Page Components]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Status Page Component]}}"
                    },
                    "variables": ["{{variables.[Status Page Component]}}"],
                    "visualisation": {
                        "type": "data-stream-scalar",
                        "config": {
                            "data-stream-scalar": {
                                "value": "availabilityPercent",
                                "comparisonColumn": "none",
                                "label": "Availability"
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "gauge",
                            "encoding": { "value": { "field": "availabilityPercent", "type": "quantitative" } },
                            "style": {
                                "gaugeMin": 90,
                                "gaugeMax": 100,
                                "gaugeBands": [
                                    { "to": 0.9, "color": "#ef4444" },
                                    { "to": 0.99, "color": "#f59e0b" },
                                    { "to": 1, "color": "#22c55e" }
                                ],
                                "gaugeLabelText": "Availability"
                            }
                        }
                    }
                }
            },
            {
                "i": "15a783c9-6a2e-43ac-b95a-7f401d2259a9",
                "x": 2,
                "y": 0,
                "w": 1,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Availability State",
                    "description": "Healthy at 99.9% or above, warning from 99%, error below 99%",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[componentAvailability]}}",
                        "name": "componentAvailability",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Status Page Components]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Status Page Component]}}"
                    },
                    "variables": ["{{variables.[Status Page Component]}}"],
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": ["componentName", "availabilityState"]
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "statusGrid",
                            "encoding": {
                                "label": { "field": "componentName", "type": "nominal" },
                                "status": { "field": "availabilityState", "type": "nominal" }
                            },
                            "style": { "statusGridColumnsPerRow": 1 }
                        }
                    }
                }
            },
            {
                "i": "9d6c9872-0d39-461b-8a4b-d8f042520b98",
                "x": 3,
                "y": 0,
                "w": 1,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Measurement Window",
                    "description": "The window the availability covers",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[componentAvailability]}}",
                        "name": "componentAvailability",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Status Page Components]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Status Page Component]}}"
                    },
                    "variables": ["{{variables.[Status Page Component]}}"],
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": true,
                                "columnOrder": ["groupName", "startAt", "endAt", "dataAvailableSince"]
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    { "field": "groupName", "title": "Group", "renderer": { "type": "text" } },
                                    { "field": "startAt", "title": "Window Start", "renderer": { "type": "date" } },
                                    { "field": "endAt", "title": "Window End", "renderer": { "type": "date" } },
                                    {
                                        "field": "dataAvailableSince",
                                        "title": "Data Since",
                                        "renderer": { "type": "date" }
                                    }
                                ]
                            },
                            "style": { "richTableTranspose": true }
                        }
                    }
                }
            },
            {
                "i": "48d92c27-b117-4078-813b-d835e61fc2f3",
                "x": 0,
                "y": 4,
                "w": 4,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Properties",
                    "description": "",
                    "activePluginConfigIds": ["{{configId}}"],
                    "timeframe": "none",
                    "dataStream": { "id": "datastream-properties", "name": "properties" },
                    "scope": {
                        "scope": "{{scopes.[Status Page Components]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Status Page Component]}}"
                    },
                    "variables": ["{{variables.[Status Page Component]}}"],
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": true,
                                "columnOrder": ["name"],
                                "hiddenColumns": ["id", "links", "link", "type", "sourceId", "sourceType", "label"]
                            }
                        }
                    }
                }
            }
        ]
    }
}
