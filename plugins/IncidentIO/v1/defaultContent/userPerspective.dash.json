{
    "name": "User",
    "schemaVersion": "1.5",
    "timeframe": "none",
    "variables": ["{{variables.[User]}}"],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "ea403429-2c93-4a8d-aab5-dd65ff79dba0",
                "x": 0,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "On Call Now",
                    "description": "Schedules this person is currently on call for",
                    "activePluginConfigIds": ["{{configId}}"],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[userSchedules]}}",
                        "name": "userSchedules",
                        "pluginConfigId": "{{configId}}",
                        "group": { "by": [], "aggregate": [{ "type": "distinctCount", "names": ["scheduleId"] }] }
                    },
                    "scope": {
                        "scope": "{{scopes.[Users]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[User]}}"
                    },
                    "variables": ["{{variables.[User]}}"],
                    "visualisation": {
                        "type": "data-stream-scalar",
                        "config": {
                            "data-stream-scalar": {
                                "value": "scheduleId_distinctCount",
                                "comparisonColumn": "none",
                                "label": "On Call Now"
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [{ "field": "scheduleId_distinctCount", "type": "quantitative", "title": "On Call Now" }]
                            },
                            "style": { "scalarLabelPosition": "none" }
                        }
                    }
                }
            },
            {
                "i": "b9863526-ab7c-4ae6-982e-9094847af329",
                "x": 1,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Outstanding Follow-ups",
                    "description": "Follow-ups assigned to this person that aren't completed",
                    "activePluginConfigIds": ["{{configId}}"],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[followUps]}}",
                        "name": "followUps",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "user": {
                                "variable": "{{variables.[User]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Users]}}"
                            }
                        },
                        "filter": {
                            "multiOperation": "and",
                            "filters": [{ "column": "status", "operation": "equals", "value": "outstanding" }]
                        },
                        "group": { "by": [], "aggregate": [{ "type": "count" }] }
                    },
                    "variables": ["{{variables.[User]}}"],
                    "visualisation": {
                        "type": "data-stream-scalar",
                        "config": {
                            "data-stream-scalar": {
                                "value": "count",
                                "comparisonColumn": "none",
                                "label": "Outstanding Follow-ups"
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    { "field": "count", "type": "quantitative", "title": "Outstanding Follow-ups" }
                                ]
                            },
                            "style": { "scalarLabelPosition": "none" }
                        }
                    }
                }
            },
            {
                "i": "759b6d9b-b1c5-458e-9ad7-ce1797c5a705",
                "x": 2,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Completed Follow-ups",
                    "description": "Follow-ups this person has completed",
                    "activePluginConfigIds": ["{{configId}}"],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[followUps]}}",
                        "name": "followUps",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "user": {
                                "variable": "{{variables.[User]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Users]}}"
                            }
                        },
                        "filter": {
                            "multiOperation": "and",
                            "filters": [{ "column": "status", "operation": "equals", "value": "completed" }]
                        },
                        "group": { "by": [], "aggregate": [{ "type": "count" }] }
                    },
                    "variables": ["{{variables.[User]}}"],
                    "visualisation": {
                        "type": "data-stream-scalar",
                        "config": {
                            "data-stream-scalar": {
                                "value": "count",
                                "comparisonColumn": "none",
                                "label": "Completed Follow-ups"
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    { "field": "count", "type": "quantitative", "title": "Completed Follow-ups" }
                                ]
                            },
                            "style": { "scalarLabelPosition": "none" }
                        }
                    }
                }
            },
            {
                "i": "f0672108-f93c-47f1-b076-334986dadd8d",
                "x": 3,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Oldest Outstanding Follow-up",
                    "description": "Age in days of this person’s oldest outstanding follow-up",
                    "activePluginConfigIds": ["{{configId}}"],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[followUps]}}",
                        "name": "followUps",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "user": {
                                "variable": "{{variables.[User]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Users]}}"
                            }
                        },
                        "filter": {
                            "multiOperation": "and",
                            "filters": [{ "column": "status", "operation": "equals", "value": "outstanding" }]
                        },
                        "group": { "by": [], "aggregate": [{ "type": "max", "names": ["ageDays"] }] }
                    },
                    "variables": ["{{variables.[User]}}"],
                    "visualisation": {
                        "type": "data-stream-scalar",
                        "config": {
                            "data-stream-scalar": {
                                "value": "ageDays_max",
                                "comparisonColumn": "none",
                                "label": "days"
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [{ "field": "ageDays_max", "type": "quantitative", "title": "days" }]
                            }
                        }
                    }
                }
            },
            {
                "i": "948f4040-0c1a-4d14-b5d8-ac424599bcef",
                "x": 0,
                "y": 2,
                "w": 2,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "On-Call Schedules",
                    "description": "Schedules this person is currently on call for",
                    "activePluginConfigIds": ["{{configId}}"],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[userSchedules]}}",
                        "name": "userSchedules",
                        "pluginConfigId": "{{configId}}",
                        "sort": { "by": [["end_at", "asc"]] }
                    },
                    "scope": {
                        "scope": "{{scopes.[Users]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[User]}}"
                    },
                    "variables": ["{{variables.[User]}}"],
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": ["scheduleName", "start_at", "end_at", "schedulePermalink"],
                                "hiddenColumns": ["scheduleId", "rotation_id", "layer_id"]
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    { "field": "scheduleName", "title": "Schedule", "renderer": { "type": "text" } },
                                    { "field": "start_at", "title": "Since", "renderer": { "type": "date" } },
                                    {
                                        "field": "end_at",
                                        "title": "Until",
                                        "renderer": { "type": "date", "relative": true }
                                    },
                                    { "field": "schedulePermalink", "title": "Link", "renderer": { "type": "link" } }
                                ]
                            },
                            "style": { "richTableRowLinkField": "schedulePermalink", "richTableCellPadding": 6 }
                        }
                    }
                }
            },
            {
                "i": "a63627c4-d151-47db-a4e7-4b7ea4848ef8",
                "x": 2,
                "y": 2,
                "w": 2,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Properties",
                    "description": "",
                    "activePluginConfigIds": ["{{configId}}"],
                    "timeframe": "none",
                    "dataStream": { "id": "datastream-properties", "name": "properties" },
                    "scope": {
                        "scope": "{{scopes.[Users]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[User]}}"
                    },
                    "variables": ["{{variables.[User]}}"],
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": true,
                                "columnOrder": ["name"],
                                "hiddenColumns": ["id", "links", "link", "type", "sourceId", "sourceType", "label"]
                            }
                        }
                    }
                }
            },
            {
                "i": "070f4a5f-bb3a-4574-aea2-66ccc74ce4b1",
                "x": 0,
                "y": 6,
                "w": 4,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Assigned Follow-ups",
                    "description": "All follow-ups assigned to this person, oldest first",
                    "activePluginConfigIds": ["{{configId}}"],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[followUps]}}",
                        "name": "followUps",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "user": {
                                "variable": "{{variables.[User]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Users]}}"
                            }
                        },
                        "sort": { "by": [["ageDays", "desc"]] }
                    },
                    "variables": ["{{variables.[User]}}"],
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": [
                                    "statusState",
                                    "title",
                                    "status",
                                    "priority",
                                    "assigneeTeam",
                                    "created_at",
                                    "ageDays"
                                ]
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "statusState",
                                        "title": "State",
                                        "renderer": { "type": "status", "showLabel": false },
                                        "width": 60
                                    },
                                    { "field": "title", "title": "Follow-up", "renderer": { "type": "text" } },
                                    {
                                        "field": "status",
                                        "title": "Status",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "outstanding": "#f59e0b",
                                                "completed": "#22c55e",
                                                "not_doing": "#94a3b8"
                                            }
                                        }
                                    },
                                    {
                                        "field": "priority",
                                        "title": "Priority",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "Urgent": "#ef4444",
                                                "High": "#f97316",
                                                "Medium": "#f59e0b",
                                                "Low": "#3b82f6"
                                            }
                                        }
                                    },
                                    { "field": "assigneeTeam", "title": "Team", "renderer": { "type": "text" } },
                                    {
                                        "field": "created_at",
                                        "title": "Created",
                                        "renderer": { "type": "date", "relative": true }
                                    },
                                    {
                                        "field": "ageDays",
                                        "title": "Age",
                                        "renderer": {
                                            "type": "number",
                                            "decimals": 1,
                                            "suffix": " days",
                                            "thresholds": [
                                                { "to": 7, "color": "#22c55e" },
                                                { "to": 30, "color": "#f59e0b" },
                                                { "to": 100000, "color": "#ef4444" }
                                            ]
                                        },
                                        "align": "right"
                                    }
                                ]
                            },
                            "style": { "richTableCellPadding": 6 }
                        }
                    }
                }
            }
        ]
    }
}
