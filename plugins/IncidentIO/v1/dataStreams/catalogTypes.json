{
    "name": "catalogTypes",
    "displayName": "Catalog Types",
    "description": "The catalog types chosen in the data source's Catalog types to import setting, one row per type. Used to import catalog entries",
    "tags": ["Catalog"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "v3/catalog_types",
        "postRequestScript": "catalogTypes.js"
    },
    "matches": "none",
    "visibility": { "type": "hidden" },
    "metadata": [
        { "name": "id", "displayName": "ID", "shape": "string", "visible": false },
        { "name": "name", "displayName": "Name", "shape": "string", "role": "label" },
        { "name": "typeName", "displayName": "Type Name", "shape": "string", "visible": false },
        { "name": "description", "displayName": "Description", "shape": "string" },
        { "name": "estimatedCount", "displayName": "Estimated Entries", "shape": ["number", { "decimalPlaces": 0 }] }
    ],
    "timeframes": false
}
