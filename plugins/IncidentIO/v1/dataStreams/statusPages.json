{
    "name": "statusPages",
    "displayName": "Status Pages",
    "description": "All status pages in the organization, one row per page",
    "tags": ["Status Pages"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "v2/status_pages",
        "pathToData": "status_pages",
        "paging": {
            "mode": "token",
            "pageSize": { "realm": "queryArg", "path": "page_size", "value": "100" },
            "in": { "realm": "payload", "path": "pagination_meta.after" },
            "out": { "realm": "queryArg", "path": "after" }
        }
    },
    "matches": "none",
    "visibility": { "type": "hidden" },
    "metadata": [
        { "name": "id", "displayName": "ID", "shape": "string", "visible": false },
        { "name": "name", "displayName": "Name", "shape": "string", "role": "label" },
        { "name": "description", "displayName": "Description", "shape": "string" },
        { "name": "public_url", "displayName": "Public URL", "shape": "url" }
    ],
    "timeframes": false
}
