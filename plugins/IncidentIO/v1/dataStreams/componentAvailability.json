{
    "name": "componentAvailability",
    "displayName": "Component Availability",
    "description": "Availability percentage of a status page component over the selected timeframe (up to 366 days)",
    "tags": ["Status Pages"],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "v2/status_pages/{{object.statusPageId}}/components/{{object.componentId}}/availability",
        "getArgs": [
            { "key": "start_at", "value": "{{timeframe.start}}" },
            { "key": "end_at", "value": "{{timeframe.end}}" }
        ],
        "postRequestScript": "componentAvailability.js"
    },
    "matches": { "sourceType": { "type": "oneOf", "values": ["Status Page Component"] } },
    "metadata": [
        { "name": "componentName", "displayName": "Component", "shape": "string", "role": "label" },
        { "name": "groupName", "displayName": "Group", "shape": "string" },
        { "name": "availabilityPercent", "displayName": "Availability", "shape": ["percent", { "decimalPlaces": 3 }] },
        { "name": "availabilityState", "displayName": "Availability State", "shape": "state" },
        { "name": "dataAvailableSince", "displayName": "Data Available Since", "shape": "date" },
        { "name": "startAt", "displayName": "Window Start", "shape": "date" },
        { "name": "endAt", "displayName": "Window End", "shape": "date" }
    ],
    "timeframes": [
        "last24hours",
        "last7days",
        "last30days",
        "thisMonth",
        "thisQuarter",
        "thisYear",
        "lastMonth",
        "lastQuarter",
        "lastYear"
    ]
}
