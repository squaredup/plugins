{
    "name": "alertSources",
    "displayName": "Alert Sources",
    "description": "All alert sources configured in the organization, one row per source",
    "tags": ["Alerts"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "v2/alert_sources",
        "postRequestScript": "alertSources.js",
        "paging": { "mode": "none" }
    },
    "matches": "none",
    "visibility": { "type": "hidden" },
    "metadata": [
        { "name": "id", "displayName": "ID", "shape": "string", "visible": false },
        { "name": "name", "displayName": "Name", "shape": "string", "role": "label" },
        { "name": "sourceType", "displayName": "Source Type", "shape": "string" },
        {
            "name": "owningTeamIds",
            "displayName": "Owning Team IDs",
            "shape": ["array", { "itemShape": "string" }],
            "visible": false
        },
        { "name": "autoResolveTimeoutMinutes", "displayName": "Auto-Resolve Timeout (min)", "shape": "number" },
        { "name": "autoResolveIncidentAlerts", "displayName": "Auto-Resolve Incident Alerts", "shape": "boolean" }
    ],
    "timeframes": false
}
