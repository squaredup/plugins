{
    "name": "statusPageComponents",
    "displayName": "Status Page Components",
    "description": "The components shown on a status page, one row per component",
    "tags": ["Status Pages"],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "v2/status_page_structures/{{object.rawId}}",
        "postRequestScript": "statusPageComponents.js"
    },
    "matches": { "sourceType": { "type": "oneOf", "values": ["Status Page"] } },
    "visibility": { "type": "hidden" },
    "metadata": [
        { "name": "id", "displayName": "ID", "shape": "string", "visible": false },
        { "name": "name", "displayName": "Name", "shape": "string", "role": "label" },
        { "name": "statusPageId", "displayName": "Status Page ID", "shape": "string", "visible": false },
        { "name": "statusPageName", "displayName": "Status Page", "shape": "string" },
        { "name": "groupName", "displayName": "Group", "shape": "string" },
        { "name": "subPageName", "displayName": "Sub-Page", "shape": "string" },
        { "name": "hidden", "displayName": "Hidden", "shape": "boolean" }
    ],
    "timeframes": false
}
