{
    "name": "mcpUsage",
    "displayName": "MCP usage",
    "description": "Pull requests that used MCP servers during review, with insight and tool call counts per server",
    "tags": ["Code Review", "Usage"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/v1/metrics/mcp",
        "pathToData": "data",
        "getArgs": [
            { "key": "start_date", "value": "{{timeframe.start.slice(0, 10)}}" },
            { "key": "end_date", "value": "{{timeframe.end.slice(0, 10)}}" },
            {
                "key": "repository_ids",
                "value": "{{repository && repository.length ? repository.map(o => [].concat(o.rawId)[0]).join(',') : null}}"
            },
            {
                "key": "user_ids",
                "value": "{{user && user.length ? user.map(o => [].concat(o.rawId)[0]).join(',') : null}}"
            }
        ],
        "paging": {
            "mode": "token",
            "pageSize": { "realm": "queryArg", "path": "limit", "value": "1000" },
            "in": { "realm": "payload", "path": "next_cursor" },
            "out": { "realm": "queryArg", "path": "cursor" }
        },
        "errorHandling": { "type": "script", "script": "errorHandling/mcpUsage.js" },
        "postRequestScript": "mcpUsage.js"
    },
    "matches": "none",
    "ui": [
        {
            "type": "objects",
            "name": "repository",
            "label": "Repository",
            "matches": { "sourceType": { "type": "oneOf", "values": ["Repository"] } }
        },
        {
            "type": "objects",
            "name": "user",
            "label": "User",
            "matches": { "sourceType": { "type": "oneOf", "values": ["User"] } }
        }
    ],
    "metadata": [
        { "name": "prUrl", "displayName": "Pull request", "shape": ["url", { "label": "#{{column.prNumber}}" }], "role": "link" },
        {
            "name": "prNumber",
            "displayName": "PR number",
            "shape": ["number", { "thousandsSeparator": false }],
            "visible": false
        },
        { "name": "merged_at", "displayName": "Merged", "shape": "date", "role": "timestamp" },
        { "name": "serverName", "displayName": "MCP server", "shape": "string", "role": "label" },
        { "name": "insightCount", "displayName": "Insights", "shape": "number" },
        { "name": "toolCallCount", "displayName": "Tool calls", "shape": "number" },
        { "name": "tools", "displayName": "Tools", "shape": "string" },
        { "name": "repository_id", "displayName": "Repository ID", "shape": "string", "visible": false },
        { "name": "author_id", "displayName": "Author ID", "shape": "string", "visible": false },
        { "name": "repositoryName", "displayName": "Repository", "sourceId": "repository_id", "sourceType": "Repository", "objectPropertyPath": "name" },
        { "name": "authorName", "displayName": "Author", "sourceId": "author_id", "sourceType": "User", "objectPropertyPath": "name" }
    ],
    "timeframes": ["last7days", "last30days", "thisMonth", "lastMonth", "thisQuarter", "lastQuarter"]
}
