{
    "name": "organizations",
    "displayName": "Organizations",
    "description": "CodeRabbit organizations the API key can access",
    "tags": ["Organization"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/v1/organizations",
        "pathToData": "organizations",
        "paging": {
            "mode": "token",
            "pageSize": { "realm": "queryArg", "path": "limit", "value": "100" },
            "in": { "realm": "payload", "path": "next_cursor" },
            "out": { "realm": "queryArg", "path": "cursor" }
        },
        "errorHandling": { "type": "path", "realm": "payload", "path": "error.message" }
    },
    "matches": "none",
    "metadata": [
        { "name": "name", "displayName": "Name", "shape": "string", "role": "label" },
        { "name": "provider", "displayName": "Git provider", "shape": "string" },
        { "name": "provider_organization_id", "displayName": "Provider organization ID", "shape": "string", "role": "id" },
        { "name": "id", "displayName": "CodeRabbit organization ID", "shape": "string", "visible": false }
    ],
    "timeframes": ["none"],
    "supportsNoneTimeframe": true,
    "defaultTimeframe": "none"
}
