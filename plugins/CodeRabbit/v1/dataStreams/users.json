{
    "name": "users",
    "displayName": "Users",
    "description": "CodeRabbit users with their seat assignment and role",
    "tags": ["Users", "License"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/v1/users",
        "pathToData": "users",
        "paging": {
            "mode": "token",
            "pageSize": { "realm": "queryArg", "path": "limit", "value": "100" },
            "in": { "realm": "payload", "path": "next_cursor" },
            "out": { "realm": "queryArg", "path": "cursor" }
        },
        "errorHandling": { "type": "path", "realm": "payload", "path": "error.message" }
    },
    "matches": "none",
    "metadata": [
        { "name": "username", "displayName": "Username", "shape": "string", "role": "label" },
        { "name": "user_id", "displayName": "User ID", "shape": "string", "role": "id", "visible": false },
        { "name": "seat_assigned", "displayName": "Seat assigned", "shape": "boolean" },
        { "name": "role_name", "displayName": "Role", "shape": "string" },
        { "sourceId": "user_id", "sourceType": "User", "name": "username" }
    ],
    "timeframes": ["none"],
    "supportsNoneTimeframe": true,
    "defaultTimeframe": "none"
}
