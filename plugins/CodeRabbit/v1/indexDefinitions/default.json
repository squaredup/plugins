{
    "steps": [
        {
            "name": "organizations",
            "dataStream": { "name": "organizations" },
            "timeframe": "none",
            "objectMapping": {
                "id": "provider_organization_id",
                "name": "name",
                "type": { "value": "Organization" },
                "properties": ["provider", { "codeRabbitId": "id" }]
            }
        },
        {
            "name": "repositories",
            "dataStream": { "name": "repositories" },
            "scope": {
                "query": "g.V().has(\"sourceType\", \"Organization\")"
            },
            "timeframe": "none",
            "objectMapping": {
                "id": "repository_id",
                "name": "repository_name",
                "type": { "value": "Repository" },
                "properties": [
                    "private",
                    { "groupPath": "group_path" },
                    { "installed": "is_installed" },
                    "organizationId",
                    "organizationName"
                ]
            },
            "dependsOn": ["organizations"]
        },
        {
            "name": "users",
            "dataStream": { "name": "users" },
            "timeframe": "none",
            "objectMapping": {
                "id": "user_id",
                "name": "username",
                "type": { "value": "User" },
                "properties": [
                    { "seatAssigned": "seat_assigned" },
                    { "role": "role_name" }
                ]
            }
        }
    ]
