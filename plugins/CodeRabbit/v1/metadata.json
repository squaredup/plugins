{
    "name": "coderabbit",
    "displayName": "CodeRabbit",
    "version": "1.0.0",
    "author": { "name": "@TimWheeler-SQUP", "type": "community" },
    "description": "Track CodeRabbit seat usage, adoption, pull request review times, review quality and security findings.",
    "category": "Analytics",
    "type": "hybrid",
    "schemaVersion": "2.1",
    "importNotSupported": false,
    "restrictedToPlatforms": [],
    "keywords": [
        "coderabbit",
        "code review",
        "ai",
        "pull requests",
        "developer productivity",
        "seats",
        "licenses",
        "security"
    ],
    "objectTypes": ["Organization", "Repository", "User"],
    "links": [
        {
            "category": "documentation",
            "url": "https://github.com/squaredup/plugins/blob/main/plugins/CodeRabbit/v1/docs/README.md",
            "label": "Help adding this plugin"
        },
        {
            "category": "source",
            "url": "https://github.com/squaredup/plugins/tree/main/plugins/CodeRabbit/v1",
            "label": "Repository"
        }
    ],
    "base": {
        "plugin": "WebAPI",
        "majorVersion": "1",
        "config": {
            "baseUrl": "https://api.coderabbit.ai",
            "authMode": "none",
            "headers": [
                {
                    "key": "x-coderabbitai-api-key",
                    "value": "{{apiKey}}"
                }
            ],
            "queryArgs": []
        }
    }
}
