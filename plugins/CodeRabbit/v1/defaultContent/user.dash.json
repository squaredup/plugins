            {
                "i": "d0312110-a50a-4382-9674-c50d6b2573ec",
                "x": 2,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Acceptance Rate",
                    "description": "Share of CodeRabbit findings that were accepted.",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "variables": [
                        "{{variables.[User]}}"
                    ],
                    "dataStream": {
                        "id": "datastream-sql",
                        "dataSourceConfig": {
                            "version": "2.0",
                            "sql": "SELECT AVG(\"acceptedCount\") * 100 AS \"acceptanceRate\" FROM \"dataset1\"",
                            "tables": [
                                {
                                    "tableName": "dataset1",
                                    "config": {
                                        "variables": [
                                            "{{variables.[User]}}"
                                        ],
                                        "activePluginConfigIds": [
                                            "{{configId}}"
                                        ],
                                        "dataStream": {
                                            "id": "{{dataStreams.[reviewComments]}}",
                                            "name": "reviewComments",
                                            "pluginConfigId": "{{configId}}",
                                            "dataSourceConfig": {
                                                "user": {
                                                    "variable": "{{variables.[User]}}",
                                                    "workspace": "{{workspaceId}}",
                                                    "scope": "{{scopes.[Users]}}"
                                                }
                                            }
                                        }
                                    }
                                }
                            ]
                        },
                        "metadata": [
                            {
                                "name": "acceptanceRate",
                                "shape": [
                                    "percent",
                                    {
                                        "decimalPlaces": 1
                                    }
                                ]
                            },
                            {
                                "pattern": ".*"
                            }
                        ]
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "gauge",
                            "encoding": {
                                "value": {
                                    "field": "acceptanceRate",
                                    "type": "quantitative",
                                    "title": "Acceptance Rate"
                                }
                            },
                            "style": {
                                "gaugeMin": 0,
                                "gaugeMax": 100,
                                "gaugeBands": [
                                    {
                                        "to": 0.6,
                                        "color": "#DE0038"
                                    },
                                    {
                                        "to": 0.8,
                                        "color": "#E18700"
                                    },
                                    {
                                        "to": 1,
                                        "color": "#259A51"
                                    }
                                ]
                            }
                        }
                    }
                }
            },
            {
                "i": "b5ac9a89-ef60-4eda-815a-8ac5b73b550b",
