                                    "type": "median",
                                    "names": [
                                        "hoursToMerge"
                                    ]
                                }
                            ]
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    {
                                        "field": "hoursToMerge_median",
                                        "type": "quantitative",
                                        "title": "Hours"
                                    }
                                ]
                            },
                            "style": {
                                "scalarLabelPosition": "none"
                            }
                        }
                    }
                }
            },
