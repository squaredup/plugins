                                            "dataSourceConfig": {
                                                "repository": {
                                                    "variable": "{{variables.[Repository]}}",
                                                    "workspace": "{{workspaceId}}",
                                                    "scope": "{{scopes.[Repositories]}}"
                                                }
                                            }
                                        }
                                    }
                                }
                            ]
                        },
                        "metadata": [
                            {
                                "name": "acceptanceRate",
                                "shape": [
                                    "percent",
                                    {
                                        "decimalPlaces": 1
                                    }
                                ]
                            },
                            {
                                "pattern": ".*"
                            }
                        ]
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "ringGrid",
                            "encoding": {
                                "value": {
                                    "field": "acceptanceRate",
                                    "type": "quantitative",
                                    "title": "Acceptance Rate"
                                },
                                "label": {
                                    "field": "category",
                                    "type": "nominal",
                                    "title": "Category"
                                }
                            },
                            "style": {
                                "ringGridMax": 100,
                                "ringGridThresholds": [
                                    {
                                        "to": 0.6,
                                        "color": "#DE0038"
                                    },
                                    {
                                        "to": 0.8,
                                        "color": "#E18700"
                                    },
                                    {
                                        "to": 1,
                                        "color": "#259A51"
                                    }
                                ]
                            }
                        }
                    }
                }
            },
            {
                "i": "83b0df73-2b8f-471f-9fd2-3176efbffdac",
                "x": 2,
                "y": 6,
                "w": 2,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Critical and Major Findings",
                    "description": "",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "variables": [
                        "{{variables.[Repository]}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[reviewComments]}}",
                        "name": "reviewComments",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "repository": {
                                "variable": "{{variables.[Repository]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Repositories]}}"
                            }
                        },
                        "filter": {
                            "multiOperation": "or",
                            "filters": [
                                {
                                    "column": "severity",
                                    "operation": "equals",
                                    "value": "Critical"
                                },
                                {
                                    "column": "severity",
                                    "operation": "equals",
                                    "value": "Major"
                                }
                            ]
                        },
                        "sort": {
                            "by": [
                                [
                                    "severityRank",
                                    "asc"
                                ],
                                [
                                    "merged_at",
                                    "desc"
                                ]
                            ]
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "severity",
                                        "title": "Severity",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "Critical": "#c01616",
                                                "Major": "#f97316",
                                                "Minor": "#f59e0b",
                                                "Trivial": "#3b82f6",
                                                "Info": "#94a3b8",
                                                "Unclassified": "#cbd5e1"
                                            }
                                        },
                                        "width": 100
                                    },
                                    {
                                        "field": "commentUrl",
                                        "title": "Finding",
                                        "renderer": {
                                            "type": "link",
                                            "labelField": "category"
                                        }
                                    },
                                    {
                                        "field": "prUrl",
                                        "title": "Pull Request",
                                        "renderer": {
                                            "type": "link",
                                            "labelField": "prNumber"
                                        },
                                        "width": 110
                                    },
                                    {
                                        "field": "repositoryName",
                                        "title": "Repository",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "accepted",
                                        "title": "Accepted",
                                        "renderer": {
                                            "type": "boolean",
                                            "trueLabel": "Yes",
                                            "falseLabel": "No"
                                        },
                                        "width": 100
                                    }
                                ]
                            },
                            "style": {}
                        }
                    }
                }
            },
            {
                "i": "65b021ef-6fd3-4d78-88bd-069f5855c1c6",
