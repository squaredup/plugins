                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "PRs Merged",
                    "description": "",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "variables": [
                        "{{variables.[Repository]}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[pullRequests]}}",
