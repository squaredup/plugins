                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "prUrl",
                                        "title": "Pull Request",
                                        "renderer": {
                                            "type": "link",
                                            "labelField": "prNumber"
                                        },
                                        "width": 110
