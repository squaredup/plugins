                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    {
                                        "field": "count",
                                        "type": "quantitative",
                                        "title": "PRs Merged"
                                    }
                                ]
                            },
                            "style": {
                                "scalarLabelPosition": "none"
                            }
                        }
                    }
                }
            },
            {
                "i": "33933337-ab10-49cc-8e53-b3f0e7f07061",
                "x": 0,
                "y": 2,
                "w": 2,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Time to Merge Trend",
                    "description": "Median hours from ready for review to merge, by merge day.",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "variables": [
                        "{{variables.[Repository]}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[pullRequests]}}",
                        "name": "pullRequests",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "status": "merged",
                            "repository": {
                                "variable": "{{variables.[Repository]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Repositories]}}"
                            }
                        },
                        "group": {
                            "by": [
                                [
                                    "merged_at",
                                    "byDay"
                                ]
                            ],
                            "aggregate": [
                                {
                                    "type": "median",
                                    "names": [
                                        "hoursToMerge"
                                    ]
                                }
                            ]
                        },
                        "sort": {
                            "by": [
                                [
                                    "merged_at_byDay",
                                    "asc"
                                ]
                            ]
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "line",
                            "encoding": {
                                "x": {
                                    "field": "merged_at_byDay",
                                    "type": "temporal",
                                    "title": "Merged"
                                },
                                "y": {
                                    "field": "hoursToMerge_median",
                                    "type": "quantitative",
                                    "title": "Hours to Merge"
                                }
                            },
                            "style": {
                                "legendPosition": "none",
                                "cartesianAreaGradient": true
                            }
                        }
                    }
                }
            },
            {
                "i": "a907092f-30e7-499b-8399-ea2ae5b8ef82",
                "x": 2,
                "y": 2,
                "w": 2,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Acceptance Rate by Severity",
                    "description": "",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "variables": [
                        "{{variables.[Repository]}}"
                    ],
                    "dataStream": {
                        "id": "datastream-sql",
                        "dataSourceConfig": {
                            "version": "2.0",
                            "sql": "SELECT\n    \"severity\",\n    MIN(\"severityRank\") AS \"severityRank\",\n    COUNT(*) AS \"findings\",\n    AVG(\"acceptedCount\") * 100 AS \"acceptanceRate\"\nFROM \"dataset1\"\nGROUP BY \"severity\"\nORDER BY \"severityRank\"",
                            "tables": [
                                {
                                    "tableName": "dataset1",
                                    "config": {
                                        "variables": [
                                            "{{variables.[Repository]}}"
                                        ],
                                        "activePluginConfigIds": [
                                            "{{configId}}"
                                        ],
                                        "dataStream": {
                                            "id": "{{dataStreams.[reviewComments]}}",
                                            "name": "reviewComments",
                                            "pluginConfigId": "{{configId}}",
                                            "dataSourceConfig": {
                                                "repository": {
                                                    "variable": "{{variables.[Repository]}}",
                                                    "workspace": "{{workspaceId}}",
                                                    "scope": "{{scopes.[Repositories]}}"
                                                }
                                            }
                                        }
                                    }
                                }
                            ]
                        },
                        "metadata": [
                            {
                                "name": "acceptanceRate",
                                "shape": [
                                    "percent",
                                    {
                                        "decimalPlaces": 1
                                    }
                                ]
                            },
                            {
                                "pattern": ".*"
                            }
                        ]
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "ringGrid",
                            "encoding": {
                                "value": {
                                    "field": "acceptanceRate",
                                    "type": "quantitative",
                                    "title": "Acceptance Rate"
                                },
                                "label": {
                                    "field": "severity",
                                    "type": "nominal",
                                    "title": "Severity"
                                }
                            },
                            "style": {
                                "ringGridMax": 100,
                                "ringGridThresholds": [
                                    {
                                        "to": 0.6,
                                        "color": "#DE0038"
                                    },
                                    {
                                        "to": 0.8,
                                        "color": "#E18700"
                                    },
                                    {
                                        "to": 1,
                                        "color": "#259A51"
                                    }
                                ]
                            }
                        }
                    }
                }
            },
            {
                "i": "87da594e-999f-422d-9fe0-8043c7728527",
                "x": 0,
                "y": 6,
                "w": 2,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Acceptance Rate by Category",
                    "description": "",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "variables": [
                        "{{variables.[Repository]}}"
                    ],
                    "dataStream": {
                        "id": "datastream-sql",
                        "dataSourceConfig": {
                            "version": "2.0",
                            "sql": "SELECT\n    \"category\",\n    MIN(\"severityRank\") AS \"severityRank\",\n    COUNT(*) AS \"findings\",\n    AVG(\"acceptedCount\") * 100 AS \"acceptanceRate\"\nFROM \"dataset1\"\nGROUP BY \"category\"\nORDER BY \"acceptanceRate\" DESC",
                            "tables": [
                                {
                                    "tableName": "dataset1",
                                    "config": {
                                        "variables": [
                                            "{{variables.[Repository]}}"
                                        ],
                                        "activePluginConfigIds": [
                                            "{{configId}}"
                                        ],
                                        "dataStream": {
                                            "id": "{{dataStreams.[reviewComments]}}",
                                            "name": "reviewComments",
