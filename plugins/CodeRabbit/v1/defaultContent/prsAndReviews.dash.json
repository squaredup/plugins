            },
            {
                "i": "267b4bdd-4d22-49e4-b71f-8f496ebf7bbb",
                "x": 2,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Acceptance Rate",
                    "description": "Share of CodeRabbit findings that were accepted.",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "variables": [
                        "{{variables.[Repository]}}"
                    ],
                    "dataStream": {
                        "id": "datastream-sql",
                        "dataSourceConfig": {
                            "version": "2.0",
                            "sql": "SELECT AVG(\"acceptedCount\") * 100 AS \"acceptanceRate\" FROM \"dataset1\"",
                            "tables": [
                                {
                                    "tableName": "dataset1",
                                    "config": {
                                        "variables": [
                                            "{{variables.[Repository]}}"
                                        ],
                                        "activePluginConfigIds": [
                                            "{{configId}}"
                                        ],
                                        "dataStream": {
                                            "id": "{{dataStreams.[reviewComments]}}",
                                            "name": "reviewComments",
                                            "pluginConfigId": "{{configId}}",
                                            "dataSourceConfig": {
                                                "repository": {
                                                    "variable": "{{variables.[Repository]}}",
                                                    "workspace": "{{workspaceId}}",
                                                    "scope": "{{scopes.[Repositories]}}"
                                                }
                                            }
                                        }
                                    }
                                }
                            ]
                        },
                        "metadata": [
                            {
                                "name": "acceptanceRate",
                                "shape": [
                                    "percent",
                                    {
                                        "decimalPlaces": 1
                                    }
                                ]
                            },
                            {
                                "pattern": ".*"
                            }
                        ]
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "gauge",
                            "encoding": {
                                "value": {
                                    "field": "acceptanceRate",
                                    "type": "quantitative",
                                    "title": "Acceptance Rate"
                                }
                            },
                            "style": {
                                "gaugeMin": 0,
                                "gaugeMax": 100,
                                "gaugeBands": [
                                    {
                                        "to": 0.6,
                                        "color": "#DE0038"
                                    },
                                    {
                                        "to": 0.8,
                                        "color": "#E18700"
                                    },
                                    {
                                        "to": 1,
                                        "color": "#259A51"
                                    }
                                ]
                            }
                        }
                    }
                }
            },
            {
                "i": "f4f4c8ea-1460-4347-a046-35e6220b7984",
                "x": 3,
