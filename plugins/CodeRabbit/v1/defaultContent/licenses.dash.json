                    "dataStream": {
                        "id": "{{dataStreams.[pullRequests]}}",
                        "name": "pullRequests",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "status": "merged"
                        },
                        "group": {
                            "by": [
                                [
                                    "merged_at",
                                    "byDay"
                                ]
                            ],
                            "aggregate": [
                                {
                                    "type": "distinctCount",
                                    "names": [
                                        "author_id"
                                    ]
                                }
                            ]
                        },
                        "sort": {
                            "by": [
