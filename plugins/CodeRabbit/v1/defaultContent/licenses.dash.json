            {
                "i": "3f141345-2937-4a6c-add5-ccff36dae1ec",
                "x": 0,
                "y": 11,
                "w": 2,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Idle Seats",
                    "description": "Users holding a seat with no merged pull request in the timeframe.",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "datastream-sql",
                        "dataSourceConfig": {
                            "version": "2.0",
                            "sql": "SELECT u.\"username\" AS \"username\", u.\"role_name\" AS \"role\"\nFROM \"dataset1\" u\nWHERE u.\"seat_assigned\" = TRUE\n  AND CAST(u.\"user_id\" AS VARCHAR) NOT IN (\n      SELECT DISTINCT CAST(\"author_id\" AS VARCHAR) FROM \"dataset2\" WHERE \"author_id\" IS NOT NULL\n  )\nORDER BY u.\"username\"",
                            "tables": [
                                {
                                    "tableName": "dataset1",
                                    "config": {
                                        "timeframe": "none",
                                        "activePluginConfigIds": [
                                            "{{configId}}"
                                        ],
                                        "dataStream": {
                                            "id": "{{dataStreams.[users]}}",
                                            "name": "users",
                                            "pluginConfigId": "{{configId}}"
                                        }
                                    }
                                },
                                {
                                    "tableName": "dataset2",
                                    "config": {
                                        "activePluginConfigIds": [
                                            "{{configId}}"
                                        ],
                                        "dataStream": {
                                            "id": "{{dataStreams.[pullRequests]}}",
                                            "name": "pullRequests",
                                            "pluginConfigId": "{{configId}}",
                                            "dataSourceConfig": {
                                                "status": "merged"
                                            }
                                        }
                                    }
                                }
                            ]
                        },
                        "metadata": [
                            {
                                "pattern": ".*"
                            }
                        ]
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "username",
                                        "title": "Username",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "role",
                                        "title": "Role",
                                        "renderer": {
                                            "type": "text"
                                        },
                                        "width": 160
                                    }
                                ]
                            },
                            "style": {
                                "richTableSort": {
                                    "field": "username",
                                    "direction": "asc"
                                }
                            }
                        }
                    }
                }
            }
        ]
    }
