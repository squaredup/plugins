                        "version": "1.0",
                        "visualization": {
                            "chartType": "line",
                            "encoding": {
                                "x": {
                                    "field": "merged_at_byDay",
                                    "type": "temporal",
                                    "title": "Merged"
                                },
                                "y": {
                                    "field": "author_id_distinctCount",
                                    "type": "quantitative",
                                    "title": "Active Users"
                                }
                            },
                            "style": {
                                "legendPosition": "none",
                                "cartesianAreaGradient": true
                            }
                        }
                    }
