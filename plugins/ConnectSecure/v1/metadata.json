{
    "name": "connectsecure",
    "displayName": "ConnectSecure",
    "version": "1.0.0",
    "author": { "name": "@JackTSquppy", "type": "community" },
    "description": "Monitor managed companies' assets, vulnerabilities, compliance, and remediation status across your ConnectSecure tenant.",
    "category": "Security",
    "type": "hybrid",
    "schemaVersion": "2.1",
    "importNotSupported": false,
    "restrictedToPlatforms": [],
    "keywords": ["vulnerability management", "msp", "security", "compliance", "cybercns", "connectsecure"],
    "objectTypes": ["Company", "Agent", "Asset"],
    "links": [
        {
            "category": "documentation",
            "url": "https://github.com/squaredup/plugins/blob/main/plugins/ConnectSecure/v1/docs/README.md",
            "label": "Help adding this plugin"
        },
        {
            "category": "source",
            "url": "https://github.com/squaredup/plugins/tree/main/plugins/ConnectSecure/v1",
            "label": "Repository"
        }
    ],
    "base": {
        "plugin": "WebAPI",
        "majorVersion": "1",
        "config": {
            "baseUrl": "{{podBaseUrl}}",
            "authMode": "oauth2",
            "oauth2GrantType": "clientCredentials",
            "oauth2TokenUrl": "{{podBaseUrl}}/w/authorize",
            "oauth2ClientId": "notused",
            "oauth2ClientSecret": "notused",
            "oauth2ClientSecretLocationDuringAuth": "body",
            "oauth2TokenExtraHeaders": [
                {
                    "key": "Client-Auth-Token",
                    "value": "{{Buffer.from(tenantName + clientId + ':' + clientSecret).toString('base64')}}"
                }
            ],
            "headers": [
                { "key": "X-USER-ID", "value": "{{userId}}" },
                { "key": "Accept", "value": "application/json" }
            ],
            "queryArgs": []
        }
    }
}
