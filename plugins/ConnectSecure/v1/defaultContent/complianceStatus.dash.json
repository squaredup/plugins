                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Assessments by Status",
                    "description": "",
                    "timeframe": "none",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[complianceAssessments]}}",
                        "name": "complianceAssessments",
                        "pluginConfigId": "{{configId}}",
                        "group": {
                            "by": [["status", "uniqueValues"]],
                            "aggregate": [{ "type": "count" }]
                        }
                    },
                    "visualisation": {
                        "type": "data-stream-donut-chart",
                        "config": {
                            "data-stream-donut-chart": {
                                "valueColumn": "count",
                                "labelColumn": "status_uniqueValues",
                                "hideCenterValue": false,
                                "showValuesAsPercentage": true,
                                "legendPosition": "auto",
                                "legendMode": "table"
                            }
                        }
                    }
                }
            },
            {
                "i": "bbcd706f-183e-493b-8ea3-1d41a7ccb015",
                "x": 0,
                "y": 2,
                "w": 4,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Compliance Assessment Status by Company",
                    "description": "",
                    "timeframe": "none",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[complianceAssessments]}}",
                        "name": "complianceAssessments",
                        "pluginConfigId": "{{configId}}",
                        "sort": { "by": [["completed_time", "desc"]] }
                    },
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": [
                                    "companyName",
                                    "template_name",
                                    "status",
                                    "type",
                                    "completed_time"
                                ],
                                "hiddenColumns": [
                                    "current_section",
                                    "completed_section",
                                    "saq_type",
                                    "template_status",
                                    "created",
                                    "updated"
                                ]
                            }
                        }
                    }
                }
            },
            {
                "i": "009df7d9-97cb-4188-96fb-13b404f36fc6",
                "x": 0,
                "y": 6,
                "w": 4,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Companies with No Recent Assessment",
                    "description": "Assessments last completed more than 90 days ago, oldest first",
                    "timeframe": "none",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[complianceAssessments]}}",
                        "name": "complianceAssessments",
                        "pluginConfigId": "{{configId}}",
                        "filter": {
                            "multiOperation": "and",
                            "filters": [
                                {
                                    "column": "completed_time",
                                    "operation": "datemorethan",
                                    "value": "90",
                                    "unit": "days",
                                    "tenseUnit": "before"
                                }
                            ]
                        },
                        "sort": { "by": [["completed_time", "asc"]] }
                    },
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": [
                                    "companyName",
                                    "template_name",
                                    "status",
                                    "completed_time"
                                ],
                                "hiddenColumns": [
                                    "current_section",
                                    "completed_section",
                                    "saq_type",
                                    "template_status",
                                    "type",
                                    "created",
                                    "updated"
                                ]
                            }
                        }
                    }
                }
            }
        ]
    }
