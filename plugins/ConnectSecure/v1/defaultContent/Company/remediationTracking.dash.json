{
    "name": "Remediation Tracking",
    "schemaVersion": "1.5",
    "timeframe": "last24hours",
    "variables": ["{{variables.[Company]}}"],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "ed0c3ba2-248d-4e16-a072-3c8964779474",
                "x": 0,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Total Problems",
                    "description": "",
                    "timeframe": "none",
                    "activePluginConfigIds": ["{{configId}}"],
                    "variables": ["{{variables.[Company]}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[remediationPlan]}}",
                        "name": "remediationPlan",
                        "pluginConfigId": "{{configId}}",
                        "group": { "by": [], "aggregate": [{ "type": "sum", "names": ["total_problems"] }] }
                    },
                    "scope": {
                        "variable": "{{variables.[Company]}}",
                        "workspace": "{{workspaceId}}",
                        "scope": "{{scopes.[Companies]}}"
                    },
                    "visualisation": {
                        "type": "data-stream-scalar",
                        "config": {
                            "data-stream-scalar": { "value": "total_problems_sum", "comparisonColumn": "none" }
                        }
                    }
                }
