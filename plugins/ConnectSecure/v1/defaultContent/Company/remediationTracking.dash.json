                "x": 0,
                "y": 2,
                "w": 4,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Remediation Plan by Solution",
                    "description": "Affected assets and problem counts for each recommended remediation solution",
                    "timeframe": "none",
                    "activePluginConfigIds": ["{{configId}}"],
                    "variables": ["{{variables.[Company]}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[remediationPlan]}}",
                        "name": "remediationPlan",
                        "pluginConfigId": "{{configId}}",
                        "sort": { "by": [["total_problems", "desc"]] }
                    },
                    "scope": {
                        "variable": "{{variables.[Company]}}",
                        "workspace": "{{workspaceId}}",
                        "scope": "{{scopes.[Companies]}}"
                    },
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": [
                                    "product",
                                    "severity",
                                    "remediation_action",
                                    "os_name",
                                    "affected_assets",
                                    "critical_problems",
                                    "high_problems",
                                    "medium_problems",
                                    "low_problems",
                                    "total_problems",
                                    "is_patchable",
                                    "epss_vuls",
                                    "url"
                                ],
                                "hiddenColumns": ["solution_id", "fix"]
                            }
                        }
                    }
                }
            },
            {
                "i": "9b205791-960d-45ae-83e6-44fd6bc456a6",
                "x": 0,
                "y": 6,
                "w": 4,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Top Solutions by Problem Severity",
                    "description": "",
                    "timeframe": "none",
                    "activePluginConfigIds": ["{{configId}}"],
                    "variables": ["{{variables.[Company]}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[remediationPlan]}}",
                        "name": "remediationPlan",
                        "pluginConfigId": "{{configId}}",
                        "sort": { "by": [["total_problems", "desc"]], "top": 10 }
                    },
                    "scope": {
                        "variable": "{{variables.[Company]}}",
                        "workspace": "{{workspaceId}}",
                        "scope": "{{scopes.[Companies]}}"
                    },
                    "visualisation": {
                        "type": "data-stream-bar-chart",
                        "config": {
                            "data-stream-bar-chart": {
                                "xAxisData": "product",
                                "yAxisData": ["critical_problems", "high_problems", "medium_problems", "low_problems"],
                                "xAxisGroup": "none",
                                "xAxisLabel": "",
                                "yAxisLabel": "Problems",
                                "showXAxisLabel": false,
                                "showYAxisLabel": true,
                                "showLegend": true,
                                "legendPosition": "bottom",
                                "showGrid": true,
                                "horizontalLayout": "vertical",
                                "displayMode": "actual",
                                "showTotals": false,
                                "showValue": false,
                                "grouping": true,
                                "range": { "type": "auto" }
                            }
                        }
                    }
                }
            }
        ]
    }
