{
    "name": "remediationPlan",
    "displayName": "Remediation Plan",
    "description": "Recommended remediation solutions for a single managed company, with affected asset and severity counts",
    "tags": ["Company", "Remediation"],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/r/get_data/remediation_plan_companies",
        "getArgs": [
            { "key": "company_id", "value": "{{object.rawId}}" }
        ],
        "pathToData": "data"
    },
    "matches": { "sourceType": { "type": "oneOf", "values": ["Company"] } },
    "metadata": [
        { "name": "product", "displayName": "Solution", "shape": "string", "role": "label" },
        { "name": "solution_id", "displayName": "Solution ID", "shape": "string" },
        { "name": "severity", "displayName": "Severity", "shape": "string" },
        { "name": "remediation_action", "displayName": "Remediation Action", "shape": "string" },
        { "name": "os_name", "displayName": "OS", "shape": "string" },
        { "name": "fix", "displayName": "Recommended Fix", "shape": "string" },
        { "name": "is_patchable", "displayName": "Patchable", "shape": "boolean" },
        { "name": "affected_assets", "displayName": "Affected Assets", "shape": "number" },
        { "name": "critical_problems", "displayName": "Critical", "shape": "number" },
        { "name": "high_problems", "displayName": "High", "shape": "number" },
        { "name": "medium_problems", "displayName": "Medium", "shape": "number" },
        { "name": "low_problems", "displayName": "Low", "shape": "number" },
        { "name": "total_problems", "displayName": "Total Problems", "shape": "number" },
        { "name": "epss_vuls", "displayName": "EPSS Score", "shape": "number" },
        { "name": "fix_script", "displayName": "Fix Script", "shape": "string", "visible": false },
        { "name": "url", "displayName": "Reference URL", "shape": "url" },
        { "name": "total_count", "displayName": "Company Solution Count", "shape": "number", "visible": false }
    ],
    "timeframes": false
}
