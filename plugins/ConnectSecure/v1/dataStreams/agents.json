{
    "name": "agents",
    "displayName": "Agents",
    "description": "ConnectSecure agents installed across your managed companies",
    "tags": ["Agent"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/r/company/agents",
        "paging": {
            "mode": "offset",
            "pageSize": { "realm": "queryArg", "path": "limit", "value": "5000" },
            "offset": {
                "mode": "row",
                "rowCountIn": { "realm": "payloadArraySize", "path": "data" },
                "base": 0
            },
            "out": { "realm": "queryArg", "path": "skip" }
        },
        "postRequestScript": "agents.js"
    },
    "matches": "none",
    "ui": [
        {
            "type": "objects",
            "name": "company",
            "label": "Company (optional)",
            "matches": {
                "sourceType": { "type": "oneOf", "values": ["Company"] }
            }
        }
    ],
    "metadata": [
        { "name": "id", "displayName": "ID", "shape": "string", "visible": false },
        { "name": "host_name", "displayName": "Hostname", "shape": "string", "role": "label" },
        { "name": "ip", "displayName": "IP Address", "shape": "string" },
        { "name": "mac", "displayName": "MAC Address", "shape": "string" },
        { "name": "os_name", "displayName": "OS Name", "shape": "string" },
        { "name": "os_version", "displayName": "OS Version", "shape": "string" },
        { "name": "os_platform", "displayName": "OS Platform", "shape": "string" },
        { "name": "agent_version", "displayName": "Agent Version", "shape": "string" },
        { "name": "agent_type", "displayName": "Agent Type", "shape": "string" },
        { "name": "company_id", "displayName": "Company ID", "shape": "string", "visible": false },
        { "name": "companyName", "displayName": "Company", "sourceId": "company_id", "sourceType": "Company", "objectPropertyPath": "name" },
        { "name": "is_deprecated", "displayName": "Deprecated", "shape": "boolean" },
        { "name": "last_reported", "displayName": "Last Reported", "shape": "date" },
        { "name": "last_ping_time", "displayName": "Last Ping", "shape": "date" },
        { "name": "last_scanned_time", "displayName": "Last Scanned", "shape": "date" },
        { "name": "created", "displayName": "Created", "shape": "date" },
        { "name": "updated", "displayName": "Updated", "shape": "date" }
    ],
    "timeframes": false
}
