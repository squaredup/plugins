{
    "name": "companies",
    "displayName": "Companies",
    "description": "Managed companies in your ConnectSecure tenant",
    "tags": ["Company"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/r/company/companies",
        "pathToData": "data",
        "paging": {
            "mode": "offset",
            "pageSize": { "realm": "queryArg", "path": "limit", "value": "5000" },
            "offset": {
                "mode": "row",
                "rowCountIn": { "realm": "payloadArraySize", "path": "data" },
                "base": 0
            },
            "out": { "realm": "queryArg", "path": "skip" }
        }
    },
    "matches": "none",
    "visibility": { "type": "hidden" },
    "metadata": [
        { "name": "id", "displayName": "ID", "shape": "string", "visible": false },
        { "name": "name", "displayName": "Name", "shape": "string", "role": "label" },
        { "name": "domain", "displayName": "Domain", "shape": "string" },
        { "name": "description", "displayName": "Description", "shape": "string" },
        { "name": "tags", "displayName": "Tags", "shape": "string" },
        { "name": "is_deleted", "displayName": "Deleted", "shape": "boolean" },
        { "name": "address_country", "displayName": "Country", "shape": "string" },
        { "name": "address_state", "displayName": "State", "shape": "string" },
        { "name": "address_city", "displayName": "City", "shape": "string" },
        { "name": "created", "displayName": "Created", "shape": "date" },
        { "name": "updated", "displayName": "Updated", "shape": "date" }
    ],
    "timeframes": false
}
