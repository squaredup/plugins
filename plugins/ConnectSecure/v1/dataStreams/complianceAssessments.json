{
    "name": "complianceAssessments",
    "displayName": "Compliance Assessments",
    "description": "Compliance assessment status across your managed companies",
    "tags": ["Company", "Compliance"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/r/company/compliance_assessment",
        "postRequestScript": "complianceAssessments.js",
        "paging": {
            "mode": "offset",
            "pageSize": { "realm": "queryArg", "path": "limit", "value": "5000" },
            "offset": {
                "mode": "row",
                "rowCountIn": { "realm": "payloadArraySize", "path": "data" },
                "base": 0
            },
            "out": { "realm": "queryArg", "path": "skip" }
        }
    },
    "matches": "none",
    "ui": [
        {
            "type": "objects",
            "name": "company",
            "label": "Company (optional)",
            "matches": {
                "sourceType": { "type": "oneOf", "values": ["Company"] }
            }
        }
    ],
    "metadata": [
        { "name": "id", "displayName": "ID", "shape": "string", "visible": false },
        { "name": "company_id", "displayName": "Company ID", "shape": "string", "visible": false },
        { "name": "companyName", "displayName": "Company", "sourceId": "company_id", "sourceType": "Company", "objectPropertyPath": "name" },
        { "name": "tenantid", "displayName": "Tenant ID", "shape": "string", "visible": false },
        { "name": "template_name", "displayName": "Template Name", "shape": "string", "role": "label" },
        { "name": "template_status", "displayName": "Template Status", "shape": "boolean" },
        { "name": "status", "displayName": "Status", "shape": "string" },
        { "name": "type", "displayName": "Assessment Type", "shape": "string" },
        { "name": "current_section", "displayName": "Current Section", "shape": "string" },
        { "name": "completed_section", "displayName": "Completed Section", "shape": "string" },
        { "name": "completed_time", "displayName": "Completed", "shape": "date" },
        { "name": "saq_type", "displayName": "SAQ Type", "shape": "string" },
        { "name": "download_url", "displayName": "Download URL", "shape": "string" },
        { "name": "compliance_assessment", "displayName": "Assessment Detail", "shape": "json", "visible": false },
        { "name": "created", "displayName": "Created", "shape": "date" },
        { "name": "updated", "displayName": "Updated", "shape": "date" }
    ],
    "timeframes": false
}
