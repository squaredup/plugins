{
    "name": "companyStats",
    "displayName": "Company Stats",
    "description": "Asset, vulnerability, and compliance summary statistics per managed company",
    "tags": ["Company", "Vulnerability", "Compliance"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/r/company/company_stats",
        "paging": {
            "mode": "offset",
            "pageSize": { "realm": "queryArg", "path": "limit", "value": "5000" },
            "offset": {
                "mode": "row",
                "rowCountIn": { "realm": "payloadArraySize", "path": "data" },
                "base": 0
            },
            "out": { "realm": "queryArg", "path": "skip" }
        },
        "expandInnerObjects": true,
        "postRequestScript": "companyStats.js"
    },
    "matches": "none",
    "ui": [
        {
            "type": "objects",
            "name": "company",
            "label": "Company (optional)",
            "matches": {
                "sourceType": { "type": "oneOf", "values": ["Company"] }
            }
        }
    ],
    "metadata": [
        { "name": "id", "displayName": "ID", "shape": "string", "visible": false },
        { "name": "company_id", "displayName": "Company ID", "shape": "string", "visible": false },
        { "name": "companyName", "displayName": "Company", "sourceId": "company_id", "sourceType": "Company", "objectPropertyPath": "name" },
        { "name": "tenantid", "displayName": "Tenant ID", "shape": "string", "visible": false },
        { "name": "date", "displayName": "Date", "shape": "date" },
        { "name": "total_assets", "displayName": "Total Assets", "shape": "number" },
        { "name": "total_assets_external", "displayName": "Total External Assets", "shape": "number" },
        { "name": "asset_vul_stats.avg_risk_score", "displayName": "Vulnerability Risk Score (Avg)", "shape": "number" },
        { "name": "asset_vul_stats.max_risk_score", "displayName": "Vulnerability Risk Score (Max)", "shape": "number" },
        { "name": "external_asset_vul_stats.avg_risk_score", "displayName": "External Vulnerability Risk Score (Avg)", "shape": "number" },
        { "name": "external_asset_vul_stats.max_risk_score", "displayName": "External Vulnerability Risk Score (Max)", "shape": "number" },
        { "name": "compliance_stats.cis.compliant", "displayName": "CIS Compliant", "shape": "number" },
        { "name": "compliance_stats.cis.non_compliant", "displayName": "CIS Non-Compliant", "shape": "number" },
        { "name": "compliance_stats.cis.risk_score", "displayName": "CIS Risk Score", "shape": "number" },
        { "name": "compliance_stats.hipaa.compliant", "displayName": "HIPAA Compliant", "shape": "number" },
