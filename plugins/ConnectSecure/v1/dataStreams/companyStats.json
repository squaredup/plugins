        { "name": "compliance_stats.hipaa.risk_score", "displayName": "HIPAA Risk Score", "shape": "number" },
        { "name": "compliance_stats.iso_27002.compliant", "displayName": "ISO 27002 Compliant", "shape": "number" },
        { "name": "compliance_stats.iso_27002.non_compliant", "displayName": "ISO 27002 Non-Compliant", "shape": "number" },
        { "name": "compliance_stats.iso_27002.risk_score", "displayName": "ISO 27002 Risk Score", "shape": "number" },
        { "name": "compliance_stats.nist_50083.compliant", "displayName": "NIST 50083 Compliant", "shape": "number" },
