{
    "name": "technicians",
    "displayName": "Technicians",
    "description": "All technicians in TANSS",
    "tags": ["Users"],
    "baseDataSourceName": "httpRequestUnscoped",
    "matches": "none",
    "timeframes": false,
    "config": {
        "httpMethod": "get",
        "endpointPath": "employees/technicians",
        "pathToData": "content",
        "paging": { "mode": "none" },
        "errorHandling": { "type": "path", "realm": "payload", "path": "error.text" }
    },
    "metadata": [
        { "name": "id", "displayName": "Technician ID", "shape": "string", "visible": false },
        { "name": "name", "visible": false },
        { "name": "firstName", "displayName": "First Name" },
        { "name": "lastName", "displayName": "Last Name" },
        {
            "name": "displayName",
            "displayName": "Name",
            "computed": true,
            "role": "label",
            "valueExpression": "{{ $['name'] || [$['firstName'], $['lastName']].filter(Boolean).join(' ') || ('Technician ' + $['id']) }}"
        },
        { "name": "emailAddress", "displayName": "Email" },
        { "name": "departmentId", "displayName": "Department ID", "shape": "string", "visible": false },
        { "pattern": ".*" }
    ]
}
