{
    "name": "tanss",
    "displayName": "TANSS",
    "version": "1.0.0",
    "author": {
        "name": "@vincentbabin-squp",
        "type": "labs"
    },
    "description": "Monitor open tickets, technician workload, and logged working time from TANSS.",
    "category": "Service Management",
    "type": "hybrid",
    "schemaVersion": "2.1",
    "importNotSupported": false,
    "restrictedToPlatforms": [],
    "keywords": ["tanss", "tickets", "psa", "itsm", "msp", "helpdesk", "time tracking"],
    "objectTypes": ["Technician", "Company"],
    "links": [
        {
            "category": "documentation",
            "url": "https://github.com/squaredup/plugins/blob/main/plugins/TANSS/v1/docs/README.md",
            "label": "Help adding this plugin"
        },
        {
            "category": "source",
            "url": "https://github.com/squaredup/plugins/tree/main/plugins/TANSS/v1",
            "label": "Repository"
        }
    ],
    "base": {
        "plugin": "WebAPI",
        "majorVersion": "1",
        "config": {
            "baseUrl": "{{tanssUrl}}/api/v1",
            "authMode": "none",
            "headers": [
                {
                    "key": "apiToken",
                    "value": "{{apiToken.startsWith('Bearer ') ? apiToken : 'Bearer ' + apiToken}}"
                }
            ],
            "queryArgs": []
        }
    }
}
