{
    "name": "topSearches",
    "displayName": "Top Searches",
    "description": "Most frequent search queries for an index over the selected timeframe",
    "tags": [],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "baseUrl": "https://analytics.{{dataSource.analyticsRegion || 'us'}}.algolia.com",
        "endpointPath": "/2/searches",
        "getArgs": [
            { "key": "index", "value": "{{object.rawId}}" },
            { "key": "startDate", "value": "{{timeframe.start.slice(0,10)}}" },
            { "key": "endDate", "value": "{{timeframe.end.slice(0,10)}}" },
            { "key": "limit", "value": "50" }
        ],
        "pathToData": "searches",
        "paging": { "mode": "none" }
    },
    "matches": { "sourceType": { "type": "equals", "value": "Algolia Index" } },
    "metadata": [
        {
            "name": "search",
            "displayName": "Search",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "count",
            "displayName": "Count",
            "shape": ["number", { "decimalPlaces": 0 }]
        },
        {
            "name": "nbHits",
            "displayName": "Results",
            "shape": ["number", { "decimalPlaces": 0 }]
        }
    ],
    "timeframes": true
}
