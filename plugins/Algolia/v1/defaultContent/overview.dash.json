{
    "name": "Overview",
    "schemaVersion": "1.5",
    "timeframe": "last7days",
    "variables": [],
    "dashboard": {
        "_type": "layout/grid",
        "version": 50,
        "columns": 4,
        "contents": [
            {
                "i": "66e90a23-50f4-4e6b-b6b1-b8036378e1f7",
