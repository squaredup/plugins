{
    "author": {
        "name": "SquaredUp",
        "type": "firstParty"
    },
    "base": {
        "config": {
            "authMode": "none",
            "baseUrl": "https://",
            "headers": [
                {
                    "key": "Accept",
                    "value": "application/vnd.github+json"
                },
                {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}"
                },
                {
                    "key": "X-GitHub-Api-Version",
                    "value": "2022-11-28"
                }
            ],
            "queryArgs": []
        },
        "majorVersion": "1",
        "plugin": "WebAPI"
    },
    "category": "Version Control",
    "description": "Monitor the Incidents, Issues and Pull Requests from your GitHub environment.",
    "displayName": "GitHub",
    "links": [
        {
            "category": "documentation",
            "label": "Help adding this plugin",
            "url": "https://docs.squaredup.com/data-sources/github-plugin"
        },
        {
            "category": "marketing",
            "label": "Learn more",
            "url": "https://squaredup.com/plugins/github/"
        }
    ],
    "name": "github",
    "schemaVersion": "2.0",
    "type": "cloud",
    "version": "2.0.0"
}
