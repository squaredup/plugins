{
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "endpointPath": "api.github.com/{{typeof repos !== 'undefined' && repos.length > 0 ? `repos/${repos[0].fullName}` : `orgs/${dataSource.org}`}}/secret-scanning/alerts",
        "expandInnerObjects": true,
        "getArgs": [
            {
                "key": "state",
                "value": "{{state}}"
            },
            {
                "key": "validity",
                "value": "{{typeof validity !== 'undefined' ? validity.join(',') : ''}}"
            },
            {
                "key": "direction",
                "value": "desc"
            }
        ],
        "headers": [],
        "httpMethod": "get",
        "paging": {
            "in": {
                "path": "next",
                "realm": {
                    "label": "Web link",
                    "value": "webLink"
                }
            },
            "mode": "nextUrl",
            "pageSize": {
                "path": "per_page",
                "realm": {
                    "label": "Query parameter",
                    "value": "queryArg"
                },
                "value": "100"
            }
        },
        "postRequestScript": "secretScan.js"
    },
    "displayName": "Secret Scanning",
    "manualConfigApply": true,
    "metadata": [
        {
            "displayName": "Number",
            "name": "html_url",
            "shape": [
                "url",
                {
                    "label": "{{column.number}}"
                }
            ]
        },
        {
            "displayName": "Title",
            "name": "secret_type_display_name",
            "shape": "string"
        },
        {
            "displayName": "State",
            "name": "state",
            "shape": "string"
        },
        {
            "displayName": "Validity",
            "name": "validity",
            "shape": "string"
        },
        {
            "displayName": "Publicly Leaked",
            "name": "publicly_leaked",
            "shape": "boolean"
        },
        {
            "displayName": "Repository",
            "name": "repo",
            "shape": "string"
        },
        {
            "displayName": "Created At",
            "name": "created_at",
            "shape": "date"
        },
        {
            "displayName": "Updated At",
            "name": "updated_at",
            "shape": "date"
        },
        {
            "displayName": "Resolved At",
            "name": "resolved_at",
            "shape": "date"
        },
        {
            "displayName": "Resolved By",
            "name": "resolved_by_login",
            "shape": "string"
        },
        {
            "displayName": "Secret Type",
            "name": "secret_type",
            "shape": "string"
        },
        {
            "displayName": "Resolution",
            "name": "resolution",
            "shape": "string"
        },
        {
            "displayName": "Number (Raw)",
            "name": "number",
            "shape": "string",
            "visible": false
        },
        {
            "pattern": ".*"
        }
    ],
    "name": "secretScan",
    "timeframes": false,
    "ui": [
        {
            "label": "Repository",
            "matches": {
                "sourceType": {
                    "type": "equals",
                    "value": "GitHub Repo"
                }
            },
            "name": "repos",
            "nodeProperties": ["name", "fullName", "sourceId"],
            "objectLimit": 1,
            "placeholder": "Select...",
            "searchPlaceholder": "Search repositories...",
            "type": "objects"
        },
        {
            "allowCustomValues": false,
            "data": {
                "source": "fixed",
                "values": [
                    {
                        "label": "Open",
                        "value": "open"
                    },
                    {
                        "label": "Resolved",
                        "value": "resolved"
                    }
                ]
            },
            "defaultValue": "open",
            "isClearable": false,
            "isMulti": false,
            "label": "State",
            "name": "state",
            "type": "autocomplete"
        },
        {
            "allowCustomValues": false,
            "data": {
                "source": "fixed",
                "values": [
                    {
                        "label": "Active",
                        "value": "active"
                    },
                    {
                        "label": "Inactive",
                        "value": "inactive"
                    },
                    {
                        "label": "Unknown",
                        "value": "unknown"
                    }
                ]
            },
            "isMulti": true,
            "label": "Validity",
            "name": "validity",
            "type": "autocomplete",
            "validation": {
                "required": false
            }
        }
    ]
}
