{
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "endpointPath": "api.github.com/orgs/{{dataSource.org}}/repos",
        "expandInnerObjects": true,
        "getArgs": [],
        "headers": [],
        "httpMethod": "get",
        "paging": {
            "in": {
                "path": "next",
                "realm": {
                    "label": "Web link",
                    "value": "webLink"
                }
            },
            "mode": "nextUrl",
            "pageSize": {
                "path": "per_page",
                "realm": {
                    "label": "Query parameter",
                    "value": "queryArg"
                },
                "value": "100"
            }
        },
        "postRequestScript": "repositories.js"
    },
    "displayName": "Repositories",
    "metadata": [
        {
            "displayName": "Name",
            "name": "html_url",
            "shape": [
                "url",
                {
                    "label": "{{column.name}}"
                }
            ]
        },
        {
            "name": "id",
            "shape": "string",
            "visible": false
        },
        {
            "name": "name",
            "shape": "string",
            "visible": false
        },
        {
            "displayName": "Description",
            "name": "description",
            "shape": "string"
        },
        {
            "displayName": "Owner",
            "name": "owner",
            "shape": "string"
        },
        {
            "displayName": "Language",
            "name": "language",
            "shape": "string"
        },
        {
            "displayName": "Visibility",
            "name": "visibility",
            "shape": "string"
        },
        {
            "displayName": "Archived",
            "name": "archived",
            "shape": "boolean"
        },
        {
            "displayName": "Fork",
            "name": "fork",
            "shape": "boolean"
        },
        {
            "displayName": "Stars",
            "name": "stargazers",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0
                }
            ]
        },
        {
            "displayName": "Forks",
            "name": "forks_count",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0
                }
            ]
        },
        {
            "displayName": "Open Issues",
            "name": "open_issues",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0
                }
            ]
        },
        {
            "displayName": "Size (KB)",
            "name": "size",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0
                }
            ]
        },
        {
            "displayName": "License",
            "name": "license",
            "shape": "string"
        },
        {
            "displayName": "Default Branch",
            "name": "default_branch",
            "shape": "string"
        },
        {
            "displayName": "Topics",
            "name": "topics",
            "shape": "string"
        },
        {
            "displayName": "Created At",
            "name": "created_at",
            "shape": "date"
        },
        {
            "displayName": "Updated At",
            "name": "updated_at",
            "shape": "date"
        },
        {
            "displayName": "Last Push",
            "name": "pushed_at",
            "shape": "date"
        },
        {
            "pattern": ".*"
        }
    ],
    "name": "repositories",
    "timeframes": false
}
