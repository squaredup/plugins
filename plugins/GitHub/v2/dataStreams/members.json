{
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "endpointPath": "api.github.com/orgs/{{dataSource.org}}/members",
        "expandInnerObjects": true,
        "getArgs": [],
        "headers": [],
        "httpMethod": "get",
        "paging": {
            "in": {
                "path": "next",
                "realm": {
                    "label": "Web link",
                    "value": "webLink"
                }
            },
            "mode": "nextUrl",
            "pageSize": {
                "path": "per_page",
                "realm": {
                    "label": "Query parameter",
                    "value": "queryArg"
                },
                "value": "100"
            }
        },
        "postRequestScript": "members.js"
    },
    "displayName": "Members",
    "metadata": [
        {
            "displayName": "Username",
            "name": "html_url",
            "shape": [
                "url",
                {
                    "label": "{{column.login}}"
                }
            ]
        },
        {
            "name": "id",
            "shape": "string"
        },
        {
            "pattern": ".*"
        }
    ],
    "name": "members",
    "timeframes": false
}
