{
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "endpointPath": "api.github.com/repos/{{repos[0].fullName}}/branches",
        "expandInnerObjects": true,
        "getArgs": [],
        "headers": [],
        "httpMethod": "get",
        "paging": {
            "in": {
                "path": "next",
                "realm": {
                    "label": "Web link",
                    "value": "webLink"
                }
            },
            "mode": "nextUrl",
            "pageSize": {
                "path": "per_page",
                "realm": {
                    "label": "Query parameter",
                    "value": "queryArg"
                },
                "value": "100"
            }
        },
        "postRequestScript": "branches.js"
    },
    "displayName": "Branches",
    "metadata": [
        {
            "name": "label",
            "role": "label",
            "shape": "string"
        },
        {
            "name": "value",
            "role": "value",
            "shape": "string"
        }
    ],
    "name": "branches",
    "options": {
        "noMatch": true
    },
    "provides": "templateData",
    "timeframes": false,
    "ui": [
        {
            "matches": {
                "sourceType": {
                    "type": "equals",
                    "value": "GitHub Repo"
                }
            },
            "name": "repos",
            "nodeProperties": ["name", "fullName", "sourceId"],
            "type": "objects"
        }
    ]
}
