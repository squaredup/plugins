{
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "endpointPath": "api.github.com/repos/{{repos[0].fullName}}/releases",
        "expandInnerObjects": true,
        "getArgs": [],
        "headers": [],
        "httpMethod": "get",
        "paging": {
            "in": {
                "path": "next",
                "realm": {
                    "label": "Web link",
                    "value": "webLink"
                }
            },
            "mode": "nextUrl",
            "pageSize": {
                "path": "per_page",
                "realm": {
                    "label": "Query parameter",
                    "value": "queryArg"
                },
                "value": "100"
            }
        },
        "postRequestScript": "releases.js"
    },
    "displayName": "Releases",
    "metadata": [
        {
            "displayName": "Name",
            "name": "html_url",
            "shape": [
                "url",
                {
                    "label": "{{column.tag_name}}"
                }
            ]
        },
        {
            "displayName": "Author",
            "name": "author",
            "shape": "string"
        },
        {
            "displayName": "Draft",
            "name": "draft",
            "shape": "boolean"
        },
        {
            "displayName": "Prerelease",
            "name": "prerelease",
            "shape": "boolean"
        },
        {
            "displayName": "Description",
            "name": "body",
            "shape": "string"
        },
        {
            "displayName": "Created At",
            "name": "created_at",
            "shape": "date"
        },
        {
            "displayName": "Published At",
            "name": "published_at",
            "shape": "date"
        },
        {
            "name": "tag_name",
            "shape": "string",
            "visible": false
        },
        {
            "name": "name",
            "shape": "string",
            "visible": false
        },
        {
            "pattern": ".*"
        }
    ],
    "name": "releases",
    "timeframes": false,
    "ui": [
        {
            "label": "Repository",
            "matches": {
                "sourceType": {
                    "type": "equals",
                    "value": "GitHub Repo"
                }
            },
            "name": "repos",
            "nodeProperties": ["name", "fullName", "sourceId"],
            "objectLimit": 1,
            "placeholder": "Select...",
            "searchPlaceholder": "Search repositories...",
            "type": "objects",
            "validation": {
                "required": true
            }
        }
    ]
}
