{
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "endpointPath": "api.github.com/search/issues",
        "expandInnerObjects": true,
        "getArgs": [
            {
                "key": "q",
                "value": "org:{{dataSource.org}} is:pr {{timeframe && timeframe.start ? ` ${dateFilter}:${timeframe.start}..${timeframe.end}` : ''}}"
            },
            {
                "key": "advanced_search",
                "value": "true"
            }
        ],
        "headers": [],
        "httpMethod": "get",
        "paging": {
            "in": {
                "path": "next",
                "realm": {
                    "label": "Web link",
                    "value": "webLink"
                }
            },
            "mode": "nextUrl",
            "pageSize": {
                "path": "per_page",
                "realm": {
                    "label": "Query parameter",
                    "value": "queryArg"
                },
                "value": "100"
            }
        },
        "postRequestScript": "pullRequests.js"
    },
    "displayName": "Pull Requests (All)",
    "manualConfigApply": true,
    "metadata": [
        {
            "displayName": "Title",
            "name": "title",
            "role": "label",
            "shape": "string",
            "sourceId": "repo_id"
        },
        {
            "displayName": "Number",
            "name": "html_url",
            "shape": [
                "url",
                {
                    "label": "{{column.number}}"
                }
            ]
        },
        {
            "name": "number",
            "shape": "string",
            "visible": false
        },
        {
            "displayName": "State",
            "name": "state",
            "shape": "string"
        },
        {
            "displayName": "Draft",
            "name": "draft",
            "shape": "boolean"
        },
        {
            "displayName": "Author",
            "name": "user",
            "shape": "string"
        },
        {
            "displayName": "Labels",
            "name": "labels",
            "shape": "string"
        },
        {
            "displayName": "Repo",
            "name": "repo_url",
            "shape": [
                "url",
                {
                    "label": "{{column.repo_name}}"
                }
            ]
        },
        {
            "displayName": "Assignee",
            "name": "assignee",
            "shape": "string"
        },
        {
            "displayName": "Created At",
            "name": "created_at",
            "shape": "date"
        },
        {
            "displayName": "Updated At",
            "name": "updated_at",
            "shape": "date"
        },
        {
            "displayName": "Closed At",
            "name": "closed_at",
            "shape": "date"
        },
        {
            "displayName": "PR ID",
            "name": "id",
            "shape": "string",
            "visible": false
        },
        {
            "displayName": "Repo ID",
            "name": "repo_id",
            "shape": "string",
            "visible": false
        },
        {
            "name": "count",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0
                }
            ]
        },
        {
            "pattern": ".*"
        }
    ],
    "name": "pullRequestsAll",
    "timeframes": true,
    "ui": [
        {
            "allowCustomValues": false,
            "data": {
                "source": "fixed",
                "values": [
                    {
                        "label": "Created",
                        "value": "created"
                    },
                    {
                        "label": "Updated",
                        "value": "updated"
                    },
                    {
                        "label": "Closed",
                        "value": "closed"
                    },
                    {
                        "label": "Merged",
                        "value": "merged"
                    }
                ]
            },
            "defaultValue": "created",
            "help": "Select the date column used for sorting and filtering",
            "isClearable": false,
            "isMulti": false,
            "label": "Date column",
            "name": "dateFilter",
            "type": "autocomplete",
            "validation": {
                "required": true
            }
        }
    ]
}
