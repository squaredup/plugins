{
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "endpointPath": "www.githubstatus.com/api/v2/incidents.json",
        "expandInnerObjects": true,
        "getArgs": [],
        "headers": [],
        "httpMethod": "get",
        "paging": {
            "mode": "none"
        },
        "postRequestScript": "incidents.js"
    },
    "displayName": "Incidents",
    "metadata": [
        {
            "displayName": "Name",
            "name": "shortlink",
            "shape": [
                "url",
                {
                    "label": "{{column.name}}"
                }
            ]
        },
        {
            "name": "name",
            "shape": "string",
            "visible": false
        },
        {
            "displayName": "Status",
            "name": "status",
            "shape": "string"
        },
        {
            "displayName": "Impact",
            "name": "impact",
            "shape": "string"
        },
        {
            "displayName": "Created At",
            "name": "created_at",
            "shape": "date"
        },
        {
            "displayName": "Updated At",
            "name": "updated_at",
            "shape": "date"
        },
        {
            "displayName": "Monitoring At",
            "name": "monitoring_at",
            "shape": "date"
        },
        {
            "displayName": "Resolved At",
            "name": "resolved_at",
            "shape": "date"
        },
        {
            "pattern": ".*"
        }
    ],
    "name": "incidents",
    "timeframes": false,
    "ui": [
        {
            "defaultValue": "all",
            "label": "Status",
            "name": "status",
            "options": [
                {
                    "label": "All",
                    "value": "all"
                },
                {
                    "label": "Resolved",
                    "value": "resolved"
                },
                {
                    "label": "Unresolved",
                    "value": "unresolved"
                }
            ],
            "type": "radio"
        },
        {
            "allowCustomValues": false,
            "data": {
                "source": "fixed",
                "values": [
                    {
                        "label": "Investigating",
                        "value": "investigating"
                    },
                    {
                        "label": "Identified",
                        "value": "identified"
                    },
                    {
                        "label": "Monitoring",
                        "value": "monitoring"
                    }
                ]
            },
            "defaultValue": ["investigating"],
            "isMulti": true,
            "label": "Unresolved state",
            "name": "state",
            "type": "autocomplete",
            "visible": {
                "status": "unresolved"
            }
        }
    ]
}
