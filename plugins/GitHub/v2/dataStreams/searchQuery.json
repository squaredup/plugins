{
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "endpointPath": "api.github.com/search/issues",
        "expandInnerObjects": true,
        "getArgs": [
            {
                "key": "q",
                "value": "org:{{dataSource.org}} {{query}}"
            },
            {
                "key": "advanced_search",
                "value": "true"
            }
        ],
        "headers": [],
        "httpMethod": "get",
        "paging": {
            "in": {
                "path": "next",
                "realm": {
                    "label": "Web link",
                    "value": "webLink"
                }
            },
            "mode": "nextUrl",
            "pageSize": {
                "path": "per_page",
                "realm": {
                    "label": "Query parameter",
                    "value": "queryArg"
                },
                "value": "{{!resultType || resultType === 'list' ? 100 : 1}}"
            }
        },
        "postRequestScript": "searchQuery.js"
    },
    "displayName": "Search Query",
    "manualConfigApply": true,
    "metadata": [
        {
            "displayName": "Title",
            "name": "title",
            "shape": "string"
        },
        {
            "displayName": "Number",
            "name": "html_url",
            "shape": [
                "url",
                {
                    "label": "{{column.number}}"
                }
            ]
        },
        {
            "name": "number",
            "shape": "string",
            "visible": false
        },
        {
            "displayName": "Type",
            "name": "type",
            "shape": "string"
        },
        {
            "displayName": "State",
            "name": "state",
            "shape": "string"
        },
        {
            "displayName": "Author",
            "name": "user",
            "shape": "string"
        },
        {
            "displayName": "Labels",
            "name": "labels",
            "shape": "string"
        },
        {
            "displayName": "Repository",
            "name": "repo_url",
            "shape": [
                "url",
                {
                    "label": "{{column.repo_name}}"
                }
            ]
        },
        {
            "displayName": "Assignee",
            "name": "assignee",
            "shape": "string"
        },
        {
            "displayName": "Created At",
            "name": "created_at",
            "shape": "date"
        },
        {
            "displayName": "Updated At",
            "name": "updated_at",
            "shape": "date"
        },
        {
            "displayName": "Closed At",
            "name": "closed_at",
            "shape": "date"
        },
        {
            "name": "count",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0
                }
            ]
        },
        {
            "pattern": ".*"
        }
    ],
    "name": "searchQuery",
    "timeframes": false,
    "ui": [
        {
            "help": "Enter a query using [GitHub's search syntax](https://docs.github.com/en/search-github/searching-on-github/searching-issues-and-pull-requests). The org filter is applied automatically.",
            "label": "Query",
            "name": "query",
            "placeholder": "e.g. is:issue state:open label:bug",
            "type": "text",
            "validation": {
                "required": true
            }
        },
        {
            "defaultValue": "list",
            "label": "Result type",
            "name": "resultType",
            "options": [
                {
                    "label": "List",
                    "value": "list"
                },
                {
                    "label": "Count",
                    "value": "count"
                }
            ],
            "type": "radio"
        }
    ]
}
