{
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "endpointPath": "api.github.com/repos/{{repos[0].fullName}}/deployments",
        "expandInnerObjects": true,
        "getArgs": [
            {
                "key": "environment",
                "value": "{{typeof environment !== 'undefined' ? environment : ''}}"
            }
        ],
        "headers": [],
        "httpMethod": "get",
        "paging": {
            "in": {
                "path": "next",
                "realm": {
                    "label": "Web link",
                    "value": "webLink"
                }
            },
            "mode": "nextUrl",
            "pageSize": {
                "path": "per_page",
                "realm": {
                    "label": "Query parameter",
                    "value": "queryArg"
                },
                "value": "100"
            }
        },
        "postRequestScript": "deployments.js"
    },
    "displayName": "Deployments",
    "manualConfigApply": true,
    "metadata": [
        {
            "displayName": "Environment",
            "name": "environment",
            "shape": "string"
        },
        {
            "displayName": "Ref",
            "name": "ref",
            "shape": "string"
        },
        {
            "displayName": "SHA",
            "name": "sha",
            "shape": "string"
        },
        {
            "displayName": "Task",
            "name": "task",
            "shape": "string"
        },
        {
            "displayName": "Creator",
            "name": "creator",
            "shape": "string"
        },
        {
            "displayName": "Description",
            "name": "description",
            "shape": "string"
        },
        {
            "displayName": "Production",
            "name": "production_environment",
            "shape": "boolean"
        },
        {
            "displayName": "Transient",
            "name": "transient_environment",
            "shape": "boolean"
        },
        {
            "displayName": "Created At",
            "name": "created_at",
            "shape": "date"
        },
        {
            "displayName": "Updated At",
            "name": "updated_at",
            "shape": "date"
        },
        {
            "name": "id",
            "shape": "string",
            "visible": false
        },
        {
            "pattern": ".*"
        }
    ],
    "name": "deployments",
    "timeframes": false,
    "ui": [
        {
            "label": "Repository",
            "matches": {
                "sourceType": {
                    "type": "equals",
                    "value": "GitHub Repo"
                }
            },
            "name": "repos",
            "nodeProperties": ["name", "fullName", "sourceId"],
            "objectLimit": 1,
            "placeholder": "Select...",
            "searchPlaceholder": "Search repositories...",
            "type": "objects",
            "validation": {
                "required": true
            }
        },
        {
            "allowCustomValues": true,
            "data": {
                "dataSourceConfig": {
                    "repos": {
                        "fieldName": "repos",
                        "required": true
                    }
                },
                "dataStreamName": "environments",
                "source": "dataStream"
            },
            "isMulti": false,
            "label": "Environment",
            "name": "environment",
            "placeholder": "e.g. production",
            "type": "autocomplete",
            "validation": {
                "required": false
            }
        }
    ]
}
