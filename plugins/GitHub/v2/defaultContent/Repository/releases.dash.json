            {
                "config": {
                    "_type": "tile/data-stream",
                    "dataStream": {
                        "dataSourceConfig": {
                            "sql": "WITH sorted_releases AS (\n  SELECT \n    published_at,\n    ROW_NUMBER() OVER (ORDER BY published_at) AS rn\n  FROM releases\n  WHERE published_at IS NOT NULL\n),\n\nrelease_deltas AS (\n  SELECT\n    curr.published_at AS current_release_date,\n    prev.published_at AS previous_release_date,\n    DATE_DIFF('second', prev.published_at, curr.published_at) / 3600.0 AS hours_between\n  FROM sorted_releases curr\n  JOIN sorted_releases prev\n    ON curr.rn = prev.rn + 1\n)\n\nSELECT \n  ROUND(AVG(hours_between), 2) AS avg_hours_between_releases\nFROM release_deltas;",
                            "tables": [
                                {
                                    "config": {
                                        "activePluginConfigIds": ["{{configId}}"],
                                        "dataStream": {
                                            "dataSourceConfig": {
                                                "repos": {
                                                    "scope": "{{scopes.[GitHub Repositories]}}",
                                                    "variable": "{{variables.[GitHub Repository]}}",
                                                    "workspace": "{{workspaceId}}"
                                                }
                                            },
                                            "filter": {
                                                "filters": [
                                                    {
                                                        "column": "prerelease",
                                                        "operation": "notequals",
                                                        "value": "true"
                                                    },
                                                    {
                                                        "column": "draft",
                                                        "operation": "notequals",
                                                        "value": "true"
                                                    }
                                                ],
                                                "multiOperation": "and"
                                            },
                                            "id": "{{dataStreams.releases}}",
                                            "name": "releases"
                                        },
                                        "timeframe": "none",
                                        "variables": ["{{variables.[GitHub Repository]}}"]
                                    },
                                    "tableName": "releases"
                                }
                            ],
                            "version": "2.0"
                        },
                        "id": "datastream-sql"
                    },
