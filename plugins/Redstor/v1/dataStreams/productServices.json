{
    "name": "productServices",
    "displayName": "Product Services",
    "description": "Services available within each Redstor product (Exchange and OneDrive sit within O365)",
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/products",
        "paging": {
            "mode": "token",
            "pageSize": { "realm": "queryArg", "path": "maxResults", "value": "100" },
            "in": { "realm": "payload", "path": "nextPageToken" },
            "out": { "realm": "queryArg", "path": "pageToken" }
        },
        "postRequestScript": "productServices.js"
    },
    "matches": "none",
    "visibility": { "type": "hidden" },
    "metadata": [
        { "name": "serviceId", "displayName": "Service ID", "shape": "number", "visible": false },
        { "name": "serviceName", "displayName": "Service", "shape": "string", "role": "label" },
        { "name": "productId", "displayName": "Product ID", "shape": "number", "visible": false },
        { "name": "productName", "displayName": "Product", "shape": "string" }
    ],
    "timeframes": false
}
