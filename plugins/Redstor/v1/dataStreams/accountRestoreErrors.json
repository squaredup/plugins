{
    "name": "accountRestoreErrors",
    "displayName": "Account Restore Errors",
    "description": "Restore error and warning messages for an account",
    "tags": ["Backup", "Account"],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/restores/status/accounts/errors",
        "getArgs": [{ "key": "accountId", "value": "{{object.rawId}}" }],
        "paging": {
            "mode": "token",
            "pageSize": { "realm": "queryArg", "path": "maxResults", "value": "100" },
            "in": { "realm": "payload", "path": "nextPageToken" },
            "out": { "realm": "queryArg", "path": "pageToken" }
        },
        "pathToData": "results"
    },
    "matches": { "sourceType": { "type": "oneOf", "values": ["Account"] } },
    "metadata": [
        { "name": "timestamp", "displayName": "Time", "shape": "date", "role": "timestamp" },
        { "name": "message", "displayName": "Message", "shape": "string", "role": "label" },
        { "name": "category", "displayName": "Category", "shape": "string" },
        { "name": "type", "displayName": "Type", "shape": "string" },
        { "name": "count", "displayName": "Count", "shape": "number" },
        { "name": "extraInfo", "displayName": "Extra Info", "shape": "string", "visible": false },
        { "name": "productId", "displayName": "Product ID", "shape": "number", "visible": false }
    ],
    "timeframes": false
}
