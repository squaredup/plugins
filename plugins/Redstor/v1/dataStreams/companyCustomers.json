{
    "name": "companyCustomers",
    "displayName": "Company Customers",
    "description": "Customer companies under the configured Redstor Partner company",
    "tags": ["Company"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/companies/{{dataSource.companyId}}/customers",
        "paging": {
            "mode": "token",
            "pageSize": { "realm": "queryArg", "path": "maxResults", "value": "100" },
            "in": { "realm": "payload", "path": "nextPageToken" },
            "out": { "realm": "queryArg", "path": "pageToken" }
        },
        "pathToData": "results"
    },
    "matches": "none",
    "visibility": { "type": "hidden" },
    "metadata": [
        { "name": "companyId", "displayName": "Company ID", "shape": "guid", "visible": false },
        { "name": "companyName", "displayName": "Company Name", "shape": "string", "role": "label" },
        { "name": "type", "displayName": "Type", "shape": "string" },
        { "name": "isEnabled", "displayName": "Enabled", "shape": "boolean" },
        { "name": "parentCompanyId", "displayName": "Parent Company ID", "shape": "guid", "visible": false }
    ],
    "timeframes": false
}
