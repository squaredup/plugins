{
    "name": "estateConsumption",
    "displayName": "Estate Consumption",
    "description": "Storage consumption and seat usage, for the Partner company and rolled up across its customers",
    "tags": ["Usage"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/consumption/summary",
        "getArgs": [
            { "key": "companyId", "value": "{{dataSource.entityIdentifier}}" },
            { "key": "shouldExcludeTrials", "value": "{{excludeTrials || null}}" }
        ],
        "postRequestScript": "estateConsumption.js"
    },
    "matches": "none",
    "ui": [
        {
            "type": "checkbox",
            "name": "excludeTrials",
            "label": "Exclude trial subscriptions",
            "defaultValue": true
        }
    ],
    "metadata": [
        { "name": "scope", "displayName": "Scope", "shape": "string", "role": "label" },
        { "name": "totalDataProtectedInBytes", "displayName": "Data Protected", "shape": "bytes" },
        { "name": "totalDataProtectedInBytesExternal", "displayName": "Data Protected (External)", "shape": "bytes" },
        { "name": "fupOverageInBytes", "displayName": "Fair Use Overage", "shape": "bytes" },
        { "name": "activeSeats", "displayName": "Active Seats", "shape": "number" },
        { "name": "inactiveSeats", "displayName": "Inactive Seats", "shape": "number" },
        { "name": "sharedSeats", "displayName": "Shared Seats", "shape": "number" },
        { "name": "activeWorkloads", "displayName": "Active Workloads", "shape": "number" },
        { "name": "licensedUsers", "displayName": "Licensed Users", "shape": "number" }
    ],
    "timeframes": false
}
