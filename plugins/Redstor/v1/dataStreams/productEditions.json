{
    "name": "productEditions",
    "displayName": "Product Editions",
    "description": "Editions available for each Redstor product",
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/products",
        "paging": {
            "mode": "token",
            "pageSize": { "realm": "queryArg", "path": "maxResults", "value": "100" },
            "in": { "realm": "payload", "path": "nextPageToken" },
            "out": { "realm": "queryArg", "path": "pageToken" }
        },
        "postRequestScript": "productEditions.js"
    },
    "matches": "none",
    "visibility": { "type": "hidden" },
    "metadata": [
        { "name": "editionId", "displayName": "Edition ID", "shape": "number", "visible": false },
        { "name": "editionName", "displayName": "Edition", "shape": "string", "role": "label" },
        { "name": "productId", "displayName": "Product ID", "shape": "number", "visible": false },
        { "name": "productName", "displayName": "Product", "shape": "string" },
        { "name": "hasTrial", "displayName": "Trial Available", "shape": "boolean" }
    ],
    "timeframes": false
}
