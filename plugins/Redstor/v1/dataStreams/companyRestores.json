{
    "name": "companyRestores",
    "displayName": "Company Restores",
    "description": "Latest restore run per account for a company (the full seven day history is available as an option, where Redstor holds one)",
    "tags": ["Restore"],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/restores/status/accounts",
        "getArgs": [{ "key": "companyId", "value": "{{object.rawId}}" }],
        "paging": {
            "mode": "token",
            "pageSize": { "realm": "queryArg", "path": "maxResults", "value": "100" },
            "in": { "realm": "payload", "path": "nextPageToken" },
            "out": { "realm": "queryArg", "path": "pageToken" }
        },
        "postRequestScript": "companyRestores.js"
    },
    "matches": { "sourceType": { "type": "oneOf", "values": ["Company"] } },
    "ui": [
        {
            "type": "checkbox",
            "name": "includeHistory",
            "label": "Include full history",
            "defaultValue": false,
            "help": "Returns every run in Redstor's rolling seven day window, where history is available. Large datasets may exceed the amount of data a tile can return."
        }
    ],
    "metadata": [
        { "name": "accountName", "displayName": "Account", "shape": "string", "role": "label" },
        {
            "name": "serviceName",
            "displayName": "Service",
            "sourceId": "productId",
            "sourceType": "Service",
            "objectPropertyPath": "name"
        },
        { "name": "timestamp", "displayName": "Time", "shape": "date", "role": "timestamp" },
        {
            "name": "status",
            "displayName": "Status Code",
            "shape": "number",
            "help": "Raw Redstor status code — RedAPI's public documentation does not define the meaning of each value."
        },
        {
            "name": "productId",
            "displayName": "Service ID",
            "shape": "number",
            "visible": false,
            "help": "RedAPI names this field productId, but it carries service ids (94 = Exchange, 91 = OneDrive, 92 = SharePoint, 107 = Teams)"
        },
        { "name": "accountId", "displayName": "Account ID", "shape": "guid", "visible": false },
        { "name": "companyId", "displayName": "Company ID", "shape": "guid", "visible": false },
        { "name": "groupId", "displayName": "Group ID", "shape": "string", "visible": false }
    ],
    "timeframes": false
}
