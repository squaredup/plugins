{
    "name": "accountRestores",
    "displayName": "Account Restores",
    "description": "Current restore operation status for an account",
    "tags": ["Restore"],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/restores/status/accounts",
        "getArgs": [
            { "key": "companyId", "value": "{{object.companyId}}" },
            { "key": "accountId", "value": "{{object.rawId}}" }
        ],
        "paging": {
            "mode": "token",
            "pageSize": { "realm": "queryArg", "path": "maxResults", "value": "100" },
            "in": { "realm": "payload", "path": "nextPageToken" },
            "out": { "realm": "queryArg", "path": "pageToken" }
        },
        "pathToData": "results"
    },
    "matches": { "sourceType": { "type": "oneOf", "values": ["Account"] } },
    "metadata": [
        { "name": "timestamp", "displayName": "Time", "shape": "date", "role": "timestamp" },
        { "name": "status", "displayName": "Status Code", "shape": "number" },
        { "name": "accountName", "displayName": "Account", "shape": "string", "visible": false },
        { "name": "accountId", "displayName": "Account ID", "shape": "guid", "visible": false },
        { "name": "productId", "displayName": "Service ID", "shape": "number", "visible": false }
    ],
    "timeframes": false
}
