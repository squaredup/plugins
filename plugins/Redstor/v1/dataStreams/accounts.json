{
    "name": "accounts",
    "displayName": "Company Accounts",
    "description": "Backup and storage accounts for a Redstor company",
    "tags": ["Account"],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/storage/accounts",
        "getArgs": [{ "key": "companyId", "value": "{{object.rawId}}" }],
        "paging": {
            "mode": "token",
            "pageSize": { "realm": "queryArg", "path": "maxResults", "value": "100" },
            "in": { "realm": "payload", "path": "nextPageToken" },
            "out": { "realm": "queryArg", "path": "pageToken" }
        },
        "pathToData": "results"
    },
    "matches": { "sourceType": { "type": "oneOf", "values": ["Company"] } },
    "metadata": [
        { "name": "accountId", "displayName": "Account ID", "shape": "guid", "visible": false },
        { "name": "accountName", "displayName": "Account Name", "shape": "string", "role": "label" },
        { "name": "displayName", "displayName": "Display Name", "shape": "string" },
        { "name": "serviceId", "displayName": "Service ID", "shape": "number", "visible": false },
        { "name": "serviceName", "displayName": "Service", "shape": "string" },
        { "name": "productId", "displayName": "Product ID", "shape": "number", "visible": false },
        { "name": "productName", "displayName": "Product", "shape": "string" },
        { "name": "storageRegion", "displayName": "Storage Region", "shape": "string" },
        { "name": "createOn", "displayName": "Created On", "shape": "date" },
        {
            "name": "companyId",
            "displayName": "Company ID",
            "computed": true,
            "valueExpression": "{{object.rawId}}",
            "shape": "guid",
            "visible": false
        }
    ],
    "timeframes": false
}
