{
    "name": "companyAccountBackupStatus",
    "displayName": "Company Account Backup Status",
    "description": "Latest backup run per account for a company (the full seven day history is available as an option)",
    "tags": ["Backup", "Account"],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/backups/status/accounts",
        "getArgs": [{ "key": "companyId", "value": "{{object.rawId}}" }],
        "paging": {
            "mode": "token",
            "pageSize": { "realm": "queryArg", "path": "maxResults", "value": "100" },
            "in": { "realm": "payload", "path": "nextPageToken" },
            "out": { "realm": "queryArg", "path": "pageToken" }
        },
        "postRequestScript": "companyAccountBackupStatus.js"
    },
    "matches": { "sourceType": { "type": "oneOf", "values": ["Company"] } },
    "ui": [
        {
            "type": "checkbox",
            "name": "includeHistory",
            "label": "Include full history",
            "defaultValue": false,
            "help": "Returns every run in Redstor's rolling seven day window. Large datasets may exceed the amount of data a tile can return."
        }
    ],
    "metadata": [
        { "name": "accountName", "displayName": "Account", "shape": "string", "role": "label" },
        { "name": "serviceId", "displayName": "Service ID", "shape": "number", "visible": false },
        {
            "name": "serviceName",
            "displayName": "Service",
            "sourceId": "serviceId",
            "sourceType": "Service",
            "objectPropertyPath": "name"
        },
        { "name": "timestamp", "displayName": "Time", "shape": "date", "role": "timestamp" },
        {
            "name": "overallStatus",
            "displayName": "Status",
            "computed": true,
            "valueExpression": "{{ $['status'] === 1 ? 'success' : ($['status'] === 2 ? 'warning' : 'error') }}",
            "shape": "state"
        },
        {
            "name": "status",
            "displayName": "Status Code",
            "shape": "number",
            "visible": false,
            "help": "Raw Redstor status code: 0 = Failed, 1 = Completed successfully, 2 = Completed with warnings, 3 = Completed with errors."
        },
        { "name": "message", "displayName": "Message", "shape": "string" },
        { "name": "errorCount", "displayName": "Error Count", "shape": "number" },
        { "name": "accountId", "displayName": "Account ID", "shape": "guid", "visible": false }
    ],
    "timeframes": false
}
