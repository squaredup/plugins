                            "by": [["productName", "uniqueValues"]],
                            "aggregate": [
                                { "type": "sum", "names": ["succeeded"] },
                                { "type": "sum", "names": ["completedWithWarnings"] },
                                { "type": "sum", "names": ["completedWithErrors"] },
                                { "type": "sum", "names": ["failed"] },
                                { "type": "sum", "names": ["missed"] }
                            ]
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
