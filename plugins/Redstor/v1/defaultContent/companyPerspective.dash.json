                                            "type": "boolean"
                                        }
                                    },
                                    {
                                        "field": "parentCompanyId",
                                        "title": "Parent Company ID",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "companyId",
                                        "title": "Company ID",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableTranspose": true,
                                "richTableFontSize": 14,
                                "richTableCellPadding": 8
                            }
                        }
                    }
                }
            },
            {
