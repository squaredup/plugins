                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Company]}}"
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "name",
