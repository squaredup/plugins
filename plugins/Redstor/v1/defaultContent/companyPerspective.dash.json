                        "name": "companyBackupSummary",
                        "pluginConfigId": "{{configId}}",
                        "group": {
                            "by": [
                                [
                                    "productName",
                                    "uniqueValues"
                                ]
                            ],
                            "aggregate": [
                                {
                                    "type": "sum",
                                    "names": [
                                        "succeeded"
                                    ]
                                },
                                {
                                    "type": "sum",
                                    "names": [
                                        "completedWithWarnings"
                                    ]
                                },
                                {
                                    "type": "sum",
                                    "names": [
                                        "completedWithErrors"
                                    ]
                                },
                                {
                                    "type": "sum",
                                    "names": [
                                        "failed"
                                    ]
                                },
                                {
                                    "type": "sum",
                                    "names": [
                                        "missed"
                                    ]
                                }
                            ]
                        }
                    },
                    "scope": {
                        "scope": "{{scopes.[Companies]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Company]}}"
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "productName_uniqueValues",
                                    "type": "nominal",
                                    "title": "Product"
                                }
                            },
                            "style": {
                                "legendPosition": "bottom",
                                "cartesianStack": "normalize",
