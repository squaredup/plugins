{
    "name": "Company View",
    "schemaVersion": "1.5",
    "timeframe": "none",
    "variables": [
        "{{variables.[Company]}}"
    ],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "0b065314-8e61-47f1-930c-361061f5e01e",
                "x": 0,
                "y": 0,
                "w": 4,
                "h": 2,
                "z": 0,
                "moved": false,
                "static": false,
                "config": {
