{
    "name": "redstor",
    "displayName": "Redstor",
    "version": "1.0.0",
    "author": { "name": "@TimWheeler-SQUP", "type": "community" },
    "description": "Monitor your Redstor RedAPI Partner account — customer companies, backup accounts, backup and restore status, storage consumption, and product subscriptions.",
    "category": "Monitoring",
    "type": "hybrid",
    "schemaVersion": "2.1",
    "importNotSupported": false,
    "restrictedToPlatforms": [],
    "keywords": ["backup", "disaster recovery", "archiving", "msp", "redstor", "redapi"],
    "objectTypes": ["Redstor Company", "Redstor Account"],
    "links": [
        {
            "category": "documentation",
            "url": "https://github.com/squaredup/plugins/blob/main/plugins/Redstor/v1/docs/README.md",
            "label": "Help adding this plugin"
        },
        {
            "category": "source",
            "url": "https://github.com/squaredup/plugins/tree/main/plugins/Redstor/v1",
            "label": "Repository"
        }
    ],
    "base": {
        "plugin": "WebAPI",
        "majorVersion": "1",
        "config": {
            "baseUrl": "https://api.redstor.com",
            "authMode": "none",
            "headers": [{ "key": "Accept", "value": "application/json" }],
            "queryArgs": [],
            "scriptingVariables": [
                { "key": "clientId", "value": "{{clientId}}" },
                { "key": "privateKey", "value": "{{privateKey}}" }
            ],
            "preRequestScript": "preRequest.js",
            "showScripting": true
        }
    }
}
