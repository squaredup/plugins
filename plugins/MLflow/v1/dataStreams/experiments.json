{
    "name": "experiments",
    "displayName": "Experiments",
    "description": "MLflow experiments, one row per experiment",
    "tags": ["MLOps", "Experiments"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "post",
        "endpointPath": "/api/2.0/mlflow/experiments/search",
        "postBody": { "max_results": 1000 },
        "paging": {
            "mode": "token",
            "pageSize": { "realm": "body", "path": "max_results", "value": "1000" },
            "in": { "realm": "payload", "path": "next_page_token" },
            "out": { "realm": "body", "path": "page_token" }
        },
        "pathToData": "experiments",
        "expandInnerObjects": true
    },
    "matches": "none",
    "metadata": [
        {
            "name": "experiment_id",
            "displayName": "Experiment ID",
            "shape": "string",
            "role": "id",
            "visible": false
        },
        {
            "name": "name",
            "displayName": "Name",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "lifecycle_stage",
            "displayName": "Lifecycle Stage",
            "shape": "string"
        },
        {
            "name": "creation_time",
            "displayName": "Created",
            "shape": "date"
        },
        {
            "name": "last_update_time",
            "displayName": "Last Updated",
            "shape": "date"
        },
        {
            "name": "artifact_location",
            "displayName": "Artifact Location",
            "shape": "string",
            "visible": false
        },
        {
            "name": "tags",
            "displayName": "Tags",
            "shape": "json"
        },
        { "pattern": ".*" }
    ],
    "timeframes": false
}
