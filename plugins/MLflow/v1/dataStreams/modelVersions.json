{
    "name": "modelVersions",
    "displayName": "Model Versions",
    "description": "MLflow model versions, one row per version, across every registered model",
    "tags": ["MLOps", "Model Registry"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/api/2.0/mlflow/model-versions/search",
        "paging": {
            "mode": "token",
            "pageSize": { "realm": "queryArg", "path": "max_results", "value": "1000" },
            "in": { "realm": "payload", "path": "next_page_token" },
            "out": { "realm": "queryArg", "path": "page_token" }
        },
        "pathToData": "model_versions"
    },
    "matches": "none",
    "metadata": [
        {
            "name": "name",
            "displayName": "Model Name",
            "shape": "string"
        },
        {
            "name": "version",
            "displayName": "Version",
            "shape": "string"
        },
        {
            "name": "versionId",
            "displayName": "Version ID",
            "computed": true,
            "valueExpression": "{{ $['name'] + '/' + $['version'] }}",
            "shape": "string",
            "role": "id",
            "visible": false
        },
        {
            "name": "versionDisplayName",
            "displayName": "Version",
            "computed": true,
            "valueExpression": "{{ $['name'] + ' v' + $['version'] }}",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "current_stage",
            "displayName": "Stage",
            "shape": "string"
        },
        {
            "name": "status",
            "displayName": "Status",
            "shape": "string"
        },
        {
            "name": "run_id",
            "displayName": "Run ID",
            "shape": "string",
            "visible": false
        },
        {
            "name": "runName",
            "displayName": "Source Run",
            "sourceId": "run_id",
            "sourceType": "MLflow Run",
            "objectPropertyPath": "name"
        },
        {
            "name": "source",
            "displayName": "Source",
            "shape": "string",
            "visible": false
        },
        {
            "name": "creation_timestamp",
            "displayName": "Created",
            "shape": "date"
        },
        {
            "name": "last_updated_timestamp",
            "displayName": "Last Updated",
            "shape": "date"
        },
        {
            "name": "timeInCurrentStageMs",
            "displayName": "Time in Current Stage",
            "computed": true,
            "valueExpression": "{{ Date.now() - new Date($['last_updated_timestamp']).getTime() }}",
            "shape": "milliseconds"
        },
        {
            "name": "tags",
            "displayName": "Tags",
            "shape": "json"
        },
        {
            "name": "aliases",
            "displayName": "Aliases",
            "shape": "json"
        },
        { "pattern": ".*" }
    ],
    "timeframes": false
}
