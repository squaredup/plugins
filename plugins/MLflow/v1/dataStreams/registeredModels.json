{
    "name": "registeredModels",
    "displayName": "Registered Models",
    "description": "MLflow registered models, one row per model",
    "tags": ["MLOps", "Model Registry"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/api/2.0/mlflow/registered-models/search",
        "paging": {
            "mode": "token",
            "pageSize": { "realm": "queryArg", "path": "max_results", "value": "1000" },
            "in": { "realm": "payload", "path": "next_page_token" },
            "out": { "realm": "queryArg", "path": "page_token" }
        },
        "pathToData": "registered_models"
    },
    "matches": "none",
    "metadata": [
        {
            "name": "name",
            "displayName": "Name",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "description",
            "displayName": "Description",
            "shape": "string"
        },
        {
            "name": "creation_timestamp",
            "displayName": "Created",
            "shape": "date"
        },
        {
            "name": "last_updated_timestamp",
            "displayName": "Last Updated",
            "shape": "date"
        },
        {
            "name": "tags",
            "displayName": "Tags",
            "computed": true,
            "valueExpression": "{{ $['tags'] || [] }}",
            "shape": "json"
        },
        {
            "name": "aliases",
            "displayName": "Aliases",
            "computed": true,
            "valueExpression": "{{ $['aliases'] || [] }}",
            "shape": "json"
        },
        {
            "name": "latest_versions",
            "visible": false
        },
        { "pattern": ".*" }
    ],
    "timeframes": false
}
