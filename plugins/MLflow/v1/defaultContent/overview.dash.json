{
    "name": "Overview",
    "schemaVersion": "1.5",
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "9b1247fc-c7cb-476d-ada0-744617199f52",
                "x": 0,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Active Experiments",
                    "description": "",
                    "timeframe": "none",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[experiments]}}",
                        "name": "experiments",
                        "pluginConfigId": "{{configId}}",
                        "filter": {
                            "multiOperation": "and",
                            "filters": [
                                { "column": "lifecycle_stage", "operation": "equals", "value": "active" }
                            ]
                        },
                        "group": {
                            "by": [],
                            "aggregate": [{ "type": "count" }]
                        }
                    },
                    "visualisation": {
                        "type": "data-stream-scalar",
                        "config": {
                            "data-stream-scalar": {
                                "value": "count",
                                "comparisonColumn": "none",
                                "label": "Active Experiments"
                            }
                        }
                    }
                }
            },
            {
                "i": "09e6afff-8252-4497-a4a1-6c2e2308ddef",
                "x": 1,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Runs Started Today",
                    "description": "",
                    "timeframe": "none",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[runs]}}",
                        "name": "runs",
                        "pluginConfigId": "{{configId}}",
                        "filter": {
                            "multiOperation": "and",
                            "filters": [
                                { "column": "info.start_time", "operation": "datewithinlast", "value": "1", "unit": "days" }
                            ]
                        },
                        "group": {
                            "by": [],
                            "aggregate": [{ "type": "count" }]
                        }
                    },
                    "visualisation": {
                        "type": "data-stream-scalar",
                        "config": {
                            "data-stream-scalar": {
                                "value": "count",
                                "comparisonColumn": "none",
                                "label": "Runs Started Today"
                            }
                        }
                    }
                }
            },
            {
                "i": "19f4e641-3e0e-4267-a441-ff24f0c5dc60",
                "x": 2,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Models in Production",
                    "description": "",
                    "timeframe": "none",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[modelVersions]}}",
                        "name": "modelVersions",
                        "pluginConfigId": "{{configId}}",
                        "filter": {
                            "multiOperation": "and",
                            "filters": [
                                { "column": "current_stage", "operation": "equals", "value": "Production" }
                            ]
                        },
                        "group": {
                            "by": [],
                            "aggregate": [{ "type": "count" }]
                        }
                    },
                    "visualisation": {
                        "type": "data-stream-scalar",
                        "config": {
                            "data-stream-scalar": {
                                "value": "count",
                                "comparisonColumn": "none",
                                "label": "Models in Production"
                            }
                        }
                    }
                }
            },
            {
                "i": "c554bcf1-4218-4679-8da8-7f5a0f9da2f7",
                "x": 3,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Runs by Status (Last 7 Days)",
                    "description": "",
                    "timeframe": "none",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[runs]}}",
                        "name": "runs",
                        "pluginConfigId": "{{configId}}",
                        "filter": {
                            "multiOperation": "and",
                            "filters": [
                                { "column": "info.start_time", "operation": "datewithinlast", "value": "7", "unit": "days" }
                            ]
                        },
                        "group": {
                            "by": [["info.status", "uniqueValues"]],
                            "aggregate": [{ "type": "count" }]
                        }
                    },
                    "visualisation": {
                        "type": "data-stream-donut-chart",
                        "config": {
                            "data-stream-donut-chart": {
                                "valueColumn": "count",
                                "labelColumn": "info.status_uniqueValues",
                                "hideCenterValue": false,
                                "showValuesAsPercentage": false,
                                "legendPosition": "auto",
                                "legendMode": "table"
                            }
                        }
                    }
                }
            },
            {
                "i": "f05022c7-8955-4b23-9112-e00addf874e6",
                "x": 0,
                "y": 2,
                "w": 4,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Recent Failed/Killed Runs",
                    "description": "",
                    "timeframe": "none",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[runs]}}",
                        "name": "runs",
                        "pluginConfigId": "{{configId}}",
                        "filter": {
                            "multiOperation": "or",
                            "filters": [
                                { "column": "info.status", "operation": "equals", "value": "FAILED" },
                                { "column": "info.status", "operation": "equals", "value": "KILLED" }
                            ]
                        },
                        "sort": { "by": [["info.start_time", "desc"]], "top": 10 }
                    },
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": [
                                    "info.run_name",
                                    "info.status",
                                    "info.start_time",
                                    "duration_ms",
                                    "info.experiment_id",
                                    "data.tags"
                                ],
                                "hiddenColumns": [
                                    "info.run_id",
                                    "info.end_time",
                                    "info.user_id",
                                    "data.params",
                                    "data.metrics"
                                ]
                            }
                        }
                    }
                }
            }
        ]
    }
}
