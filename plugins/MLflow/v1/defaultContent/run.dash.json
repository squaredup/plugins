                            "metricKey": "accuracy"
                        },
                        "sort": { "by": [["step", "asc"]] }
                    },
                    "scope": {
                        "scope": "{{scopes.[Runs]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Run]}}"
