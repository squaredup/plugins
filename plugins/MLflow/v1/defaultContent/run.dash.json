                        "config": {
                            "data-stream-line-graph": {
                                "xAxisColumn": "step",
                                "yAxisColumn": ["value"],
                                "seriesColumn": "none",
                                "showLegend": false,
                                "legendPosition": "bottom",
                                "yAxisLabel": "Accuracy",
                                "showYAxisLabel": true,
                                "showTrendLine": false
                            }
                        }
                    }
                }
            }
        ]
    }
