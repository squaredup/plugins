                        }
                    }
                }
            },
            {
                "i": "87d331db-36d9-4823-b02f-d14f1c48d2c8",
                "x": 1,
                "y": 0,
                "w": 3,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Accuracy Over Time",
                    "description": "Metric history for this run (metric key: accuracy)",
                    "timeframe": "none",
                    "activePluginConfigIds": ["{{configId}}"],
                    "variables": ["{{variables.[Run]}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[runMetricHistory]}}",
                        "name": "runMetricHistory",
