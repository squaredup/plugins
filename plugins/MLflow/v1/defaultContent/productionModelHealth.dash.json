{
    "name": "Production Model Health",
    "schemaVersion": "1.5",
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "7a2c7ed6-2803-4ffc-962a-123513bf62af",
                "x": 0,
                "y": 0,
                "w": 4,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Production Model Versions",
                    "description": "",
                    "timeframe": "none",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[modelVersions]}}",
                        "name": "modelVersions",
                        "pluginConfigId": "{{configId}}",
                        "filter": {
                            "multiOperation": "and",
                            "filters": [
                                { "column": "current_stage", "operation": "equals", "value": "Production" }
                            ]
                        },
                        "sort": { "by": [["last_updated_timestamp", "desc"]] }
                    },
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": [
                                    "versionDisplayName",
                                    "runName",
                                    "last_updated_timestamp",
                                    "status"
                                ],
                                "hiddenColumns": [
                                    "name",
                                    "version",
                                    "versionId",
                                    "current_stage",
                                    "run_id",
                                    "source",
                                    "creation_timestamp",
                                    "timeInCurrentStageMs",
                                    "tags",
                                    "aliases"
                                ]
                            }
                        }
                    }
                }
            }
        ]
    }
}
