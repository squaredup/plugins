{
    "name": "Experiment Detail",
    "schemaVersion": "1.5",
    "variables": ["{{variables.[Experiment]}}"],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "4ec87e3c-504d-4385-8b49-9b8356cd2e5d",
                "x": 0,
                "y": 0,
                "w": 1,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Properties",
                    "description": "",
                    "timeframe": "none",
                    "activePluginConfigIds": ["{{configId}}"],
                    "variables": ["{{variables.[Experiment]}}"],
                    "dataStream": {
                        "id": "datastream-properties",
                        "name": "properties"
                    },
                    "scope": {
                        "scope": "{{scopes.[Experiments]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Experiment]}}"
                    },
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": true
                            }
                        }
                    }
                }
            },
            {
                "i": "90879650-7c23-4ad4-8999-fc913ce4ad1e",
                "x": 1,
                "y": 0,
                "w": 3,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Runs in this Experiment",
                    "description": "",
                    "timeframe": "none",
                    "activePluginConfigIds": ["{{configId}}"],
                    "variables": ["{{variables.[Experiment]}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[runs]}}",
                        "name": "runs",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "experiment": {
                                "variable": "{{variables.[Experiment]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Experiments]}}"
                            }
                        },
                        "sort": { "by": [["info.start_time", "desc"]] }
                    },
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": [
                                    "info.run_name",
                                    "info.status",
                                    "duration_ms",
                                    "info.start_time"
                                ],
                                "hiddenColumns": [
                                    "info.run_id",
                                    "info.experiment_id",
                                    "info.end_time",
                                    "info.user_id",
                                    "data.params",
                                    "data.metrics",
                                    "data.tags"
                                ]
                            }
                        }
                    }
                }
            },
            {
                "i": "211aa0a4-40ed-4097-9295-be76e0d97844",
                "x": 0,
                "y": 4,
                "w": 4,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Longest-Running Runs",
                    "description": "",
                    "timeframe": "none",
                    "activePluginConfigIds": ["{{configId}}"],
                    "variables": ["{{variables.[Experiment]}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[runs]}}",
                        "name": "runs",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "experiment": {
                                "variable": "{{variables.[Experiment]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Experiments]}}"
                            }
                        },
                        "sort": { "by": [["duration_ms", "desc"]], "top": 10 }
                    },
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": [
                                    "info.run_name",
                                    "info.status",
                                    "duration_ms",
                                    "info.start_time"
                                ],
                                "hiddenColumns": [
                                    "info.run_id",
                                    "info.experiment_id",
                                    "info.end_time",
                                    "info.user_id",
                                    "data.params",
                                    "data.metrics",
                                    "data.tags"
                                ]
                            }
                        }
                    }
                }
            }
        ]
    }
}
