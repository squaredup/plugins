{
    "name": "Model Registry Lifecycle",
    "schemaVersion": "1.5",
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "15134f45-e421-46d8-bda8-cfc4093fd0cb",
                "x": 0,
                "y": 0,
                "w": 1,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Model Versions by Stage",
                    "description": "",
                    "timeframe": "none",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[modelVersions]}}",
                        "name": "modelVersions",
                        "pluginConfigId": "{{configId}}",
                        "group": {
                            "by": [["current_stage", "uniqueValues"]],
                            "aggregate": [{ "type": "count" }]
                        }
                    },
                    "visualisation": {
                        "type": "data-stream-donut-chart",
                        "config": {
                            "data-stream-donut-chart": {
                                "valueColumn": "count",
                                "labelColumn": "current_stage_uniqueValues",
                                "hideCenterValue": false,
                                "showValuesAsPercentage": false,
                                "legendPosition": "auto",
                                "legendMode": "table"
                            }
                        }
                    }
                }
            },
            {
                "i": "d12ff10a-8dd1-479e-8bfb-d99e71820e09",
                "x": 1,
                "y": 0,
                "w": 3,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Time in Current Stage",
                    "description": "",
                    "timeframe": "none",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[modelVersions]}}",
                        "name": "modelVersions",
                        "pluginConfigId": "{{configId}}",
                        "sort": { "by": [["timeInCurrentStageMs", "desc"]] }
                    },
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": [
                                    "versionDisplayName",
                                    "current_stage",
                                    "timeInCurrentStageMs",
                                    "runName"
                                ],
                                "hiddenColumns": [
                                    "name",
                                    "version",
                                    "versionId",
                                    "status",
                                    "run_id",
                                    "source",
                                    "creation_timestamp",
                                    "last_updated_timestamp",
                                    "tags",
                                    "aliases"
                                ]
                            }
                        }
                    }
                }
            }
        ]
    }
}
