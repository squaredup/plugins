{
    "name": "mlflow",
    "displayName": "MLflow",
    "version": "1.1.0",
    "author": {
        "name": "@JackTSquppy",
        "type": "community"
    },
    "description": "Monitor MLflow experiments, runs, and the model registry from a self-hosted or Databricks-hosted tracking server.",
    "category": "Analytics",
    "type": "hybrid",
    "schemaVersion": "2.1",
    "importNotSupported": false,
    "restrictedToPlatforms": [],
    "keywords": ["mlflow", "machine learning", "ml", "experiment tracking", "model registry", "mlops", "databricks"],
    "objectTypes": ["MLflow Experiment", "MLflow Run", "MLflow Registered Model", "MLflow Model Version"],
    "links": [
        {
            "category": "documentation",
            "url": "https://github.com/squaredup/plugins/blob/main/plugins/MLflow/v1/docs/README.md",
            "label": "Help adding this plugin"
        },
        {
            "category": "source",
            "url": "https://github.com/squaredup/plugins/tree/main/plugins/MLflow/v1",
            "label": "Repository"
        }
    ],
    "base": {
        "plugin": "WebAPI",
        "majorVersion": "1",
        "config": {
            "baseUrl": "{{baseUrl}}",
            "authMode": "{{authType === 'basic' ? 'basic' : 'none'}}",
            "basicAuthUsername": "{{username}}",
            "basicAuthPassword": "{{password}}",
            "headers": [
                { "key": "Content-Type", "value": "application/json" },
                { "key": "Authorization", "value": "{{authType === 'bearer' ? 'Bearer ' + token : null}}" }
            ],
            "queryArgs": [],
            "ignoreCertificateErrors": "{{ignoreCertificateErrors}}"
        }
    }
}
