{
    "name": "labels",
    "displayName": "Label Names",
    "description": "Label names present in the time series database, optionally filtered by a series selector",
    "tags": [
        "Metadata"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "api/v1/labels",
        "getArgs": [
            {
                "key": "match[]",
                "value": "{{match || null}}"
            },
            {
                "key": "start",
                "value": "{{timeframe.unixStart}}"
            },
            {
                "key": "end",
                "value": "{{timeframe.unixEnd}}"
            },
            {
                "key": "limit",
                "value": "{{limit || null}}"
            }
        ],
        "postRequestScript": "labels.js",
        "paging": {
            "mode": "none"
        }
    },
    "ui": [
        {
            "type": "text",
            "name": "match",
            "label": "Series selector (optional)",
            "placeholder": "{job=\"node-exporter\"}",
            "help": "Only return labels from series matching this selector."
        },
        {
            "type": "number",
            "name": "limit",
            "label": "Limit (optional)"
        }
    ],
    "manualConfigApply": true,
    "matches": "none",
    "metadata": [
        {
            "name": "label",
            "displayName": "Label",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "value",
            "displayName": "Value",
            "shape": "string",
            "role": "value",
            "visible": false
        }
    ],
    "timeframes": true,
    "visibility": {
        "type": "hidden"
    }
}
