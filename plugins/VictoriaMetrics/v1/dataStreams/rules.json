{
    "name": "rules",
    "displayName": "Rules",
    "description": "Alerting and recording rules from vmalert with their state, health and last evaluation",
    "tags": [
        "Alerts",
        "vmalert"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "api/v1/rules",
        "getArgs": [
            {
                "key": "type",
                "value": "{{type && type !== 'all' ? type : null}}"
            }
        ],
        "postRequestScript": "rules.js",
        "paging": {
            "mode": "none"
        }
    },
    "matches": "none",
    "metadata": [
        {
            "name": "name",
            "displayName": "Rule",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "group",
            "displayName": "Group",
            "shape": "string"
        },
        {
            "name": "type",
            "displayName": "Type",
            "shape": "string"
        },
        {
            "name": "state",
            "displayName": "State",
            "shape": "state"
        },
        {
            "name": "health",
            "displayName": "Health",
            "shape": "string"
        },
        {
            "name": "activeAlerts",
            "displayName": "Active alerts",
            "shape": "number"
        },
        {
            "name": "query",
            "displayName": "Query",
            "shape": "string"
        },
        {
            "name": "lastEvaluation",
            "displayName": "Last evaluated",
            "shape": "date"
        },
        {
            "name": "lastError",
            "displayName": "Last error",
            "shape": "string"
        },
        {
            "name": "severity",
            "displayName": "Severity",
            "shape": "string"
        }
    ],
    "timeframes": false,
    "ui": [
        {
            "type": "switch",
            "name": "type",
            "label": "Rule type",
            "defaultValue": "all",
            "options": [
                {
                    "value": "all",
                    "label": "All"
                },
                {
                    "value": "alert",
                    "label": "Alerting"
                },
                {
                    "value": "record",
                    "label": "Recording"
                }
            ]
        }
    ],
    "manualConfigApply": true
}
