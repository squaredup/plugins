{
    "name": "query",
    "displayName": "MetricsQL Query",
    "description": "Results of a MetricsQL or PromQL query as a time series or instant values, optionally scoped to selected objects",
    "tags": [
        "Metrics",
        "MetricsQL",
        "PromQL"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "{{queryType === 'instant' ? 'api/v1/query' : 'api/v1/query_range'}}",
        "getArgs": [
            {
                "key": "query",
                "value": "{{query}}"
            },
            {
                "key": "start",
                "value": "{{queryType === 'instant' ? null : timeframe.unixStart}}"
            },
            {
                "key": "end",
                "value": "{{queryType === 'instant' ? null : Math.min(timeframe.unixEnd, Math.floor(Date.now() / 1000))}}"
            },
            {
                "key": "time",
                "value": "{{queryType === 'instant' ? Math.min(timeframe.unixEnd, Math.floor(Date.now() / 1000)) : null}}"
            },
            {
                "key": "step",
                "value": "{{queryType === 'instant' ? null : (step || Math.max(15, Math.ceil((timeframe.unixEnd - timeframe.unixStart) / 300)) + 's')}}"
            },
            {
                "key": "extra_filters[]",
                "value": "{{Array.isArray(scope) && scope.length ? '{' + (scope.flatMap(o => [].concat(o.selector || [])).filter(s => typeof s === 'string' && s && !s.includes('\":=') && !s.includes('\":in(')).join(' or ') || '__name__=\"__squaredup_no_matching_objects__\"') + '}' : null}}"
            }
        ],
        "postRequestScript": "query.js",
        "paging": {
            "mode": "none"
        }
    },
    "ui": [
        {
            "type": "code",
            "name": "query",
            "label": "Query",
            "language": "promql",
            "help": "A [MetricsQL](https://docs.victoriametrics.com/victoriametrics/metricsql/) or PromQL expression, e.g. `sum by (job) (rate(http_requests_total[5m]))`.",
            "validation": {
                "required": true
            }
        },
        {
            "type": "switch",
            "name": "queryType",
            "label": "Query type",
            "defaultValue": "range",
            "options": [
                {
                    "value": "range",
                    "label": "Range (time series)"
                },
                {
                    "value": "instant",
                    "label": "Instant (latest value)"
                }
            ]
        },
        {
            "type": "objects",
            "name": "scope",
            "label": "Objects (optional)",
            "help": "Restrict every series selector in the query to the selected objects. Leave empty to query everything. Objects that only come from other plugins (for example VictoriaLogs) don't match any series.",
            "matches": {
                "sourceName": {
                    "type": "equals",
                    "value": "VictoriaMetrics"
                },
                "selector": {
                    "type": "any"
                }
            }
        },
        {
            "type": "text",
            "name": "step",
            "label": "Step (optional)",
            "placeholder": "e.g. 1m",
            "help": "Resolution of range queries. Defaults to about 300 points across the timeframe."
        },
        {
            "type": "text",
            "name": "pivot",
            "label": "Pivot label (optional)",
            "placeholder": "e.g. kpi",
            "help": "Turn the values of this label into columns: series that differ only by this label become one row, with a column per label value. Useful for tables, e.g. `label_set(<cpu query>, \"kpi\", \"cpu\") or label_set(<memory query>, \"kpi\", \"memory\")` with pivot `kpi` gives one row per object with `cpu` and `memory` columns."
        }
    ],
    "manualConfigApply": true,
    "matches": "none",
