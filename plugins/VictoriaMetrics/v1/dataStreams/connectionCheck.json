{
    "name": "connectionCheck",
    "displayName": "Connection Check",
    "description": "First label name returned by the querying API, used to validate the connection",
    "tags": [
        "Metadata"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "api/v1/labels",
        "getArgs": [
            {
                "key": "limit",
                "value": "1"
            }
        ],
        "postRequestScript": "labels.js",
        "paging": {
            "mode": "none"
        }
    },
    "matches": "none",
    "metadata": [
        {
            "name": "label",
            "displayName": "Label",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "value",
            "displayName": "Value",
            "shape": "string",
            "role": "value",
            "visible": false
        }
    ],
    "timeframes": false,
    "visibility": {
        "type": "hidden"
    }
}
