{
    "name": "metricMetadata",
    "displayName": "Metric Metadata",
    "description": "Type, unit and help text for metrics, where metadata ingestion is enabled",
    "tags": [
        "Metadata"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "api/v1/metadata",
        "getArgs": [
            {
                "key": "metric",
                "value": "{{metric || null}}"
            },
            {
                "key": "limit",
                "value": "{{limit || null}}"
            }
        ],
        "postRequestScript": "metricMetadata.js",
        "paging": {
            "mode": "none"
        }
    },
    "matches": "none",
    "metadata": [
        {
            "name": "metric",
            "displayName": "Metric",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "type",
            "displayName": "Type",
            "shape": "string"
        },
        {
            "name": "unit",
            "displayName": "Unit",
            "shape": "string"
        },
        {
            "name": "help",
            "displayName": "Help",
            "shape": "string"
        }
    ],
    "timeframes": false,
    "ui": [
        {
            "type": "text",
            "name": "metric",
            "label": "Metric (optional)",
            "help": "Return metadata for this metric only."
        },
        {
            "type": "number",
            "name": "limit",
            "label": "Limit (optional)"
        }
    ],
    "manualConfigApply": true,
    "visibility": {
        "type": "hidden"
    }
}
