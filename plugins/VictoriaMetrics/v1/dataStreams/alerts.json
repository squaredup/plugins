{
    "name": "alerts",
    "displayName": "Alerts",
    "description": "Active and pending alerts from vmalert, one row per alert",
    "tags": [
        "Alerts",
        "vmalert"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "api/v1/alerts",
        "getArgs": [],
        "postRequestScript": "alerts.js",
        "paging": {
            "mode": "none"
        }
    },
    "matches": "none",
    "metadata": [
        {
            "name": "alertname",
            "displayName": "Alert",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "state",
            "displayName": "State",
            "shape": "state"
        },
        {
            "name": "severity",
            "displayName": "Severity",
            "shape": "string"
        },
        {
            "name": "value",
            "displayName": "Value",
            "shape": "number"
        },
        {
            "name": "activeAt",
            "displayName": "Active since",
            "shape": "date"
        },
        {
            "name": "summary",
            "displayName": "Summary",
            "shape": "string"
        },
        {
            "name": "description",
            "displayName": "Description",
            "shape": "string"
        },
        {
            "name": "group",
            "displayName": "Group",
            "shape": "string"
        },
        {
            "pattern": ".*"
        }
    ],
    "timeframes": false
}
