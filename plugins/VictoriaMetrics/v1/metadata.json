{
    "name": "victoriametrics",
    "displayName": "VictoriaMetrics",
    "version": "1.0.0",
    "author": {
        "name": "SquaredUp Labs",
        "type": "labs"
    },
    "description": "Query VictoriaMetrics with MetricsQL and index Kubernetes, OpenTelemetry and scrape-target objects from your metric labels.",
    "category": "Monitoring",
    "type": "hybrid",
    "schemaVersion": "2.1",
    "importNotSupported": false,
    "restrictedToPlatforms": [],
    "keywords": [
        "victoriametrics",
        "metricsql",
        "promql",
        "prometheus",
        "metrics",
        "tsdb",
        "opentelemetry",
        "otel",
        "kubernetes",
        "k8s",
        "vmalert"
    ],
    "objectTypes": [
        "Scrape Job",
        "Scrape Target",
        "Kubernetes Cluster",
        "Kubernetes Node",
        "Kubernetes Namespace",
        "Kubernetes Pod",
        "Kubernetes Container",
        "Kubernetes Service",
        "Kubernetes Ingress",
        "Kubernetes Deployment",
        "Kubernetes StatefulSet",
        "Kubernetes DaemonSet",
        "Kubernetes ReplicaSet",
        "Kubernetes Job",
        "Kubernetes CronJob",
        "Service",
        "Host",
        "Deployment Environment",
        "Cloud Resource",
        "FaaS Function",
        "Device",
        "AWS ECS Cluster",
        "AWS ECS Container",
        "AWS EKS Cluster",
        "GCP GCE Instance",
        "GCP Cloud Run Job Execution",
        "Heroku App"
    ],
    "links": [
        {
            "category": "documentation",
            "url": "https://github.com/squaredup/plugins/blob/main/plugins/VictoriaMetrics/v1/docs/README.md",
            "label": "Help adding this plugin"
        },
        {
            "category": "source",
            "url": "https://github.com/squaredup/plugins/tree/main/plugins/VictoriaMetrics",
            "label": "Repository"
        }
    ],
    "base": {
        "plugin": "WebAPI",
        "majorVersion": "1",
        "config": {
            "baseUrl": "{{url}}",
            "authMode": "{{authType === 'basic' ? 'basic' : 'none'}}",
            "basicAuthUsername": "{{authType === 'basic' ? username : null}}",
            "basicAuthPassword": "{{authType === 'basic' ? password : null}}",
            "ignoreCertificateErrors": "{{typeof ignoreCertificateErrors !== 'undefined' && ignoreCertificateErrors === true}}",
            "headers": [
                {
                    "key": "Authorization",
                    "value": "{{authType === 'token' ? 'Bearer ' + apiToken : null}}"
                }
            ],
            "queryArgs": []
        }
    }
}
