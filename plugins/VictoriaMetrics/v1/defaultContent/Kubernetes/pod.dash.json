            },
            {
                "i": "309867ab-eeaf-475a-9546-a23f8ed4ddb6",
                "x": 2,
                "y": 5,
                "w": 2,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Containers",
                    "description": "Usage against limits and restarts for each container",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[query]}}",
                        "name": "query",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "query": "WITH (\n    cpuUsed = (sum by (container) (rate(container_cpu_usage_seconds_total{container!=\"\", container!=\"POD\"}[5m])) or label_move(sum by (k8s.container.name) (container_cpu_usage or container_cpu_utilization), \"k8s.container.name\", \"container\")),\n    cpuLim = sum by (container) (kube_pod_container_resource_limits{resource=\"cpu\"}),\n    memUsed = (sum by (container) (container_memory_working_set_bytes{container!=\"\", container!=\"POD\"}) or label_move(sum by (k8s.container.name) ({__name__=~\"container_memory_working_set(_bytes)?\"}), \"k8s.container.name\", \"container\") or sum by (container) (container_memory_usage_bytes{container!=\"\", container!=\"POD\"})),\n    memLim = sum by (container) (kube_pod_container_resource_limits{resource=\"memory\"})\n)\nlabel_set(cpuUsed, \"kpi\", \"cpu\")\nor label_set(sum by (container) (kube_pod_container_resource_requests{resource=\"cpu\"}), \"kpi\", \"cpuRequest\")\nor label_set(cpuLim, \"kpi\", \"cpuLimit\")\nor label_set(100 * cpuUsed / cpuLim, \"kpi\", \"cpuLimitPct\")\nor label_set(memUsed, \"kpi\", \"memory\")\nor label_set(sum by (container) (kube_pod_container_resource_requests{resource=\"memory\"}), \"kpi\", \"memoryRequest\")\nor label_set(memLim, \"kpi\", \"memoryLimit\")\nor label_set(100 * memUsed / memLim, \"kpi\", \"memoryLimitPct\")\nor label_set(sum by (container) (increase(kube_pod_container_status_restarts_total[1h])) or label_move(sum by (k8s.container.name) (increase(k8s_container_restarts[1h])), \"k8s.container.name\", \"container\"), \"kpi\", \"restarts\")",
                            "queryType": "instant",
                            "pivot": "kpi",
                            "scope": {
                                "variable": "{{variables.[Kubernetes Pod]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Kubernetes Pods]}}"
                            }
                        },
                        "metadata": [
                            {
                                "name": "memory",
                                "shape": "bytes"
                            },
                            {
                                "name": "memoryRequest",
                                "shape": "bytes"
                            },
                            {
                                "name": "memoryLimit",
                                "shape": "bytes"
                            },
                            {
                                "name": "cpuLimitPct",
                                "shape": [
                                    "percent",
                                    {
                                        "decimalPlaces": 1
                                    }
                                ]
                            },
                            {
                                "name": "memoryLimitPct",
                                "shape": [
                                    "percent",
                                    {
                                        "decimalPlaces": 1
                                    }
                                ]
                            }
                        ]
                    },
                    "variables": [
                        "{{variables.[Kubernetes Pod]}}"
                    ],
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": [
                                    "ContainerLink",
                                    "cpu",
                                    "cpuLimitPct",
                                    "memory",
                                    "memoryLimitPct",
                                    "restarts"
                                ]
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "ContainerLink",
                                        "title": "Container",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "cpu",
                                        "title": "CPU (cores)",
                                        "renderer": {
                                            "type": "number",
                                            "decimals": 3
                                        },
                                        "align": "right"
                                    },
                                    {
                                        "field": "cpuLimitPct",
                                        "title": "CPU % of limit",
                                        "renderer": {
                                            "type": "bar",
                                            "thresholds": [
                                                {
                                                    "to": 70,
                                                    "color": "#2bb660"
                                                },
                                                {
                                                    "to": 90,
                                                    "color": "#ffaa00"
                                                },
                                                {
                                                    "to": 100000,
                                                    "color": "#f2164d"
                                                }
