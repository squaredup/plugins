            {
                "i": "f61a6961-2813-4446-9ed3-2cd227a287f0",
                "x": 0,
                "y": 5,
                "w": 2,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Network",
                    "description": "Bytes received and transmitted by the pod",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[query]}}",
                        "name": "query",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "query": "label_set(sum(rate(container_network_receive_bytes_total[5m])) or sum(rate({__name__=~\"k8s_pod_network_io(_bytes)?(_total)?\", direction=\"receive\" or __name__=~\"k8s_pod_network_io(_bytes)?(_total)?\", network.io.direction=\"receive\"}[5m])), \"direction\", \"Receive\")\nor label_set(sum(rate(container_network_transmit_bytes_total[5m])) or sum(rate({__name__=~\"k8s_pod_network_io(_bytes)?(_total)?\", direction=\"transmit\" or __name__=~\"k8s_pod_network_io(_bytes)?(_total)?\", network.io.direction=\"transmit\"}[5m])), \"direction\", \"Transmit\")",
                            "queryType": "range",
                            "scope": {
                                "variable": "{{variables.[Kubernetes Pod]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Kubernetes Pods]}}"
                            }
                        },
                        "metadata": [
                            {
                                "name": "value",
                                "shape": "bytespersecondbinary",
                                "displayName": "Throughput"
                            }
                        ]
                    },
                    "variables": [
                        "{{variables.[Kubernetes Pod]}}"
                    ],
                    "visualisation": {
                        "type": "data-stream-line-graph",
                        "config": {
                            "data-stream-line-graph": {
                                "xAxisColumn": "timestamp",
                                "yAxisColumn": [
