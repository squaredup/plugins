                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[query]}}",
                        "name": "query",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "query": "label_set(sum by (container) (container_memory_working_set_bytes{container!=\"\", container!=\"POD\"}) or label_move(sum by (k8s.container.name) ({__name__=~\"container_memory_working_set(_bytes)?\"}), \"k8s.container.name\", \"container\") or sum by (container) (container_memory_usage_bytes{container!=\"\", container!=\"POD\"}), \"measure\", \"Used\")\nor label_set(sum by (container) (kube_pod_container_resource_requests{resource=\"memory\"}) or label_move(sum by (k8s.container.name) ({__name__=~\"k8s_container_memory_request(_bytes)?\"}), \"k8s.container.name\", \"container\"), \"measure\", \"Requested\")\nor label_set(sum by (container) (kube_pod_container_resource_limits{resource=\"memory\"}) or label_move(sum by (k8s.container.name) ({__name__=~\"k8s_container_memory_limit(_bytes)?\"}), \"k8s.container.name\", \"container\"), \"measure\", \"Limits\")",
                            "queryType": "range",
