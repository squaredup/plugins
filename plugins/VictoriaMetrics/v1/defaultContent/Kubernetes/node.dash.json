                    "dataStream": {
                        "id": "{{dataStreams.[query]}}",
                        "name": "query",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "query": "label_set((sum(rate(container_cpu_usage_seconds_total{container!=\"\", container!=\"POD\"}[5m])) or sum(k8s_pod_cpu_usage)), \"measure\", \"Used\")\nor label_set((sum(kube_pod_container_resource_requests{resource=\"cpu\"}) or sum(k8s_container_cpu_request)), \"measure\", \"Requested\")\nor label_set((sum(kube_pod_container_resource_limits{resource=\"cpu\"}) or sum(k8s_container_cpu_limit)), \"measure\", \"Limits\")\nor label_set((sum(kube_node_status_allocatable{resource=\"cpu\"}) or sum(k8s_node_allocatable_cpu)), \"measure\", \"Allocatable\")",
                            "queryType": "range",
                            "scope": {
                                "variable": "{{variables.[Kubernetes Node]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Kubernetes Nodes]}}"
                            }
