            {
                "i": "9f5fc0fb-d1ab-4df2-9735-6956e112b18e",
                "x": 3,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Conditions",
                    "description": "Node conditions reported by the kubelet",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[query]}}",
                        "name": "query",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "query": "label_set(max by (condition) (kube_node_status_condition{condition=\"Ready\", status=\"true\"}) == 1, \"state\", \"success\")\nor label_set(max by (condition) (kube_node_status_condition{condition=\"Ready\", status=\"true\"}) == 0, \"state\", \"error\")\nor label_set(max by (condition) (kube_node_status_condition{condition!=\"Ready\", status=\"true\"}) == 0, \"state\", \"success\")\nor label_set(max by (condition) (kube_node_status_condition{condition!=\"Ready\", status=\"true\"}) == 1, \"state\", \"error\")\nor label_set(max(k8s_node_condition_ready) == 1, \"condition\", \"Ready\", \"state\", \"success\")\nor label_set(max(k8s_node_condition_ready) < 1, \"condition\", \"Ready\", \"state\", \"error\")\nor label_set(max(k8s_node_condition_memory_pressure) == 0, \"condition\", \"MemoryPressure\", \"state\", \"success\")\nor label_set(max(k8s_node_condition_memory_pressure) != 0, \"condition\", \"MemoryPressure\", \"state\", \"error\")\nor label_set(max(k8s_node_condition_disk_pressure) == 0, \"condition\", \"DiskPressure\", \"state\", \"success\")\nor label_set(max(k8s_node_condition_disk_pressure) != 0, \"condition\", \"DiskPressure\", \"state\", \"error\")\nor label_set(max(k8s_node_condition_pid_pressure) == 0, \"condition\", \"PIDPressure\", \"state\", \"success\")\nor label_set(max(k8s_node_condition_pid_pressure) != 0, \"condition\", \"PIDPressure\", \"state\", \"error\")",
                            "queryType": "instant",
                            "scope": {
                                "variable": "{{variables.[Kubernetes Node]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Kubernetes Nodes]}}"
                            }
                        }
                    },
                    "variables": [
                        "{{variables.[Kubernetes Node]}}"
                    ],
                    "visualisation": {
                        "type": "data-stream-blocks",
                        "config": {
                            "data-stream-blocks": {
                                "labelColumn": "condition",
                                "stateColumn": "state",
                                "linkColumn": "none",
                                "columns": 4
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "statusGrid",
                            "encoding": {
                                "label": {
                                    "field": "condition",
