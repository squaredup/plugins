                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "query": "WITH (\n    cpuUsed = (sum by (cluster, namespace, pod) (rate(container_cpu_usage_seconds_total{container!=\"\", container!=\"POD\"}[5m])) or label_move(label_move(label_move(sum by (k8s.cluster.name, k8s.namespace.name, k8s.pod.name) (k8s_pod_cpu_usage), \"k8s.pod.name\", \"pod\"), \"k8s.namespace.name\", \"namespace\"), \"k8s.cluster.name\", \"cluster\")),\n    cpuLim = sum by (cluster, namespace, pod) (kube_pod_container_resource_limits{resource=\"cpu\"}),\n    memUsed = ((sum by (cluster, namespace, pod) (container_memory_working_set_bytes{container!=\"\", container!=\"POD\"}) or label_move(label_move(label_move(sum by (k8s.cluster.name, k8s.namespace.name, k8s.pod.name) ({__name__=~\"k8s_pod_memory_working_set(_bytes)?\"}), \"k8s.pod.name\", \"pod\"), \"k8s.namespace.name\", \"namespace\"), \"k8s.cluster.name\", \"cluster\") or sum by (cluster, namespace, pod) (container_memory_usage_bytes{container!=\"\", container!=\"POD\"}))),\n    memLim = sum by (cluster, namespace, pod) (kube_pod_container_resource_limits{resource=\"memory\"})\n)\nlabel_set(cpuUsed, \"kpi\", \"cpu\")\nor label_set(sum by (cluster, namespace, pod) (kube_pod_container_resource_requests{resource=\"cpu\"}), \"kpi\", \"cpuRequest\")\nor label_set(cpuLim, \"kpi\", \"cpuLimit\")\nor label_set(100 * cpuUsed / cpuLim, \"kpi\", \"cpuLimitPct\")\nor label_set(memUsed, \"kpi\", \"memory\")\nor label_set(sum by (cluster, namespace, pod) (kube_pod_container_resource_requests{resource=\"memory\"}), \"kpi\", \"memoryRequest\")\nor label_set(memLim, \"kpi\", \"memoryLimit\")\nor label_set(100 * memUsed / memLim, \"kpi\", \"memoryLimitPct\")\nor label_set(sum by (cluster, namespace, pod) (increase(kube_pod_container_status_restarts_total[1h])), \"kpi\", \"restarts\")",
                            "queryType": "instant",
                            "pivot": "kpi",
                            "scope": {
                                "variable": "{{variables.[Kubernetes Namespace]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Kubernetes Namespaces]}}"
                            }
                        },
                        "metadata": [
                            {
                                "name": "memory",
                                "shape": "bytes"
                            },
                            {
                                "name": "memoryRequest",
                                "shape": "bytes"
                            },
                            {
                                "name": "memoryLimit",
                                "shape": "bytes"
                            },
                            {
                                "name": "cpuLimitPct",
                                "shape": [
