                                    {
                                        "to": 0.7,
                                        "color": "#2bb660"
                                    },
                                    {
                                        "to": 0.9,
                                        "color": "#ffaa00"
                                    },
                                    {
                                        "to": 1,
                                        "color": "#f2164d"
                                    }
                                ]
                            }
                        }
                    }
                }
