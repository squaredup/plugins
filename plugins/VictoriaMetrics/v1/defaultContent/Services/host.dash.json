                            "query": "sum(max by (device, direction) (label_copy(rate(system_disk_io_bytes_total{}[5m]), \"disk.io.direction\", \"direction\"))) or (sum(rate(node_disk_read_bytes_total[5m])) + sum(rate(node_disk_written_bytes_total[5m])))",
                            "queryType": "instant",
                            "scope": {
