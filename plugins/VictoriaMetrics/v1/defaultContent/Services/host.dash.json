        "contents": [
            {
                "i": "a6667d61-11a5-4fdd-b155-4915c0b25e96",
                "x": 0,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "CPU Utilization",
                    "description": "",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[query]}}",
                        "name": "query",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "query": "100 * (1 - avg(system_cpu_utilization_ratio{state=\"idle\", cpu.mode=\"\" or cpu.mode=\"idle\"})) or 100 * (1 - sum(rate(system_cpu_time_seconds_total{state=\"idle\", cpu.mode=\"\" or cpu.mode=\"idle\"}[5m])) / sum(rate(system_cpu_time_seconds_total[5m]))) or 100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))",
                            "queryType": "instant",
                            "scope": {
                                "variable": "{{variables.[Host]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Hosts]}}"
                            }
                        },
                        "metadata": [
                            {
                                "name": "value",
                                "shape": [
                                    "percent",
                                    {
                                        "decimalPlaces": 1
                                    }
                                ],
                                "displayName": "CPU"
                            }
                        ]
                    },
                    "variables": [
                        "{{variables.[Host]}}"
                    ],
                    "visualisation": {
                        "type": "data-stream-gauge",
                        "config": {
                            "data-stream-gauge": {
                                "value": {
                                    "type": "arr",
                                    "columns": [
                                        "value"
                                    ]
                                },
                                "minimum": 0,
                                "maximum": 100
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "gauge",
                            "encoding": {
                                "value": {
                                    "field": "value",
                                    "type": "quantitative"
                                }
                            },
                            "style": {
                                "gaugeMin": 0,
                                "gaugeMax": 100,
                                "gaugeLabelText": "CPU busy",
