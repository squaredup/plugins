                                "y": {
                                    "field": "value",
                                    "type": "quantitative",
                                    "title": "CPU"
                                },
                                "series": {
                                    "field": "state",
                                    "type": "nominal"
                                }
                            },
                            "style": {
                                "legendPosition": "bottom",
                                "cartesianShowYAxisTitle": true,
                                "cartesianYAxisTitle": "CPU",
                                "cartesianStack": "on",
                                "cartesianAreaGradient": true
                            }
                        }
