                            "query": "100 * avg by (state) (label_copy(system_cpu_utilization_ratio{state!=\"idle\", cpu.mode!=\"idle\"}, \"cpu.mode\", \"state\")) or 100 * label_move(sum by (mode) (rate(node_cpu_seconds_total{mode!=\"idle\"}[5m])) / scalar(count(node_cpu_seconds_total{mode=\"idle\"})), \"mode\", \"state\") or 100 * label_move(sum by (state, cpu.mode) (rate(system_cpu_time_seconds_total{state!=\"idle\", cpu.mode!=\"idle\"}[5m])) / scalar(sum(rate(system_cpu_time_seconds_total[5m]))), \"cpu.mode\", \"state\")",
