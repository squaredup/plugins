{
    "name": "Alerts",
    "schemaVersion": "1.5",
    "timeframe": "last1hour",
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "66e5314e-d410-4111-85d6-7b3d438eab30",
                "x": 0,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Firing",
                    "description": "Alerts currently firing in vmalert",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[alerts]}}",
                        "name": "alerts",
                        "pluginConfigId": "{{configId}}",
                        "filter": {
                            "multiOperation": "and",
                            "filters": [
                                {
                                    "column": "alertState",
                                    "operation": "equals",
                                    "value": "firing"
                                }
                            ]
                        }
                    },
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": []
                            },
                            "style": {
                                "scalarRowCount": true,
                                "scalarLabelPosition": "none",
                                "scalarValueColor": "#f2164d"
                            }
                        }
                    }
                }
            },
            {
                "i": "28ffbc48-aabb-4b08-ab6c-6fd1b022f550",
                "x": 1,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Pending",
                    "description": "Alerts whose condition is true but has not yet held for its \"for\" duration",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[alerts]}}",
                        "name": "alerts",
                        "pluginConfigId": "{{configId}}",
                        "filter": {
                            "multiOperation": "and",
                            "filters": [
                                {
                                    "column": "alertState",
                                    "operation": "equals",
                                    "value": "pending"
                                }
                            ]
                        }
                    },
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": []
                            },
                            "style": {
                                "scalarRowCount": true,
                                "scalarLabelPosition": "none",
                                "scalarValueColor": "#ffaa00"
                            }
                        }
                    }
                }
            },
            {
                "i": "1fbafdcb-3194-4e1e-aa80-0e3ecb5af75f",
                "x": 2,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Unhealthy Rules",
                    "description": "Alerting and recording rules whose last evaluation failed",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[rules]}}",
                        "name": "rules",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "type": "all"
                        },
                        "filter": {
                            "multiOperation": "and",
                            "filters": [
                                {
                                    "column": "health",
                                    "operation": "notequals",
                                    "value": "ok"
                                }
                            ]
                        }
                    },
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": []
                            },
                            "style": {
                                "scalarRowCount": true,
                                "scalarLabelPosition": "none"
                            }
                        }
                    }
                }
            },
            {
                "i": "662ca94e-7e21-484e-b4c2-f39cf44e3d18",
                "x": 3,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Alerting Rules",
                    "description": "",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[rules]}}",
                        "name": "rules",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "type": "alert"
                        }
                    },
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": []
                            },
                            "style": {
                                "scalarRowCount": true,
                                "scalarLabelPosition": "none"
                            }
                        }
                    }
                }
            },
            {
                "i": "ade44bba-4063-49dd-ace2-97fabeef9c2d",
                "x": 0,
                "y": 2,
                "w": 4,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Active Alerts",
                    "description": "Firing and pending alerts with their labels in the details panel",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[alerts]}}",
                        "name": "alerts",
                        "pluginConfigId": "{{configId}}"
                    },
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": [
                                    "alertname",
                                    "state",
                                    "alertState",
                                    "severity",
                                    "summary",
                                    "group",
                                    "activeAt",
                                    "value"
                                ]
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "alertname",
                                        "title": "Alert",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "state",
                                        "title": "State",
                                        "renderer": {
                                            "type": "status",
                                            "showLabel": false
                                        },
                                        "width": 60,
                                        "align": "center"
                                    },
                                    {
                                        "field": "alertState",
                                        "title": "Status",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "firing": "#f2164d",
                                                "pending": "#ffaa00"
                                            }
                                        }
                                    },
                                    {
                                        "field": "severity",
                                        "title": "Severity",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "critical": "#f2164d",
                                                "error": "#f2164d",
                                                "warning": "#ffaa00",
                                                "info": "#3EB5FF"
                                            }
                                        }
                                    },
                                    {
                                        "field": "summary",
                                        "title": "Summary",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "group",
                                        "title": "Group",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "activeAt",
                                        "title": "Active since",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    },
                                    {
                                        "field": "value",
                                        "title": "Value",
                                        "renderer": {
                                            "type": "number",
                                            "decimals": 2
                                        },
                                        "align": "right"
                                    }
                                ]
                            },
                            "style": {
                                "richTableSort": {
                                    "field": "activeAt",
                                    "direction": "desc"
                                },
                                "detailsPanel": true,
                                "richTableWrapText": true
                            }
                        }
                    }
                }
            },
            {
                "i": "f8969511-ba28-45b5-aea0-dbf6b6839995",
                "x": 0,
                "y": 6,
                "w": 2,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Alerting Rules by Group",
                    "description": "Each alerting rule: red firing, amber pending, green inactive",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[rules]}}",
                        "name": "rules",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "type": "alert"
                        }
                    },
                    "visualisation": {
                        "type": "data-stream-blocks",
                        "config": {
                            "data-stream-blocks": {
                                "labelColumn": "name",
                                "stateColumn": "state",
                                "linkColumn": "none",
                                "columns": 4
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "statusGrid",
                            "encoding": {
                                "label": {
                                    "field": "name",
                                    "type": "nominal"
                                },
                                "status": {
                                    "field": "state",
                                    "type": "nominal"
                                },
                                "group": {
                                    "field": "group",
                                    "type": "nominal"
                                }
                            },
                            "style": {
                                "statusGridColumnsPerRow": 4,
                                "statusGridFlat": true,
                                "statusGridOrderByField": "state"
                            }
                        }
                    }
                }
            },
            {
                "i": "a48ad238-6757-438d-833a-25e087625940",
                "x": 2,
                "y": 6,
                "w": 2,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Rule Health",
                    "description": "Evaluation health of every alerting and recording rule",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[rules]}}",
                        "name": "rules",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "type": "all"
                        }
                    },
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": [
                                    "name",
                                    "group",
                                    "type",
                                    "health",
                                    "lastEvaluation",
                                    "lastError"
                                ]
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "name",
                                        "title": "Rule",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "group",
                                        "title": "Group",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "type",
                                        "title": "Type",
                                        "renderer": {
                                            "type": "badge"
                                        }
                                    },
                                    {
                                        "field": "health",
                                        "title": "Health",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "ok": "#2bb660",
                                                "err": "#f2164d",
                                                "unknown": "#9aa3ab"
                                            }
                                        }
                                    },
                                    {
                                        "field": "lastEvaluation",
                                        "title": "Last evaluated",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    },
                                    {
                                        "field": "lastError",
                                        "title": "Last error",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableSort": {
                                    "field": "health",
                                    "direction": "asc"
                                },
                                "detailsPanel": true
                            }
                        }
                    }
                }
            }
        ]
    }
}
