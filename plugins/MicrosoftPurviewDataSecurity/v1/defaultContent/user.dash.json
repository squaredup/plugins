{
    "name": "User",
    "schemaVersion": "1.5",
    "timeframe": "last7days",
    "variables": [
        "{{variables.[User]}}"
    ],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "6f17b3ee-30c8-466e-b08e-6cc47638138b",
                "x": 0,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "User Details",
                    "description": "The user's identity in Microsoft Entra ID",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "datastream-properties",
                        "name": "properties",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Users]}}",
                        "variable": "{{variables.[User]}}",
                        "workspace": "{{workspaceId}}"
                    },
                    "variables": [
                        "{{variables.[User]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "userPrincipalName",
                                        "title": "User principal name",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "entraObjectId",
                                        "title": "Entra object ID",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableCellPadding": 6,
                                "richTableTranspose": true,
                                "richTableWrapText": true
                            }
                        }
                    }
                }
            },
            {
                "i": "5bac23be-d6b1-411b-8a74-5faa67d4a9dd",
                "x": 1,
                "y": 0,
                "w": 3,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "AI Activity",
                    "description": "This user's Copilot and AI app interactions in the dashboard timeframe, the labelled resources they reached, and the risks detected in them",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[aiInteractions]}}",
                        "name": "aiInteractions",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "groupBy": [
                                "label"
                            ],
                            "users": {
                                "variable": "{{variables.[User]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Users]}}"
                            }
                        },
                        "group": {
                            "by": [],
                            "aggregate": [
                                {
                                    "type": "sum",
                                    "names": [
                                        "uniqueInteractions"
                                    ]
                                },
                                {
                                    "type": "sum",
                                    "names": [
                                        "labelledResources"
                                    ]
                                },
                                {
                                    "type": "sum",
                                    "names": [
                                        "dlpPolicyMatches"
                                    ]
                                },
                                {
                                    "type": "sum",
                                    "names": [
                                        "xpiaDetections"
                                    ]
                                },
                                {
                                    "type": "sum",
                                    "names": [
                                        "jailbreakAttempts"
                                    ]
                                }
                            ]
                        }
                    },
                    "variables": [
                        "{{variables.[User]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    {
                                        "field": "uniqueInteractions_sum",
                                        "type": "quantitative",
                                        "title": "Interactions"
                                    },
                                    {
                                        "field": "labelledResources_sum",
                                        "type": "quantitative",
                                        "title": "Labelled resources"
                                    },
                                    {
                                        "field": "dlpPolicyMatches_sum",
                                        "type": "quantitative",
                                        "title": "DLP policy matches"
                                    },
                                    {
                                        "field": "xpiaDetections_sum",
                                        "type": "quantitative",
                                        "title": "Prompt injections"
                                    },
                                    {
                                        "field": "jailbreakAttempts_sum",
                                        "type": "quantitative",
                                        "title": "Jailbreak attempts"
                                    }
                                ]
                            },
                            "style": {
                                "scalarColumns": 5
                            }
                        }
                    }
                }
            },
            {
                "i": "65958dd9-fb61-4344-b84f-f3461c425d71",
                "x": 0,
                "y": 2,
                "w": 2,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Labelled Data Reached by AI",
                    "description": "The sensitivity labels on data this user's AI interactions reached in the dashboard timeframe, least to most sensitive. An interaction counts once for each label it reached",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[aiInteractions]}}",
                        "name": "aiInteractions",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "groupBy": [
                                "label"
                            ],
                            "users": {
                                "variable": "{{variables.[User]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Users]}}"
                            }
                        },
                        "filter": {
                            "multiOperation": "and",
                            "filters": [
                                {
                                    "column": "sensitivityLabelId",
                                    "operation": "notempty"
                                }
                            ]
                        },
                        "sort": {
                            "by": [
                                [
                                    "labelPriority",
                                    "asc"
                                ]
                            ]
                        }
                    },
                    "variables": [
                        "{{variables.[User]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "sensitivityLabel",
                                    "type": "nominal",
                                    "title": "Sensitivity Label"
                                },
                                "y": [
                                    {
                                        "field": "interactions",
                                        "type": "quantitative",
                                        "title": "Interactions"
                                    },
                                    {
                                        "field": "labelledResources",
                                        "type": "quantitative",
                                        "title": "Labelled resources"
                                    }
                                ]
                            },
                            "style": {
                                "cartesianBarBorderRadius": 4,
                                "legendPosition": "bottom",
                                "colors": [
                                    "#8b5cf6",
                                    "#f97316"
                                ]
                            }
                        }
                    }
                }
            },
            {
                "i": "5bb72324-1c8d-42fe-b20f-6b08230c14a3",
                "x": 2,
                "y": 2,
                "w": 2,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "File Activity by Category",
                    "description": "This user's SharePoint and OneDrive activity in the dashboard timeframe, by kind of activity",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[fileActivity]}}",
                        "name": "fileActivity",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "groupBy": [
                                "category"
                            ],
                            "users": {
                                "variable": "{{variables.[User]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Users]}}"
                            }
                        },
                        "sort": {
                            "by": [
                                [
                                    "events",
                                    "desc"
                                ]
                            ]
                        }
                    },
                    "variables": [
                        "{{variables.[User]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "category",
                                    "type": "nominal",
                                    "title": "Category"
                                },
                                "y": {
                                    "field": "events",
                                    "type": "quantitative",
                                    "title": "Events"
                                }
                            },
                            "style": {
                                "cartesianHorizontal": true,
                                "cartesianBarBorderRadius": 4,
                                "showLabels": true,
                                "colors": [
                                    "#3b82f6"
                                ]
                            }
                        }
                    }
                }
            },
            {
                "i": "c9ad69f7-edc4-47ee-9b36-33f42fc01d09",
                "x": 0,
                "y": 5,
                "w": 4,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Label Activity",
                    "description": "Sensitivity label events by this user in the dashboard timeframe: labels applied, changed or removed, labelled files opened, and labelled email detected",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[labelActivity]}}",
                        "name": "labelActivity",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "groupBy": [
                                "time",
                                "action"
                            ],
                            "users": {
                                "variable": "{{variables.[User]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Users]}}"
                            }
                        }
                    },
                    "variables": [
                        "{{variables.[User]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "timestamp",
                                    "type": "temporal",
                                    "title": "Time"
                                },
                                "y": {
                                    "field": "events",
                                    "type": "quantitative",
                                    "title": "Events",
                                    "aggregate": "sum"
                                },
                                "series": {
                                    "field": "action",
                                    "type": "nominal",
                                    "title": "Action"
                                }
                            },
                            "style": {
                                "cartesianStack": "on",
                                "cartesianBarBorderRadius": 2,
                                "legendPosition": "bottom",
                                "mappedColors": {
                                    "Applied": "#22c55e",
                                    "Changed": "#3b82f6",
                                    "Upgraded": "#8b5cf6",
                                    "Downgraded": "#f97316",
                                    "Removed": "#ef4444",
                                    "Change failed": "#b91c1c",
                                    "Opened": "#06b6d4",
                                    "Renamed": "#94a3b8",
                                    "Detected in email": "#6366f1"
                                }
                            }
                        }
                    }
                }
            },
            {
                "i": "1258a8e1-e856-4463-9031-5ef36c982e2a",
                "x": 0,
                "y": 8,
                "w": 4,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Alerts Naming This User",
                    "description": "Data loss prevention, insider risk and Security for AI alerts with this user in their evidence, created in the last 30 days",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "last30days",
                    "dataStream": {
                        "id": "{{dataStreams.[alerts]}}",
                        "name": "alerts",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "users": {
                                "variable": "{{variables.[User]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Users]}}"
                            }
                        },
                        "sort": {
                            "by": [
                                [
                                    "createdDateTime",
                                    "desc"
                                ]
                            ]
                        }
                    },
                    "variables": [
                        "{{variables.[User]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "severity",
                                        "title": "Severity",
                                        "width": 80,
                                        "renderer": {
                                            "type": "status",
                                            "showLabel": false
                                        }
                                    },
                                    {
                                        "field": "title",
                                        "title": "Alert",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "serviceSource",
                                        "title": "Source",
                                        "width": 190,
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "Data loss prevention": "#3b82f6",
                                                "Insider risk management": "#d97706",
                                                "Security for AI": "#8b5cf6"
                                            }
                                        }
                                    },
                                    {
                                        "field": "status",
                                        "title": "Status",
                                        "width": 110,
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "assignedTo",
                                        "title": "Assigned To",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "createdDateTime",
                                        "title": "Created",
                                        "width": 130,
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableCellPadding": 6,
                                "richTableRowLinkField": "alertWebUrl"
                            }
                        }
                    }
                }
            }
        ]
    }
}
