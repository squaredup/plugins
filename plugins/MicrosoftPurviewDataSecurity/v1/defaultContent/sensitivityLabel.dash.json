{
    "name": "Sensitivity Label",
    "schemaVersion": "1.5",
    "timeframe": "last7days",
    "variables": [
        "{{variables.[Sensitivity Label]}}"
    ],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "4f57bb9c-5184-40fe-88a2-9cb18c7714c0",
                "x": 0,
                "y": 0,
                "w": 1,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Label Details",
                    "description": "The label's settings in Microsoft Purview",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "datastream-properties",
                        "name": "properties",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Sensitivity Labels]}}",
                        "variable": "{{variables.[Sensitivity Label]}}",
                        "workspace": "{{workspaceId}}"
                    },
                    "variables": [
                        "{{variables.[Sensitivity Label]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "priority",
                                        "title": "Priority",
                                        "renderer": {
                                            "type": "number"
                                        }
                                    },
                                    {
                                        "field": "parentName",
                                        "title": "Parent label",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "color",
                                        "title": "Colour",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "isActive",
                                        "title": "Active",
                                        "renderer": {
                                            "type": "boolean",
                                            "trueLabel": "Yes",
                                            "falseLabel": "No",
                                            "trueColor": "#22c55e",
                                            "falseColor": "#64748b"
                                        }
                                    },
                                    {
                                        "field": "isAppliable",
                                        "title": "Can be applied",
                                        "renderer": {
                                            "type": "boolean",
                                            "trueLabel": "Yes",
                                            "falseLabel": "No",
                                            "trueColor": "#22c55e",
                                            "falseColor": "#64748b"
                                        }
                                    },
                                    {
                                        "field": "hasProtection",
                                        "title": "Encryption",
                                        "renderer": {
                                            "type": "boolean",
                                            "trueLabel": "Yes",
                                            "falseLabel": "No",
                                            "trueColor": "#22c55e",
                                            "falseColor": "#64748b"
                                        }
                                    },
                                    {
                                        "field": "contentFormats",
                                        "title": "Applies to",
                                        "renderer": {
                                            "type": "tag-list",
                                            "color": "#3b82f6"
                                        }
                                    },
                                    {
                                        "field": "description",
                                        "title": "Description",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableCellPadding": 6,
                                "richTableTranspose": true,
                                "richTableWrapText": true
                            }
                        }
                    }
                }
            },
            {
                "i": "16cc1c6d-2882-48ac-ba0c-643e5775c823",
                "x": 1,
                "y": 0,
                "w": 3,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "AI Activity",
                    "description": "Copilot and AI app interactions that reached data with this label in the dashboard timeframe, the resources with this label they read, and those that matched a DLP policy",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[aiInteractions]}}",
                        "name": "aiInteractions",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "groupBy": [],
                            "labels": {
                                "variable": "{{variables.[Sensitivity Label]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Sensitivity Labels]}}"
                            }
                        },
                        "group": {
                            "by": [],
                            "aggregate": [
                                {
                                    "type": "sum",
                                    "names": [
                                        "uniqueInteractions"
                                    ]
                                },
                                {
                                    "type": "sum",
                                    "names": [
                                        "labelledResources"
                                    ]
                                },
                                {
                                    "type": "sum",
                                    "names": [
                                        "dlpPolicyMatches"
                                    ]
                                }
                            ]
                        }
                    },
                    "variables": [
                        "{{variables.[Sensitivity Label]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    {
                                        "field": "uniqueInteractions_sum",
                                        "type": "quantitative",
                                        "title": "Interactions"
                                    },
                                    {
                                        "field": "labelledResources_sum",
                                        "type": "quantitative",
                                        "title": "Resources read"
                                    },
                                    {
                                        "field": "dlpPolicyMatches_sum",
                                        "type": "quantitative",
                                        "title": "DLP policy matches"
                                    }
                                ]
                            },
                            "style": {
                                "scalarColumns": 3
                            }
                        }
                    }
                }
            },
            {
                "i": "f919f0a7-79d5-4fc8-a18b-71071adc513e",
                "x": 1,
                "y": 2,
                "w": 3,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Label Activity over Time",
                    "description": "Events for this label in the dashboard timeframe: applied, changed to or from it, removed, labelled files opened, and labelled email detected",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[labelActivity]}}",
                        "name": "labelActivity",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "groupBy": [
                                "time",
                                "action"
                            ],
                            "labels": {
                                "variable": "{{variables.[Sensitivity Label]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Sensitivity Labels]}}"
                            }
                        }
                    },
                    "variables": [
                        "{{variables.[Sensitivity Label]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "timestamp",
                                    "type": "temporal",
                                    "title": "Time"
                                },
                                "y": {
                                    "field": "events",
                                    "type": "quantitative",
                                    "title": "Events",
                                    "aggregate": "sum"
                                },
                                "series": {
                                    "field": "action",
                                    "type": "nominal",
                                    "title": "Action"
                                }
                            },
                            "style": {
                                "cartesianStack": "on",
                                "cartesianBarBorderRadius": 2,
                                "legendPosition": "bottom",
                                "mappedColors": {
                                    "Applied": "#22c55e",
                                    "Changed": "#3b82f6",
                                    "Upgraded": "#8b5cf6",
                                    "Downgraded": "#f97316",
                                    "Removed": "#ef4444",
                                    "Change failed": "#b91c1c",
                                    "Opened": "#06b6d4",
                                    "Renamed": "#94a3b8",
                                    "Detected in email": "#6366f1"
                                }
                            }
                        }
                    }
                }
            },
            {
                "i": "1f46d9bc-1a08-4ab2-b701-f5171cf93642",
                "x": 0,
                "y": 4,
                "w": 2,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Top AI Users",
                    "description": "The people whose AI interactions most often reached data with this label in the dashboard timeframe",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[aiInteractions]}}",
                        "name": "aiInteractions",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "groupBy": [
                                "user"
                            ],
                            "top": 10,
                            "labels": {
                                "variable": "{{variables.[Sensitivity Label]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Sensitivity Labels]}}"
                            }
                        },
                        "sort": {
                            "by": [
                                [
                                    "uniqueInteractions",
                                    "desc"
                                ]
                            ]
                        }
                    },
                    "variables": [
                        "{{variables.[Sensitivity Label]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "user",
                                    "type": "nominal",
                                    "title": "User"
                                },
                                "y": {
                                    "field": "uniqueInteractions",
                                    "type": "quantitative",
                                    "title": "Interactions",
                                    "aggregate": "sum"
                                }
                            },
                            "style": {
                                "cartesianHorizontal": true,
                                "cartesianBarBorderRadius": 4,
                                "showLabels": true,
                                "colors": [
                                    "#8b5cf6"
                                ]
                            }
                        }
                    }
                }
            },
            {
                "i": "16126b08-6720-46c5-a7fb-b124e08d39b7",
                "x": 2,
                "y": 4,
                "w": 2,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Who Applies or Changes It",
                    "description": "The people who applied, changed or removed this label most in the dashboard timeframe",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[labelActivity]}}",
                        "name": "labelActivity",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "groupBy": [
                                "user"
                            ],
                            "actions": [
                                "Applied",
                                "Changed",
                                "Upgraded",
                                "Downgraded",
                                "Removed"
                            ],
                            "top": 10,
                            "labels": {
                                "variable": "{{variables.[Sensitivity Label]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Sensitivity Labels]}}"
                            }
                        },
                        "filter": {
                            "multiOperation": "and",
                            "filters": [
                                {
                                    "column": "user",
                                    "operation": "notempty"
                                }
                            ]
                        },
                        "sort": {
                            "by": [
                                [
                                    "events",
                                    "desc"
                                ]
                            ]
                        }
                    },
                    "variables": [
                        "{{variables.[Sensitivity Label]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "user",
                                    "type": "nominal",
                                    "title": "User"
                                },
                                "y": {
                                    "field": "events",
                                    "type": "quantitative",
                                    "title": "Events",
                                    "aggregate": "sum"
                                }
                            },
                            "style": {
                                "cartesianHorizontal": true,
                                "cartesianBarBorderRadius": 4,
                                "showLabels": true,
                                "colors": [
                                    "#22c55e"
                                ]
                            }
                        }
                    }
                }
            }
        ]
    }
}
