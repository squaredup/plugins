{
    "name": "purview-data-security",
    "displayName": "Microsoft Purview Data Security",
    "version": "1.0.0",
    "author": {
        "name": "SquaredUp Labs",
        "type": "labs"
    },
    "description": "Track Microsoft Purview data loss prevention, insider risk and AI security alerts, sensitivity label use, file sharing, and the sensitive data Copilot and AI apps reach.",
    "category": "Security",
    "type": "hybrid",
    "schemaVersion": "2.1",
    "importNotSupported": false,
    "restrictedToPlatforms": [],
    "keywords": [
        "purview",
        "microsoft",
        "data security",
        "dlp",
        "data loss prevention",
        "insider risk",
        "information protection",
        "sensitivity labels",
        "copilot",
        "ai",
        "dspm",
        "sharepoint",
        "onedrive",
        "oversharing"
    ],
    "objectTypes": [
        "Sensitivity Label",
        "User",
        "AI App",
        "Site"
    ],
    "links": [
        {
            "category": "documentation",
            "url": "https://github.com/squaredup/plugins/blob/main/plugins/MicrosoftPurviewDataSecurity/v1/docs/README.md",
            "label": "Help adding this plugin"
        },
        {
            "category": "source",
            "url": "https://github.com/squaredup/plugins/tree/main/plugins/MicrosoftPurviewDataSecurity/v1",
            "label": "Repository"
        }
    ],
    "base": {
        "plugin": "WebAPI",
        "majorVersion": "1",
        "config": {
            "baseUrl": "https://graph.microsoft.com/",
            "authMode": "oauth2",
            "oauth2GrantType": "clientCredentials",
            "oauth2TokenUrl": "https://login.microsoftonline.com/{{tenantId}}/oauth2/v2.0/token",
            "oauth2ClientId": "{{clientId}}",
            "oauth2ClientSecret": "{{clientSecret}}",
            "oauth2ClientSecretLocationDuringAuth": "body",
            "oauth2Scope": "https://graph.microsoft.com/.default",
            "oauth2TokenExtraArgs": [
                {
                    "key": "grant_type",
                    "value": "client_credentials"
                },
                {
                    "key": "scope",
                    "value": "https://graph.microsoft.com/.default"
                }
            ],
            "oauth2TokenExtraHeaders": [
                {
                    "key": "Content-Type",
                    "value": "application/x-www-form-urlencoded"
                }
            ],
            "headers": [],
            "queryArgs": []
        }
    }
}
