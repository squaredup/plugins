{
    "name": "alerts",
    "displayName": "Alerts",
    "description": "Microsoft Purview data loss prevention, insider risk and Security for AI alerts",
    "tags": [
        "Alerts",
        "AI"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "errorHandling": {
            "type": "script",
            "script": "errorHandling/microsoftGraphApi.js"
        },
        "paging": {
            "mode": "nextUrl",
            "pageSize": {
                "realm": {
                    "value": "none",
                    "label": "none"
                }
            },
            "in": {
                "realm": {
                    "value": "payload",
                    "label": "payload"
                },
                "path": "@odata.nextLink"
            }
        },
        "endpointPath": "v1.0/security/alerts_v2",
        "postRequestScript": "alerts.js",
        "getArgs": [
            {
                "key": "$filter",
                "value": "{{ (() => { const vals = (a) => (Array.isArray(a) ? a : (a ? [a] : [])).map((m) => (m && typeof m === 'object' ? m.value : m)).filter((m) => m); const any = (field, list) => '(' + list.map((v) => field + \" eq '\" + v + \"'\").join(' or ') + ')'; const all = ['dataLossPrevention', 'microsoftInsiderRiskManagement', 'microsoftSecurityForAI']; const src = vals(typeof source === 'undefined' ? null : source); const sev = vals(typeof severity === 'undefined' ? null : severity); const sta = vals(typeof status === 'undefined' ? null : status); const col = vals(typeof timeframeCol === 'undefined' ? null : timeframeCol)[0] || 'createdDateTime'; const parts = [any('serviceSource', src.length ? src : all)]; if (sev.length) parts.push(any('severity', sev)); if (sta.length) parts.push(any('status', sta)); if (timeframe.enum !== 'none') parts.push(col + ' ge ' + timeframe.start + ' and ' + col + ' le ' + timeframe.end); return parts.join(' and '); })() }}"
            }
        ],
        "headers": [
            {
                "key": "Prefer",
                "value": "include-unknown-enum-members"
            }
        ]
    },
    "matches": "none",
    "metadata": [
        {
            "name": "id",
            "displayName": "ID",
            "shape": "string",
            "role": "id",
            "visible": false
        },
        {
