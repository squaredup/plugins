{
    "name": "validationHunting",
    "displayName": "Validation - AI Interactions",
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "post",
        "errorHandling": {
            "type": "script",
            "script": "errorHandling/microsoftGraphApi.js"
        },
        "paging": {
            "mode": "none"
        },
        "expandInnerObjects": false,
        "endpointPath": "v1.0/security/runHuntingQuery",
        "postBody": {
            "Query": "CloudAppEvents | where Timestamp > ago(30d) | where ActionType in ('CopilotInteraction', 'AIAppInteraction') | take 1 | project Timestamp"
        },
        "pathToData": "results",
        "getArgs": [],
        "headers": []
    },
    "matches": "none",
    "timeframes": false,
    "providesPluginDiagnostics": true,
    "visibility": {
        "type": "hidden"
    }
}
