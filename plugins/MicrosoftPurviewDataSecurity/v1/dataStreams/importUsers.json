{
    "name": "importUsers",
    "displayName": "Import - Users",
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "post",
        "errorHandling": {
            "type": "script",
            "script": "errorHandling/microsoftGraphApi.js"
        },
        "paging": {
            "mode": "none"
        },
        "expandInnerObjects": false,
        "endpointPath": "v1.0/security/runHuntingQuery",
        "postBody": {
            "Query": "IdentityInfo | where Timestamp > ago(14d) | where isnotempty(AccountObjectId) and isnotempty(AccountUpn) and Type == 'User' | extend entraObjectId = tolower(AccountObjectId) | where hash(entraObjectId, 4) == {{shardIndex}} | summarize arg_max(Timestamp, AccountUpn, AccountDisplayName, Department, JobTitle, IsAccountEnabled) by entraObjectId | project entraObjectId, displayName = iff(isempty(AccountDisplayName), tolower(AccountUpn), AccountDisplayName), userPrincipalName = tolower(AccountUpn), department = Department, jobTitle = JobTitle, accountEnabled = IsAccountEnabled, userType = iff(AccountUpn contains '#ext#', 'Guest', 'Member')"
        },
        "pathToData": "results",
        "getArgs": [],
        "headers": []
    },
    "matches": "none",
    "metadata": [
        {
            "name": "entraObjectId",
            "displayName": "Entra Object ID",
            "shape": "string",
            "role": "id"
        },
        {
            "name": "displayName",
            "displayName": "Name",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "userPrincipalName",
            "displayName": "User Principal Name",
            "shape": "string"
        },
        {
            "name": "department",
            "displayName": "Department",
            "shape": "string"
        },
        {
            "name": "jobTitle",
            "displayName": "Job Title",
            "shape": "string"
        },
        {
            "name": "accountEnabled",
            "displayName": "Account Enabled",
            "shape": "boolean"
        },
        {
            "name": "userType",
            "displayName": "User Type",
            "shape": "string"
        }
    ],
    "timeframes": false,
    "providesPluginDiagnostics": true,
    "visibility": {
        "type": "hidden"
    },
    "ui": [
        {
            "name": "shardIndex",
            "label": "Shard index",
            "type": "text",
            "defaultValue": "0"
        }
    ]
}
