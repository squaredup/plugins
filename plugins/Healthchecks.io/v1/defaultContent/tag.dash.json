                                    "status",
                                    "secondsSinceLastPing",
                                    "last_ping",
                                    "next_ping",
                                    "grace",
                                    "tags",
                                    "checkUrl"
                                ],
                                "hiddenColumns": [
                                    "status[Expanded].rawState",
                                    "started",
                                    "kind",
                                    "timeout",
                                    "schedule",
                                    "tz",
                                    "slug",
                                    "desc",
