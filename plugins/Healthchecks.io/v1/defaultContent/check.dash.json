                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Ping Timing",
                    "description": "When the next ping is due and how long the check waits before alerting",
                    "activePluginConfigIds": ["{{configId}}"],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[checks]}}",
                        "name": "checks",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "checks": {
                                "variable": "{{variables.[Healthchecks Check]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Healthchecks Checks]}}"
                            }
                        }
                    },
                    "variables": ["{{variables.[Healthchecks Check]}}"],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "next_ping",
                                        "title": "Next ping due",
                                        "renderer": {
                                            "type": "date"
                                        }
                                    },
                                    {
                                        "field": "last_ping",
                                        "title": "Last ping",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    },
                                    {
                                        "field": "timeout",
                                        "title": "Period",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "grace",
                                        "title": "Grace time",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "started",
                                        "title": "Running",
                                        "renderer": {
                                            "type": "boolean",
                                            "trueLabel": "Yes",
                                            "falseLabel": "No",
                                            "trueColor": "inherit",
                                            "falseColor": "inherit"
                                        }
                                    },
                                    {
                                        "field": "id",
                                        "title": "Check ID",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "manual_resume",
                                        "title": "Manual resume",
                                        "renderer": {
                                            "type": "boolean",
                                            "trueLabel": "Yes",
                                            "falseLabel": "No",
                                            "trueColor": "inherit",
                                            "falseColor": "inherit"
                                        }
                                    },
                                    {
                                        "field": "ping_url",
