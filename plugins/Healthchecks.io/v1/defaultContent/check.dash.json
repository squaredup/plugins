{
    "name": "Check",
    "schemaVersion": "1.5",
    "timeframe": "last7days",
    "variables": ["{{variables.[Healthchecks Check]}}"],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "779bc7d7-5ebb-459c-9040-9b5afcdbd625",
                "x": 0,
                "y": 0,
                "w": 1,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Check Properties",
                    "description": "",
                    "activePluginConfigIds": ["{{configId}}"],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "datastream-properties",
                        "name": "properties",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Healthchecks Checks]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Healthchecks Check]}}"
                    },
                    "variables": ["{{variables.[Healthchecks Check]}}"],
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": true,
                                "columnOrder": [
                                    "name",
                                    "description",
                                    "kind",
                                    "schedule",
                                    "tz",
                                    "checkTags",
                                    "slug",
                                    "link"
                                ],
                                "hiddenColumns": [
                                    "id",
                                    "links",
                                    "type",
                                    "label",
                                    "sourceId",
                                    "sourceType",
                                    "sourceName",
                                    "status",
                                    "timeout",
                                    "grace"
                                ],
                                "columnDisplayNames": {
                                    "tz": "Time zone",
                                    "checkTags": "Tags"
                                }
                            }
                        }
                    }
                }
            },
            {
                "i": "9eb7a9df-6776-4b4c-9d1c-a496e254e2cc",
                "x": 1,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Status",
                    "description": "Current status of this check; select it to open the check in Healthchecks.io",
                    "activePluginConfigIds": ["{{configId}}"],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[checks]}}",
                        "name": "checks",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "checks": {
                                "variable": "{{variables.[Healthchecks Check]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Healthchecks Checks]}}"
                            }
                        }
                    },
                    "variables": ["{{variables.[Healthchecks Check]}}"],
                    "visualisation": {
                        "type": "data-stream-blocks",
                        "config": {
                            "data-stream-blocks": {
                                "labelColumn": "name",
                                "stateColumn": "status",
                                "sublabel": "status[Expanded].rawState",
                                "linkColumn": "checkUrl",
                                "columns": 1
                            }
                        }
                    }
                }
            },
            {
                "i": "b69d52d5-eb88-49fd-9716-f7050a546e37",
                "x": 2,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Time Since Last Ping",
                    "description": "How long ago this check last received a ping",
                    "activePluginConfigIds": ["{{configId}}"],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[checks]}}",
                        "name": "checks",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "checks": {
                                "variable": "{{variables.[Healthchecks Check]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Healthchecks Checks]}}"
                            }
                        }
                    },
                    "variables": ["{{variables.[Healthchecks Check]}}"],
                    "visualisation": {
                        "type": "data-stream-scalar",
                        "config": {
                            "data-stream-scalar": {
                                "value": "secondsSinceLastPing",
                                "comparisonColumn": "none",
                                "label": "Since last ping"
                            }
                        }
                    }
                }
            },
            {
                "i": "e374f82e-32dd-4ed7-960f-80311c6e0f7c",
                "x": 3,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Ping Timing",
                    "description": "When the next ping is due and how long the check waits before alerting",
                    "activePluginConfigIds": ["{{configId}}"],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[checks]}}",
                        "name": "checks",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "checks": {
                                "variable": "{{variables.[Healthchecks Check]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Healthchecks Checks]}}"
                            }
                        }
                    },
                    "variables": ["{{variables.[Healthchecks Check]}}"],
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": true,
                                "columnOrder": [
                                    "next_ping",
                                    "last_ping",
                                    "timeout",
                                    "grace",
                                    "started"
                                ],
                                "hiddenColumns": [
                                    "name",
                                    "status",
                                    "status[Expanded].rawState",
                                    "secondsSinceLastPing",
                                    "kind",
                                    "schedule",
                                    "tz",
                                    "tags",
                                    "slug",
                                    "desc",
                                    "n_pings",
                                    "checkUrl"
                                ]
                            }
                        }
                    }
                }
            },
            {
                "i": "915c90a2-9c97-4d5b-9e6f-b200ad07434d",
                "x": 1,
                "y": 2,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Availability",
                    "description": "Share of the timeframe this check spent up and down",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[statusHistory]}}",
                        "name": "statusHistory",
                        "pluginConfigId": "{{configId}}",
                        "group": {
                            "by": [["status", "uniqueValues"]],
                            "aggregate": [
                                {
                                    "type": "sum",
                                    "names": ["durationSeconds"]
                                }
                            ]
                        }
                    },
                    "scope": {
                        "scope": "{{scopes.[Healthchecks Checks]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Healthchecks Check]}}"
                    },
                    "variables": ["{{variables.[Healthchecks Check]}}"],
                    "visualisation": {
                        "type": "data-stream-donut-chart",
                        "config": {
                            "data-stream-donut-chart": {
                                "valueColumn": "durationSeconds_sum",
                                "labelColumn": "status_uniqueValues",
                                "hideCenterValue": true,
                                "showValuesAsPercentage": true,
                                "legendPosition": "auto",
                                "legendMode": "table"
                            }
                        }
                    }
                }
            },
            {
                "i": "46be007d-ba58-447f-a33c-9ccbb5b07e20",
                "x": 2,
                "y": 2,
                "w": 2,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Status History",
                    "description": "Up and down periods of this check, newest first",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[statusHistory]}}",
                        "name": "statusHistory",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [["start", "desc"]]
                        }
                    },
                    "scope": {
                        "scope": "{{scopes.[Healthchecks Checks]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Healthchecks Check]}}"
                    },
                    "variables": ["{{variables.[Healthchecks Check]}}"],
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": [
                                    "status",
                                    "start",
                                    "end",
                                    "durationSeconds",
                                    "ongoing"
                                ],
                                "hiddenColumns": [
                                    "checkName",
                                    "status[Expanded].rawState"
                                ]
                            }
                        }
                    }
                }
            },
            {
                "i": "76113f71-3c2a-4caf-a842-7c5f290c1738",
                "x": 0,
                "y": 4,
                "w": 4,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Ping Results",
                    "description": "Pings received per day, by type",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[pings]}}",
                        "name": "pings",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [["date_byDay", "asc"]]
                        },
                        "group": {
                            "by": [["date", "byDay"], ["type", "uniqueValues"]],
                            "aggregate": [{ "type": "count" }]
                        }
                    },
                    "scope": {
                        "scope": "{{scopes.[Healthchecks Checks]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Healthchecks Check]}}"
                    },
                    "variables": ["{{variables.[Healthchecks Check]}}"],
                    "visualisation": {
                        "type": "data-stream-bar-chart",
                        "config": {
                            "data-stream-bar-chart": {
                                "xAxisData": "date_byDay",
                                "yAxisData": ["count"],
                                "xAxisGroup": "type_uniqueValues",
                                "xAxisLabel": "",
                                "yAxisLabel": "Pings",
                                "showXAxisLabel": false,
                                "showYAxisLabel": true,
                                "showLegend": true,
                                "legendPosition": "bottom",
                                "showGrid": true,
                                "horizontalLayout": "vertical",
                                "displayMode": "actual",
                                "showTotals": true,
                                "showValue": false,
                                "grouping": false,
                                "range": {
                                    "type": "auto"
                                }
                            }
                        }
                    }
                }
            },
            {
                "i": "c46e4213-b49c-4499-90d4-365fc05265aa",
                "x": 0,
                "y": 6,
                "w": 4,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Recent Pings",
                    "description": "Pings received by this check, newest first",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[pings]}}",
                        "name": "pings",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [["date", "desc"]]
                        }
                    },
                    "scope": {
                        "scope": "{{scopes.[Healthchecks Checks]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Healthchecks Check]}}"
                    },
                    "variables": ["{{variables.[Healthchecks Check]}}"],
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": [
                                    "date",
                                    "result",
                                    "type",
                                    "duration",
                                    "exitstatus",
                                    "method",
                                    "scheme",
                                    "remote_addr",
                                    "ua"
                                ],
                                "hiddenColumns": ["checkName"]
                            }
                        }
                    }
                }
            }
        ]
    }
}
