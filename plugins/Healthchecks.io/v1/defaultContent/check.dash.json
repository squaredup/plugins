                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    {
                                        "field": "secondsSinceLastPing",
                                        "type": "quantitative",
                                        "title": "Time since last ping"
                                    }
                                ]
                            },
                            "style": {
                                "scalarLabelText": "Since last ping"
                            }
                        }
                    }
                }
            },
            {
                "i": "e374f82e-32dd-4ed7-960f-80311c6e0f7c",
