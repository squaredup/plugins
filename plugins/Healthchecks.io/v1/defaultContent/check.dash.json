            },
            {
                "i": "915c90a2-9c97-4d5b-9e6f-b200ad07434d",
                "x": 1,
                "y": 2,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Availability",
                    "description": "Share of the timeframe this check spent up and down",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[statusHistory]}}",
                        "name": "statusHistory",
                        "pluginConfigId": "{{configId}}",
                        "group": {
                            "by": [["status", "uniqueValues"]],
                            "aggregate": [
                                {
                                    "type": "sum",
                                    "names": ["durationSeconds"]
                                }
                            ]
                        }
                    },
                    "scope": {
                        "scope": "{{scopes.[Healthchecks Checks]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Healthchecks Check]}}"
                    },
                    "variables": ["{{variables.[Healthchecks Check]}}"],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "pie",
                            "encoding": {
                                "label": {
                                    "field": "status_uniqueValues",
                                    "type": "nominal",
                                    "title": "Status"
                                },
                                "value": {
                                    "field": "durationSeconds_sum",
                                    "type": "quantitative",
                                    "aggregate": "sum",
                                    "title": "Duration (Sum)"
                                }
                            },
                            "style": {
                                "pieInnerRadius": 60,
                                "pieDonutCenterValue": "none",
                                "labelFontSize": 16,
                                "pieLegendStyle": "table",
                                "pieLabels": "nameAndPercent",
                                "mappedColors": {
                                    "critical": "#DE0038",
                                    "error": "#DE0038",
                                    "failed": "#DE0038",
                                    "failure": "#DE0038",
                                    "down": "#DE0038",
                                    "offline": "#DE0038",
                                    "unhealthy": "#DE0038",
                                    "high": "#DE0038",
                                    "warning": "#F59E0B",
                                    "warn": "#F59E0B",
                                    "medium": "#F59E0B",
                                    "moderate": "#F59E0B",
                                    "degraded": "#F59E0B",
                                    "partial": "#F59E0B",
                                    "ok": "#2BB660",
                                    "healthy": "#2BB660",
                                    "success": "#2BB660",
                                    "succeeded": "#2BB660",
                                    "passed": "#2BB660",
                                    "up": "#2BB660",
                                    "online": "#2BB660",
                                    "resolved": "#2BB660",
                                    "low": "#3B82F6",
                                    "info": "#3B82F6",
                                    "informational": "#3B82F6",
                                    "unknown": "#94A3B8",
                                    "unmonitored": "#94A3B8",
                                    "not monitored": "#94A3B8",
                                    "paused": "#94A3B8"
                                }
                            }
                        }
                    }
                }
            },
