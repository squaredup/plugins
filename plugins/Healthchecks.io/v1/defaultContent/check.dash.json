                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[pings]}}",
                        "name": "pings",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [["date_byDay", "asc"]]
