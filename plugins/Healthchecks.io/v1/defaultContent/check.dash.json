                                        "renderer": {
                                            "type": "link"
                                        }
                                    },
                                    {
                                        "field": "update_url",
                                        "title": "API URL",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "uuid",
                                        "title": "UUID",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "badge_url",
                                        "title": "Badge URL",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableTranspose": true
                            }
                        }
                    }
