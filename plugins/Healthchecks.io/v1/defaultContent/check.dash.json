                    "activePluginConfigIds": ["{{configId}}"],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[checks]}}",
                        "name": "checks",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "checks": {
                                "variable": "{{variables.[Healthchecks Check]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Healthchecks Checks]}}"
                            }
                        }
                    },
                    "variables": ["{{variables.[Healthchecks Check]}}"],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "statusGrid",
                            "encoding": {
                                "label": {
                                    "field": "name",
                                    "type": "nominal"
                                },
                                "status": {
                                    "field": "status",
                                    "type": "nominal"
                                },
                                "link": {
                                    "field": "checkUrl",
                                    "type": "nominal"
                                }
                            },
                            "style": {
                                "statusGridColumnsPerRow": 1,
                                "statusGridSecondaryTemplate": "{{{{raw}}}}{{lookup this \"status[Expanded].rawState\"}}{{{{/raw}}}}"
                            }
