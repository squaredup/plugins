                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Healthchecks Check]}}"
                    },
                    "variables": ["{{variables.[Healthchecks Check]}}"],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "date_byDay",
                                    "type": "temporal",
                                    "title": "Date"
                                },
                                "y": {
                                    "field": "count",
                                    "type": "quantitative",
                                    "title": "Count"
                                },
                                "series": {
                                    "field": "type_uniqueValues",
                                    "type": "nominal",
                                    "title": "Type"
                                }
                            },
                            "style": {
                                "legendPosition": "bottom",
                                "cartesianShowYAxisTitle": true,
                                "cartesianYAxisTitle": "Pings",
                                "cartesianStack": "on",
                                "cartesianShowStackedTotals": true
                            }
                        }
                    }
                }
            },
