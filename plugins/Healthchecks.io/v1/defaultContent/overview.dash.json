                "x": 0,
                "y": 2,
                "w": 1,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Checks by Status",
                    "description": "Current status of every check",
                    "activePluginConfigIds": ["{{configId}}"],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[checks]}}",
                        "name": "checks",
                        "pluginConfigId": "{{configId}}",
                        "group": {
                            "by": [["status", "uniqueValues"]],
                            "aggregate": [{ "type": "count" }]
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "pie",
                            "encoding": {
                                "label": {
                                    "field": "status_uniqueValues",
                                    "type": "nominal",
                                    "title": "Status"
                                },
                                "value": {
                                    "field": "count",
                                    "type": "quantitative",
                                    "aggregate": "sum",
                                    "title": "Count"
                                }
                            },
                            "style": {
                                "pieInnerRadius": 60,
                                "pieDonutCenterValue": "total",
                                "labelFontSize": 16,
                                "pieLegendStyle": "table",
                                "mappedColors": {
                                    "critical": "#DE0038",
                                    "error": "#DE0038",
                                    "failed": "#DE0038",
                                    "failure": "#DE0038",
                                    "down": "#DE0038",
                                    "offline": "#DE0038",
                                    "unhealthy": "#DE0038",
                                    "high": "#DE0038",
                                    "warning": "#F59E0B",
                                    "warn": "#F59E0B",
                                    "medium": "#F59E0B",
                                    "moderate": "#F59E0B",
                                    "degraded": "#F59E0B",
                                    "partial": "#F59E0B",
                                    "ok": "#2BB660",
                                    "healthy": "#2BB660",
                                    "success": "#2BB660",
                                    "succeeded": "#2BB660",
                                    "passed": "#2BB660",
                                    "up": "#2BB660",
                                    "online": "#2BB660",
                                    "resolved": "#2BB660",
                                    "low": "#3B82F6",
                                    "info": "#3B82F6",
                                    "informational": "#3B82F6",
                                    "unknown": "#94A3B8",
                                    "unmonitored": "#94A3B8",
                                    "not monitored": "#94A3B8",
                                    "paused": "#94A3B8"
                                }
                            }
                        }
                    }
                }
            },
            {
                "i": "adeb46cd-d28e-4d8d-ac21-0f3be515de75",
                "x": 1,
                "y": 2,
                "w": 3,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Checks Needing Attention",
                    "description": "Checks that are down or late, longest without a ping first",
                    "activePluginConfigIds": ["{{configId}}"],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[checks]}}",
                        "name": "checks",
                        "pluginConfigId": "{{configId}}",
                        "filter": {
                            "multiOperation": "or",
                            "filters": [
                                {
                                    "column": "status",
                                    "operation": "equals",
                                    "value": "error"
                                },
                                {
                                    "column": "status",
                                    "operation": "equals",
                                    "value": "warning"
                                }
                            ]
                        },
                        "sort": {
                            "by": [["secondsSinceLastPing", "desc"]]
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "name",
                                        "title": "Name",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "status[Expanded].rawState",
                                        "title": "Status",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "up": "#2BB660",
                                                "grace": "#F59E0B",
                                                "down": "#DE0038",
                                                "new": "#94A3B8"
                                            }
                                        }
                                    },
                                    {
                                        "field": "secondsSinceLastPing",
                                        "title": "Time since last ping",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "last_ping",
                                        "title": "Last ping",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    },
                                    {
                                        "field": "next_ping",
                                        "title": "Next ping due",
                                        "renderer": {
                                            "type": "date"
                                        }
                                    },
                                    {
                                        "field": "grace",
                                        "title": "Grace time",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "tags",
                                        "title": "Tags",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "checkUrl",
                                        "title": "Link",
                                        "renderer": {
                                            "type": "link"
                                        }
                                    }
                                ]
                            }
                        }
                    }
                }
            },
