                "config": {
                    "_type": "tile/data-stream",
                    "title": "Checks Down",
                    "description": "Checks that missed their expected ping and the grace time that follows it",
                    "activePluginConfigIds": ["{{configId}}"],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[checks]}}",
                        "name": "checks",
                        "pluginConfigId": "{{configId}}",
                        "filter": {
                            "multiOperation": "and",
                            "filters": [
                                {
                                    "column": "status",
                                    "operation": "equals",
                                    "value": "error"
                                }
                            ]
                        },
                        "group": {
                            "by": [],
                            "aggregate": [{ "type": "count" }]
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
