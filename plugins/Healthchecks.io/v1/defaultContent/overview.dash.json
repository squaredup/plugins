            {
                "i": "207fdac3-f9ad-4b44-8b01-a531df5cdd76",
                "x": 0,
                "y": 2,
                "w": 1,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Checks by Status",
                    "description": "Current status of every check",
                    "activePluginConfigIds": ["{{configId}}"],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[checks]}}",
                        "name": "checks",
                        "pluginConfigId": "{{configId}}",
                        "group": {
                            "by": [["status", "uniqueValues"]],
                            "aggregate": [{ "type": "count" }]
                        }
                    },
                    "visualisation": {
                        "type": "data-stream-donut-chart",
                        "config": {
                            "data-stream-donut-chart": {
                                "valueColumn": "count",
                                "labelColumn": "status_uniqueValues",
                                "hideCenterValue": false,
                                "showValuesAsPercentage": false,
                                "legendPosition": "auto",
                                "legendMode": "table"
                            }
                        }
                    }
                }
            },
            {
                "i": "adeb46cd-d28e-4d8d-ac21-0f3be515de75",
                "x": 1,
                "y": 2,
                "w": 3,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Checks Needing Attention",
                    "description": "Checks that are down or late, longest without a ping first",
                    "activePluginConfigIds": ["{{configId}}"],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[checks]}}",
                        "name": "checks",
                        "pluginConfigId": "{{configId}}",
                        "filter": {
                            "multiOperation": "or",
                            "filters": [
                                {
                                    "column": "status",
                                    "operation": "equals",
                                    "value": "error"
                                },
                                {
                                    "column": "status",
                                    "operation": "equals",
                                    "value": "warning"
                                }
                            ]
                        },
                        "sort": {
                            "by": [["secondsSinceLastPing", "desc"]]
                        }
                    },
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": [
                                    "name",
                                    "status",
                                    "secondsSinceLastPing",
                                    "last_ping",
                                    "next_ping",
                                    "grace",
                                    "tags",
                                    "checkUrl"
                                ],
                                "hiddenColumns": [
                                    "status[Expanded].rawState",
                                    "started",
                                    "kind",
                                    "timeout",
                                    "schedule",
                                    "tz",
                                    "slug",
                                    "desc",
                                    "n_pings"
                                ]
                            }
                        }
                    }
                }
            },
            {
                "i": "b16ae127-5eff-4302-bc9a-34c2c5232123",
                "x": 0,
                "y": 5,
                "w": 4,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "All Checks",
                    "description": "Every check in the project with its schedule and latest ping",
                    "activePluginConfigIds": ["{{configId}}"],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[checks]}}",
                        "name": "checks",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [["name", "asc"]]
                        }
                    },
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": [
                                    "name",
                                    "status",
                                    "last_ping",
                                    "next_ping",
                                    "kind",
                                    "timeout",
                                    "schedule",
                                    "tz",
                                    "grace",
                                    "tags",
                                    "checkUrl"
                                ],
                                "hiddenColumns": [
                                    "status[Expanded].rawState",
                                    "started",
                                    "secondsSinceLastPing",
                                    "slug",
                                    "desc",
                                    "n_pings"
                                ]
                            }
                        }
                    }
                }
