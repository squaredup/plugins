{
    "name": "healthchecks-io",
    "displayName": "Healthchecks.io",
    "version": "1.0.1",
    "author": {
        "name": "@adamkinniburgh",
        "type": "community"
    },
    "description": "Monitor your cron jobs and scheduled tasks with check status, availability and job run times.",
    "category": "Monitoring",
    "type": "hybrid",
    "schemaVersion": "2.1",
    "importNotSupported": false,
    "restrictedToPlatforms": [],
    "keywords": [
        "healthchecks",
        "healthchecks.io",
        "cron",
        "cron job",
        "heartbeat",
        "scheduled task",
        "dead man's switch",
        "uptime",
        "monitoring"
    ],
    "objectTypes": ["Check", "Tag"],
    "links": [
        {
            "category": "documentation",
            "url": "https://github.com/squaredup/plugins/blob/main/plugins/Healthchecks.io/v1/docs/README.md",
            "label": "Help adding this plugin"
        },
        {
            "category": "source",
            "url": "https://github.com/squaredup/plugins/tree/main/plugins/Healthchecks.io/v1",
            "label": "Repository"
        }
    ],
    "base": {
        "plugin": "WebAPI",
        "majorVersion": "1",
        "config": {
            "baseUrl": "{{ (serverUrl || 'https://healthchecks.io').trim().replace(/[/]+$/, '').replace(/[/]api([/]v[0-9]+)?$/i, '') }}/api/v3/",
            "authMode": "none",
            "headers": [
                {
                    "key": "X-Api-Key",
                    "value": "{{ apiKey.trim() }}"
                },
                {
                    "key": "Accept",
                    "value": "application/json"
                }
            ],
            "queryArgs": []
        }
    }
}
