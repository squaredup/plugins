                                            "id": "{{dataStreams.[repositoryStates]}}"
                                        }
                                    },
                                    "tableName": "dataset1"
                                }
                            ],
                            "sql": "SELECT\n    \"Name\",\n    ROUND(\n        CASE WHEN \"capacityGB\" > 0\n             THEN (\"freeGB\" / \"capacityGB\") * 100\n             ELSE NULL\n        END,\n        1\n    ) AS \"Free Space %\"\nFROM dataset1\nORDER BY \"Free Space %\" ASC;"
                        },
                        "metadata": [
                            {
                                "shape": ["percent", { "thousandsSeparator": true, "asZeroToOne": false }],
                                "name": "Free Space %"
                            },
