{
    "name": "reservedDomains",
    "displayName": "Reserved Domains",
    "description": "Reserved domains with certificate management and provisioning status",
    "tags": [
        "Network",
        "Certificates"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "reserved_domains",
        "getArgs": [
            {
                "key": "filter",
                "value": "{{ (typeof domain !== 'undefined' && domain && domain.length ? 'obj.id in [' + domain.flatMap((o) => o.rawId).map((i) => '\"' + i + '\"').join(',') + ']' : null) }}"
            }
        ],
        "postRequestScript": "reservedDomains.js",
        "paging": {
            "mode": "nextUrl",
            "pageSize": {
                "realm": "queryArg",
                "path": "limit",
                "value": "100"
            },
            "in": {
                "realm": "payload",
                "path": "next_page_uri"
            }
        },
        "errorHandling": {
            "type": "path",
            "realm": "payload",
            "path": "msg"
        }
    },
    "matches": "none",
    "ui": [
        {
            "type": "objects",
            "name": "domain",
            "label": "Reserved domain(s)",
            "matches": {
                "sourceType": {
                    "type": "oneOf",
                    "values": [
                        "Reserved Domain"
                    ]
                }
            }
        }
    ],
    "metadata": [
        {
            "name": "id",
            "displayName": "Domain ID",
            "role": "id",
            "visible": false
        },
        {
            "name": "domain",
            "displayName": "Domain",
            "role": "label"
        },
        {
            "sourceId": "id",
            "sourceType": "Reserved Domain",
            "name": "domain"
        },
        {
            "name": "description",
            "displayName": "Description"
        },
        {
            "name": "isDev",
            "displayName": "Dev domain",
            "shape": "boolean"
        },
        {
            "name": "cnameTarget",
            "displayName": "CNAME target"
        },
        {
            "name": "certificateSource",
            "displayName": "Certificate source"
        },
        {
            "name": "certificateId",
            "displayName": "Certificate ID"
        },
        {
            "name": "renewsAt",
            "displayName": "Certificate renews",
            "shape": "date"
        },
        {
            "name": "certificateStatus",
            "displayName": "Certificate status",
            "shape": [
                "state",
                {
                    "map": {
                        "error": [
                            "DNS error",
                            "Provisioning error",
                            "No certificate"
                        ],
                        "warning": [
                            "Provisioning",
                            "Renewal overdue"
                        ],
                        "success": [
                            "OK"
                        ]
                    }
                }
            ]
        },
        {
            "name": "provisioningError",
            "displayName": "Provisioning error"
        },
        {
            "name": "provisioningRetriesAt",
            "displayName": "Provisioning retries",
            "shape": "date"
        },
        {
            "name": "created_at",
            "displayName": "Created",
            "shape": "date"
        }
    ],
    "timeframes": false
}
