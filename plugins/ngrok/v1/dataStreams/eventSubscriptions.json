{
    "name": "eventSubscriptions",
    "displayName": "Event Subscriptions",
    "description": "Log export subscriptions with the event types they export and their destination count",
    "tags": [
        "Logs"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "event_subscriptions",
        "postRequestScript": "eventSubscriptions.js",
        "paging": {
            "mode": "nextUrl",
            "pageSize": {
                "realm": "queryArg",
                "path": "limit",
                "value": "100"
            },
            "in": {
                "realm": "payload",
                "path": "next_page_uri"
            }
        },
        "errorHandling": {
            "type": "path",
            "realm": "payload",
            "path": "msg"
        }
    },
    "matches": "none",
    "metadata": [
        {
            "name": "id",
            "displayName": "Subscription ID",
            "role": "id",
            "visible": false
        },
        {
            "name": "description",
            "displayName": "Description",
            "role": "label"
        },
        {
            "name": "eventTypes",
            "displayName": "Event types",
            "shape": [
                "array",
                {
                    "itemShape": "string"
                }
            ]
        },
        {
            "name": "destinationIds",
            "displayName": "Destination IDs",
            "shape": [
                "array",
                {
                    "itemShape": "string"
                }
            ]
        },
        {
            "name": "destinationCount",
            "displayName": "Destinations",
            "shape": "number"
        },
        {
            "name": "created_at",
            "displayName": "Created",
            "shape": "date"
        }
    ],
    "timeframes": false
}
