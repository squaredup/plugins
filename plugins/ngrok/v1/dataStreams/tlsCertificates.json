{
    "name": "tlsCertificates",
    "displayName": "TLS Certificates",
    "description": "TLS certificates with issuer, validity dates and days until expiry",
    "tags": [
        "Certificates",
        "Security"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "tls_certificates",
        "expandInnerObjects": true,
        "getArgs": [
            {
                "key": "filter",
                "value": "{{ (typeof certificate !== 'undefined' && certificate && certificate.length ? 'obj.id in [' + certificate.flatMap((o) => o.rawId).map((i) => '\"' + i + '\"').join(',') + ']' : null) }}"
            }
        ],
        "pathToData": "tls_certificates",
        "paging": {
            "mode": "nextUrl",
            "pageSize": {
                "realm": "queryArg",
                "path": "limit",
                "value": "100"
            },
            "in": {
                "realm": "payload",
                "path": "next_page_uri"
            }
        },
        "errorHandling": {
            "type": "path",
            "realm": "payload",
            "path": "msg"
        }
    },
    "matches": "none",
    "ui": [
        {
            "type": "objects",
            "name": "certificate",
            "label": "TLS certificate(s)",
            "matches": {
                "sourceType": {
                    "type": "oneOf",
                    "values": [
                        "TLS Certificate"
                    ]
                }
            }
        }
    ],
    "metadata": [
        {
            "name": "id",
            "displayName": "Certificate ID",
            "role": "id",
            "visible": false
        },
        {
            "name": "subject_common_name",
            "displayName": "Common name",
            "role": "label"
        },
        {
            "sourceId": "id",
            "sourceType": "TLS Certificate",
            "name": "subject_common_name"
        },
        {
            "name": "description",
            "displayName": "Description"
        },
        {
            "name": "subject_alternative_names.dns_names",
            "displayName": "DNS names",
            "shape": [
                "array",
                {
                    "itemShape": "string"
                }
            ]
        },
        {
            "name": "issuer_common_name",
            "displayName": "Issuer"
        },
        {
            "name": "issued_at",
            "displayName": "Issued",
            "shape": "date"
        },
        {
            "name": "managedBy",
            "displayName": "Managed by",
            "computed": true,
            "valueExpression": "{{ $['issued_at'] ? 'ngrok (automatic)' : 'Uploaded' }}"
        },
        {
            "name": "not_before",
            "displayName": "Valid from",
            "shape": "date"
        },
        {
            "name": "not_after",
            "displayName": "Expires",
            "shape": "date"
        },
        {
            "name": "daysUntilExpiry",
            "displayName": "Days until expiry",
            "computed": true,
            "shape": "number",
            "role": "value",
            "valueExpression": "{{ $['not_after'] ? Math.floor((new Date($['not_after']).getTime() - Date.now()) / 86400000) : null }}"
        },
        {
            "name": "expiryStatus",
            "displayName": "Expiry status",
            "computed": true,
            "valueExpression": "{{ $['daysUntilExpiry'] == null ? null : $['daysUntilExpiry'] < 0 ? 'Expired' : $['daysUntilExpiry'] <= 7 ? 'Expires within 7 days' : $['daysUntilExpiry'] <= 30 ? 'Expires within 30 days' : 'Valid' }}",
            "shape": [
                "state",
                {
                    "map": {
                        "error": [
                            "Expired",
                            "Expires within 7 days"
                        ],
                        "warning": [
                            "Expires within 30 days"
                        ],
                        "success": [
                            "Valid"
                        ]
                    }
                }
            ]
        },
        {
            "name": "private_key_type",
            "displayName": "Key type"
        },
        {
            "name": "serial_number",
            "displayName": "Serial number",
            "visible": false
        },
        {
            "name": "created_at",
            "displayName": "Created",
            "shape": "date"
        }
    ],
    "timeframes": false
}
