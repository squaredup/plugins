{
    "name": "trafficIdentities",
    "displayName": "Traffic Identities",
    "description": "Users who have signed in to endpoints protected by OAuth, OIDC or SAML, with last activity",
    "tags": [
        "User",
        "Security"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "app/users",
        "expandInnerObjects": true,
        "pathToData": "application_users",
        "paging": {
            "mode": "nextUrl",
            "pageSize": {
                "realm": "queryArg",
                "path": "limit",
                "value": "100"
            },
            "in": {
                "realm": "payload",
                "path": "next_page_uri"
            }
        },
        "errorHandling": {
            "type": "path",
            "realm": "payload",
            "path": "msg"
        }
    },
    "matches": "none",
    "metadata": [
        {
            "name": "id",
            "displayName": "Identity ID",
            "role": "id",
            "visible": false
        },
        {
            "name": "name",
            "displayName": "Name",
            "role": "label"
        },
        {
            "name": "email",
            "displayName": "Email"
        },
        {
            "name": "username",
            "displayName": "Username"
        },
        {
            "name": "identity_provider.name",
            "displayName": "Identity provider"
        },
        {
            "name": "last_login",
            "displayName": "Last login",
            "shape": "date"
        },
        {
            "name": "last_active",
            "displayName": "Last active",
            "shape": "date"
        },
        {
            "name": "created_at",
            "displayName": "First seen",
            "shape": "date"
        }
    ],
    "timeframes": false
}
