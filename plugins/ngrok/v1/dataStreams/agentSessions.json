{
    "name": "agentSessions",
    "displayName": "Agent Sessions",
    "description": "ngrok agents currently connected to the account, with version, OS, IP and region",
    "tags": [
        "Network"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "tunnel_sessions",
        "expandInnerObjects": true,
        "pathToData": "tunnel_sessions",
        "paging": {
            "mode": "nextUrl",
            "pageSize": {
                "realm": "queryArg",
                "path": "limit",
                "value": "100"
            },
            "in": {
                "realm": "payload",
                "path": "next_page_uri"
            }
        },
        "errorHandling": {
            "type": "path",
            "realm": "payload",
            "path": "msg"
        }
    },
    "matches": "none",
    "metadata": [
        {
            "name": "id",
            "displayName": "Agent session ID",
            "role": "id",
            "visible": false
        },
        {
            "name": "ip",
            "displayName": "IP address",
            "role": "label"
        },
        {
            "name": "agent_version",
            "displayName": "Agent version"
        },
        {
            "name": "os",
            "displayName": "OS"
        },
        {
            "name": "region",
            "displayName": "Region"
        },
        {
            "name": "transport",
            "displayName": "Transport"
        },
        {
            "name": "started_at",
            "displayName": "Started",
            "shape": "date"
        },
        {
            "name": "uptime",
            "displayName": "Uptime",
            "computed": true,
            "shape": "seconds",
            "valueExpression": "{{ $['started_at'] ? Math.floor((Date.now() - new Date($['started_at']).getTime()) / 1000) : null }}"
        },
        {
            "name": "credential.id",
            "displayName": "Authtoken ID"
        }
    ],
    "timeframes": false
}
