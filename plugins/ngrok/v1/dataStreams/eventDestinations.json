{
    "name": "eventDestinations",
    "displayName": "Event Destinations",
    "description": "Log export destinations with their target service and location (credentials excluded)",
    "tags": [
        "Logs"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "event_destinations",
        "postRequestScript": "eventDestinations.js",
        "paging": {
            "mode": "nextUrl",
            "pageSize": {
                "realm": "queryArg",
                "path": "limit",
                "value": "100"
            },
            "in": {
                "realm": "payload",
                "path": "next_page_uri"
            }
        },
        "errorHandling": {
            "type": "path",
            "realm": "payload",
            "path": "msg"
        }
    },
    "matches": "none",
    "metadata": [
        {
            "name": "id",
            "displayName": "Destination ID",
            "role": "id",
            "visible": false
        },
        {
            "name": "description",
            "displayName": "Description",
            "role": "label"
        },
        {
            "name": "targetType",
            "displayName": "Target"
        },
        {
            "name": "location",
            "displayName": "Location"
        },
        {
            "name": "format",
            "displayName": "Format"
        },
        {
            "name": "created_at",
            "displayName": "Created",
            "shape": "date"
        }
    ],
    "timeframes": false
}
