{
    "name": "authtokens",
    "displayName": "Authtokens",
    "description": "Agent authtokens in the ngrok account with their description and creation date (token values excluded)",
    "tags": [
        "Security"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "credentials",
        "postRequestScript": "authtokens.js",
        "paging": {
            "mode": "nextUrl",
            "pageSize": {
                "realm": "queryArg",
                "path": "limit",
                "value": "100"
            },
            "in": {
                "realm": "payload",
                "path": "next_page_uri"
            }
        },
        "errorHandling": {
            "type": "path",
            "realm": "payload",
            "path": "msg"
        }
    },
    "matches": "none",
    "metadata": [
        {
            "name": "id",
            "displayName": "Authtoken ID",
            "role": "id"
        },
        {
            "name": "description",
            "displayName": "Description",
            "role": "label"
        },
        {
            "name": "hasAcl",
            "displayName": "Restricted by ACL",
            "shape": "boolean"
        },
        {
            "name": "ownerId",
            "displayName": "Owner ID",
            "visible": false
        },
        {
            "name": "created_at",
            "displayName": "Created",
            "shape": "date"
        }
    ],
    "timeframes": false
}
