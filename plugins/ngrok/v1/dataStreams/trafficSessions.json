{
    "name": "trafficSessions",
    "displayName": "Traffic Sessions",
    "description": "Signed-in browser sessions on endpoints protected by OAuth, OIDC or SAML, with the endpoint, browser and expiry",
    "tags": [
        "User",
        "Security"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "app/sessions",
        "postRequestScript": "trafficSessions.js",
        "paging": {
            "mode": "nextUrl",
            "pageSize": {
                "realm": "queryArg",
                "path": "limit",
                "value": "100"
            },
            "in": {
                "realm": "payload",
                "path": "next_page_uri"
            }
        },
        "errorHandling": {
            "type": "path",
            "realm": "payload",
            "path": "msg"
        }
    },
    "matches": "none",
    "metadata": [
        {
            "name": "id",
            "displayName": "Session ID",
            "role": "id",
            "visible": false
        },
        {
            "name": "publicUrl",
            "displayName": "Endpoint URL",
            "role": "label"
        },
        {
            "name": "userId",
            "displayName": "Identity ID"
        },
        {
            "name": "ipAddress",
            "displayName": "IP address"
        },
        {
            "name": "countryCode",
            "displayName": "Country"
        },
        {
            "name": "browser",
            "displayName": "Browser"
        },
        {
            "name": "os",
            "displayName": "OS"
        },
        {
            "name": "deviceType",
            "displayName": "Device"
        },
        {
            "name": "created_at",
            "displayName": "Started",
            "shape": "date"
        },
        {
            "name": "last_active",
            "displayName": "Last active",
            "shape": "date"
        },
        {
            "name": "expires_at",
            "displayName": "Expires",
            "shape": "date"
        }
    ],
    "timeframes": false
}
