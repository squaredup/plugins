{
    "name": "apiKeys",
    "displayName": "API Keys",
    "description": "API keys in the ngrok account (first page only)",
    "tags": ["Security"],
    "baseDataSourceName": "httpRequestUnscoped",
    "visibility": { "type": "hidden" },
    "config": {
        "httpMethod": "get",
        "endpointPath": "api_keys",
        "getArgs": [{ "key": "limit", "value": "1" }],
        "pathToData": "keys",
        "paging": { "mode": "none" },
        "errorHandling": { "type": "path", "realm": "payload", "path": "msg" }
    },
    "matches": "none",
    "metadata": [
        { "name": "id", "displayName": "ID", "role": "id" },
        { "name": "description", "displayName": "Description", "role": "label" },
        { "name": "created_at", "displayName": "Created", "shape": "date" }
    ],
    "timeframes": false
}
