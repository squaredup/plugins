            "allowMultipleSelection": false,
            "default": "none",
            "type": "object"
        }
    },
    {
        "name": "ngrok TLS Certificates",
        "matches": {
            "sourceType": {
                "type": "oneOf",
                "values": [
                    "TLS Certificate"
                ]
            }
        },
        "variable": {
            "name": "ngrok TLS Certificate",
            "allowMultipleSelection": false,
            "default": "none",
            "type": "object"
        }
    }
