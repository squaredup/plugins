                                "displayName": "Type",
                                "shape": "string"
                            },
                            {
                                "name": "proto",
                                "displayName": "Protocol",
                                "shape": "string"
                            },
                            {
                                "name": "created_at",
                                "displayName": "Created",
                                "shape": "date"
                            },
                            {
                                "pattern": ".*"
                            }
                        ]
                    },
                    "variables": [
                        "{{variables.[ngrok Reserved Domain]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
