            {
                "i": "21d07848-ab8e-4544-8df7-0fd170459d13",
                "x": 2,
                "y": 3,
                "w": 2,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Endpoints on This Domain",
                    "description": "Active endpoints served on this domain",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "datastream-sql",
                        "dataSourceConfig": {
                            "version": "2.0",
                            "sql": "SELECT e.\"url\", e.\"endpointType\", e.\"proto\", e.\"created_at\" FROM \"endpoints\" e WHERE e.\"domain.id\" IN (SELECT \"id\" FROM \"domain\") ORDER BY e.\"created_at\" DESC",
                            "tables": [
                                {
                                    "tableName": "domain",
                                    "config": {
                                        "activePluginConfigIds": [
                                            "{{configId}}"
                                        ],
                                        "timeframe": "none",
                                        "dataStream": {
                                            "id": "{{dataStreams.[reservedDomains]}}",
                                            "name": "reservedDomains",
                                            "pluginConfigId": "{{configId}}",
                                            "dataSourceConfig": {
                                                "domain": {
                                                    "variable": "{{variables.[ngrok Reserved Domain]}}",
                                                    "workspace": "{{workspaceId}}",
                                                    "scope": "{{scopes.[ngrok Reserved Domains]}}"
                                                }
                                            }
                                        },
                                        "variables": [
                                            "{{variables.[ngrok Reserved Domain]}}"
                                        ]
                                    }
                                },
                                {
                                    "tableName": "endpoints",
                                    "config": {
                                        "activePluginConfigIds": [
                                            "{{configId}}"
                                        ],
                                        "timeframe": "none",
                                        "dataStream": {
                                            "id": "{{dataStreams.[endpoints]}}",
                                            "name": "endpoints",
                                            "pluginConfigId": "{{configId}}"
                                        },
                                        "variables": [
                                            "{{variables.[ngrok Reserved Domain]}}"
                                        ]
                                    }
                                }
                            ]
                        },
                        "metadata": [
                            {
                                "name": "url",
