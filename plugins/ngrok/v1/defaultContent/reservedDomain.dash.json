                                        }
                                    },
                                    {
                                        "field": "proto",
                                        "title": "Protocol",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "created_at",
                                        "title": "Created",
                                        "renderer": {
                                            "type": "date"
                                        }
                                    }
                                ]
                            },
