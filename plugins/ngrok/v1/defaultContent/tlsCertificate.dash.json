{
    "name": "TLS Certificate",
    "schemaVersion": "1.5",
    "timeframe": "none",
    "variables": [
        "{{variables.[ngrok TLS Certificate]}}"
    ],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "f556d287-a19c-4f23-927c-5d321172f508",
                "x": 0,
                "y": 0,
                "w": 2,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Days Until Expiry",
                    "description": "Days left before this certificate expires",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[tlsCertificates]}}",
                        "name": "tlsCertificates",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "certificate": {
                                "variable": "{{variables.[ngrok TLS Certificate]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[ngrok TLS Certificates]}}"
                            }
                        }
                    },
                    "variables": [
                        "{{variables.[ngrok TLS Certificate]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    {
                                        "field": "daysUntilExpiry",
                                        "type": "quantitative",
                                        "title": "Days",
                                        "aggregate": "min"
                                    }
                                ]
                            },
                            "style": {
                                "scalarLabelText": "Days"
                            }
                        }
                    }
                }
            },
            {
                "i": "ba7633f1-dba6-4326-80b3-90b356c87a0e",
                "x": 2,
                "y": 0,
                "w": 2,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Expiry Status",
                    "description": "Expiry state of this certificate",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[tlsCertificates]}}",
                        "name": "tlsCertificates",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "certificate": {
                                "variable": "{{variables.[ngrok TLS Certificate]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[ngrok TLS Certificates]}}"
                            }
                        }
                    },
                    "variables": [
                        "{{variables.[ngrok TLS Certificate]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "statusGrid",
                            "encoding": {
                                "label": {
                                    "field": "subject_common_name",
                                    "type": "nominal",
                                    "title": "Common name"
                                },
                                "status": {
                                    "field": "expiryStatus",
                                    "type": "nominal",
                                    "title": "Expiry status"
                                }
                            },
                            "style": {
                                "statusGridColumnsPerRow": 1,
                                "statusGridSecondaryTemplate": "{{{{raw}}}}Expires {{date not_after}}{{{{/raw}}}}",
                                "mappedColors": {
                                    "Valid": "#16a34a",
                                    "Expires within 30 days": "#f59e0b",
                                    "Expires within 7 days": "#ef4444",
                                    "Expired": "#ef4444"
                                }
                            }
                        }
                    },
                    "monitor": {
                        "_type": "simple",
                        "tileRollsUp": true,
                        "monitorType": "state",
                        "column": "expiryStatus",
                        "aggregation": "top",
                        "condition": {
                            "columns": [
                                "expiryStatus"
                            ]
                        },
                        "frequency": 15
                    }
                }
            },
            {
                "i": "ced3aaaf-ef7c-4cc6-b6e2-15c3a4ae36cf",
                "x": 0,
                "y": 2,
                "w": 2,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Certificate Validity",
                    "description": "Issuer and validity window of this certificate",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[tlsCertificates]}}",
                        "name": "tlsCertificates",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "certificate": {
                                "variable": "{{variables.[ngrok TLS Certificate]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[ngrok TLS Certificates]}}"
                            }
                        }
                    },
                    "variables": [
                        "{{variables.[ngrok TLS Certificate]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "expiryStatus",
                                        "title": "Expiry status",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "Valid": "#16a34a",
                                                "Expires within 30 days": "#f59e0b",
                                                "Expires within 7 days": "#ef4444",
                                                "Expired": "#ef4444"
                                            }
                                        }
                                    },
                                    {
                                        "field": "daysUntilExpiry",
                                        "title": "Days until expiry",
                                        "renderer": {
                                            "type": "number",
                                            "decimals": 0,
                                            "thresholds": [
                                                {
                                                    "to": 7,
                                                    "color": "#ef4444"
                                                },
                                                {
                                                    "to": 30,
                                                    "color": "#f59e0b"
                                                },
                                                {
                                                    "to": 100000,
                                                    "color": "#16a34a"
                                                }
                                            ]
                                        }
                                    },
                                    {
                                        "field": "not_before",
                                        "title": "Valid from",
                                        "renderer": {
                                            "type": "date"
                                        }
                                    },
                                    {
                                        "field": "not_after",
                                        "title": "Expires",
                                        "renderer": {
                                            "type": "date"
                                        }
                                    },
                                    {
                                        "field": "issuer_common_name",
                                        "title": "Issuer",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "managedBy",
                                        "title": "Managed by",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "subject_alternative_names.dns_names",
                                        "title": "DNS names",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "private_key_type",
                                        "title": "Key type",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "issued_at",
                                        "title": "Issued",
                                        "renderer": {
                                            "type": "date"
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableTranspose": true,
                                "richTableWrapText": true
                            }
                        }
                    }
                }
            },
            {
                "i": "f5e710b1-d261-45e3-9ddb-51a11a88a0bb",
                "x": 2,
                "y": 2,
                "w": 2,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Certificate Details",
                    "description": "Properties imported for this certificate",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "datastream-properties",
                        "name": "properties"
                    },
                    "scope": {
                        "scope": "{{scopes.[ngrok TLS Certificates]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[ngrok TLS Certificate]}}"
                    },
                    "variables": [
                        "{{variables.[ngrok TLS Certificate]}}"
                    ],
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": true,
                                "hiddenColumns": [
                                    "id",
                                    "link",
                                    "links",
                                    "label"
                                ]
                            }
                        }
                    }
                }
            }
        ]
    }
}
