                "config": {
                    "_type": "tile/data-stream",
                    "title": "Domain Certificate",
                    "description": "Certificate health of the reserved domain this endpoint is served on",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "datastream-sql",
                        "dataSourceConfig": {
                            "version": "2.0",
                            "sql": "SELECT d.\"domain\", d.\"certificateStatus\", d.\"certificateSource\", d.\"renewsAt\", d.\"provisioningError\" FROM \"endpoints\" e JOIN \"domains\" d ON e.\"domain.id\" = d.\"id\"",
                            "tables": [
                                {
                                    "tableName": "endpoints",
                                    "config": {
                                        "activePluginConfigIds": [
                                            "{{configId}}"
