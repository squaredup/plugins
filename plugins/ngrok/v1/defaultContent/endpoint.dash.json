{
    "name": "Endpoint",
    "schemaVersion": "1.5",
    "timeframe": "none",
    "variables": [
        "{{variables.[ngrok Endpoint]}}"
    ],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "9a6af9d3-6a72-490c-adc7-4b4707e8df1b",
                "x": 0,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Status",
                    "description": "Whether this endpoint is currently online",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[endpointStatus]}}",
                        "name": "endpointStatus",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[ngrok Endpoints]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[ngrok Endpoint]}}"
                    },
                    "variables": [
                        "{{variables.[ngrok Endpoint]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "statusGrid",
                            "encoding": {
                                "label": {
                                    "field": "url",
                                    "type": "nominal",
                                    "title": "URL"
                                },
                                "status": {
                                    "field": "status",
                                    "type": "nominal",
                                    "title": "Status"
                                }
                            },
                            "style": {
                                "statusGridColumnsPerRow": 1,
                                "statusGridLabelWrap": true,
                                "statusGridSecondaryTemplate": "{{{{raw}}}}{{liveEndpoints}} live endpoint(s){{{{/raw}}}}",
                                "mappedColors": {
                                    "Online": "#16a34a",
                                    "Offline": "#ef4444",
                                    "Unknown": "#9ca3af"
                                },
                                "statusGridPrimaryTemplate": "{{{{raw}}}}{{#if liveEndpoints}}Online{{else}}Offline{{/if}}{{{{/raw}}}}"
                            }
                        }
                    },
                    "monitor": {
                        "_type": "simple",
                        "tileRollsUp": true,
                        "monitorType": "state",
                        "column": "status",
                        "aggregation": "top",
                        "condition": {
                            "columns": [
                                "status"
                            ]
                        },
                        "frequency": 15
                    }
                }
            },
            {
                "i": "172433e1-3a12-402a-b61d-719454fd2396",
                "x": 1,
                "y": 0,
                "w": 3,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Agent Session",
                    "description": "The ngrok agent serving this endpoint (agent endpoints only)",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "datastream-sql",
                        "dataSourceConfig": {
                            "version": "2.0",
                            "sql": "SELECT a.\"ip\", t.\"description\" AS \"authtoken\", a.\"agent_version\", a.\"os\", a.\"region\", a.\"transport\", a.\"started_at\", a.\"uptime\" FROM \"agents\" a LEFT JOIN \"authtokens\" t ON a.\"credential.id\" = t.\"id\" WHERE a.\"id\" IN (SELECT \"tunnel_session.id\" FROM \"endpoint\")",
                            "tables": [
                                {
                                    "tableName": "endpoint",
                                    "config": {
                                        "activePluginConfigIds": [
                                            "{{configId}}"
                                        ],
                                        "timeframe": "none",
                                        "dataStream": {
                                            "id": "{{dataStreams.[endpoints]}}",
                                            "name": "endpoints",
                                            "pluginConfigId": "{{configId}}",
                                            "dataSourceConfig": {
                                                "endpoint": {
                                                    "variable": "{{variables.[ngrok Endpoint]}}",
                                                    "workspace": "{{workspaceId}}",
                                                    "scope": "{{scopes.[ngrok Endpoints]}}"
                                                }
                                            }
                                        },
                                        "variables": [
                                            "{{variables.[ngrok Endpoint]}}"
                                        ]
                                    }
                                },
                                {
                                    "tableName": "agents",
                                    "config": {
                                        "activePluginConfigIds": [
                                            "{{configId}}"
                                        ],
                                        "timeframe": "none",
                                        "dataStream": {
                                            "id": "{{dataStreams.[agentSessions]}}",
                                            "name": "agentSessions",
                                            "pluginConfigId": "{{configId}}"
                                        },
                                        "variables": [
                                            "{{variables.[ngrok Endpoint]}}"
                                        ]
                                    }
                                },
                                {
                                    "tableName": "authtokens",
                                    "config": {
                                        "activePluginConfigIds": [
                                            "{{configId}}"
                                        ],
                                        "timeframe": "none",
                                        "dataStream": {
                                            "id": "{{dataStreams.[authtokens]}}",
                                            "name": "authtokens",
                                            "pluginConfigId": "{{configId}}"
                                        },
                                        "variables": [
                                            "{{variables.[ngrok Endpoint]}}"
                                        ]
                                    }
                                }
                            ]
                        },
                        "metadata": [
                            {
                                "name": "ip",
                                "displayName": "IP address",
                                "shape": "string",
                                "role": "label"
                            },
                            {
                                "name": "authtoken",
                                "displayName": "Authtoken",
                                "shape": "string"
                            },
                            {
                                "name": "agent_version",
                                "displayName": "Agent version",
                                "shape": "string"
                            },
                            {
                                "name": "os",
                                "displayName": "OS",
                                "shape": "string"
                            },
                            {
                                "name": "region",
                                "displayName": "Region",
                                "shape": "string"
                            },
                            {
                                "name": "transport",
                                "displayName": "Transport",
                                "shape": "string"
                            },
                            {
                                "name": "started_at",
                                "displayName": "Started",
                                "shape": "date"
                            },
                            {
                                "name": "uptime",
                                "displayName": "Uptime",
                                "shape": [
                                    "seconds",
                                    {
                                        "formatDuration": true
                                    }
                                ]
                            },
                            {
                                "pattern": ".*"
                            }
                        ]
                    },
                    "variables": [
                        "{{variables.[ngrok Endpoint]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "ip",
                                        "title": "IP address",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "authtoken",
                                        "title": "Authtoken",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "agent_version",
                                        "title": "Agent version",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "os",
                                        "title": "OS",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "region",
                                        "title": "Region",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "transport",
                                        "title": "Transport",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "started_at",
                                        "title": "Started",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
