                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Top Dependencies by Call Count",
                    "description": "Busiest service-to-service call paths in the last hour",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[dependencies]}}",
                        "name": "dependencies",
                        "pluginConfigId": "{{configId}}",
