                                "showXAxisLabel": false,
                                "showYAxisLabel": true,
                                "showLegend": false,
                                "legendPosition": "bottom",
                                "showGrid": true,
                                "horizontalLayout": "vertical",
                                "displayMode": "actual",
                                "showTotals": false,
                                "showValue": false,
                                "grouping": false,
                                "range": {
                                    "type": "auto"
                                }
                            }
                        }
                    }
                }
            }
