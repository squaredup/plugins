{
    "name": "Tracing",
    "schemaVersion": "1.5",
    "timeframe": "last24hours",
    "variables": [
        "{{variables.[Service]}}"
    ],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "62d75b50-0b77-4358-947f-cb76744a6044",
                "x": 0,
                "y": 0,
                "w": 1,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Operations",
                    "description": "Operation names reported by this service",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "variables": [
                        "{{variables.[Service]}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[operations]}}",
                        "name": "operations",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Services]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Service]}}"
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "name",
                                        "title": "Operation",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "spanKind",
                                        "title": "Span Kind",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    }
                                ]
                            }
                        }
                    }
                }
            },
            {
                "i": "5b847262-6bde-4b0c-9ae9-c2aba620599b",
                "x": 1,
                "y": 0,
                "w": 3,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Traces",
                    "description": "Spans reported by this service within the selected timeframe",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "variables": [
                        "{{variables.[Service]}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[traces]}}",
                        "name": "traces",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [
                                [
                                    "startTime",
                                    "desc"
                                ]
                            ]
                        }
                    },
                    "scope": {
                        "scope": "{{scopes.[Services]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Service]}}"
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "traceId",
                                        "title": "Trace ID",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "operationName",
                                        "title": "Operation",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "serviceName",
                                        "title": "Service",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "kind",
                                        "title": "Kind",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "startTime",
                                        "title": "Start Time",
                                        "renderer": {
                                            "type": "date"
                                        }
                                    },
                                    {
                                        "field": "durationMs",
                                        "title": "Duration (ms)",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "statusCode",
                                        "title": "Status Code",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    }
                                ]
                            }
                        }
                    }
                }
            },
            {
                "i": "42eeafa5-ece0-4e93-ac29-b1d1e160b6be",
                "x": 0,
                "y": 3,
                "w": 4,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Dependencies",
                    "description": "Call paths into and out of this service",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "variables": [
                        "{{variables.[Service]}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[serviceDependencies]}}",
                        "name": "serviceDependencies",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [
                                [
                                    "callCount",
                                    "desc"
                                ]
                            ]
                        }
                    },
                    "scope": {
                        "scope": "{{scopes.[Services]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Service]}}"
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "key",
                                        "title": "Dependency",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "parent",
                                        "title": "Parent Service",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "child",
                                        "title": "Child Service",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "callCount",
                                        "title": "Call Count",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    }
                                ]
                            }
                        }
                    }
                }
            }
        ]
    }
}
