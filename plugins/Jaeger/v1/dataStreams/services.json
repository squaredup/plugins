{
    "name": "services",
    "displayName": "Services",
    "description": "Services known to the Jaeger backend",
    "tags": [
        "Services"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "matches": "none",
    "timeframes": false,
    "config": {
        "httpMethod": "get",
        "endpointPath": "/api/v3/services",
        "postRequestScript": "result = (data.services || []).map(service => ({ service }));",
        "headers": []
    },
    "metadata": [
        {
            "name": "service",
            "displayName": "Service",
            "shape": "string",
            "role": "label"
        }
    ]
}
