{
    "name": "Libbi",
    "schemaVersion": "1.5",
    "timeframe": "last24hours",
    "variables": [
        "{{variables.[Libbi]}}"
    ],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "024f0736-1dba-5c28-84d8-3a86ee2b0eaa",
                "x": 0,
                "y": 0,
                "w": 1,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Libbi Properties",
                    "description": "",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "datastream-properties",
                        "name": "properties",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Libbis]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Libbi]}}"
                    },
                    "variables": [
                        "{{variables.[Libbi]}}"
                    ],
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": true,
                                "columnOrder": [
                                    "name",
                                    "serial",
                                    "firmware",
                                    "batteryCapacity",
                                    "inverterSize",
                                    "ctTypes"
                                ],
                                "hiddenColumns": [
                                    "id",
                                    "links",
                                    "type",
                                    "label",
                                    "sourceId",
                                    "sourceType",
                                    "sourceName"
                                ],
                                "columnDisplayNames": {
                                    "batteryCapacity": "Battery capacity",
                                    "inverterSize": "Inverter size",
                                    "ctTypes": "CT types"
                                }
                            }
                        }
                    }
                }
            },
            {
                "i": "b1020006-f4a6-53f7-89ef-fe0303559fe6",
                "x": 1,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Battery",
                    "description": "Current battery status and mode; red means a fault, amber means no data in the last 15 minutes",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[deviceStatus]}}",
                        "name": "deviceStatus",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Libbis]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Libbi]}}"
                    },
                    "variables": [
                        "{{variables.[Libbi]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "statusGrid",
                            "encoding": {
                                "label": {
                                    "field": "deviceName",
                                    "type": "nominal"
                                },
                                "status": {
                                    "field": "health",
                                    "type": "nominal"
                                }
                            },
                            "style": {
                                "statusGridColumnsPerRow": 1,
                                "statusGridSecondaryTemplate": "{{{{raw}}}}{{status}} · {{mode}}{{{{/raw}}}}"
                            }
                        }
                    }
                }
            },
            {
                "i": "3f3800bc-90fb-5a14-ab4e-8f2253745c16",
                "x": 2,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Charge Level",
                    "description": "Current state of charge",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[deviceStatus]}}",
                        "name": "deviceStatus",
                        "pluginConfigId": "{{configId}}",
                        "sql": "SELECT CAST(\"batteryLevel\" AS DOUBLE) AS \"level\" FROM \"dataset\""
                    },
                    "scope": {
                        "scope": "{{scopes.[Libbis]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Libbi]}}"
                    },
                    "variables": [
                        "{{variables.[Libbi]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "gauge",
                            "encoding": {
                                "value": {
                                    "field": "level",
                                    "type": "quantitative",
                                    "title": "Charge level (%)"
                                }
                            },
                            "style": {
                                "gaugeMin": 0,
                                "gaugeMax": 100,
                                "labelFormat": "{{{{raw}}}}{{value}}%{{{{/raw}}}}",
                                "gaugeBands": [
                                    {
                                        "to": 0.2,
                                        "color": "#F0506E"
                                    },
                                    {
                                        "to": 0.5,
                                        "color": "#F5A623"
                                    },
                                    {
                                        "to": 1,
                                        "color": "#14B8A6"
                                    }
                                ],
                                "gaugeLabelText": "State of charge"
                            }
                        }
                    }
                }
            },
            {
                "i": "6ff62c08-4966-5c9d-8d35-fc3a741f3455",
                "x": 3,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Battery Power",
                    "description": "Power charging (right of zero) or discharging (left of zero) the battery right now, in kW",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[deviceStatus]}}",
                        "name": "deviceStatus",
                        "pluginConfigId": "{{configId}}",
                        "sql": "SELECT CASE WHEN v > 0.05 THEN 'Charging' WHEN v < -0.05 THEN 'Discharging' ELSE 'Idle' END AS \"direction\", v AS \"batteryKw\" FROM (SELECT ROUND(CAST(\"power\" AS DOUBLE) / 1000, 2) AS v FROM \"dataset\")"
                    },
                    "scope": {
                        "scope": "{{scopes.[Libbis]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Libbi]}}"
                    },
                    "variables": [
                        "{{variables.[Libbi]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "direction",
                                    "type": "nominal"
                                },
                                "y": {
                                    "field": "batteryKw",
                                    "type": "quantitative",
                                    "title": "kW"
                                }
                            },
                            "style": {
                                "cartesianHorizontal": true,
                                "cartesianYAxisMin": -5,
                                "cartesianYAxisMax": 5,
                                "showLabels": true,
                                "labelFormat": "{{{{raw}}}}{{value}} kW{{{{/raw}}}}",
                                "labelFontSize": 16,
                                "cartesianBarBorderRadius": 4,
                                "cartesianBarWidth": 36,
                                "cartesianColorRules": [
                                    {
                                        "lt": 0,
                                        "color": "#38BDF8"
                                    },
                                    {
                                        "gte": 0,
                                        "color": "#14B8A6"
                                    }
                                ],
                                "cartesianShowVerticalGridLines": true
                            }
                        }
                    }
                }
            },
            {
                "i": "e332290e-3517-5f69-87a8-2bbeb37b73dc",
                "x": 1,
                "y": 2,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Energy Returned (30 Days)",
                    "description": "kWh discharged out of kWh charged over the last 30 days; the gap is conversion losses plus any change in stored charge",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "last30days",
                    "dataStream": {
                        "id": "{{dataStreams.[energyHistory]}}",
                        "name": "energyHistory",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "measure": "energy"
                        },
                        "sql": "SELECT 'kWh out of kWh in' AS \"metric\", ROUND(SUM(\"batteryDischarge\"), 1) AS \"discharged\", ROUND(SUM(\"batteryCharge\"), 1) AS \"charged\" FROM \"dataset\""
                    },
                    "scope": {
                        "scope": "{{scopes.[Libbis]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Libbi]}}"
                    },
                    "variables": [
                        "{{variables.[Libbi]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "ringGrid",
                            "encoding": {
                                "value": {
                                    "field": "discharged",
                                    "type": "quantitative"
                                },
                                "max": {
                                    "field": "charged",
                                    "type": "quantitative"
                                },
                                "label": {
                                    "field": "metric",
                                    "type": "nominal"
                                }
                            },
                            "style": {
                                "ringGridTrackWidth": 8,
                                "labelFontSize": 13,
                                "ringGridThresholds": [
                                    {
                                        "to": 1,
                                        "color": "#14B8A6"
                                    }
                                ]
                            }
                        }
                    }
                }
            },
            {
                "i": "997899ba-70af-54cf-99bb-79acf915d2ff",
                "x": 2,
                "y": 2,
                "w": 2,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "CT Clamps",
                    "description": "Live power through each CT clamp on this Libbi; the grid clamp turns green when exporting",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[ctReadings]}}",
                        "name": "ctReadings",
                        "pluginConfigId": "{{configId}}",
                        "sql": "SELECT \"ctType\", \"power\" FROM \"dataset\" ORDER BY \"ct\" DESC"
                    },
                    "scope": {
                        "scope": "{{scopes.[Libbis]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Libbi]}}"
                    },
                    "variables": [
                        "{{variables.[Libbi]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "ctType",
                                    "type": "nominal",
                                    "title": "CT"
                                },
                                "y": {
                                    "field": "power",
                                    "type": "quantitative",
                                    "title": "Power (W)"
                                }
                            },
                            "style": {
                                "cartesianHorizontal": true,
                                "showLabels": true,
                                "labelFormat": "{{{{raw}}}}{{value}} W{{{{/raw}}}}",
                                "cartesianBarBorderRadius": 3,
                                "cartesianColorRules": [
                                    {
                                        "label": "Grid",
                                        "lt": 0,
                                        "color": "#2BB673"
                                    },
                                    {
                                        "label": "Grid",
                                        "color": "#8E6CEF"
                                    },
                                    {
                                        "label": "Generation",
                                        "color": "#F5A623"
                                    },
                                    {
                                        "labelContains": "Storage",
                                        "color": "#14B8A6"
                                    },
                                    {
                                        "labelContains": "Load",
                                        "color": "#38BDF8"
                                    }
                                ]
                            }
                        }
                    }
                }
            },
            {
                "i": "acfeb0f2-7838-5f12-b7a9-105c1f1a8914",
                "x": 0,
                "y": 4,
                "w": 4,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Charging and Discharging",
                    "description": "Average battery charging (above the line) and discharging (below) in kW, with solar generation for context",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[energyHistory]}}",
                        "name": "energyHistory",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "measure": "power"
                        },
                        "sql": "SELECT \"timestamp\", \"series\", \"kw\" FROM (SELECT \"timestamp\", 'Charging' AS \"series\", \"batteryCharge\" AS \"kw\" FROM \"dataset\" UNION ALL SELECT \"timestamp\", 'Discharging', -\"batteryDischarge\" FROM \"dataset\" UNION ALL SELECT \"timestamp\", 'Solar generation', \"generation\" FROM \"dataset\") ORDER BY \"timestamp\""
                    },
                    "scope": {
                        "scope": "{{scopes.[Libbis]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Libbi]}}"
                    },
                    "variables": [
                        "{{variables.[Libbi]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "line",
                            "encoding": {
                                "x": {
                                    "field": "timestamp",
                                    "type": "temporal"
                                },
                                "y": {
                                    "field": "kw",
                                    "type": "quantitative",
                                    "title": "kW",
                                    "aggregate": "avg"
                                },
                                "series": {
                                    "field": "series",
                                    "type": "nominal"
                                }
                            },
                            "style": {
                                "cartesianAreaGradient": true,
                                "cartesianSymbol": "none",
                                "mappedColors": {
                                    "Charging": "#14B8A6",
                                    "Discharging": "#38BDF8",
                                    "Solar generation": "#F5A623"
                                },
                                "legendPosition": "bottom",
                                "cartesianShowYAxisTitle": true,
                                "cartesianYAxisTitle": "kW"
                            }
                        }
                    }
                }
            },
            {
                "i": "5bddc9ea-2119-59b2-b576-85967a865684",
                "x": 0,
                "y": 7,
                "w": 4,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Daily Charge and Discharge",
                    "description": "Energy charged into (above the line) and discharged from (below) the battery on each of the last 29 whole days",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "last30days",
                    "dataStream": {
                        "id": "{{dataStreams.[energyHistory]}}",
                        "name": "energyHistory",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "measure": "energy"
                        },
                        "sql": "WITH b AS (SELECT DATE_TRUNC('day', MIN(\"timestamp\") + INTERVAL 23 HOUR) AS lo, DATE_TRUNC('day', MAX(\"timestamp\")) AS hi FROM \"dataset\"), x AS (SELECT \"dataset\".* FROM \"dataset\", b WHERE \"timestamp\" >= b.lo AND \"timestamp\" < b.hi) SELECT STRFTIME(DATE_TRUNC('day', \"timestamp\"), '%Y-%m-%dT%H:%M:%SZ') AS \"day\", ROUND(SUM(\"batteryCharge\"), 2) AS \"charged\", ROUND(-SUM(\"batteryDischarge\"), 2) AS \"discharged\" FROM x GROUP BY 1 ORDER BY 1"
                    },
                    "scope": {
                        "scope": "{{scopes.[Libbis]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Libbi]}}"
                    },
                    "variables": [
                        "{{variables.[Libbi]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "day",
                                    "type": "temporal"
                                }
                            },
                            "style": {
                                "cartesianStack": "on",
                                "colors": [
                                    "#14B8A6",
                                    "#38BDF8"
                                ],
                                "legendPosition": "bottom",
                                "cartesianBarBorderRadius": 2,
                                "cartesianShowYAxisTitle": true,
                                "cartesianYAxisTitle": "kWh"
                            }
                        }
                    }
                }
            }
        ]
    }
}
