                "x": 0,
                "y": 4,
                "w": 4,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Device Status",
                    "description": "Live status of every Zappi, Eddi, Harvi and Libbi; amber means no data in the last 15 minutes",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[deviceStatus]}}",
                        "name": "deviceStatus",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [
                                [
                                    "deviceType",
                                    "asc"
                                ],
                                [
                                    "deviceName",
                                    "asc"
                                ]
                            ]
                        }
                    },
                    "scope": {
                        "scope": "{{scopes.[Devices]}}",
                        "workspace": "{{workspaceId}}"
                    },
                    "visualisation": {
                        "type": "data-stream-blocks",
                        "config": {
                            "data-stream-blocks": {
                                "labelColumn": "deviceName",
                                "stateColumn": "health",
                                "sublabel": "status",
                                "linkColumn": "none",
                                "columns": 4
                            }
                        }
                    }
                }
            },
            {
                "i": "1e3eadc2-921b-4390-990c-e177cfa80265",
                "x": 0,
                "y": 6,
                "w": 3,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Site Power",
                    "description": "Average grid import, grid export and generation each minute; every device reports the same site readings, so the highest per interval is shown rather than a total",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[energyHistory]}}",
                        "name": "energyHistory",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "measure": "power"
                        },
                        "group": {
                            "by": [
                                [
                                    "timestamp",
                                    "uniqueValues"
                                ]
                            ],
                            "aggregate": [
                                {
                                    "type": "max",
                                    "names": [
                                        "import"
                                    ]
                                },
                                {
                                    "type": "max",
                                    "names": [
                                        "export"
                                    ]
                                },
                                {
                                    "type": "max",
                                    "names": [
                                        "generation"
                                    ]
                                }
                            ]
                        },
                        "sort": {
                            "by": [
                                [
                                    "timestamp_uniqueValues",
                                    "asc"
                                ]
                            ]
                        }
                    },
                    "scope": {
                        "scope": "{{scopes.[Devices with Energy History]}}",
                        "workspace": "{{workspaceId}}"
                    },
                    "visualisation": {
                        "type": "data-stream-line-graph",
                        "config": {
                            "data-stream-line-graph": {
                                "xAxisColumn": "timestamp_uniqueValues",
                                "yAxisColumn": [
                                    "import_max",
                                    "export_max",
                                    "generation_max"
                                ],
                                "seriesColumn": "none",
                                "showLegend": true,
                                "legendPosition": "bottom",
                                "yAxisLabel": "kW",
                                "showYAxisLabel": true,
                                "showTrendLine": false
                            }
                        }
                    }
                }
            },
            {
                "i": "2424343c-b55c-4860-b8f7-6c48c121d10c",
                "x": 3,
                "y": 6,
                "w": 1,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Energy by Device",
                    "description": "Surplus energy diverted and energy boosted by each Zappi, Eddi and Libbi",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[energyHistory]}}",
                        "name": "energyHistory",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "measure": "energy"
                        },
                        "group": {
                            "by": [
                                [
                                    "deviceName",
                                    "uniqueValues"
                                ]
                            ],
                            "aggregate": [
                                {
                                    "type": "sum",
                                    "names": [
                                        "diverted"
                                    ]
                                },
                                {
                                    "type": "sum",
                                    "names": [
                                        "boosted"
                                    ]
                                }
                            ]
                        },
                        "sort": {
                            "by": [
                                [
                                    "deviceName_uniqueValues",
                                    "asc"
                                ]
                            ]
                        }
                    },
                    "scope": {
                        "scope": "{{scopes.[Devices with Energy History]}}",
                        "workspace": "{{workspaceId}}"
                    },
                    "visualisation": {
                        "type": "data-stream-bar-chart",
                        "config": {
                            "data-stream-bar-chart": {
                                "xAxisData": "deviceName_uniqueValues",
                                "yAxisData": [
                                    "diverted_sum",
                                    "boosted_sum"
                                ],
                                "xAxisGroup": "none",
                                "xAxisLabel": "",
                                "yAxisLabel": "kWh",
                                "showXAxisLabel": false,
                                "showYAxisLabel": true,
                                "showLegend": true,
                                "legendPosition": "bottom",
                                "showGrid": true,
                                "horizontalLayout": "vertical",
                                "displayMode": "actual",
                                "showTotals": false,
                                "showValue": false,
                                "grouping": false,
                                "range": {
                                    "type": "auto"
                                }
                            }
                        }
                    }
                }
            }
        ]
    }
