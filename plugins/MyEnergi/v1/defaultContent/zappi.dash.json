            {
                "i": "8fbbe1c4-3496-5c41-980a-87c8837ba49f",
                "x": 0,
                "y": 7,
                "w": 2,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Daily Charging",
                    "description": "Energy charged into the EV on each of the last 29 whole days, split into diverted and boosted",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "last30days",
                    "dataStream": {
                        "id": "{{dataStreams.[energyHistory]}}",
                        "name": "energyHistory",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "measure": "energy"
                        },
                        "sql": "WITH b AS (SELECT DATE_TRUNC('day', MIN(\"timestamp\") + INTERVAL 23 HOUR) AS lo, DATE_TRUNC('day', MAX(\"timestamp\")) AS hi FROM \"dataset\"), x AS (SELECT \"dataset\".* FROM \"dataset\", b WHERE \"timestamp\" >= b.lo AND \"timestamp\" < b.hi) SELECT STRFTIME(DATE_TRUNC('day', \"timestamp\"), '%Y-%m-%dT%H:%M:%SZ') AS \"day\", ROUND(SUM(\"diverted\"), 2) AS \"diverted\", ROUND(SUM(\"boosted\"), 2) AS \"boosted\" FROM x GROUP BY 1 ORDER BY 1"
                    },
                    "scope": {
                        "scope": "{{scopes.[Zappis]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Zappi]}}"
                    },
                    "variables": [
                        "{{variables.[Zappi]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "day",
                                    "type": "temporal"
                                }
                            },
                            "style": {
                                "cartesianStack": "on",
                                "colors": [
                                    "#F5A623",
                                    "#8E6CEF"
                                ],
                                "legendPosition": "bottom",
                                "cartesianBarBorderRadius": 2,
                                "cartesianShowYAxisTitle": true,
                                "cartesianYAxisTitle": "kWh"
                            }
                        }
                    }
                }
            },
            {
                "i": "ef2875b5-f45e-5ed1-8084-3225f693eca9",
                "x": 2,
                "y": 7,
                "w": 2,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "When the EV Charges",
                    "description": "kWh charged in each hour (UTC) of the last 29 whole days; off-peak tariff windows show up as a band",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "last30days",
                    "dataStream": {
                        "id": "{{dataStreams.[energyHistory]}}",
                        "name": "energyHistory",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "measure": "energy"
                        },
                        "sql": "WITH b AS (SELECT DATE_TRUNC('day', MIN(\"timestamp\") + INTERVAL 23 HOUR) AS lo, DATE_TRUNC('day', MAX(\"timestamp\")) AS hi FROM \"dataset\"), x AS (SELECT \"dataset\".* FROM \"dataset\", b WHERE \"timestamp\" >= b.lo AND \"timestamp\" < b.hi), s AS (SELECT \"timestamp\", SUM(\"diverted\" + \"boosted\") AS v FROM x GROUP BY \"timestamp\"), d AS (SELECT DISTINCT CAST(\"timestamp\" AS DATE) AS d FROM s), h AS (SELECT \"range\" AS h FROM range(24)) SELECT STRFTIME(d.d, '%a %d %b') AS \"day\", LPAD(CAST(h.h AS VARCHAR), 2, '0') || ':00' AS \"hour\", ROUND(COALESCE(s.v, 0), 2) AS \"charged\" FROM d CROSS JOIN h LEFT JOIN s ON CAST(s.\"timestamp\" AS DATE) = d.d AND HOUR(s.\"timestamp\") = h.h ORDER BY d.d, h.h"
                    },
                    "scope": {
                        "scope": "{{scopes.[Zappis]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Zappi]}}"
                    },
                    "variables": [
                        "{{variables.[Zappi]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "heatmap",
                            "encoding": {
                                "x": {
                                    "field": "hour",
                                    "type": "nominal"
                                },
                                "y": {
                                    "field": "day",
                                    "type": "nominal"
                                },
                                "color": {
                                    "field": "charged",
                                    "type": "quantitative",
                                    "title": "EV charge (kWh)"
                                }
                            },
                            "style": {
                                "colorScheme": "squaredUpBlue",
                                "heatmapCellBorderWidth": 1,
                                "heatmapCellBorderRadius": 2,
                                "heatmapColorScaleReversed": true
                            }
                        }
                    }
                }
            },
