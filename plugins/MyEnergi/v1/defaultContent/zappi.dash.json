                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Charge Sources (30 Days)",
                    "description": "EV energy over the last 30 days: diverted (Eco and Eco+ charging, mostly surplus solar) against boosted (timed or manual grid boost)",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "last30days",
                    "dataStream": {
                        "id": "{{dataStreams.[energyHistory]}}",
                        "name": "energyHistory",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "measure": "energy"
                        },
                        "sql": "SELECT \"source\", \"energy\" FROM (SELECT 'Diverted' AS \"source\", ROUND(SUM(\"diverted\"), 1) AS \"energy\" FROM \"dataset\" UNION ALL SELECT 'Boosted', ROUND(SUM(\"boosted\"), 1) FROM \"dataset\") WHERE \"energy\" > 0"
                    },
                    "scope": {
                        "scope": "{{scopes.[Zappis]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Zappi]}}"
                    },
                    "variables": [
                        "{{variables.[Zappi]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "pie",
                            "encoding": {
                                "label": {
                                    "field": "source",
                                    "type": "nominal"
                                },
                                "value": {
                                    "field": "energy",
                                    "type": "quantitative",
                                    "title": "kWh"
                                }
                            },
                            "style": {
                                "pieInnerRadius": 60,
                                "pieDonutCenterValue": "total",
                                "labelFontSize": 16,
                                "pieLabels": "percent",
                                "mappedColors": {
                                    "Diverted": "#F5A623",
                                    "Boosted": "#8E6CEF"
                                },
                                "pieLegendStyle": "table"
                            }
                        }
                    }
                }
            },
            {
                "i": "e721a9dd-5fcf-5e66-958d-8d1b6b505546",
                "x": 0,
                "y": 4,
                "w": 4,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Charging Power",
                    "description": "Average diverted and boosted charging power in kW, with the site's solar generation for context",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[energyHistory]}}",
                        "name": "energyHistory",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "measure": "power"
                        },
                        "sql": "SELECT \"timestamp\", \"series\", \"kw\" FROM (SELECT \"timestamp\", 'Diverted' AS \"series\", \"diverted\" AS \"kw\" FROM \"dataset\" UNION ALL SELECT \"timestamp\", 'Boosted', \"boosted\" FROM \"dataset\" UNION ALL SELECT \"timestamp\", 'Solar generation', \"generation\" FROM \"dataset\") ORDER BY \"timestamp\""
                    },
                    "scope": {
                        "scope": "{{scopes.[Zappis]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Zappi]}}"
                    },
                    "variables": [
                        "{{variables.[Zappi]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "line",
                            "encoding": {
                                "x": {
                                    "field": "timestamp",
                                    "type": "temporal"
                                },
                                "y": {
                                    "field": "kw",
                                    "type": "quantitative",
                                    "title": "kW",
                                    "aggregate": "avg"
                                },
                                "series": {
                                    "field": "series",
                                    "type": "nominal"
                                }
                            },
                            "style": {
                                "cartesianAreaGradient": true,
                                "cartesianSymbol": "none",
                                "mappedColors": {
                                    "Diverted": "#F5A623",
                                    "Boosted": "#8E6CEF",
                                    "Solar generation": "#94A3B8"
                                },
                                "legendPosition": "bottom",
                                "cartesianShowYAxisTitle": true,
                                "cartesianYAxisTitle": "kW"
                            }
                        }
                    }
                }
