{
    "name": "myenergi",
    "displayName": "myenergi",
    "version": "1.0.0",
    "author": {
        "name": "@adamkinniburgh",
        "type": "community"
    },
    "description": "Find and monitor your myenergi zappi, eddi, libbi and harvi devices. View status, energy readings and overall home energy usage.",
    "category": "Monitoring",
    "type": "hybrid",
    "schemaVersion": "2.1",
    "importNotSupported": false,
    "restrictedToPlatforms": [],
    "keywords": [
        "myenergi",
        "energy",
        "solar",
        "ev charger",
        "zappi",
        "eddi",
        "libbi",
        "harvi",
        "battery",
        "home energy"
    ],
    "objectTypes": [
        "myenergi Site",
        "myenergi Zappi",
        "myenergi Eddi",
        "myenergi Libbi",
        "myenergi Harvi",
        "myenergi Hub"
    ],
    "links": [
        {
            "category": "documentation",
            "url": "https://github.com/squaredup/plugins/blob/main/plugins/MyEnergi/v1/docs/README.md",
            "label": "Help adding this plugin"
        },
        {
            "category": "source",
            "url": "https://github.com/squaredup/plugins/tree/main/plugins/MyEnergi/v1",
            "label": "Repository"
        }
    ],
    "base": {
        "plugin": "WebAPI",
        "majorVersion": "1",
        "config": {
            "baseUrl": "https://api.s18.myenergi.net",
            "authMode": "oauth2",
            "oauth2GrantType": "authCode",
            "oauth2AuthUrl": "https://auth.s18.myenergi.net/oauth2/authorize",
            "oauth2TokenUrl": "https://auth.s18.myenergi.net/oauth2/token",
            "oauth2ClientId": "{{clientId}}",
            "oauth2ClientSecret": "{{clientSecret}}",
            "oauth2ClientSecretLocationDuringAuth": "body",
            "oauth2Scope": "",
            "oauth2AuthExtraArgs": [
                {
                    "key": "response_type",
                    "value": "code"
                }
            ],
            "headers": [
                {
                    "key": "Accept",
                    "value": "application/json"
                }
            ],
            "queryArgs": []
        }
    }
}
