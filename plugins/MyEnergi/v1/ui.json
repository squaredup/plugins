[
    {
        "type": "text",
        "name": "clientId",
        "label": "Client ID",
        "help": "The OAuth client ID issued to your application by myenergi. This is requested manually — contact myenergi support to register your application and obtain a Client ID and Client secret.",
        "placeholder": "Enter your myenergi Client ID",
        "validation": {
            "required": true
        }
    },
    {
        "type": "password",
        "name": "clientSecret",
        "label": "Client secret",
        "help": "The OAuth client secret issued alongside your Client ID by myenergi support.",
        "placeholder": "Enter your myenergi Client secret",
        "validation": {
            "required": true
        }
    },
    {
        "type": "fieldGroup",
        "name": "signInGroup",
        "label": "Sign in",
        "visible": {
            "clientId": {
                "type": "regex",
                "pattern": "(.+)"
            },
            "clientSecret": {
                "type": "regex",
                "pattern": "(.+)"
            }
        },
        "fields": [
            {
                "type": "oAuth2",
                "name": "oauth2AuthCodeSignIn",
                "label": "Sign in with myenergi",
                "validation": {
                    "required": true
                }
            }
        ]
    }
]
