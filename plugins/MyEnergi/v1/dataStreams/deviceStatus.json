{
    "name": "deviceStatus",
    "displayName": "Device Status",
    "description": "Current telemetry for a zappi, eddi or libbi including state, mode and live power",
    "tags": [
        "Status",
        "Devices"
    ],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/devices/{{object.rawId}}/status",
        "expandInnerObjects": true
    },
    "matches": {
        "sourceType": {
            "type": "oneOf",
            "values": [
                "myenergi Zappi",
                "myenergi Eddi",
                "myenergi Libbi"
            ]
        }
    },
    "metadata": [
        {
            "name": "deviceClass",
            "displayName": "Device Class",
            "shape": "string"
        },
        {
            "name": "status",
            "displayName": "Status",
            "shape": [
                "state",
                {
                    "map": {
                        "success": [
                            "active"
                        ],
                        "warning": [
                            "inactive"
                        ],
                        "error": [
                            "offline",
                            "faulted"
                        ],
                        "unknown": [
                            "unknown"
                        ]
                    }
                }
            ]
        },
        {
            "name": "state",
            "displayName": "State",
            "shape": "string"
        },
        {
            "name": "deviceStatus",
            "displayName": "Detailed Status",
            "shape": "string"
        },
        {
            "name": "supplyMode",
            "displayName": "Mode",
            "shape": "string"
        },
        {
            "name": "pilotState",
            "displayName": "EV Connection",
            "shape": "string"
        },
        {
            "name": "boostCharge",
            "displayName": "Boosting",
            "shape": "boolean"
        },
        {
            "name": "boostActive",
            "displayName": "Boost Active",
            "shape": "boolean"
        },
        {
            "name": "actualPower",
            "displayName": "Power (kW)",
            "shape": [
                "number",
                {
                    "decimalPlaces": 2
                }
            ],
            "role": "value"
        },
        {
            "name": "gridPower",
            "displayName": "Grid Power (kW)",
            "shape": [
                "number",
                {
                    "decimalPlaces": 2
                }
            ]
        },
        {
            "name": "genPower",
            "displayName": "Generation (kW)",
            "shape": [
                "number",
                {
                    "decimalPlaces": 2
                }
            ]
        },
        {
            "name": "sessionEnergy",
            "displayName": "Session Energy (kWh)",
            "shape": [
                "number",
                {
                    "decimalPlaces": 2
                }
            ]
        },
        {
            "name": "energyDelivered",
            "displayName": "Energy Delivered (kWh)",
            "shape": [
                "number",
                {
                    "decimalPlaces": 2
                }
            ]
        },
        {
            "name": "stateOfCharge",
            "displayName": "State of Charge",
            "shape": "percent"
        },
        {
            "name": "batteryEnergyKwh",
            "displayName": "Battery Energy (kWh)",
            "shape": [
                "number",
                {
                    "decimalPlaces": 2
                }
            ]
        },
        {
            "name": "batteryCapacityKwh",
            "displayName": "Battery Capacity (kWh)",
            "shape": [
                "number",
                {
                    "decimalPlaces": 2
                }
            ]
        },
        {
            "name": "chargePowerKw",
            "displayName": "Charge Power (kW)",
            "shape": [
                "number",
                {
                    "decimalPlaces": 2
                }
            ]
        },
        {
            "name": "dischargePowerKw",
            "displayName": "Discharge Power (kW)",
            "shape": [
                "number",
                {
                    "decimalPlaces": 2
                }
            ]
        },
        {
            "name": "firmwareVersion",
            "displayName": "Firmware",
            "shape": "string"
        },
        {
            "name": "installationDate",
            "displayName": "Installed",
            "shape": "date"
        },
        {
            "name": "timestamp",
            "displayName": "Updated",
            "shape": "date"
        }
    ],
    "timeframes": false
}
