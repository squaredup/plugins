{
    "name": "deviceStatus",
    "displayName": "Device Status",
    "description": "Live status, mode, power and temperatures for each Zappi, Eddi, Harvi and Libbi",
    "tags": ["Energy"],
    "baseDataSourceName": "httpRequestScoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "cgi-jstatus-*",
        "paging": { "mode": "none" },
        "postRequestScript": "deviceStatus.js"
    },
    "matches": { "sourceType": { "type": "oneOf", "values": ["Zappi", "Eddi", "Harvi", "Libbi"] } },
    "metadata": [
        { "name": "deviceName", "displayName": "Device", "shape": "string", "role": "label" },
        { "name": "deviceKey", "displayName": "Device key", "shape": "string", "role": "id", "visible": false },
        { "name": "deviceType", "displayName": "Type", "shape": "string" },
        { "name": "status", "displayName": "Status", "shape": "string" },
        { "name": "health", "displayName": "Health", "shape": "state" },
        { "name": "mode", "displayName": "Mode", "shape": "string" },
        { "name": "plugStatus", "displayName": "Plug status", "shape": "string" },
        { "name": "power", "displayName": "Power (W)", "shape": "number", "role": "value" },
        { "name": "energy", "displayName": "Energy (kWh)", "shape": ["number", { "decimalPlaces": 2 }] },
        { "name": "activeHeater", "displayName": "Active heater", "shape": "string" },
        { "name": "tank1Temperature", "displayName": "Tank 1 temperature (°C)", "shape": "number" },
        { "name": "tank2Temperature", "displayName": "Tank 2 temperature (°C)", "shape": "number" },
        { "name": "batteryLevel", "displayName": "Battery level", "shape": "percent" },
        { "name": "minGreenLevel", "displayName": "Minimum green level", "shape": "percent" },
        { "name": "boosting", "displayName": "Boosting", "shape": "boolean" },
        { "name": "voltage", "displayName": "Voltage (V)", "shape": ["number", { "decimalPlaces": 1 }] },
        { "name": "frequency", "displayName": "Frequency (Hz)", "shape": ["number", { "decimalPlaces": 2 }] },
        { "name": "gridPower", "displayName": "Grid power (W)", "shape": "number" },
        { "name": "lastUpdated", "displayName": "Last updated", "shape": "date", "role": "timestamp" },
        { "name": "firmware", "displayName": "Firmware", "shape": "string" }
    ],
    "timeframes": false
}
