{
    "name": "devices",
    "displayName": "Devices",
    "description": "The hub and every Zappi, Eddi, Harvi and Libbi registered to it",
    "tags": ["Devices", "Energy"],
    "baseDataSourceName": "httpRequestUnscoped",
    "visibility": { "type": "hidden" },
    "config": {
        "httpMethod": "get",
        "endpointPath": "cgi-jstatus-*",
        "paging": { "mode": "none" },
        "postRequestScript": "devices.js"
    },
    "matches": "none",
    "metadata": [
        { "name": "deviceKey", "displayName": "Device key", "shape": "string", "role": "id" },
        { "name": "name", "displayName": "Name", "shape": "string", "role": "label" },
        { "name": "sourceType", "displayName": "Type", "shape": "string" },
        { "name": "serial", "displayName": "Serial number", "shape": "string" },
        { "name": "firmware", "displayName": "Firmware", "shape": "string" },
        { "name": "phases", "displayName": "Phases", "shape": "number" },
        { "name": "ctTypes", "displayName": "CT types", "shape": ["array", { "itemShape": "string" }] },
        { "name": "heater1Name", "displayName": "Heater 1 name", "shape": "string" },
        { "name": "heater2Name", "displayName": "Heater 2 name", "shape": "string" },
        { "name": "batteryCapacity", "displayName": "Battery capacity (Wh)", "shape": "number" },
        { "name": "inverterSize", "displayName": "Inverter size (W)", "shape": "number" },
        { "name": "server", "displayName": "Server", "shape": "string" }
    ],
    "timeframes": false
}
