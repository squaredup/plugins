{
    "name": "ctReadings",
    "displayName": "CT readings",
    "description": "Live power reading from each current transformer clamp on the selected devices",
    "tags": ["Energy", "Devices"],
    "baseDataSourceName": "httpRequestScoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "cgi-jstatus-*",
        "paging": { "mode": "none" },
        "postRequestScript": "ctReadings.js"
    },
    "matches": {
        "sourceType": { "type": "oneOf", "values": ["Zappi", "Eddi", "Harvi", "Libbi"] }
    },
    "metadata": [
        { "name": "ctLabel", "displayName": "CT", "shape": "string", "role": "label" },
        { "name": "deviceName", "displayName": "Device", "shape": "string" },
        { "name": "deviceKey", "displayName": "Device key", "shape": "string", "visible": false },
        { "name": "deviceType", "displayName": "Device type", "shape": "string" },
        { "name": "ct", "displayName": "CT number", "shape": "number" },
        { "name": "ctType", "displayName": "CT type", "shape": "string" },
        { "name": "power", "displayName": "Power (W)", "shape": ["number", { "decimalPlaces": 0 }], "role": "value" },
        { "name": "phase", "displayName": "Phase", "shape": "number" },
        { "name": "lastUpdated", "displayName": "Last updated", "shape": "date", "role": "timestamp" }
    ],
    "timeframes": false
}
