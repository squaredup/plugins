{
    "name": "deviceHistory",
    "displayName": "Energy History",
    "description": "Minute-by-minute imported, exported, generated and diverted power for a zappi, eddi or libbi",
    "tags": [
        "Energy",
        "Devices"
    ],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/devices/{{object.rawId}}/history",
        "pathToData": "history",
        "getArgs": [
            {
                "key": "start",
                "value": "{{timeframe.start}}"
            },
            {
                "key": "end",
                "value": "{{timeframe.end}}"
            }
        ]
    },
    "matches": {
        "sourceType": {
            "type": "oneOf",
            "values": [
                "myenergi Zappi",
                "myenergi Eddi",
                "myenergi Libbi"
            ]
        }
    },
    "metadata": [
        {
            "name": "timestamp",
            "displayName": "Time",
            "shape": "date",
            "role": "timestamp"
        },
        {
            "name": "importPower",
            "displayName": "Imported (W)",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0
                }
            ]
        },
        {
            "name": "exportPower",
            "displayName": "Exported (W)",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0
                }
            ]
        },
        {
            "name": "generationPositivePower",
            "displayName": "Generated (W)",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0
                }
            ]
        },
        {
            "name": "generationNegativePower",
            "displayName": "Generation Consumed (W)",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0
                }
            ]
        },
        {
            "name": "divertedLoadPower1",
            "displayName": "Diverted 1 (W)",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0
                }
            ]
        },
        {
            "name": "divertedLoadPower2",
            "displayName": "Diverted 2 (W)",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0
                }
            ]
        },
        {
            "name": "divertedLoadPower3",
            "displayName": "Diverted 3 (W)",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0
                }
            ]
        },
        {
            "name": "boostLoadPower1",
            "displayName": "Boost 1 (W)",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0
                }
            ]
        },
        {
            "name": "boostLoadPower2",
            "displayName": "Boost 2 (W)",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0
                }
            ]
        },
        {
            "name": "boostLoadPower3",
            "displayName": "Boost 3 (W)",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0
                }
            ]
        },
        {
            "name": "batteryChargePower",
            "displayName": "Battery Charge (W)",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0
                }
            ]
        },
        {
            "name": "batteryDischargePower",
            "displayName": "Battery Discharge (W)",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0
                }
            ]
        },
        {
            "name": "pvPower",
            "displayName": "PV Power (W)",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0
                }
            ]
        },
        {
            "name": "stateOfCharge",
            "displayName": "State of Charge",
            "shape": "percent"
        },
        {
            "name": "voltage1",
            "displayName": "Voltage (V)",
            "shape": [
                "number",
                {
                    "decimalPlaces": 1
                }
            ]
        },
        {
            "name": "frequency",
            "displayName": "Frequency (Hz)",
            "shape": [
                "number",
                {
                    "decimalPlaces": 2
                }
            ]
        },
        {
            "name": "pt1",
            "displayName": "Temp 1 (°C)",
            "shape": [
                "number",
                {
                    "decimalPlaces": 1
                }
            ]
        },
        {
            "name": "pt2",
            "displayName": "Temp 2 (°C)",
            "shape": [
                "number",
                {
                    "decimalPlaces": 1
                }
            ]
        },
        {
            "name": "deviceClass",
            "displayName": "Device Class",
            "shape": "string",
            "visible": false
        }
    ],
    "timeframes": [
        "last1hour",
        "last12hours",
        "last24hours",
        "last7days"
    ]
}
