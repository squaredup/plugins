{
    "name": "siteList",
    "displayName": "Sites",
    "description": "myenergi sites on the account with their grid power limit",
    "tags": [
        "Inventory"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/devices",
        "pathToData": "sites"
    },
    "matches": "none",
    "visibility": {
        "type": "hidden"
    },
    "metadata": [
        {
            "name": "name",
            "displayName": "Name",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "gridLimit",
            "displayName": "Grid Limit (kW)",
            "shape": [
                "number",
                {
                    "decimalPlaces": 1
                }
            ]
        },
        {
            "name": "siteId",
            "displayName": "Site ID",
            "shape": "string",
            "visible": false
        }
    ],
    "timeframes": false
}
