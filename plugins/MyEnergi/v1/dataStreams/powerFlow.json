{
    "name": "powerFlow",
    "displayName": "Power Flow",
    "description": "Live site power flow including grid, generation, EV charging, hot water and battery",
    "tags": ["Energy"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "cgi-jstatus-*",
        "paging": { "mode": "none" },
        "postRequestScript": "powerFlow.js"
    },
    "matches": "none",
    "metadata": [
        { "name": "gridPower", "displayName": "Grid (W)", "shape": "number" },
        { "name": "importPower", "displayName": "Import (W)", "shape": "number" },
        { "name": "exportPower", "displayName": "Export (W)", "shape": "number" },
        { "name": "generationPower", "displayName": "Generation (W)", "shape": "number" },
        { "name": "consumptionPower", "displayName": "Consumption (W)", "shape": "number", "role": "value" },
        { "name": "houseLoadPower", "displayName": "House load (W)", "shape": "number" },
        { "name": "evChargePower", "displayName": "EV charging (W)", "shape": "number" },
        { "name": "hotWaterPower", "displayName": "Hot water (W)", "shape": "number" },
        { "name": "batteryPower", "displayName": "Battery (W)", "shape": "number" },
        { "name": "lastUpdated", "displayName": "Last updated", "shape": "date", "role": "timestamp" }
    ],
    "timeframes": false
}
