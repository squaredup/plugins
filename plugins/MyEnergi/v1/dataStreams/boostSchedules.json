{
    "name": "boostSchedules",
    "displayName": "Boost Schedules",
    "description": "Configured boost timer slots for each Zappi and Eddi",
    "tags": ["Energy"],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "cgi-boost-time-{{object.rawId}}",
        "paging": { "mode": "none" },
        "postRequestScript": "boostSchedules.js"
    },
    "matches": { "sourceType": { "type": "oneOf", "values": ["Zappi", "Eddi"] } },
    "metadata": [
        { "name": "deviceName", "displayName": "Device", "shape": "string", "role": "label" },
        { "name": "deviceKey", "displayName": "Device key", "shape": "string", "role": "id", "visible": false },
        { "name": "deviceType", "displayName": "Type", "shape": "string" },
        { "name": "slot", "displayName": "Slot", "shape": "number" },
        { "name": "target", "displayName": "Target", "shape": "string" },
        { "name": "startTime", "displayName": "Start time", "shape": "string" },
        { "name": "duration", "displayName": "Duration", "shape": "minutes" },
        { "name": "days", "displayName": "Days", "shape": ["array", { "itemShape": "string" }] }
    ],
    "timeframes": false
}
