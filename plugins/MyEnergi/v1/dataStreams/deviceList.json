{
    "name": "deviceList",
    "displayName": "Devices",
    "description": "myenergi devices across all sites with their model, site, connection status and firmware",
    "tags": [
        "Inventory",
        "Devices"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/devices",
        "postRequestScript": "deviceList.js"
    },
    "matches": "none",
    "metadata": [
        {
            "name": "name",
            "displayName": "Name",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "sourceType",
            "displayName": "Type",
            "shape": "string"
        },
        {
            "name": "model",
            "displayName": "Model",
            "shape": "string"
        },
        {
            "name": "status",
            "displayName": "Status",
            "shape": [
                "state",
                {
                    "map": {
                        "success": [
                            "active"
                        ],
                        "warning": [
                            "inactive"
                        ],
                        "error": [
                            "offline",
                            "faulted"
                        ],
                        "unknown": [
                            "unknown"
                        ]
                    }
                }
            ]
        },
        {
            "name": "online",
            "displayName": "Online",
            "shape": "boolean"
        },
        {
            "name": "siteName",
            "displayName": "Site",
            "shape": "string"
        },
        {
            "name": "firmwareVersion",
            "displayName": "Firmware",
            "shape": "string"
        },
        {
            "name": "serialNumber",
            "displayName": "Serial Number",
            "shape": "string"
        },
        {
            "name": "powerLimit",
            "displayName": "Power Limit (kW)",
            "shape": [
                "number",
                {
                    "decimalPlaces": 1
                }
            ]
        },
        {
            "name": "lastSeen",
            "displayName": "Last Seen",
            "shape": "date"
        },
        {
            "name": "deviceId",
            "displayName": "Device ID",
            "shape": "string",
            "visible": false
        },
        {
            "name": "deviceType",
            "displayName": "Device Category",
            "shape": "string",
            "visible": false
        },
        {
            "name": "siteId",
            "displayName": "Site ID",
            "shape": "string",
            "visible": false
        }
    ],
    "timeframes": false
}
