{
    "displayName": "Ingress routes to Service",
    "source": {
        "types": "Ingress"
    },
    "target": {
        "types": "Service"
    },
    "conditions": [
        {
            "sourceProperty": "primaryBackendServiceName",
            "operator": "equals",
            "targetProperty": "name"
        },
        {
            "sourceProperty": "namespace",
            "operator": "equals",
            "targetProperty": "namespace"
        }
    ],
    "labels": {
        "forward": "routes to",
        "reverse": "exposed via"
    }
}
