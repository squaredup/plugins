{
    "name": "nodeMetrics",
    "displayName": "Node Metrics",
    "description": "Live CPU and memory usage per cluster node, one row per node",
    "tags": [
        "Metrics"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/apis/metrics.k8s.io/v1beta1/nodes",
        "postRequestScript": "nodeMetrics.js"
    },
    "matches": "none",
    "ui": [
        {
            "type": "objects",
            "name": "node",
            "label": "Filter by Node",
            "matches": {
                "sourceType": {
                    "type": "equals",
                    "value": "Node"
                }
            }
        }
    ],
    "metadata": [
        {
            "name": "name",
            "displayName": "Name",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "cpuUsageMillicores",
            "displayName": "CPU Usage (m)",
            "shape": "number"
        },
        {
            "name": "memoryUsageBytes",
            "displayName": "Memory Usage",
            "shape": "bytes"
        }
    ],
    "timeframes": false
}
