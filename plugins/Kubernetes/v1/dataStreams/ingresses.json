{
    "name": "ingresses",
    "displayName": "Ingresses",
    "description": "Kubernetes ingresses, one row per ingress",
    "tags": [
        "Resources"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/apis/networking.k8s.io/v1/ingresses",
        "postRequestScript": "ingresses.js"
    },
    "matches": "none",
    "metadata": [
        {
            "name": "uid",
            "displayName": "UID",
            "shape": "string",
            "role": "id"
        },
        {
            "name": "name",
            "displayName": "Name",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "namespace",
            "displayName": "Namespace",
            "shape": "string"
        },
        {
            "name": "ingressClassName",
            "displayName": "Ingress Class",
            "shape": "string"
        },
        {
            "name": "hosts",
            "displayName": "Hosts",
            "shape": "string"
        },
        {
            "name": "primaryBackendServiceName",
            "displayName": "Primary Backend Service",
            "shape": "string",
            "visible": false
        }
    ],
    "timeframes": false
}
