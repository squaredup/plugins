{
    "name": "podMetrics",
    "displayName": "Pod Metrics",
    "description": "Live CPU and memory usage per pod, one row per pod",
    "tags": [
        "Metrics"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/apis/metrics.k8s.io/v1beta1/pods",
        "postRequestScript": "podMetrics.js"
    },
    "matches": "none",
    "ui": [
        {
            "type": "objects",
            "name": "pod",
            "label": "Pod (optional)",
            "matches": {
                "sourceType": {
                    "type": "equals",
                    "value": "Pod"
                }
            }
        }
    ],
    "metadata": [
        {
            "name": "name",
            "displayName": "Name",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "namespace",
            "displayName": "Namespace",
            "shape": "string"
        },
        {
            "name": "cpuUsageMillicores",
            "displayName": "CPU Usage (m)",
            "shape": "number"
        },
        {
            "name": "memoryUsageBytes",
            "displayName": "Memory Usage",
            "shape": "bytes"
        }
    ],
    "timeframes": false
}
