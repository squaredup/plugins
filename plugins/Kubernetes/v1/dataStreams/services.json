{
    "name": "services",
    "displayName": "Services",
    "description": "Kubernetes services, one row per service",
    "tags": [
        "Resources"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/api/v1/services",
        "postRequestScript": "services.js"
    },
    "matches": "none",
    "ui": [
        {
            "type": "objects",
            "name": "ingress",
            "label": "Filter by Ingress",
            "matches": {
                "sourceType": {
                    "type": "equals",
                    "value": "Ingress"
                }
            }
        }
    ],
    "metadata": [
        {
            "name": "uid",
            "displayName": "UID",
            "shape": "string",
            "role": "id"
        },
        {
            "name": "name",
            "displayName": "Name",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "namespace",
            "displayName": "Namespace",
            "shape": "string"
        },
        {
            "name": "serviceType",
            "displayName": "Type",
            "shape": "string"
        },
        {
            "name": "selectorAppLabel",
            "displayName": "Selector App Label",
            "shape": "string",
            "visible": false
        }
    ],
    "timeframes": false
}
