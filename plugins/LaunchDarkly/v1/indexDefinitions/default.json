{
    "steps": [
        {
            "name": "projects",
            "dataStream": { "name": "projects" },
            "timeframe": "none",
            "objectMapping": {
                "id": "key",
                "name": "name",
                "type": { "value": "Project" }
            }
        },
        {
            "name": "environments",
            "dataStream": { "name": "environments" },
            "scope": {
                "query": "g.V().has(\"sourceType\", \"Project\")"
            },
            "timeframe": "none",
            "objectMapping": {
                "id": "environmentId",
                "name": "name",
                "type": { "value": "Environment" },
                "properties": ["environmentKey", "environmentName", "projectKey", "critical", "tagList"]
            },
            "dependsOn": ["projects"]
        },
        {
            "name": "flags",
            "dataStream": { "name": "flagList" },
            "scope": {
                "query": "g.V().has(\"sourceType\", \"Project\")"
            },
            "timeframe": "none",
            "objectMapping": {
                "id": "flagId",
                "name": "name",
                "type": { "value": "Flag" },
                "properties": [
                    "flagKey",
                    "projectKey",
                    "kind",
                    "temporary",
                    "deprecated",
                    "tagList",
                    "maintainer",
                    "createdAt"
