{
    "name": "projects",
    "displayName": "Projects",
    "description": "LaunchDarkly projects in the account",
    "tags": ["Organization"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "projects",
        "pathToData": "items",
        "paging": {
            "mode": "offset",
            "pageSize": { "realm": "queryArg", "path": "limit", "value": "100" },
            "offset": {
                "mode": "row",
                "rowCountIn": { "realm": "payloadArraySize", "path": "items" },
                "base": 0
            },
            "out": { "realm": "queryArg", "path": "offset" }
        }
    },
    "matches": "none",
    "metadata": [
        { "name": "key", "displayName": "Key", "role": "value" },
        { "name": "name", "displayName": "Name", "role": "label" }
    ],
    "timeframes": false,
    "visibility": { "type": "hidden" }
}
