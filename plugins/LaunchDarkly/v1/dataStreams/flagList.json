{
    "name": "flagList",
    "displayName": "Flag List",
    "description": "Feature flags in a LaunchDarkly project (excludes archived flags)",
    "tags": ["Inventory"],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "flags/{{object.rawId}}",
        "paging": {
            "mode": "offset",
            "pageSize": { "realm": "queryArg", "path": "limit", "value": "100" },
            "offset": {
                "mode": "row",
                "rowCountIn": { "realm": "payloadArraySize", "path": "items" },
                "base": 0
            },
            "out": { "realm": "queryArg", "path": "offset" }
        },
        "postRequestScript": "flagList.js"
    },
    "matches": { "sourceType": { "type": "oneOf", "values": ["Project"] } },
    "metadata": [
        { "name": "flagId", "displayName": "Flag ID", "visible": false },
        { "sourceId": "flagId", "sourceType": "Flag", "name": "name" },
        { "name": "name", "displayName": "Name", "role": "label" },
        { "name": "flagKey", "displayName": "Key" },
        { "name": "projectKey", "displayName": "Project Key" },
        { "name": "kind", "displayName": "Kind" },
        { "name": "temporary", "displayName": "Temporary", "shape": "boolean" },
        { "name": "deprecated", "displayName": "Deprecated", "shape": "boolean" },
        { "name": "tagList", "displayName": "Tags" },
        { "name": "maintainer", "displayName": "Maintainer" },
        { "name": "createdAt", "displayName": "Created", "shape": "date" }
    ],
    "timeframes": false
}
