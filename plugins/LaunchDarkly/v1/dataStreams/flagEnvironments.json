{
    "name": "flagEnvironments",
    "displayName": "Flag Environments",
    "description": "State of a feature flag in each environment of its project",
    "tags": ["Status", "Configuration"],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "flags/{{object.projectKey}}/{{object.flagKey}}",
        "postRequestScript": "flagEnvironments.js"
    },
    "matches": { "sourceType": { "type": "oneOf", "values": ["Flag"] } },
    "metadata": [
        { "name": "environmentId", "displayName": "Environment ID", "visible": false },
        { "name": "environment", "displayName": "Environment", "role": "label" },
        { "name": "environmentKey", "displayName": "Key" },
        { "name": "on", "displayName": "On", "shape": "boolean" },
        {
            "name": "status",
            "displayName": "Status",
            "shape": ["state", { "map": { "success": ["On"], "unknown": ["Off"] } }]
        },
        { "name": "servingVariation", "displayName": "Serving Variation" },
        { "name": "offVariation", "displayName": "Off Variation" },
        { "name": "rules", "displayName": "Rules", "shape": "number" },
        { "name": "targets", "displayName": "Targets", "shape": "number" },
        { "name": "prerequisites", "displayName": "Prerequisites", "shape": "number" },
        { "name": "lastModified", "displayName": "Last Modified", "shape": "date" },
        { "name": "version", "displayName": "Version", "shape": "number" },
        { "sourceId": "environmentId", "sourceType": "Environment", "name": "environment" }
    ],
    "timeframes": false
}
