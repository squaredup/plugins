{
    "name": "environments",
    "displayName": "Environments",
    "description": "Environments in a LaunchDarkly project",
    "tags": ["Organization"],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "projects/{{object.rawId}}/environments",
        "paging": {
            "mode": "offset",
            "pageSize": { "realm": "queryArg", "path": "limit", "value": "100" },
            "offset": {
                "mode": "row",
                "rowCountIn": { "realm": "payloadArraySize", "path": "items" },
                "base": 0
            },
            "out": { "realm": "queryArg", "path": "offset" }
        },
        "postRequestScript": "environments.js"
    },
    "matches": { "sourceType": { "type": "oneOf", "values": ["Project"] } },
    "metadata": [
        { "name": "environmentId", "displayName": "Environment ID", "visible": false },
        { "sourceId": "environmentId", "sourceType": "Environment", "name": "name" },
        { "name": "name", "displayName": "Name", "role": "label" },
        { "name": "environmentName", "displayName": "Environment", "visible": false },
        { "name": "environmentKey", "displayName": "Key" },
        { "name": "projectKey", "displayName": "Project Key" },
        { "name": "critical", "displayName": "Critical", "shape": "boolean" },
        { "name": "tagList", "displayName": "Tags" }
    ],
    "timeframes": false
}
