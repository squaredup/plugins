{
    "name": "scheduledChanges",
    "displayName": "Scheduled Changes",
    "description": "Upcoming scheduled changes to a feature flag in an environment",
    "tags": ["Activity", "Configuration"],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "projects/{{object.projectKey}}/flags/{{object.flagKey}}/environments/{{environmentKey || 'production'}}/scheduled-changes",
        "postRequestScript": "scheduledChanges.js"
    },
    "ui": [
        {
            "name": "environmentKey",
            "label": "Environment key",
            "type": "text",
            "defaultValue": "production",
            "placeholder": "production"
        }
    ],
    "matches": { "sourceType": { "type": "oneOf", "values": ["Flag"] } },
    "metadata": [
        { "name": "id", "displayName": "ID", "shape": "string", "visible": false },
        { "name": "executionDate", "displayName": "Execution Date", "shape": "date", "role": "timestamp" },
        { "name": "change", "displayName": "Change", "shape": "string", "role": "label" },
        { "name": "environment", "displayName": "Environment", "shape": "string" },
        { "name": "createdAt", "displayName": "Created", "shape": "date" },
        { "name": "creator", "displayName": "Creator ID", "shape": "string" },
        { "name": "conflicts", "displayName": "Conflicts", "shape": "number" }
    ],
    "timeframes": false
}
