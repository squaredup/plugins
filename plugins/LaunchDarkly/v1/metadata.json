{
    "name": "launchdarkly",
    "displayName": "LaunchDarkly",
    "version": "1.0.0",
    "author": { "name": "@clarkd", "type": "community" },
    "description": "Monitor LaunchDarkly feature flags across your projects and environments, including flag state, lifecycle status and evaluation volume.",
    "category": "CI/CD Tools",
    "type": "hybrid",
    "schemaVersion": "2.1",
    "importNotSupported": false,
    "restrictedToPlatforms": [],
    "keywords": [
        "launchdarkly",
        "feature flags",
        "feature management",
        "flags",
        "releases",
        "toggles"
    ],
    "objectTypes": ["Project", "Environment", "Flag"],
    "links": [
        {
            "category": "documentation",
            "url": "https://github.com/squaredup/plugins/blob/main/plugins/LaunchDarkly/v1/docs/README.md",
            "label": "Help adding this plugin"
        },
        {
            "category": "source",
            "url": "https://github.com/squaredup/plugins/tree/main/plugins/LaunchDarkly",
            "label": "Repository"
        }
    ],
    "base": {
        "plugin": "WebAPI",
        "majorVersion": "1",
        "config": {
            "baseUrl": "{{ ({ eu: 'https://app.eu.launchdarkly.com', federal: 'https://app.launchdarkly.us' })[instance] || 'https://app.launchdarkly.com' }}/api/v2",
            "authMode": "none",
            "headers": [
                { "key": "Authorization", "value": "{{accessToken}}" },
                { "key": "LD-API-Version", "value": "20240415" }
            ]
        }
    }
}
