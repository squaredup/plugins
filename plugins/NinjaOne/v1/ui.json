[
    {
        "type": "radio",
        "name": "apiBaseUrl",
        "label": "Region",
        "help": "Select your NinjaOne instance region",
        "defaultValue": "https://ca-api.ninjarmm.com",
        "options": [
            {
                "value": "https://api.ninjarmm.com",
                "label": "US"
            },
            {
                "value": "https://eu-api.ninjarmm.com",
                "label": "EU"
            },
            {
                "value": "https://ca-api.ninjarmm.com",
                "label": "Canada"
            },
            {
                "value": "https://oc-api.ninjarmm.com",
                "label": "OC"
            }
        ],
        "validation": {
            "required": true
        }
    },
    {
        "type": "text",
        "name": "clientId",
        "label": "Client ID",
        "help": "Enter the Client ID from your NinjaOne API credentials",
        "validation": {
            "required": true
        },
        "placeholder": "Enter your Client ID"
    },
    {
        "type": "password",
        "name": "clientSecret",
        "label": "Client Secret",
        "help": "Enter the Client Secret from your NinjaOne API credentials",
        "validation": {
            "required": true
        },
        "placeholder": "Enter your Client Secret"
    },
    {
        "type": "radio",
        "name": "ticketingApiPath",
        "label": "NinjaOne Ticketing Module",
        "help": "Select 'Disabled' if your NinjaOne tenant does not have the optional Ticketing module enabled. Leaving this set to 'Enabled' on a tenant without ticketing will cause the import to fail.",
        "defaultValue": "/v2/ticketing/trigger/boards",
        "options": [
            {
                "value": "/v2/ticketing/trigger/boards",
                "label": "Enabled"
            },
            {
                "value": "/v2/organizations",
                "label": "Disabled"
            }
        ],
        "validation": {
            "required": true
        }
    }
]
