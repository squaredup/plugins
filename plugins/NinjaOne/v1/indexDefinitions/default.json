{
    "steps": [
        {
            "name": "organizations",
            "dataStream": {
                "name": "organizations"
            },
            "timeframe": "none",
            "objectMapping": {
                "id": "id",
                "name": "name",
                "type": { "value": "NinjaOne Organization" },
                "properties": [{ "organizationId": "id" }, "description", "nodeApprovalMode"],
                "externalLink": "{{instanceUrl}}/app/organizations/{{id}}"
            }
        },
        {
            "name": "locations",
            "dataStream": {
                "name": "locations"
            },
            "timeframe": "none",
            "objectMapping": {
                "id": "locationId",
                "name": "name",
                "type": { "value": "NinjaOne Location" },
                "properties": [
                    { "locationId": "locationId" },
                    "organizationId",
                    "description",
                    "address"
                ],
                "externalLink": "{{instanceUrl}}/app/organizations/{{organizationId}}/locations/{{locationId}}"
            }
        },
        {
            "name": "devices",
            "dataStream": {
                "name": "devices"
            },
            "timeframe": "none",
            "objectMapping": {
                "id": "deviceId",
                "name": "displayName",
                "type": { "value": "NinjaOne Device" },
                "properties": [
                    { "deviceId": "deviceId" },
                    { "nodeId": "id" },
                    "organizationId",
                    "locationId",
                    "systemName"
                ],
                "externalLink": "{{instanceUrl}}/app/devices/{{deviceId}}"
            }
        },
        {
            "name": "ticketBoards",
            "dataStream": {
                "name": "ticketBoards"
            },
            "timeframe": "none",
            "objectMapping": {
                "id": "id",
                "name": "name",
                "type": { "value": "NinjaOne Ticket Board" },
                "properties": [{ "boardId": "id" }, "description", "organizationId"],
                "externalLink": "{{instanceUrl}}/app/ticketing/boards/{{id}}"
            }
        }
    ]
