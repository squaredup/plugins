                "z": 0,
                "config": {
                    "timeframe": "last7days",
                    "dataStream": {
                        "name": "activities",
                        "id": "{{dataStreams.activities}}",
                        "filter": {
                            "multiOperation": "or",
                            "filters": [
                                {
                                    "column": "status",
                                    "operation": "equals",
                                    "value": "failed"
                                },
                                {
                                    "column": "status",
                                    "operation": "equals",
                                    "value": "error"
