                                {
                                    "type": "sum",
                                    "names": ["pendingOSPatchesCount"]
                                }
                            ]
                        },
                        "pluginConfigId": "{{configId}}"
                    },
                    "_type": "tile/data-stream",
                    "description": "",
                    "activePluginConfigIds": ["{{configId}}"],
                    "title": "Pending OS Patches",
                    "visualisation": {
                        "type": "data-stream-scalar",
                        "config": {
                            "data-stream-scalar": {
                                "value": "pendingOSPatchesCount_sum",
                                "comparisonColumn": "none",
                                "formatted": false
                            }
                        }
                    }
                }
            },
            {
                "static": false,
