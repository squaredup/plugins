                "i": "patch-kpi-pendingos-001",
                "z": 0,
                "config": {
                    "timeframe": "none",
                    "dataStream": {
                        "name": "deviceHealth",
                        "id": "{{dataStreams.deviceHealth}}",
                        "group": {
                            "by": [],
