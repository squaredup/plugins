{
    "name": "ninja-one",
    "displayName": "NinjaOne",
    "version": "1.0.0",
    "author": {
        "name": "Dan Watts",
        "type": "community"
    },
    "description": "Dashboard and Monitor your NinjaOne device data",
    "category": "Monitoring",
    "type": "cloud",
    "schemaVersion": "2.0",
    "base": {
        "plugin": "WebAPI",
        "majorVersion": "1",
        "config": {
            "queryArgs": [],
            "oauth2TokenExtraArgs": [],
            "oauth2ClientSecret": "{{clientSecret}}",
            "oauth2ClientSecretLocationDuringAuth": "body",
            "oauth2AuthUrl": "{{instanceUrl}}/oauth/authorize",
            "oauth2TokenExtraHeaders": [],
            "oauth2AuthExtraArgs": [],
            "headers": [],
            "authMode": "oauth2",
            "oauth2GrantType": "authCode",
            "baseUrl": "{{apiBaseUrl}}",
            "oauth2ClientId": "{{clientId}}",
            "oauth2TokenUrl": "{{instanceUrl}}/oauth/token",
            "oauth2Scope": "monitoring management control offline_access"
        }
    }
}
