{
    "name": "organizationLocations",
    "displayName": "Locations (Organization)",
    "tags": ["Monitoring"],
    "description": "Locations for a specific organization",
    "baseDataSourceName": "httpRequestScoped",
    "config": {
        "httpMethod": "get",
        "paging": {
            "mode": "none"
        },
        "expandInnerObjects": true,
        "endpointPath": "/v2/locations",
        "postRequestScript": "organizationLocations.js",
        "pathToData": "",
        "getArgs": [
            {
                "key": "pageSize",
                "value": "10000"
            }
        ],
        "headers": []
    },
    "matches": {
        "sourceType": {
            "type": "oneOf",
            "values": ["Organization"]
        }
    },
    "metadata": [
        {
            "name": "name",
            "displayName": "Location Name",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "locationId",
            "displayName": "Location ID",
            "shape": "string",
            "role": "id",
            "visible": false
        },
        {
            "name": "description",
            "displayName": "Description",
            "shape": "string"
        },
        {
            "name": "address",
            "displayName": "Address",
            "shape": "string"
        },
        {
            "pattern": ".*"
        }
    ],
    "timeframes": false
}
