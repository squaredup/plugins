{
    "name": "devices",
    "displayName": "Devices",
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "paging": {
            "mode": "token",
            "pageSize": {
                "realm": "queryArg",
                "path": "pageSize",
                "value": "1000"
            },
            "in": {
                "realm": "payload",
                "path": "metadata.next_page_token"
            },
            "out": {
                "realm": "queryArg",
                "path": "after"
            }
        },
        "expandInnerObjects": true,
        "endpointPath": "/v2/devices",
        "postRequestScript": "devices.js",
        "pathToData": "",
        "getArgs": [],
        "headers": []
    },
