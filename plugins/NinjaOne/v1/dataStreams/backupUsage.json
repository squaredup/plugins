        }
    ],
    "timeframes": [
        "last1hour",
        "last12hours",
        "last24hours",
        "last7days",
        "last30days",
        "thisMonth",
        "thisQuarter",
        "thisYear",
        "lastMonth",
        "lastQuarter",
        "lastYear",
        "none"
    ]
