{
    "name": "backupUsage",
    "displayName": "Backup Usage",
    "description": "Backup storage usage by organization and location",
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "paging": {
            "mode": "none"
        },
        "expandInnerObjects": false,
        "endpointPath": "/v2/queries/backup/usage",
        "pathToData": "results",
        "getArgs": [],
        "headers": []
    },
    "metadata": [
        {
            "name": "organizationId",
            "displayName": "Organization ID",
            "shape": "string",
            "role": "id",
            "visible": false
        },
        {
            "name": "organizationName",
            "displayName": "Organization",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "locationId",
            "displayName": "Location ID",
            "shape": "string"
        },
        {
            "name": "locationName",
            "displayName": "Location",
            "shape": "string"
        },
        {
            "name": "usedBytes",
            "displayName": "Used (Bytes)",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0
                }
            ]
        },
        {
            "name": "includedBytes",
            "displayName": "Included (Bytes)",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0
                }
            ]
        },
        {
            "name": "overageBytes",
            "displayName": "Overage (Bytes)",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0
                }
            ]
        },
        {
            "name": "deviceCount",
            "displayName": "Device Count",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0
                }
            ]
        },
        {
