{
    "name": "github-copilot",
    "displayName": "GitHub Copilot",
    "version": "1.0.0",
    "author": {
        "name": "SquaredUp Labs",
        "type": "labs"
    },
    "description": "Track GitHub Copilot licences, adoption, AI credit spend and token usage by person and model across your organization or enterprise.",
    "category": "Analytics",
    "type": "hybrid",
    "schemaVersion": "2.1",
    "importNotSupported": false,
    "restrictedToPlatforms": [],
    "keywords": [
        "github",
        "copilot",
        "ai",
        "llm",
        "ai credits",
        "premium requests",
        "tokens",
        "usage",
        "adoption",
        "licences",
        "seats",
        "billing",
        "budgets",
        "cost centers"
    ],
    "objectTypes": [
        "User",
        "Budget",
        "Cost Center"
    ],
    "links": [
        {
            "category": "documentation",
            "url": "https://github.com/squaredup/plugins/blob/main/plugins/GitHubCopilot/v1/docs/README.md",
            "label": "Help adding this plugin"
        },
        {
            "category": "source",
            "url": "https://github.com/squaredup/plugins/tree/main/plugins/GitHubCopilot/v1",
            "label": "Repository"
        }
    ],
    "base": {
        "plugin": "WebAPI",
        "majorVersion": "1",
        "config": {
            "baseUrl": "{{ (typeof apiUrl !== 'undefined' && apiUrl ? apiUrl.trim() : 'https://api.github.com').replace(/[/]+$/, '') }}",
            "authMode": "none",
            "headers": [
                {
                    "key": "Accept",
                    "value": "application/vnd.github+json"
                },
                {
                    "key": "X-GitHub-Api-Version",
                    "value": "2026-03-10"
                }
            ],
            "queryArgs": [],
            "showScripting": true,
            "scriptingVariables": [
                {
                    "key": "accessToken",
                    "value": "{{ accessToken.trim() }}"
                }
            ],
            "preRequestScript": "preRequest.js"
        }
    }
}
