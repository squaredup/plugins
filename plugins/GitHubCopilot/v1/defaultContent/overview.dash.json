                "config": {
                    "_type": "tile/data-stream",
                    "title": "Copilot Seats",
                    "description": "People with a Copilot licence, and how many used it in the last 30 days",
                    "timeframe": "none",
                    "dataStream": {
                        "id": "datastream-sql",
                        "dataSourceConfig": {
                            "version": "2.0",
                            "sql": "SELECT CAST(COUNT(DISTINCT \"assignee.login\") AS DOUBLE) AS \"seats\", CAST(COUNT(DISTINCT \"assignee.login\") FILTER (WHERE \"activity\" = 'success') AS DOUBLE) AS \"active\" FROM \"seats\"",
                            "tables": [
                                {
                                    "tableName": "seats",
                                    "config": {
                                        "activePluginConfigIds": [
                                            "{{configId}}"
                                        ],
                                        "dataStream": {
                                            "id": "{{dataStreams.[seats]}}",
                                            "name": "seats"
                                        },
                                        "timeframe": "none"
                                    }
                                }
                            ]
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    {
                                        "field": "seats",
                                        "type": "quantitative",
                                        "title": "Seats",
                                        "aggregate": "sum"
                                    },
                                    {
                                        "field": "active",
                                        "type": "quantitative",
                                        "title": "Active (30 days)",
                                        "aggregate": "sum"
                                    }
                                ]
                            },
                            "style": {
                                "scalarColumns": 2
                            }
                        }
                    }
                }
