            {
                "i": "1e4e1437-fabc-4ff0-9893-62a428a1862f",
                "x": 0,
                "y": 2,
                "w": 1,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Seat Activity",
                    "description": "People active in the last 30 days, inactive for longer, or with no recorded activity",
                    "timeframe": "none",
                    "dataStream": {
                        "id": "datastream-sql",
                        "dataSourceConfig": {
                            "version": "2.0",
                            "sql": "WITH \"users\" AS (SELECT \"assignee.login\", CASE WHEN bool_or(\"activity\" = 'success') THEN 'Active' WHEN bool_or(\"activity\" = 'warning') THEN 'Inactive' ELSE 'No recorded activity' END AS \"activity\" FROM \"seats\" GROUP BY \"assignee.login\") SELECT \"activity\", CAST(COUNT(*) AS DOUBLE) AS \"users\" FROM \"users\" GROUP BY \"activity\" ORDER BY \"users\" DESC",
                            "tables": [
                                {
                                    "tableName": "seats",
                                    "config": {
                                        "activePluginConfigIds": [
                                            "{{configId}}"
                                        ],
                                        "dataStream": {
                                            "id": "{{dataStreams.[seats]}}",
                                            "name": "seats"
                                        },
                                        "timeframe": "none"
                                    }
                                }
                            ]
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "pie",
                            "encoding": {
                                "label": {
                                    "field": "activity",
                                    "type": "nominal",
                                    "title": "Activity"
                                },
                                "value": {
                                    "field": "users",
                                    "type": "quantitative",
                                    "title": "Users",
                                    "aggregate": "sum"
                                }
                            },
                            "style": {
                                "pieInnerRadius": 60,
                                "pieDonutCenterValue": "total",
                                "labelFontSize": 12,
                                "piePadAngle": 2,
                                "pieBorderRadius": 4,
                                "pieMinShowLabelAngle": 4,
                                "mappedColors": {
                                    "Active": "#16a34a",
                                    "Inactive": "#d97706",
                                    "No recorded activity": "#64748b"
                                }
                            }
                        }
                    }
                }
            },
            {
                "i": "bad550d2-72ca-4508-a611-6aca815a7c2d",
                "x": 1,
                "y": 2,
                "w": 3,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Active Users Trend",
                    "description": "Daily, weekly and monthly active users over the latest 28-day usage report",
                    "timeframe": "none",
                    "dataStream": {
                        "id": "datastream-sql",
                        "dataSourceConfig": {
                            "version": "2.0",
                            "sql": "SELECT STRFTIME(DATE_TRUNC('day', \"day\"), '%Y-%m-%dT%H:%M:%SZ') AS \"day\", 'Daily' AS \"measure\", CAST(\"dailyActiveUsers\" AS DOUBLE) AS \"users\" FROM \"metrics\" WHERE \"dailyActiveUsers\" IS NOT NULL UNION ALL SELECT STRFTIME(DATE_TRUNC('day', \"day\"), '%Y-%m-%dT%H:%M:%SZ') AS \"day\", 'Weekly' AS \"measure\", CAST(\"weeklyActiveUsers\" AS DOUBLE) AS \"users\" FROM \"metrics\" WHERE \"weeklyActiveUsers\" IS NOT NULL UNION ALL SELECT STRFTIME(DATE_TRUNC('day', \"day\"), '%Y-%m-%dT%H:%M:%SZ') AS \"day\", 'Monthly' AS \"measure\", CAST(\"monthlyActiveUsers\" AS DOUBLE) AS \"users\" FROM \"metrics\" WHERE \"monthlyActiveUsers\" IS NOT NULL ORDER BY 1",
                            "tables": [
                                {
                                    "tableName": "metrics",
                                    "config": {
                                        "activePluginConfigIds": [
                                            "{{configId}}"
                                        ],
                                        "dataStream": {
                                            "id": "{{dataStreams.[usageMetrics]}}",
                                            "name": "usageMetrics"
                                        },
                                        "timeframe": "none"
                                    }
                                }
                            ]
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "line",
                            "encoding": {
                                "x": {
                                    "field": "day",
                                    "type": "temporal",
                                    "title": "Day"
                                },
                                "y": {
                                    "field": "users",
                                    "type": "quantitative",
                                    "title": "Users",
                                    "aggregate": "max"
                                },
                                "series": {
                                    "field": "measure",
                                    "type": "nominal",
                                    "title": "Measure"
                                }
                            },
                            "style": {
                                "cartesianAreaGradient": true,
                                "cartesianSmooth": true,
                                "legendPosition": "bottom",
                                "mappedColors": {
                                    "Daily": "#3b82f6",
                                    "Weekly": "#8b5cf6",
                                    "Monthly": "#14b8a6"
                                }
                            }
                        }
                    }
                }
            },
