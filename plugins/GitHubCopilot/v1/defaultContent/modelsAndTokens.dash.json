            {
                "i": "1936d46f-9d77-4c05-8900-9d60d8f27e07",
                "x": 0,
                "y": 2,
                "w": 4,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Tokens by Model Over Time",
                    "description": "Daily prompt and output tokens, stacked by model",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[tokenUsage]}}",
                        "name": "tokenUsage",
                        "pluginConfigId": "{{configId}}",
                        "group": {
                            "by": [
                                [
                                    "day",
                                    "byDay"
                                ],
                                [
                                    "model",
                                    "uniqueValues"
                                ]
                            ],
                            "aggregate": [
                                {
                                    "type": "sum",
                                    "names": [
                                        "totalTokens"
                                    ]
                                }
                            ]
                        },
                        "sort": {
                            "by": [
                                [
                                    "day_byDay",
                                    "asc"
                                ]
                            ]
                        },
                        "metadata": [
                            {
                                "name": "totalTokens_sum",
                                "displayName": "Total tokens",
                                "shape": [
                                    "number",
                                    {
                                        "decimalPlaces": 0,
                                        "thousandsSeparator": true
                                    }
                                ]
                            },
                            {
                                "pattern": ".*"
                            }
                        ]
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "line",
                            "encoding": {
                                "x": {
                                    "field": "day_byDay",
                                    "type": "temporal",
                                    "title": "Day"
                                },
                                "y": {
                                    "field": "totalTokens_sum",
                                    "type": "quantitative",
                                    "title": "Tokens",
                                    "aggregate": "sum"
                                },
                                "series": {
                                    "field": "model_uniqueValues",
                                    "type": "nominal",
                                    "title": "Model"
                                }
                            },
                            "style": {
                                "cartesianStack": "on",
                                "cartesianAreaGradient": true,
                                "cartesianSmooth": true,
                                "legendPosition": "bottom"
                            }
                        }
                    }
                }
            },
            {
                "i": "b520402a-2f52-4a3e-b173-9f17ff29815c",
                "x": 0,
                "y": 5,
                "w": 2,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Tokens by Client and Model",
                    "description": "How tokens flow from each client to the six busiest models over the latest 28-day usage report",
                    "timeframe": "none",
                    "dataStream": {
                        "id": "datastream-sql",
                        "dataSourceConfig": {
                            "version": "2.0",
                            "sql": "WITH \"t\" AS (SELECT CASE \"client\" WHEN 'vscode' THEN 'VS Code' WHEN 'visualstudio' THEN 'Visual Studio' WHEN 'jetbrains' THEN 'JetBrains' WHEN 'copilot_cli' THEN 'Copilot CLI' WHEN 'cloud_agent' THEN 'Cloud agent' WHEN 'code_review' THEN 'Code review' WHEN 'github_web' THEN 'GitHub.com' ELSE 'Other clients' END AS \"source\", COALESCE(\"model\", 'unknown') AS \"model\", CAST(\"totalTokens\" AS DOUBLE) AS \"tokens\" FROM \"tokens\"), \"ranked\" AS (SELECT \"model\", ROW_NUMBER() OVER (ORDER BY SUM(\"tokens\") DESC) AS \"rank\" FROM \"t\" GROUP BY \"model\") SELECT \"t\".\"source\", CASE WHEN \"ranked\".\"rank\" <= 6 THEN \"t\".\"model\" ELSE 'Other models' END AS \"target\", SUM(\"t\".\"tokens\") AS \"tokens\" FROM \"t\" JOIN \"ranked\" ON \"ranked\".\"model\" = \"t\".\"model\" GROUP BY 1, 2 HAVING SUM(\"t\".\"tokens\") > 0 ORDER BY 3 DESC",
                            "tables": [
                                {
                                    "tableName": "tokens",
                                    "config": {
                                        "activePluginConfigIds": [
                                            "{{configId}}"
                                        ],
                                        "dataStream": {
                                            "id": "{{dataStreams.[tokenUsage]}}",
                                            "name": "tokenUsage"
                                        },
                                        "timeframe": "none"
                                    }
                                }
                            ]
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "sankey",
                            "encoding": {
                                "source": {
                                    "field": "source",
                                    "type": "nominal"
                                },
                                "target": {
                                    "field": "target",
                                    "type": "nominal"
                                },
                                "value": {
                                    "field": "tokens",
                                    "type": "quantitative"
                                }
                            },
                            "style": {
                                "labelFontSize": 11,
                                "mappedColors": {
                                    "VS Code": "#3b82f6",
                                    "Visual Studio": "#8b5cf6",
                                    "JetBrains": "#ec4899",
                                    "Copilot CLI": "#14b8a6",
                                    "Cloud agent": "#f59e0b",
                                    "Code review": "#22c55e",
                                    "GitHub.com": "#64748b",
                                    "Other clients": "#94a3b8",
                                    "Other models": "#94a3b8",
                                    "gpt-*": "#10b981",
                                    "claude-*": "#f97316",
                                    "gemini-*": "#6366f1",
                                    "grok-*": "#e11d48",
                                    "*": "#0ea5e9"
                                }
                            }
                        }
                    }
                }
            },
