                        "pluginConfigId": "{{configId}}",
                        "group": {
                            "by": [],
                            "aggregate": [
                                {
                                    "type": "sum",
                                    "names": [
                                        "requests"
                                    ]
                                },
                                {
                                    "type": "distinctCount",
