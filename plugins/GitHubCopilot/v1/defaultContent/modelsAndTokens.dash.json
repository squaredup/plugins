            {
                "i": "972cf3ef-16c4-4287-af7d-6919a70a7f77",
                "x": 0,
                "y": 11,
                "w": 4,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Model Policies",
                    "description": "Whether each Copilot model is enabled for the organization (organizations only)",
                    "timeframe": "none",
                    "dataStream": {
                        "id": "datastream-sql",
                        "dataSourceConfig": {
                            "version": "2.0",
                            "sql": "SELECT COALESCE(\"displayName\", \"model\") AS \"model\", \"policyState\" AS \"health\", COALESCE(\"policyState[Expanded].rawState\", 'Not configured') AS \"policy\", CAST(CASE \"policyState\" WHEN 'success' THEN 1 WHEN 'warning' THEN 2 WHEN 'error' THEN 3 ELSE 4 END AS DOUBLE) AS \"rank\" FROM \"policies\" ORDER BY \"rank\", \"model\"",
                            "tables": [
                                {
                                    "tableName": "policies",
                                    "config": {
                                        "activePluginConfigIds": [
                                            "{{configId}}"
                                        ],
                                        "dataStream": {
                                            "id": "{{dataStreams.[modelPolicies]}}",
                                            "name": "modelPolicies"
                                        },
                                        "timeframe": "none"
                                    }
                                }
                            ]
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "statusGrid",
                            "encoding": {
                                "label": {
                                    "field": "model",
                                    "type": "nominal"
                                },
                                "status": {
                                    "field": "health",
                                    "type": "nominal"
                                }
                            },
                            "style": {
                                "statusGridColumnsPerRow": 6,
                                "statusGridBlockGap": 4,
                                "labelFontSize": 12,
                                "secondaryFontSize": 10,
                                "statusGridLabelWrap": true,
                                "statusGridMaxBlockHeight": 80,
                                "statusGridSecondaryTemplate": "{{{{raw}}}}{{policy}}{{{{/raw}}}}",
                                "statusGridOrderByField": "rank",
                                "statusGridOrderDirection": "asc"
                            }
                        }
                    }
                }
