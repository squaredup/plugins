{
    "name": "Budget",
    "schemaVersion": "1.5",
    "timeframe": "none",
    "variables": [
        "{{variables.[Copilot Budget]}}"
    ],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "c3fa56f2-4eaf-42a0-a347-65fa6e625c36",
                "x": 0,
                "y": 0,
                "w": 1,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Budget Properties",
                    "description": "What this budget covers and how it is scoped",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "datastream-properties",
                        "name": "properties",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Copilot Budgets]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Copilot Budget]}}"
                    },
                    "variables": [
                        "{{variables.[Copilot Budget]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "name",
                                        "title": "Budget",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "budgetScope",
                                        "title": "Scope",
                                        "renderer": {
                                            "type": "badge",
                                            "defaultColor": "#6366f1"
                                        }
                                    },
                                    {
                                        "field": "budgetEntity",
                                        "title": "Applies to",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "budgetType",
                                        "title": "Type",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "skus",
                                        "title": "Products / SKUs",
                                        "renderer": {
                                            "type": "tag-list",
                                            "separator": ",",
                                            "color": "#475569"
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableTranspose": true,
                                "richTableCellPadding": 6,
                                "richTableWrapText": true
                            }
                        }
                    }
                }
            },
            {
                "i": "d8df3a44-fd66-471c-a0fd-ef3d5a4efda9",
                "x": 1,
                "y": 0,
                "w": 1,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Status",
                    "description": "Spend against this budget this billing cycle, with the share used",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[budgetConsumption]}}",
                        "name": "budgetConsumption",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Copilot Budgets]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Copilot Budget]}}"
                    },
                    "variables": [
                        "{{variables.[Copilot Budget]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "statusGrid",
                            "encoding": {
                                "label": {
                                    "field": "budgetName",
                                    "type": "nominal"
                                },
                                "status": {
                                    "field": "status",
                                    "type": "nominal"
                                },
                                "value": {
                                    "field": "percentUsed",
                                    "type": "quantitative"
                                }
                            },
                            "style": {
                                "statusGridColumnsPerRow": 1,
                                "statusGridLabelWrap": true,
                                "labelFontSize": 15,
                                "secondaryFontSize": 12
                            }
                        }
                    }
                }
            },
            {
                "i": "e638ab36-6f4f-4fc2-9908-6db69fe9eaa0",
                "x": 2,
                "y": 0,
                "w": 1,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Budget Used",
                    "description": "Share of the budget spent this billing cycle",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[budgetConsumption]}}",
                        "name": "budgetConsumption",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Copilot Budgets]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Copilot Budget]}}"
                    },
                    "variables": [
                        "{{variables.[Copilot Budget]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "ringGrid",
                            "encoding": {
                                "value": {
                                    "field": "percentUsed",
                                    "type": "quantitative"
                                }
                            },
                            "style": {
                                "ringGridThresholds": [
                                    {
                                        "to": 0.8,
                                        "color": "#22c55e"
                                    },
                                    {
                                        "to": 0.999,
                                        "color": "#f59e0b"
                                    },
                                    {
                                        "to": 1,
                                        "color": "#ef4444"
                                    }
                                ],
                                "ringGridMax": 100,
                                "ringGridTrackWidth": 10
                            }
                        }
                    }
                }
            },
            {
                "i": "fb8efe39-f02a-475f-9708-d95933b07a2d",
                "x": 3,
                "y": 0,
                "w": 1,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Spend",
                    "description": "Budget limit, amount spent and amount remaining this billing cycle",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[budgetConsumption]}}",
                        "name": "budgetConsumption",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Copilot Budgets]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Copilot Budget]}}"
                    },
                    "variables": [
                        "{{variables.[Copilot Budget]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    {
                                        "field": "budgetAmount",
                                        "type": "quantitative",
                                        "title": "Budget",
                                        "aggregate": "max"
                                    },
                                    {
                                        "field": "consumedAmount",
                                        "type": "quantitative",
                                        "title": "Spent",
                                        "aggregate": "max"
                                    },
                                    {
                                        "field": "remainingAmount",
                                        "type": "quantitative",
                                        "title": "Remaining",
                                        "aggregate": "max"
                                    }
                                ]
                            },
                            "style": {
                                "scalarColumns": 1
                            }
                        }
                    }
                }
            },
            {
                "i": "43cfdac1-e659-410d-8227-fa75fd777ff3",
                "x": 0,
                "y": 3,
                "w": 4,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Per-User Spend Status (Enterprise Only)",
                    "description": "Each person's spend against a universal per-user budget, highest share first",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[budgetUsers]}}",
                        "name": "budgetUsers",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [
                                [
                                    "percentUsed",
                                    "desc"
                                ]
                            ]
                        }
                    },
                    "scope": {
                        "scope": "{{scopes.[Copilot Budgets]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Copilot Budget]}}"
                    },
                    "variables": [
                        "{{variables.[Copilot Budget]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "statusGrid",
                            "encoding": {
                                "label": {
                                    "field": "login",
                                    "type": "nominal"
                                },
                                "status": {
                                    "field": "status",
                                    "type": "nominal"
                                },
                                "value": {
                                    "field": "percentUsed",
                                    "type": "quantitative"
                                }
                            },
                            "style": {
                                "statusGridColumnsPerRow": 6,
                                "statusGridBlockGap": 4,
                                "statusGridMaxBlockHeight": 80,
                                "statusGridLabelWrap": true,
                                "labelFontSize": 12,
                                "secondaryFontSize": 10,
                                "statusGridOrderByField": "percentUsed"
                            }
                        }
                    }
                }
            },
            {
                "i": "30fd7712-7e1b-4214-93c1-99a8718e95e2",
                "x": 0,
                "y": 6,
                "w": 4,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Per-User Spend (Enterprise Only)",
                    "description": "Spend, target and remaining amount per person for a universal per-user budget",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[budgetUsers]}}",
                        "name": "budgetUsers",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [
                                [
                                    "consumedAmount",
                                    "desc"
                                ]
                            ]
                        }
                    },
                    "scope": {
                        "scope": "{{scopes.[Copilot Budgets]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Copilot Budget]}}"
                    },
                    "variables": [
                        "{{variables.[Copilot Budget]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "login",
                                        "title": "User",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "status[Expanded].rawState",
                                        "title": "Status",
                                        "width": 140,
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "Under budget": "#16a34a",
                                                "Under target": "#16a34a",
                                                "Over 80%": "#d97706",
                                                "Exhausted": "#dc2626",
                                                "No limit": "#64748b",
                                                "No target": "#64748b",
                                                "Unavailable": "#64748b"
                                            }
                                        }
                                    },
                                    {
                                        "field": "percentUsed",
                                        "title": "Used",
                                        "renderer": {
                                            "type": "progress",
                                            "max": 100
                                        }
                                    },
                                    {
                                        "field": "consumedAmount",
                                        "title": "Spent",
                                        "align": "right",
                                        "renderer": {
                                            "type": "number",
                                            "decimals": 2,
                                            "prefix": "$"
                                        }
                                    },
                                    {
                                        "field": "targetAmount",
                                        "title": "Target",
                                        "align": "right",
                                        "renderer": {
                                            "type": "number",
                                            "decimals": 2,
                                            "prefix": "$"
                                        }
                                    },
                                    {
                                        "field": "remainingAmount",
                                        "title": "Remaining",
                                        "align": "right",
                                        "renderer": {
                                            "type": "number",
                                            "decimals": 2,
                                            "prefix": "$"
                                        }
                                    },
                                    {
                                        "field": "hasOverride",
                                        "title": "Override",
                                        "align": "center",
                                        "renderer": {
                                            "type": "boolean",
                                            "trueColor": "#6366f1",
                                            "falseColor": "#64748b"
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableCellPadding": 6,
                                "richTableRowHighlight": {
                                    "field": "status",
                                    "colors": {
                                        "error": "rgba(239,68,68,0.10)",
                                        "warning": "rgba(245,158,11,0.08)"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        ]
    }
}
