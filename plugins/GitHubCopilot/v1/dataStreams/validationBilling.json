{
    "name": "validationBilling",
    "displayName": "Validation - Billing",
    "description": "AI credit usage for the current month, to confirm billing access",
    "tags": ["Billing"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/{{ dataSource.accountType === 'enterprise' ? 'enterprises' : 'organizations' }}/{{ dataSource.slug.trim() }}/settings/billing/ai_credit/usage",
        "pathToData": "timePeriod"
    },
    "matches": "none",
    "metadata": [
        { "name": "year", "displayName": "Year", "shape": "number" },
        { "name": "month", "displayName": "Month", "shape": "number" }
    ],
    "timeframes": false,
    "visibility": { "type": "hidden" }
}
