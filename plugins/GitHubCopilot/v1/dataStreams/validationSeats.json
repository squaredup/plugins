{
    "name": "validationSeats",
    "displayName": "Validation - Seats",
    "description": "First Copilot seat, to confirm seat access",
    "tags": ["Licensing"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/{{ dataSource.accountType === 'enterprise' ? 'enterprises' : 'orgs' }}/{{ dataSource.slug.trim() }}/copilot/billing/seats",
        "getArgs": [{ "key": "per_page", "value": "1" }]
    },
    "matches": "none",
    "metadata": [{ "name": "total_seats", "displayName": "Total seats", "shape": "number" }],
    "timeframes": false,
    "visibility": { "type": "hidden" }
}
