{
    "name": "validationUsageMetrics",
    "displayName": "Validation - Usage Metrics",
    "description": "Latest 28-day usage report window, to confirm usage metrics access",
    "tags": ["Usage"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/{{ dataSource.accountType === 'enterprise' ? 'enterprises' : 'orgs' }}/{{ dataSource.slug.trim() }}/copilot/metrics/reports/{{ dataSource.accountType === 'enterprise' ? 'enterprise' : 'organization' }}-28-day/latest"
    },
    "matches": "none",
    "metadata": [
        { "name": "report_start_day", "displayName": "Report start", "shape": "date" },
        { "name": "report_end_day", "displayName": "Report end", "shape": "date" }
    ],
    "timeframes": false,
    "visibility": { "type": "hidden" }
}
