{
    "name": "currentUser",
    "displayName": "Current User",
    "description": "The GitHub user the personal access token belongs to",
    "tags": ["User"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/user"
    },
    "matches": "none",
    "metadata": [
        { "name": "login", "displayName": "Login", "shape": "string", "role": "label" },
        { "name": "name", "displayName": "Name", "shape": "string" },
        { "name": "html_url", "displayName": "Profile", "shape": ["url", { "label": "{{column.login}}" }] }
    ],
    "timeframes": false,
    "visibility": { "type": "hidden" }
}
