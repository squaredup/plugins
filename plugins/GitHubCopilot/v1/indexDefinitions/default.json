{
    "steps": [
        {
            "name": "users",
            "dataStream": { "name": "seats" },
            "timeframe": "none",
            "objectMapping": {
                "id": "userId",
                "name": "assignee.login",
                "type": { "value": "User" },
                "properties": [
                    { "fullName": "assignee.name" },
                    { "planType": "plan_type" },
                    { "organization": "organization.login" },
                    { "assigningTeam": "assigning_team.name" }
                ]
            }
        },
        {
            "name": "budgets",
            "dataStream": { "name": "budgets" },
            "timeframe": "none",
            "objectMapping": {
                "id": "budgetId",
                "name": "budgetName",
                "type": { "value": "Budget" },
                "properties": ["budgetScope", "budgetEntity", "budgetType", "skus"]
            },
            "optional": true
        },
        {
            "name": "costCenters",
            "dataStream": { "name": "costCenters" },
            "timeframe": "none",
            "objectMapping": {
                "id": "costCenterId",
                "name": "name",
                "type": { "value": "Cost Center" },
                "properties": ["poolEnabled"]
            },
            "optional": true
        }
    ]
}
