{
    "timeframes": false,
    "name": "topTracks",
    "config": {
        "httpMethod": "get",
        "paging": {
            "mode": "nextUrl",
            "pageSize": {
                "realm": "queryArg",
                "path": "limit",
                "value": "50"
            },
            "in": {
                "realm": "payload",
                "path": "next"
            }
        },
        "expandInnerObjects": true,
        "endpointPath": "/me/top/tracks",
        "getArgs": [
            {
                "key": "time_range",
                "value": "{{time_range}}"
            }
        ],
        "postRequestScript": "topTracks.js",
        "headers": []
    },
    "displayName": "Top Tracks",
    "baseDataSourceName": "httpRequestUnscoped",
    "matches": "none",
    "ui": [
        {
            "isMulti": false,
            "data": {
                "source": "fixed",
                "values": [
                    {
                        "value": "short_term",
                        "label": "Short Term (Past 4 Weeks)"
                    },
                    {
                        "value": "medium_term",
                        "label": "Medium Term (Past 6 Months)"
                    },
                    {
                        "value": "long_term",
                        "label": "Long Term (Past Year)"
                    }
                ]
            },
            "name": "time_range",
            "label": "Time Range",
            "title": "Time Range",
            "type": "autocomplete",
            "validation": {
                "required": true
            }
        }
    ]
}