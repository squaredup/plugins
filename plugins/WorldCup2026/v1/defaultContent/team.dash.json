{
    "name": "Team Dashboard",
    "schemaVersion": "1.4",
    "variables": [
        "{{variables.[Team]}}"
    ],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
