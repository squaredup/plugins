{
    "name": "companies",
    "displayName": "Companies",
    "description": "Client company accounts",
    "tags": ["Company", "CRM"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/company/companies",
        "getArgs": [
            { "key": "orderBy", "value": "id asc" }
        ],
        "expandInnerObjects": true,
        "paging": {
            "mode": "nextUrl",
            "pageSize": { "realm": "queryArg", "path": "pageSize", "value": "100" },
            "in": { "realm": "webLink", "path": "next" }
        }
    },
    "matches": "none",
    "metadata": [
        { "name": "id", "displayName": "ID", "shape": "number", "visible": false },
        { "name": "identifier", "displayName": "Identifier", "shape": "string" },
        { "name": "name", "displayName": "Name", "shape": "string", "role": "label" },
        { "name": "status.name", "displayName": "Status", "shape": "string" },
        { "name": "city", "displayName": "City", "shape": "string" },
        { "name": "state", "displayName": "State", "shape": "string" },
        { "name": "country.name", "displayName": "Country", "shape": "string" },
        { "name": "phoneNumber", "displayName": "Phone", "shape": "string" },
        { "name": "website", "displayName": "Website", "shape": "string" },
        { "name": "accountNumber", "displayName": "Account Number", "shape": "string" },
        { "name": "territory.name", "displayName": "Territory", "shape": "string" },
        { "name": "market.name", "displayName": "Market", "shape": "string" },
        { "name": "defaultContact.name", "displayName": "Primary Contact", "shape": "string" },
        { "name": "annualRevenue", "displayName": "Annual Revenue", "shape": "number" },
        { "name": "numberOfEmployees", "displayName": "Employees", "shape": "number" },
        { "name": "site.name", "displayName": "Site", "shape": "string" }
    ],
    "timeframes": false
}
