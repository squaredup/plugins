{
    "name": "members",
    "displayName": "Members",
    "description": "Technicians and staff, one row per member",
    "tags": ["Member", "User"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/system/members",
        "getArgs": [{ "key": "orderBy", "value": "id asc" }],
        "expandInnerObjects": true,
        "paging": {
            "mode": "nextUrl",
            "pageSize": { "realm": "queryArg", "path": "pageSize", "value": "100" },
            "in": { "realm": "webLink", "path": "next" }
        }
    },
    "matches": "none",
    "metadata": [
        { "name": "id", "displayName": "ID", "shape": "number", "visible": false },
        { "name": "identifier", "displayName": "Identifier", "shape": "string" },
        { "name": "firstName", "displayName": "First Name", "shape": "string", "visible": false },
        { "name": "lastName", "displayName": "Last Name", "shape": "string", "visible": false },
        {
            "name": "name",
            "displayName": "Name",
            "shape": "string",
            "role": "label",
            "computed": true,
            "valueExpression": "{{ ($['firstName'] || '') + ' ' + ($['lastName'] || '') }}"
        },
        { "name": "title", "displayName": "Title", "shape": "string" },
        { "name": "officeEmail", "displayName": "Email", "shape": "string" },
        { "name": "type.name", "displayName": "Member Type", "shape": "string" },
        { "name": "securityRole.name", "displayName": "Security Role", "shape": "string" },
        { "name": "inactiveFlag", "displayName": "Inactive", "shape": "boolean" }
    ],
    "timeframes": false
}
