{
    "name": "Project",
    "schemaVersion": "1.5",
    "timeframe": "last30days",
    "variables": ["{{variables.[Project]}}"],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "ec9bfc8a-3f28-486b-9810-84fbe6b4d0ef",
                "x": 0,
                "y": 0,
                "w": 2,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Project Properties",
                    "description": "",
                    "activePluginConfigIds": ["{{configId}}"],
                    "timeframe": "none",
                    "variables": ["{{variables.[Project]}}"],
                    "scope": {
                        "scope": "{{scopes.[Projects]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Project]}}"
                    },
                    "dataStream": {
                        "id": "datastream-properties",
                        "name": "properties"
                    },
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": true,
                                "hiddenColumns": ["id", "links"]
                            }
                        }
                    }
                }
            },
            {
                "i": "5423902d-b786-40e4-a024-3b4d13cc44d7",
                "x": 2,
                "y": 0,
                "w": 2,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Time Logged",
                    "description": "",
                    "activePluginConfigIds": ["{{configId}}"],
                    "variables": ["{{variables.[Project]}}"],
                    "dataStream": {
                        "id": "{{dataStreams.timeEntries}}",
                        "name": "timeEntries",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "project": {
                                "variable": "{{variables.[Project]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Projects]}}"
                            }
                        },
                        "sort": { "by": [["timeStart", "desc"]] }
                    },
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": ["member.name", "actualHours", "billableOption", "notes", "timeStart"],
                                "hiddenColumns": [
                                    "id",
                                    "member.id",
                                    "company.id",
                                    "company.name",
                                    "ticket.summary",
                                    "project.name",
                                    "workType.name",
                                    "hoursBilled",
                                    "hourlyRate",
                                    "timeEnd",
                                    "dateEntered"
                                ]
                            }
                        }
                    }
                }
            },
            {
                "i": "08683d1d-ed24-4029-b463-299da874677d",
                "x": 0,
                "y": 4,
                "w": 2,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Total Hours Logged",
                    "description": "",
                    "activePluginConfigIds": ["{{configId}}"],
                    "variables": ["{{variables.[Project]}}"],
                    "dataStream": {
                        "id": "{{dataStreams.timeEntries}}",
                        "name": "timeEntries",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "project": {
                                "variable": "{{variables.[Project]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Projects]}}"
                            }
                        },
                        "group": { "by": [], "aggregate": [{ "type": "sum", "names": ["actualHours"] }] }
                    },
                    "visualisation": {
                        "type": "data-stream-scalar",
                        "config": {
                            "data-stream-scalar": { "value": "actualHours_sum", "comparisonColumn": "none", "label": "Hours" }
                        }
                    }
                }
            }
        ]
    }
}
