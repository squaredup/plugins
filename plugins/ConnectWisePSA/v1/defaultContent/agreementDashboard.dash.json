                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "agreement": {
                                "variable": "{{variables.[Agreement]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Agreements]}}"
                            }
                        },
                        "sort": { "by": [["timeStart", "desc"]] }
