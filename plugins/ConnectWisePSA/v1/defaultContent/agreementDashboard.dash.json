                                    "id",
                                    "company.id",
                                    "company.name",
                                    "type.name",
                                    "severity",
                                    "impact",
                                    "isInSla",
                                    "slaStatus",
                                    "budgetHours",
                                    "closedDate"
                                ]
                            }
                        }
                    }
                }
            },
