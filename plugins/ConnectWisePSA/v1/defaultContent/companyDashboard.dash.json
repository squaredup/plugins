                            "company": {
                                "variable": "{{variables.[Company]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Companies]}}"
                            }
                        },
                        "group": {
                            "by": [["closedFlag", "uniqueValues"]],
                            "aggregate": [{ "type": "count" }]
                        }
                    },
                    "visualisation": {
                        "type": "data-stream-donut-chart",
                        "config": {
                            "data-stream-donut-chart": {
                                "valueColumn": "count",
                                "labelColumn": "closedFlag_uniqueValues",
                                "hideCenterValue": false,
                                "showValuesAsPercentage": false,
                                "legendPosition": "auto",
                                "legendMode": "table"
                            }
                        }
                    }
                }
            },
