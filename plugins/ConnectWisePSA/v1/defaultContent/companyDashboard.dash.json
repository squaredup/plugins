                    "title": "Open vs Closed Tickets",
                    "description": "",
                    "activePluginConfigIds": ["{{configId}}"],
                    "timeframe": "none",
                    "variables": ["{{variables.[Company]}}"],
                    "dataStream": {
                        "id": "{{dataStreams.tickets}}",
