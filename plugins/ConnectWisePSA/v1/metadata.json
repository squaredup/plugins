{
    "name": "connectwise-psa",
    "displayName": "ConnectWise PSA",
    "version": "1.0.0",
    "author": {
        "name": "Dan Watts",
        "type": "community"
    },
    "description": "Monitor tickets, agreements, configurations, projects, time tracking, and company data from ConnectWise PSA (ConnectWise Manage).",
    "category": "Service Management",
    "type": "hybrid",
    "schemaVersion": "2.1",
    "objectTypes": [
        "ConnectWise Company",
        "ConnectWise Agreement",
        "ConnectWise Configuration",
        "ConnectWise Project",
        "ConnectWise Member"
    ],
    "keywords": ["connectwise", "psa", "manage", "tickets", "itsm", "agreements", "contracts", "projects", "msp", "time tracking"],
    "links": [
        {
            "category": "documentation",
            "url": "https://github.com/squaredup/plugins/blob/main/plugins/ConnectWisePSA/v1/docs/README.md",
            "label": "Help adding this plugin"
        },
        {
            "category": "source",
            "url": "https://github.com/squaredup/plugins/tree/main/plugins/ConnectWisePSA",
            "label": "Repository"
        }
    ],
    "base": {
        "plugin": "WebAPI",
        "majorVersion": "1",
        "config": {
            "baseUrl": "https://{{siteUrl}}/v4_6_release/apis/3.0",
            "authMode": "basic",
            "basicAuthUsername": "{{companyId + '+' + publicKey}}",
            "basicAuthPassword": "{{privateKey}}",
            "headers": [
                { "key": "clientId", "value": "49080845-83b0-4961-a4bc-afd3598db314" },
                { "key": "Content-Type", "value": "application/json" }
            ]
        }
    }
}
