{
    "steps": [
        {
            "name": "Companies",
            "dataStream": { "name": "companies" },
            "timeframe": "none",
            "objectMapping": {
                "id": "id",
                "name": "name",
                "type": { "value": "ConnectWise Company" },
                "properties": [
                    "identifier",
                    { "status": "status.name" },
                    "city",
                    { "stateProvince": "state" },
                    { "country": "country.name" },
                    "phoneNumber",
                    "website",
                    "accountNumber",
                    "annualRevenue",
                    "numberOfEmployees"
                ]
            }
        },
        {
            "name": "Agreements",
            "dataStream": { "name": "agreements" },
            "timeframe": "none",
            "objectMapping": {
                "id": "id",
                "name": "name",
                "type": { "value": "ConnectWise Agreement" },
                "properties": [
                    { "type": "type.name" },
                    { "companyId": "company.id" },
                    { "company": "company.name" },
                    "agreementStatus",
                    "startDate",
                    "endDate",
                    "noEndingDateFlag",
                    "cancelledFlag",
                    { "billingCycle": "billingCycle.name" }
                ]
            }
        },
        {
            "name": "Configurations",
            "dataStream": { "name": "configurations" },
            "timeframe": "none",
            "objectMapping": {
                "id": "id",
                "name": "name",
                "type": { "value": "ConnectWise Configuration" },
                "properties": [
                    { "type": "type.name" },
