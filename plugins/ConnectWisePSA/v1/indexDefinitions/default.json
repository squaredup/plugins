                    { "status": "status.name" },
                    { "companyId": "company.id" },
                    { "company": "company.name" },
                    { "manager": "manager.name" },
                    "closedFlag"
                ]
            }
        },
        {
            "name": "Members",
            "dataStream": { "name": "members" },
            "timeframe": "none",
            "objectMapping": {
                "id": "id",
