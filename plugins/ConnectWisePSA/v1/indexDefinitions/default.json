                    { "companyId": "company.id" },
                    { "company": "company.name" },
                    "deviceIdentifier",
                    "serialNumber",
                    "ipAddress",
                    "osType",
                    "activeFlag"
                ]
            }
        },
        {
            "name": "Projects",
            "dataStream": { "name": "projects" },
            "timeframe": "none",
            "objectMapping": {
                "id": "id",
                "name": "name",
