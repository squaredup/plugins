        {
            "name": "NodeLink",
            "displayName": "Node",
            "shape": "string",
            "sourceId": "NodeLinkId",
            "sourceType": "Kubernetes Node"
        },
        {
            "name": "NodeLinkId",
            "displayName": "Node ID",
            "shape": "string",
