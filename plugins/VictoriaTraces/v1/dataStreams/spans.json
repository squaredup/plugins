        {
            "name": "OperationLink",
            "displayName": "Operation",
            "shape": "string",
            "sourceId": "OperationLinkId",
            "sourceType": "Service Operation"
        },
        {
            "name": "OperationLinkId",
            "displayName": "Operation ID",
            "shape": "string",
            "visible": false
