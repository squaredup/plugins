        {
            "name": "DaemonSetLink",
            "displayName": "DaemonSet",
            "shape": "string",
            "sourceId": "DaemonSetLinkId",
            "sourceType": "Kubernetes DaemonSet"
        },
        {
            "name": "DaemonSetLinkId",
            "displayName": "DaemonSet ID",
            "shape": "string",
            "visible": false
        },
        {
            "name": "ReplicaSetLink",
            "displayName": "ReplicaSet",
            "shape": "string",
            "sourceId": "ReplicaSetLinkId",
            "sourceType": "Kubernetes ReplicaSet"
        },
        {
            "name": "ReplicaSetLinkId",
            "displayName": "ReplicaSet ID",
            "shape": "string",
            "visible": false
        },
        {
            "name": "KubeJobLink",
            "displayName": "Job",
            "shape": "string",
            "sourceId": "KubeJobLinkId",
            "sourceType": "Kubernetes Job"
        },
        {
            "name": "KubeJobLinkId",
            "displayName": "Job ID",
            "shape": "string",
            "visible": false
        },
        {
            "name": "KubeCronJobLink",
            "displayName": "CronJob",
            "shape": "string",
            "sourceId": "KubeCronJobLinkId",
            "sourceType": "Kubernetes CronJob"
        },
        {
            "name": "KubeCronJobLinkId",
            "displayName": "CronJob ID",
            "shape": "string",
            "visible": false
        },
        {
            "name": "NamespaceLink",
            "displayName": "Namespace",
            "shape": "string",
            "sourceId": "NamespaceLinkId",
            "sourceType": "Kubernetes Namespace"
        },
        {
            "name": "NamespaceLinkId",
            "displayName": "Namespace ID",
            "shape": "string",
            "visible": false
