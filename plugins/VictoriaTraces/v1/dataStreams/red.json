{
    "name": "red",
    "displayName": "RED Metrics",
    "description": "Request rate, error rate and latency percentiles calculated from spans, per service, per operation or overall",
    "tags": [
        "APM",
        "RED",
        "Latency"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "{{queryType === 'instant' ? 'select/logsql/stats_query' : 'select/logsql/stats_query_range'}}",
        "getArgs": [
            {
                "key": "query",
                "value": "{{(kind === 'client' ? 'kind:=3' : kind === 'all' ? '*' : 'kind:in(2, 5)') + (filter ? ' (' + filter + ')' : '') + ' | stats ' + (groupBy === 'none' ? '' : groupBy === 'operation' ? 'by (\"resource_attr:service.name\", name) ' : 'by (\"resource_attr:service.name\") ') + 'count() calls, count() if (status_code:=2) errors, quantile(0.5, duration) p50, quantile(0.95, duration) p95, quantile(0.99, duration) p99'}}"
            },
            {
                "key": "start",
                "value": "{{timeframe.unixStart}}"
            },
            {
                "key": "end",
                "value": "{{Math.min(timeframe.unixEnd, Math.floor(Date.now() / 1000))}}"
            },
            {
                "key": "time",
                "value": "{{queryType === 'instant' ? Math.min(timeframe.unixEnd, Math.floor(Date.now() / 1000)) : null}}"
            },
            {
                "key": "step",
                "value": "{{queryType === 'instant' ? null : (step || Math.max(60, Math.ceil((timeframe.unixEnd - timeframe.unixStart) / 120)) + 's')}}"
            },
            {
                "key": "extra_filters",
                "value": "{{Array.isArray(scope) && scope.length ? ((scope.flatMap(o => [].concat(o.selector || [])).filter(s => typeof s === 'string' && s.trim().startsWith('(') && s.includes('resource_attr:'))).join(' or ') || '\"__squaredup_no_match__\":=\"1\"') : null}}"
            },
            {
                "key": "disable_latency_offset",
                "value": "true"
            }
        ],
        "postRequestScript": "red.js",
        "paging": {
            "mode": "none"
        }
    },
    "ui": [
        {
            "type": "switch",
            "name": "groupBy",
            "label": "Group by",
            "defaultValue": "service",
            "options": [
                {
                    "value": "service",
                    "label": "Service"
                },
                {
                    "value": "operation",
                    "label": "Operation"
                },
                {
                    "value": "none",
                    "label": "None"
                }
            ]
        },
        {
            "type": "switch",
            "name": "kind",
            "label": "Spans",
            "defaultValue": "server",
            "options": [
                {
                    "value": "server",
                    "label": "Incoming (server and consumer)"
                },
                {
                    "value": "client",
                    "label": "Outgoing (client)"
                },
                {
                    "value": "all",
                    "label": "All"
                }
            ],
            "help": "Which spans to measure. **Incoming** measures the requests a service handles; **Outgoing** measures the calls it makes."
        },
        {
            "type": "switch",
            "name": "queryType",
            "label": "Query type",
            "defaultValue": "range",
            "options": [
                {
                    "value": "range",
                    "label": "Range (time series)"
                },
                {
                    "value": "instant",
                    "label": "Instant (totals for the timeframe)"
                }
            ]
        },
        {
            "type": "objects",
            "name": "scope",
            "label": "Objects (optional)",
            "help": "Only include spans from the selected objects. Leave empty to include all spans.",
            "matches": {
                "sourceName": {
                    "type": "equals",
                    "value": "VictoriaTraces"
                },
                "selector": {
                    "type": "any"
                }
            }
        },
        {
            "type": "text",
            "name": "filter",
            "label": "Filter (optional)",
            "placeholder": "e.g. \"span_attr:http.route\":=\"/api/cart\"",
            "help": "An extra LogsQL filter applied to the spans before measuring."
        },
        {
            "type": "text",
            "name": "step",
            "label": "Step (optional)",
            "placeholder": "e.g. 5m",
            "help": "Bucket size of range queries. Defaults to about 120 buckets across the timeframe.",
            "validation": {
                "pattern": {
                    "value": "^(\\d+(\\.\\d+)?(ms|s|m|h|d|w|y))+$",
                    "message": "Use a duration such as 30s, 5m, 1.5h or 1h30m"
                }
            }
        }
    ],
    "manualConfigApply": true,
    "matches": "none",
    "metadata": [
        {
            "name": "timestamp",
            "displayName": "Timestamp",
            "shape": "date",
            "role": "timestamp"
        },
        {
            "name": "series",
            "displayName": "Series",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "service",
            "displayName": "Service name",
            "shape": "string"
        },
        {
            "name": "operation",
            "displayName": "Operation name",
            "shape": "string"
        },
        {
            "name": "callsPerSecond",
            "displayName": "Requests/sec",
            "shape": [
                "number",
                {
                    "decimalPlaces": 2
                }
            ],
            "role": "value"
        },
        {
            "name": "calls",
            "displayName": "Requests",
            "shape": "number"
        },
        {
            "name": "errors",
            "displayName": "Errors",
            "shape": "number"
        },
        {
            "name": "errorPercent",
            "displayName": "Error rate",
            "shape": [
                "percent",
                {
                    "decimalPlaces": 2
                }
            ]
        },
        {
            "name": "p50",
            "displayName": "p50 latency",
            "shape": [
                "milliseconds",
                {
                    "decimalPlaces": 1
                }
            ]
        },
        {
            "name": "p95",
            "displayName": "p95 latency",
            "shape": [
                "milliseconds",
                {
                    "decimalPlaces": 1
                }
            ]
        },
        {
            "name": "p99",
            "displayName": "p99 latency",
            "shape": [
                "milliseconds",
                {
                    "decimalPlaces": 1
                }
            ]
        },
        {
