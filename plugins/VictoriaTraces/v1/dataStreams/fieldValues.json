{
    "name": "fieldValues",
    "displayName": "Field Values",
    "description": "The most common values of a span field in matching spans, with the number of spans for each",
    "tags": [
        "Metadata"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "select/logsql/stats_query",
        "getArgs": [
            {
                "key": "query",
                "value": "{{'(' + (query || '*') + ') | stats by (' + JSON.stringify(String(field || '').trim()) + ') count() hits | sort by (hits desc) | limit ' + Math.max(1, Math.min(Math.round(Number(limit)) || 100, 1000))}}"
            },
            {
                "key": "start",
                "value": "{{timeframe.unixStart}}"
            },
            {
                "key": "end",
                "value": "{{Math.min(timeframe.unixEnd, Math.floor(Date.now() / 1000))}}"
            },
            {
                "key": "time",
                "value": "{{Math.min(timeframe.unixEnd, Math.floor(Date.now() / 1000))}}"
            },
            {
                "key": "extra_filters",
                "value": "{{Array.isArray(scope) && scope.length ? scope.map(o => [].concat(o.selector || [])[0]).filter(s => s).join(' or ') || null : null}}"
            },
            {
                "key": "disable_latency_offset",
                "value": "true"
            }
        ],
        "postRequestScript": "fieldValues.js",
        "paging": {
            "mode": "none"
        }
    },
    "ui": [
        {
            "type": "text",
            "name": "query",
            "label": "Query (optional)",
            "placeholder": "*",
            "help": "LogsQL filter selecting the spans to inspect."
        },
        {
            "type": "text",
            "name": "field",
            "label": "Field",
            "help": "Field name, e.g. `resource_attr:service.name` or `span_attr:http.route`.",
            "validation": {
                "required": true
            }
        },
        {
            "type": "number",
            "name": "limit",
            "label": "Limit (optional)",
            "help": "Number of values to return, most common first (up to 1,000).",
            "defaultValue": 100,
            "validation": {
                "min": 1,
                "max": 1000
            }
        },
        {
            "type": "objects",
            "name": "scope",
            "label": "Objects (optional)",
            "help": "Only include spans from the selected objects. Leave empty to include all spans.",
            "matches": {
                "sourceType": {
                    "type": "oneOf",
                    "values": [
                        "Service",
                        "Service Operation",
                        "Kubernetes Cluster",
                        "Kubernetes Node",
                        "Kubernetes Namespace",
                        "Kubernetes Pod",
                        "Kubernetes Deployment",
                        "Kubernetes StatefulSet",
                        "Kubernetes DaemonSet",
                        "Kubernetes ReplicaSet",
                        "Kubernetes Job",
                        "Kubernetes CronJob",
                        "Host",
                        "Deployment Environment"
                    ]
                }
            }
        }
    ],
    "manualConfigApply": true,
    "matches": "none",
    "metadata": [
        {
            "name": "label",
            "displayName": "Value",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "value",
            "displayName": "Value (raw)",
            "shape": "string",
            "role": "value",
            "visible": false
        },
        {
            "name": "hits",
            "displayName": "Spans",
            "shape": "number"
        }
    ],
    "timeframes": true,
    "visibility": {
        "type": "hidden"
    }
}
