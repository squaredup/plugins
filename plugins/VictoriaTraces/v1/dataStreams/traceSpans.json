{
    "name": "traceSpans",
    "displayName": "Trace Spans",
    "description": "Spans of one trace in start order with their offset from the start of the trace, up to the first 500 spans",
    "tags": [
        "Traces",
        "Spans"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "select/logsql/query",
        "getArgs": [
            {
                "key": "query",
                "value": "{{'trace_id:=' + JSON.stringify(String(traceId || '').trim()) + ' span_id:* | sort by (start_time_unix_nano) | limit 500'}}"
            },
            {
                "key": "start",
                "value": "{{timeframe.unixStart}}"
            },
            {
                "key": "end",
                "value": "{{Math.min(timeframe.unixEnd, Math.floor(Date.now() / 1000))}}"
            },
            {
                "key": "disable_latency_offset",
                "value": "true"
            }
        ],
        "postRequestScript": "spans.js",
        "paging": {
            "mode": "none"
        }
    },
    "ui": [
        {
            "type": "text",
            "name": "traceId",
            "label": "Trace ID",
            "validation": {
                "required": true
            },
            "help": "The trace to show. The tile's timeframe must include the trace."
        }
    ],
    "manualConfigApply": true,
    "matches": "none",
    "metadata": [
        {
            "name": "timestamp",
            "displayName": "Start",
            "shape": "date",
            "role": "timestamp"
        },
        {
            "name": "offsetMs",
            "displayName": "Offset",
            "shape": [
                "milliseconds",
                {
                    "decimalPlaces": 2
                }
            ]
        },
        {
            "name": "service",
            "displayName": "Service name",
            "shape": "string"
        },
        {
            "name": "operation",
            "displayName": "Operation",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "kind",
            "displayName": "Kind",
            "shape": "string"
        },
        {
            "name": "durationMs",
            "displayName": "Duration",
            "shape": [
                "milliseconds",
                {
                    "decimalPlaces": 2
                }
            ],
            "role": "value"
        },
        {
            "name": "status",
            "displayName": "Status",
            "shape": [
                "state",
                {
                    "map": {
                        "success": [
                            "ok",
                            "unset"
                        ],
                        "error": [
                            "error"
                        ]
                    }
                }
            ]
        },
        {
            "name": "statusMessage",
            "displayName": "Status message",
            "shape": "string"
        },
        {
            "name": "traceId",
            "displayName": "Trace ID",
            "shape": "string"
        },
