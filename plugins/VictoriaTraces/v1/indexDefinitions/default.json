{
    "frequencyMinutes": 60,
    "steps": [
        {
            "name": "services",
            "dataStream": {
                "name": "labelSets",
                "config": {
                    "pack": "indexServices",
                    "labels": "resource_attr:service.name",
                    "keys": "serviceName",
                    "required": "resource_attr:service.name",
                    "nameKey": "serviceName",
                    "extraLabels": "resource_attr:service.namespace",
                    "extraKeys": "serviceNamespace"
                }
            },
            "timeframe": "none",
            "objectMapping": {
                "id": "id",
                "name": "name",
                "type": {
                    "value": "Service"
                },
                "properties": [
                    "serviceName",
                    "serviceNamespace",
                    "selector"
                ]
            },
            "optional": true
        },
        {
            "name": "operations",
            "dataStream": {
                "name": "labelSets",
                "config": {
                    "pack": "indexOperations",
                    "labels": "resource_attr:service.name,name",
                    "keys": "service,operation",
                    "required": "resource_attr:service.name,name",
                    "nameKey": "service,operation",
                    "match": "kind:in(2, 5) \"resource_attr:service.name\":* name:*"
                }
            },
            "timeframe": "none",
            "objectMapping": {
                "id": "id",
                "name": "name",
                "type": {
                    "value": "Service Operation"
                },
                "properties": [
                    "service",
                    "operation",
                    "selector"
                ]
            },
            "optional": true
        },
