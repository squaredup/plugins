{
    "name": "victoriatraces",
    "displayName": "VictoriaTraces",
    "version": "1.0.0",
    "author": {
        "name": "SquaredUp Labs",
        "type": "labs"
    },
    "description": "Analyse distributed traces in VictoriaTraces: RED metrics, slow and failing traces, spans and the service map, computed directly from spans with LogsQL.",
    "category": "Monitoring",
    "type": "hybrid",
    "schemaVersion": "2.1",
    "importNotSupported": false,
    "restrictedToPlatforms": [],
    "keywords": [
        "victoriatraces",
        "victoriametrics",
        "traces",
        "tracing",
        "distributed tracing",
        "spans",
        "apm",
        "red metrics",
        "service map",
        "opentelemetry",
        "otel",
        "jaeger",
        "logsql",
        "kubernetes"
    ],
    "objectTypes": [
        "Service",
        "Service Operation",
        "Service Dependency",
        "Kubernetes Cluster",
        "Kubernetes Node",
        "Kubernetes Namespace",
        "Kubernetes Pod",
        "Kubernetes Deployment",
        "Kubernetes StatefulSet",
        "Kubernetes DaemonSet",
        "Kubernetes ReplicaSet",
        "Kubernetes Job",
        "Kubernetes CronJob",
        "Host",
        "Deployment Environment"
    ],
    "links": [
        {
            "category": "documentation",
            "url": "https://github.com/squaredup/plugins/blob/main/plugins/VictoriaTraces/v1/docs/README.md",
            "label": "Help adding this plugin"
        },
        {
            "category": "source",
            "url": "https://github.com/squaredup/plugins/tree/main/plugins/VictoriaTraces",
            "label": "Repository"
        }
    ],
    "base": {
        "plugin": "WebAPI",
        "majorVersion": "1",
        "config": {
            "baseUrl": "{{url}}",
            "authMode": "{{authType === 'basic' ? 'basic' : 'none'}}",
            "basicAuthUsername": "{{authType === 'basic' ? username : null}}",
            "basicAuthPassword": "{{authType === 'basic' ? password : null}}",
            "ignoreCertificateErrors": "{{typeof ignoreCertificateErrors !== 'undefined' && ignoreCertificateErrors === true}}",
            "headers": [
                {
                    "key": "Authorization",
                    "value": "{{authType === 'token' ? 'Bearer ' + apiToken : null}}"
                },
                {
                    "key": "AccountID",
                    "value": "{{typeof accountId !== 'undefined' && accountId !== null && String(accountId).trim() !== '' ? String(accountId).trim() : null}}"
                },
                {
                    "key": "ProjectID",
                    "value": "{{typeof projectId !== 'undefined' && projectId !== null && String(projectId).trim() !== '' ? String(projectId).trim() : null}}"
                }
            ],
            "queryArgs": []
        }
    }
}
