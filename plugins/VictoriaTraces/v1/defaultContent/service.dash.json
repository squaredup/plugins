                                        "renderer": {
                                            "type": "status",
                                            "showLabel": false
                                        },
                                        "width": 60,
                                        "align": "center"
                                    },
                                    {
                                        "field": "traceId",
                                        "title": "Trace ID",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableSort": {
                                    "field": "durationMs",
                                    "direction": "desc"
                                }
                            }
                        }
                    }
                }
            },
