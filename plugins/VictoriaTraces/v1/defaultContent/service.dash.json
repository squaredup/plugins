                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "start",
                                        "title": "Start",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        },
                                        "width": 110
                                    },
                                    {
                                        "field": "ServiceLink",
                                        "title": "Root service",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "rootOperation",
                                        "title": "Root operation",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "durationMs",
                                        "title": "Duration",
                                        "renderer": {
                                            "type": "bar",
                                            "thresholds": [
                                                {
                                                    "to": 250,
                                                    "color": "#2bb660"
                                                },
                                                {
                                                    "to": 1000,
                                                    "color": "#ffaa00"
                                                },
                                                {
                                                    "to": 1000000000000.0,
                                                    "color": "#f2164d"
                                                }
                                            ]
                                        }
                                    },
                                    {
                                        "field": "spans",
                                        "title": "Spans",
                                        "renderer": {
                                            "type": "number",
                                            "decimals": 0
                                        },
                                        "align": "right",
                                        "width": 70
                                    },
                                    {
                                        "field": "errors",
                                        "title": "Errors",
                                        "renderer": {
                                            "type": "number",
                                            "decimals": 0,
                                            "thresholds": [
                                                {
                                                    "to": 0,
                                                    "color": "#2bb660"
                                                },
                                                {
                                                    "to": 1000000000.0,
                                                    "color": "#f2164d"
                                                }
                                            ]
                                        },
                                        "align": "right",
                                        "width": 70
                                    },
