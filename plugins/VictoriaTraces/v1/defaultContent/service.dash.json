                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "PodLink",
                                        "title": "Pod",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "traceId",
                                        "title": "Trace ID",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableSort": {
                                    "field": "timestamp",
                                    "direction": "desc"
                                },
                                "detailsPanel": true,
                                "richTableWrapText": true
                            }
                        }
                    }
                }
