                                "columns": [
                                    {
                                        "field": "timestamp",
                                        "title": "Time",
                                        "renderer": {
                                            "type": "date",
                                            "showMilliseconds": true
                                        },
                                        "width": 170
                                    },
                                    {
                                        "field": "service",
                                        "title": "Service",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "OperationLink",
