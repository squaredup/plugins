                    "dataStream": {
                        "id": "{{dataStreams.[traces]}}",
                        "name": "traces",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "filter": "kind:=2 duration:<60000000000",
                            "sort": "slowest",
                            "limit": 20,
                            "scope": {
                                "variable": "{{variables.[Service]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Services]}}"
                            }
                        }
