{
    "name": "Pod Traces",
    "schemaVersion": "1.5",
    "timeframe": "last1hour",
    "variables": [
        "{{variables.[Kubernetes Pod]}}"
    ],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "d78d52ce-aa00-4b42-bd2a-70e510a7babd",
                "x": 0,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Requests / sec",
                    "description": "Incoming server and consumer spans per second",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[red]}}",
                        "name": "red",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "groupBy": "none",
                            "kind": "server",
                            "queryType": "instant",
                            "scope": {
                                "variable": "{{variables.[Kubernetes Pod]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Kubernetes Pods]}}"
                            }
                        }
                    },
                    "variables": [
                        "{{variables.[Kubernetes Pod]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    {
                                        "field": "callsPerSecond",
                                        "type": "quantitative"
                                    }
                                ]
                            },
                            "style": {
                                "scalarLabelPosition": "none"
                            }
                        }
                    }
                }
            },
            {
                "i": "7a23e942-2c0a-473d-8c2c-2d0efcd36ebe",
                "x": 1,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Error Rate",
                    "description": "Share of incoming spans with an error status",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[red]}}",
                        "name": "red",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "groupBy": "none",
                            "kind": "server",
                            "queryType": "instant",
                            "scope": {
                                "variable": "{{variables.[Kubernetes Pod]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Kubernetes Pods]}}"
                            }
                        }
                    },
                    "variables": [
                        "{{variables.[Kubernetes Pod]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    {
                                        "field": "errorPercent",
                                        "type": "quantitative"
                                    }
                                ]
                            },
                            "style": {
                                "scalarLabelPosition": "none"
                            }
                        }
                    }
                }
            },
            {
                "i": "c3506703-7add-4ea3-aa01-91ab14a06ced",
                "x": 2,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "p95 Latency",
                    "description": "",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[red]}}",
                        "name": "red",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "groupBy": "none",
                            "kind": "server",
                            "queryType": "instant",
                            "scope": {
                                "variable": "{{variables.[Kubernetes Pod]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Kubernetes Pods]}}"
                            }
                        }
                    },
                    "variables": [
                        "{{variables.[Kubernetes Pod]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    {
                                        "field": "p95",
                                        "type": "quantitative"
                                    }
                                ]
                            },
                            "style": {
                                "scalarLabelPosition": "none"
                            }
                        }
                    }
                }
            },
            {
                "i": "9b3b30de-f70d-4e43-ad3d-23f37bf6e667",
                "x": 3,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Spans",
                    "description": "All spans recorded by the pod",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[stats]}}",
                        "name": "stats",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "query": "* | stats count() spans",
                            "queryType": "instant",
                            "scope": {
                                "variable": "{{variables.[Kubernetes Pod]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Kubernetes Pods]}}"
                            }
                        }
                    },
                    "variables": [
                        "{{variables.[Kubernetes Pod]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    {
                                        "field": "value",
                                        "type": "quantitative"
                                    }
                                ]
                            },
                            "style": {
                                "scalarLabelPosition": "none"
                            }
                        }
                    }
                }
            },
            {
                "i": "8e1c2b6f-caf0-4de1-94e7-0e4b69e858d3",
                "x": 0,
                "y": 2,
                "w": 4,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Services on this Pod",
                    "description": "RED metrics for each service running in the pod",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[red]}}",
                        "name": "red",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "groupBy": "service",
                            "kind": "server",
                            "queryType": "instant",
                            "scope": {
                                "variable": "{{variables.[Kubernetes Pod]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Kubernetes Pods]}}"
                            }
                        }
                    },
                    "variables": [
                        "{{variables.[Kubernetes Pod]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "ServiceLink",
                                        "title": "Service",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "callsPerSecond",
                                        "title": "Requests / sec",
                                        "renderer": {
                                            "type": "bar",
                                            "color": "#3EB5FF"
                                        }
                                    },
                                    {
                                        "field": "errorPercent",
                                        "title": "Error %",
                                        "renderer": {
                                            "type": "bar",
                                            "thresholds": [
                                                {
                                                    "to": 1,
                                                    "color": "#2bb660"
                                                },
                                                {
                                                    "to": 5,
                                                    "color": "#ffaa00"
                                                },
                                                {
                                                    "to": 100,
                                                    "color": "#f2164d"
                                                }
                                            ]
                                        }
                                    },
                                    {
                                        "field": "p50",
                                        "title": "p50",
                                        "renderer": {
                                            "type": "text"
                                        },
                                        "align": "right"
                                    },
                                    {
                                        "field": "p95",
                                        "title": "p95",
                                        "renderer": {
                                            "type": "bar",
                                            "thresholds": [
                                                {
                                                    "to": 250,
                                                    "color": "#2bb660"
                                                },
                                                {
                                                    "to": 1000,
                                                    "color": "#ffaa00"
                                                },
                                                {
                                                    "to": 1000000000000.0,
                                                    "color": "#f2164d"
                                                }
                                            ]
                                        }
                                    },
                                    {
                                        "field": "p99",
                                        "title": "p99",
                                        "renderer": {
                                            "type": "text"
                                        },
                                        "align": "right"
                                    }
                                ]
                            },
                            "style": {
                                "richTableSort": {
                                    "field": "callsPerSecond",
                                    "direction": "desc"
                                }
                            }
                        }
                    }
                }
            },
            {
                "i": "aca570b5-d4cf-4619-8d16-b38d282ae814",
                "x": 0,
                "y": 5,
                "w": 2,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Requests and Error Rate",
                    "description": "",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[red]}}",
                        "name": "red",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "groupBy": "none",
                            "kind": "server",
                            "queryType": "range",
                            "scope": {
                                "variable": "{{variables.[Kubernetes Pod]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Kubernetes Pods]}}"
                            }
                        }
                    },
                    "variables": [
                        "{{variables.[Kubernetes Pod]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "line",
                            "encoding": {
                                "x": {
                                    "field": "timestamp",
                                    "type": "temporal"
                                },
                                "y": {
                                    "field": "callsPerSecond",
                                    "type": "quantitative",
                                    "title": "Requests / sec"
                                }
                            },
                            "style": {
                                "cartesianY2AxisField": "errorPercent",
                                "cartesianY2AxisTitle": "Error %",
                                "cartesianY2AxisMin": 0,
                                "cartesianShowYAxisTitle": true,
                                "cartesianYAxisTitle": "Requests / sec",
                                "legendPosition": "bottom",
                                "mappedColors": {
                                    "callsPerSecond": "#3EB5FF",
                                    "errorPercent": "#f2164d"
                                }
                            }
                        }
                    }
                }
            },
            {
                "i": "874f0311-c7a6-4921-ab5c-3ae5efe58ddb",
                "x": 2,
                "y": 5,
                "w": 2,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Latency",
                    "description": "",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[red]}}",
                        "name": "red",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "groupBy": "none",
                            "kind": "server",
                            "queryType": "range",
                            "scope": {
                                "variable": "{{variables.[Kubernetes Pod]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Kubernetes Pods]}}"
                            }
                        }
                    },
                    "variables": [
                        "{{variables.[Kubernetes Pod]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "line",
                            "encoding": {
                                "x": {
                                    "field": "timestamp",
                                    "type": "temporal"
                                },
                                "y": [
                                    {
                                        "field": "p50",
                                        "type": "quantitative",
                                        "title": "p50"
                                    },
                                    {
                                        "field": "p95",
                                        "type": "quantitative",
                                        "title": "p95"
                                    },
                                    {
                                        "field": "p99",
                                        "type": "quantitative",
                                        "title": "p99"
                                    }
                                ]
                            },
                            "style": {
                                "legendPosition": "bottom",
                                "cartesianShowYAxisTitle": true,
                                "cartesianYAxisTitle": "Latency",
                                "mappedColors": {
                                    "p50": "#2bb660",
                                    "p95": "#ffaa00",
                                    "p99": "#f2164d"
                                }
                            }
                        }
                    }
                }
            },
            {
                "i": "2932bc78-e092-4046-a52f-146fd8902314",
                "x": 0,
                "y": 8,
                "w": 4,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Recent Error Spans",
                    "description": "The latest 100 requests the pod answered with an error",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[spans]}}",
                        "name": "spans",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "query": "kind:in(2, 5) status_code:=2",
                            "limit": 100,
                            "scope": {
                                "variable": "{{variables.[Kubernetes Pod]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Kubernetes Pods]}}"
                            }
                        }
                    },
                    "variables": [
                        "{{variables.[Kubernetes Pod]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "timestamp",
                                        "title": "Time",
                                        "renderer": {
                                            "type": "date",
                                            "showMilliseconds": true
                                        },
                                        "width": 170
                                    },
                                    {
                                        "field": "service",
                                        "title": "Service",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "OperationLink",
                                        "title": "Operation",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "durationMs",
                                        "title": "Duration",
                                        "renderer": {
                                            "type": "text"
                                        },
                                        "align": "right"
                                    },
                                    {
                                        "field": "statusMessage",
                                        "title": "Status message",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "PodLink",
                                        "title": "Pod",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "traceId",
                                        "title": "Trace ID",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableSort": {
                                    "field": "timestamp",
                                    "direction": "desc"
                                },
                                "detailsPanel": true,
                                "richTableWrapText": true
                            }
                        }
                    }
                }
            }
        ]
    }
}
