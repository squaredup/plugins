                                    "type": "nominal"
                                }
                            },
                            "style": {
                                "sparklineValue": "average",
                                "sparklineSortBy": "value",
                                "sparklineSortDirection": "desc",
                                "sparklineLimit": 8,
                                "sparklineScale": "shared"
                            }
                        }
                    }
