                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "ServiceLink",
                                        "title": "Service",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "callsPerSecond",
