                "config": {
                    "_type": "tile/data-stream",
                    "title": "Latency",
                    "description": "p50, p95 and p99 latency",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[red]}}",
                        "name": "red",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "groupBy": "none",
                            "kind": "server",
                            "queryType": "range",
                            "scope": {
                                "variable": "{{variables.[Service Operation]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Service Operations]}}"
                            }
                        }
                    },
                    "variables": [
                        "{{variables.[Service Operation]}}"
                    ],
