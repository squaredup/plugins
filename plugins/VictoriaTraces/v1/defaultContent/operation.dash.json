            {
                "i": "14b2cfb9-5314-411a-8bd6-8a6dc73afd68",
                "x": 0,
                "y": 5,
                "w": 2,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Latency Distribution",
                    "description": "Requests in power-of-two duration buckets over the timeframe",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[stats]}}",
                        "name": "stats",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "query": "kind:in(2, 5) | math round(exp(ceil(ln(max(duration, 1000) / 1000000) / 0.6931471805599453) * 0.6931471805599453), 0.001) as le_ms | stats by (le_ms) count() spans | sort by (le_ms) | format \"≤ <le_ms> ms\" as bucket",
                            "queryType": "instant",
                            "scope": {
                                "variable": "{{variables.[Service Operation]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Service Operations]}}"
                            }
                        }
                    },
                    "variables": [
                        "{{variables.[Service Operation]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "bucket",
                                    "type": "ordinal",
                                    "title": "Duration"
                                },
                                "y": {
                                    "field": "value",
                                    "type": "quantitative",
                                    "title": "Spans"
                                }
                            },
                            "style": {
                                "legendPosition": "none",
                                "cartesianShowYAxisTitle": true,
                                "cartesianYAxisTitle": "Spans",
                                "cartesianXAxisLabelRotation": 45,
                                "colors": [
                                    "#3EB5FF"
                                ]
                            }
                        }
                    }
                }
            },
            {
                "i": "27178d2b-65af-4117-80b1-ed96235df016",
                "x": 2,
                "y": 5,
                "w": 2,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Slowest Traces",
                    "description": "The 20 slowest traces through this operation",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[traces]}}",
                        "name": "traces",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "filter": "kind:=2 duration:<60000000000",
                            "sort": "slowest",
                            "limit": 20,
                            "scope": {
                                "variable": "{{variables.[Service Operation]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Service Operations]}}"
                            }
                        }
                    },
                    "variables": [
                        "{{variables.[Service Operation]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "start",
                                        "title": "Start",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        },
                                        "width": 110
                                    },
                                    {
                                        "field": "ServiceLink",
                                        "title": "Root service",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "rootOperation",
                                        "title": "Root operation",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "durationMs",
                                        "title": "Duration",
                                        "renderer": {
                                            "type": "bar",
                                            "thresholds": [
                                                {
                                                    "to": 250,
                                                    "color": "#2bb660"
                                                },
                                                {
                                                    "to": 1000,
                                                    "color": "#ffaa00"
                                                },
                                                {
                                                    "to": 1000000000000.0,
                                                    "color": "#f2164d"
                                                }
                                            ]
                                        }
                                    },
                                    {
                                        "field": "spans",
                                        "title": "Spans",
                                        "renderer": {
                                            "type": "number",
                                            "decimals": 0
                                        },
                                        "align": "right",
                                        "width": 70
                                    },
                                    {
                                        "field": "errors",
                                        "title": "Errors",
                                        "renderer": {
                                            "type": "number",
                                            "decimals": 0,
                                            "thresholds": [
                                                {
                                                    "to": 0,
                                                    "color": "#2bb660"
                                                },
                                                {
                                                    "to": 1000000000.0,
                                                    "color": "#f2164d"
                                                }
                                            ]
                                        },
                                        "align": "right",
                                        "width": 70
                                    },
                                    {
                                        "field": "status",
                                        "title": "Status",
                                        "renderer": {
                                            "type": "status",
                                            "showLabel": false
                                        },
                                        "width": 60,
                                        "align": "center"
                                    },
                                    {
                                        "field": "traceId",
                                        "title": "Trace ID",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableSort": {
                                    "field": "durationMs",
                                    "direction": "desc"
                                }
                            }
                        }
                    }
                }
            },
            {
                "i": "3b84b5a5-5025-481a-b456-dc7c8c9f4b29",
                "x": 0,
                "y": 9,
                "w": 4,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Recent Error Spans",
                    "description": "The latest 100 requests to this operation that returned an error",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[spans]}}",
                        "name": "spans",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "query": "kind:in(2, 5) status_code:=2",
                            "limit": 100,
                            "scope": {
                                "variable": "{{variables.[Service Operation]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Service Operations]}}"
                            }
                        }
                    },
                    "variables": [
                        "{{variables.[Service Operation]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "timestamp",
                                        "title": "Time",
                                        "renderer": {
                                            "type": "date",
                                            "showMilliseconds": true
                                        },
                                        "width": 170
                                    },
                                    {
                                        "field": "service",
                                        "title": "Service",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "OperationLink",
                                        "title": "Operation",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "durationMs",
                                        "title": "Duration",
                                        "renderer": {
                                            "type": "text"
                                        },
                                        "align": "right"
                                    },
                                    {
                                        "field": "statusMessage",
                                        "title": "Status message",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "PodLink",
                                        "title": "Pod",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "traceId",
                                        "title": "Trace ID",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableSort": {
                                    "field": "timestamp",
                                    "direction": "desc"
                                },
                                "detailsPanel": true,
                                "richTableWrapText": true
                            }
                        }
                    }
                }
            }
        ]
    }
