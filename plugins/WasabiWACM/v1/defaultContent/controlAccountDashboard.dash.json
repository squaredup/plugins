                                    "region",
                                    "activeStorage",
                                    "deletedStorage",
                                    "activeObjects",
                                    "deletedObjects",
                                    "apiCalls",
                                    "egress",
                                    "ingress"
                                ],
                                "hiddenColumns": ["bucketNumber", "startTime", "endTime"]
