                        "sort": { "by": [["activeStorage", "desc"]] }
                    },
                    "scope": {
                        "scope": "{{scopes.[Control Accounts]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Control Account]}}"
                    },
                    "variables": ["{{variables.[Control Account]}}"],
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": [
