                "config": {
                    "_type": "tile/data-stream",
                    "title": "Usage History",
                    "description": "Daily storage usage over the dashboard timeframe",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[controlAccountUsageHistory]}}",
                        "name": "controlAccountUsageHistory",
                        "pluginConfigId": "{{configId}}",
                        "group": {
                            "by": [["startTime", "byDay"]],
                            "aggregate": [
                                { "type": "sum", "names": ["activeStorage"] },
                                { "type": "sum", "names": ["deletedStorage"] }
                            ]
                        },
                        "sort": { "by": [["startTime_byDay", "asc"]] }
                    },
                    "scope": {
                        "scope": "{{scopes.[Control Accounts]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Control Account]}}"
                    },
                    "variables": ["{{variables.[Control Account]}}"],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "line",
                            "encoding": {
                                "x": {
                                    "field": "startTime_byDay",
                                    "type": "temporal",
                                    "title": "Start Time"
                                }
                            },
                            "style": {
                                "legendPosition": "bottom",
                                "cartesianShowYAxisTitle": true,
                                "cartesianYAxisTitle": "Storage (TB)",
                                "cartesianYAxisRangeMode": "fit",
                                "cartesianSymbol": "none",
                                "cartesianAreaGradient": true
                            }
                        }
                    }
                }
            },
