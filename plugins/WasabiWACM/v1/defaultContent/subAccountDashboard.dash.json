                    "_type": "tile/data-stream",
                    "title": "Usage History",
                    "description": "Daily storage usage over the dashboard timeframe",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[subAccountUsageHistory]}}",
                        "name": "subAccountUsageHistory",
                        "pluginConfigId": "{{configId}}",
                        "group": {
                            "by": [["startTime", "byDay"]],
                            "aggregate": [
                                { "type": "sum", "names": ["activeStorage"] },
                                { "type": "sum", "names": ["deletedStorage"] }
                            ]
                        },
                        "sort": { "by": [["startTime_byDay", "asc"]] }
