{
    "name": "typesense",
    "displayName": "Typesense",
    "version": "1.0.0",
    "author": { "name": "@clarkd", "type": "community" },
    "description": "Query documents from your Typesense collections using a search-only API key.",
    "category": "Database",
    "type": "hybrid",
    "schemaVersion": "2.1",
    "importNotSupported": true,
    "restrictedToPlatforms": [],
    "keywords": ["typesense", "search", "documents", "query"],
    "objectTypes": [],
    "links": [
        {
            "category": "documentation",
            "url": "https://github.com/squaredup/plugins/blob/main/plugins/Typesense/v1/docs/README.md",
            "label": "Help adding this plugin"
        },
        {
            "category": "source",
            "url": "https://github.com/squaredup/plugins/tree/main/plugins/Typesense",
            "label": "Repository"
        }
    ],
    "base": {
        "plugin": "WebAPI",
        "majorVersion": "1",
        "config": {
            "baseUrl": "{{host}}",
            "authMode": "none",
            "headers": [{ "key": "X-TYPESENSE-API-KEY", "value": "{{apiKey}}" }],
            "queryArgs": []
        }
    }
}
