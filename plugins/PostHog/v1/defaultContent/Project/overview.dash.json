                                        "field": "active",
                                        "title": "Active",
                                        "renderer": {
                                            "type": "boolean",
                                            "trueLabel": "Yes",
                                            "falseLabel": "No",
                                            "trueColor": "inherit",
                                            "falseColor": "inherit"
                                        }
                                    },
                                    {
                                        "field": "last_called_at",
                                        "title": "Last evaluated",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    },
                                    {
                                        "field": "created_at",
                                        "title": "Created",
                                        "renderer": {
                                            "type": "date"
                                        }
                                    }
                                ]
