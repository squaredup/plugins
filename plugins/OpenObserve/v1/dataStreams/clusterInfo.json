{
    "name": "clusterInfo",
    "displayName": "Cluster Info",
    "description": "Pending compaction jobs per node, grouped by region, for the OpenObserve cluster",
    "tags": ["Streams"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "cluster_info",
        "postRequestScript": "clusterInfo.js",
        "errorHandling": { "type": "script", "script": "errorHandling/clusterInfo.js" }
    },
    "matches": "none",
    "visibility": { "type": "hidden" },
    "metadata": [
        { "name": "region", "displayName": "Region", "shape": "string" },
        { "name": "node", "displayName": "Node", "shape": "string", "role": "label" },
        { "name": "pendingJobs", "displayName": "Pending Compaction Jobs", "shape": "number" }
    ],
    "timeframes": false
}
