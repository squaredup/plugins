{
    "name": "metricLabels",
    "displayName": "Metric Labels",
    "description": "Label names present on a metric",
    "tags": ["Metrics"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "prometheus/api/v1/labels",
        "getArgs": [
            { "key": "match[]", "value": "{{metric}}" },
            { "key": "start", "value": "{{timeframe.unixStart}}" },
            { "key": "end", "value": "{{timeframe.unixEnd}}" }
        ],
        "postRequestScript": "metricLabels.js"
    },
    "matches": "none",
    "visibility": { "type": "hidden" },
    "ui": [{ "type": "text", "name": "metric", "label": "Metric" }],
    "metadata": [
        { "name": "result", "visible": false },
        { "name": "label", "computed": true, "valueExpression": "{{ $['result'] }}", "role": "label" },
        { "name": "value", "computed": true, "valueExpression": "{{ $['result'] }}", "role": "value" }
    ],
    "timeframes": true
}
