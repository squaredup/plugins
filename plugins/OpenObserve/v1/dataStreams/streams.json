{
    "name": "streams",
    "displayName": "Streams",
    "description": "Streams registered in the organization, with stats, settings, and optionally their field schema",
    "tags": ["Streams"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "streams",
        "getArgs": [
            { "key": "type", "value": "{{type}}" },
            { "key": "fetchSchema", "value": "{{String(includeSchema) === 'true' ? 'true' : 'false'}}" }
        ],
        "expandInnerObjects": true,
        "pathToData": "list"
    },
    "matches": "none",
    "ui": [
        {
            "type": "autocomplete",
            "name": "type",
            "label": "Stream type",
            "defaultValue": "logs",
            "allowCustomValues": false,
            "isMulti": false,
            "isClearable": false,
            "data": {
                "source": "fixed",
                "values": [
                    { "value": "logs", "label": "Logs" },
                    { "value": "metrics", "label": "Metrics" },
                    { "value": "traces", "label": "Traces" }
                ]
            }
        },
        {
            "type": "toggle",
            "name": "includeSchema",
            "label": "Include field schema",
            "help": "Fills the Total Fields and Schema columns. When off, Total Fields is 0 and Schema is empty."
        }
    ],
    "metadata": [
        { "name": "name", "displayName": "Name", "shape": "string", "role": "label" },
        { "name": "stream_type", "displayName": "Stream Type", "shape": "string" },
        { "name": "total_fields", "displayName": "Total Fields", "shape": "number" },
        { "name": "stats.doc_num", "displayName": "Document Count", "shape": "number" },
        { "name": "stats.storage_size", "displayName": "Storage Size (MB)", "shape": ["megabytes", {}] },
        { "name": "stats.compressed_size", "displayName": "Compressed Size (MB)", "shape": ["megabytes", {}] },
        { "name": "schema", "displayName": "Schema", "shape": "json" },
        { "name": "settings", "displayName": "Settings", "shape": "json" },
        {
            "name": "sourceId",
            "displayName": "Source ID",
            "computed": true,
            "valueExpression": "{{ $['name'] + ':' + $['stream_type'] }}",
            "visible": false
        }
    ],
    "timeframes": false
}
