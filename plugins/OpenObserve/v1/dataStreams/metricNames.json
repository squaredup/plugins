{
    "name": "metricNames",
    "displayName": "Metric Names",
    "description": "Metric names available for querying",
    "tags": ["Metrics"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "streams",
        "getArgs": [
            { "key": "type", "value": "metrics" },
            { "key": "fetchSchema", "value": "false" }
        ],
        "pathToData": "list"
    },
    "matches": "none",
    "visibility": { "type": "hidden" },
    "metadata": [
        { "name": "name", "visible": false },
        { "name": "label", "computed": true, "valueExpression": "{{ $['name'] }}", "role": "label" },
        { "name": "value", "computed": true, "valueExpression": "{{ $['name'] }}", "role": "value" }
    ],
    "timeframes": false
}
