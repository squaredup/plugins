{
    "name": "incidentStats",
    "displayName": "Incident Stats",
    "description": "Summary statistics for alert incidents in the organization",
    "tags": ["Alerts"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "../v2/{{dataSource.organization}}/alerts/incidents/stats",
        "postRequestScript": "incidentStats.js",
        "errorHandling": { "type": "script", "script": "errorHandling/incidentStats.js" }
    },
    "matches": "none",
    "visibility": { "type": "hidden" },
    "metadata": [
        { "name": "total_incidents", "displayName": "Total Incidents", "shape": "number" },
        { "name": "open_incidents", "displayName": "Open Incidents", "shape": "number" },
        { "name": "acknowledged_incidents", "displayName": "Acknowledged Incidents", "shape": "number" },
        { "name": "resolved_incidents", "displayName": "Resolved Incidents", "shape": "number" },
        { "name": "alerts_per_incident_avg", "displayName": "Alerts Per Incident (avg)", "shape": ["number", { "decimalPlaces": 2 }] },
        { "name": "mttr_minutes", "displayName": "Mean Time to Resolve (min)", "shape": "number" },
        { "name": "by_severity", "displayName": "By Severity", "shape": "json" },
        { "name": "by_service", "displayName": "By Service", "shape": "json" }
    ],
    "timeframes": false
}
