{
    "name": "slos",
    "displayName": "SLOs",
    "description": "Service Level Objectives defined in the organization, with current status",
    "tags": ["SLOs"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "slos",
        "getArgs": [{ "key": "folder", "value": "{{folder || null}}" }],
        "postRequestScript": "slos.js"
    },
    "matches": "none",
    "ui": [
        {
            "type": "text",
            "name": "folder",
            "label": "Folder (optional)"
        }
    ],
    "metadata": [
        { "name": "id", "displayName": "ID", "shape": "string" },
        { "name": "name", "displayName": "Name", "shape": "string", "role": "label" },
        { "name": "description", "displayName": "Description", "shape": "string" },
        { "name": "enabled", "displayName": "Enabled", "shape": "boolean" },
        { "name": "target", "displayName": "Target", "shape": "percent" },
        { "name": "owner", "displayName": "Owner", "shape": "string" },
        { "name": "folderId", "displayName": "Folder ID", "shape": "string" },
        { "name": "tags", "displayName": "Tags", "shape": "string" },
        { "name": "sliType", "displayName": "SLI Type", "shape": "string" },
        { "name": "config", "displayName": "Config", "shape": "json" },
        { "name": "windowSecs", "displayName": "Window", "shape": "seconds" },
        { "name": "sliceIntervalSecs", "displayName": "Slice Interval", "shape": "seconds" },
        { "name": "groupBy", "displayName": "Group By", "shape": "string" },
        { "name": "noData", "displayName": "No Data", "shape": "boolean" },
        { "name": "sli", "displayName": "SLI", "shape": "percent" },
        { "name": "coverage", "displayName": "Coverage", "shape": ["percent", { "asZeroToOne": true }] },
        { "name": "good", "displayName": "Good", "shape": "number" },
        { "name": "total", "displayName": "Total", "shape": "number" },
        { "name": "coveredSlices", "displayName": "Covered Slices", "shape": "number" },
        { "name": "burnRate", "displayName": "Burn Rate", "shape": ["number", { "decimalPlaces": 2 }] },
        { "name": "errorBudgetRemaining", "displayName": "Error Budget Remaining", "shape": "percent" },
        { "name": "timeToExhaustSecs", "displayName": "Time To Exhaust", "shape": "seconds" },
        { "name": "computedAt", "displayName": "Computed At", "shape": "date", "role": "timestamp" },
        { "name": "watermarkEnd", "displayName": "Watermark End", "shape": "date" },
        { "name": "measuringSince", "displayName": "Measuring Since", "shape": "date" },
        { "name": "staleWatermark", "displayName": "Stale Watermark", "shape": "boolean" }
    ],
    "timeframes": false
}
