{
    "name": "labelValues",
    "displayName": "Label Values",
    "description": "Values present for a label on a metric",
    "tags": ["Metrics"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "prometheus/api/v1/label/{{labelName}}/values",
        "getArgs": [
            { "key": "match[]", "value": "{{metric}}" },
            { "key": "start", "value": "{{timeframe.unixStart}}" },
            { "key": "end", "value": "{{timeframe.unixEnd}}" }
        ],
        "postRequestScript": "labelValues.js"
    },
    "matches": "none",
    "visibility": { "type": "hidden" },
    "ui": [
        { "type": "text", "name": "metric", "label": "Metric" },
        { "type": "text", "name": "labelName", "label": "Label" }
    ],
    "metadata": [
        { "name": "result", "visible": false },
        { "name": "label", "computed": true, "valueExpression": "{{ $['result'] }}", "role": "label" },
        { "name": "value", "computed": true, "valueExpression": "{{ $['result'] }}", "role": "value" }
    ],
    "timeframes": true
}
