{
    "name": "Workspace",
    "schemaVersion": "1.5",
    "timeframe": "last30days",
    "variables": ["{{variables.[Workspace]}}"],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "000cafdc-39cc-4259-b46c-6bfe01bc61dd",
                "x": 0,
                "y": 0,
                "w": 1,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Properties",
                    "description": "",
                    "timeframe": "none",
                    "dataStream": {
                        "id": "datastream-properties",
                        "name": "properties"
                    },
                    "scope": {
                        "scope": "{{scopes.[Workspaces]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Workspace]}}"
                    },
                    "variables": ["{{variables.[Workspace]}}"],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "name",
                                        "title": "Name",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "sourceId",
                                        "title": "Source Id",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "sourceType",
                                        "title": "Source Type",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableTranspose": true
                            }
                        }
                    }
                }
            },
            {
                "i": "f5562a7c-2bbc-42e9-bf03-2cb3cadef87e",
                "x": 1,
                "y": 0,
                "w": 3,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Cost Over Time",
                    "description": "",
                    "activePluginConfigIds": ["{{configId}}"],
                    "variables": ["{{variables.[Workspace]}}"],
                    "dataStream": {
                        "id": "{{dataStreams.cost}}",
                        "name": "cost",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "workspace": {
                                "scope": "{{scopes.[Workspaces]}}",
                                "workspace": "{{workspaceId}}",
                                "variable": "{{variables.[Workspace]}}"
                            }
                        },
                        "group": {
                            "by": [["date", "byDay"]],
                            "aggregate": [
                                { "type": "sum", "names": ["amount"] }
                            ]
                        },
                        "sort": { "by": [["date_byDay", "asc"]] }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "line",
                            "encoding": {
                                "x": {
                                    "field": "date_byDay",
                                    "type": "temporal",
                                    "title": "Date"
                                },
                                "y": {
                                    "field": "amount_sum",
                                    "type": "quantitative",
                                    "title": "Cost ($) (Sum)"
                                }
                            },
                            "style": {
                                "legendPosition": "none",
                                "cartesianShowYAxisTitle": true,
                                "cartesianYAxisTitle": "Cost ($)",
                                "cartesianYAxisRangeMode": "fit",
                                "cartesianSymbol": "none",
                                "cartesianAreaGradient": true
                            }
                        }
                    }
                }
            },
            {
                "i": "393d5f28-2dbc-407d-936e-9da6d15886ec",
                "x": 0,
                "y": 3,
                "w": 4,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Usage By Model",
                    "description": "",
                    "activePluginConfigIds": ["{{configId}}"],
                    "variables": ["{{variables.[Workspace]}}"],
                    "dataStream": {
                        "id": "{{dataStreams.usage}}",
                        "name": "usage",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "groupBy": "model",
                            "workspace": {
                                "scope": "{{scopes.[Workspaces]}}",
                                "workspace": "{{workspaceId}}",
                                "variable": "{{variables.[Workspace]}}"
                            }
                        },
                        "group": {
                            "by": [
                                ["start", "byDay"],
                                ["model", "uniqueValues"]
                            ],
                            "aggregate": [
                                { "type": "sum", "names": ["total_tokens"] }
                            ]
                        },
                        "sort": { "by": [["start_byDay", "asc"]] }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "line",
                            "encoding": {
                                "x": {
                                    "field": "start_byDay",
                                    "type": "temporal",
                                    "title": "Time"
                                },
                                "y": {
                                    "field": "total_tokens_sum",
                                    "type": "quantitative",
                                    "title": "Total Tokens (Sum)"
                                },
                                "series": {
                                    "field": "model_uniqueValues",
                                    "type": "nominal",
                                    "title": "Model"
                                }
                            },
                            "style": {
                                "legendPosition": "bottom",
                                "cartesianShowYAxisTitle": true,
                                "cartesianYAxisTitle": "Tokens",
                                "cartesianYAxisRangeMode": "fit",
                                "cartesianSymbol": "none"
                            }
                        }
                    }
                }
            },
            {
                "i": "bd36baee-a12c-4bae-9a05-503ff39ca34e",
                "x": 0,
                "y": 6,
                "w": 4,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "API Keys In This Workspace",
                    "description": "",
                    "timeframe": "none",
                    "activePluginConfigIds": ["{{configId}}"],
                    "variables": ["{{variables.[Workspace]}}"],
                    "dataStream": {
                        "id": "{{dataStreams.apiKeys}}",
                        "name": "apiKeys",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "workspace": {
                                "scope": "{{scopes.[Workspaces]}}",
                                "workspace": "{{workspaceId}}",
                                "variable": "{{variables.[Workspace]}}"
                            }
                        },
                        "sort": { "by": [["created_at", "desc"]] }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "name",
                                        "title": "Name",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "status[Expanded].rawState",
                                        "title": "Status",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "active": "#2BB660",
                                                "expired": "#94A3B8",
                                                "archived": "#94A3B8",
                                                "inactive": "#94A3B8"
                                            }
                                        }
                                    },
                                    {
                                        "field": "partial_key_hint",
                                        "title": "Key Hint",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "created_at",
                                        "title": "Created",
                                        "renderer": {
                                            "type": "date"
                                        }
                                    },
                                    {
                                        "field": "expires_at",
                                        "title": "Expires",
                                        "renderer": {
                                            "type": "date"
                                        }
                                    }
                                ]
                            }
                        }
                    }
                }
            }
        ]
    }
}
