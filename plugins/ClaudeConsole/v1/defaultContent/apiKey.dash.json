{
    "name": "API Key",
    "schemaVersion": "1.5",
    "timeframe": "last30days",
    "variables": ["{{variables.[API Key]}}"],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "b1fb62c0-436b-4a5f-a09b-a341354bc6d4",
                "x": 0,
                "y": 0,
                "w": 1,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Properties",
                    "description": "",
                    "timeframe": "none",
                    "dataStream": {
                        "id": "datastream-properties",
                        "name": "properties"
                    },
                    "scope": {
                        "scope": "{{scopes.[API Keys]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[API Key]}}"
                    },
                    "variables": ["{{variables.[API Key]}}"],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {},
                            "style": {
                                "richTableTranspose": true,
                                "richTableHiddenColumns": [
                                    "id",
                                    "links",
                                    "type",
                                    "label"
                                ]
                            }
                        }
                    }
                }
            },
            {
                "i": "9f6cee89-ed40-4dce-8e19-da4da8147afb",
                "x": 1,
                "y": 0,
                "w": 3,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Token Usage",
                    "description": "",
                    "activePluginConfigIds": ["{{configId}}"],
                    "variables": ["{{variables.[API Key]}}"],
                    "dataStream": {
                        "id": "{{dataStreams.usage}}",
                        "name": "usage",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "groupBy": "model",
                            "apiKeyFilter": {
                                "scope": "{{scopes.[API Keys]}}",
                                "workspace": "{{workspaceId}}",
                                "variable": "{{variables.[API Key]}}"
                            }
                        },
                        "group": {
                            "by": [
                                ["start", "byDay"],
                                ["model", "uniqueValues"]
                            ],
                            "aggregate": [
                                { "type": "sum", "names": ["total_tokens"] }
                            ]
                        },
                        "sort": { "by": [["start_byDay", "asc"]] }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "line",
                            "encoding": {
                                "x": {
                                    "field": "start_byDay",
                                    "type": "temporal",
                                    "title": "Time"
                                },
                                "y": {
                                    "field": "total_tokens_sum",
                                    "type": "quantitative",
                                    "title": "Total Tokens (Sum)"
                                },
                                "series": {
                                    "field": "model_uniqueValues",
                                    "type": "nominal",
                                    "title": "Model"
                                }
                            },
                            "style": {
                                "legendPosition": "bottom",
                                "cartesianShowYAxisTitle": true,
                                "cartesianYAxisTitle": "Tokens",
                                "cartesianYAxisRangeMode": "fit",
                                "cartesianSymbol": "none"
                            }
                        }
                    }
                }
            }
        ]
    }
}
