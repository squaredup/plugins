{
    "name": "Member",
    "schemaVersion": "1.5",
    "timeframe": "last30days",
    "variables": ["{{variables.[Member]}}"],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "61835d71-5aa3-4700-a3f8-763c0377212e",
                "x": 0,
                "y": 0,
                "w": 1,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Properties",
                    "description": "",
                    "timeframe": "none",
                    "dataStream": {
                        "id": "datastream-properties",
                        "name": "properties"
                    },
                    "scope": {
                        "scope": "{{scopes.[Members]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Member]}}"
                    },
                    "variables": ["{{variables.[Member]}}"],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {},
                            "style": {
                                "richTableTranspose": true,
                                "richTableHiddenColumns": [
                                    "id",
                                    "links",
                                    "type",
                                    "label"
                                ]
                            }
                        }
                    }
                }
            },
            {
                "i": "1c2d8cbf-0d72-4458-b603-600746125408",
                "x": 1,
                "y": 0,
                "w": 3,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Account Usage",
                    "description": "",
                    "activePluginConfigIds": ["{{configId}}"],
                    "variables": ["{{variables.[Member]}}"],
                    "dataStream": {
                        "id": "{{dataStreams.usage}}",
                        "name": "usage",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "groupBy": "model",
                            "member": {
                                "scope": "{{scopes.[Members]}}",
                                "workspace": "{{workspaceId}}",
                                "variable": "{{variables.[Member]}}"
                            }
                        },
                        "group": {
                            "by": [
                                ["start", "byDay"],
                                ["model", "uniqueValues"]
                            ],
                            "aggregate": [
                                { "type": "sum", "names": ["total_tokens"] }
                            ]
                        },
                        "sort": { "by": [["start_byDay", "asc"]] }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "line",
                            "encoding": {
                                "x": {
                                    "field": "start_byDay",
                                    "type": "temporal",
                                    "title": "Time"
                                },
                                "y": {
                                    "field": "total_tokens_sum",
                                    "type": "quantitative",
                                    "title": "Total Tokens (Sum)"
                                },
                                "series": {
                                    "field": "model_uniqueValues",
                                    "type": "nominal",
                                    "title": "Model"
                                }
                            },
                            "style": {
                                "legendPosition": "bottom",
                                "cartesianShowYAxisTitle": true,
                                "cartesianYAxisTitle": "Tokens",
                                "cartesianYAxisRangeMode": "fit",
                                "cartesianSymbol": "none"
                            }
                        }
                    }
                }
            },
            {
                "i": "834eb786-b31d-4de2-9c76-20324e0c954a",
                "x": 0,
                "y": 3,
                "w": 4,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "API Keys Created By This Member",
                    "description": "",
                    "timeframe": "none",
                    "activePluginConfigIds": ["{{configId}}"],
                    "variables": ["{{variables.[Member]}}"],
                    "dataStream": {
                        "id": "{{dataStreams.apiKeys}}",
                        "name": "apiKeys",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "createdBy": {
                                "scope": "{{scopes.[Members]}}",
                                "workspace": "{{workspaceId}}",
                                "variable": "{{variables.[Member]}}"
                            }
                        },
                        "sort": { "by": [["created_at", "desc"]] }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "name",
                                        "title": "Name",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "status[Expanded].rawState",
                                        "title": "Status",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "active": "#2BB660",
                                                "expired": "#94A3B8",
                                                "archived": "#94A3B8",
                                                "inactive": "#94A3B8"
                                            }
                                        }
                                    },
                                    {
                                        "field": "workspace_id",
                                        "title": "Workspace ID",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "partial_key_hint",
                                        "title": "Key Hint",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "created_at",
                                        "title": "Created",
                                        "renderer": {
                                            "type": "date"
                                        }
                                    }
                                ]
                            }
                        }
                    }
                }
            }
        ]
    }
}
