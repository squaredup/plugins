{
    "name": "struxureware-dce",
    "displayName": "StruxureWare Data Center Expert",
    "version": "1.0.0",
    "author": {
        "name": "@shawn149",
        "type": "community"
    },
    "description": "Monitor data center power, cooling and environmental devices, sensors and alarms from EcoStruxure IT Data Center Expert.",
    "category": "Infrastructure",
    "type": "hybrid",
    "schemaVersion": "2.1",
    "importNotSupported": false,
    "restrictedToPlatforms": [],
    "keywords": [
        "struxureware",
        "ecostruxure",
        "dce",
        "data center expert",
        "schneider electric",
        "apc",
        "ups",
        "pdu",
        "netbotz",
        "dcim",
        "sensor",
        "alarm"
    ],
    "objectTypes": ["Device", "Device Group", "Sensor"],
    "links": [
        {
            "category": "documentation",
            "url": "https://github.com/squaredup/plugins/blob/main/plugins/StruxureWare/v1/docs/README.md",
            "label": "Help adding this plugin"
        },
        {
            "category": "source",
            "url": "https://github.com/squaredup/plugins/tree/main/plugins/StruxureWare/v1",
            "label": "Repository"
        }
    ],
    "base": {
        "plugin": "WebAPI",
        "majorVersion": "1",
        "config": {
            "baseUrl": "{{serverUrl.trim().replace(/\\/+$/, '').replace(/\\/isxg$/i, '')}}/isxg",
            "authMode": "oauth2",
            "oauth2GrantType": "password",
            "oauth2TokenUrl": "{{serverUrl.trim().replace(/\\/+$/, '').replace(/\\/isxg$/i, '')}}/isxg/oauth/token",
            "oauth2PasswordGrantUserName": "{{username}}",
            "oauth2PasswordGrantPassword": "{{password}}",
            "oauth2ClientId": "{{typeof clientId === 'string' && clientId.trim() ? clientId.trim() : 'notused'}}",
            "oauth2ClientSecret": "{{typeof clientSecret === 'string' && clientSecret ? clientSecret : 'notused'}}",
            "oauth2ClientSecretLocationDuringAuth": "{{typeof clientId === 'string' && clientId.trim() ? 'header' : 'body'}}",
            "oauth2Scope": "",
            "oauth2TokenExtraArgs": [],
            "oauth2TokenExtraHeaders": [],
            "ignoreCertificateErrors": "{{ignoreCertificateErrors}}",
            "headers": [
                {
                    "key": "Accept",
                    "value": "application/json"
                }
            ],
            "queryArgs": []
        }
    }
}
