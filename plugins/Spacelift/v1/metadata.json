{
    "name": "spacelift",
    "displayName": "Spacelift",
    "version": "1.0.0",
    "author": {
        "name": "@adamkinniburgh",
        "type": "community"
    },
    "description": "Monitor Spacelift stacks, runs, drift and worker pool capacity.",
    "category": "CI/CD Tools",
    "type": "hybrid",
    "schemaVersion": "2.1",
    "importNotSupported": false,
    "restrictedToPlatforms": [],
    "keywords": [
        "spacelift",
        "infrastructure as code",
        "iac",
        "terraform",
        "opentofu",
        "pulumi",
        "cloudformation",
        "ansible",
        "drift",
        "gitops"
    ],
    "objectTypes": [
        "Stack",
        "Worker Pool"
    ],
    "links": [
        {
            "category": "documentation",
            "url": "https://github.com/squaredup/plugins/blob/main/plugins/Spacelift/v1/docs/README.md",
            "label": "Help adding this plugin"
        },
        {
            "category": "source",
            "url": "https://github.com/squaredup/plugins/tree/main/plugins/Spacelift/v1",
            "label": "Repository"
        }
    ],
    "base": {
        "plugin": "WebAPI",
        "majorVersion": "1",
        "config": {
            "baseUrl": "{{accountUrl}}",
            "authMode": "none",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "application/json"
                },
                {
                    "key": "Accept",
                    "value": "application/json"
                }
            ],
            "queryArgs": [],
            "showScripting": true,
            "scriptingVariables": [
                {
                    "key": "apiKeyId",
                    "value": "{{apiKeyId}}"
                },
                {
                    "key": "apiKeySecret",
                    "value": "{{apiKeySecret}}"
                }
            ],
            "preRequestScript": "preRequest.js"
        }
    }
}
