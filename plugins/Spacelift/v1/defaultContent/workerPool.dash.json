{
    "name": "Worker Pool",
    "schemaVersion": "1.5",
    "timeframe": "none",
    "variables": [
        "{{variables.[Spacelift Worker Pool]}}"
    ],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "34a4719c-379c-49ee-af5f-b5ddc571f330",
                "x": 0,
                "y": 0,
                "w": 1,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Utilization",
                    "description": "Share of this pool's available workers that are busy",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[workerPools]}}",
                        "name": "workerPools",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "workerPool": {
                                "variable": "{{variables.[Spacelift Worker Pool]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Spacelift Worker Pools]}}"
                            }
                        }
                    },
                    "variables": [
                        "{{variables.[Spacelift Worker Pool]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "gauge",
                            "encoding": {
                                "value": {
                                    "field": "utilization",
                                    "type": "quantitative",
                                    "title": "Utilization"
                                }
                            },
                            "style": {
                                "gaugeMin": 0,
                                "gaugeMax": 100,
                                "gaugeLabelText": "busy",
                                "gaugeBands": [
                                    {
                                        "to": 0.7,
                                        "color": "#2BB660"
                                    },
                                    {
                                        "to": 0.9,
                                        "color": "#F59E0B"
                                    },
                                    {
                                        "to": 1,
                                        "color": "#DE0038"
                                    }
                                ]
                            }
                        }
                    }
                }
            },
            {
                "i": "b4839859-4d28-4890-b0ad-fa02c4849c6f",
                "x": 1,
                "y": 0,
                "w": 3,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Pool Status",
                    "description": "Runs waiting for a worker, and how many workers are busy, idle or drained. The public pool has no drained count",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[workerPools]}}",
                        "name": "workerPools",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "workerPool": {
                                "variable": "{{variables.[Spacelift Worker Pool]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Spacelift Worker Pools]}}"
                            }
                        }
                    },
                    "variables": [
                        "{{variables.[Spacelift Worker Pool]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    {
                                        "field": "pendingRuns",
                                        "type": "quantitative",
                                        "title": "Pending Runs"
                                    },
                                    {
                                        "field": "busyWorkers",
                                        "type": "quantitative",
                                        "title": "Busy Workers"
                                    },
                                    {
                                        "field": "idleWorkers",
                                        "type": "quantitative",
                                        "title": "Idle Workers"
                                    },
                                    {
                                        "field": "drainedWorkers",
                                        "type": "quantitative",
                                        "title": "Drained Workers"
                                    }
                                ]
                            },
                            "style": {
                                "scalarColumns": 4
                            }
                        }
                    }
                }
            },
            {
                "i": "f8c6a9f0-abb8-4bf1-9018-936d2387c68b",
                "x": 0,
                "y": 3,
                "w": 1,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Properties",
                    "description": "Type and space of this worker pool",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "datastream-properties",
                        "name": "properties",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Spacelift Worker Pools]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Spacelift Worker Pool]}}"
                    },
                    "variables": [
                        "{{variables.[Spacelift Worker Pool]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "name",
                                        "title": "Name",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "poolType",
                                        "title": "Type",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "space",
                                        "title": "Space",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "description",
                                        "title": "Description",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableTranspose": true,
                                "richTableCellPadding": 6
                            }
                        }
                    }
                }
            },
            {
                "i": "8a3c6332-0f05-45a7-a8b4-aacad93c3986",
                "x": 1,
                "y": 3,
                "w": 3,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Workers",
                    "description": "Workers registered in this private pool. Spacelift doesn't list the public pool's workers, so this tile has no data for the public pool",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[workers]}}",
                        "name": "workers",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Spacelift Worker Pools]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Spacelift Worker Pool]}}"
                    },
                    "variables": [
                        "{{variables.[Spacelift Worker Pool]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "workerId",
                                        "title": "Worker",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "status[Expanded].rawState",
                                        "title": "Status",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "IDLE": "#2BB660",
                                                "BUSY": "#3B82F6",
                                                "DRAINED": "#F59E0B"
                                            },
                                            "defaultColor": "#94A3B8"
                                        },
                                        "width": 110
                                    },
                                    {
                                        "field": "createdAt",
                                        "title": "Registered",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    },
                                    {
                                        "field": "availableAt",
                                        "title": "Idle since",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableCellPadding": 6
                            }
                        }
                    }
                }
            },
            {
                "i": "160ddfec-990b-4be1-ada1-b5c27c83451b",
                "x": 0,
                "y": 7,
                "w": 4,
                "h": 5,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Stacks on This Pool",
                    "description": "Stacks that run on this worker pool",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[stacks]}}",
                        "name": "stacks",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "workerPool": {
                                "variable": "{{variables.[Spacelift Worker Pool]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Spacelift Worker Pools]}}"
                            }
                        }
                    },
                    "variables": [
                        "{{variables.[Spacelift Worker Pool]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "name",
                                        "title": "Stack",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "health",
                                        "title": "Health",
                                        "renderer": {
                                            "type": "status"
                                        }
                                    },
                                    {
                                        "field": "state",
                                        "title": "State",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "FINISHED": "#2BB660",
                                                "FAILED": "#DE0038",
                                                "UNCONFIRMED": "#F59E0B",
                                                "STOPPED": "#F59E0B",
                                                "DISCARDED": "#94A3B8",
                                                "NONE": "#94A3B8"
                                            },
                                            "defaultColor": "#3B82F6"
                                        }
                                    },
                                    {
                                        "field": "isDrifted",
                                        "title": "Drifted",
                                        "renderer": {
                                            "type": "boolean",
                                            "trueLabel": "Yes",
                                            "falseLabel": "No",
                                            "trueColor": "#F59E0B",
                                            "falseColor": "inherit"
                                        }
                                    },
                                    {
                                        "field": "isLocked",
                                        "title": "Locked",
                                        "renderer": {
                                            "type": "boolean",
                                            "trueLabel": "Yes",
                                            "falseLabel": "No",
                                            "trueColor": "#3B82F6",
                                            "falseColor": "inherit"
                                        }
                                    },
                                    {
                                        "field": "space",
                                        "title": "Space",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "vendor",
                                        "title": "Vendor",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "lastApplyAt",
                                        "title": "Last applied",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    },
                                    {
                                        "field": "url",
                                        "title": "Link",
                                        "renderer": {
                                            "type": "link"
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableCellPadding": 6
                            }
                        }
                    }
                }
            }
        ]
    }
}
