                            "encoding": {
                                "label": {
                                    "field": "name",
                                    "type": "nominal"
                                },
                                "status": {
                                    "field": "health",
                                    "type": "nominal"
                                },
                                "link": {
                                    "field": "name",
                                    "type": "nominal"
                                }
                            },
                            "style": {
                                "statusGridColumnsPerRow": 6,
                                "statusGridOrderByField": "name",
                                "statusGridOrderDirection": "asc",
                                "statusGridMaxBlockHeight": 110,
                                "statusGridLabelWrap": true,
                                "statusGridSecondaryTemplate": "{{{{raw}}}}{{state}}{{{{/raw}}}}"
                            }
                        }
                    }
