                "config": {
                    "_type": "tile/data-stream",
                    "title": "Stack Health",
                    "description": "Health of each stack from its current state and drift. Disabled stacks show as unmonitored",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[stacks]}}",
                        "name": "stacks",
                        "pluginConfigId": "{{configId}}"
