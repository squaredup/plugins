                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Runs by State",
                    "description": "Runs and tasks started in the timeframe, by their current state",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[runs]}}",
                        "name": "runs",
                        "pluginConfigId": "{{configId}}",
                        "group": {
                            "by": [
                                [
                                    "state",
                                    "uniqueValues"
                                ],
                                [
                                    "state[Expanded].rawState",
                                    "uniqueValues"
                                ]
                            ],
                            "aggregate": [
                                {
                                    "type": "count"
                                }
                            ]
                        },
                        "sort": {
                            "by": [
                                [
                                    "count",
                                    "desc"
                                ]
                            ]
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "pie",
                            "encoding": {
                                "label": {
                                    "field": "state[Expanded].rawState_uniqueValues",
                                    "type": "nominal",
                                    "title": "State"
                                },
                                "value": {
                                    "field": "count",
                                    "type": "quantitative",
                                    "aggregate": "sum",
                                    "title": "Runs"
                                }
                            },
                            "style": {
                                "pieInnerRadius": 60,
                                "pieDonutCenterValue": "total",
                                "labelFontSize": 16,
                                "pieLegendStyle": "table",
                                "mappedColors": {
                                    "FINISHED": "#2BB660",
                                    "FAILED": "#DE0038",
                                    "UNCONFIRMED": "#F59E0B",
                                    "PENDING_REVIEW": "#F59E0B",
                                    "STOPPED": "#F59E0B",
                                    "DISCARDED": "#94A3B8",
                                    "CANCELED": "#94A3B8",
                                    "SKIPPED": "#94A3B8",
                                    "QUEUED": "#3B82F6",
                                    "READY": "#3B82F6",
                                    "PREPARING": "#3B82F6",
                                    "INITIALIZING": "#3B82F6",
                                    "PLANNING": "#3B82F6",
                                    "CONFIRMED": "#3B82F6",
                                    "PREPARING_APPLY": "#3B82F6",
                                    "APPLYING": "#3B82F6",
                                    "PERFORMING": "#3B82F6",
                                    "DESTROYING": "#3B82F6",
                                    "REPLAN_REQUESTED": "#3B82F6",
                                    "PREPARING_REPLAN": "#3B82F6",
                                    "PENDING": "#3B82F6"
                                }
                            }
                        }
                    }
                }
