                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[runs]}}",
                        "name": "runs",
                        "pluginConfigId": "{{configId}}",
                        "filter": {
                            "multiOperation": "or",
                            "filters": [
                                {
                                    "column": "state",
                                    "operation": "equals",
                                    "value": "FAILED"
                                },
                                {
                                    "column": "state",
                                    "operation": "equals",
                                    "value": "error"
                                }
                            ]
                        },
                        "sort": {
