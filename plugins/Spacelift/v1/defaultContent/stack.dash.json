{
    "name": "Stack",
    "schemaVersion": "1.5",
    "timeframe": "last7days",
    "variables": [
        "{{variables.[Spacelift Stack]}}"
    ],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "6dffc440-9409-49ff-bf0f-6f69bb82c3a6",
                "x": 0,
                "y": 0,
                "w": 1,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Status",
                    "description": "Current state, drift and lock status of this stack",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[stacks]}}",
                        "name": "stacks",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "stack": {
                                "variable": "{{variables.[Spacelift Stack]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Spacelift Stacks]}}"
                            }
                        }
                    },
                    "variables": [
                        "{{variables.[Spacelift Stack]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "health",
                                        "title": "Health",
                                        "renderer": {
                                            "type": "status"
                                        }
                                    },
                                    {
                                        "field": "state",
                                        "title": "State",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "FINISHED": "#2BB660",
                                                "FAILED": "#DE0038",
                                                "UNCONFIRMED": "#F59E0B",
                                                "STOPPED": "#F59E0B",
                                                "DISCARDED": "#94A3B8",
                                                "NONE": "#94A3B8"
                                            },
                                            "defaultColor": "#3B82F6"
                                        }
                                    },
                                    {
                                        "field": "isDrifted",
                                        "title": "Drifted",
                                        "renderer": {
                                            "type": "boolean",
                                            "trueLabel": "Yes",
                                            "falseLabel": "No",
                                            "trueColor": "#F59E0B",
                                            "falseColor": "inherit"
                                        }
                                    },
                                    {
                                        "field": "needsApproval",
                                        "title": "Needs approval",
                                        "renderer": {
                                            "type": "boolean",
                                            "trueLabel": "Yes",
                                            "falseLabel": "No",
                                            "trueColor": "#F59E0B",
                                            "falseColor": "inherit"
                                        }
                                    },
                                    {
                                        "field": "isLocked",
                                        "title": "Locked",
                                        "renderer": {
                                            "type": "boolean",
                                            "trueLabel": "Yes",
                                            "falseLabel": "No",
                                            "trueColor": "#3B82F6",
                                            "falseColor": "inherit"
                                        }
                                    },
                                    {
                                        "field": "lockedBy",
                                        "title": "Locked by",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "isDisabled",
                                        "title": "Disabled",
                                        "renderer": {
                                            "type": "boolean",
                                            "trueLabel": "Yes",
                                            "falseLabel": "No",
                                            "trueColor": "inherit",
                                            "falseColor": "inherit"
                                        }
                                    },
                                    {
                                        "field": "resourceCount",
                                        "title": "Resources",
                                        "renderer": {
                                            "type": "number"
                                        }
                                    },
                                    {
                                        "field": "stateSetAt",
                                        "title": "State changed",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    },
                                    {
                                        "field": "lastApplyAt",
                                        "title": "Last applied",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    },
                                    {
                                        "field": "commitHash",
                                        "title": "Tracked commit",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableTranspose": true,
                                "richTableCellPadding": 6
                            }
                        }
                    }
                }
            },
            {
                "i": "5651f176-39b3-430f-abb5-34b37943e59f",
                "x": 1,
                "y": 0,
                "w": 1,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Properties",
                    "description": "Where this stack's code comes from and where it runs",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "datastream-properties",
                        "name": "properties",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Spacelift Stacks]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Spacelift Stack]}}"
                    },
                    "variables": [
                        "{{variables.[Spacelift Stack]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "space",
                                        "title": "Space",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "vendor",
                                        "title": "Vendor",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "repository",
                                        "title": "Repository",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "branch",
                                        "title": "Branch",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "projectRoot",
                                        "title": "Project root",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "vcsProvider",
                                        "title": "VCS provider",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "workerPoolName",
                                        "title": "Worker pool",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "autodeploy",
                                        "title": "Autodeploy",
                                        "renderer": {
                                            "type": "boolean",
                                            "trueLabel": "Yes",
                                            "falseLabel": "No",
                                            "trueColor": "inherit",
                                            "falseColor": "inherit"
                                        }
                                    },
                                    {
                                        "field": "administrative",
                                        "title": "Administrative",
                                        "renderer": {
                                            "type": "boolean",
                                            "trueLabel": "Yes",
                                            "falseLabel": "No",
                                            "trueColor": "inherit",
                                            "falseColor": "inherit"
                                        }
                                    },
                                    {
                                        "field": "description",
                                        "title": "Description",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "url",
                                        "title": "Link",
                                        "renderer": {
                                            "type": "link"
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableTranspose": true,
                                "richTableCellPadding": 6
                            }
                        }
                    }
                }
            },
            {
                "i": "0db29ca8-aa82-4f73-ac2c-d2705c873484",
                "x": 2,
                "y": 0,
                "w": 2,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Run Outcomes",
                    "description": "Runs and tasks on this stack in the timeframe, by their current state",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[stackRuns]}}",
                        "name": "stackRuns",
                        "pluginConfigId": "{{configId}}",
                        "group": {
                            "by": [
                                [
                                    "state",
                                    "uniqueValues"
                                ],
                                [
                                    "state[Expanded].rawState",
                                    "uniqueValues"
                                ]
                            ],
                            "aggregate": [
                                {
                                    "type": "count"
                                }
                            ]
                        },
                        "sort": {
                            "by": [
                                [
                                    "count",
                                    "desc"
                                ]
                            ]
                        }
                    },
                    "scope": {
                        "scope": "{{scopes.[Spacelift Stacks]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Spacelift Stack]}}"
                    },
                    "variables": [
                        "{{variables.[Spacelift Stack]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "pie",
                            "encoding": {
                                "label": {
                                    "field": "state[Expanded].rawState_uniqueValues",
                                    "type": "nominal",
                                    "title": "State"
                                },
                                "value": {
                                    "field": "count",
                                    "type": "quantitative",
                                    "aggregate": "sum",
                                    "title": "Runs"
                                }
                            },
                            "style": {
                                "pieInnerRadius": 60,
                                "pieDonutCenterValue": "total",
                                "labelFontSize": 16,
                                "pieLegendStyle": "table",
                                "mappedColors": {
                                    "FINISHED": "#2BB660",
                                    "FAILED": "#DE0038",
                                    "UNCONFIRMED": "#F59E0B",
                                    "PENDING_REVIEW": "#F59E0B",
                                    "STOPPED": "#F59E0B",
                                    "DISCARDED": "#94A3B8",
                                    "CANCELED": "#94A3B8",
                                    "SKIPPED": "#94A3B8",
                                    "QUEUED": "#3B82F6",
                                    "READY": "#3B82F6",
                                    "PREPARING": "#3B82F6",
                                    "INITIALIZING": "#3B82F6",
                                    "PLANNING": "#3B82F6",
                                    "CONFIRMED": "#3B82F6",
                                    "PREPARING_APPLY": "#3B82F6",
                                    "APPLYING": "#3B82F6",
                                    "PERFORMING": "#3B82F6",
                                    "DESTROYING": "#3B82F6",
                                    "REPLAN_REQUESTED": "#3B82F6",
                                    "PREPARING_REPLAN": "#3B82F6",
                                    "PENDING": "#3B82F6"
                                }
                            }
                        }
                    }
                }
            },
            {
                "i": "ecc48b2f-5d81-4d26-ab83-88b41bfcd01c",
                "x": 0,
                "y": 4,
                "w": 4,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Resource Changes",
                    "description": "Resources added, changed and deleted each day by this stack's runs. Proposed runs only preview changes, so they are left out",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[stackRuns]}}",
                        "name": "stackRuns",
                        "pluginConfigId": "{{configId}}",
                        "filter": {
                            "multiOperation": "and",
                            "filters": [
                                {
                                    "column": "type",
                                    "operation": "notequals",
                                    "value": "PROPOSED"
                                }
                            ]
                        },
                        "group": {
                            "by": [
                                [
                                    "createdAt",
                                    "byDay"
                                ]
                            ],
                            "aggregate": [
                                {
                                    "type": "sum",
                                    "names": [
                                        "resourcesAdded"
                                    ]
                                },
                                {
                                    "type": "sum",
                                    "names": [
                                        "resourcesChanged"
                                    ]
                                },
                                {
                                    "type": "sum",
                                    "names": [
                                        "resourcesDeleted"
                                    ]
                                }
                            ]
                        },
                        "sort": {
                            "by": [
                                [
                                    "createdAt_byDay",
                                    "asc"
                                ]
                            ]
                        }
                    },
                    "scope": {
                        "scope": "{{scopes.[Spacelift Stacks]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Spacelift Stack]}}"
                    },
                    "variables": [
                        "{{variables.[Spacelift Stack]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "createdAt_byDay",
                                    "type": "temporal",
                                    "title": "Day"
                                },
                                "y": [
                                    {
                                        "field": "resourcesAdded_sum",
                                        "type": "quantitative",
                                        "title": "Added"
                                    },
                                    {
                                        "field": "resourcesChanged_sum",
                                        "type": "quantitative",
                                        "title": "Changed"
                                    },
                                    {
                                        "field": "resourcesDeleted_sum",
                                        "type": "quantitative",
                                        "title": "Deleted"
                                    }
                                ]
                            },
                            "style": {
                                "cartesianStack": "on",
                                "cartesianShowStackedTotals": true,
                                "cartesianBarBorderRadius": 3,
                                "legendPosition": "bottom",
                                "colors": [
                                    "#2BB660",
                                    "#F59E0B",
                                    "#DE0038"
                                ]
                            }
                        }
                    }
                }
            },
            {
                "i": "34b78a80-f018-402c-bb2d-df257425a714",
                "x": 0,
                "y": 7,
                "w": 4,
                "h": 5,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Recent Runs",
                    "description": "Runs and tasks on this stack in the timeframe, newest first",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[stackRuns]}}",
                        "name": "stackRuns",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [
                                [
                                    "createdAt",
                                    "desc"
                                ]
                            ]
                        }
                    },
                    "scope": {
                        "scope": "{{scopes.[Spacelift Stacks]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Spacelift Stack]}}"
                    },
                    "variables": [
                        "{{variables.[Spacelift Stack]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "state[Expanded].rawState",
                                        "title": "State",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "FINISHED": "#2BB660",
                                                "FAILED": "#DE0038",
                                                "UNCONFIRMED": "#F59E0B",
                                                "PENDING_REVIEW": "#F59E0B",
                                                "STOPPED": "#F59E0B",
                                                "DISCARDED": "#94A3B8",
                                                "CANCELED": "#94A3B8",
                                                "SKIPPED": "#94A3B8",
                                                "QUEUED": "#3B82F6",
                                                "READY": "#3B82F6",
                                                "PREPARING": "#3B82F6",
                                                "INITIALIZING": "#3B82F6",
                                                "PLANNING": "#3B82F6",
                                                "CONFIRMED": "#3B82F6",
                                                "PREPARING_APPLY": "#3B82F6",
                                                "APPLYING": "#3B82F6",
                                                "PERFORMING": "#3B82F6",
                                                "DESTROYING": "#3B82F6",
                                                "REPLAN_REQUESTED": "#3B82F6",
                                                "PREPARING_REPLAN": "#3B82F6",
                                                "PENDING": "#3B82F6"
                                            },
                                            "defaultColor": "#3B82F6"
                                        },
                                        "width": 140
                                    },
                                    {
                                        "field": "title",
                                        "title": "Run",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "type",
                                        "title": "Type",
                                        "renderer": {
                                            "type": "badge",
                                            "defaultColor": "#64748B"
                                        }
                                    },
                                    {
                                        "field": "createdAt",
                                        "title": "Started",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    },
                                    {
                                        "field": "duration",
                                        "title": "Duration",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "resourcesAdded",
                                        "title": "Added",
                                        "renderer": {
                                            "type": "number"
                                        },
                                        "align": "right"
                                    },
                                    {
                                        "field": "resourcesChanged",
                                        "title": "Changed",
                                        "renderer": {
                                            "type": "number"
                                        },
                                        "align": "right"
                                    },
                                    {
                                        "field": "resourcesDeleted",
                                        "title": "Deleted",
                                        "renderer": {
                                            "type": "number"
                                        },
                                        "align": "right"
                                    },
                                    {
                                        "field": "triggeredBy",
                                        "title": "Triggered by",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "commitHash",
                                        "title": "Commit",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "url",
                                        "title": "Link",
                                        "renderer": {
                                            "type": "link"
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableCellPadding": 6,
                                "richTableRowHighlight": {
                                    "field": "state[Expanded].rawState",
                                    "colors": {
                                        "FAILED": "rgba(222,0,56,0.08)"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        ]
    }
}
