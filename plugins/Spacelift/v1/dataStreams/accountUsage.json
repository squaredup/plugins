{
    "name": "accountUsage",
    "displayName": "Account Usage",
    "description": "Run minutes, seats and self-hosted workers used in the current billing period",
    "tags": [
        "Capacity",
        "Account"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "post",
        "endpointPath": "graphql",
        "postBody": {
            "query": "query AccountUsage { usage { billingPeriodStart billingPeriodEnd usedMinutes allowedMinutes usedPrivateMinutes usedPublicMinutes usedSeats allowedSeats usedWorkers } }"
        },
        "postRequestScript": "accountUsage.js",
        "errorHandling": {
            "type": "script",
            "script": "errorHandling/graphql.js"
        }
    },
    "matches": "none",
    "metadata": [
        {
            "name": "usedMinutes",
            "displayName": "Run minutes used",
            "shape": [
                "number",
                {
                    "thousandsSeparator": true
                }
            ],
            "role": "value"
        },
        {
            "name": "allowedMinutes",
            "displayName": "Run minutes allowed",
            "shape": [
                "number",
                {
                    "thousandsSeparator": true
                }
            ]
        },
        {
            "name": "minutesUsedPercent",
            "displayName": "Run minutes used (%)",
            "shape": [
                "percent",
                {
                    "decimalPlaces": 0
                }
            ]
        },
        {
            "name": "usedPublicMinutes",
            "displayName": "Public worker minutes",
            "shape": [
                "number",
                {
                    "thousandsSeparator": true
                }
            ]
        },
        {
            "name": "usedPrivateMinutes",
            "displayName": "Private worker minutes",
            "shape": [
                "number",
                {
                    "thousandsSeparator": true
                }
            ]
        },
        {
            "name": "usedSeats",
            "displayName": "Seats used",
            "shape": "number"
        },
        {
            "name": "allowedSeats",
            "displayName": "Seats allowed",
            "shape": "number"
        },
        {
            "name": "seatsUsedPercent",
            "displayName": "Seats used (%)",
            "shape": [
                "percent",
                {
                    "decimalPlaces": 0
                }
            ]
        },
        {
            "name": "usedWorkers",
            "displayName": "Peak self-hosted workers",
            "shape": "number"
        },
        {
            "name": "billingPeriodStart",
            "displayName": "Billing period start",
            "shape": "date"
        },
        {
            "name": "billingPeriodEnd",
            "displayName": "Billing period end",
            "shape": "date"
        }
    ],
    "timeframes": false
}
