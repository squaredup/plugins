{
    "name": "viewer",
    "displayName": "Current User",
    "description": "The Spacelift identity the API key signs in as",
    "tags": ["Account"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "post",
        "endpointPath": "graphql",
        "postBody": {
            "query": "query Viewer { viewer { id name admin } }"
        },
        "postRequestScript": "viewer.js",
        "errorHandling": {
            "type": "script",
            "script": "errorHandling/graphql.js"
        }
    },
    "matches": "none",
    "metadata": [
        {
            "name": "name",
            "displayName": "Name",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "admin",
            "displayName": "Admin",
            "shape": "boolean"
        },
        {
            "name": "userId",
            "displayName": "ID",
            "shape": "string",
            "visible": false
        }
    ],
    "timeframes": false,
    "visibility": {
        "type": "hidden"
    }
}
