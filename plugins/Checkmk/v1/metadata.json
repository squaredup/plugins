{
    "name": "checkmk",
    "displayName": "Checkmk",
    "version": "1.0.0",
    "author": { "name": "@shawn149", "type": "community" },
    "description": "Monitor your Checkmk hosts and services, track their states and surface current problems.",
    "category": "Monitoring",
    "type": "hybrid",
    "schemaVersion": "2.1",
    "importNotSupported": false,
    "restrictedToPlatforms": [],
    "keywords": ["checkmk", "check_mk", "nagios", "livestatus", "monitoring", "infrastructure", "hosts", "services"],
    "objectTypes": ["Host"],
    "links": [
        {
            "category": "documentation",
            "url": "https://github.com/squaredup/plugins/blob/main/plugins/Checkmk/v1/docs/README.md",
            "label": "Help adding this plugin"
        },
        {
            "category": "source",
            "url": "https://github.com/squaredup/plugins",
            "label": "Repository"
        }
    ],
    "screenshots": [
        "https://github.com/squaredup/plugins/blob/main/plugins/Checkmk/v1/screenshots/overview.png",
        "https://github.com/squaredup/plugins/blob/main/plugins/Checkmk/v1/screenshots/host.png"
    ],
    "base": {
        "plugin": "WebAPI",
        "majorVersion": "1",
        "config": {
            "baseUrl": "{{siteUrl.trim().replace(/[/]+$/, '').replace(/[/]check_mk([/].*)?$/i, '')}}/check_mk/api/1.0",
            "authMode": "none",
            "headers": [
                { "key": "Authorization", "value": "Bearer {{automationUser.trim()}} {{automationSecret.trim()}}" },
                { "key": "Accept", "value": "application/json" }
            ],
            "queryArgs": []
        }
    }
}
