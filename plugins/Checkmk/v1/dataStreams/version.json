{
    "name": "version",
    "displayName": "Version",
    "description": "Checkmk site name, version and edition",
    "tags": ["Info"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/version",
        "errorHandling": { "type": "script", "script": "errorHandling/checkmkError.js" }
    },
    "matches": "none",
    "visibility": { "type": "hidden" },
    "metadata": [
        { "pattern": ".*" }
    ],
    "timeframes": false
}
