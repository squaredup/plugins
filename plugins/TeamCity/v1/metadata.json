{
    "name": "teamcity",
    "displayName": "TeamCity",
    "version": "1.0.0",
    "author": {
        "name": "SquaredUp",
        "type": "labs"
    },
    "description": "Track build health, success rates, durations, queues and build agents across your TeamCity projects.",
    "category": "CI/CD Tools",
    "type": "hybrid",
    "schemaVersion": "2.1",
    "importNotSupported": false,
    "restrictedToPlatforms": [],
    "keywords": [
        "teamcity",
        "jetbrains",
        "build",
        "ci",
        "continuous integration",
        "cicd",
        "devops",
        "build configuration",
        "build agent",
        "build queue",
        "tests"
    ],
    "objectTypes": [
        "Project",
        "Build Configuration",
        "Agent"
    ],
    "links": [
        {
            "category": "documentation",
            "url": "https://github.com/squaredup/plugins/blob/main/plugins/TeamCity/v1/docs/README.md",
            "label": "Help adding this plugin"
        },
        {
            "category": "source",
            "url": "https://github.com/squaredup/plugins/tree/main/plugins/TeamCity/v1",
            "label": "Repository"
        }
    ],
    "base": {
        "plugin": "WebAPI",
        "majorVersion": "1",
        "config": {
            "baseUrl": "{{ serverUrl.trim().replace(/[/]+$/, '').replace(/[/]app[/]rest$/i, '') }}/app/rest",
            "authMode": "none",
            "headers": [
                {
                    "key": "Authorization",
                    "value": "Bearer {{ accessToken.trim() }}"
                },
                {
                    "key": "Accept",
                    "value": "application/json"
                }
            ],
            "queryArgs": []
        }
    },
    "screenshots": [
        "https://github.com/squaredup/plugins/blob/main/plugins/TeamCity/v1/screenshots/overview.png",
        "https://github.com/squaredup/plugins/blob/main/plugins/TeamCity/v1/screenshots/project.png",
        "https://github.com/squaredup/plugins/blob/main/plugins/TeamCity/v1/screenshots/buildConfiguration.png",
        "https://github.com/squaredup/plugins/blob/main/plugins/TeamCity/v1/screenshots/agent.png"
    ]
}
