{
    "name": "projects",
    "displayName": "Projects",
    "description": "TeamCity projects and subprojects, with their parent project and archived status",
    "tags": [
        "Inventory"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "projects",
        "getArgs": [
            {
                "key": "locator",
                "value": "affectedProject:(id:_Root),count:1000"
            },
            {
                "key": "fields",
                "value": "nextHref,project(id,name,parentProjectId,archived,webUrl,parentProject(name))"
            }
        ],
        "paging": {
            "mode": "nextUrl",
            "in": {
                "realm": "payload",
                "path": "nextHref"
            }
        },
        "postRequestScript": "pagedList.js",
        "expandInnerObjects": true
    },
    "matches": "none",
    "visibility": {
        "type": "hidden"
    },
    "metadata": [
        {
            "name": "id",
            "displayName": "ID",
            "shape": "string",
            "role": "id"
        },
        {
            "name": "name",
            "displayName": "Name",
            "shape": "string",
            "visible": false
        },
        {
            "name": "parentProject.name",
            "displayName": "Parent Project",
            "shape": "string"
        },
        {
            "name": "fullName",
            "displayName": "Project",
            "shape": "string",
            "role": "label",
            "computed": true,
            "valueExpression": "{{ $['parentProjectId'] && $['parentProjectId'] !== '_Root' && $['parentProject.name'] ? `${$['parentProject.name']} / ${$['name']}` : $['name'] }}"
        },
        {
            "name": "parentProjectId",
            "displayName": "Parent Project ID",
            "shape": "string"
        },
        {
            "name": "archived",
            "displayName": "Archived",
            "shape": "boolean"
        },
        {
            "name": "webUrl",
            "displayName": "URL",
            "shape": ["url", { "label": "Open in TeamCity" }]
        }
    ],
    "timeframes": false
}
