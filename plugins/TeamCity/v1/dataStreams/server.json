{
    "name": "server",
    "displayName": "Server",
    "description": "TeamCity server version, build number and start time",
    "tags": [
        "Server"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "server",
        "getArgs": [
            {
                "key": "fields",
                "value": "version,versionMajor,versionMinor,buildNumber,buildDate,startTime,currentTime,webUrl,role"
            }
        ]
    },
    "matches": "none",
    "metadata": [
        {
            "name": "version",
            "displayName": "Version",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "buildNumber",
            "displayName": "Build Number",
            "shape": "string"
        },
        {
            "name": "buildDate",
            "displayName": "Build Date",
            "shape": ["date", { "inputPattern": "yyyyMMdd'T'HHmmssxx" }]
        },
        {
            "name": "startTime",
            "displayName": "Started",
            "shape": ["date", { "inputPattern": "yyyyMMdd'T'HHmmssxx" }]
        },
        {
            "name": "role",
            "displayName": "Node Role",
            "shape": "string"
        },
        {
            "name": "webUrl",
            "displayName": "URL",
            "shape": ["url", { "label": "Open TeamCity" }]
        }
    ],
    "timeframes": false
}
