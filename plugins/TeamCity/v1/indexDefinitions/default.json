{
    "steps": [
        {
            "name": "projects",
            "dataStream": {
                "name": "projects"
            },
            "timeframe": "none",
            "objectMapping": {
                "id": "id",
                "name": "fullName",
                "type": {
                    "value": "Project"
                },
                "properties": [
                    {
                        "shortName": "name"
                    },
                    "parentProjectId",
                    {
                        "parentProjectName": "parentProject.name"
                    },
                    "archived",
                    "webUrl"
                ]
            }
        },
        {
            "name": "buildTypes",
            "dataStream": {
                "name": "buildTypes"
            },
            "timeframe": "none",
            "objectMapping": {
                "id": "id",
                "name": "fullName",
                "type": {
                    "value": "Build Configuration"
                },
                "properties": [
                    {
                        "shortName": "name"
                    },
                    "projectId",
                    "projectName",
                    "paused",
                    "webUrl"
                ]
            }
        },
        {
            "name": "agents",
            "dataStream": {
                "name": "agentList"
            },
            "timeframe": "none",
            "objectMapping": {
                "id": "id",
                "name": "name",
                "type": {
                    "value": "Agent"
                },
                "properties": [
                    {
                        "poolName": "pool.name"
                    },
                    {
                        "poolId": "pool.id"
                    },
                    {
                        "ipAddress": "ip"
                    },
                    {
                        "osType": "environment.osType"
                    },
                    {
                        "osName": "environment.osName"
                    }
                ]
            },
            "optional": true
        }
    ]
}
