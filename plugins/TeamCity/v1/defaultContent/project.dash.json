                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "finishDate_byDay",
                                    "type": "temporal",
                                    "title": "Day"
                                },
                                "y": {
                                    "field": "count",
                                    "type": "quantitative",
                                    "title": "Builds"
                                },
                                "series": {
                                    "field": "status_uniqueValues",
                                    "type": "nominal",
                                    "title": "Status"
                                }
