                                    {
                                        "field": "duration_mean",
                                        "type": "quantitative",
                                        "title": "Build Duration"
                                    },
                                    {
                                        "field": "queueTime_mean",
                                        "type": "quantitative",
                                        "title": "Queue Time"
                                    }
                                ]
                            },
                            "style": {
                                "legendPosition": "bottom"
                            }
                        }
                    }
