                    "_type": "tile/data-stream",
                    "title": "Average Build Duration",
                    "description": "Mean build duration and time spent queued per day, excluding composite (pipeline head) builds",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[builds]}}",
                        "name": "builds",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "project": {
                                "variable": "{{variables.[TeamCity Project]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[TeamCity Projects]}}"
                            }
                        },
                        "filter": {
                            "multiOperation": "and",
                            "filters": [
                                {
                                    "column": "composite",
                                    "operation": "equals",
                                    "value": "false"
                                }
                            ]
                        },
                        "group": {
                            "by": [
                                [
                                    "finishDate",
                                    "byDay"
                                ]
                            ],
                            "aggregate": [
                                {
                                    "type": "mean",
                                    "names": [
                                        "duration"
                                    ]
                                },
                                {
                                    "type": "mean",
                                    "names": [
                                        "queueTime"
                                    ]
                                }
                            ]
                        },
                        "sort": {
                            "by": [
                                [
                                    "finishDate_byDay",
                                    "asc"
                                ]
                            ]
                        }
                    },
                    "variables": [
                        "{{variables.[TeamCity Project]}}"
                    ],
