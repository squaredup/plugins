                "config": {
                    "_type": "tile/data-stream",
                    "title": "Builds per Day",
                    "description": "Finished builds per day by status, excluding composite (pipeline head) builds",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[builds]}}",
                        "name": "builds",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "project": {
                                "variable": "{{variables.[TeamCity Project]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[TeamCity Projects]}}"
                            }
                        },
                        "filter": {
                            "multiOperation": "and",
                            "filters": [
                                {
                                    "column": "composite",
                                    "operation": "equals",
                                    "value": "false"
                                }
                            ]
                        },
                        "group": {
                            "by": [
                                [
                                    "finishDate",
                                    "byDay"
                                ],
                                [
                                    "status",
                                    "uniqueValues"
                                ]
