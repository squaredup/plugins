                "config": {
                    "_type": "tile/data-stream",
                    "title": "Success Rate by Day",
                    "description": "Share of builds finished each day that succeeded",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[builds]}}",
                        "name": "builds",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "buildConfiguration": {
                                "variable": "{{variables.[TeamCity Build Configuration]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[TeamCity Build Configurations]}}"
                            }
                        },
                        "sql": "SELECT STRFTIME(DATE_TRUNC('day', \"finishDate\"), '%Y-%m-%dT%H:%M:%SZ') AS \"day\", ROUND(CAST(COUNT(*) FILTER (WHERE \"status[Expanded].rawState\" = 'SUCCESS') AS DOUBLE) * 100 / COUNT(*), 1) AS \"successRate\" FROM \"dataset\" WHERE \"finishDate\" IS NOT NULL GROUP BY 1 ORDER BY 1"
                    },
                    "variables": [
                        "{{variables.[TeamCity Build Configuration]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "line",
                            "encoding": {
                                "x": {
                                    "field": "day",
                                    "type": "temporal",
                                    "title": "Day"
                                },
                                "y": {
                                    "field": "successRate",
                                    "type": "quantitative",
                                    "title": "Success Rate"
                                }
                            },
                            "style": {
                                "cartesianYAxisRangeMode": "percentage",
                                "cartesianTooltipTemplate": "{{{{raw}}}}{{value}}%{{{{/raw}}}}"
                            }
                        }
                    }
