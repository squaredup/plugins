                                "cartesianStack": "on",
                                "mappedColors": {
                                    "success": "#259A51",
                                    "error": "#DE0038",
                                    "failure": "#DE0038",
                                    "unknown": "#9CA3AF"
                                }
                            }
                        }
                    }
                }
