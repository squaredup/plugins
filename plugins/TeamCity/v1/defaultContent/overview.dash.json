                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Builds per Day",
                    "description": "Finished builds per day by status, excluding composite (pipeline head) builds",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[builds]}}",
                        "name": "builds",
                        "pluginConfigId": "{{configId}}",
                        "filter": {
                            "multiOperation": "and",
                            "filters": [
                                {
                                    "column": "composite",
                                    "operation": "equals",
                                    "value": "false"
                                }
                            ]
                        },
                        "group": {
                            "by": [
                                [
                                    "finishDate",
                                    "byDay"
                                ],
                                [
                                    "status",
                                    "uniqueValues"
                                ]
                            ],
                            "aggregate": [
                                {
                                    "type": "count"
                                }
                            ]
                        },
                        "sort": {
                            "by": [
                                [
                                    "finishDate_byDay",
                                    "asc"
                                ]
                            ]
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "finishDate_byDay",
                                    "type": "temporal",
                                    "title": "Day"
                                },
                                "y": {
                                    "field": "count",
                                    "type": "quantitative",
                                    "title": "Builds"
                                },
                                "series": {
                                    "field": "status_uniqueValues",
                                    "type": "nominal",
                                    "title": "Status"
                                }
                            },
                            "style": {
                                "cartesianStack": "on",
                                "mappedColors": {
                                    "success": "#259A51",
                                    "error": "#DE0038",
                                    "failure": "#DE0038",
                                    "unknown": "#9CA3AF"
                                }
                            }
                        }
                    }
                }
            },
            {
                "i": "8ca2e192-ee5f-4258-9228-dac6993fc01e",
                "x": 2,
                "y": 5,
                "w": 2,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Average Build Duration",
                    "description": "Mean build duration and time spent queued per day, excluding composite (pipeline head) builds",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[builds]}}",
                        "name": "builds",
                        "pluginConfigId": "{{configId}}",
                        "filter": {
                            "multiOperation": "and",
                            "filters": [
                                {
                                    "column": "composite",
                                    "operation": "equals",
                                    "value": "false"
                                }
                            ]
                        },
                        "group": {
                            "by": [
                                [
                                    "finishDate",
                                    "byDay"
                                ]
                            ],
                            "aggregate": [
                                {
                                    "type": "mean",
                                    "names": [
                                        "duration"
                                    ]
                                },
                                {
                                    "type": "mean",
                                    "names": [
                                        "queueTime"
                                    ]
                                }
                            ]
                        },
                        "sort": {
                            "by": [
                                [
                                    "finishDate_byDay",
                                    "asc"
                                ]
                            ]
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "line",
                            "encoding": {
                                "x": {
                                    "field": "finishDate_byDay",
                                    "type": "temporal",
                                    "title": "Day"
                                },
                                "y": [
                                    {
                                        "field": "duration_mean",
                                        "type": "quantitative",
                                        "title": "Build Duration"
                                    },
                                    {
                                        "field": "queueTime_mean",
                                        "type": "quantitative",
                                        "title": "Queue Time"
                                    }
                                ]
                            },
                            "style": {
                                "legendPosition": "bottom"
                            }
                        }
                    }
                }
            },
