                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Success Rate",
                    "description": "Share of builds finished in the timeframe that succeeded, excluding composite (pipeline head) builds",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[builds]}}",
                        "name": "builds",
                        "pluginConfigId": "{{configId}}",
                        "sql": "SELECT ROUND(CAST(COUNT(*) FILTER (WHERE \"status[Expanded].rawState\" = 'SUCCESS') AS DOUBLE) * 100 / NULLIF(COUNT(*), 0), 1) AS \"successRate\" FROM \"dataset\" WHERE COALESCE(CAST(\"composite\" AS VARCHAR), 'false') <> 'true'"
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "gauge",
                            "encoding": {
                                "value": {
                                    "field": "successRate",
                                    "type": "quantitative",
                                    "title": "Success Rate"
                                }
                            },
                            "style": {
                                "gaugeMin": 0,
                                "gaugeMax": 100,
                                "gaugeShowLabelText": false,
                                "labelFormat": "{{{{raw}}}}{{value}}%{{{{/raw}}}}",
                                "gaugeBands": [
                                    {
                                        "to": 0.7,
                                        "color": "#DE0038"
                                    },
                                    {
                                        "to": 0.9,
                                        "color": "#E18700"
                                    },
                                    {
                                        "to": 1,
                                        "color": "#259A51"
                                    }
                                ]
                            }
                        }
                    }
                }
            },
