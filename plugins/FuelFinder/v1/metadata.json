{
    "name": "fuel-finder",
    "displayName": "Fuel Finder",
    "version": "1.0.0",
    "author": {
        "name": "@clarkd",
        "type": "community"
    },
    "description": "Monitor UK road fuel prices near a location via the UK government's Fuel Finder open data API - find the cheapest petrol and diesel forecourts within a radius of your postcode and track price changes.",
    "category": "Utility",
    "type": "hybrid",
    "schemaVersion": "2.1",
    "importNotSupported": false,
    "restrictedToPlatforms": [],
    "keywords": [
        "fuel",
        "petrol",
        "diesel",
        "fuel prices",
        "forecourt",
        "uk",
        "gov.uk",
        "fuel finder"
    ],
    "objectTypes": ["Fuel Station"],
    "links": [
        {
            "category": "documentation",
            "url": "https://github.com/squaredup/plugins/blob/main/plugins/FuelFinder/v1/docs/README.md",
            "label": "Help adding this plugin"
        },
        {
            "category": "source",
            "url": "https://github.com/squaredup/plugins/tree/main/plugins/FuelFinder",
            "label": "Repository"
        }
    ],
    "base": {
        "plugin": "WebAPI",
        "majorVersion": "1",
        "config": {
            "baseUrl": "https://www.fuel-finder.service.gov.uk",
            "authMode": "oauth2",
            "oauth2GrantType": "clientCredentials",
            "oauth2TokenUrl": "https://www.fuel-finder.service.gov.uk/api/v1/oauth/generate_access_token",
            "oauth2ClientId": "{{clientId}}",
            "oauth2ClientSecret": "{{clientSecret}}",
            "oauth2ClientSecretLocationDuringAuth": "body"
        }
    }
}
