{
    "name": "fuelPrices",
    "displayName": "Fuel Prices",
    "description": "Current price per fuel type at each fuel station, optionally with distance from a location",
    "tags": [
        "Fuel"
    ],
    "baseDataSourceName": "httpRequestScoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "favicon.ico",
        "paging": {
            "mode": "none"
        },
        "postRequestScript": "fuelPrices.js"
    },
    "matches": {
        "sourceType": {
            "type": "oneOf",
            "values": [
                "Fuel Station"
            ]
        }
    },
    "ui": [
        {
            "type": "text",
            "name": "latitude",
            "label": "Latitude (optional)",
            "placeholder": "e.g. 51.5074"
        },
        {
            "type": "text",
            "name": "longitude",
            "label": "Longitude (optional)",
            "placeholder": "e.g. -0.1278"
        },
        {
            "type": "number",
            "name": "radiusMiles",
            "label": "Radius in miles (optional)"
        }
    ],
    "metadata": [
        {
            "name": "stationId",
            "displayName": "Station ID",
            "shape": "string",
            "visible": false
        },
        {
            "name": "stationName",
            "displayName": "Station",
            "shape": "string",
            "role": "label"
        },
        {
            "sourceId": "stationId",
            "sourceType": "Fuel Station",
            "name": "stationName"
        },
        {
            "name": "fuelType",
            "displayName": "Fuel",
            "shape": "string",
            "formatExpression": "{{ ({ E10: 'Petrol (E10)', E5: 'Super unleaded (E5)', B7_STANDARD: 'Diesel (B7)', B7_PREMIUM: 'Premium diesel (B7)' })[$['fuelType']] || $['fuelType'] }}"
        },
        {
            "name": "price",
            "displayName": "Price (p/litre)",
            "shape": [
                "number",
                {
                    "decimalPlaces": 1
                }
            ],
            "role": "value"
        },
        {
            "name": "lastUpdated",
            "displayName": "Price last updated",
            "shape": "date"
        },
        {
            "name": "distanceMiles",
            "displayName": "Distance (miles)",
            "shape": [
                "number",
                {
                    "decimalPlaces": 1
                }
            ]
        },
        {
            "name": "brand",
            "displayName": "Brand",
            "shape": "string"
        },
        {
            "name": "city",
            "displayName": "City",
            "shape": "string"
        },
        {
            "name": "postcodeArea",
            "displayName": "Postcode area",
            "shape": "string"
        },
        {
            "name": "isMotorway",
            "displayName": "Motorway",
            "shape": "boolean"
        },
        {
            "name": "isSupermarket",
            "displayName": "Supermarket",
            "shape": "boolean"
        },
        {
            "name": "latitude",
            "displayName": "Latitude",
            "shape": "number",
            "visible": false
        },
        {
            "name": "longitude",
            "displayName": "Longitude",
            "shape": "number",
            "visible": false
        }
    ],
    "timeframes": false
}
