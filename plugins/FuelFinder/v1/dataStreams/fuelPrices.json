{
    "name": "fuelPrices",
    "displayName": "Fuel Prices",
    "description": "Current price per fuel type at each fuel station, one row per station, optionally with distance from a location",
    "tags": [
        "Fuel"
    ],
    "baseDataSourceName": "httpRequestScoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "favicon.ico",
        "paging": {
            "mode": "none"
        },
        "postRequestScript": "fuelPrices.js"
    },
    "matches": {
        "sourceType": {
            "type": "oneOf",
            "values": [
                "Fuel Station"
            ]
        }
    },
    "ui": [
        {
            "type": "text",
            "name": "latitude",
            "label": "Latitude (optional)",
            "placeholder": "e.g. 51.5074"
        },
        {
            "type": "text",
            "name": "longitude",
            "label": "Longitude (optional)",
            "placeholder": "e.g. -0.1278"
        },
        {
            "type": "number",
            "name": "radiusMiles",
            "label": "Radius in miles (optional)"
        }
    ],
    "metadata": [
        {
            "name": "stationId",
            "displayName": "Station ID",
            "shape": "string",
            "visible": false
        },
        {
            "name": "stationName",
            "displayName": "Station",
            "shape": "string",
            "role": "label"
        },
        {
            "sourceId": "stationId",
            "sourceType": "Fuel Station",
            "name": "stationName"
        },
        {
            "name": "brand",
            "displayName": "Brand",
            "shape": "string"
        },
        {
            "name": "city",
            "displayName": "City",
            "shape": "string"
        },
        {
            "name": "postcodeArea",
            "displayName": "Postcode area",
            "shape": "string"
        },
        {
            "name": "distanceMiles",
            "displayName": "Distance (miles)",
            "shape": [
                "number",
                {
                    "decimalPlaces": 1
                }
            ]
        },
        {
            "name": "latitude",
            "displayName": "Latitude",
            "shape": "number",
            "visible": false
        },
        {
            "name": "longitude",
            "displayName": "Longitude",
            "shape": "number",
            "visible": false
        },
        {
            "name": "isMotorway",
            "displayName": "Motorway",
            "shape": "boolean"
        },
        {
            "name": "isSupermarket",
            "displayName": "Supermarket",
            "shape": "boolean"
        },
        {
            "name": "priceE10",
            "displayName": "Petrol E10 (p/litre)",
            "sourceId": "stationId",
            "sourceType": "Fuel Price",
            "objectPropertyPath": "priceE10",
            "shape": [
                "number",
                {
                    "decimalPlaces": 1
                }
            ],
            "role": "value"
        },
        {
            "name": "priceE5",
            "displayName": "Super unleaded E5 (p/litre)",
            "sourceId": "stationId",
            "sourceType": "Fuel Price",
            "objectPropertyPath": "priceE5",
            "shape": [
                "number",
                {
                    "decimalPlaces": 1
                }
            ],
            "role": "value"
        },
        {
            "name": "priceB7",
            "displayName": "Diesel B7 (p/litre)",
            "sourceId": "stationId",
            "sourceType": "Fuel Price",
            "objectPropertyPath": "priceB7",
            "shape": [
                "number",
                {
                    "decimalPlaces": 1
                }
            ],
            "role": "value"
        },
        {
            "name": "priceB7Premium",
            "displayName": "Premium diesel (p/litre)",
            "sourceId": "stationId",
            "sourceType": "Fuel Price",
            "objectPropertyPath": "priceB7Premium",
            "shape": [
                "number",
                {
                    "decimalPlaces": 1
                }
            ],
            "role": "value"
        },
        {
            "name": "pricesUpdated",
            "displayName": "Prices last changed",
            "sourceId": "stationId",
            "sourceType": "Fuel Price",
            "objectPropertyPath": "pricesUpdated",
            "shape": "date"
        }
    ],
    "timeframes": false
}
