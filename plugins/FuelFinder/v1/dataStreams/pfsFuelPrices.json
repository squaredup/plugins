{
    "name": "pfsFuelPrices",
    "displayName": "Fuel Station Prices",
    "description": "Current price per fuel type for every UK fuel station, one row per station",
    "tags": ["Fuel"],
    "visibility": { "type": "hidden" },
    "baseDataSourceName": "httpRequestScoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "api/v1/pfs/fuel-prices",
        "postRequestScript": "pfsFuelPrices.js",
        "paging": {
            "mode": "offset",
            "pageSize": { "realm": "none" },
            "offset": {
                "mode": "page",
                "rowCountIn": { "realm": "payloadArraySize", "path": "499.fuel_prices" },
                "base": 1
            },
            "out": { "realm": "queryArg", "path": "batch-number" }
        }
    },
    "matches": { "sourceType": { "type": "oneOf", "values": ["Fuel Station"] } },
    "metadata": [
        { "name": "node_id", "displayName": "Station ID", "shape": "string", "role": "id" },
        { "name": "name", "displayName": "Name", "shape": "string", "role": "label" },
        { "name": "sourceType", "displayName": "Type", "shape": "string", "visible": false },
        { "name": "brand", "displayName": "Brand", "shape": "string" },
        { "name": "addressLine1", "displayName": "Address", "shape": "string" },
        { "name": "city", "displayName": "City", "shape": "string" },
        { "name": "postcode", "displayName": "Postcode", "shape": "string" },
        { "name": "postcodeArea", "displayName": "Postcode area", "shape": "string" },
        { "name": "latitude", "displayName": "Latitude", "shape": "number", "visible": false },
        { "name": "longitude", "displayName": "Longitude", "shape": "number", "visible": false },
        { "name": "fuelTypes", "displayName": "Fuel types", "shape": ["array", { "itemShape": "string" }] },
        { "name": "amenities", "displayName": "Amenities", "shape": ["array", { "itemShape": "string" }] },
        { "name": "isMotorway", "displayName": "Motorway services", "shape": "boolean" },
        { "name": "isSupermarket", "displayName": "Supermarket", "shape": "boolean" },
        { "name": "priceE10", "displayName": "Petrol E10 (p/litre)", "shape": ["number", { "decimalPlaces": 1 }] },
        { "name": "priceE10ChangedAt", "displayName": "E10 changed at", "shape": "date" },
        { "name": "priceE5", "displayName": "Super unleaded E5 (p/litre)", "shape": ["number", { "decimalPlaces": 1 }] },
        { "name": "priceE5ChangedAt", "displayName": "E5 changed at", "shape": "date" },
        { "name": "priceB7", "displayName": "Diesel B7 (p/litre)", "shape": ["number", { "decimalPlaces": 1 }] },
        { "name": "priceB7ChangedAt", "displayName": "B7 changed at", "shape": "date" },
        { "name": "priceB7Premium", "displayName": "Premium diesel (p/litre)", "shape": ["number", { "decimalPlaces": 1 }] },
        { "name": "priceB7PremiumChangedAt", "displayName": "Premium diesel changed at", "shape": "date" },
        { "name": "pricesUpdated", "displayName": "Prices last changed", "shape": "date" }
    ],
    "timeframes": false
}
