{
    "name": "pfsFuelPrices",
    "displayName": "Fuel Station Prices",
    "description": "Current price per fuel type for every UK fuel station, one row per station",
    "tags": [
        "Fuel"
    ],
    "visibility": {
        "type": "hidden"
    },
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "api/v1/pfs/fuel-prices",
        "postRequestScript": "pfsFuelPrices.js",
        "paging": {
            "mode": "offset",
            "pageSize": {
                "realm": "none"
            },
            "offset": {
                "mode": "page",
                "rowCountIn": {
                    "realm": "payloadArraySize",
                    "path": "499.fuel_prices"
                },
                "base": 1
            },
            "out": {
                "realm": "queryArg",
                "path": "batch-number"
            }
        }
    },
    "matches": "none",
    "metadata": [
        {
            "name": "node_id",
            "displayName": "Station ID",
            "shape": "string",
            "role": "id"
        },
        {
            "name": "name",
            "displayName": "Name",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "sourceType",
            "displayName": "Type",
            "shape": "string",
            "visible": false
        },
        {
            "name": "priceE10",
            "displayName": "Petrol E10 (\u00a3/litre)",
            "shape": [
                "gbp",
                {
                    "decimalPlaces": 3
                }
            ]
        },
        {
            "name": "priceE10ChangedAt",
            "displayName": "E10 changed at",
            "shape": "date"
        },
        {
            "name": "priceE5",
            "displayName": "Super unleaded E5 (\u00a3/litre)",
            "shape": [
                "gbp",
                {
                    "decimalPlaces": 3
                }
            ]
        },
        {
            "name": "priceE5ChangedAt",
            "displayName": "E5 changed at",
            "shape": "date"
        },
        {
            "name": "priceB7",
            "displayName": "Diesel B7 (\u00a3/litre)",
            "shape": [
                "gbp",
                {
                    "decimalPlaces": 3
                }
            ]
        },
        {
            "name": "priceB7ChangedAt",
            "displayName": "B7 changed at",
            "shape": "date"
        },
        {
            "name": "priceB7Premium",
            "displayName": "Premium diesel (\u00a3/litre)",
            "shape": [
                "gbp",
                {
                    "decimalPlaces": 3
                }
            ]
        },
        {
            "name": "priceB7PremiumChangedAt",
            "displayName": "Premium diesel changed at",
            "shape": "date"
        },
        {
            "name": "pricesUpdated",
            "displayName": "Prices last changed",
            "shape": "date"
        }
    ],
    "timeframes": false
}
