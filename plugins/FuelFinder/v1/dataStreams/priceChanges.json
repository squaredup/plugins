{
    "name": "priceChanges",
    "displayName": "Price Changes",
    "description": "Fuel price changes at each fuel station during the timeframe",
    "tags": [
        "Fuel"
    ],
    "baseDataSourceName": "httpRequestScoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "favicon.ico",
        "paging": {
            "mode": "none"
        },
        "postRequestScript": "priceChanges.js"
    },
    "matches": {
        "sourceType": {
            "type": "oneOf",
            "values": [
                "Fuel Price"
            ]
        }
    },
    "metadata": [
        {
            "name": "stationId",
            "displayName": "Station ID",
            "shape": "string",
            "visible": false
        },
        {
            "name": "stationName",
            "displayName": "Station",
            "shape": "string",
            "role": "label"
        },
        {
            "sourceId": "stationId",
            "sourceType": "Fuel Station",
            "name": "stationName"
        },
        {
            "name": "fuelType",
            "displayName": "Fuel",
            "shape": "string",
            "formatExpression": "{{ ({ E10: 'Petrol (E10)', E5: 'Super unleaded (E5)', B7_STANDARD: 'Diesel (B7)', B7_PREMIUM: 'Premium diesel (B7)' })[$['fuelType']] || $['fuelType'] }}"
        },
        {
            "name": "price",
            "displayName": "New price (\u00a3/litre)",
            "shape": [
                "gbp",
                {
                    "decimalPlaces": 3
                }
            ],
            "role": "value"
        },
        {
            "name": "changedAt",
            "displayName": "Changed at",
            "shape": "date",
            "role": "timestamp"
        },
        {
            "name": "brand",
            "displayName": "Brand",
            "shape": "string",
            "sourceId": "stationId",
            "sourceType": "Fuel Station",
            "objectPropertyPath": "brand"
        },
        {
            "name": "postcodeArea",
            "displayName": "Postcode area",
            "shape": "string",
            "sourceId": "stationId",
            "sourceType": "Fuel Station",
            "objectPropertyPath": "postcodeArea"
        }
    ],
    "timeframes": [
        "last24hours",
        "last7days",
        "last30days"
    ]
}
