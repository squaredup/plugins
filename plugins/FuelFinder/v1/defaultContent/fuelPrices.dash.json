                "config": {
                    "_type": "tile/data-stream",
                    "title": "Cheapest Petrol (E10)",
                    "description": "Lowest current E10 price (p/litre) across nearby stations",
                    "timeframe": "none",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[fuelPrices]}}",
                        "name": "fuelPrices",
                        "pluginConfigId": "{{configId}}",
                        "filter": {
                            "multiOperation": "and",
                            "filters": [{ "column": "fuelType", "operation": "equals", "value": "E10" }]
                        },
                        "group": {
