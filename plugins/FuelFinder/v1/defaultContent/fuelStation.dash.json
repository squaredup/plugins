{
    "name": "Fuel Station",
    "schemaVersion": "1.5",
    "timeframe": "last30days",
    "variables": ["{{variables.[Fuel Station]}}"],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "61aa220d-724b-4271-90ac-ac4cdd8aa47f",
                "x": 0,
                "y": 0,
                "w": 1,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Details",
                    "description": "",
                    "timeframe": "none",
                    "activePluginConfigIds": ["{{configId}}"],
                    "variables": ["{{variables.[Fuel Station]}}"],
                    "dataStream": {
                        "id": "datastream-properties",
                        "name": "properties"
                    },
                    "scope": {
                        "scope": "{{scopes.[Fuel Stations]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Fuel Station]}}"
                    },
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": true,
                                "columnOrder": [
                                    "name",
                                    "brand",
                                    "addressLine1",
                                    "city",
                                    "postcode",
                                    "distanceMiles",
                                    "fuelTypes",
                                    "amenities",
                                    "isMotorway",
                                    "isSupermarket"
                                ],
                                "hiddenColumns": [
                                    "id",
                                    "links",
                                    "type",
                                    "label",
                                    "sourceId",
                                    "sourceType",
                                    "latitude",
                                    "longitude"
                                ]
                            }
                        }
                    }
                }
            },
            {
                "i": "7c3ac4b0-34fc-487b-a6e5-3bb3f80c9f2b",
                "x": 1,
                "y": 0,
                "w": 3,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Current prices",
                    "description": "",
                    "timeframe": "none",
                    "activePluginConfigIds": ["{{configId}}"],
                    "variables": ["{{variables.[Fuel Station]}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[fuelPrices]}}",
                        "name": "fuelPrices",
                        "pluginConfigId": "{{configId}}",
                        "sort": { "by": [["price", "asc"]] }
                    },
                    "scope": {
                        "scope": "{{scopes.[Fuel Stations]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Fuel Station]}}"
                    },
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": ["fuelType", "price", "lastUpdated"],
                                "hiddenColumns": ["stationId", "stationName", "distanceMiles"]
                            }
                        }
                    }
                }
            },
            {
                "i": "9f3b0d35-330e-4902-84a6-47ca328f0685",
                "x": 1,
                "y": 2,
                "w": 3,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Recent price changes",
                    "description": "",
                    "activePluginConfigIds": ["{{configId}}"],
                    "variables": ["{{variables.[Fuel Station]}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[priceChanges]}}",
                        "name": "priceChanges",
                        "pluginConfigId": "{{configId}}",
                        "sort": { "by": [["changedAt", "desc"]] }
                    },
                    "scope": {
                        "scope": "{{scopes.[Fuel Stations]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Fuel Station]}}"
                    },
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": ["changedAt", "fuelType", "price"],
                                "hiddenColumns": ["stationId", "stationName"]
                            }
                        }
                    }
                }
            }
        ]
    }
}
