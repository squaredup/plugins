[
    {
        "name": "CrUX Websites",
        "matches": {
            "sourceType": {
                "type": "oneOf",
                "values": [
                    "origin"
                ]
            }
        }
    },
    {
        "name": "CrUX Competitors",
        "matches": {
            "sourceType": {
                "type": "oneOf",
                "values": [
                    "competitor"
                ]
            }
        }
    },
    {
        "name": "CrUX Key Pages",
        "matches": {
            "sourceType": {
                "type": "oneOf",
                "values": [
                    "page"
                ]
            },
            "pageGroup": {
                "type": "equals",
                "value": "Key page"
            }
        }
    },
    {
        "name": "CrUX Pages",
        "matches": {
            "sourceType": {
                "type": "oneOf",
                "values": [
                    "page"
                ]
            }
        },
        "variable": {
            "name": "page",
            "allowMultipleSelection": false,
            "default": "none",
            "type": "object"
        }
    }
]
