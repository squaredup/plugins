                "config": {
                    "_type": "tile/data-stream",
                    "title": "Your Site vs Competitors",
                    "description": "Loading speed (LCP), responsiveness (INP) and visual stability (CLS) on phone for your site and each competitor, as met or beaten by 3 in 4 visits, with the share of good visits. Empty until you add competitors to the data source.",
                    "activePluginConfigIds": [
