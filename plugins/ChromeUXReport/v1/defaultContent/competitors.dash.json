    "dashboard": {
        "_type": "layout/grid",
        "columns": 12,
        "version": 1,
        "contents": [
            {
                "i": "719c1c7f-bee6-4029-8572-599ac0fe26e1",
                "x": 0,
                "y": 0,
                "w": 12,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Your site vs competitors",
                    "description": "Core Web Vitals on phone over the last 28 days for your site and each competitor, competitors ordered by LCP. Empty until you add competitors to the data source.",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "datastream-sql",
                        "dataSourceConfig": {
                            "version": "2.0",
                            "sql": "SELECT site, kind, assessment, lcp, lcpGood, inp, inpGood, cls, clsGood\nFROM (\n  SELECT replace(replace(target, 'https://', ''), 'http://', '') AS site, 'Your site' AS kind, 1 AS kindOrder, * FROM (SELECT target,\n    CASE WHEN bool_and(rating = 'success') FILTER (WHERE isCoreWebVital) THEN 'Passed' ELSE 'Failed' END AS assessment,\n    max(CASE WHEN metric = 'LCP' THEN CASE WHEN metric = 'CLS' THEN printf('%.2f', p75) WHEN p75 >= 1000 THEN printf('%.2f s', p75 / 1000) ELSE printf('%d ms', CAST(round(p75) AS BIGINT)) END END) AS lcp, max(CASE WHEN metric = 'LCP' THEN CAST(good AS DOUBLE) END) AS lcpGood,\n    max(CASE WHEN metric = 'INP' THEN CASE WHEN metric = 'CLS' THEN printf('%.2f', p75) WHEN p75 >= 1000 THEN printf('%.2f s', p75 / 1000) ELSE printf('%d ms', CAST(round(p75) AS BIGINT)) END END) AS inp, max(CASE WHEN metric = 'INP' THEN CAST(good AS DOUBLE) END) AS inpGood,\n    max(CASE WHEN metric = 'CLS' THEN CASE WHEN metric = 'CLS' THEN printf('%.2f', p75) WHEN p75 >= 1000 THEN printf('%.2f s', p75 / 1000) ELSE printf('%d ms', CAST(round(p75) AS BIGINT)) END END) AS cls, max(CASE WHEN metric = 'CLS' THEN CAST(good AS DOUBLE) END) AS clsGood,\n    max(CASE WHEN metric = 'LCP' THEN p75 END) AS lcpSort\n  FROM own GROUP BY target)\n  UNION ALL\n  SELECT replace(replace(target, 'https://', ''), 'http://', '') AS site, 'Competitor' AS kind, 2 AS kindOrder, * FROM (SELECT target,\n    CASE WHEN bool_and(rating = 'success') FILTER (WHERE isCoreWebVital) THEN 'Passed' ELSE 'Failed' END AS assessment,\n    max(CASE WHEN metric = 'LCP' THEN CASE WHEN metric = 'CLS' THEN printf('%.2f', p75) WHEN p75 >= 1000 THEN printf('%.2f s', p75 / 1000) ELSE printf('%d ms', CAST(round(p75) AS BIGINT)) END END) AS lcp, max(CASE WHEN metric = 'LCP' THEN CAST(good AS DOUBLE) END) AS lcpGood,\n    max(CASE WHEN metric = 'INP' THEN CASE WHEN metric = 'CLS' THEN printf('%.2f', p75) WHEN p75 >= 1000 THEN printf('%.2f s', p75 / 1000) ELSE printf('%d ms', CAST(round(p75) AS BIGINT)) END END) AS inp, max(CASE WHEN metric = 'INP' THEN CAST(good AS DOUBLE) END) AS inpGood,\n    max(CASE WHEN metric = 'CLS' THEN CASE WHEN metric = 'CLS' THEN printf('%.2f', p75) WHEN p75 >= 1000 THEN printf('%.2f s', p75 / 1000) ELSE printf('%d ms', CAST(round(p75) AS BIGINT)) END END) AS cls, max(CASE WHEN metric = 'CLS' THEN CAST(good AS DOUBLE) END) AS clsGood,\n    max(CASE WHEN metric = 'LCP' THEN p75 END) AS lcpSort\n  FROM competitors GROUP BY target)\n)\nORDER BY kindOrder, lcpSort",
                            "tables": [
                                {
                                    "tableName": "own",
                                    "config": {
                                        "activePluginConfigIds": [
                                            "{{configId}}"
                                        ],
                                        "dataStream": {
                                            "id": "{{dataStreams.[coreWebVitals]}}",
                                            "name": "coreWebVitals",
                                            "pluginConfigId": "{{configId}}",
                                            "dataSourceConfig": {
                                                "level": "origin",
                                                "formFactor": "PHONE"
                                            }
                                        },
                                        "scope": {
                                            "scope": "{{scopes.[CrUX Origins]}}",
                                            "workspace": "{{workspaceId}}"
                                        },
                                        "timeframe": "none"
                                    }
                                },
                                {
                                    "tableName": "competitors",
                                    "config": {
                                        "activePluginConfigIds": [
                                            "{{configId}}"
                                        ],
                                        "dataStream": {
                                            "id": "{{dataStreams.[coreWebVitals]}}",
                                            "name": "coreWebVitals",
                                            "pluginConfigId": "{{configId}}",
                                            "dataSourceConfig": {
                                                "level": "origin",
                                                "formFactor": "PHONE"
                                            }
                                        },
                                        "scope": {
                                            "scope": "{{scopes.[CrUX Competitors]}}",
                                            "workspace": "{{workspaceId}}"
                                        },
                                        "timeframe": "none"
                                    }
                                }
                            ]
                        },
                        "metadata": [
                            {
                                "name": "site",
                                "displayName": "Site",
                                "shape": "string",
                                "role": "label"
                            },
                            {
