                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "datastream-sql",
                        "dataSourceConfig": {
                            "version": "2.0",
                            "sql": "SELECT site, kind, assessment, lcp, lcpGood, inp, inpGood, cls, clsGood\nFROM (\n  SELECT replace(replace(target, 'https://', ''), 'http://', '') AS site, 'Your site' AS kind, 1 AS kindOrder, * FROM (SELECT target,\n    CASE bool_and(rating = 'success') FILTER (WHERE isCoreWebVital) WHEN true THEN 'Passed' WHEN false THEN 'Failed' ELSE 'No data' END AS assessment,\n    max(CASE WHEN metric = 'LCP' THEN CASE WHEN metric = 'CLS' THEN printf('%.2f', p75) WHEN p75 >= 1000 THEN printf('%.2f s', p75 / 1000) ELSE printf('%d ms', CAST(round(p75) AS BIGINT)) END END) AS lcp, max(CASE WHEN metric = 'LCP' THEN CAST(good AS DOUBLE) END) AS lcpGood,\n    max(CASE WHEN metric = 'INP' THEN CASE WHEN metric = 'CLS' THEN printf('%.2f', p75) WHEN p75 >= 1000 THEN printf('%.2f s', p75 / 1000) ELSE printf('%d ms', CAST(round(p75) AS BIGINT)) END END) AS inp, max(CASE WHEN metric = 'INP' THEN CAST(good AS DOUBLE) END) AS inpGood,\n    max(CASE WHEN metric = 'CLS' THEN CASE WHEN metric = 'CLS' THEN printf('%.2f', p75) WHEN p75 >= 1000 THEN printf('%.2f s', p75 / 1000) ELSE printf('%d ms', CAST(round(p75) AS BIGINT)) END END) AS cls, max(CASE WHEN metric = 'CLS' THEN CAST(good AS DOUBLE) END) AS clsGood,\n    max(CASE WHEN metric = 'LCP' THEN p75 END) AS lcpSort\n  FROM own GROUP BY target)\n  UNION ALL\n  SELECT replace(replace(target, 'https://', ''), 'http://', '') AS site, 'Competitor' AS kind, 2 AS kindOrder, * FROM (SELECT target,\n    CASE bool_and(rating = 'success') FILTER (WHERE isCoreWebVital) WHEN true THEN 'Passed' WHEN false THEN 'Failed' ELSE 'No data' END AS assessment,\n    max(CASE WHEN metric = 'LCP' THEN CASE WHEN metric = 'CLS' THEN printf('%.2f', p75) WHEN p75 >= 1000 THEN printf('%.2f s', p75 / 1000) ELSE printf('%d ms', CAST(round(p75) AS BIGINT)) END END) AS lcp, max(CASE WHEN metric = 'LCP' THEN CAST(good AS DOUBLE) END) AS lcpGood,\n    max(CASE WHEN metric = 'INP' THEN CASE WHEN metric = 'CLS' THEN printf('%.2f', p75) WHEN p75 >= 1000 THEN printf('%.2f s', p75 / 1000) ELSE printf('%d ms', CAST(round(p75) AS BIGINT)) END END) AS inp, max(CASE WHEN metric = 'INP' THEN CAST(good AS DOUBLE) END) AS inpGood,\n    max(CASE WHEN metric = 'CLS' THEN CASE WHEN metric = 'CLS' THEN printf('%.2f', p75) WHEN p75 >= 1000 THEN printf('%.2f s', p75 / 1000) ELSE printf('%d ms', CAST(round(p75) AS BIGINT)) END END) AS cls, max(CASE WHEN metric = 'CLS' THEN CAST(good AS DOUBLE) END) AS clsGood,\n    max(CASE WHEN metric = 'LCP' THEN p75 END) AS lcpSort\n  FROM competitors GROUP BY target)\n)\nORDER BY kindOrder, lcpSort",
                            "tables": [
                                {
                                    "tableName": "own",
                                    "config": {
                                        "activePluginConfigIds": [
                                            "{{configId}}"
                                        ],
                                        "dataStream": {
                                            "id": "{{dataStreams.[coreWebVitals]}}",
                                            "name": "coreWebVitals",
                                            "pluginConfigId": "{{configId}}",
