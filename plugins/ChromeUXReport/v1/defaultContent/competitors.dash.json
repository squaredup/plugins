                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Who Is Improving",
                    "description": "Loading speed (LCP) on phone for each site now against four weeks earlier, as met or beaten by 3 in 4 visits. Lower is better, and changes under 2% count as the same.",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "datastream-sql",
                        "dataSourceConfig": {
                            "version": "2.0",
                            "sql": "WITH ranked AS (\n  SELECT replace(replace(target, 'https://', ''), 'http://', '') AS site, 1 AS labelOrder, metric, periodEnd, p75, max(CAST(periodEnd AS DATE)) OVER (PARTITION BY target, metric) AS latest FROM own WHERE p75 IS NOT NULL AND metric = 'LCP'\n  UNION ALL\n  SELECT replace(replace(target, 'https://', ''), 'http://', '') AS site, 2 AS labelOrder, metric, periodEnd, p75, max(CAST(periodEnd AS DATE)) OVER (PARTITION BY target, metric) AS latest FROM competitors WHERE p75 IS NOT NULL AND metric = 'LCP'\n), paired AS (\n  SELECT site, labelOrder, metric,\n    max(CASE WHEN CAST(periodEnd AS DATE) = latest THEN p75 END) AS now,\n    max(CASE WHEN CAST(periodEnd AS DATE) = latest - INTERVAL 28 DAY THEN p75 END) AS before\n  FROM ranked GROUP BY ALL\n), diffed AS (SELECT *, now - before AS diff FROM paired WHERE now IS NOT NULL AND before IS NOT NULL)\nSELECT site, metric,\n  CASE WHEN metric = 'CLS' THEN printf('%.2f', now)\n       WHEN metric = 'INP' THEN printf('%d ms', CAST(round(now) AS BIGINT))\n       ELSE printf('%.2f s', now / 1000) END AS nowText,\n  CASE WHEN metric = 'CLS' THEN printf('%.2f', before)\n       WHEN metric = 'INP' THEN printf('%d ms', CAST(round(before) AS BIGINT))\n       ELSE printf('%.2f s', before / 1000) END AS beforeText,\n  CASE WHEN metric = 'CLS' THEN printf('%+.2f', diff)\n       WHEN metric = 'INP' THEN printf('%+d ms', CAST(round(diff) AS BIGINT))\n       ELSE printf('%+.2f s', diff / 1000) END AS change,\n  CASE WHEN abs(diff) < 0.02 * nullif(before, 0) OR diff = 0 THEN 'Same' WHEN diff < 0 THEN 'Better' ELSE 'Worse' END AS verdict\nFROM diffed\nORDER BY CASE metric WHEN 'LCP' THEN 1 WHEN 'INP' THEN 2 WHEN 'CLS' THEN 3 WHEN 'FCP' THEN 4 ELSE 5 END, labelOrder, site",
                            "tables": [
                                {
                                    "tableName": "own",
                                    "config": {
                                        "activePluginConfigIds": [
                                            "{{configId}}"
                                        ],
                                        "dataStream": {
                                            "id": "{{dataStreams.[coreWebVitalsHistory]}}",
                                            "name": "coreWebVitalsHistory",
                                            "pluginConfigId": "{{configId}}",
                                            "dataSourceConfig": {
                                                "level": "origin",
                                                "formFactor": "PHONE"
                                            }
                                        },
                                        "scope": {
                                            "scope": "{{scopes.[CrUX Websites]}}",
                                            "workspace": "{{workspaceId}}"
                                        },
                                        "timeframe": "none"
                                    }
                                },
                                {
                                    "tableName": "competitors",
