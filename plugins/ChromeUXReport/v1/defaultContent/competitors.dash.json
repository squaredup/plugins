                            "sql": "SELECT periodEnd, replace(replace(target, 'https://', ''), 'http://', '') AS site, p75 FROM own WHERE metric = 'LCP'\nUNION ALL\nSELECT periodEnd, replace(replace(target, 'https://', ''), 'http://', '') AS site, p75 FROM competitors WHERE metric = 'LCP'\nORDER BY periodEnd, site",
