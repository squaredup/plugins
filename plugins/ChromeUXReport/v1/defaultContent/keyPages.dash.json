                                        "renderer": {
                                            "type": "text"
                                        },
                                        "align": "right"
                                    },
                                    {
                                        "field": "inpRating",
                                        "title": "INP rating",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "Good": "#0CCE6B",
                                                "Needs improvement": "#FFA400",
                                                "Poor": "#FF4E42"
                                            }
                                        }
                                    },
                                    {
