                "y": 0,
                "w": 12,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Key pages",
                    "description": "Each key page on phone over the last 28 days, worst LCP first. Better and worse compare the page with the whole site. Pages without enough phone traffic are left out.",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "datastream-sql",
                        "dataSourceConfig": {
                            "version": "2.0",
                            "sql": "SELECT CASE WHEN regexp_replace(p.target, '^https?://[^/]+', '') = '' THEN '/' ELSE regexp_replace(p.target, '^https?://[^/]+', '') END AS page,\n  max(CASE WHEN p.metric = 'LCP' THEN CASE WHEN p.metric = 'CLS' THEN printf('%.2f', p.p75) WHEN p.p75 >= 1000 THEN printf('%.2f s', p.p75 / 1000) ELSE printf('%d ms', CAST(round(p.p75) AS BIGINT)) END END) AS lcp, max(CASE WHEN p.metric = 'LCP' THEN CASE p.rating WHEN 'success' THEN 'Good' WHEN 'warning' THEN 'Needs improvement' ELSE 'Poor' END END) AS lcpRating, max(CASE WHEN p.metric = 'LCP' THEN CASE\n      WHEN round(p.p75, 2) < round(s.p75, 2) THEN 'Better'\n      WHEN round(p.p75, 2) > round(s.p75, 2) THEN 'Worse' ELSE 'Same' END END) AS lcpVsSite,\n  max(CASE WHEN p.metric = 'INP' THEN CASE WHEN p.metric = 'CLS' THEN printf('%.2f', p.p75) WHEN p.p75 >= 1000 THEN printf('%.2f s', p.p75 / 1000) ELSE printf('%d ms', CAST(round(p.p75) AS BIGINT)) END END) AS inp, max(CASE WHEN p.metric = 'INP' THEN CASE p.rating WHEN 'success' THEN 'Good' WHEN 'warning' THEN 'Needs improvement' ELSE 'Poor' END END) AS inpRating, max(CASE WHEN p.metric = 'INP' THEN CASE\n      WHEN round(p.p75, 2) < round(s.p75, 2) THEN 'Better'\n      WHEN round(p.p75, 2) > round(s.p75, 2) THEN 'Worse' ELSE 'Same' END END) AS inpVsSite,\n  max(CASE WHEN p.metric = 'CLS' THEN CASE WHEN p.metric = 'CLS' THEN printf('%.2f', p.p75) WHEN p.p75 >= 1000 THEN printf('%.2f s', p.p75 / 1000) ELSE printf('%d ms', CAST(round(p.p75) AS BIGINT)) END END) AS cls, max(CASE WHEN p.metric = 'CLS' THEN CASE p.rating WHEN 'success' THEN 'Good' WHEN 'warning' THEN 'Needs improvement' ELSE 'Poor' END END) AS clsRating, max(CASE WHEN p.metric = 'CLS' THEN CASE\n      WHEN round(p.p75, 2) < round(s.p75, 2) THEN 'Better'\n      WHEN round(p.p75, 2) > round(s.p75, 2) THEN 'Worse' ELSE 'Same' END END) AS clsVsSite\nFROM pages p\nJOIN site s ON p.metric = s.metric AND starts_with(p.target, s.target)\nWHERE p.isCoreWebVital\nGROUP BY p.target\nORDER BY max(CASE WHEN p.metric = 'LCP' THEN p.p75 END) DESC",
                            "tables": [
                                {
                                    "tableName": "pages",
                                    "config": {
                                        "activePluginConfigIds": [
                                            "{{configId}}"
                                        ],
                                        "dataStream": {
                                            "id": "{{dataStreams.[coreWebVitals]}}",
                                            "name": "coreWebVitals",
                                            "pluginConfigId": "{{configId}}",
                                            "dataSourceConfig": {
                                                "level": "page",
                                                "formFactor": "PHONE"
                                            }
                                        },
                                        "scope": {
                                            "scope": "{{scopes.[Key pages]}}",
                                            "workspace": "{{workspaceId}}"
                                        },
                                        "timeframe": "none"
                                    }
                                },
                                {
                                    "tableName": "site",
                                    "config": {
                                        "activePluginConfigIds": [
                                            "{{configId}}"
                                        ],
                                        "dataStream": {
                                            "id": "{{dataStreams.[coreWebVitals]}}",
                                            "name": "coreWebVitals",
                                            "pluginConfigId": "{{configId}}",
                                            "dataSourceConfig": {
                                                "level": "origin",
                                                "formFactor": "PHONE"
                                            }
                                        },
                                        "scope": {
                                            "scope": "{{scopes.[CrUX Origins]}}",
                                            "workspace": "{{workspaceId}}"
                                        },
                                        "timeframe": "none"
                                    }
                                }
                            ]
                        },
