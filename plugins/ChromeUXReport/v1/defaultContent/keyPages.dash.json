                    "timeframe": "none",
                    "dataStream": {
                        "id": "datastream-sql",
                        "dataSourceConfig": {
                            "version": "2.0",
                            "sql": "SELECT CASE WHEN regexp_replace(target, '^https?://[^/]+', '') = '' THEN '/' ELSE regexp_replace(target, '^https?://[^/]+', '') END AS page, rating AS state, CASE WHEN pages.metric = 'CLS' THEN printf('%.2f', pages.p75) WHEN pages.p75 >= 1000 THEN printf('%.2f s', pages.p75 / 1000) ELSE printf('%d ms', CAST(round(pages.p75) AS BIGINT)) END AS lcp\nFROM pages WHERE metric = 'LCP'\nORDER BY p75 DESC",
