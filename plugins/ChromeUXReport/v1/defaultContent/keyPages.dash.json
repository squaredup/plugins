                                            "colors": {
                                                "Good": "#0CCE6B",
                                                "Needs improvement": "#FFA400",
                                                "Poor": "#FF4E42"
                                            }
                                        }
                                    },
                                    {
                                        "field": "clsVsLastMonth",
                                        "title": "CLS vs last month",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "Better": "#0CCE6B",
                                                "Same": "#9CA3AF",
                                                "Worse": "#FF4E42"
                                            }
                                        }
                                    }
                                ]
                            }
                        }
                    }
                }
            }
        ]
    }
