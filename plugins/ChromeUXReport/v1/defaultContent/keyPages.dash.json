                                        "title": "INP vs last month",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "Better": "#0CCE6B",
                                                "Same": "#9CA3AF",
                                                "Worse": "#FF4E42"
                                            }
                                        }
                                    },
                                    {
                                        "field": "cls",
                                        "title": "CLS",
                                        "renderer": {
                                            "type": "text"
                                        },
                                        "align": "right"
                                    },
                                    {
                                        "field": "clsRating",
                                        "title": "CLS rating",
                                        "renderer": {
