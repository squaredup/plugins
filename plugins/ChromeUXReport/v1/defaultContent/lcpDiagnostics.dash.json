                "x": 0,
                "y": 2,
                "w": 4,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "LCP element",
                    "description": "Whether the largest element on screen was an image or text on phone and desktop, as a share of visits over the last 28 days.",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "datastream-sql",
                        "dataSourceConfig": {
                            "version": "2.0",
                            "sql": "SELECT device, item, value\nFROM (\n  SELECT 'Phone' AS device, 1 AS deviceOrder, item, CAST(value AS DOUBLE) AS value FROM phone WHERE \"group\" = 'LCP element'\n  UNION ALL\n  SELECT 'Desktop' AS device, 2 AS deviceOrder, item, CAST(value AS DOUBLE) AS value FROM desktop WHERE \"group\" = 'LCP element'\n)\nORDER BY deviceOrder, item",
                            "tables": [
                                {
                                    "tableName": "phone",
                                    "config": {
                                        "activePluginConfigIds": [
                                            "{{configId}}"
                                        ],
                                        "dataStream": {
                                            "id": "{{dataStreams.[pageDiagnostics]}}",
                                            "name": "pageDiagnostics",
                                            "pluginConfigId": "{{configId}}",
                                            "dataSourceConfig": {
                                                "level": "origin",
                                                "formFactor": "PHONE"
                                            }
                                        },
                                        "scope": {
                                            "scope": "{{scopes.[CrUX Origins]}}",
                                            "workspace": "{{workspaceId}}"
                                        },
                                        "timeframe": "none"
                                    }
                                },
                                {
                                    "tableName": "desktop",
                                    "config": {
                                        "activePluginConfigIds": [
                                            "{{configId}}"
                                        ],
                                        "dataStream": {
                                            "id": "{{dataStreams.[pageDiagnostics]}}",
                                            "name": "pageDiagnostics",
                                            "pluginConfigId": "{{configId}}",
                                            "dataSourceConfig": {
                                                "level": "origin",
                                                "formFactor": "DESKTOP"
                                            }
                                        },
                                        "scope": {
                                            "scope": "{{scopes.[CrUX Origins]}}",
                                            "workspace": "{{workspaceId}}"
                                        },
                                        "timeframe": "none"
                                    }
                                }
                            ]
                        },
