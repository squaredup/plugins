                "x": 0,
                "y": 3,
                "w": 3,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "LCP Element",
                    "description": "Whether the main content (the largest element on screen) was an image or text on phone and desktop. When it is mostly an image, image size and delivery matter most for loading speed.",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "datastream-sql",
                        "dataSourceConfig": {
                            "version": "2.0",
                            "sql": "SELECT device, item, value\nFROM (\n  SELECT 'Phone' AS device, 1 AS deviceOrder, item, CAST(value AS DOUBLE) AS value FROM phone WHERE \"group\" = 'LCP element'\n  UNION ALL\n  SELECT 'Desktop' AS device, 2 AS deviceOrder, item, CAST(value AS DOUBLE) AS value FROM desktop WHERE \"group\" = 'LCP element'\n)\nORDER BY deviceOrder, item",
                            "tables": [
                                {
                                    "tableName": "phone",
                                    "config": {
                                        "activePluginConfigIds": [
                                            "{{configId}}"
                                        ],
                                        "dataStream": {
                                            "id": "{{dataStreams.[pageDiagnostics]}}",
                                            "name": "pageDiagnostics",
                                            "pluginConfigId": "{{configId}}",
                                            "dataSourceConfig": {
                                                "level": "origin",
                                                "formFactor": "PHONE"
                                            }
                                        },
                                        "scope": {
                                            "scope": "{{scopes.[CrUX Websites]}}",
                                            "workspace": "{{workspaceId}}"
                                        },
                                        "timeframe": "none"
                                    }
                                },
                                {
                                    "tableName": "desktop",
                                    "config": {
                                        "activePluginConfigIds": [
                                            "{{configId}}"
                                        ],
                                        "dataStream": {
                                            "id": "{{dataStreams.[pageDiagnostics]}}",
                                            "name": "pageDiagnostics",
                                            "pluginConfigId": "{{configId}}",
                                            "dataSourceConfig": {
                                                "level": "origin",
                                                "formFactor": "DESKTOP"
                                            }
                                        },
                                        "scope": {
                                            "scope": "{{scopes.[CrUX Websites]}}",
                                            "workspace": "{{workspaceId}}"
                                        },
                                        "timeframe": "none"
                                    }
                                }
                            ]
                        },
