                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Navigation Types",
                    "description": "How visits arrived over the last 28 days; bfcache (back/forward cache) and prerender loads are near instant. A low bfcache share is usually caused by unload handlers or Cache-Control: no-store, and fixing those makes back and forward visits instant.",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "datastream-sql",
                        "dataSourceConfig": {
                            "version": "2.0",
                            "sql": "SELECT item, CASE WHEN item IN ('bfcache', 'Prerender') THEN 'Instant' ELSE 'Standard' END AS kind, CAST(value AS DOUBLE) AS value\nFROM diag WHERE \"group\" = 'Navigation type'\nORDER BY \"order\"",
                            "tables": [
                                {
                                    "tableName": "diag",
                                    "config": {
                                        "activePluginConfigIds": [
                                            "{{configId}}"
                                        ],
                                        "dataStream": {
                                            "id": "{{dataStreams.[pageDiagnostics]}}",
                                            "name": "pageDiagnostics",
                                            "pluginConfigId": "{{configId}}",
                                            "dataSourceConfig": {
                                                "level": "origin",
                                                "formFactor": "ALL"
                                            }
                                        },
                                        "scope": {
                                            "scope": "{{scopes.[CrUX Websites]}}",
                                            "workspace": "{{workspaceId}}"
                                        },
                                        "timeframe": "none"
                                    }
                                }
                            ]
                        },
                        "metadata": [
                            {
                                "name": "item",
                                "displayName": "Navigation type",
                                "shape": "string",
                                "role": "label"
                            },
                            {
                                "name": "kind",
                                "displayName": "Speed",
                                "shape": "string"
                            },
                            {
                                "name": "value",
                                "displayName": "Share of visits",
                                "shape": [
                                    "percent",
                                    {
                                        "decimalPlaces": 1
                                    }
                                ],
                                "role": "value"
                            }
                        ]
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "item",
                                    "type": "nominal",
                                    "title": "Navigation type"
                                },
                                "y": {
                                    "field": "value",
                                    "type": "quantitative",
                                    "title": "Share of visits"
                                },
                                "series": {
                                    "field": "kind",
                                    "type": "nominal",
                                    "title": "Speed"
                                }
                            },
                            "style": {
                                "cartesianHorizontal": false,
                                "cartesianStack": "on",
                                "legendPosition": "bottom",
                                "mappedColors": {
                                    "Instant": "#0CCE6B",
                                    "Standard": "#9CA3AF"
                                }
                            }
                        }
                    }
                }
