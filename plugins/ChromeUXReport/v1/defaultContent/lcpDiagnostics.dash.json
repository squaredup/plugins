                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "LCP Breakdown (Phone)",
                    "description": "How long each stage of loading the main image takes for the site on phone, in load order (each is its own 3 in 4 visits value, so they do not add up to LCP). Large TTFB: check the server, CDN and caching; large load delay: preload the image and do not lazy-load it; large load time: compress, resize or use modern formats; large render delay: cut render-blocking scripts and styles.",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[pageDiagnostics]}}",
                        "name": "pageDiagnostics",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "level": "origin",
                            "formFactor": "PHONE"
                        },
                        "filter": {
                            "multiOperation": "and",
                            "filters": [
                                {
                                    "column": "group",
                                    "operation": "equals",
                                    "value": "LCP breakdown"
                                }
                            ]
                        },
                        "sort": {
                            "by": [
                                [
                                    "order",
                                    "asc"
                                ]
                            ]
                        }
                    },
                    "scope": {
                        "scope": "{{scopes.[CrUX Websites]}}",
                        "workspace": "{{workspaceId}}"
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "item",
                                    "type": "nominal",
                                    "title": "Part"
                                },
                                "y": {
                                    "field": "value",
                                    "type": "quantitative",
                                    "title": "Time (ms)"
                                }
                            },
                            "style": {
                                "legendPosition": "none",
                                "cartesianYAxisDecimalPlaces": 0
                            }
                        }
                    }
                }
            },
