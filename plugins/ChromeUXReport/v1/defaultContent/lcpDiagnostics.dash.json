            {
                "i": "9ca3e69c-10dd-4b10-9b4b-3dc59d1f75f7",
                "x": 4,
                "y": 2,
                "w": 8,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Navigation types",
                    "description": "How visits arrived over the last 28 days. bfcache (back/forward cache) and prerender loads are near instant, so a bigger share of those is the cheapest LCP win.",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "datastream-sql",
                        "dataSourceConfig": {
                            "version": "2.0",
                            "sql": "SELECT item, CASE WHEN item IN ('bfcache', 'Prerender') THEN 'Instant' ELSE 'Standard' END AS kind, CAST(value AS DOUBLE) AS value\nFROM diag WHERE \"group\" = 'Navigation type'\nORDER BY \"order\"",
                            "tables": [
                                {
                                    "tableName": "diag",
                                    "config": {
                                        "activePluginConfigIds": [
                                            "{{configId}}"
                                        ],
                                        "dataStream": {
                                            "id": "{{dataStreams.[pageDiagnostics]}}",
                                            "name": "pageDiagnostics",
                                            "pluginConfigId": "{{configId}}",
                                            "dataSourceConfig": {
                                                "level": "origin",
                                                "formFactor": "ALL"
                                            }
                                        },
                                        "scope": {
                                            "scope": "{{scopes.[CrUX Origins]}}",
                                            "workspace": "{{workspaceId}}"
                                        },
                                        "timeframe": "none"
                                    }
                                }
                            ]
                        },
                        "metadata": [
                            {
                                "name": "item",
                                "displayName": "Navigation type",
                                "shape": "string",
                                "role": "label"
                            },
                            {
                                "name": "kind",
                                "displayName": "Speed",
                                "shape": "string"
                            },
                            {
                                "name": "value",
                                "displayName": "Share of visits",
                                "shape": [
                                    "percent",
                                    {
                                        "decimalPlaces": 1
                                    }
                                ],
                                "role": "value"
                            }
                        ]
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "item",
                                    "type": "nominal",
                                    "title": "Navigation type"
                                },
                                "y": {
                                    "field": "value",
                                    "type": "quantitative",
                                    "title": "Share of visits"
                                },
                                "series": {
                                    "field": "kind",
                                    "type": "nominal",
                                    "title": "Speed"
                                }
                            },
                            "style": {
                                "cartesianHorizontal": true,
                                "cartesianStack": "on",
                                "legendPosition": "bottom",
                                "mappedColors": {
                                    "Instant": "#0CCE6B",
                                    "Standard": "#9CA3AF"
                                }
                            }
                        }
                    }
                }
            },
            {
                "i": "aff59742-add2-496c-a377-dfb2bea82553",
                "x": 0,
                "y": 5,
                "w": 12,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Server and network",
                    "description": "Time to First Byte and network round trip time at the 75th percentile on phone and desktop. A slow round trip points to the network, a slow TTFB with a fast round trip points to the server.",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "datastream-sql",
                        "dataSourceConfig": {
                            "version": "2.0",
                            "sql": "SELECT device, ttfb, ttfbRating, rtt\nFROM (\n  SELECT 'Phone' AS device, 1 AS deviceOrder,\n    CASE WHEN pv.metric = 'CLS' THEN printf('%.2f', pv.p75) WHEN pv.p75 >= 1000 THEN printf('%.2f s', pv.p75 / 1000) ELSE printf('%d ms', CAST(round(pv.p75) AS BIGINT)) END AS ttfb, CASE pv.rating WHEN 'success' THEN 'Good' WHEN 'warning' THEN 'Needs improvement' ELSE 'Poor' END AS ttfbRating,\n    (SELECT printf('%d ms', CAST(round(value) AS BIGINT)) FROM phoneDiag WHERE \"group\" = 'Network') AS rtt\n  FROM phoneVitals pv WHERE pv.metric = 'TTFB'\n  UNION ALL\n  SELECT 'Desktop' AS device, 2 AS deviceOrder,\n    CASE WHEN dv.metric = 'CLS' THEN printf('%.2f', dv.p75) WHEN dv.p75 >= 1000 THEN printf('%.2f s', dv.p75 / 1000) ELSE printf('%d ms', CAST(round(dv.p75) AS BIGINT)) END AS ttfb, CASE dv.rating WHEN 'success' THEN 'Good' WHEN 'warning' THEN 'Needs improvement' ELSE 'Poor' END AS ttfbRating,\n    (SELECT printf('%d ms', CAST(round(value) AS BIGINT)) FROM desktopDiag WHERE \"group\" = 'Network') AS rtt\n  FROM desktopVitals dv WHERE dv.metric = 'TTFB'\n)\nORDER BY deviceOrder",
                            "tables": [
                                {
                                    "tableName": "phoneVitals",
                                    "config": {
                                        "activePluginConfigIds": [
                                            "{{configId}}"
                                        ],
                                        "dataStream": {
                                            "id": "{{dataStreams.[coreWebVitals]}}",
                                            "name": "coreWebVitals",
                                            "pluginConfigId": "{{configId}}",
                                            "dataSourceConfig": {
                                                "level": "origin",
                                                "formFactor": "PHONE"
                                            }
                                        },
                                        "scope": {
                                            "scope": "{{scopes.[CrUX Origins]}}",
                                            "workspace": "{{workspaceId}}"
                                        },
                                        "timeframe": "none"
                                    }
                                },
                                {
                                    "tableName": "desktopVitals",
                                    "config": {
                                        "activePluginConfigIds": [
                                            "{{configId}}"
                                        ],
                                        "dataStream": {
                                            "id": "{{dataStreams.[coreWebVitals]}}",
                                            "name": "coreWebVitals",
                                            "pluginConfigId": "{{configId}}",
                                            "dataSourceConfig": {
                                                "level": "origin",
                                                "formFactor": "DESKTOP"
                                            }
                                        },
                                        "scope": {
                                            "scope": "{{scopes.[CrUX Origins]}}",
                                            "workspace": "{{workspaceId}}"
                                        },
                                        "timeframe": "none"
                                    }
                                },
                                {
                                    "tableName": "phoneDiag",
                                    "config": {
                                        "activePluginConfigIds": [
                                            "{{configId}}"
                                        ],
                                        "dataStream": {
                                            "id": "{{dataStreams.[pageDiagnostics]}}",
                                            "name": "pageDiagnostics",
                                            "pluginConfigId": "{{configId}}",
                                            "dataSourceConfig": {
                                                "level": "origin",
                                                "formFactor": "PHONE"
                                            }
                                        },
                                        "scope": {
                                            "scope": "{{scopes.[CrUX Origins]}}",
                                            "workspace": "{{workspaceId}}"
                                        },
                                        "timeframe": "none"
                                    }
                                },
                                {
                                    "tableName": "desktopDiag",
                                    "config": {
                                        "activePluginConfigIds": [
                                            "{{configId}}"
                                        ],
                                        "dataStream": {
                                            "id": "{{dataStreams.[pageDiagnostics]}}",
                                            "name": "pageDiagnostics",
                                            "pluginConfigId": "{{configId}}",
                                            "dataSourceConfig": {
                                                "level": "origin",
                                                "formFactor": "DESKTOP"
                                            }
