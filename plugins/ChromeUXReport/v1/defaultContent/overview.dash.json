                            "sql": "SELECT device, CASE WHEN passed IS NULL THEN 'No data' WHEN passed THEN 'Passed' ELSE 'Failed' END AS result, CASE WHEN passed IS NULL THEN 'unknown' WHEN passed THEN 'success' ELSE 'error' END AS state\nFROM (\n  SELECT 'Phone' AS device, 1 AS sortOrder, bool_and(rating = 'success') AS passed FROM phone WHERE isCoreWebVital\n  UNION ALL\n  SELECT 'Desktop' AS device, 2 AS sortOrder, bool_and(rating = 'success') AS passed FROM desktop WHERE isCoreWebVital\n)\nORDER BY sortOrder",
