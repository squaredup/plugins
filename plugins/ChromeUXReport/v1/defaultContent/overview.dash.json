                            "sql": "SELECT metric, bucket, share\nFROM (\n  SELECT metric, CASE metric WHEN 'LCP' THEN 1 WHEN 'INP' THEN 2 WHEN 'CLS' THEN 3 WHEN 'FCP' THEN 4 ELSE 5 END AS metricOrder, 1 AS bucketOrder, 'Good' AS bucket, CAST(good AS DOUBLE) AS share FROM vitals\n  UNION ALL\n  SELECT metric, CASE metric WHEN 'LCP' THEN 1 WHEN 'INP' THEN 2 WHEN 'CLS' THEN 3 WHEN 'FCP' THEN 4 ELSE 5 END AS metricOrder, 2 AS bucketOrder, 'Needs improvement' AS bucket, CAST(needsImprovement AS DOUBLE) AS share FROM vitals\n  UNION ALL\n  SELECT metric, CASE metric WHEN 'LCP' THEN 1 WHEN 'INP' THEN 2 WHEN 'CLS' THEN 3 WHEN 'FCP' THEN 4 ELSE 5 END AS metricOrder, 3 AS bucketOrder, 'Poor' AS bucket, CAST(poor AS DOUBLE) AS share FROM vitals\n)\nORDER BY metricOrder, bucketOrder",
