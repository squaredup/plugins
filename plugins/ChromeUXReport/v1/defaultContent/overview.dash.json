                    "_type": "tile/data-stream",
                    "title": "FCP and TTFB",
                    "description": "First Contentful Paint (FCP, when anything first appears) and Time to First Byte (TTFB, how long the server takes to start responding) for the site, as met or beaten by 3 in 4 visits. They are not Core Web Vitals, but a slow TTFB or FCP usually explains slow loading.",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "datastream-sql",
                        "dataSourceConfig": {
                            "version": "2.0",
                            "sql": "SELECT metric, device, p75Text, rating, good\nFROM (\n  SELECT phone.metric, 'Phone' AS device, 1 AS deviceOrder, CASE WHEN phone.metric = 'CLS' THEN printf('%.2f', phone.p75) WHEN phone.p75 >= 1000 THEN printf('%.2f s', phone.p75 / 1000) ELSE printf('%d ms', CAST(round(phone.p75) AS BIGINT)) END AS p75Text, CASE phone.rating WHEN 'success' THEN 'Good' WHEN 'warning' THEN 'Needs improvement' ELSE 'Poor' END AS rating, CAST(phone.good AS DOUBLE) AS good FROM phone WHERE NOT phone.isCoreWebVital\n  UNION ALL\n  SELECT desktop.metric, 'Desktop' AS device, 2 AS deviceOrder, CASE WHEN desktop.metric = 'CLS' THEN printf('%.2f', desktop.p75) WHEN desktop.p75 >= 1000 THEN printf('%.2f s', desktop.p75 / 1000) ELSE printf('%d ms', CAST(round(desktop.p75) AS BIGINT)) END AS p75Text, CASE desktop.rating WHEN 'success' THEN 'Good' WHEN 'warning' THEN 'Needs improvement' ELSE 'Poor' END AS rating, CAST(desktop.good AS DOUBLE) AS good FROM desktop WHERE NOT desktop.isCoreWebVital\n)\nORDER BY metric, deviceOrder",
