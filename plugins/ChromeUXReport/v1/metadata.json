{
    "name": "chrome-ux-report",
    "displayName": "Chrome UX Report",
    "version": "1.0.0",
    "author": {
        "name": "@Daniel-Hodgson-SquaredUp",
        "type": "community"
    },
    "description": "Monitor real-user Core Web Vitals (LCP, INP, CLS, FCP and TTFB) for a website and its pages from the Chrome UX Report (CrUX).",
    "category": "Analytics",
    "type": "hybrid",
    "schemaVersion": "2.1",
    "importNotSupported": false,
    "restrictedToPlatforms": [],
    "keywords": [
        "crux",
        "core web vitals",
        "lcp",
        "inp",
        "cls",
        "page speed",
        "web performance",
        "seo",
        "chrome"
    ],
    "objectTypes": [
        "CrUX Origin",
        "CrUX Page",
        "CrUX Competitor"
    ],
    "links": [
        {
            "category": "documentation",
            "url": "https://github.com/squaredup/plugins/blob/main/plugins/ChromeUXReport/v1/docs/README.md",
            "label": "Help adding this plugin"
        },
        {
            "category": "source",
            "url": "https://github.com/squaredup/plugins/tree/main/plugins/ChromeUXReport/v1",
            "label": "Repository"
        }
    ],
    "base": {
        "plugin": "WebAPI",
        "majorVersion": "1",
        "config": {
            "baseUrl": "https:/",
            "authMode": "none",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "application/json"
                }
            ],
            "queryArgs": []
        }
    }
}
