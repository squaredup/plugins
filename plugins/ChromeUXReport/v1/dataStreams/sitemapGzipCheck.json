{
    "name": "sitemapGzipCheck",
    "displayName": "Sitemap gzip check",
    "description": "Returns a row when the configured sitemap lists no gzipped sitemaps",
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "baseUrl": "{{new URL(dataSource.sitemapUrl).origin}}",
        "httpMethod": "get",
        "endpointPath": "{{new URL(dataSource.sitemapUrl).pathname.slice(1) + new URL(dataSource.sitemapUrl).search}}",
        "getArgs": [],
        "headers": [],
        "postRequestScript": "sitemapGzipCheck.js",
        "errorHandling": {
            "type": "script",
            "script": "errorHandling/sitemapCheck.js"
        }
    },
    "matches": "none",
    "timeframes": false,
    "visibility": {
        "type": "hidden"
    },
    "tags": [
        "Web Performance"
    ],
    "metadata": [
        {
            "name": "gzipped",
            "displayName": "Gzipped sitemaps",
            "shape": "number"
        }
    ]
}
