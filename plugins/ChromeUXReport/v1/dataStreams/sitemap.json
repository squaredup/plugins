{
    "name": "sitemap",
    "displayName": "Sitemap",
    "description": "Returns the website origin, competitor origins and every page listed in the configured sitemap and its child sitemaps",
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "{{dataSource.sitemapUrl.split('://')[1]}}",
        "getArgs": [],
        "headers": [],
        "postRequestScript": "sitemapEntries.js",
        "paging": {
            "mode": "nextUrl",
            "in": {
                "realm": "payload",
                "path": "cruxNextSitemap"
            }
        }
    },
    "matches": "none",
    "timeframes": false,
    "visibility": {
        "type": "hidden"
    },
    "tags": [
        "Web Performance"
    ],
    "metadata": [
        {
            "name": "url",
            "displayName": "URL",
            "shape": "url",
            "role": "label"
        },
        {
            "name": "sourceType",
            "displayName": "Type",
            "shape": "string"
        },
        {
            "name": "pageGroup",
            "displayName": "Page group",
            "shape": "string"
        }
    ]
}
