{
    "name": "origin",
    "displayName": "Origin",
    "description": "Returns the website origin of the configured sitemap if the Chrome UX Report holds data for it",
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "post",
        "endpointPath": "chromeuxreport.googleapis.com/v1/records:queryRecord",
        "postBody": {
            "origin": "{{new URL(dataSource.sitemapUrl).origin}}",
            "metrics": [
                "largest_contentful_paint"
            ]
        },
        "pathToData": "record.key",
        "errorHandling": {
            "type": "path",
            "realm": "payload",
            "path": "error.message"
        },
        "getArgs": [
            {
                "key": "key",
                "value": "{{dataSource.apiKey}}"
            }
        ],
        "headers": []
    },
    "matches": "none",
    "timeframes": false,
    "visibility": {
        "type": "hidden"
    },
    "providesPluginDiagnostics": true,
    "tags": [
        "Web Performance"
    ],
    "metadata": [
        {
            "name": "origin",
            "displayName": "Origin",
            "shape": "string",
            "role": "label"
        }
    ]
}
