{
    "name": "pageDiagnostics",
    "displayName": "Page experience diagnostics",
    "description": "Returns what makes up the Largest Contentful Paint, the LCP element type, how visitors navigated, their devices and their network round trip time over the last 28 days",
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "post",
        "endpointPath": "chromeuxreport.googleapis.com/v1/records:queryRecord",
        "getArgs": [
            {
                "key": "key",
                "value": "{{dataSource.apiKey}}"
            }
        ],
        "headers": [],
        "postBody": "{{JSON.stringify(Object.assign((level === 'origin' || ['CrUX Origin', 'CrUX Competitor'].includes(object.sourceType)) ? { origin: new URL(object.name).origin } : { url: object.name }, formFactor && formFactor !== 'ALL' ? { formFactor } : {}, { metrics: ['largest_contentful_paint_image_time_to_first_byte', 'largest_contentful_paint_image_resource_load_delay', 'largest_contentful_paint_image_resource_load_duration', 'largest_contentful_paint_image_element_render_delay', 'largest_contentful_paint_resource_type', 'navigation_types', 'form_factors', 'round_trip_time'] }))}}",
        "postRequestScript": "pageDiagnostics.js",
        "errorHandling": {
            "type": "script",
            "script": "errorHandling/coreWebVitals.js"
        }
    },
    "matches": {
        "sourceType": {
            "type": "oneOf",
            "values": [
                "CrUX Origin",
                "CrUX Page",
                "CrUX Competitor",
                "page"
            ]
        }
    },
    "ui": [
        {
            "name": "level",
            "type": "radio",
            "label": "Level",
            "help": "**Page** reports the selected page. **Whole site** reports every page on the selected page's origin together.",
            "defaultValue": "page",
            "options": [
                {
                    "value": "page",
                    "label": "Page"
                },
                {
                    "value": "origin",
                    "label": "Whole site"
                }
            ]
        },
        {
            "name": "formFactor",
            "type": "radio",
            "label": "Device",
            "defaultValue": "ALL",
            "options": [
                {
                    "value": "ALL",
                    "label": "All devices"
                },
                {
                    "value": "PHONE",
                    "label": "Phone"
                },
                {
                    "value": "DESKTOP",
                    "label": "Desktop"
                },
                {
                    "value": "TABLET",
                    "label": "Tablet"
                }
            ]
        }
    ],
    "timeframes": false,
    "providesPluginDiagnostics": true,
    "tags": [
        "Web Performance",
        "SEO"
    ],
    "metadata": [
        {
            "name": "target",
            "displayName": "Page",
            "shape": "url",
            "role": "label"
        },
        {
            "name": "group",
            "displayName": "Group",
            "shape": "string"
        },
        {
            "name": "item",
            "displayName": "Item",
            "shape": "string"
        },
        {
            "name": "value",
            "displayName": "Value",
            "shape": "number",
            "role": "value",
            "formatExpression": "{{ $['unit'] === '%' ? $['value'].toFixed(1) + '%' : $['value'] >= 1000 ? ($['value'] / 1000).toFixed(2) + ' s' : Math.round($['value']) + ' ms' }}"
        },
        {
            "name": "unit",
            "displayName": "Unit",
            "shape": "string"
        },
        {
            "name": "order",
            "displayName": "Order",
            "shape": "number",
            "visible": false
        },
        {
            "name": "device",
            "displayName": "Device",
            "shape": "string"
        },
        {
            "name": "level",
            "displayName": "Level",
            "shape": "string"
        },
        {
            "name": "periodEnd",
            "displayName": "Period end",
            "shape": [
                "date",
                {
                    "format": "dd MMM yyyy"
                }
            ]
        }
    ]
}
