{
    "name": "sitemapCheck",
    "displayName": "Sitemap check",
    "description": "Returns how many pages and child sitemaps the configured sitemap lists",
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "baseUrl": "{{new URL(dataSource.sitemapUrl).origin}}",
        "httpMethod": "get",
        "endpointPath": "{{new URL(dataSource.sitemapUrl).pathname.slice(1) + new URL(dataSource.sitemapUrl).search}}",
        "getArgs": [],
        "headers": [],
        "postRequestScript": "sitemapCheck.js",
        "errorHandling": {
            "type": "script",
            "script": "errorHandling/sitemapCheck.js"
        }
    },
    "matches": "none",
    "timeframes": false,
    "visibility": {
        "type": "hidden"
    },
    "tags": [
        "Web Performance"
    ],
    "metadata": [
        {
            "name": "pages",
            "displayName": "Pages",
            "shape": "number"
        },
        {
            "name": "sitemaps",
            "displayName": "Child sitemaps",
            "shape": "number"
        },
        {
            "name": "readableSitemaps",
            "displayName": "Readable child sitemaps",
            "shape": "number"
        }
    ]
}
