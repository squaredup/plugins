{
    "name": "apiKeyCheck",
    "displayName": "API key check",
    "description": "Returns a known origin from the Chrome UX Report to confirm the API key works",
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "baseUrl": "https://chromeuxreport.googleapis.com/v1",
        "httpMethod": "post",
        "endpointPath": "records:queryRecord",
        "postBody": {
            "origin": "https://www.google.com",
            "metrics": [
                "largest_contentful_paint"
            ]
        },
        "pathToData": "record.key",
        "errorHandling": {
            "type": "path",
            "realm": "payload",
            "path": "error.message"
        },
        "getArgs": [
            {
                "key": "key",
                "value": "{{dataSource.apiKey}}"
            }
        ],
        "headers": []
    },
    "matches": "none",
    "timeframes": false,
    "visibility": {
        "type": "hidden"
    },
    "providesPluginDiagnostics": true,
    "tags": [
        "Web Performance"
    ],
    "metadata": [
        {
            "name": "origin",
            "displayName": "Origin",
            "shape": "string",
            "role": "label"
        }
    ]
}
