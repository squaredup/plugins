{
    "name": "workspaceMembers",
    "displayName": "Workspace Members",
    "description": "Lists members assigned to a specific workspace with their workspace role",
    "tags": ["Users", "Workspaces"],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "organizations/workspaces/{{object.anthropicWorkspaceId}}/members",
        "pathToData": "data",
        "paging": {
            "mode": "token",
            "pageSize": { "realm": "queryArg", "path": "limit", "value": "100" },
            "in": { "realm": "payload", "path": "next_page" },
            "out": { "realm": "queryArg", "path": "page" }
        }
    },
    "matches": { "sourceType": { "type": "oneOf", "values": ["Anthropic Workspace"] } },
    "metadata": [
        { "name": "user_id", "displayName": "User ID", "role": "label" },
        { "name": "workspace_id", "displayName": "Workspace ID", "visible": false },
        { "name": "workspace_role", "displayName": "Workspace Role" }
    ],
    "timeframes": false
}
