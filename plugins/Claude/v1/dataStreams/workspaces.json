{
    "name": "workspaces",
    "displayName": "Workspaces",
    "description": "Lists all workspaces in the Anthropic organisation",
    "tags": ["Workspaces"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "organizations/workspaces",
        "pathToData": "data",
        "paging": {
            "mode": "token",
            "pageSize": { "realm": "queryArg", "path": "limit", "value": "100" },
            "in": { "realm": "payload", "path": "next_page" },
            "out": { "realm": "queryArg", "path": "page" }
        }
    },
    "matches": "none",
    "visibility": { "type": "hidden" },
    "metadata": [
        { "name": "id", "displayName": "Workspace ID", "role": "label", "visible": false },
        { "name": "name", "displayName": "Name" },
        { "name": "created_at", "displayName": "Created", "shape": ["date", { "format": "dd/MM/yyyy" }] },
        { "name": "archived_at", "displayName": "Archived", "shape": ["date", { "format": "dd/MM/yyyy" }] },
        {
            "name": "sourceId",
            "computed": true,
            "valueExpression": "{{ $['id'] }}",
            "visible": false
        },
        {
            "name": "sourceType",
            "computed": true,
            "valueExpression": "Anthropic Workspace",
            "visible": false
        }
    ],
    "timeframes": false
}
