{
    "name": "invites",
    "displayName": "Pending Invites",
    "description": "Lists pending organisation invitations that have not yet been accepted",
    "tags": ["Users", "Invites"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "organizations/invites",
        "pathToData": "data",
        "paging": {
            "mode": "token",
            "pageSize": { "realm": "queryArg", "path": "limit", "value": "100" },
            "in": { "realm": "payload", "path": "next_page" },
            "out": { "realm": "queryArg", "path": "page" }
        }
    },
    "matches": "none",
    "metadata": [
        { "name": "id", "displayName": "Invite ID", "visible": false },
        { "name": "email", "displayName": "Email", "role": "label" },
        { "name": "role", "displayName": "Role" },
        { "name": "status", "displayName": "Status" },
        { "name": "invited_at", "displayName": "Invited", "shape": ["date", { "format": "dd/MM/yyyy" }] },
        { "name": "expires_at", "displayName": "Expires", "shape": ["date", { "format": "dd/MM/yyyy" }] }
    ],
    "timeframes": false
}
