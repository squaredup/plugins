{
    "name": "workspaceRateLimits",
    "displayName": "Workspace Rate Limits",
    "description": "Rate limit overrides configured for a specific workspace, with the org-level value shown for comparison",
    "tags": ["Rate Limits"],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "organizations/workspaces/{{object.anthropicWorkspaceId}}/rate_limits",
        "postRequestScript": "workspaceRateLimits.js"
    },
    "matches": { "sourceType": { "type": "oneOf", "values": ["Anthropic Workspace"] } },
    "metadata": [
        { "name": "group_type", "displayName": "Group", "role": "label" },
        { "name": "models", "displayName": "Models" },
        { "name": "limit_type", "displayName": "Limit Type" },
        {
            "name": "value",
            "displayName": "Workspace Value",
            "shape": ["number", { "thousandsSeparator": true, "decimalPlaces": 0 }],
            "role": "value"
        },
        {
            "name": "org_limit",
            "displayName": "Org Limit",
            "shape": ["number", { "thousandsSeparator": true, "decimalPlaces": 0 }]
        }
    ],
    "timeframes": false
}
