        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "27f4a3ce-147f-4134-9ae4-4602ed639403",
                "x": 0,
                "y": 0,
                "w": 1,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Properties",
                    "description": "",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "datastream-properties"
                    },
                    "scope": {
                        "scope": "{{scopes.[API Keys]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[API Key]}}"
                    },
                    "variables": ["{{variables.[API Key]}}"],
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": { "data-stream-table": { "transpose": true } }
                    }
                }
            },
            {
                "i": "71743400-82bc-4d2d-9d1a-a5039b5127c6",
                "x": 1,
                "y": 0,
                "w": 3,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Token Usage by Model",
                    "description": "Tokens consumed by this API key per model over time",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[apiKeyUsage]}}",
                        "name": "apiKeyUsage",
                        "pluginConfigId": "{{configId}}",
                        "config": { "bucketWidth": "1h" }
                    },
                    "scope": {
                        "scope": "{{scopes.[API Keys]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[API Key]}}"
                    },
                    "variables": ["{{variables.[API Key]}}"],
                    "visualisation": {
                        "type": "data-stream-line-graph",
                        "config": {
                            "data-stream-line-graph": {
                                "xAxisColumn": "timestamp",
                                "yAxisColumns": ["total_tokens"],
                                "seriesColumn": "model",
                                "showLegend": true,
                                "legendPosition": "bottom",
                                "yAxisLabel": "Tokens",
                                "showYAxisLabel": true
                            }
                        }
                    }
                }
            }
        ]
    }
