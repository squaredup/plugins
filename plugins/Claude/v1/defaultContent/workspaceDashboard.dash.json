{
    "name": "Workspace",
    "schemaVersion": "1.4",
    "timeframe": "last7days",
    "variables": ["{{variables.[Workspace]}}"],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "8e8b012e-abc8-4407-b843-e549cc17092a",
                "x": 0,
                "y": 0,
                "w": 1,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Properties",
                    "description": "",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "datastream-properties"
                    },
                    "scope": {
                        "scope": "{{scopes.[Workspaces]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Workspace]}}"
                    },
                    "variables": ["{{variables.[Workspace]}}"],
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": { "data-stream-table": { "transpose": true } }
                    }
                }
            },
            {
                "i": "a8a1cf05-10fa-487a-a4c3-70713604c9ed",
                "x": 1,
                "y": 0,
                "w": 3,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Token Usage by Model",
                    "description": "Tokens consumed by this workspace per model over time",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[workspaceUsage]}}",
                        "name": "workspaceUsage",
                        "pluginConfigId": "{{configId}}",
                        "config": { "bucketWidth": "1h" }
                    },
                    "scope": {
                        "scope": "{{scopes.[Workspaces]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Workspace]}}"
                    },
                    "variables": ["{{variables.[Workspace]}}"],
                    "visualisation": {
                        "type": "data-stream-line-graph",
                        "config": {
                            "data-stream-line-graph": {
                                "xAxisColumn": "timestamp",
                                "yAxisColumns": ["total_tokens"],
                                "seriesColumn": "model",
                                "showLegend": true,
                                "legendPosition": "bottom",
                                "yAxisLabel": "Tokens",
                                "showYAxisLabel": true
                            }
                        }
                    }
                }
            },
            {
                "i": "e66c6cfd-c901-40a4-aab1-5b6635518266",
                "x": 0,
                "y": 4,
                "w": 4,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "API Keys in Workspace",
                    "description": "",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "datastream-properties"
                    },
                    "scope": {
                        "query": "g.V().order().by('__name').hasNot('__canonicalType').has('__configId', within('{{configId}}')).has('sourceType', 'Anthropic API Key').limit(500)",
                        "bindings": {},
                        "queryDetail": {}
                    },
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": { "data-stream-table": { "transpose": false } }
                    }
                }
            }
        ]
    }
}
