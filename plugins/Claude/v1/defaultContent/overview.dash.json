{
    "name": "Overview",
    "schemaVersion": "1.4",
    "timeframe": "last7days",
    "variables": [],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "20d778cb-af5f-4eae-a422-660477606a3b",
                "x": 0,
                "y": 0,
                "w": 4,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Token Usage by Model",
                    "description": "Total tokens consumed per model over time",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[usageByModel]}}",
                        "name": "usageByModel",
                        "pluginConfigId": "{{configId}}",
                        "config": { "bucketWidth": "1h" }
                    },
                    "scope": {},
                    "visualisation": {
                        "type": "data-stream-line-graph",
                        "config": {
                            "data-stream-line-graph": {
                                "xAxisColumn": "timestamp",
                                "yAxisColumns": ["total_tokens"],
                                "seriesColumn": "model",
                                "showLegend": true,
                                "legendPosition": "bottom",
                                "yAxisLabel": "Tokens",
                                "showYAxisLabel": true
                            }
                        }
                    }
                }
            },
            {
                "i": "1d905364-050c-4607-96f6-bba3e83676b7",
                "x": 0,
                "y": 4,
                "w": 2,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Daily Cost by Workspace (USD)",
                    "description": "Cost per workspace per day",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[costReport]}}",
                        "name": "costReport",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {},
                    "visualisation": {
                        "type": "data-stream-bar-chart",
                        "config": {
                            "data-stream-bar-chart": {
                                "xAxisData": "timestamp",
                                "yAxisData": ["amount_usd"],
                                "xAxisGroup": "workspace_id",
                                "yAxisLabel": "Cost (USD)",
                                "showYAxisLabel": true,
                                "showLegend": true,
                                "legendPosition": "bottom",
                                "showGrid": true,
                                "horizontalLayout": "vertical",
                                "displayMode": "actual",
                                "grouping": true
                            }
                        }
                    }
                }
            },
            {
                "i": "9d430f0c-fbbd-486d-b23a-beaad2c4419e",
                "x": 2,
                "y": 4,
                "w": 2,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Token Usage by Workspace",
                    "description": "Tokens per workspace over time",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[usageByWorkspace]}}",
                        "name": "usageByWorkspace",
                        "pluginConfigId": "{{configId}}",
                        "config": { "bucketWidth": "1d" }
                    },
                    "scope": {},
                    "visualisation": {
                        "type": "data-stream-line-graph",
                        "config": {
                            "data-stream-line-graph": {
                                "xAxisColumn": "timestamp",
                                "yAxisColumns": ["total_tokens"],
                                "seriesColumn": "workspace_id",
                                "showLegend": true,
                                "legendPosition": "bottom",
                                "yAxisLabel": "Tokens",
                                "showYAxisLabel": true
                            }
                        }
                    }
                }
            },
            {
                "i": "a44fe9c1-4336-4c28-8df8-9db1c1771033",
                "x": 0,
                "y": 8,
                "w": 4,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Workspaces",
                    "description": "",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "datastream-properties"
                    },
                    "scope": {
                        "query": "g.V().order().by('__name').hasNot('__canonicalType').has('__configId', within('{{configId}}')).has('sourceType', 'Anthropic Workspace').limit(500)",
                        "bindings": {},
                        "queryDetail": {}
                    },
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false
                            }
                        }
                    }
                }
            }
        ]
    }
}
