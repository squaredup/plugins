                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "datastream-properties",
                        "name": "properties",
                        "filter": {
                            "multiOperation": "and",
                            "filters": [
                                {
                                    "column": "countKind",
                                    "operation": "equals",
                                    "value": "operations"
                                }
                            ]
                        },
                        "group": {
                            "by": [],
                            "aggregate": [
                                {
                                    "type": "sum",
                                    "names": [
                                        "countValue"
                                    ]
                                }
                            ]
                        }
                    },
                    "visualisation": {
                        "type": "data-stream-scalar",
                        "config": {
                            "data-stream-scalar": {
                                "value": "countValue_sum",
                                "comparisonColumn": "none",
                                "label": "Pending Patch Operations"
                            }
                        }
                    },
                    "scope": {
                        "scope": "{{scopes.[Pre-Patch Counts]}}",
                        "workspace": "{{workspaceId}}"
                    }
                }
