{
    "name": "automox",
    "displayName": "Automox (Beta)",
    "version": "1.0.0",
    "author": { "name": "Jack Tobia", "type": "community" },
    "description": "Monitor device patch posture, policy compliance, and pre-patch risk for an Automox organization.",
    "category": "Monitoring",
    "type": "hybrid",
    "schemaVersion": "2.1",
    "importNotSupported": false,
    "restrictedToPlatforms": [],
    "keywords": ["automox", "patch management", "endpoint management", "compliance", "rmm", "it operations"],
    "objectTypes": ["Automox Device", "Automox Policy"],
    "links": [
        {
            "category": "documentation",
            "url": "https://github.com/squaredup/plugins/blob/main/plugins/Automox/v1/docs/README.md",
            "label": "Help adding this plugin"
        },
        {
            "category": "source",
            "url": "https://developer.automox.com",
            "label": "Automox API Reference"
        }
    ],
    "base": {
        "plugin": "WebAPI",
        "majorVersion": "1",
        "config": {
            "baseUrl": "https://console.automox.com/api",
            "authMode": "none",
            "headers": [{ "key": "Authorization", "value": "Bearer {{apiKey}}" }],
            "queryArgs": [],
            "showScripting": true,
            "preRequestScript": "preRequest.js"
        }
    }
}
