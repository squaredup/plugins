{
    "name": "policies",
    "displayName": "Policies",
    "description": "Patch, required-software and custom worklet policies in the organization, with schedule and status",
    "tags": ["Automox", "Policy"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "policies",
        "getArgs": [
            { "key": "o", "value": "{{dataSource.organizationId}}" },
            { "key": "limit", "value": "100" }
        ],
        "paging": {
            "mode": "offset",
            "pageSize": { "realm": "queryArg", "path": "limit", "value": "100" },
            "offset": {
                "mode": "page",
                "rowCountIn": { "realm": "payloadArraySize", "path": "." },
                "base": 0
            },
            "out": { "realm": "queryArg", "path": "page" }
        },
        "errorHandling": { "type": "script", "script": "errorHandling/automoxRateLimit.js" }
    },
    "matches": "none",
    "metadata": [
        { "name": "id", "displayName": "Policy ID", "shape": "number", "role": "id" },
        { "name": "name", "displayName": "Name", "shape": "string", "role": "label" },
        { "name": "organization_id", "displayName": "Organization ID", "shape": "number", "visible": false },
        { "name": "policy_type_name", "displayName": "Policy Type", "shape": "string" },
        { "name": "notes", "displayName": "Notes", "shape": "string" },
        { "name": "server_groups", "displayName": "Server Group IDs", "shape": "json", "visible": false },
        { "name": "schedule_time", "displayName": "Schedule Time", "shape": "string" },
        { "name": "schedule_days", "displayName": "Schedule Days (bitmask)", "shape": "number", "visible": false },
        {
            "name": "schedule_weeks_of_month",
            "displayName": "Schedule Weeks (bitmask)",
            "shape": "number",
            "visible": false
        },
        { "name": "schedule_months", "displayName": "Schedule Months (bitmask)", "shape": "number", "visible": false },
        {
            "name": "installation_do_not_disturb_honored",
            "displayName": "Honors Installation DND",
            "shape": "boolean",
            "visible": false
        },
        {
            "name": "reboot_do_not_disturb_honored",
            "displayName": "Honors Reboot DND",
            "shape": "boolean",
            "visible": false
        },
        {
            "name": "configuration",
            "displayName": "Configuration",
            "shape": "json",
            "visible": false
        },
        { "name": "uuid", "displayName": "UUID", "shape": "guid", "visible": false },
        { "name": "status", "displayName": "Status", "shape": "string" },
        { "name": "server_count", "displayName": "Device Count", "shape": "number" },
        { "name": "create_time", "displayName": "Created", "shape": "date" },
        { "name": "next_remediation", "displayName": "Next Remediation", "shape": "date", "visible": false },
        { "pattern": ".*" }
    ],
    "timeframes": false
}
