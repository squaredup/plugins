{
    "name": "prepatchCounts",
    "displayName": "Pre-Patch Counts",
    "description": "Pending patch operations by severity and devices with pending patches for each page of the pre-patch report - imported so dashboards can total an estate too large to read live",
    "tags": ["Automox", "Compliance"],
    "baseDataSourceName": "httpRequestUnscoped",
    "visibility": { "type": "hidden" },
    "config": {
        "httpMethod": "get",
        "endpointPath": "reports/prepatch",
        "getArgs": [
            { "key": "o", "value": "{{dataSource.organizationId}}" },
            { "key": "limit", "value": "250" },
            { "key": "offset", "value": "0" }
        ],
        "paging": {
            "mode": "offset",
            "pageSize": { "realm": "queryArg", "path": "limit", "value": "250" },
            "offset": {
                "mode": "row",
                "rowCountIn": { "realm": "payloadArraySize", "path": "prepatch.devices" },
                "base": 0
            },
            "out": { "realm": "queryArg", "path": "offset" }
        },
        "postRequestScript": "prepatchCounts.js",
        "errorHandling": { "type": "script", "script": "errorHandling/automoxRateLimit.js" }
    },
    "matches": "none",
    "metadata": [
        { "name": "countId", "displayName": "Count ID", "shape": "string", "role": "id" },
        { "name": "countName", "displayName": "Name", "shape": "string", "role": "label" },
        { "name": "countKind", "displayName": "Kind", "shape": "string" },
        { "name": "countLabel", "displayName": "Category", "shape": "string" },
        { "name": "countValue", "displayName": "Count", "shape": "number" }
    ],
    "timeframes": false
}
