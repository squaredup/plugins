{
    "name": "deviceCounts",
    "displayName": "Device Counts",
    "description": "Device counts by connection, reboot, compliance and OS family for each 500-device page of the device list - imported so dashboards can total an estate too large to read live",
    "tags": ["Automox", "Device"],
    "baseDataSourceName": "httpRequestUnscoped",
    "visibility": { "type": "hidden" },
    "config": {
        "httpMethod": "get",
        "endpointPath": "servers",
        "getArgs": [
            { "key": "o", "value": "{{dataSource.organizationId}}" },
            { "key": "limit", "value": "500" },
            { "key": "exclude_policy_status", "value": "1" }
        ],
        "paging": {
            "mode": "offset",
            "pageSize": { "realm": "queryArg", "path": "limit", "value": "500" },
            "offset": {
                "mode": "page",
                "rowCountIn": { "realm": "payloadArraySize", "path": "." },
                "base": 0
            },
            "out": { "realm": "queryArg", "path": "page" }
        },
        "postRequestScript": "deviceCounts.js",
        "errorHandling": { "type": "script", "script": "errorHandling/automoxRateLimit.js" }
    },
    "matches": "none",
    "metadata": [
        { "name": "countId", "displayName": "Count ID", "shape": "string", "role": "id" },
        { "name": "countName", "displayName": "Name", "shape": "string", "role": "label" },
        { "name": "countKind", "displayName": "Kind", "shape": "string" },
        { "name": "countLabel", "displayName": "Category", "shape": "string" },
        { "name": "countValue", "displayName": "Devices", "shape": "number" }
    ],
    "timeframes": false
}
