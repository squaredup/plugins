{
    "name": "devices",
    "displayName": "Devices",
    "description": "Managed devices in the organization, with OS, connection, patch and compliance state",
    "tags": ["Automox", "Device"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "servers",
        "getArgs": [
            { "key": "o", "value": "{{dataSource.organizationId}}" },
            { "key": "limit", "value": "100" },
            { "key": "groupId", "value": "{{groupId || null}}" },
            { "key": "policyId", "value": "{{policyId || null}}" },
            { "key": "patchStatus", "value": "{{patchStatus || null}}" },
            { "key": "pending", "value": "{{pending || null}}" },
            { "key": "managed", "value": "{{managed || null}}" },
            { "key": "exception", "value": "{{exception || null}}" }
        ],
        "paging": {
            "mode": "offset",
            "pageSize": { "realm": "queryArg", "path": "limit", "value": "100" },
            "offset": {
                "mode": "page",
                "rowCountIn": { "realm": "payloadArraySize", "path": "." },
                "base": 0
            },
            "out": { "realm": "queryArg", "path": "page" }
        },
        "errorHandling": { "type": "script", "script": "errorHandling/automoxRateLimit.js" }
    },
    "matches": "none",
    "ui": [
        { "type": "number", "name": "groupId", "label": "Server Group ID (optional)" },
        { "type": "number", "name": "policyId", "label": "Policy ID (optional)" },
        { "type": "text", "name": "patchStatus", "label": "Patch status filter (optional)" },
        {
            "type": "switch",
            "name": "pending",
            "label": "Pending filter (optional)",
            "options": [
                { "value": "1", "label": "Pending only" },
                { "value": "0", "label": "Not pending" }
            ]
        },
        {
            "type": "switch",
            "name": "managed",
            "label": "Managed filter (optional)",
            "options": [
                { "value": "1", "label": "Managed only" },
                { "value": "0", "label": "Unmanaged only" }
            ]
        },
        {
            "type": "switch",
            "name": "exception",
            "label": "Exception filter (optional)",
            "options": [
                { "value": "1", "label": "Exceptions only" },
                { "value": "0", "label": "No exceptions" }
            ]
        }
    ],
    "metadata": [
        { "name": "uuid", "displayName": "UUID", "shape": "guid", "role": "id" },
        { "name": "id", "displayName": "Device ID", "shape": "number" },
        { "name": "display_name", "displayName": "Display Name", "shape": "string", "visible": false },
        { "name": "custom_name", "displayName": "Custom Name", "shape": "string", "visible": false },
        { "name": "name", "displayName": "Raw Name", "shape": "string", "visible": false },
        {
            "name": "deviceName",
            "displayName": "Name",
            "computed": true,
            "valueExpression": "{{ $['display_name'] || $['custom_name'] || $['name'] }}",
            "shape": "string",
            "role": "label"
        },
        { "name": "os_family", "displayName": "OS Family", "shape": "string" },
        { "name": "os_name", "displayName": "OS", "shape": "string" },
        { "name": "os_version", "displayName": "OS Version", "shape": "string" },
        { "name": "agent_version", "displayName": "Agent Version", "shape": "string" },
        {
            "name": "connected",
            "displayName": "Connected",
            "shape": ["state", { "map": { "success": ["true"], "error": ["false"] } }]
        },
        {
            "name": "compliant",
            "displayName": "Compliant",
            "shape": ["state", { "map": { "success": ["true"], "error": ["false"] } }]
        },
        {
            "name": "needs_attention",
            "displayName": "Needs Attention",
            "shape": ["state", { "map": { "error": ["true"], "success": ["false"] } }]
        },
        { "name": "needs_reboot", "displayName": "Needs Reboot", "shape": "boolean" },
        { "name": "status", "displayName": "Status", "shape": "string" },
        { "name": "server_group_id", "displayName": "Server Group ID", "shape": "number" },
        { "name": "organization_id", "displayName": "Organization ID", "shape": "number", "visible": false },
        { "name": "ip_addrs", "displayName": "IP Addresses", "shape": "json" },
        { "name": "serial_number", "displayName": "Serial Number", "shape": "string" },
        { "name": "tags", "displayName": "Tags", "shape": "json" },
        { "name": "last_refresh_time", "displayName": "Last Refresh", "shape": "date" },
        { "name": "last_disconnect_time", "displayName": "Last Disconnected", "shape": "date", "visible": false },
        { "name": "next_patch_time", "displayName": "Next Patch Time", "shape": "date" },
        { "name": "create_time", "displayName": "Enrolled", "shape": "date" },
        { "name": "pending_patches", "displayName": "Pending Patches", "shape": "number" },
        { "name": "patch_deferral_count", "displayName": "Patch Deferral Count", "shape": "number", "visible": false },
        { "name": "policy_status", "displayName": "Policy Status", "shape": "json", "visible": false },
        {
            "name": "policyIds",
            "displayName": "Policy IDs",
            "computed": true,
            "valueExpression": "{{ ($['policy_status'] || []).map(p => p.policy_id) }}",
            "shape": "json",
            "visible": false
        },
        { "pattern": ".*" }
    ],
    "timeframes": false
}
