{
    "name": "deviceInventoryCategories",
    "displayName": "Device Inventory Categories",
    "description": "Inventory categories available for a device",
    "tags": ["Automox", "Device"],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "device-details/orgs/__ORG_UUID__/devices/{{object.rawId}}/categories",
        "errorHandling": { "type": "script", "script": "errorHandling/automoxRateLimit.js" }
    },
    "matches": { "sourceType": { "type": "oneOf", "values": ["Automox Device"] } },
    "visibility": { "type": "hidden" },
    "metadata": [
        { "name": "name", "displayName": "Category", "shape": "string", "role": "value" },
        { "name": "friendly_name", "displayName": "Category Name", "shape": "string", "role": "label" }
    ],
    "timeframes": false
}
