{
    "steps": [
        {
            "name": "projects",
            "dataStream": { "name": "projects" },
            "timeframe": "none",
            "objectMapping": {
                "id": "ref",
                "name": "name",
                "type": { "value": "Project" },
                "properties": [
                    "status",
                    { "organization": "organization_slug" },
                    "region",
                    { "postgresVersion": "database.version" },
                    "dashboardUrl"
                ]
            }
        },
        {
            "name": "edgeFunctions",
            "dataStream": { "name": "edgeFunctions" },
            "scope": {
                "query": "g.V().has(\"sourceType\", \"Project\")"
            },
            "timeframe": "none",
            "objectMapping": {
                "id": "id",
                "name": "name",
                "type": { "value": "Edge Function" },
                "properties": [
                    "slug",
                    "status",
                    "version",
                    "projectRef",
                    "projectName",
                    "dashboardUrl"
                ]
            },
            "optional": true,
            "dependsOn": ["projects"]
        }
    ]
