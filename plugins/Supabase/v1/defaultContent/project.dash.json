{
    "name": "Project",
    "schemaVersion": "1.5",
    "timeframe": "last24hours",
    "variables": [
        "{{variables.[Project]}}"
    ],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "db3d24b7-4134-48f8-9d65-1665cc81239c",
                "x": 0,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Project Details",
                    "description": "Status, organization, region and Postgres version of this project",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "datastream-properties",
                        "name": "properties",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Projects]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Project]}}"
                    },
                    "variables": [
                        "{{variables.[Project]}}"
                    ],
                    "timeframe": "none",
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "name",
                                        "title": "Name",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "status",
                                        "title": "Status",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "organization",
                                        "title": "Organization",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "region",
                                        "title": "Region",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "postgresVersion",
                                        "title": "Postgres version",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "dashboardUrl",
                                        "title": "Dashboard",
                                        "renderer": {
                                            "type": "link"
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableTranspose": true
                            }
                        }
                    }
                }
            },
            {
                "i": "7b2c550c-5dad-4c7b-a790-0e6b0da2c9a0",
                "x": 1,
                "y": 0,
                "w": 2,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Service Health",
                    "description": "Current health of each Supabase service for this project. Realtime can briefly report unhealthy on the first check of an idle project",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[serviceHealth]}}",
                        "name": "serviceHealth",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Projects]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Project]}}"
                    },
                    "variables": [
                        "{{variables.[Project]}}"
                    ],
                    "timeframe": "none",
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "statusGrid",
                            "encoding": {
                                "label": {
                                    "field": "service",
                                    "type": "nominal"
                                },
                                "status": {
                                    "field": "status",
                                    "type": "nominal"
                                }
                            },
                            "style": {
                                "statusGridColumnsPerRow": 3,
                                "statusGridLabelWrap": true
                            }
                        }
                    }
                }
            },
            {
                "i": "205b6545-c0b8-485d-a9ac-af6c53342620",
                "x": 3,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Disk Used",
                    "description": "Share of this project's database disk in use",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[diskUsage]}}",
                        "name": "diskUsage",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Projects]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Project]}}"
                    },
                    "variables": [
                        "{{variables.[Project]}}"
                    ],
                    "timeframe": "none",
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "ringGrid",
                            "encoding": {
                                "value": {
                                    "field": "usedPercent",
                                    "type": "quantitative"
                                },
                                "label": {
                                    "field": "projectName",
                                    "type": "nominal"
                                }
                            },
                            "style": {
                                "ringGridThresholds": [
                                    {
                                        "to": 0.7,
                                        "color": "#22c55e"
                                    },
                                    {
                                        "to": 0.85,
                                        "color": "#f59e0b"
                                    },
                                    {
                                        "to": 1,
                                        "color": "#ef4444"
                                    }
                                ],
                                "ringGridTrackWidth": 10
                            }
                        }
                    }
                }
            },
            {
                "i": "a48e6b0a-163a-4b53-b29a-7723dbee7d6a",
                "x": 0,
                "y": 2,
                "w": 2,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Database Resources",
                    "description": "Memory in use, connections against the maximum, and 1-minute load per CPU core for this project's database",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[databaseMetrics]}}",
                        "name": "databaseMetrics",
                        "pluginConfigId": "{{configId}}",
                        "sql": "SELECT 'Memory' AS \"metric\", CAST(\"memoryUsedPercent\" AS DOUBLE) AS \"used\" FROM \"dataset\" UNION ALL SELECT 'Connections · ' || CAST(CAST(\"activeConnections\" AS INTEGER) AS VARCHAR) || ' of ' || CAST(CAST(\"maxConnections\" AS INTEGER) AS VARCHAR), ROUND(CAST(\"activeConnections\" AS DOUBLE) * 100 / NULLIF(CAST(\"maxConnections\" AS DOUBLE), 0), 1) FROM \"dataset\" UNION ALL SELECT 'CPU load · ' || CAST(CAST(\"cpuCores\" AS INTEGER) AS VARCHAR) || ' cores', ROUND(CAST(\"load1\" AS DOUBLE) * 100 / NULLIF(CAST(\"cpuCores\" AS DOUBLE), 0), 1) FROM \"dataset\""
                    },
                    "scope": {
                        "scope": "{{scopes.[Projects]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Project]}}"
                    },
                    "variables": [
                        "{{variables.[Project]}}"
                    ],
                    "timeframe": "none",
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "ringGrid",
                            "encoding": {
                                "value": {
                                    "field": "used",
                                    "type": "quantitative"
                                },
                                "label": {
                                    "field": "metric",
                                    "type": "nominal"
                                }
                            },
                            "style": {
                                "ringGridThresholds": [
                                    {
                                        "to": 0.7,
                                        "color": "#22c55e"
                                    },
                                    {
                                        "to": 0.85,
                                        "color": "#f59e0b"
                                    },
                                    {
                                        "to": 1,
                                        "color": "#ef4444"
                                    }
                                ],
                                "ringGridTrackWidth": 10
                            }
                        }
                    }
                }
            },
            {
                "i": "f8a6f7b6-0b29-4b64-a7c2-7fc8e4d2c659",
                "x": 2,
                "y": 2,
                "w": 2,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Advisor Summary",
                    "description": "Advisor findings for this project: errors and warnings, and how many come from the security and performance advisors",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[advisors]}}",
                        "name": "advisors",
                        "pluginConfigId": "{{configId}}",
                        "sql": "SELECT CAST(COUNT(*) FILTER (WHERE \"level[Expanded].rawState\" = 'ERROR') AS DOUBLE) AS \"errors\", CAST(COUNT(*) FILTER (WHERE \"level[Expanded].rawState\" = 'WARN') AS DOUBLE) AS \"warnings\", CAST(COUNT(*) FILTER (WHERE \"advisor\" = 'Security') AS DOUBLE) AS \"security\", CAST(COUNT(*) FILTER (WHERE \"advisor\" = 'Performance') AS DOUBLE) AS \"performance\" FROM \"dataset\""
                    },
                    "scope": {
                        "scope": "{{scopes.[Projects]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Project]}}"
                    },
                    "variables": [
                        "{{variables.[Project]}}"
                    ],
                    "timeframe": "none",
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    {
                                        "field": "errors",
                                        "type": "quantitative",
                                        "title": "Errors",
                                        "aggregate": "sum"
                                    },
                                    {
                                        "field": "warnings",
                                        "type": "quantitative",
                                        "title": "Warnings",
                                        "aggregate": "sum"
                                    },
                                    {
                                        "field": "security",
                                        "type": "quantitative",
                                        "title": "Security",
                                        "aggregate": "sum"
                                    },
                                    {
                                        "field": "performance",
                                        "type": "quantitative",
                                        "title": "Performance",
                                        "aggregate": "sum"
                                    }
                                ]
                            },
                            "style": {
                                "scalarColumns": 4
                            }
                        }
                    }
                }
            },
            {
                "i": "c1e8e419-aa93-46d7-bc1a-d6d871b0d775",
                "x": 0,
                "y": 4,
                "w": 4,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Advisor Findings",
                    "description": "Every security and performance advisor finding for this project, most severe first, with a link to how to fix it",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[advisors]}}",
                        "name": "advisors",
                        "pluginConfigId": "{{configId}}",
                        "sql": "SELECT CASE \"level[Expanded].rawState\" WHEN 'ERROR' THEN 'Error' WHEN 'WARN' THEN 'Warning' ELSE 'Info' END AS \"severity\", \"title\", \"advisor\", \"entity\", \"detail\", \"remediation\" FROM \"dataset\" ORDER BY CASE \"level[Expanded].rawState\" WHEN 'ERROR' THEN 0 WHEN 'WARN' THEN 1 ELSE 2 END, \"advisor\" DESC, \"title\", \"entity\""
                    },
                    "scope": {
                        "scope": "{{scopes.[Projects]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Project]}}"
                    },
                    "variables": [
                        "{{variables.[Project]}}"
                    ],
                    "timeframe": "none",
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "severity",
                                        "title": "Level",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "Error": "#ef4444",
                                                "Warning": "#f59e0b",
                                                "Info": "#3b82f6"
                                            }
                                        },
                                        "width": 90
                                    },
                                    {
                                        "field": "title",
                                        "title": "Finding",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "advisor",
                                        "title": "Advisor",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "Security": "#8b5cf6",
                                                "Performance": "#0ea5e9"
                                            }
                                        },
                                        "width": 110
                                    },
                                    {
                                        "field": "entity",
                                        "title": "Affected object",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "detail",
                                        "title": "Detail",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "remediation",
                                        "title": "Fix",
                                        "renderer": {
                                            "type": "link"
                                        },
                                        "width": 110
                                    }
                                ]
                            },
                            "style": {
                                "detailsPanel": true
                            }
                        }
                    }
                }
            },
            {
                "i": "c5655add-14b3-45b7-b067-4902a788b130",
                "x": 0,
                "y": 8,
                "w": 2,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "API Requests by Service",
                    "description": "API requests to this project over the last 24 hours, by service",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[apiUsage]}}",
                        "name": "apiUsage",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Projects]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Project]}}"
                    },
                    "variables": [
                        "{{variables.[Project]}}"
                    ],
                    "timeframe": "last24hours",
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "line",
                            "encoding": {
                                "x": {
                                    "field": "timestamp",
                                    "type": "temporal"
                                },
                                "y": {
                                    "field": "requests",
                                    "type": "quantitative",
                                    "aggregate": "sum",
                                    "title": "Requests"
                                },
                                "series": {
                                    "field": "service",
                                    "type": "nominal"
                                }
                            },
                            "style": {
                                "cartesianAreaGradient": true,
                                "cartesianStack": "on"
                            }
                        }
                    }
                }
            },
            {
                "i": "8b5b6a71-47eb-4308-ae26-cb89d02ff021",
                "x": 2,
                "y": 8,
                "w": 2,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Responses by Status",
                    "description": "API gateway responses for this project over the last 24 hours, by HTTP status class. Amber is client errors (4xx), red is server errors (5xx)",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[apiResponses]}}",
                        "name": "apiResponses",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Projects]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Project]}}"
                    },
                    "variables": [
                        "{{variables.[Project]}}"
                    ],
                    "timeframe": "last24hours",
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "timestamp",
                                    "type": "temporal"
                                },
                                "y": {
                                    "field": "requests",
                                    "type": "quantitative",
                                    "aggregate": "sum",
                                    "title": "Requests"
                                },
                                "series": {
                                    "field": "statusClass",
                                    "type": "nominal"
                                }
                            },
                            "style": {
                                "cartesianStack": "on",
                                "mappedColors": {
                                    "2xx": "#22c55e",
                                    "3xx": "#3b82f6",
                                    "4xx": "#f59e0b",
                                    "5xx": "#ef4444",
                                    "1xx": "#64748b"
                                }
                            }
                        }
                    }
                }
            },
            {
                "i": "5ea44a85-abfa-4ecc-884d-a8a49eb26864",
                "x": 0,
                "y": 11,
                "w": 2,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Backups",
                    "description": "Database backups for this project, newest first, and whether point-in-time recovery is enabled",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[backups]}}",
                        "name": "backups",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [
                                [
                                    "insertedAt",
                                    "desc"
                                ]
                            ]
                        }
                    },
                    "scope": {
                        "scope": "{{scopes.[Projects]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Project]}}"
                    },
                    "variables": [
                        "{{variables.[Project]}}"
                    ],
                    "timeframe": "none",
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "status",
                                        "title": "Status",
                                        "renderer": {
                                            "type": "status",
                                            "showLabel": false
                                        },
                                        "width": 70
                                    },
                                    {
                                        "field": "insertedAt",
                                        "title": "Taken",
                                        "renderer": {
                                            "type": "date"
                                        }
                                    },
                                    {
                                        "field": "backupType",
                                        "title": "Type",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "pitrEnabled",
                                        "title": "PITR",
                                        "renderer": {
                                            "type": "boolean",
                                            "trueLabel": "On",
                                            "falseLabel": "Off",
                                            "trueColor": "#16a34a",
                                            "falseColor": "#64748b"
                                        }
                                    }
                                ]
                            }
                        }
                    }
                }
            },
            {
                "i": "487bb132-69e2-41a0-8671-6a37f60f3262",
                "x": 2,
                "y": 11,
                "w": 2,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Edge Functions",
                    "description": "Edge Functions deployed to this project. Click a function to open its dashboard",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[edgeFunctions]}}",
                        "name": "edgeFunctions",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [
                                [
                                    "name",
                                    "asc"
                                ]
                            ]
                        }
                    },
                    "scope": {
                        "scope": "{{scopes.[Projects]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Project]}}"
                    },
                    "variables": [
                        "{{variables.[Project]}}"
                    ],
                    "timeframe": "none",
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "status",
                                        "title": "Status",
                                        "renderer": {
                                            "type": "status",
                                            "showLabel": false
                                        },
                                        "width": 70
                                    },
                                    {
                                        "field": "name",
                                        "title": "Function",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "version",
                                        "title": "Version",
                                        "renderer": {
                                            "type": "number"
                                        },
                                        "align": "right",
                                        "width": 80
                                    },
                                    {
                                        "field": "updatedAt",
                                        "title": "Last deployed",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    },
                                    {
                                        "field": "dashboardUrl",
                                        "title": "Supabase",
                                        "renderer": {
                                            "type": "link"
                                        }
                                    }
                                ]
                            }
                        }
                    }
                }
            }
        ]
    }
}
