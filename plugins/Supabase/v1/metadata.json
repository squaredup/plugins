{
    "name": "supabase",
    "displayName": "Supabase",
    "version": "1.0.0",
    "author": { "name": "@adamkinniburgh", "type": "community" },
    "description": "Monitor your Supabase projects and Edge Functions in SquaredUp - track project and service health, security and performance advisors, API and function traffic, backups, and database resource usage.",
    "category": "Cloud Platforms",
    "type": "hybrid",
    "schemaVersion": "2.1",
    "importNotSupported": false,
    "restrictedToPlatforms": [],
    "keywords": [
        "supabase",
        "postgres",
        "database",
        "edge functions",
        "backend",
        "advisors",
        "projects"
    ],
    "objectTypes": ["Project", "Edge Function"],
    "links": [
        {
            "category": "documentation",
            "url": "https://github.com/squaredup/plugins/blob/main/plugins/Supabase/v1/docs/README.md",
            "label": "Help adding this plugin"
        },
        {
            "category": "source",
            "url": "https://github.com/squaredup/plugins/tree/main/plugins/Supabase",
            "label": "Repository"
        }
    ],
    "base": {
        "plugin": "WebAPI",
        "majorVersion": "1",
        "config": {
            "baseUrl": "https://api.supabase.com",
            "authMode": "none",
            "headers": [
                { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ]
        }
    }
}
