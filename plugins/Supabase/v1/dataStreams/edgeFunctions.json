{
    "name": "edgeFunctions",
    "displayName": "Edge Functions",
    "description": "The Edge Functions deployed to a project, with their status, version and last update",
    "tags": ["Edge Functions"],
    "baseDataSourceName": "httpRequestScopedSingle",
    "matches": {
        "sourceType": { "type": "equals", "value": "Project" }
    },
    "config": {
        "httpMethod": "get",
        "endpointPath": "/v1/projects/{{object.rawId}}/functions",
        "paging": { "mode": "none" },
        "postRequestScript": "edgeFunctions.js"
    },
    "metadata": [
        {
            "name": "id",
            "displayName": "Function ID",
            "shape": "string",
            "visible": false
        },
        {
            "name": "name",
            "displayName": "Name",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "slug",
            "displayName": "Slug",
            "shape": "string"
        },
        {
            "name": "status",
            "displayName": "Status",
            "shape": [
                "state",
                {
                    "map": {
                        "success": ["ACTIVE"],
                        "warning": ["THROTTLED"],
                        "unmonitored": ["REMOVED"]
                    }
                }
            ]
        },
        {
            "name": "version",
            "displayName": "Version",
            "shape": "number"
        },
        {
            "name": "verifyJwt",
            "displayName": "Verify JWT",
            "shape": "boolean"
        },
        {
            "name": "createdAt",
            "displayName": "Created",
            "shape": "date"
        },
        {
            "name": "updatedAt",
            "displayName": "Last deployed",
            "shape": "date"
        },
        {
            "name": "projectRef",
            "displayName": "Project reference ID",
            "shape": "string",
            "visible": false
        },
        {
            "name": "projectName",
            "displayName": "Project",
            "shape": "string"
        },
        {
            "name": "dashboardUrl",
            "displayName": "Dashboard",
            "shape": ["url", { "label": "Open in Supabase" }]
        },
        {
            "sourceId": "id",
            "sourceType": "Edge Function",
            "name": "name"
        }
    ],
    "timeframes": false
}
