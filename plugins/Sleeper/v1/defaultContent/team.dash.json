{
    "name": "Team",
    "schemaVersion": "1.5",
    "timeframe": "none",
    "variables": [
        "{{variables.[Sleeper Team]}}"
    ],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "b51dbedd-6981-4a1a-9824-688dc806ee5b",
                "x": 0,
                "y": 0,
                "w": 4,
                "h": 1,
                "z": 0,
                "moved": false,
                "static": false,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Season So Far",
                    "description": "Rank, record, luck and lineup efficiency for this team",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[standings]}}",
                        "name": "standings",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "teams": {
                                "variable": "{{variables.[Sleeper Team]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Sleeper Teams]}}"
                            }
                        }
                    },
                    "timeframe": "none",
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": true,
                                "columnOrder": [
                                    "rank",
                                    "wins",
                                    "losses",
                                    "luck",
                                    "efficiency",
                                    "missedPoints"
                                ]
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    {
                                        "field": "rank",
                                        "type": "quantitative",
                                        "title": "League Rank"
                                    },
                                    {
                                        "field": "wins",
                                        "type": "quantitative",
                                        "title": "Wins"
                                    },
                                    {
                                        "field": "losses",
                                        "type": "quantitative",
                                        "title": "Losses"
                                    },
                                    {
                                        "field": "luck",
                                        "type": "quantitative",
                                        "title": "Luck"
                                    },
                                    {
                                        "field": "efficiency",
                                        "type": "quantitative",
                                        "title": "Lineup Efficiency"
                                    },
                                    {
                                        "field": "missedPoints",
                                        "type": "quantitative",
                                        "title": "Points Missed"
                                    }
                                ]
                            },
                            "style": {
                                "scalarColumns": 6
                            }
                        }
                    },
                    "variables": [
                        "{{variables.[Sleeper Team]}}"
                    ]
                }
            },
            {
                "i": "7401eba4-01b9-4161-80ea-df80235eb9eb",
                "x": 0,
                "y": 1,
                "w": 2,
                "h": 2,
                "z": 0,
                "moved": false,
                "static": false,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Points vs Opponent",
                    "description": "Points scored and points conceded each week",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[weeklyScores]}}",
                        "name": "weeklyScores",
                        "pluginConfigId": "{{configId}}",
                        "group": {
                            "by": [
                                [
                                    "week",
                                    "uniqueValues"
                                ]
                            ],
                            "aggregate": [
                                {
                                    "type": "sum",
                                    "names": [
                                        "points"
                                    ]
                                },
                                {
                                    "type": "sum",
                                    "names": [
                                        "opponentPoints"
                                    ]
                                }
                            ]
                        },
                        "sort": {
                            "by": [
                                [
                                    "week_uniqueValues",
                                    "asc"
                                ]
                            ]
                        },
                        "dataSourceConfig": {
                            "teams": {
                                "variable": "{{variables.[Sleeper Team]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Sleeper Teams]}}"
                            }
                        }
                    },
                    "timeframe": "none",
                    "visualisation": {
                        "type": "data-stream-line-graph",
                        "config": {
                            "data-stream-line-graph": {
                                "xAxisColumn": "week_uniqueValues",
                                "yAxisColumn": [
                                    "points_sum",
                                    "opponentPoints_sum"
                                ],
                                "seriesColumn": "none",
                                "showLegend": true,
                                "legendPosition": "bottom",
                                "showTrendLine": false
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "line",
                            "encoding": {
                                "x": {
                                    "field": "week_uniqueValues",
                                    "type": "ordinal",
                                    "title": "Week"
                                }
                            },
                            "style": {
                                "mappedColors": {
                                    "points_sum": "#3b82f6",
                                    "opponentPoints_sum": "#ef4444"
                                },
                                "cartesianSmooth": true,
                                "legendPosition": "bottom"
                            }
                        }
                    },
                    "variables": [
                        "{{variables.[Sleeper Team]}}"
                    ]
                }
            },
            {
                "i": "54e680a0-57f6-4069-94db-455f63d495f7",
                "x": 2,
                "y": 1,
                "w": 2,
                "h": 2,
                "z": 0,
                "moved": false,
                "static": false,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Bench Points by Week",
                    "description": "Points scored by players on the bench each week",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[weeklyScores]}}",
                        "name": "weeklyScores",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [
                                [
                                    "week",
                                    "asc"
                                ]
                            ]
                        },
                        "dataSourceConfig": {
                            "teams": {
                                "variable": "{{variables.[Sleeper Team]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Sleeper Teams]}}"
                            }
                        }
                    },
                    "timeframe": "none",
                    "visualisation": {
                        "type": "data-stream-bar-chart",
                        "config": {
                            "data-stream-bar-chart": {
                                "xAxisData": "week",
                                "yAxisData": [
                                    "benchPoints"
                                ],
                                "xAxisGroup": "none",
                                "xAxisLabel": "",
                                "yAxisLabel": "",
                                "showXAxisLabel": false,
                                "showYAxisLabel": false,
                                "showLegend": false,
                                "legendPosition": "bottom",
                                "showGrid": true,
                                "horizontalLayout": "vertical",
                                "displayMode": "actual",
                                "showTotals": false,
                                "showValue": false,
                                "grouping": false,
                                "range": {
                                    "type": "auto"
                                }
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "week",
                                    "type": "ordinal",
                                    "title": "Week"
                                },
                                "y": {
                                    "field": "benchPoints",
                                    "type": "quantitative",
                                    "title": "Bench Points"
                                }
                            },
                            "markLines": [
                                {
                                    "type": "average",
                                    "label": "Average"
                                }
                            ],
                            "style": {
                                "colors": [
                                    "#f59e0b"
                                ],
                                "cartesianBarBorderRadius": 4
                            }
                        }
                    },
                    "variables": [
                        "{{variables.[Sleeper Team]}}"
                    ]
                }
            },
            {
                "i": "a4075d8e-487f-462d-b83e-2cfdd82014cf",
                "x": 0,
                "y": 3,
                "w": 4,
                "h": 3,
                "z": 0,
                "moved": false,
                "static": false,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Results by Week",
                    "description": "Every matchup this season",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[weeklyScores]}}",
                        "name": "weeklyScores",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [
                                [
                                    "week",
                                    "desc"
                                ]
                            ]
                        },
                        "dataSourceConfig": {
                            "teams": {
                                "variable": "{{variables.[Sleeper Team]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Sleeper Teams]}}"
                            }
                        }
                    },
                    "timeframe": "none",
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": [
                                    "week",
                                    "outcome",
                                    "opponent",
                                    "points",
                                    "opponentPoints",
                                    "margin",
                                    "weekRank",
                                    "award"
                                ],
                                "hiddenColumns": [
                                    "sourceId",
                                    "phase",
                                    "team",
                                    "benchPoints",
                                    "allPlayWins",
                                    "allPlayLosses",
                                    "aboveMedian"
                                ]
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "week",
                                        "title": "Week",
                                        "renderer": {
                                            "type": "number"
                                        },
                                        "width": 60,
                                        "align": "center"
                                    },
                                    {
                                        "field": "outcome",
                                        "title": "Result",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "Win": "#22c55e",
                                                "Tie": "#eab308",
                                                "Loss": "#ef4444"
                                            }
                                        }
                                    },
                                    {
                                        "field": "opponent",
                                        "title": "Opponent",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "points",
                                        "title": "Points",
                                        "renderer": {
                                            "type": "number",
                                            "decimals": 2
                                        },
                                        "align": "right"
                                    },
                                    {
                                        "field": "opponentPoints",
                                        "title": "Opp. Points",
                                        "renderer": {
                                            "type": "number",
                                            "decimals": 2
                                        },
                                        "align": "right"
                                    },
                                    {
                                        "field": "margin",
                                        "title": "Margin",
                                        "renderer": {
                                            "type": "delta"
                                        },
                                        "align": "right"
                                    },
                                    {
                                        "field": "weekRank",
                                        "title": "Weekly Rank",
                                        "renderer": {
                                            "type": "number"
                                        },
                                        "align": "center"
                                    },
                                    {
                                        "field": "award",
                                        "title": "Award",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "Top scorer": "#eab308",
                                                "Bottom scorer": "#94a3b8"
                                            }
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableSort": {
                                    "field": "week",
                                    "direction": "desc"
                                }
                            }
                        }
                    },
                    "variables": [
                        "{{variables.[Sleeper Team]}}"
                    ]
                }
            }
        ]
    }
}
