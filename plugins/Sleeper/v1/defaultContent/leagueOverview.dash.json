{
    "name": "League Overview",
    "schemaVersion": "1.5",
    "timeframe": "none",
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "ba087661-3fd2-41d8-87db-2350da08dc48",
                "x": 0,
                "y": 0,
                "w": 4,
                "h": 1,
                "z": 0,
                "moved": false,
                "static": false,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "",
                    "description": "",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[league]}}",
                        "name": "league",
                        "pluginConfigId": "{{configId}}"
                    },
                    "timeframe": "none",
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": true,
                                "columnOrder": [
                                    "name",
                                    "season",
                                    "settings.leg",
                                    "total_rosters"
                                ]
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    {
                                        "field": "name",
                                        "type": "nominal",
                                        "title": "League"
                                    },
                                    {
                                        "field": "season",
                                        "type": "nominal",
                                        "title": "Season"
                                    },
                                    {
                                        "field": "settings.leg",
                                        "type": "quantitative",
                                        "title": "Current Week"
                                    },
                                    {
                                        "field": "total_rosters",
                                        "type": "quantitative",
                                        "title": "Teams"
                                    }
                                ]
                            },
                            "style": {
                                "scalarColumns": 4
                            }
                        }
                    }
                }
            },
            {
                "i": "a9c94394-ddf5-4a71-bb14-9d4121986b89",
                "x": 0,
                "y": 1,
                "w": 3,
                "h": 4,
                "z": 0,
                "moved": false,
                "static": false,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Standings",
                    "description": "Season-to-date record, points, missed points, lineup efficiency and luck",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[standings]}}",
                        "name": "standings",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [
                                [
                                    "rank",
                                    "asc"
                                ]
                            ]
                        }
                    },
                    "timeframe": "none",
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": [
                                    "rank",
                                    "team",
                                    "manager",
                                    "wins",
                                    "losses",
                                    "pointsFor",
                                    "missedPoints",
                                    "efficiency",
                                    "luck"
                                ],
                                "hiddenColumns": [
                                    "sourceId",
                                    "ties",
                                    "pointsAgainst",
                                    "maxPoints",
                                    "winPct",
                                    "allPlayPct",
                                    "expectedWins"
                                ]
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "rank",
                                        "title": "#",
                                        "renderer": {
                                            "type": "number"
                                        },
                                        "width": 50,
                                        "align": "center"
                                    },
                                    {
                                        "field": "team",
                                        "title": "Team",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "manager",
                                        "title": "Manager",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "wins",
                                        "title": "W",
                                        "renderer": {
                                            "type": "number"
                                        },
                                        "align": "right"
                                    },
                                    {
                                        "field": "losses",
                                        "title": "L",
                                        "renderer": {
                                            "type": "number"
                                        },
                                        "align": "right"
                                    },
                                    {
                                        "field": "pointsFor",
                                        "title": "Points For",
                                        "renderer": {
                                            "type": "bar",
                                            "color": "#3b82f6"
                                        }
                                    },
                                    {
                                        "field": "missedPoints",
                                        "title": "Points Missed",
                                        "renderer": {
                                            "type": "number",
                                            "decimals": 1,
                                            "thresholds": [
                                                {
                                                    "to": 100,
                                                    "color": "#16a34a"
                                                },
                                                {
                                                    "to": 200,
                                                    "color": "#f59e0b"
                                                },
                                                {
                                                    "to": 100000,
                                                    "color": "#ef4444"
                                                }
                                            ]
                                        },
                                        "align": "right"
                                    },
                                    {
                                        "field": "efficiency",
                                        "title": "Lineup Efficiency",
                                        "renderer": {
                                            "type": "progress",
                                            "max": 100
                                        }
                                    },
                                    {
                                        "field": "luck",
                                        "title": "Luck",
                                        "renderer": {
                                            "type": "delta"
                                        },
                                        "align": "right"
                                    }
                                ]
                            },
                            "style": {
                                "richTableSort": {
                                    "field": "rank",
                                    "direction": "asc"
                                },
                                "richTableRowHighlight": {
                                    "field": "rank",
                                    "thresholds": [
                                        {
                                            "to": 1,
                                            "color": "rgba(234,179,8,0.15)"
                                        }
                                    ]
                                }
                            }
                        }
                    }
                }
            },
            {
                "i": "faffe14a-3483-4208-a476-0d6608b836d1",
                "x": 3,
                "y": 1,
                "w": 1,
                "h": 4,
                "z": 0,
                "moved": false,
                "static": false,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "This Week's Awards",
                    "description": "Top and bottom scorer of the most recent scored week",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[weeklyScores]}}",
                        "name": "weeklyScores",
                        "pluginConfigId": "{{configId}}",
                        "filter": {
                            "multiOperation": "and",
                            "filters": [
                                {
                                    "column": "award",
                                    "operation": "notempty"
                                }
                            ]
                        },
                        "sort": {
                            "by": [
                                [
                                    "week",
                                    "desc"
                                ],
                                [
                                    "points",
                                    "desc"
                                ]
                            ],
                            "top": 2
                        }
                    },
                    "timeframe": "none",
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": [
                                    "award",
                                    "team",
                                    "points",
                                    "week"
                                ],
                                "hiddenColumns": [
                                    "sourceId",
                                    "phase",
                                    "opponent",
                                    "opponentPoints",
                                    "margin",
                                    "outcome",
                                    "benchPoints",
                                    "weekRank",
                                    "allPlayWins",
                                    "allPlayLosses",
                                    "aboveMedian"
                                ]
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "award",
                                        "title": "Award",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "Top scorer": "#eab308",
                                                "Bottom scorer": "#94a3b8"
                                            }
                                        }
                                    },
                                    {
                                        "field": "team",
                                        "title": "Team",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "points",
                                        "title": "Points",
                                        "renderer": {
                                            "type": "number",
                                            "decimals": 2
                                        },
                                        "align": "right"
                                    },
                                    {
                                        "field": "week",
                                        "title": "Week",
                                        "renderer": {
                                            "type": "number"
                                        },
                                        "align": "center"
                                    }
                                ]
                            },
                            "style": {
                                "richTableFontSize": 16,
                                "richTableCellPadding": 12,
                                "richTableSort": {
                                    "field": "points",
                                    "direction": "desc"
                                }
                            }
                        }
                    }
                }
            },
            {
                "i": "dd762e57-d4e9-4846-bd74-bed4c3ff96b5",
                "x": 0,
                "y": 5,
                "w": 2,
                "h": 3,
                "z": 0,
                "moved": false,
                "static": false,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Luck",
                    "description": "Actual wins minus expected wins from all-play record. Positive is lucky, negative is unlucky",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[standings]}}",
                        "name": "standings",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [
                                [
                                    "luck",
                                    "desc"
                                ]
                            ]
                        }
                    },
                    "timeframe": "none",
                    "visualisation": {
                        "type": "data-stream-bar-chart",
                        "config": {
                            "data-stream-bar-chart": {
                                "xAxisData": "team",
                                "yAxisData": [
                                    "luck"
                                ],
                                "xAxisGroup": "none",
                                "xAxisLabel": "",
                                "yAxisLabel": "",
                                "showXAxisLabel": false,
                                "showYAxisLabel": false,
                                "showLegend": false,
                                "legendPosition": "bottom",
                                "showGrid": true,
                                "horizontalLayout": "vertical",
                                "displayMode": "actual",
                                "showTotals": false,
                                "showValue": false,
                                "grouping": false,
                                "range": {
                                    "type": "auto"
                                }
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "team",
                                    "type": "nominal",
                                    "title": "Team"
                                },
                                "y": {
                                    "field": "luck",
                                    "type": "quantitative",
                                    "title": "Luck"
                                }
                            },
                            "style": {
                                "cartesianHorizontal": true,
                                "cartesianBarBorderRadius": 4,
                                "cartesianColorRules": [
                                    {
                                        "lt": 0,
                                        "color": "#ef4444"
                                    },
                                    {
                                        "gte": 0,
                                        "color": "#22c55e"
                                    }
                                ],
                                "showLabels": true
                            }
                        }
                    }
                }
            },
            {
                "i": "3c2470de-37d5-459c-af95-8eb16b62ed3d",
                "x": 2,
                "y": 5,
                "w": 2,
                "h": 3,
                "z": 0,
                "moved": false,
                "static": false,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Points Missed",
                    "description": "Points each team left on the table by not playing its best possible lineup",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[standings]}}",
                        "name": "standings",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [
                                [
                                    "missedPoints",
                                    "desc"
                                ]
                            ]
                        }
                    },
                    "timeframe": "none",
                    "visualisation": {
                        "type": "data-stream-bar-chart",
                        "config": {
                            "data-stream-bar-chart": {
                                "xAxisData": "team",
                                "yAxisData": [
                                    "missedPoints"
                                ],
                                "xAxisGroup": "none",
                                "xAxisLabel": "",
                                "yAxisLabel": "",
                                "showXAxisLabel": false,
                                "showYAxisLabel": false,
                                "showLegend": false,
                                "legendPosition": "bottom",
                                "showGrid": true,
                                "horizontalLayout": "vertical",
                                "displayMode": "actual",
                                "showTotals": false,
                                "showValue": false,
                                "grouping": false,
                                "range": {
                                    "type": "auto"
                                }
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "team",
                                    "type": "nominal",
                                    "title": "Team"
                                },
                                "y": {
                                    "field": "missedPoints",
                                    "type": "quantitative",
                                    "title": "Points Missed"
                                }
                            },
                            "style": {
                                "cartesianHorizontal": true,
                                "cartesianBarBorderRadius": 4,
                                "colors": [
                                    "#f59e0b"
                                ],
                                "showLabels": true
                            }
                        }
                    }
                }
            },
            {
                "i": "abb4dc26-3856-4f7f-bfa6-15bbf6f33cb6",
                "x": 0,
                "y": 8,
                "w": 4,
                "h": 4,
                "z": 0,
                "moved": false,
                "static": false,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Points by Week",
                    "description": "Weekly score for every team",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[weeklyScores]}}",
                        "name": "weeklyScores",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [
                                [
                                    "week",
                                    "asc"
                                ]
                            ]
                        }
                    },
                    "timeframe": "none",
                    "visualisation": {
                        "type": "data-stream-line-graph",
                        "config": {
                            "data-stream-line-graph": {
                                "xAxisColumn": "week",
                                "yAxisColumn": [
                                    "points"
                                ],
                                "seriesColumn": "team",
                                "showLegend": true,
                                "legendPosition": "bottom",
                                "showTrendLine": false
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "line",
                            "encoding": {
                                "x": {
                                    "field": "week",
                                    "type": "ordinal",
                                    "title": "Week"
                                },
                                "y": {
                                    "field": "points",
                                    "type": "quantitative",
                                    "title": "Points"
                                },
                                "series": {
                                    "field": "team",
                                    "type": "nominal",
                                    "title": "Team"
                                }
                            },
                            "style": {
                                "cartesianSmooth": true,
                                "legendPosition": "right"
                            }
                        }
                    }
                }
            }
        ]
    }
}
