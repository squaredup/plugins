{
    "name": "Trends",
    "schemaVersion": "1.5",
    "timeframe": "none",
    "variables": [
        "{{variables.[Sleeper Team]}}"
    ],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "3dec79de-2971-425f-850e-4eca2dba6365",
                "x": 0,
                "y": 0,
                "w": 2,
                "h": 3,
                "z": 0,
                "moved": false,
                "static": false,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Weekly Scoring",
                    "description": "Points each week against the 3-week average and the league average",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[weeklyScores]}}",
                        "name": "weeklyScores",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [
                                [
                                    "week",
                                    "asc"
                                ]
                            ]
                        },
                        "dataSourceConfig": {
                            "teams": {
                                "variable": "{{variables.[Sleeper Team]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Sleeper Teams]}}"
                            }
                        }
                    },
                    "timeframe": "none",
                    "visualisation": {
                        "type": "data-stream-line-graph",
                        "config": {
                            "data-stream-line-graph": {
                                "xAxisColumn": "week",
                                "yAxisColumn": [
                                    "points",
                                    "rollingAvgPoints",
                                    "leagueAvgPoints"
                                ],
                                "seriesColumn": "none",
                                "showLegend": true,
                                "legendPosition": "bottom",
                                "showTrendLine": false
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "line",
                            "encoding": {
                                "x": {
                                    "field": "week",
                                    "type": "ordinal",
                                    "title": "Week"
                                }
                            },
                            "style": {
                                "mappedColors": {
                                    "points": "#3b82f6",
                                    "rollingAvgPoints": "#f59e0b",
                                    "leagueAvgPoints": "#94a3b8"
                                },
                                "cartesianSmooth": true,
                                "legendPosition": "bottom"
                            }
                        }
                    },
                    "variables": [
                        "{{variables.[Sleeper Team]}}"
                    ]
                }
            },
            {
                "i": "f8c824e0-6422-4099-9a79-a38c1c78b77f",
                "x": 2,
                "y": 0,
                "w": 2,
                "h": 3,
                "z": 0,
                "moved": false,
                "static": false,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Weekly Rank",
                    "description": "Rank among all teams each week (1 is the top score)",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[weeklyScores]}}",
                        "name": "weeklyScores",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [
                                [
                                    "week",
                                    "asc"
                                ]
                            ]
                        },
                        "dataSourceConfig": {
                            "teams": {
                                "variable": "{{variables.[Sleeper Team]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Sleeper Teams]}}"
                            }
                        }
                    },
                    "timeframe": "none",
                    "visualisation": {
                        "type": "data-stream-line-graph",
                        "config": {
                            "data-stream-line-graph": {
                                "xAxisColumn": "week",
                                "yAxisColumn": [
                                    "weekRank"
                                ],
                                "seriesColumn": "none",
                                "showLegend": false,
                                "legendPosition": "bottom",
                                "showTrendLine": false
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "line",
                            "encoding": {
                                "x": {
                                    "field": "week",
                                    "type": "ordinal",
                                    "title": "Week"
                                }
                            },
                            "style": {
                                "mappedColors": {
                                    "weekRank": "#8b5cf6"
                                },
                                "cartesianSmooth": true,
                                "legendPosition": "bottom"
                            }
                        }
                    },
                    "variables": [
                        "{{variables.[Sleeper Team]}}"
                    ]
                }
            },
            {
                "i": "92b71275-8f76-4739-9721-e0b66f33e88d",
                "x": 0,
                "y": 3,
                "w": 2,
                "h": 3,
                "z": 0,
                "moved": false,
                "static": false,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Margin of Victory",
                    "description": "Winning or losing margin against each opponent, week by week",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[weeklyScores]}}",
                        "name": "weeklyScores",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [
                                [
                                    "week",
                                    "asc"
                                ]
                            ]
                        },
                        "dataSourceConfig": {
                            "teams": {
                                "variable": "{{variables.[Sleeper Team]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Sleeper Teams]}}"
                            }
                        }
                    },
                    "timeframe": "none",
                    "visualisation": {
                        "type": "data-stream-bar-chart",
                        "config": {
                            "data-stream-bar-chart": {
                                "xAxisData": "week",
                                "yAxisData": [
                                    "margin"
                                ],
                                "xAxisGroup": "none",
                                "xAxisLabel": "",
                                "yAxisLabel": "",
                                "showXAxisLabel": false,
                                "showYAxisLabel": false,
                                "showLegend": false,
                                "legendPosition": "bottom",
                                "showGrid": true,
                                "horizontalLayout": "vertical",
                                "displayMode": "actual",
                                "showTotals": false,
                                "showValue": false,
                                "grouping": false,
                                "range": {
                                    "type": "auto"
                                }
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "week",
                                    "type": "ordinal",
                                    "title": "Week"
                                },
                                "y": {
                                    "field": "margin",
                                    "type": "quantitative",
                                    "title": "Margin"
                                }
                            },
                            "style": {
                                "colors": [
                                    "#14b8a6"
                                ],
                                "cartesianBarBorderRadius": 4
                            }
                        }
                    },
                    "variables": [
                        "{{variables.[Sleeper Team]}}"
                    ]
                }
            },
            {
                "i": "e0cba075-ea32-4d11-8f5e-1b49ba3b85f3",
                "x": 2,
                "y": 3,
                "w": 2,
                "h": 3,
                "z": 0,
                "moved": false,
                "static": false,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Luck Over Time",
                    "description": "Cumulative wins above what the weekly scores predict (negative is unlucky)",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[weeklyScores]}}",
                        "name": "weeklyScores",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [
                                [
                                    "week",
                                    "asc"
                                ]
                            ]
                        },
                        "dataSourceConfig": {
                            "teams": {
                                "variable": "{{variables.[Sleeper Team]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Sleeper Teams]}}"
                            }
                        }
                    },
                    "timeframe": "none",
                    "visualisation": {
                        "type": "data-stream-line-graph",
                        "config": {
                            "data-stream-line-graph": {
                                "xAxisColumn": "week",
                                "yAxisColumn": [
                                    "cumulativeLuck"
                                ],
                                "seriesColumn": "none",
                                "showLegend": false,
                                "legendPosition": "bottom",
                                "showTrendLine": false
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "line",
                            "encoding": {
                                "x": {
                                    "field": "week",
                                    "type": "ordinal",
                                    "title": "Week"
                                }
                            },
                            "style": {
                                "mappedColors": {
                                    "cumulativeLuck": "#ef4444"
                                },
                                "cartesianSmooth": true,
                                "legendPosition": "bottom"
                            }
                        }
                    },
                    "variables": [
                        "{{variables.[Sleeper Team]}}"
                    ]
                }
            }
        ]
    }
}
