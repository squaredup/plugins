{
    "name": "weeklyScores",
    "displayName": "Weekly Scores",
    "description": "Each team's score, opponent, result, bench points and weekly rank for every scored week of the season",
    "tags": ["Matchup", "Team"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "league/{{dataSource.leagueId}}",
        "postRequestScript": "weeklyScores.js"
    },
    "matches": "none",
    "ui": [
        {
            "type": "objects",
            "name": "teams",
            "label": "Teams (optional)",
            "matches": {
                "sourceType": { "type": "oneOf", "values": ["Sleeper Team"] }
            }
        }
    ],
    "metadata": [
        { "name": "sourceId", "displayName": "Source ID", "visible": false },
        { "name": "week", "displayName": "Week", "shape": "number" },
        { "name": "phase", "displayName": "Phase" },
        { "name": "team", "displayName": "Team" },
        { "name": "points", "displayName": "Points", "shape": ["number", { "decimalPlaces": 2 }] },
        { "name": "opponent", "displayName": "Opponent" },
        { "name": "opponentPoints", "displayName": "Opponent Points", "shape": ["number", { "decimalPlaces": 2 }] },
        { "name": "margin", "displayName": "Margin", "shape": ["number", { "decimalPlaces": 2 }] },
        {
            "name": "outcome",
            "displayName": "Result",
            "shape": ["state", { "map": { "success": ["Win"], "warning": ["Tie"], "error": ["Loss"] } }]
        },
        { "name": "benchPoints", "displayName": "Bench Points", "shape": ["number", { "decimalPlaces": 2 }] },
        { "name": "weekRank", "displayName": "Weekly Rank", "shape": "number" },
        { "name": "allPlayWins", "displayName": "All-Play Wins", "shape": "number" },
        { "name": "allPlayLosses", "displayName": "All-Play Losses", "shape": "number" },
        { "name": "aboveMedian", "displayName": "Above Median", "shape": "boolean" },
        { "name": "award", "displayName": "Award" }
    ],
    "defaultShaping": {
        "sort": { "by": [["week", "desc"], ["weekRank", "asc"]] }
    },
    "timeframes": false
}
