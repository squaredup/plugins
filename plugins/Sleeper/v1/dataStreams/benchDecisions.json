{
    "name": "benchDecisions",
    "displayName": "Bench Decisions",
    "description": "Benched players who would have scored more than a starter, and how many points each lineup choice cost",
    "tags": ["Matchup", "Team"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "league/{{dataSource.leagueId}}",
        "postRequestScript": "benchDecisions.js"
    },
    "matches": "none",
    "ui": [
        {
            "type": "objects",
            "name": "teams",
            "label": "Teams (optional)",
            "matches": {
                "sourceType": { "type": "oneOf", "values": ["Sleeper Team"] }
            }
        }
    ],
    "metadata": [
        { "name": "sourceId", "displayName": "Source ID", "visible": false },
        { "name": "week", "displayName": "Week", "shape": "number" },
        { "name": "team", "displayName": "Team" },
        { "name": "slot", "displayName": "Lineup Slot" },
        { "name": "benchedPlayer", "displayName": "Benched Player" },
        { "name": "benchedPoints", "displayName": "Benched Points", "shape": ["number", { "decimalPlaces": 2 }] },
        { "name": "startedPlayer", "displayName": "Started Instead" },
        { "name": "startedPoints", "displayName": "Started Points", "shape": ["number", { "decimalPlaces": 2 }] },
        { "name": "pointsLost", "displayName": "Points Lost", "shape": ["number", { "decimalPlaces": 2 }] }
    ],
    "defaultShaping": {
        "sort": { "by": [["pointsLost", "desc"]] }
    },
    "timeframes": false
}
