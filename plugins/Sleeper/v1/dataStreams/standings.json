{
    "name": "standings",
    "displayName": "Standings",
    "description": "Season-to-date record, points, bench points, lineup efficiency and luck for each team",
    "tags": ["League", "Team"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "league/{{dataSource.leagueId}}",
        "postRequestScript": "standings.js"
    },
    "matches": "none",
    "ui": [
        {
            "type": "objects",
            "name": "teams",
            "label": "Teams (optional)",
            "matches": {
                "sourceType": { "type": "oneOf", "values": ["Sleeper Team"] }
            }
        }
    ],
    "metadata": [
        { "name": "rank", "displayName": "Rank", "shape": "number" },
        { "name": "sourceId", "displayName": "Source ID", "visible": false },
        { "name": "team", "displayName": "Team" },
        { "name": "manager", "displayName": "Manager" },
        { "name": "wins", "displayName": "Wins", "shape": "number" },
        { "name": "losses", "displayName": "Losses", "shape": "number" },
        { "name": "ties", "displayName": "Ties", "shape": "number" },
        { "name": "pointsFor", "displayName": "Points For", "shape": ["number", { "decimalPlaces": 2 }] },
        { "name": "pointsAgainst", "displayName": "Points Against", "shape": ["number", { "decimalPlaces": 2 }] },
        { "name": "maxPoints", "displayName": "Max Possible Points", "shape": ["number", { "decimalPlaces": 2 }] },
        { "name": "benchPoints", "displayName": "Points Left on Bench", "shape": ["number", { "decimalPlaces": 2 }] },
        { "name": "efficiency", "displayName": "Lineup Efficiency", "shape": "percent" },
        { "name": "winPct", "displayName": "Win %", "shape": "percent" },
        { "name": "allPlayPct", "displayName": "All-Play Win %", "shape": "percent" },
        { "name": "luck", "displayName": "Luck", "shape": ["number", { "decimalPlaces": 1 }] },
        { "name": "expectedWins", "displayName": "Expected Wins", "shape": ["number", { "decimalPlaces": 1 }] }
    ],
    "defaultShaping": {
        "sort": { "by": [["rank", "asc"]] }
    },
    "timeframes": false
}
