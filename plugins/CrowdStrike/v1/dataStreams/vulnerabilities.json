{
    "name": "vulnerabilities",
    "displayName": "Vulnerabilities",
    "description": "Open Spotlight vulnerabilities with CVE, severity and remediation detail, one row per vulnerability finding",
    "tags": ["Security", "Vulnerabilities"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/spotlight/combined/vulnerabilities/v1",
        "getArgs": [
            { "key": "limit", "value": "200" },
            { "key": "facet", "value": "host_info" },
            {
                "key": "filter",
                "value": "{{(function(){var parts=[];var sel=(typeof scope!=='undefined'?scope:[])||[];var unwrap=function(v){return Array.isArray(v)?v[0]:v;};if(sel.length){var dev=[],grp=[];sel.forEach(function(o){var id=unwrap(o.rawId);if(o.type==='CrowdStrike Host Group'){grp.push(id);}else{dev.push(id);}});if(dev.length)parts.push(\"aid:[\"+dev.map(function(i){return \"'\"+i+\"'\";}).join(\",\")+\"]\");if(grp.length)parts.push(\"host_info.groups:[\"+grp.map(function(i){return \"'\"+i+\"'\";}).join(\",\")+\"]\");}var st=(typeof status!=='undefined'?status:[])||[];if(st.length)parts.push(\"status:[\"+st.map(function(s){return \"'\"+(s.value||s)+\"'\";}).join(\",\")+\"]\");return parts.length?parts.join(\"+\"):null;})()}}"
            }
        ],
        "paging": {
            "mode": "offset",
            "pageSize": { "realm": "queryArg", "path": "limit", "value": "200" },
            "offset": {
                "mode": "row",
                "rowCountIn": { "realm": "payloadArraySize", "path": "resources" },
                "base": 0
            },
            "out": { "realm": "queryArg", "path": "offset" }
        },
        "pathToData": "resources",
        "expandInnerObjects": true
    },
    "matches": "none",
    "ui": [
        {
            "type": "objects",
            "name": "scope",
            "label": "Host or Host Group (optional)",
            "matches": {
                "sourceType": { "type": "oneOf", "values": ["CrowdStrike Host", "CrowdStrike Host Group"] }
            }
        },
        {
            "type": "choiceChips",
            "name": "status",
            "label": "Status",
            "isMulti": true,
            "options": [
                { "value": "open", "label": "Open" },
                { "value": "closed", "label": "Closed" },
                { "value": "reopen", "label": "Reopened" },
                { "value": "expired", "label": "Expired" }
            ]
        }
    ],
    "metadata": [
        { "name": "id", "displayName": "ID", "shape": "string", "role": "id", "visible": false },
        { "name": "aid", "displayName": "Device ID", "shape": "string", "visible": false },
        { "name": "cve.id", "displayName": "CVE", "shape": "string", "role": "label" },
        { "name": "cve.severity", "displayName": "CVE Severity", "shape": "string" },
        { "name": "cve.base_score", "displayName": "CVSS Score", "shape": "number" },
        { "name": "cve.exploit_status", "displayName": "Exploit Status", "shape": "string" },
        { "name": "cve.published_date", "displayName": "CVE Published", "shape": "date" },
        { "name": "status", "displayName": "Status", "shape": "string" },
        { "name": "host_info.hostname", "displayName": "Hostname", "shape": "string" },
        { "name": "host_info.platform", "displayName": "Platform", "shape": "string" },
        { "name": "host_info.local_ip", "displayName": "Local IP", "shape": "string" },
        { "name": "app.product_name_version", "displayName": "Affected Product", "shape": "string" },
        { "name": "created_timestamp", "displayName": "First Found", "shape": "date", "role": "timestamp" },
        { "name": "updated_timestamp", "displayName": "Last Updated", "shape": "date" },
        { "name": "closed_timestamp", "displayName": "Closed", "shape": "date" },
        {
            "name": "daysOpen",
            "displayName": "Days Open",
            "computed": true,
            "valueExpression": "{{ $['created_timestamp'] ? Math.floor((Date.now() - new Date($['created_timestamp'])) / 86400000) : null }}",
            "shape": "number"
        },
        { "sourceId": "aid", "sourceType": "CrowdStrike Host", "name": "host_info.hostname" },
        { "pattern": ".*" }
    ],
    "timeframes": false
}
