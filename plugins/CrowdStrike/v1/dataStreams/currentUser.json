{
    "name": "currentUser",
    "displayName": "Current User",
    "description": "A minimal Falcon Hosts query, used only to verify the configured credentials can reach the API",
    "tags": ["Security"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/devices/queries/devices/v1",
        "getArgs": [{ "key": "limit", "value": "1" }],
        "paging": { "mode": "none" },
        "pathToData": "resources"
    },
    "matches": "none",
    "visibility": { "type": "hidden" },
    "metadata": [{ "pattern": ".*" }],
    "timeframes": false
}
