{
    "name": "preventionPolicies",
    "displayName": "Prevention Policies",
    "description": "Prevention policies assigned to a Host Group, one row per policy",
    "tags": ["Security", "Policies"],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/policy/combined/prevention/v1",
        "getArgs": [
            { "key": "limit", "value": "100" },
            { "key": "filter", "value": "groups:'{{object.rawId}}'" }
        ],
        "pathToData": "resources",
        "expandInnerObjects": true
    },
    "matches": { "sourceType": { "type": "oneOf", "values": ["CrowdStrike Host Group"] } },
    "metadata": [
        { "name": "id", "displayName": "ID", "shape": "string", "role": "id", "visible": false },
        { "name": "name", "displayName": "Policy Name", "shape": "string", "role": "label" },
        { "name": "description", "displayName": "Description", "shape": "string" },
        { "name": "platform_name", "displayName": "Platform", "shape": "string" },
        { "name": "enabled", "displayName": "Enabled", "shape": "boolean" },
        { "name": "created_timestamp", "displayName": "Created", "shape": "date" },
        { "name": "modified_timestamp", "displayName": "Last Modified", "shape": "date" },
        { "pattern": ".*" }
    ],
    "timeframes": false
}
