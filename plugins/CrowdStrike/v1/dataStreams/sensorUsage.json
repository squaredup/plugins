{
    "name": "sensorUsage",
    "displayName": "Sensor Usage",
    "description": "Weekly average of unique sensors seen reporting, account-wide",
    "tags": ["Security", "Usage"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/billing-dashboards-usage/aggregates/weekly-average/v1",
        "pathToData": "resources",
        "expandInnerObjects": true
    },
    "matches": "none",
    "metadata": [{ "pattern": ".*" }],
    "timeframes": ["last30days", "thisQuarter", "lastQuarter"]
}
