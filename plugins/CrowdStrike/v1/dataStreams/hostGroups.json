{
    "name": "hostGroups",
    "displayName": "Host Groups",
    "description": "All Host Groups (agencies) in the Falcon tenant",
    "tags": ["Security"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/devices/combined/host-groups/v1",
        "getArgs": [{ "key": "limit", "value": "500" }],
        "paging": {
            "mode": "offset",
            "pageSize": { "realm": "queryArg", "path": "limit", "value": "500" },
            "offset": {
                "mode": "row",
                "rowCountIn": { "realm": "payloadArraySize", "path": "resources" },
                "base": 0
            },
            "out": { "realm": "queryArg", "path": "offset" }
        },
        "pathToData": "resources"
    },
    "matches": "none",
    "visibility": { "type": "hidden" },
    "metadata": [
        { "name": "id", "displayName": "ID", "shape": "string", "visible": false },
        { "name": "name", "displayName": "Name", "shape": "string", "role": "label" },
        { "name": "description", "displayName": "Description", "shape": "string" },
        { "name": "group_type", "displayName": "Group Type", "shape": "string" },
        { "name": "assignment_rule", "displayName": "Assignment Rule", "shape": "string" },
        { "name": "created_by", "displayName": "Created By", "shape": "string" },
        { "name": "created_timestamp", "displayName": "Created", "shape": "date" },
        { "name": "modified_by", "displayName": "Modified By", "shape": "string" },
        { "name": "modified_timestamp", "displayName": "Last Modified", "shape": "date" },
        { "pattern": ".*" }
    ],
    "timeframes": false
}
