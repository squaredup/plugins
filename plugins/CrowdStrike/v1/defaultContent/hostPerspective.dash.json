{
    "name": "Host",
    "schemaVersion": "1.5",
    "timeframe": "last7days",
    "variables": ["{{variables.[Host]}}"],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "5a326895-b8cd-4f69-9859-58207ff7fe38",
                "x": 0,
                "y": 0,
                "w": 2,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Device Properties",
                    "description": "",
                    "activePluginConfigIds": ["{{configId}}"],
                    "timeframe": "none",
                    "variables": ["{{variables.[Host]}}"],
                    "dataStream": {
                        "id": "datastream-properties",
                        "name": "properties"
                    },
                    "scope": {
                        "scope": "{{scopes.[Hosts]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Host]}}"
                    },
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": { "data-stream-table": { "transpose": true } }
                    }
                }
            },
            {
                "i": "a5ce7ce3-c43c-4713-9b55-468a6abbd363",
                "x": 2,
                "y": 0,
                "w": 2,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Alert Volume Over Time",
                    "description": "",
                    "activePluginConfigIds": ["{{configId}}"],
                    "variables": ["{{variables.[Host]}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[alerts]}}",
                        "name": "alerts",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "scope": {
                                "variable": "{{variables.[Host]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Hosts]}}"
                            }
                        },
                        "group": {
                            "by": [["created_timestamp", "byDay"]],
                            "aggregate": [{ "type": "count" }]
                        },
                        "sort": { "by": [["created_timestamp_byDay", "asc"]] }
                    },
                    "visualisation": {
                        "type": "data-stream-bar-chart",
                        "config": {
                            "data-stream-bar-chart": {
                                "xAxisData": "created_timestamp_byDay",
                                "yAxisData": ["count"],
                                "xAxisGroup": "none",
                                "xAxisLabel": "",
                                "yAxisLabel": "Alerts",
                                "showXAxisLabel": false,
                                "showYAxisLabel": true,
                                "showLegend": false,
                                "legendPosition": "bottom",
                                "showGrid": true,
                                "horizontalLayout": "vertical",
                                "displayMode": "actual",
                                "showTotals": false,
                                "showValue": false,
                                "grouping": false,
                                "range": { "type": "auto" }
                            }
                        }
                    }
                }
            },
            {
                "i": "9dd38206-119e-42f7-8859-2465170f4c77",
                "x": 0,
                "y": 4,
                "w": 4,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Alert Timeline",
                    "description": "",
                    "activePluginConfigIds": ["{{configId}}"],
                    "variables": ["{{variables.[Host]}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[alerts]}}",
                        "name": "alerts",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "scope": {
                                "variable": "{{variables.[Host]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Hosts]}}"
                            }
                        },
                        "sort": { "by": [["created_timestamp", "desc"]], "top": 20 }
                    },
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": [
                                    "name",
                                    "severity_name",
                                    "status",
                                    "tactic",
                                    "technique",
                                    "filename",
                                    "user_name",
                                    "created_timestamp"
                                ],
                                "hiddenColumns": [
                                    "composite_id",
                                    "device.device_id",
                                    "device.hostname",
                                    "device.platform_name",
                                    "filepath",
                                    "cmdline",
                                    "tags",
                                    "description",
                                    "product",
                                    "type",
                                    "confidence",
                                    "severity",
                                    "updated_timestamp",
                                    "first_behavior",
                                    "last_behavior",
                                    "detectionLatencySeconds",
                                    "responseLatencySeconds"
                                ]
                            }
                        }
                    }
                }
            },
            {
                "i": "98877648-d423-4ad4-8aa7-c7d4ffc28d32",
                "x": 0,
                "y": 8,
                "w": 4,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Vulnerabilities",
                    "description": "Open vulnerabilities for this device",
                    "activePluginConfigIds": ["{{configId}}"],
                    "timeframe": "none",
                    "variables": ["{{variables.[Host]}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[vulnerabilities]}}",
                        "name": "vulnerabilities",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "scope": {
                                "variable": "{{variables.[Host]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Hosts]}}"
                            }
                        },
                        "filter": {
                            "multiOperation": "and",
                            "filters": [{ "column": "status", "operation": "equals", "value": "open" }]
                        },
                        "sort": { "by": [["cve.base_score", "desc"]] }
                    },
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": [
                                    "cve.id",
                                    "cve.severity",
                                    "cve.base_score",
                                    "app.product_name_version",
                                    "cve.exploit_status",
                                    "created_timestamp",
                                    "daysOpen"
                                ],
                                "hiddenColumns": [
                                    "id",
                                    "aid",
                                    "host_info.hostname",
                                    "host_info.platform",
                                    "host_info.local_ip",
                                    "cve.published_date",
                                    "status",
                                    "updated_timestamp",
                                    "closed_timestamp"
                                ]
                            }
                        }
                    }
                }
            }
        ]
    }
}
