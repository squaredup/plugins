{
    "name": "Host",
    "schemaVersion": "1.5",
    "timeframe": "last7days",
    "variables": ["{{variables.[Host]}}"],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "5a326895-b8cd-4f69-9859-58207ff7fe38",
                "x": 0,
                "y": 0,
                "w": 2,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Device Properties",
                    "description": "",
                    "activePluginConfigIds": ["{{configId}}"],
                    "timeframe": "none",
                    "variables": ["{{variables.[Host]}}"],
                    "dataStream": {
                        "id": "datastream-properties",
                        "name": "properties"
                    },
                    "scope": {
                        "scope": "{{scopes.[Hosts]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Host]}}"
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {},
                            "style": {
                                "richTableTranspose": true
                            }
                        }
                    }
                }
            },
            {
                "i": "a5ce7ce3-c43c-4713-9b55-468a6abbd363",
                "x": 2,
                "y": 0,
                "w": 2,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Alert Volume Over Time",
                    "description": "",
                    "activePluginConfigIds": ["{{configId}}"],
                    "variables": ["{{variables.[Host]}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[alerts]}}",
                        "name": "alerts",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "scope": {
                                "variable": "{{variables.[Host]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Hosts]}}"
                            }
                        },
                        "group": {
                            "by": [["created_timestamp", "byDay"]],
                            "aggregate": [{ "type": "count" }]
                        },
                        "sort": { "by": [["created_timestamp_byDay", "asc"]] }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "created_timestamp_byDay",
                                    "type": "temporal",
                                    "title": "Created"
                                },
                                "y": {
                                    "field": "count",
                                    "type": "quantitative",
                                    "title": "Count"
                                }
                            },
                            "style": {
                                "legendPosition": "none",
                                "cartesianShowYAxisTitle": true,
                                "cartesianYAxisTitle": "Alerts"
                            }
                        }
                    }
                }
            },
            {
                "i": "9dd38206-119e-42f7-8859-2465170f4c77",
                "x": 0,
                "y": 4,
                "w": 4,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Alert Timeline",
                    "description": "",
                    "activePluginConfigIds": ["{{configId}}"],
                    "variables": ["{{variables.[Host]}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[alerts]}}",
                        "name": "alerts",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "scope": {
                                "variable": "{{variables.[Host]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Hosts]}}"
                            }
                        },
                        "sort": { "by": [["created_timestamp", "desc"]], "top": 20 }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "name",
                                        "title": "Name",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "severity_name",
                                        "title": "Severity",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "status",
                                        "title": "Status",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "tactic",
                                        "title": "Tactic",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "technique",
                                        "title": "Technique",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "filename",
                                        "title": "File Name",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "user_name",
                                        "title": "User",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "created_timestamp",
                                        "title": "Created",
                                        "renderer": {
                                            "type": "date"
                                        }
                                    }
                                ]
                            }
                        }
                    }
                }
            },
            {
                "i": "98877648-d423-4ad4-8aa7-c7d4ffc28d32",
                "x": 0,
                "y": 8,
                "w": 4,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Vulnerabilities",
                    "description": "Open vulnerabilities for this device",
                    "activePluginConfigIds": ["{{configId}}"],
                    "timeframe": "none",
                    "variables": ["{{variables.[Host]}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[vulnerabilities]}}",
                        "name": "vulnerabilities",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "scope": {
                                "variable": "{{variables.[Host]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Hosts]}}"
                            }
                        },
                        "filter": {
                            "multiOperation": "and",
                            "filters": [{ "column": "status", "operation": "equals", "value": "open" }]
                        },
                        "sort": { "by": [["cve.base_score", "desc"]] }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "cve.id",
                                        "title": "CVE",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "cve.severity",
                                        "title": "CVE Severity",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "cve.base_score",
                                        "title": "CVSS Score",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "app.product_name_version",
                                        "title": "Affected Product",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "cve.exploit_status",
                                        "title": "Exploit Status",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "created_timestamp",
                                        "title": "First Found",
                                        "renderer": {
                                            "type": "date"
                                        }
                                    },
                                    {
                                        "field": "daysOpen",
                                        "title": "Days Open",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    }
                                ]
                            }
                        }
                    }
                }
            }
        ]
    }
}
