                        "sort": { "by": [["count", "desc"]] }
                    },
                    "visualisation": {
                        "type": "data-stream-bar-chart",
                        "config": {
                            "data-stream-bar-chart": {
                                "xAxisData": "status_uniqueValues",
                                "yAxisData": ["count"],
                                "xAxisGroup": "none",
                                "xAxisLabel": "",
                                "yAxisLabel": "Alerts",
                                "showXAxisLabel": false,
                                "showYAxisLabel": true,
                                "showLegend": false,
                                "legendPosition": "bottom",
                                "showGrid": true,
                                "horizontalLayout": "vertical",
                                "displayMode": "actual",
                                "showTotals": false,
                                "showValue": true,
                                "grouping": false,
                                "range": { "type": "auto" }
                            }
                        }
                    }
                }
