                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Open Critical/High Vulnerabilities",
                    "description": "Open vulnerabilities with a CVSS base score of 7.0 or above",
                    "activePluginConfigIds": ["{{configId}}"],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[vulnerabilities]}}",
                        "name": "vulnerabilities",
                        "pluginConfigId": "{{configId}}",
                        "filter": {
                            "multiOperation": "and",
                            "filters": [
                                { "column": "status", "operation": "equals", "value": "open" },
                                { "column": "cve.base_score", "operation": "greaterthan", "value": "6.9" }
                            ]
                        },
                        "group": { "by": [], "aggregate": [{ "type": "count" }] }
                    },
                    "visualisation": {
                        "type": "data-stream-scalar",
                        "config": { "data-stream-scalar": { "value": "count", "comparisonColumn": "none" } }
                    }
                }
            },
            {
