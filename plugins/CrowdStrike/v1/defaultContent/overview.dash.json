                    "visualisation": {
                        "type": "data-stream-donut-chart",
                        "config": {
                            "data-stream-donut-chart": {
                                "valueColumn": "count",
                                "labelColumn": "cve.severity_uniqueValues",
                                "showValuesAsPercentage": true,
                                "legendPosition": "auto",
                                "legendMode": "table"
                            }
                        }
                    }
