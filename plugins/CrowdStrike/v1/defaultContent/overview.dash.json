                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Active Alerts",
                    "description": "Alerts not yet closed, created within the dashboard timeframe",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[alerts]}}",
                        "name": "alerts",
                        "pluginConfigId": "{{configId}}",
                        "filter": {
                            "multiOperation": "and",
                            "filters": [{ "column": "status", "operation": "notequals", "value": "closed" }]
                        },
                        "group": { "by": [], "aggregate": [{ "type": "count" }] }
                    },
                    "visualisation": {
                        "type": "data-stream-scalar",
                        "config": { "data-stream-scalar": { "value": "count", "comparisonColumn": "none" } }
                    }
                }
            },
            {
