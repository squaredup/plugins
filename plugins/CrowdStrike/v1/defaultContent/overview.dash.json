                        },
                        "sort": { "by": [["cve.base_score", "desc"]], "top": 10 }
                    },
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": [
                                    "cve.id",
                                    "cve.severity",
                                    "cve.base_score",
                                    "host_info.hostname",
                                    "host_info.platform",
                                    "cve.exploit_status",
                                    "status",
                                    "created_timestamp"
                                ],
                                "hiddenColumns": [
                                    "id",
                                    "aid",
                                    "host_info.local_ip",
                                    "app.product_name_version",
                                    "cve.published_date",
                                    "updated_timestamp",
                                    "closed_timestamp",
                                    "daysOpen"
                                ]
                            }
                        }
                    }
                }
