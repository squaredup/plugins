{
    "name": "crowdstrike",
    "displayName": "CrowdStrike",
    "version": "1.0.0",
    "author": { "name": "@JackTSquppy", "type": "community" },
    "description": "Monitor CrowdStrike Falcon host coverage, detections & incidents, vulnerabilities, and policy compliance in SquaredUp.",
    "category": "Security",
    "type": "hybrid",
    "schemaVersion": "2.1",
    "importNotSupported": false,
    "restrictedToPlatforms": [],
    "keywords": ["crowdstrike", "falcon", "edr", "endpoint", "security", "detections", "vulnerabilities", "host group"],
    "objectTypes": ["CrowdStrike Host Group", "CrowdStrike Host"],
    "links": [
        {
            "category": "documentation",
            "url": "https://github.com/squaredup/plugins/blob/main/plugins/CrowdStrike/v1/docs/README.md",
            "label": "Help adding this plugin"
        }
    ],
    "base": {
        "plugin": "WebAPI",
        "majorVersion": "1",
        "config": {
            "baseUrl": "{{cloudRegion}}",
            "authMode": "oauth2",
            "oauth2GrantType": "clientCredentials",
            "oauth2TokenUrl": "{{cloudRegion}}/oauth2/token",
            "oauth2ClientId": "{{clientId}}",
            "oauth2ClientSecret": "{{clientSecret}}",
            "oauth2ClientSecretLocationDuringAuth": "body"
        }
    }
}
