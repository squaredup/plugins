                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Total Documents",
                    "description": "Documents across all non-system indices",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[indices]}}",
                        "name": "indices",
                        "pluginConfigId": "{{configId}}",
                        "group": {
                            "by": [],
                            "aggregate": [
                                {
                                    "type": "sum",
                                    "names": [
                                        "docs.count"
                                    ]
                                }
                            ]
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    {
                                        "field": "docs.count_sum",
                                        "type": "quantitative",
                                        "title": "Documents (Sum)"
                                    }
                                ]
                            },
                            "style": {
                                "scalarLabelText": "Documents"
                            }
                        }
                    }
                }
            },
            {
                "i": "f19dd426-d657-4665-ac41-3ae1642f01b9",
                "x": 0,
                "y": 4,
                "w": 2,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Index Health",
                    "description": "Health of each non-system index",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[indices]}}",
                        "name": "indices",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [
                                [
                                    "index",
                                    "asc"
                                ]
                            ]
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "statusGrid",
                            "encoding": {
                                "label": {
                                    "field": "index",
                                    "type": "nominal"
                                },
                                "status": {
                                    "field": "health",
                                    "type": "nominal"
                                }
                            },
                            "style": {
                                "statusGridColumnsPerRow": 4,
                                "statusGridSecondaryTemplate": "{{{{raw}}}}{{lookup this \"health[Expanded].rawState\"}}{{{{/raw}}}}"
                            }
                        }
                    }
                }
            },
            {
                "i": "138bd259-81d4-4594-9d86-f088c3148d69",
                "x": 2,
                "y": 4,
                "w": 2,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Largest Indices",
                    "description": "Top 10 indices by total store size",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[indices]}}",
                        "name": "indices",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [
                                [
                                    "store.size",
                                    "desc"
                                ]
                            ],
                            "top": 10
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "index",
                                    "type": "nominal",
                                    "title": "Index"
                                },
                                "y": {
                                    "field": "store.size",
                                    "type": "quantitative",
                                    "title": "Size"
                                }
                            },
                            "style": {
                                "legendPosition": "none",
                                "cartesianHorizontal": true
                            }
                        }
                    }
                }
            },
            {
                "i": "a3734c4c-4580-4902-89d5-504aedb8b5db",
                "x": 0,
