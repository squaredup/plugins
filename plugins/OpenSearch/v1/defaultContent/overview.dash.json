                "config": {
                    "_type": "tile/data-stream",
                    "title": "Cluster Status",
                    "description": "Current cluster health status",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[clusterHealth]}}",
                        "name": "clusterHealth",
                        "pluginConfigId": "{{configId}}"
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "statusGrid",
                            "encoding": {
                                "label": {
                                    "field": "cluster_name",
                                    "type": "nominal"
                                },
                                "status": {
                                    "field": "status",
                                    "type": "nominal"
                                }
                            },
                            "style": {
                                "statusGridColumnsPerRow": 1,
                                "statusGridSecondaryTemplate": "{{{{raw}}}}{{lookup this \"status[Expanded].rawState\"}}{{{{/raw}}}}"
                            }
                        }
                    }
                }
            },
