                "w": 4,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Node Resources",
                    "description": "Heap, memory, CPU, load and disk usage per node",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[nodes]}}",
                        "name": "nodes",
                        "pluginConfigId": "{{configId}}"
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "name",
                                        "title": "Node",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "isClusterManager",
                                        "title": "Cluster Manager",
                                        "renderer": {
                                            "type": "boolean",
                                            "trueLabel": "Yes",
                                            "falseLabel": "No",
                                            "trueColor": "inherit",
                                            "falseColor": "inherit"
                                        }
                                    },
                                    {
                                        "field": "heap.percent",
                                        "title": "Heap Used (%)",
                                        "renderer": {
                                            "type": "bar",
                                            "max": 100
                                        }
                                    },
                                    {
                                        "field": "ram.percent",
                                        "title": "Memory Used (%)",
                                        "renderer": {
                                            "type": "bar",
                                            "max": 100
                                        }
                                    },
                                    {
                                        "field": "cpu",
                                        "title": "CPU (%)",
                                        "renderer": {
                                            "type": "bar",
                                            "max": 100
                                        }
                                    },
                                    {
                                        "field": "disk.used_percent",
                                        "title": "Disk Used (%)",
                                        "renderer": {
                                            "type": "bar",
                                            "max": 100
                                        }
                                    },
                                    {
                                        "field": "load_1m",
                                        "title": "Load (1m)",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "uptime",
                                        "title": "Uptime",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    }
                                ]
                            }
                        }
                    }
                }
            }
        ]
