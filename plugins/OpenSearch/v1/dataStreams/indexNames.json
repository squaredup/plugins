{
    "name": "indexNames",
    "displayName": "Index Names",
    "description": "Open, non-system index names, with wildcard patterns for date-suffixed index families",
    "tags": ["Indices"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "_cat/indices/*,-.*",
        "getArgs": [
            { "key": "format", "value": "json" },
            { "key": "expand_wildcards", "value": "open" },
            { "key": "s", "value": "index" },
            { "key": "h", "value": "index" }
        ],
        "postRequestScript": "indexNames.js"
    },
    "matches": "none",
    "timeframes": false,
    "visibility": { "type": "hidden" },
    "metadata": [
        { "name": "value", "displayName": "Index", "shape": "string", "role": "value", "visible": false },
        { "name": "label", "displayName": "Index", "shape": "string", "role": "label" }
    ]
}
