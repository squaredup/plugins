{
    "name": "clusterHealth",
    "displayName": "Cluster Health",
    "description": "Current cluster status with node and shard counts",
    "tags": ["Cluster", "Health"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "_cluster/health",
        "getArgs": [],
        "headers": []
    },
    "matches": "none",
    "timeframes": false,
    "metadata": [
        { "name": "cluster_name", "displayName": "Cluster", "shape": "string", "role": "label" },
        {
            "name": "status",
            "displayName": "Status",
            "shape": ["state", { "map": { "success": ["green"], "warning": ["yellow"], "error": ["red"] } }],
            "role": "value"
        },
        { "name": "number_of_nodes", "displayName": "Nodes", "shape": "number" },
        { "name": "number_of_data_nodes", "displayName": "Data Nodes", "shape": "number" },
        { "name": "active_primary_shards", "displayName": "Active Primary Shards", "shape": "number" },
        { "name": "active_shards", "displayName": "Active Shards", "shape": "number" },
        { "name": "relocating_shards", "displayName": "Relocating Shards", "shape": "number" },
        { "name": "initializing_shards", "displayName": "Initializing Shards", "shape": "number" },
        { "name": "unassigned_shards", "displayName": "Unassigned Shards", "shape": "number" },
        { "name": "delayed_unassigned_shards", "displayName": "Delayed Unassigned Shards", "shape": "number" },
        { "name": "active_shards_percent_as_number", "displayName": "Active Shards (%)", "shape": ["percent", { "decimalPlaces": 1 }] },
        { "name": "number_of_pending_tasks", "displayName": "Pending Tasks", "shape": "number" },
        { "name": "number_of_in_flight_fetch", "displayName": "In-flight Fetches", "shape": "number" },
        { "name": "task_max_waiting_in_queue_millis", "displayName": "Longest Task Wait", "shape": "milliseconds" },
        { "name": "discovered_cluster_manager", "displayName": "Cluster Manager Discovered", "shape": "boolean" },
        { "name": "timed_out", "displayName": "Timed Out", "shape": "boolean", "visible": false }
    ]
}
