{
    "name": "topics",
    "displayName": "Topics",
    "description": "Subscription topics contacts can opt in to or out of",
    "tags": [
        "Email",
        "Contacts"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "topics",
        "paging": {
            "mode": "token",
            "pageSize": {
                "realm": "queryArg",
                "path": "limit",
                "value": "100"
            },
            "in": {
                "realm": "payload",
                "path": "next_cursor"
            },
            "out": {
                "realm": "queryArg",
                "path": "after"
            }
        },
        "postRequestScript": "list.js"
    },
    "matches": "none",
    "metadata": [
        {
            "name": "id",
            "displayName": "ID",
            "shape": "string",
            "visible": false
        },
        {
            "name": "name",
            "displayName": "Topic",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "description",
            "displayName": "Description",
            "shape": "string"
        },
        {
            "name": "default_subscription",
            "displayName": "Default Subscription",
            "shape": "string"
        },
        {
            "name": "visibility",
            "displayName": "Visibility",
            "shape": "string"
        },
        {
            "name": "created_at",
            "displayName": "Created",
            "shape": "date",
            "role": "timestamp"
        },
        {
            "sourceId": "id",
            "sourceType": "Topic",
            "name": "name"
        },
        {
            "pattern": ".*"
        }
    ],
    "timeframes": false
}
