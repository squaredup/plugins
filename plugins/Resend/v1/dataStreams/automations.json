{
    "name": "automations",
    "displayName": "Automations",
    "description": "Event-triggered email automations on the Resend team, with status",
    "tags": [
        "Email",
        "Automations"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "automations",
        "paging": {
            "mode": "token",
            "pageSize": {
                "realm": "queryArg",
                "path": "limit",
                "value": "100"
            },
            "in": {
                "realm": "payload",
                "path": "next_cursor"
            },
            "out": {
                "realm": "queryArg",
                "path": "after"
            }
        },
        "postRequestScript": "list.js"
    },
    "matches": "none",
    "metadata": [
        {
            "name": "id",
            "displayName": "ID",
            "shape": "string",
            "visible": false
        },
        {
            "name": "name",
            "displayName": "Automation",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "status",
            "displayName": "Status",
            "shape": [
                "state",
                {
                    "map": {
                        "success": [
                            "enabled"
                        ],
                        "warning": [
                            "disabled"
                        ]
                    }
                }
            ]
        },
        {
            "name": "created_at",
            "displayName": "Created",
            "shape": "date"
        },
        {
            "name": "updated_at",
            "displayName": "Updated",
            "shape": "date",
            "role": "timestamp"
        },
        {
            "sourceId": "id",
            "sourceType": "Automation",
            "name": "name"
        },
        {
            "pattern": ".*"
        }
    ],
    "timeframes": false
}
