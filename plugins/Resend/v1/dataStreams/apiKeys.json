{
    "name": "apiKeys",
    "displayName": "API Keys",
    "description": "API keys on the Resend team, with when each was created and last used",
    "tags": [
        "Security"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "api-keys",
        "pathToData": "data"
    },
    "matches": "none",
    "metadata": [
        {
            "name": "id",
            "displayName": "ID",
            "shape": "string",
            "visible": false
        },
        {
            "name": "name",
            "displayName": "Name",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "created_at",
            "displayName": "Created",
            "shape": "date"
        },
        {
            "name": "last_used_at",
            "displayName": "Last Used",
            "shape": "date",
            "role": "timestamp"
        },
        {
            "name": "days_since_used",
            "displayName": "Days Since Used",
            "computed": true,
            "valueExpression": "{{ $['last_used_at'] ? Math.floor((Date.now() - new Date($['last_used_at']).getTime()) / 86400000) : null }}",
            "shape": "number"
        }
    ],
    "timeframes": false
}
