{
    "name": "domainRecords",
    "displayName": "Domain Records",
    "description": "DNS records needed to verify and configure a sending domain, one row per record",
    "tags": [
        "Email",
        "Domains"
    ],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "domains/{{object.rawId}}",
        "pathToData": "records"
    },
    "matches": {
        "sourceType": {
            "type": "oneOf",
            "values": [
                "Domain"
            ]
        }
    },
    "metadata": [
        {
            "name": "record",
            "displayName": "Record",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "name",
            "displayName": "Host",
            "shape": "string"
        },
        {
            "name": "type",
            "displayName": "Type",
            "shape": "string"
        },
        {
            "name": "value",
            "displayName": "Value",
            "shape": "string"
        },
        {
            "name": "ttl",
            "displayName": "TTL",
            "shape": "string"
        },
        {
            "name": "priority",
            "displayName": "Priority",
            "shape": "number"
        },
        {
            "name": "status",
            "displayName": "Status",
            "shape": [
                "state",
                {
                    "map": {
                        "success": [
                            "verified"
                        ],
                        "warning": [
                            "pending",
                            "temporary_failure"
                        ],
                        "error": [
                            "failed"
                        ],
                        "unknown": [
                            "not_started"
                        ]
                    }
                }
            ]
        },
        {
            "pattern": ".*"
        }
    ],
    "timeframes": false
}
