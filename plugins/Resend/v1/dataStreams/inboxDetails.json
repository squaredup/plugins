{
    "name": "inboxDetails",
    "displayName": "Inbox Details",
    "description": "An inbox's unread thread and draft counts, when it last received mail, and where it forwards to",
    "tags": [
        "Email",
        "Inboxes"
    ],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "inboxes/{{object.rawId}}"
    },
    "matches": {
        "sourceType": {
            "type": "oneOf",
            "values": [
                "Inbox"
            ]
        }
    },
    "metadata": [
        {
            "name": "id",
            "displayName": "ID",
            "shape": "string",
            "visible": false
        },
        {
            "name": "email_address",
            "displayName": "Address",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "from_name",
            "displayName": "From Name",
            "shape": "string"
        },
        {
            "name": "domain_id",
            "displayName": "Domain ID",
            "shape": "string",
            "visible": false
        },
        {
            "name": "domain",
            "displayName": "Domain",
            "computed": true,
            "valueExpression": "{{ typeof $['email_address'] === 'string' ? $['email_address'].split('@').pop().toLowerCase() : null }}",
            "shape": "string"
        },
        {
            "name": "unread",
            "displayName": "Unread Threads",
            "shape": "number",
            "role": "value"
        },
        {
            "name": "drafts",
            "displayName": "Drafts",
            "shape": "number"
        },
        {
            "name": "last_received",
            "displayName": "Last Received",
            "shape": "date",
            "role": "timestamp"
        },
        {
            "name": "receiving_address",
            "displayName": "Forwards To",
            "shape": "string"
        },
        {
            "name": "created_at",
            "displayName": "Created",
            "shape": "date"
        },
        {
            "name": "updated_at",
            "displayName": "Updated",
            "shape": "date"
        },
        {
            "sourceId": "domain_id",
            "sourceType": "Domain",
            "name": "domain"
        },
        {
            "name": "object",
            "displayName": "Object",
            "shape": "string",
            "visible": false
        },
        {
            "pattern": ".*"
        }
    ],
    "timeframes": false
}
