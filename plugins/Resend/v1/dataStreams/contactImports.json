{
    "name": "contactImports",
    "displayName": "Contact Imports",
    "description": "Bulk contact import jobs with their status and row counts",
    "tags": [
        "Contacts"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "contacts/imports",
        "getArgs": [
            {
                "key": "status",
                "value": "{{ status || null }}"
            }
        ],
        "paging": {
            "mode": "token",
            "pageSize": {
                "realm": "queryArg",
                "path": "limit",
                "value": "100"
            },
            "in": {
                "realm": "payload",
                "path": "next_cursor"
            },
            "out": {
                "realm": "queryArg",
                "path": "after"
            }
        },
        "postRequestScript": "list.js",
        "expandInnerObjects": true
    },
    "matches": "none",
    "ui": [
        {
            "type": "choiceChips",
            "name": "status",
            "label": "Status",
            "options": [
                {
                    "value": "queued",
                    "label": "Queued"
                },
                {
                    "value": "in_progress",
                    "label": "In progress"
                },
                {
                    "value": "completed",
                    "label": "Completed"
                },
                {
                    "value": "failed",
                    "label": "Failed"
                }
            ]
        }
    ],
    "metadata": [
        {
            "name": "id",
            "displayName": "ID",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "status",
            "displayName": "Status",
            "shape": [
                "state",
                {
                    "map": {
                        "success": [
                            "completed"
                        ],
                        "error": [
                            "failed"
                        ],
                        "unknown": [
                            "queued",
                            "in_progress"
                        ]
                    }
                }
            ]
        },
        {
            "name": "created_at",
            "displayName": "Created",
            "shape": "date",
            "role": "timestamp"
        },
        {
            "name": "completed_at",
            "displayName": "Completed",
            "shape": "date"
        },
        {
            "name": "counts.total",
            "displayName": "Total Rows",
            "shape": "number"
        },
        {
            "name": "counts.created",
            "displayName": "Contacts Created",
            "shape": "number"
        },
        {
            "name": "counts.updated",
            "displayName": "Contacts Updated",
            "shape": "number"
        },
        {
            "name": "counts.skipped",
            "displayName": "Rows Skipped",
            "shape": "number"
        },
        {
            "name": "counts.failed",
            "displayName": "Rows Failed",
            "shape": "number"
        },
        {
            "pattern": ".*"
        }
    ],
    "timeframes": false
}
