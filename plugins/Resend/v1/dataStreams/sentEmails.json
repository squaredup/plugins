{
    "name": "sentEmails",
    "displayName": "Sent Emails",
    "description": "Emails sent from the team, with latest delivery status",
    "tags": [
        "Email",
        "Deliverability"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "emails",
        "paging": {
            "mode": "token",
            "pageSize": {
                "realm": "queryArg",
                "path": "limit",
                "value": "100"
            },
            "in": {
                "realm": "payload",
                "path": "next_cursor"
            },
            "out": {
                "realm": "queryArg",
                "path": "after"
            }
        },
        "postRequestScript": "emails.js"
    },
    "matches": "none",
    "ui": [
        {
            "type": "objects",
            "name": "domain",
            "label": "Domain(s)",
            "matches": {
                "sourceType": {
                    "type": "oneOf",
                    "values": [
                        "Domain"
                    ]
                }
            }
        }
    ],
    "metadata": [
        {
            "name": "id",
            "displayName": "ID",
            "shape": "string",
            "visible": false
        },
        {
            "name": "subject",
            "displayName": "Subject",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "from",
            "displayName": "From",
            "shape": "string"
        },
        {
            "name": "to",
            "displayName": "To",
            "shape": [
                "array",
                {
                    "itemShape": "string"
                }
            ]
        },
        {
            "name": "last_event",
            "displayName": "Status",
            "shape": [
                "state",
                {
                    "map": {
                        "success": [
                            "delivered",
                            "opened",
                            "clicked"
                        ],
                        "warning": [
                            "delivery_delayed",
                            "canceled"
                        ],
                        "error": [
                            "bounced",
                            "complained",
                            "failed",
                            "suppressed"
                        ],
                        "unknown": [
                            "scheduled",
                            "queued",
                            "sent"
                        ]
                    }
                }
            ]
        },
        {
            "name": "created_at",
            "displayName": "Sent",
            "shape": "date",
            "role": "timestamp"
        },
        {
            "name": "scheduled_at",
            "displayName": "Scheduled",
            "shape": "date"
        },
        {
            "pattern": ".*"
        }
    ],
    "timeframes": [
        "last1hour",
        "last12hours",
        "last24hours",
        "last7days"
    ]
}
