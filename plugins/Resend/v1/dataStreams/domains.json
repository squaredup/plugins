{
    "name": "domains",
    "displayName": "Domains",
    "description": "Sending and receiving domains on the Resend team, with verification status and tracking settings",
    "tags": [
        "Email",
        "Domains"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "domains",
        "pathToData": "data",
        "expandInnerObjects": true
    },
    "matches": "none",
    "metadata": [
        {
            "name": "id",
            "displayName": "ID",
            "shape": "string",
            "visible": false
        },
        {
            "name": "name",
            "displayName": "Domain",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "status",
            "displayName": "Status",
            "shape": [
                "state",
                {
                    "map": {
                        "success": [
                            "verified"
                        ],
                        "warning": [
                            "pending",
                            "partially_verified",
                            "temporary_failure"
                        ],
                        "error": [
                            "failed",
                            "partially_failed"
                        ],
                        "unknown": [
                            "not_started"
                        ]
                    }
                }
            ]
        },
        {
            "name": "region",
            "displayName": "Region",
            "shape": "string"
        },
        {
            "name": "capabilities.sending",
            "displayName": "Sending",
            "shape": "string"
        },
        {
            "name": "capabilities.receiving",
            "displayName": "Receiving",
            "shape": "string"
        },
        {
            "name": "open_tracking",
            "displayName": "Open Tracking",
            "shape": "boolean"
        },
        {
            "name": "click_tracking",
            "displayName": "Click Tracking",
            "shape": "boolean"
        },
        {
            "name": "created_at",
            "displayName": "Created",
            "shape": "date",
            "role": "timestamp"
        },
        {
            "sourceId": "id",
            "sourceType": "Domain",
            "name": "name"
        },
        {
            "pattern": ".*"
        }
    ],
    "timeframes": false
}
