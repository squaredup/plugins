{
    "name": "broadcasts",
    "displayName": "Broadcasts",
    "description": "Broadcasts (marketing campaigns) on the Resend team, with status and send times, optionally limited to segments",
    "tags": [
        "Email",
        "Broadcasts"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "broadcasts",
        "postRequestScript": "broadcasts.js"
    },
    "matches": "none",
    "ui": [
        {
            "type": "objects",
            "name": "segment",
            "label": "Segment(s)",
            "matches": {
                "sourceType": {
                    "type": "oneOf",
                    "values": [
                        "Segment"
                    ]
                }
            }
        }
    ],
    "metadata": [
        {
            "name": "id",
            "displayName": "ID",
            "shape": "string",
            "visible": false
        },
        {
            "name": "name",
            "displayName": "Broadcast",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "status",
            "displayName": "Status",
            "shape": [
                "state",
                {
                    "map": {
                        "success": [
                            "sent"
                        ],
                        "warning": [
                            "canceled",
                            "cancelled"
                        ],
                        "error": [
                            "failed"
                        ],
                        "unknown": [
                            "draft",
                            "scheduled",
                            "queued",
                            "sending"
                        ]
                    }
                }
            ]
        },
        {
            "name": "segment_id",
            "displayName": "Segment ID",
            "shape": "string",
            "visible": false,
            "sourceType": "Segment"
        },
        {
            "name": "segment",
            "displayName": "Segment",
            "sourceId": "segment_id",
            "objectPropertyPath": "name"
        },
        {
            "name": "created_at",
            "displayName": "Created",
            "shape": "date"
        },
        {
            "name": "scheduled_at",
            "displayName": "Scheduled",
            "shape": "date"
        },
        {
            "name": "sent_at",
            "displayName": "Sent",
            "shape": "date",
            "role": "timestamp"
        },
        {
            "sourceId": "id",
            "sourceType": "Broadcast",
            "name": "name"
        },
        {
            "pattern": ".*"
        }
    ],
    "timeframes": false
}
