{
    "name": "webhooks",
    "displayName": "Webhooks",
    "description": "Webhook endpoints on the Resend team, with status and subscribed event types",
    "tags": [
        "Email",
        "Webhooks"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "webhooks",
        "pathToData": "data"
    },
    "matches": "none",
    "metadata": [
        {
            "name": "id",
            "displayName": "ID",
            "shape": "string",
            "visible": false
        },
        {
            "name": "endpoint",
            "displayName": "Endpoint",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "status",
            "displayName": "Status",
            "shape": [
                "state",
                {
                    "map": {
                        "success": [
                            "enabled"
                        ],
                        "warning": [
                            "disabled"
                        ]
                    }
                }
            ]
        },
        {
            "name": "events",
            "displayName": "Events",
            "shape": [
                "array",
                {
                    "itemShape": "string"
                }
            ]
        },
        {
            "name": "created_at",
            "displayName": "Created",
            "shape": "date",
            "role": "timestamp"
        },
        {
            "sourceId": "id",
            "sourceType": "Webhook",
            "name": "endpoint"
        },
        {
            "pattern": ".*"
        }
    ],
    "timeframes": false
}
