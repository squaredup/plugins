{
    "name": "webhookEvents",
    "displayName": "Webhook Events",
    "description": "Events delivered to a webhook, with delivery status",
    "tags": [
        "Email",
        "Webhooks"
    ],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "webhooks/{{object.rawId}}/events",
        "paging": {
            "mode": "token",
            "pageSize": {
                "realm": "queryArg",
                "path": "limit",
                "value": "100"
            },
            "in": {
                "realm": "payload",
                "path": "next_cursor"
            },
            "out": {
                "realm": "queryArg",
                "path": "after"
            }
        },
        "postRequestScript": "listInTimeframe.js"
    },
    "matches": {
        "sourceType": {
            "type": "oneOf",
            "values": [
                "Webhook"
            ]
        }
    },
    "metadata": [
        {
            "name": "id",
            "displayName": "ID",
            "shape": "string",
            "visible": false
        },
        {
            "name": "type",
            "displayName": "Event",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "status",
            "displayName": "Delivery",
            "shape": [
                "state",
                {
                    "map": {
                        "success": [
                            "success"
                        ],
                        "error": [
                            "failed"
                        ],
                        "warning": [
                            "attempting"
                        ],
                        "unknown": [
                            "pending"
                        ]
                    }
                }
            ]
        },
        {
            "name": "created_at",
            "displayName": "Created",
            "shape": "date",
            "role": "timestamp"
        },
        {
            "pattern": ".*"
        }
    ],
    "timeframes": [
        "last1hour",
        "last12hours",
        "last24hours",
        "last7days"
    ]
}
