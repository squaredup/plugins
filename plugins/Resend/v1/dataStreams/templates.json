{
    "name": "templates",
    "displayName": "Templates",
    "description": "Email templates on the Resend team, with publish status",
    "tags": [
        "Email",
        "Templates"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "templates",
        "paging": {
            "mode": "token",
            "pageSize": {
                "realm": "queryArg",
                "path": "limit",
                "value": "100"
            },
            "in": {
                "realm": "payload",
                "path": "next_cursor"
            },
            "out": {
                "realm": "queryArg",
                "path": "after"
            }
        },
        "postRequestScript": "list.js"
    },
    "matches": "none",
    "metadata": [
        {
            "name": "id",
            "displayName": "ID",
            "shape": "string",
            "visible": false
        },
        {
            "name": "name",
            "displayName": "Template",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "alias",
            "displayName": "Alias",
            "shape": "string"
        },
        {
            "name": "status",
            "displayName": "Status",
            "shape": [
                "state",
                {
                    "map": {
                        "success": [
                            "published"
                        ],
                        "unknown": [
                            "draft"
                        ]
                    }
                }
            ]
        },
        {
            "name": "published_at",
            "displayName": "Published",
            "shape": "date"
        },
        {
            "name": "created_at",
            "displayName": "Created",
            "shape": "date"
        },
        {
            "name": "updated_at",
            "displayName": "Updated",
            "shape": "date",
            "role": "timestamp"
        },
        {
            "sourceId": "id",
            "sourceType": "Template",
            "name": "name"
        },
        {
            "pattern": ".*"
        }
    ],
    "timeframes": false
}
