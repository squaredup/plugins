{
    "name": "receivedEmails",
    "displayName": "Received Emails",
    "description": "Inbound emails received on receiving-enabled domains",
    "tags": [
        "Email"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "emails/receiving",
        "paging": {
            "mode": "token",
            "pageSize": {
                "realm": "queryArg",
                "path": "limit",
                "value": "100"
            },
            "in": {
                "realm": "payload",
                "path": "next_cursor"
            },
            "out": {
                "realm": "queryArg",
                "path": "after"
            }
        },
        "postRequestScript": "emails.js"
    },
    "matches": "none",
    "ui": [
        {
            "type": "objects",
            "name": "domain",
            "label": "Domain(s)",
            "matches": {
                "sourceType": {
                    "type": "oneOf",
                    "values": [
                        "Domain"
                    ]
                }
            }
        }
    ],
    "metadata": [
        {
            "name": "id",
            "displayName": "ID",
            "shape": "string",
            "visible": false
        },
        {
            "name": "subject",
            "displayName": "Subject",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "from",
            "displayName": "From",
            "shape": "string"
        },
        {
            "name": "to",
            "displayName": "To",
            "shape": [
                "array",
                {
                    "itemShape": "string"
                }
            ]
        },
        {
            "name": "attachment_count",
            "displayName": "Attachments",
            "shape": "number"
        },
        {
            "name": "created_at",
            "displayName": "Received",
            "shape": "date",
            "role": "timestamp"
        },
        {
            "pattern": ".*"
        }
    ],
    "timeframes": [
        "last1hour",
        "last12hours",
        "last24hours",
        "last7days"
    ]
}
