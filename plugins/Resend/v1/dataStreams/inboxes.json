{
    "name": "inboxes",
    "displayName": "Inboxes",
    "description": "Resend inboxes, with unread thread count and when mail was last received",
    "tags": [
        "Email",
        "Inboxes"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "inboxes",
        "paging": {
            "mode": "token",
            "pageSize": {
                "realm": "queryArg",
                "path": "limit",
                "value": "100"
            },
            "in": {
                "realm": "payload",
                "path": "next_cursor"
            },
            "out": {
                "realm": "queryArg",
                "path": "after"
            }
        },
        "postRequestScript": "list.js"
    },
    "matches": "none",
    "metadata": [
        {
            "name": "id",
            "displayName": "ID",
            "shape": "string",
            "visible": false
        },
        {
            "name": "name",
            "displayName": "Name",
            "shape": "string",
            "visible": false
        },
        {
            "name": "email_address",
            "displayName": "Address",
            "shape": "string"
        },
        {
            "name": "inbox_name",
            "displayName": "Inbox",
            "computed": true,
            "valueExpression": "{{ typeof $['name'] === 'string' && $['name'].trim() ? $['name'] : $['email_address'] }}",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "from_name",
            "displayName": "From Name",
            "shape": "string"
        },
        {
            "name": "unread",
            "displayName": "Unread Threads",
            "shape": "number",
            "role": "value"
        },
        {
            "name": "last_received",
            "displayName": "Last Received",
            "shape": "date",
            "role": "timestamp"
        },
        {
            "name": "created_at",
            "displayName": "Created",
            "shape": "date"
        },
        {
            "sourceId": "id",
            "sourceType": "Inbox",
            "name": "inbox_name",
            "valueExpression": "{{ typeof $['name'] === 'string' && $['name'].trim() ? $['name'] : $['email_address'] }}"
        },
        {
            "pattern": ".*"
        }
    ],
    "timeframes": false
}
