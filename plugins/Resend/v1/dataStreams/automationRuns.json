{
    "name": "automationRuns",
    "displayName": "Automation Runs",
    "description": "Runs of an automation, with status and duration",
    "tags": [
        "Email",
        "Automations"
    ],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "automations/{{object.rawId}}/runs",
        "getArgs": [
            {
                "key": "status",
                "value": "{{ status && status.length ? [].concat(status).join(',') : null }}"
            }
        ],
        "paging": {
            "mode": "token",
            "pageSize": {
                "realm": "queryArg",
                "path": "limit",
                "value": "100"
            },
            "in": {
                "realm": "payload",
                "path": "next_cursor"
            },
            "out": {
                "realm": "queryArg",
                "path": "after"
            }
        },
        "postRequestScript": "list.js"
    },
    "matches": {
        "sourceType": {
            "type": "oneOf",
            "values": [
                "Automation"
            ]
        }
    },
    "ui": [
        {
            "type": "choiceChips",
            "name": "status",
            "label": "Status",
            "isMulti": true,
            "options": [
                {
                    "value": "running",
                    "label": "Running"
                },
                {
                    "value": "completed",
                    "label": "Completed"
                },
                {
                    "value": "failed",
                    "label": "Failed"
                },
                {
                    "value": "cancelled",
                    "label": "Cancelled"
                }
            ]
        }
    ],
    "defaultShaping": {
        "sort": {
            "by": [
                [
                    "created_at",
                    "desc"
                ]
            ]
        }
    },
    "metadata": [
        {
            "name": "id",
            "displayName": "ID",
            "shape": "string",
            "visible": false
        },
        {
            "name": "status",
            "displayName": "Status",
            "shape": [
                "state",
                {
                    "map": {
                        "success": [
                            "completed"
                        ],
                        "error": [
                            "failed"
                        ],
                        "warning": [
                            "cancelled"
                        ],
                        "unknown": [
                            "running"
                        ]
                    }
                }
            ],
            "role": "label"
        },
        {
            "name": "started_at",
            "displayName": "Started",
            "shape": "date"
        },
        {
            "name": "completed_at",
            "displayName": "Completed",
            "shape": "date"
        },
        {
            "name": "created_at",
            "displayName": "Created",
            "shape": "date",
            "role": "timestamp"
        },
        {
            "name": "duration",
            "displayName": "Duration",
            "computed": true,
            "valueExpression": "{{ $['completed_at'] && $['started_at'] ? Math.round((new Date($['completed_at']) - new Date($['started_at'])) / 1000) : null }}",
            "shape": "seconds"
        },
        {
            "pattern": ".*"
        }
    ],
    "timeframes": false
}
