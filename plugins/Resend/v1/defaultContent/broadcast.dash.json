{
    "name": "Broadcast",
    "schemaVersion": "1.5",
    "timeframe": "last30days",
    "variables": [
        "{{variables.[Resend Broadcast]}}"
    ],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "5fb0e68c-1877-4d45-99b5-aa3ade34106b",
                "x": 0,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Status",
                    "description": "Whether this broadcast has been sent",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "datastream-properties",
                        "name": "properties",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Resend Broadcasts]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Resend Broadcast]}}"
                    },
                    "variables": [
                        "{{variables.[Resend Broadcast]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "statusGrid",
                            "encoding": {
                                "label": {
                                    "field": "name",
                                    "type": "nominal"
                                },
                                "status": {
                                    "field": "status",
                                    "type": "nominal"
                                }
                            },
                            "style": {
                                "labelFontSize": 16,
                                "secondaryFontSize": 12,
                                "statusGridColumnsPerRow": 1,
                                "statusGridLabelWrap": true
                            }
                        }
                    }
                }
            },
            {
                "i": "1bad4c53-18d5-4bb1-bbf5-63c2ed193f91",
                "x": 1,
                "y": 0,
                "w": 3,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Performance",
                    "description": "Delivery and engagement for this broadcast",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[emailMetrics]}}",
                        "name": "emailMetrics",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "broadcast": {
                                "scope": "{{scopes.[Resend Broadcasts]}}",
                                "workspace": "{{workspaceId}}",
                                "variable": "{{variables.[Resend Broadcast]}}"
                            },
                            "granularity": "total"
                        }
                    },
                    "variables": [
                        "{{variables.[Resend Broadcast]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    {
                                        "field": "delivered",
                                        "type": "quantitative",
                                        "aggregate": "sum",
                                        "title": "Delivered"
                                    },
                                    {
                                        "field": "open_rate",
                                        "type": "quantitative",
                                        "aggregate": "avg",
                                        "title": "Open rate"
                                    },
                                    {
                                        "field": "click_rate",
                                        "type": "quantitative",
                                        "aggregate": "avg",
                                        "title": "Click rate"
                                    },
                                    {
                                        "field": "bounce_rate",
                                        "type": "quantitative",
                                        "aggregate": "avg",
                                        "title": "Bounce rate"
                                    },
                                    {
                                        "field": "unsubscribe_rate",
                                        "type": "quantitative",
                                        "aggregate": "avg",
                                        "title": "Unsubscribe rate"
                                    }
                                ]
                            },
                            "style": {
                                "scalarColumns": 5
                            }
                        }
                    }
                }
            },
            {
                "i": "39164362-a408-4d36-8808-cc39095a557d",
                "x": 0,
                "y": 2,
                "w": 1,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Broadcast Details",
                    "description": "When this broadcast was created, scheduled and sent",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "datastream-properties",
                        "name": "properties",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Resend Broadcasts]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Resend Broadcast]}}"
                    },
                    "variables": [
                        "{{variables.[Resend Broadcast]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "sent_at",
                                        "title": "Sent",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    },
                                    {
                                        "field": "scheduled_at",
                                        "title": "Scheduled",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    },
                                    {
                                        "field": "created_at",
                                        "title": "Created",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableCellPadding": 6,
                                "richTableTranspose": true
                            }
                        }
                    }
                }
            },
            {
                "i": "6546b96c-dbf4-4705-9ef9-211e2ca0f72e",
                "x": 1,
                "y": 2,
                "w": 1,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Engagement Funnel",
                    "description": "How many emails from this broadcast were delivered, opened and clicked",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[emailMetrics]}}",
                        "name": "emailMetrics",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "broadcast": {
                                "scope": "{{scopes.[Resend Broadcasts]}}",
                                "workspace": "{{workspaceId}}",
                                "variable": "{{variables.[Resend Broadcast]}}"
                            },
                            "granularity": "total"
                        },
                        "sql": "SELECT \"stage\", \"emails\" FROM (SELECT 1 AS \"ord\", 'Sent' AS \"stage\", CAST(COALESCE(\"sent\", 0) AS DOUBLE) AS \"emails\" FROM \"dataset\" UNION ALL SELECT 2, 'Delivered', CAST(COALESCE(\"delivered\", 0) AS DOUBLE) FROM \"dataset\" UNION ALL SELECT 3, 'Opened', CAST(COALESCE(\"unique_opened\", 0) AS DOUBLE) FROM \"dataset\" UNION ALL SELECT 4, 'Clicked', CAST(COALESCE(\"unique_clicked\", 0) AS DOUBLE) FROM \"dataset\") ORDER BY \"ord\""
                    },
                    "variables": [
                        "{{variables.[Resend Broadcast]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "funnel",
                            "encoding": {
                                "label": {
                                    "field": "stage",
                                    "type": "nominal"
                                },
                                "value": {
                                    "field": "emails",
                                    "type": "quantitative",
                                    "aggregate": "sum"
                                }
                            },
                            "style": {
                                "funnelSort": "none",
                                "colors": [
                                    "#6366f1",
                                    "#8b5cf6",
                                    "#14b8a6",
                                    "#22c55e"
                                ],
                                "labelFormat": "{{{{raw}}}}{{name}} · {{value}}{{{{/raw}}}}",
                                "funnelLabelPosition": "inside",
                                "labelColor": "#ffffff"
                            }
                        }
                    }
                }
            },
            {
                "i": "2566c64c-5041-4003-a279-a63555682bf6",
                "x": 2,
                "y": 2,
                "w": 2,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Top Clicked Links",
                    "description": "Links in this broadcast with the most clicks",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[broadcastClickedLinks]}}",
                        "name": "broadcastClickedLinks",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [
                                [
                                    "clicks",
                                    "desc"
                                ]
                            ],
                            "top": 10
                        }
                    },
                    "scope": {
                        "scope": "{{scopes.[Resend Broadcasts]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Resend Broadcast]}}"
                    },
                    "variables": [
                        "{{variables.[Resend Broadcast]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "url",
                                    "type": "nominal",
                                    "title": "Link"
                                },
                                "y": {
                                    "field": "clicks",
                                    "type": "quantitative",
                                    "aggregate": "sum",
                                    "title": "Clicks"
                                }
                            },
                            "style": {
                                "cartesianHorizontal": true,
                                "cartesianBarBorderRadius": 4,
                                "showLabels": true,
                                "colors": [
                                    "#6366f1"
                                ],
                                "cartesianShowHorizontalGridLines": false
                            }
                        }
                    }
                }
            },
            {
                "i": "2be9a06a-a7fd-4868-ba96-3ea63fbdd17c",
                "x": 0,
                "y": 5,
                "w": 2,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Clicked",
                    "description": "Recipients who clicked a link, and the links they clicked",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[broadcastRecipients]}}",
                        "name": "broadcastRecipients",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "event": "clicked"
                        },
                        "sort": {
                            "by": [
                                [
                                    "count",
                                    "desc"
                                ]
                            ]
                        }
                    },
                    "scope": {
                        "scope": "{{scopes.[Resend Broadcasts]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Resend Broadcast]}}"
                    },
                    "variables": [
                        "{{variables.[Resend Broadcast]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "email",
                                        "title": "Recipient",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "count",
                                        "title": "Clicks",
                                        "renderer": {
                                            "type": "bar",
                                            "color": "#6366f1"
                                        }
                                    },
                                    {
                                        "field": "clicked_links",
                                        "title": "Links",
                                        "renderer": {
                                            "type": "tag-list"
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableCellPadding": 6
                            }
                        }
                    }
                }
            },
            {
                "i": "f8faec25-40d3-4e3e-938a-28991a696695",
