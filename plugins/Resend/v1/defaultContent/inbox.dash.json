{
    "name": "Inbox",
    "schemaVersion": "1.5",
    "timeframe": "none",
    "variables": [
        "{{variables.[Resend Inbox]}}"
    ],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "57239d4c-c51d-479d-80b9-1eb3fbe45481",
                "x": 0,
                "y": 0,
                "w": 1,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Unread Threads",
                    "description": "Threads in this inbox with unread email",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[inboxDetails]}}",
                        "name": "inboxDetails",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Resend Inboxes]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Resend Inbox]}}"
                    },
                    "variables": [
                        "{{variables.[Resend Inbox]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    {
                                        "field": "unread",
                                        "type": "quantitative",
                                        "aggregate": "sum",
                                        "title": "Unread threads"
                                    }
                                ]
                            }
                        }
                    }
                }
            },
            {
                "i": "4d8eec31-7ace-4496-a2eb-1f5ffc45a296",
                "x": 1,
                "y": 0,
                "w": 1,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Drafts",
                    "description": "Unsent drafts in this inbox",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[inboxDetails]}}",
                        "name": "inboxDetails",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Resend Inboxes]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Resend Inbox]}}"
                    },
                    "variables": [
                        "{{variables.[Resend Inbox]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    {
                                        "field": "drafts",
                                        "type": "quantitative",
                                        "aggregate": "sum",
                                        "title": "Drafts"
                                    }
                                ]
                            }
                        }
                    }
                }
            },
            {
                "i": "01a37cb5-f9f7-4253-b1a6-97a3c14431f9",
                "x": 2,
                "y": 0,
                "w": 2,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Inbox Details",
                    "description": "Address, sender name and domain of this inbox. Click to open the domain",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[inboxDetails]}}",
                        "name": "inboxDetails",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Resend Inboxes]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Resend Inbox]}}"
                    },
                    "variables": [
                        "{{variables.[Resend Inbox]}}"
                    ],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "email_address",
                                        "title": "Address",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "from_name",
                                        "title": "From name",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "domain",
                                        "title": "Domain",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "receiving_address",
                                        "title": "Forwards to",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "last_received",
                                        "title": "Last received",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    },
                                    {
                                        "field": "created_at",
                                        "title": "Created",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableTranspose": true,
                                "richTableCellPadding": 6
                            }
                        }
                    }
                }
            }
        ]
    }
}
