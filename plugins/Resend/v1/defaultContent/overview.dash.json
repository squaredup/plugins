                "w": 1,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Suppressions by Origin",
                    "description": "Addresses Resend will not send to, by what caused the suppression",
                    "timeframe": "none",
                    "dataStream": {
                        "id": "datastream-sql",
                        "dataSourceConfig": {
                            "version": "2.0",
                            "sql": "SELECT CASE \"origin[Expanded].rawState\" WHEN 'bounce' THEN 'Bounce' WHEN 'complaint' THEN 'Complaint' ELSE 'Manual' END AS \"origin\", CAST(COUNT(*) AS DOUBLE) AS \"addresses\" FROM \"suppressions\" GROUP BY ALL",
                            "tables": [
                                {
                                    "tableName": "suppressions",
                                    "config": {
                                        "dataStream": {
                                            "id": "{{dataStreams.[suppressions]}}",
                                            "name": "suppressions"
                                        },
                                        "activePluginConfigIds": [
                                            "{{configId}}"
                                        ],
                                        "timeframe": "none"
                                    }
                                }
                            ]
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "pie",
                            "encoding": {
                                "label": {
                                    "field": "origin",
                                    "type": "nominal"
                                },
                                "value": {
                                    "field": "addresses",
                                    "type": "quantitative",
                                    "aggregate": "sum"
                                }
                            },
                            "style": {
                                "pieInnerRadius": 60,
                                "pieDonutCenterValue": "total",
                                "labelFontSize": 16,
                                "mappedColors": {
                                    "Bounce": "#f59e0b",
                                    "Complaint": "#ef4444",
                                    "Manual": "#64748b"
                                }
                            }
                        }
                    }
                }
            },
