                "x": 0,
                "y": 11,
                "w": 2,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Recent API Errors",
                    "description": "API requests that did not succeed, newest first",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[apiLogs]}}",
                        "name": "apiLogs",
                        "pluginConfigId": "{{configId}}",
                        "filter": {
                            "multiOperation": "and",
                            "filters": [
                                {
                                    "column": "outcome",
                                    "operation": "notequals",
                                    "value": "success"
                                }
                            ]
                        },
                        "sort": {
                            "by": [
                                [
                                    "created_at",
                                    "desc"
                                ]
                            ]
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "response_status",
                                        "title": "Status",
                                        "renderer": {
                                            "type": "number",
                                            "decimals": 0,
                                            "thresholds": [
                                                {
                                                    "to": 428,
                                                    "color": "#f59e0b"
                                                },
                                                {
                                                    "to": 429,
                                                    "color": "#ef4444"
                                                },
                                                {
                                                    "to": 499,
                                                    "color": "#f59e0b"
                                                },
                                                {
                                                    "to": 1000,
                                                    "color": "#ef4444"
                                                }
                                            ]
                                        }
                                    },
                                    {
                                        "field": "created_at",
                                        "title": "When",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    },
                                    {
                                        "field": "method",
                                        "title": "Method",
                                        "renderer": {
                                            "type": "badge",
                                            "defaultColor": "#64748b"
                                        },
                                        "width": 90
                                    },
                                    {
                                        "field": "endpoint",
                                        "title": "Endpoint",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableCellPadding": 6
                            }
                        }
                    }
                }
            },
            {
                "i": "c41ed89e-f123-47ec-b078-e7d70f1fdc5d",
                "x": 2,
