            {
                "i": "7f35a943-2bf7-4e31-968f-dfb14127064a",
                "x": 2,
                "y": 0,
                "w": 2,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Engagement",
                    "description": "Delivery, open and click rates across all domains",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[emailMetrics]}}",
                        "name": "emailMetrics",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "granularity": "total"
                        },
                        "sql": "SELECT \"metric\", \"rate\" FROM (SELECT 1 AS \"ord\", 'Delivered' AS \"metric\", CAST(COALESCE(\"delivery_rate\", 0) AS DOUBLE) AS \"rate\" FROM \"dataset\" UNION ALL SELECT 2, 'Opened', CAST(COALESCE(\"open_rate\", 0) AS DOUBLE) FROM \"dataset\" UNION ALL SELECT 3, 'Clicked', CAST(COALESCE(\"click_rate\", 0) AS DOUBLE) FROM \"dataset\") ORDER BY \"ord\""
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "ringGrid",
                            "encoding": {
                                "value": {
                                    "field": "rate",
                                    "type": "quantitative"
                                },
                                "label": {
                                    "field": "metric",
                                    "type": "nominal"
                                }
                            },
                            "style": {
                                "ringGridTrackWidth": 10,
                                "ringGridThresholds": [
                                    {
                                        "to": 1,
                                        "color": "#6366f1"
                                    }
                                ]
                            }
                        }
                    }
                }
            },
            {
                "i": "ce90174d-7b54-47ab-8313-429f54056429",
                "x": 0,
                "y": 2,
                "w": 3,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Email Volume",
                    "description": "Emails sent, delivered and bounced per day",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[emailMetrics]}}",
                        "name": "emailMetrics",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "granularity": "daily"
                        },
                        "sql": "SELECT \"period\", \"metric\", \"emails\" FROM (SELECT \"period\", 1 AS \"ord\", 'Sent' AS \"metric\", CAST(COALESCE(\"sent\", 0) AS DOUBLE) AS \"emails\" FROM \"dataset\" UNION ALL SELECT \"period\", 2, 'Delivered', CAST(COALESCE(\"delivered\", 0) AS DOUBLE) FROM \"dataset\" UNION ALL SELECT \"period\", 3, 'Bounced', CAST(COALESCE(\"bounced\", 0) AS DOUBLE) FROM \"dataset\") ORDER BY \"period\", \"ord\""
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "line",
                            "encoding": {
                                "x": {
                                    "field": "period",
                                    "type": "temporal",
                                    "title": "Day"
                                },
                                "y": {
                                    "field": "emails",
                                    "type": "quantitative",
                                    "aggregate": "sum",
                                    "title": "Emails"
                                },
                                "series": {
                                    "field": "metric",
                                    "type": "nominal"
                                }
                            },
                            "style": {
                                "cartesianAreaGradient": true,
                                "cartesianSymbol": "none",
                                "cartesianLineWidth": 2,
                                "cartesianShowVerticalGridLines": false,
                                "legendPosition": "bottom",
                                "mappedColors": {
                                    "Sent": "#6366f1",
                                    "Delivered": "#22c55e",
                                    "Bounced": "#ef4444"
                                }
                            }
                        }
                    }
                }
            },
            {
                "i": "063cdb95-1ef0-4db6-9755-d23e0ea23389",
                "x": 3,
                "y": 2,
                "w": 1,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Engagement Funnel",
                    "description": "How many sent emails were delivered, opened and clicked",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[emailMetrics]}}",
                        "name": "emailMetrics",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "granularity": "total"
                        },
                        "sql": "SELECT \"stage\", \"emails\" FROM (SELECT 1 AS \"ord\", 'Sent' AS \"stage\", CAST(COALESCE(\"sent\", 0) AS DOUBLE) AS \"emails\" FROM \"dataset\" UNION ALL SELECT 2, 'Delivered', CAST(COALESCE(\"delivered\", 0) AS DOUBLE) FROM \"dataset\" UNION ALL SELECT 3, 'Opened', CAST(COALESCE(\"unique_opened\", 0) AS DOUBLE) FROM \"dataset\" UNION ALL SELECT 4, 'Clicked', CAST(COALESCE(\"unique_clicked\", 0) AS DOUBLE) FROM \"dataset\") ORDER BY \"ord\""
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "funnel",
                            "encoding": {
                                "label": {
                                    "field": "stage",
                                    "type": "nominal"
                                },
                                "value": {
                                    "field": "emails",
                                    "type": "quantitative",
                                    "aggregate": "sum"
                                }
                            },
                            "style": {
                                "funnelSort": "none",
                                "colors": [
                                    "#6366f1",
                                    "#8b5cf6",
                                    "#14b8a6",
                                    "#22c55e"
                                ],
                                "labelFormat": "{{{{raw}}}}{{name}} · {{value}}{{{{/raw}}}}",
                                "funnelLabelPosition": "inside",
                                "labelColor": "#ffffff"
                            }
                        }
                    }
                }
            },
