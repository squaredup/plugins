            {
                "i": "b63c42c6-3a16-4d8d-9399-7b62629314ce",
                "x": 2,
                "y": 8,
                "w": 2,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "API Traffic",
                    "description": "API requests per day by outcome",
                    "timeframe": "last7days",
                    "dataStream": {
                        "id": "datastream-sql",
                        "dataSourceConfig": {
                            "version": "2.0",
                            "sql": "SELECT STRFTIME(DATE_TRUNC('day', \"created_at\"), '%Y-%m-%dT%H:%M:%SZ') AS \"day\", CASE \"outcome\" WHEN 'success' THEN 'Success' WHEN 'warning' THEN 'Client error' ELSE 'Rate limited or server error' END AS \"outcome\", CAST(COUNT(*) AS DOUBLE) AS \"requests\" FROM \"logs\" GROUP BY ALL ORDER BY \"day\"",
                            "tables": [
                                {
                                    "tableName": "logs",
                                    "config": {
                                        "dataStream": {
                                            "id": "{{dataStreams.[apiLogs]}}",
                                            "name": "apiLogs"
                                        },
                                        "activePluginConfigIds": [
                                            "{{configId}}"
                                        ],
                                        "timeframe": "last7days"
                                    }
                                }
                            ]
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "day",
                                    "type": "temporal",
                                    "title": "Day"
                                },
                                "y": {
                                    "field": "requests",
                                    "type": "quantitative",
                                    "aggregate": "sum",
                                    "title": "Requests"
                                },
                                "series": {
                                    "field": "outcome",
                                    "type": "nominal"
                                }
                            },
                            "style": {
                                "cartesianStack": "on",
                                "cartesianBarBorderRadius": 3,
                                "legendPosition": "bottom",
                                "mappedColors": {
                                    "Success": "#22c55e",
                                    "Client error": "#f59e0b",
                                    "Rate limited or server error": "#ef4444"
                                }
                            }
                        }
                    }
                }
            },
            {
