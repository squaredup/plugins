{
    "name": "resend",
    "displayName": "Resend",
    "version": "1.0.0",
    "author": {
        "name": "@adamkinniburgh",
        "type": "community"
    },
    "description": "Monitor Resend email delivery, sending domains, broadcasts, automations and webhooks.",
    "category": "Utility",
    "type": "hybrid",
    "schemaVersion": "2.1",
    "importNotSupported": false,
    "restrictedToPlatforms": [],
    "keywords": [
        "email",
        "resend",
        "transactional email",
        "deliverability",
        "domains",
        "broadcasts",
        "webhooks",
        "automations"
    ],
    "objectTypes": [
        "Domain",
        "Segment",
        "Broadcast",
        "Webhook",
        "Automation",
        "Template",
        "Topic",
        "Inbox"
    ],
    "links": [
        {
            "category": "documentation",
            "url": "https://github.com/squaredup/plugins/blob/main/plugins/Resend/v1/docs/README.md",
            "label": "Help adding this plugin"
        },
        {
            "category": "source",
            "url": "https://github.com/squaredup/plugins/tree/main/plugins/Resend/v1",
            "label": "Repository"
        }
    ],
    "base": {
        "plugin": "WebAPI",
        "majorVersion": "1",
        "config": {
            "baseUrl": "https://api.resend.com",
            "authMode": "none",
            "headers": [
                {
                    "key": "Authorization",
                    "value": "Bearer {{apiKey}}"
                },
                {
                    "key": "User-Agent",
                    "value": "SquaredUp-ResendPlugin/1.0"
                }
            ]
        }
    }
}
