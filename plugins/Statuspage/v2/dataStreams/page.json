{
    "name": "page",
    "displayName": "Page",
    "description": "The configured status page, one row (used to import the page object)",
    "tags": ["Status"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "status.json",
        "paging": {
            "mode": "none"
        },
        "postRequestScript": "page.js"
    },
    "matches": "none",
    "visibility": {
        "type": "hidden"
    },
    "metadata": [
        {
            "name": "name",
            "displayName": "Page",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "id",
            "displayName": "ID",
            "shape": "string",
            "role": "id"
        },
        {
            "name": "url",
            "displayName": "URL",
            "shape": "url"
        },
        {
            "name": "timeZone",
            "displayName": "Time Zone",
            "shape": "string"
        }
    ],
    "timeframes": false
}
