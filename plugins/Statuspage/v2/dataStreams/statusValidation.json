{
    "name": "statusValidation",
    "displayName": "Status Validation",
    "description": "Confirms the configured address returns a Statuspage summary document",
    "tags": ["Status"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "summary.json",
        "paging": {
            "mode": "none"
        },
        "postRequestScript": "statusValidation.js"
    },
    "matches": "none",
    "visibility": {
        "type": "hidden"
    },
    "metadata": [
        {
            "pattern": ".*"
        }
    ],
    "timeframes": false
}
