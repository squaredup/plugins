{
    "name": "activeIncidents",
    "displayName": "Active Incidents",
    "description": "Incidents that are currently unresolved, one row per incident",
    "tags": ["Incidents"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "paging": {
            "mode": "none"
        },
        "postRequestScript": "incidents.js",
        "endpointPath": "incidents/unresolved.json",
        "errorHandling": {
            "type": "script",
            "script": "errorHandling/activeIncidents.js"
        }
    },
    "matches": "none",
    "ui": [
        {
            "type": "objects",
            "name": "components",
            "label": "Components",
            "matches": {
                "sourceType": {
                    "type": "equals",
                    "value": "Component"
                }
            },
            "help": "Leave empty to include all components."
        }
    ],
    "metadata": [
        {
            "name": "state",
            "displayName": "State",
            "shape": "state"
        },
        {
            "name": "name",
            "displayName": "Incident",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "id",
            "displayName": "ID",
            "shape": "string",
            "role": "id",
            "visible": false
        },
        {
            "name": "impact",
            "displayName": "Impact",
            "shape": "string"
        },
        {
            "name": "worstComponentStatus",
            "displayName": "Worst Component Status",
            "shape": "string"
        },
        {
            "name": "status",
            "displayName": "Status",
            "shape": "string"
        },
        {
            "name": "phase",
            "displayName": "Phase",
            "shape": "string"
        },
        {
            "name": "components",
            "displayName": "Components",
            "shape": [
                "array",
                {
                    "itemShape": "string"
                }
            ]
        },
        {
            "name": "componentIds",
            "displayName": "Component IDs",
            "shape": [
                "array",
                {
                    "itemShape": "string"
                }
            ],
            "visible": false
        },
        {
            "name": "startedAt",
            "displayName": "Started",
            "shape": "date",
            "role": "timestamp"
        },
        {
            "name": "resolvedAt",
            "displayName": "Resolved",
            "shape": "date"
        },
        {
            "name": "updatedAt",
            "displayName": "Last Updated",
            "shape": "date"
        },
        {
            "name": "timeToResolveMinutes",
            "displayName": "Time To Resolve",
            "shape": "minutes"
        },
        {
            "name": "updateCount",
            "displayName": "Updates",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0
                }
            ]
        },
        {
            "name": "latestUpdate",
            "displayName": "Latest Update",
            "shape": "string"
        },
        {
            "name": "link",
            "displayName": "Link",
            "shape": [
                "url",
                {
                    "label": "View Incident"
                }
            ],
            "role": "link"
        }
    ],
    "defaultShaping": {
        "sort": {
            "by": [["startedAt", "desc"]]
        }
    },
    "timeframes": false
}
