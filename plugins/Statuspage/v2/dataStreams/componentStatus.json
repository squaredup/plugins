{
    "name": "componentStatus",
    "displayName": "Component Status",
    "description": "Current status of each component on the status page, one row per component",
    "tags": ["Status", "Components"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "components.json",
        "paging": {
            "mode": "none"
        },
        "postRequestScript": "componentStatus.js"
    },
    "matches": "none",
    "ui": [
        {
            "type": "objects",
            "name": "components",
            "label": "Components",
            "matches": {
                "sourceType": { "type": "equals", "value": "Component" }
            }
        }
    ],
    "metadata": [
        {
            "name": "state",
            "displayName": "State",
            "shape": "state"
        },
        {
            "name": "name",
            "displayName": "Name",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "id",
            "displayName": "ID",
            "shape": "string",
            "role": "id",
            "visible": false
        },
        {
            "name": "group",
            "displayName": "Group",
            "shape": "string"
        },
        {
            "name": "status",
            "displayName": "Status",
            "shape": "string"
        },
        {
            "name": "severity",
            "displayName": "Severity",
            "shape": "number",
            "visible": false
        },
        {
            "name": "description",
            "displayName": "Description",
            "shape": "string"
        },
        {
            "name": "updatedAt",
            "displayName": "Status Changed",
            "shape": "date"
        }
    ],
    "defaultShaping": {
        "sort": {
            "by": [
                ["severity", "desc"],
                ["name", "asc"]
            ]
        }
    },
    "timeframes": false
}
