{
    "name": "overallStatus",
    "displayName": "Overall Status",
    "description": "Current overall status of the status page with counts of affected components, active incidents and maintenance",
    "tags": ["Status"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "summary.json",
        "paging": {
            "mode": "none"
        },
        "postRequestScript": "overallStatus.js"
    },
    "matches": "none",
    "metadata": [
        {
            "name": "state",
            "displayName": "State",
            "shape": "state"
        },
        {
            "name": "status",
            "displayName": "Status",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "indicator",
            "displayName": "Indicator",
            "shape": "string"
        },
        {
            "name": "componentsAffected",
            "displayName": "Components Affected",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0
                }
            ]
        },
        {
            "name": "activeIncidents",
            "displayName": "Active Incidents",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0
                }
            ]
        },
        {
            "name": "activeMaintenance",
            "displayName": "Active Maintenance",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0
                }
            ]
        },
        {
            "name": "updatedAt",
            "displayName": "Updated",
            "shape": "date"
        },
        {
            "name": "link",
            "displayName": "Status Page",
            "shape": [
                "url",
                {
                    "label": "Open Status Page"
                }
            ],
            "role": "link"
        }
    ],
    "timeframes": false
}
