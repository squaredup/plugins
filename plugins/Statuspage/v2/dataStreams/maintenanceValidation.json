{
    "name": "maintenanceValidation",
    "displayName": "Maintenance Validation",
    "description": "Confirms the status page publishes scheduled maintenance (pages that only emulate the Statuspage API return 404)",
    "tags": ["Status"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "scheduled-maintenances/upcoming.json",
        "paging": {
            "mode": "none"
        },
        "pathToData": "scheduled_maintenances"
    },
    "matches": "none",
    "visibility": {
        "type": "hidden"
    },
    "metadata": [
        {
            "pattern": ".*"
        }
    ],
    "timeframes": false
}
