{
    "name": "componentList",
    "displayName": "Component List",
    "description": "Components on the status page, one row per component (used to import component objects)",
    "tags": ["Components"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "summary.json",
        "paging": {
            "mode": "none"
        },
        "postRequestScript": "componentList.js"
    },
    "matches": "none",
    "visibility": {
        "type": "hidden"
    },
    "metadata": [
        {
            "name": "name",
            "displayName": "Name",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "id",
            "displayName": "ID",
            "shape": "string",
            "role": "id"
        },
        {
            "name": "componentName",
            "displayName": "Component",
            "shape": "string"
        },
        {
            "name": "group",
            "displayName": "Group",
            "shape": "string"
        },
        {
            "name": "pageId",
            "displayName": "Page ID",
            "shape": "string"
        },
        {
            "name": "pageName",
            "displayName": "Page",
            "shape": "string"
        },
        {
            "name": "description",
            "displayName": "Description",
            "shape": "string"
        }
    ],
    "timeframes": false
}
