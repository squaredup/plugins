{
    "name": "componentReliability",
    "displayName": "Component Reliability (Estimate)",
    "description": "Availability and outage time per component over the timeframe, estimated from incident updates",
    "tags": ["Components", "Incidents"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "incidents.json",
        "paging": {
            "mode": "none"
        },
        "postRequestScript": "componentReliability.js"
    },
    "matches": "none",
    "ui": [
        {
            "type": "objects",
            "name": "components",
            "label": "Components",
            "matches": {
                "sourceType": { "type": "equals", "value": "Component" }
            }
        }
    ],
    "metadata": [
        {
            "name": "component",
            "displayName": "Component",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "id",
            "displayName": "ID",
            "shape": "string",
            "role": "id",
            "visible": false
        },
        {
            "name": "group",
            "displayName": "Group",
            "shape": "string"
        },
        {
            "name": "incidentCount",
            "displayName": "Incidents",
            "shape": ["number", { "decimalPlaces": 0 }]
        },
        {
            "name": "majorOutageMinutes",
            "displayName": "Major Outage Time",
            "shape": "minutes"
        },
        {
            "name": "partialOutageMinutes",
            "displayName": "Partial Outage Time",
            "shape": "minutes"
        },
        {
            "name": "degradedMinutes",
            "displayName": "Degraded Performance Time",
            "shape": "minutes"
        },
        {
            "name": "maintenanceMinutes",
            "displayName": "Maintenance Time",
            "shape": "minutes"
        },
        {
            "name": "availabilityPercent",
            "displayName": "Availability",
            "shape": ["percent", { "decimalPlaces": 2 }],
            "role": "value"
        },
        {
            "name": "operationalPercent",
            "displayName": "Fully Operational",
            "shape": ["percent", { "decimalPlaces": 2 }]
        },
        {
            "name": "historyFrom",
            "displayName": "History From",
            "shape": "date"
        },
        {
            "name": "basis",
            "displayName": "Basis",
            "shape": "string"
        }
    ],
    "timeframes": [
        "last7days",
        "last30days",
        "thisMonth",
        "lastMonth",
        "thisQuarter",
        "lastQuarter",
        "thisYear",
        "lastYear"
    ],
    "defaultShaping": {
        "sort": {
            "by": [
                ["availabilityPercent", "asc"],
                ["operationalPercent", "asc"]
            ]
        }
    }
}
