                "w": 4,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Longest Planned Windows",
                    "description": "The 10 maintenance windows with the longest planned duration, in hours",
                    "dataStream": {
                        "id": "datastream-sql",
                        "dataSourceConfig": {
                            "version": "2.0",
                            "sql": "SELECT \"name\" || ' (' || STRFTIME(\"scheduledFor\", '%d %b %Y') || ')' AS \"window\", ROUND(\"durationMinutes\" / 60, 1) AS \"plannedHours\" FROM \"maintenance\" WHERE \"durationMinutes\" IS NOT NULL AND \"scheduledFor\" IS NOT NULL ORDER BY \"durationMinutes\" DESC LIMIT 10",
                            "tables": [
                                {
                                    "tableName": "maintenance",
                                    "config": {
