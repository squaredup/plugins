                                    "type": "nominal",
                                    "title": "Maintenance Window"
                                },
                                "y": {
                                    "field": "plannedHours",
                                    "type": "quantitative",
                                    "title": "Planned Hours"
                                }
                            },
                            "style": {
                                "cartesianHorizontal": true,
                                "cartesianBarBorderRadius": 4,
                                "cartesianShowHorizontalGridLines": false,
                                "showLabels": true,
                                "cartesianColorRules": [
