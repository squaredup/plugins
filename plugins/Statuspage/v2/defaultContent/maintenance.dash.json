            {
                "i": "edfa7cb7-018b-4755-a77a-b2735b1d3977",
                "x": 0,
                "y": 6,
                "w": 2,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Maintenance per Month",
                    "description": "Maintenance windows and their planned hours by the month they started",
                    "dataStream": {
                        "id": "datastream-sql",
                        "dataSourceConfig": {
                            "version": "2.0",
                            "sql": "SELECT STRFTIME(DATE_TRUNC('month', \"scheduledFor\"), '%b %Y') AS \"month\", CAST(COUNT(*) AS DOUBLE) AS \"Windows\", ROUND(COALESCE(SUM(\"durationMinutes\"), 0) / 60, 1) AS \"Planned Hours\" FROM \"maintenance\" WHERE \"scheduledFor\" IS NOT NULL GROUP BY DATE_TRUNC('month', \"scheduledFor\") ORDER BY DATE_TRUNC('month', \"scheduledFor\")",
                            "tables": [
                                {
                                    "tableName": "maintenance",
                                    "config": {
                                        "activePluginConfigIds": ["{{configId}}"],
                                        "dataStream": {
                                            "id": "{{dataStreams.[maintenance]}}",
                                            "name": "maintenance"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "visualisation": {
                        "noDataMessage": "No maintenance in this timeframe"
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "month",
                                    "type": "nominal",
                                    "title": "Month"
                                },
                                "y": {
                                    "field": "Windows",
                                    "type": "quantitative",
                                    "title": "Windows"
                                }
                            },
                            "style": {
                                "cartesianBarBorderRadius": 4,
                                "cartesianY2AxisField": "Planned Hours",
                                "cartesianY2AxisTitle": "Planned Hours",
                                "legendPosition": "bottom",
                                "mappedColors": {
                                    "Windows": "#3b82f6",
                                    "Planned Hours": "#a855f7"
                                }
                            }
                        }
                    }
                }
            },
            {
                "i": "d6b44da2-f9eb-4e49-9342-613565b73bf2",
                "x": 2,
                "y": 6,
                "w": 2,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Windows by Component",
                    "description": "The 15 components named in the most maintenance windows",
                    "dataStream": {
                        "id": "datastream-sql",
                        "dataSourceConfig": {
                            "version": "2.0",
                            "sql": "SELECT REPLACE(TRIM(\"part\"), CHR(31), ', ') AS \"component\", CAST(COUNT(*) AS DOUBLE) AS \"windows\" FROM (SELECT UNNEST(STRING_SPLIT(REPLACE(\"components\", ', ', CHR(31)), ',')) AS \"part\" FROM \"maintenance\" WHERE \"components\" IS NOT NULL AND \"components\" <> '') WHERE TRIM(\"part\") <> '' GROUP BY REPLACE(TRIM(\"part\"), CHR(31), ', ') ORDER BY \"windows\" DESC, \"component\" LIMIT 15",
                            "tables": [
                                {
                                    "tableName": "maintenance",
                                    "config": {
                                        "activePluginConfigIds": ["{{configId}}"],
                                        "dataStream": {
                                            "id": "{{dataStreams.[maintenance]}}",
                                            "name": "maintenance"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "visualisation": {
                        "noDataMessage": "No maintenance in this timeframe named a component"
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "component",
                                    "type": "nominal",
                                    "title": "Component"
                                },
                                "y": {
                                    "field": "windows",
                                    "type": "quantitative",
                                    "title": "Windows"
                                }
                            },
                            "style": {
                                "cartesianHorizontal": true,
                                "cartesianBarBorderRadius": 4,
                                "cartesianShowHorizontalGridLines": false,
                                "showLabels": true,
                                "cartesianColorRules": [
                                    {
                                        "gte": 0,
                                        "color": "#3b82f6"
                                    }
                                ]
                            }
                        }
                    }
                }
            },
            {
                "i": "d1b68e77-d3d5-431b-840e-5e6a83d9887f",
