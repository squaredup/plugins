            {
                "i": "0ba6a18a-8ed3-4063-a092-0dd74c383515",
                "x": 0,
                "y": 7,
                "w": 2,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Incidents per Week (Latest 50 Incidents)",
                    "description": "Incidents started each week of the dashboard timeframe. Statuspage publishes only the 50 most recent incidents, so on a busy page this history may start later than the selected timeframe.",
                    "dataStream": {
                        "id": "datastream-sql",
                        "dataSourceConfig": {
                            "version": "2.0",
                            "sql": "SELECT STRFTIME(DATE_TRUNC('week', \"startedAt\"), '%Y-%m-%dT%H:%M:%SZ') AS \"week\", CAST(COUNT(*) AS DOUBLE) AS \"incidents\" FROM \"incidents\" WHERE \"startedAt\" IS NOT NULL GROUP BY DATE_TRUNC('week', \"startedAt\") ORDER BY DATE_TRUNC('week', \"startedAt\")",
                            "tables": [
                                {
                                    "tableName": "incidents",
                                    "config": {
                                        "activePluginConfigIds": ["{{configId}}"],
                                        "dataStream": {
                                            "id": "{{dataStreams.[incidents]}}",
                                            "name": "incidents"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "visualisation": {
                        "noDataMessage": "No incidents in this timeframe"
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "week",
                                    "type": "temporal",
                                    "title": "Week"
                                },
                                "y": {
                                    "field": "incidents",
                                    "type": "quantitative",
                                    "title": "Incidents"
                                }
                            },
                            "style": {
                                "cartesianBarBorderRadius": 4,
                                "cartesianColorRules": [
                                    {
                                        "gte": 0,
                                        "color": "#6366f1"
                                    }
                                ]
                            }
                        }
                    }
                }
            },
            {
                "i": "2795ddb4-9790-477e-8469-b4299484281a",
                "x": 2,
                "y": 7,
                "w": 2,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Component Status by Group",
                    "description": "How many components in each group are in each status right now",
                    "timeframe": "none",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[componentStatus]}}",
                        "name": "componentStatus",
                        "pluginConfigId": "{{configId}}",
                        "group": {
                            "by": [
                                ["group", "uniqueValues"],
                                ["status", "uniqueValues"]
                            ],
                            "aggregate": [
                                {
                                    "type": "count"
                                }
                            ]
                        },
                        "sort": {
                            "by": [["group_uniqueValues", "asc"]]
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "group_uniqueValues",
                                    "type": "nominal",
                                    "title": "Group"
                                },
                                "y": {
                                    "field": "count",
                                    "type": "quantitative",
                                    "title": "Components"
                                },
                                "series": {
                                    "field": "status_uniqueValues",
                                    "type": "nominal",
                                    "title": "Status"
                                }
                            },
                            "style": {
                                "cartesianHorizontal": true,
                                "cartesianStack": "on",
                                "cartesianBarBorderRadius": 3,
                                "cartesianShowHorizontalGridLines": false,
                                "legendPosition": "bottom",
                                "mappedColors": {
                                    "Operational": "#22c55e",
                                    "Under Maintenance": "#3b82f6",
                                    "Degraded Performance": "#f59e0b",
                                    "Partial Outage": "#ef4444",
                                    "Major Outage": "#991b1b"
                                }
                            }
                        }
                    }
                }
            },
            {
                "i": "ca3d9eec-1562-4126-8b4a-3f4fcb7a423c",
                "x": 0,
                "y": 10,
                "w": 4,
                "h": 5,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Component Status",
                    "description": "Current status of every component, grouped as on the status page. Groups and components with problems are listed first.",
                    "timeframe": "none",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[componentStatus]}}",
                        "name": "componentStatus",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [
                                ["severity", "desc"],
                                ["group", "asc"],
                                ["name", "asc"]
                            ]
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "statusGrid",
                            "encoding": {
                                "label": {
                                    "field": "name",
                                    "type": "nominal"
                                },
                                "status": {
                                    "field": "state",
                                    "type": "nominal"
                                },
                                "group": {
                                    "field": "group",
                                    "type": "nominal"
                                }
                            },
                            "style": {
                                "statusGridColumnsPerRow": 4,
                                "statusGridMaxBlockHeight": 72,
                                "statusGridOrderByField": "severity",
                                "statusGridSecondaryTemplate": "{{{{raw}}}}{{status}}{{{{/raw}}}}"
                            }
                        }
                    }
                }
            }
        ]
    }
}
