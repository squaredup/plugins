                                                "Under Maintenance": "#3b82f6",
                                                "Degraded Performance": "#f59e0b",
                                                "Partial Outage": "#ef4444",
                                                "Major Outage": "#991b1b"
                                            }
                                        }
                                    },
                                    {
                                        "field": "components",
                                        "title": "Components",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "startedAt",
                                        "title": "Started",
                                        "renderer": {
