{
    "name": "Component",
    "schemaVersion": "1.5",
    "timeframe": "last30days",
    "variables": ["{{variables.[Statuspage Component]}}"],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "8a4f062b-9d0c-4df4-bead-5e77d2559eae",
                "x": 0,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Current Status",
                    "description": "The status of this component on the status page right now",
                    "timeframe": "none",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[componentStatus]}}",
                        "name": "componentStatus",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "components": {
                                "variable": "{{variables.[Statuspage Component]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Statuspage Components]}}"
                            }
                        }
                    },
                    "variables": ["{{variables.[Statuspage Component]}}"],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "statusGrid",
                            "encoding": {
                                "label": {
                                    "field": "name",
                                    "type": "nominal"
                                },
                                "status": {
                                    "field": "state",
                                    "type": "nominal"
                                }
                            },
                            "style": {
                                "statusGridColumnsPerRow": 1,
                                "statusGridLabelWrap": true,
                                "statusGridSecondaryTemplate": "{{{{raw}}}}{{status}}{{{{/raw}}}}"
                            }
                        }
                    }
                }
            },
            {
                "i": "6aa6d50b-b500-486f-bd94-1987dcffbcbd",
