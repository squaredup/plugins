                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": []
                            },
                            "style": {
                                "scalarRowCount": true,
                                "scalarLabelPosition": "none"
                            }
                        }
                    }
                }
            },
            {
                "i": "31b50bba-9bec-416e-a28b-c00f87a6bf22",
                "x": 0,
                "y": 2,
                "w": 4,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Time Not Fully Operational",
                    "description": "Estimated time this component spent in each status during the timeframe, from incident updates",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[componentReliability]}}",
                        "name": "componentReliability",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "components": {
                                "variable": "{{variables.[Statuspage Component]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Statuspage Components]}}"
                            }
                        }
                    },
                    "variables": ["{{variables.[Statuspage Component]}}"],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    {
                                        "field": "majorOutageMinutes",
                                        "type": "quantitative",
                                        "title": "Major Outage"
                                    },
                                    {
                                        "field": "partialOutageMinutes",
                                        "type": "quantitative",
                                        "title": "Partial Outage"
                                    },
                                    {
                                        "field": "degradedMinutes",
                                        "type": "quantitative",
                                        "title": "Degraded Performance"
                                    },
                                    {
                                        "field": "maintenanceMinutes",
                                        "type": "quantitative",
                                        "title": "Under Maintenance"
                                    }
                                ]
                            },
                            "style": {
                                "scalarColumns": 4
                            }
                        }
                    }
                }
            },
            {
                "i": "c9ab221a-cf12-41eb-ab4c-f7df8e8129b5",
                "x": 0,
                "y": 4,
                "w": 4,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Incidents",
                    "description": "Incidents affecting this component, newest first. Click a row for the latest update and a link to the incident.",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[incidents]}}",
                        "name": "incidents",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "components": {
                                "variable": "{{variables.[Statuspage Component]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Statuspage Components]}}"
                            }
                        },
                        "sort": {
                            "by": [["startedAt", "desc"]]
                        }
                    },
                    "variables": ["{{variables.[Statuspage Component]}}"],
                    "visualisation": {
                        "noDataMessage": "No incidents affected this component in this timeframe"
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "impact",
                                        "title": "Impact",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "Critical": "#ef4444",
                                                "Major": "#f97316",
                                                "Minor": "#f59e0b",
                                                "None": "#94a3b8",
                                                "Maintenance": "#3b82f6"
                                            }
                                        },
                                        "width": 100
                                    },
                                    {
                                        "field": "name",
                                        "title": "Incident",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "status",
                                        "title": "Status",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "Investigating": "#ef4444",
                                                "Identified": "#f97316",
                                                "Monitoring": "#3b82f6",
                                                "Resolved": "#22c55e",
                                                "Postmortem": "#64748b"
                                            }
                                        },
                                        "width": 120
                                    },
                                    {
                                        "field": "startedAt",
                                        "title": "Started",
                                        "renderer": {
                                            "type": "date"
                                        }
                                    },
                                    {
                                        "field": "resolvedAt",
                                        "title": "Resolved",
                                        "renderer": {
                                            "type": "date"
                                        }
                                    },
                                    {
                                        "field": "timeToResolveMinutes",
                                        "title": "Time to Resolve",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableCellPadding": 6,
                                "richTableRowLinkField": "link",
                                "detailsPanel": true
                            }
                        }
                    }
                }
            },
            {
                "i": "7d7be7a8-cdf4-452d-9fd6-bb8d2a615d44",
                "x": 0,
                "y": 7,
                "w": 4,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Status Changes",
                    "description": "Each time an incident update changed the status of this component, newest first. Click a row to read the update.",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[incidentUpdates]}}",
                        "name": "incidentUpdates",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "oneRowPerComponent": true,
                            "components": {
                                "variable": "{{variables.[Statuspage Component]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Statuspage Components]}}"
                            }
                        },
                        "filter": {
                            "multiOperation": "and",
                            "filters": [
                                {
                                    "column": "newStatus",
                                    "operation": "notempty"
                                }
                            ]
                        },
                        "sort": {
                            "by": [["postedAt", "desc"]]
                        }
                    },
                    "variables": ["{{variables.[Statuspage Component]}}"],
                    "visualisation": {
                        "noDataMessage": "No status changes for this component in this timeframe"
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "postedAt",
                                        "title": "Posted",
                                        "renderer": {
                                            "type": "date"
                                        }
                                    },
                                    {
                                        "field": "oldStatus",
                                        "title": "From",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "Operational": "#22c55e",
                                                "Under Maintenance": "#3b82f6",
                                                "Degraded Performance": "#f59e0b",
                                                "Partial Outage": "#ef4444",
                                                "Major Outage": "#991b1b"
                                            }
                                        }
                                    },
                                    {
                                        "field": "newStatus",
                                        "title": "To",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "Operational": "#22c55e",
                                                "Under Maintenance": "#3b82f6",
                                                "Degraded Performance": "#f59e0b",
                                                "Partial Outage": "#ef4444",
                                                "Major Outage": "#991b1b"
                                            }
                                        }
                                    },
                                    {
                                        "field": "incidentName",
                                        "title": "Incident",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "status",
                                        "title": "Incident Status",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "Investigating": "#ef4444",
                                                "Identified": "#f97316",
                                                "Monitoring": "#3b82f6",
                                                "Resolved": "#22c55e",
                                                "Postmortem": "#64748b"
                                            }
                                        },
                                        "width": 130
                                    },
                                    {
                                        "field": "body",
                                        "title": "Update",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableCellPadding": 6,
                                "richTableRowLinkField": "link",
                                "detailsPanel": true
                            }
                        }
                    }
                }
            },
            {
                "i": "70d0115e-d63a-4f52-a94c-62fd8916d63c",
                "x": 0,
                "y": 11,
                "w": 4,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Maintenance",
                    "description": "Maintenance windows that include this component, newest first. Click a row for the details.",
                    "timeframe": "none",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[maintenance]}}",
                        "name": "maintenance",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "components": {
                                "variable": "{{variables.[Statuspage Component]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Statuspage Components]}}"
                            }
                        },
                        "sort": {
                            "by": [["scheduledFor", "desc"]]
                        }
                    },
                    "variables": ["{{variables.[Statuspage Component]}}"],
                    "visualisation": {
                        "noDataMessage": "No maintenance has included this component"
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "phase",
                                        "title": "Phase",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "Active": "#f59e0b",
                                                "Upcoming": "#3b82f6",
                                                "Completed": "#22c55e"
                                            }
                                        },
                                        "width": 100
                                    },
                                    {
                                        "field": "name",
                                        "title": "Maintenance",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "scheduledFor",
                                        "title": "Starts",
                                        "renderer": {
                                            "type": "date"
                                        }
                                    },
                                    {
                                        "field": "scheduledUntil",
                                        "title": "Ends",
                                        "renderer": {
                                            "type": "date"
                                        }
                                    },
                                    {
                                        "field": "durationMinutes",
                                        "title": "Planned Duration",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "status",
                                        "title": "Status",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "Scheduled": "#3b82f6",
                                                "In Progress": "#f59e0b",
                                                "Verifying": "#f59e0b",
                                                "Completed": "#22c55e"
                                            }
                                        },
                                        "width": 120
                                    }
                                ]
                            },
                            "style": {
                                "richTableCellPadding": 6,
                                "richTableRowLinkField": "link",
                                "detailsPanel": true
                            }
                        }
                    }
                }
            }
        ]
    }
}
