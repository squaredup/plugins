                "config": {
                    "_type": "tile/data-stream",
                    "title": "Incidents With Outages",
                    "description": "Incidents in which at least one component reached Partial Outage or Major Outage",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[incidents]}}",
                        "name": "incidents",
                        "pluginConfigId": "{{configId}}",
                        "filter": {
                            "multiOperation": "or",
                            "filters": [
