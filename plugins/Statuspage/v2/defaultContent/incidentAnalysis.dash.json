            {
                "i": "65ee2716-e0e1-4d5c-8ef2-ac2192c1962a",
                "x": 2,
                "y": 9,
                "w": 2,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Time to Resolve by Impact",
                    "description": "Median and 90th percentile hours to resolve, for resolved incidents of each impact",
                    "dataStream": {
                        "id": "datastream-sql",
                        "dataSourceConfig": {
                            "version": "2.0",
                            "sql": "SELECT \"impact\", ROUND(MEDIAN(\"timeToResolveMinutes\") / 60, 1) AS \"Median\", ROUND(QUANTILE_CONT(\"timeToResolveMinutes\", 0.9) / 60, 1) AS \"90th Percentile\" FROM \"incidents\" WHERE \"timeToResolveMinutes\" IS NOT NULL AND \"impact\" IS NOT NULL GROUP BY \"impact\" ORDER BY CASE \"impact\" WHEN 'Critical' THEN 1 WHEN 'Major' THEN 2 WHEN 'Minor' THEN 3 WHEN 'None' THEN 4 ELSE 5 END",
                            "tables": [
                                {
                                    "tableName": "incidents",
                                    "config": {
                                        "activePluginConfigIds": ["{{configId}}"],
                                        "dataStream": {
                                            "id": "{{dataStreams.[incidents]}}",
                                            "name": "incidents"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "visualisation": {
                        "noDataMessage": "No resolved incidents in this timeframe"
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "impact",
                                    "type": "nominal",
                                    "title": "Impact"
                                },
                                "y": [
                                    {
                                        "field": "Median",
                                        "type": "quantitative",
                                        "title": "Median"
                                    },
                                    {
                                        "field": "90th Percentile",
                                        "type": "quantitative",
                                        "title": "90th Percentile"
                                    }
                                ]
                            },
                            "style": {
                                "cartesianBarBorderRadius": 4,
                                "legendPosition": "bottom",
                                "cartesianShowYAxisTitle": true,
                                "cartesianYAxisTitle": "Hours",
                                "mappedColors": {
                                    "Median": "#3b82f6",
                                    "90th Percentile": "#a855f7"
                                }
                            }
                        }
                    }
                }
            },
