{
    "name": "Component Reliability",
    "schemaVersion": "1.5",
    "timeframe": "last30days",
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "12be24a5-7075-4e09-afc4-4e0321033b85",
                "x": 0,
                "y": 0,
                "w": 4,
                "h": 1,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/text",
                    "title": "How This Is Estimated",
                    "description": "",
                    "visualisation": {
                        "config": {
                            "content": "Reliability is estimated from incident updates, not measured. Availability counts Major Outage time as down; Fully Operational also counts Partial Outage and Degraded Performance. Statuspage publishes only the 50 most recent incidents, so older periods may be missing; the tiles warn when that happens.",
                            "fontSize": 14,
                            "align": "left",
                            "autoSize": false
                        }
                    }
                }
            },
            {
                "i": "69db2212-5a1b-42b2-a2dc-e05133c6aba7",
                "x": 0,
                "y": 1,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Average Availability",
                    "description": "Average estimated availability across all components",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[componentReliability]}}",
                        "name": "componentReliability",
                        "pluginConfigId": "{{configId}}"
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    {
                                        "field": "availabilityPercent",
                                        "type": "quantitative",
                                        "title": "Average Availability",
                                        "aggregate": "avg"
                                    }
                                ]
                            },
                            "style": {
                                "scalarLabelPosition": "none"
                            }
                        }
                    }
                }
            },
            {
                "i": "dc7eeac8-724e-4ed1-b27b-598e7990a123",
                "x": 1,
                "y": 1,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Lowest Availability",
                    "description": "Estimated availability of the least available component",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[componentReliability]}}",
                        "name": "componentReliability",
                        "pluginConfigId": "{{configId}}"
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    {
                                        "field": "availabilityPercent",
                                        "type": "quantitative",
                                        "title": "Lowest Availability",
                                        "aggregate": "min"
                                    }
                                ]
                            },
                            "style": {
                                "scalarLabelPosition": "none"
                            }
                        }
                    }
                }
            },
            {
                "i": "6d49899c-40f3-4e66-b850-0bc4a72143b6",
                "x": 2,
                "y": 1,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Average Fully Operational",
                    "description": "Average share of the timeframe components were fully operational",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[componentReliability]}}",
                        "name": "componentReliability",
                        "pluginConfigId": "{{configId}}"
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    {
                                        "field": "operationalPercent",
                                        "type": "quantitative",
                                        "title": "Average Fully Operational",
                                        "aggregate": "avg"
                                    }
                                ]
                            },
                            "style": {
                                "scalarLabelPosition": "none"
                            }
                        }
                    }
                }
            },
            {
                "i": "f381cb26-0341-49d8-b7a2-2e101fe1700b",
                "x": 3,
                "y": 1,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Components With Outages",
                    "description": "Components that spent time in Partial Outage or Major Outage",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[componentReliability]}}",
                        "name": "componentReliability",
                        "pluginConfigId": "{{configId}}",
                        "filter": {
                            "multiOperation": "or",
                            "filters": [
                                {
                                    "column": "majorOutageMinutes",
                                    "operation": "greaterthan",
                                    "value": "0"
                                },
                                {
                                    "column": "partialOutageMinutes",
                                    "operation": "greaterthan",
                                    "value": "0"
                                }
                            ]
                        }
                    },
                    "visualisation": {
                        "noDataMessage": "None in this timeframe"
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": []
                            },
                            "style": {
                                "scalarRowCount": true,
                                "scalarLabelPosition": "none"
                            }
                        }
                    }
                }
            },
            {
                "i": "0e1b1b43-caba-4097-a3f9-e43b703d586d",
                "x": 0,
                "y": 3,
                "w": 2,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Outage Time by Component (Hours)",
                    "description": "Hours each component spent in each status, for the 15 components with the most outage time",
                    "dataStream": {
                        "id": "datastream-sql",
                        "dataSourceConfig": {
                            "version": "2.0",
                            "sql": "SELECT \"component\", ROUND(COALESCE(\"majorOutageMinutes\", 0) / 60, 2) AS \"Major Outage\", ROUND(COALESCE(\"partialOutageMinutes\", 0) / 60, 2) AS \"Partial Outage\", ROUND(COALESCE(\"degradedMinutes\", 0) / 60, 2) AS \"Degraded Performance\", ROUND(COALESCE(\"maintenanceMinutes\", 0) / 60, 2) AS \"Under Maintenance\" FROM \"componentReliability\" WHERE COALESCE(\"majorOutageMinutes\", 0) + COALESCE(\"partialOutageMinutes\", 0) + COALESCE(\"degradedMinutes\", 0) + COALESCE(\"maintenanceMinutes\", 0) > 0 ORDER BY COALESCE(\"majorOutageMinutes\", 0) DESC, COALESCE(\"partialOutageMinutes\", 0) DESC, COALESCE(\"majorOutageMinutes\", 0) + COALESCE(\"partialOutageMinutes\", 0) + COALESCE(\"degradedMinutes\", 0) + COALESCE(\"maintenanceMinutes\", 0) DESC LIMIT 15",
                            "tables": [
                                {
                                    "tableName": "componentReliability",
                                    "config": {
                                        "activePluginConfigIds": ["{{configId}}"],
                                        "dataStream": {
                                            "id": "{{dataStreams.[componentReliability]}}",
                                            "name": "componentReliability"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "visualisation": {
                        "noDataMessage": "No outage time in this timeframe"
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "component",
                                    "type": "nominal",
                                    "title": "Component"
                                },
                                "y": [
                                    {
                                        "field": "Major Outage",
                                        "type": "quantitative"
                                    },
                                    {
                                        "field": "Partial Outage",
                                        "type": "quantitative"
                                    },
                                    {
                                        "field": "Degraded Performance",
                                        "type": "quantitative"
                                    },
                                    {
                                        "field": "Under Maintenance",
                                        "type": "quantitative"
                                    }
                                ]
                            },
                            "style": {
                                "cartesianHorizontal": true,
                                "cartesianStack": "on",
                                "cartesianBarBorderRadius": 3,
                                "cartesianShowHorizontalGridLines": false,
                                "legendPosition": "bottom",
                                "mappedColors": {
                                    "Operational": "#22c55e",
                                    "Under Maintenance": "#3b82f6",
                                    "Degraded Performance": "#f59e0b",
                                    "Partial Outage": "#ef4444",
                                    "Major Outage": "#991b1b"
                                }
                            }
                        }
                    }
                }
            },
            {
                "i": "95cf511b-8354-4da8-a813-c1c8972cf2e8",
                "x": 2,
                "y": 3,
                "w": 2,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Outage Time by Status (Hours)",
                    "description": "Hours spent in each status, added up across all components",
                    "dataStream": {
                        "id": "datastream-sql",
                        "dataSourceConfig": {
                            "version": "2.0",
                            "sql": "SELECT \"status\", \"hours\" FROM (SELECT 'Major Outage' AS \"status\", 1 AS \"rank\", ROUND(SUM(COALESCE(\"majorOutageMinutes\", 0)) / 60, 2) AS \"hours\" FROM \"componentReliability\" UNION ALL SELECT 'Partial Outage', 2, ROUND(SUM(COALESCE(\"partialOutageMinutes\", 0)) / 60, 2) FROM \"componentReliability\" UNION ALL SELECT 'Degraded Performance', 3, ROUND(SUM(COALESCE(\"degradedMinutes\", 0)) / 60, 2) FROM \"componentReliability\" UNION ALL SELECT 'Under Maintenance', 4, ROUND(SUM(COALESCE(\"maintenanceMinutes\", 0)) / 60, 2) FROM \"componentReliability\") WHERE \"hours\" > 0 ORDER BY \"rank\"",
                            "tables": [
                                {
                                    "tableName": "componentReliability",
                                    "config": {
                                        "activePluginConfigIds": ["{{configId}}"],
                                        "dataStream": {
                                            "id": "{{dataStreams.[componentReliability]}}",
                                            "name": "componentReliability"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "visualisation": {
                        "noDataMessage": "No outage time in this timeframe"
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "pie",
                            "encoding": {
                                "label": {
                                    "field": "status",
                                    "type": "nominal",
                                    "title": "Status"
                                },
                                "value": {
                                    "field": "hours",
                                    "type": "quantitative",
                                    "title": "Hours"
                                }
                            },
                            "style": {
                                "pieInnerRadius": 60,
                                "pieDonutCenterValue": "total",
                                "labelFontSize": 16,
                                "pieLegendStyle": "table",
                                "pieLabels": "nameAndValue",
                                "mappedColors": {
                                    "Operational": "#22c55e",
                                    "Under Maintenance": "#3b82f6",
                                    "Degraded Performance": "#f59e0b",
                                    "Partial Outage": "#ef4444",
                                    "Major Outage": "#991b1b"
                                }
                            }
                        }
                    }
                }
            },
            {
                "i": "7ae53bc7-74fe-45ca-b907-2429cf443998",
                "x": 0,
                "y": 7,
                "w": 4,
                "h": 5,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Availability by Component",
                    "description": "Estimated availability and time in each status per component, least available first",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[componentReliability]}}",
                        "name": "componentReliability",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [
                                ["availabilityPercent", "asc"],
                                ["operationalPercent", "asc"]
                            ]
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "component",
                                        "title": "Component",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "group",
                                        "title": "Group",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "availabilityPercent",
                                        "title": "Availability",
                                        "renderer": {
                                            "type": "number",
                                            "decimals": 3,
                                            "suffix": "%",
                                            "thresholds": [
                                                {
                                                    "to": 99,
                                                    "color": "#ef4444"
                                                },
                                                {
                                                    "to": 99.9,
                                                    "color": "#f59e0b"
                                                },
                                                {
                                                    "to": 100,
                                                    "color": "#16a34a"
                                                }
                                            ]
                                        },
                                        "align": "right"
                                    },
                                    {
                                        "field": "operationalPercent",
                                        "title": "Fully Operational",
                                        "renderer": {
                                            "type": "number",
                                            "decimals": 3,
                                            "suffix": "%",
                                            "thresholds": [
                                                {
                                                    "to": 99,
                                                    "color": "#ef4444"
                                                },
                                                {
                                                    "to": 99.9,
                                                    "color": "#f59e0b"
                                                },
                                                {
                                                    "to": 100,
                                                    "color": "#16a34a"
                                                }
                                            ]
                                        },
                                        "align": "right"
                                    },
                                    {
                                        "field": "majorOutageMinutes",
                                        "title": "Major Outage",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "partialOutageMinutes",
                                        "title": "Partial Outage",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "degradedMinutes",
                                        "title": "Degraded Performance",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "maintenanceMinutes",
                                        "title": "Under Maintenance",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "incidentCount",
                                        "title": "Incidents",
                                        "renderer": {
                                            "type": "number",
                                            "decimals": 0
                                        },
                                        "align": "right",
                                        "width": 90
                                    },
                                    {
                                        "field": "historyFrom",
                                        "title": "History From",
                                        "renderer": {
                                            "type": "date"
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableCellPadding": 6
                            }
                        }
                    }
                }
            }
        ]
    }
}
