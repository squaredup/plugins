    {
        "type": "fieldGroup",
        "visible": {
            "pageSource": "custom"
        },
        "fields": [
            {
                "type": "text",
                "name": "statusPageUrl",
                "label": "Status page URL",
                "placeholder": "https://status.example.com",
                "help": "Accepts the address of any status page hosted on Atlassian Statuspage, such as `status.example.com`, or a Statuspage subdomain or page ID such as `abc123xyz`. Requests are always sent over HTTPS.",
                "validation": {
                    "required": true,
                    "pattern": {
                        "value": "^\\s*([a-zA-Z]+://)?[A-Za-z0-9.-]+(:[0-9]+)?([/?#]\\S*)?\\s*$",
                        "message": "Enter a status page address, such as status.example.com"
                    }
                }
            }
        ]
    }
