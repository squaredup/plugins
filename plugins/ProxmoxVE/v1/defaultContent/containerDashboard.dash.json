                                        "field": "name",
                                        "title": "Name",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "status[Expanded].rawState",
                                        "title": "Status",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
