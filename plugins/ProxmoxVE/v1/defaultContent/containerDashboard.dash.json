                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "maxmem",
                                        "title": "Memory Total",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "swap",
                                        "title": "Swap Used",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "maxswap",
                                        "title": "Swap Total",
                                        "renderer": {
                                            "type": "text"
                                        }
