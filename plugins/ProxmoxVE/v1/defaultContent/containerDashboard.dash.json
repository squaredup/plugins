                                    {
                                        "field": "disk",
                                        "title": "Disk Used",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "maxdisk",
                                        "title": "Disk Total",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "uptime",
                                        "title": "Uptime",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "containerid",
                                        "title": "Container ID",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableTranspose": true
                            }
                        }
                    }
