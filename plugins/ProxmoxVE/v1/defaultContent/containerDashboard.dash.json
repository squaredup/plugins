{
    "name": "Container",
    "schemaVersion": "1.5",
    "timeframe": "last24hours",
    "variables": ["{{variables.[Container]}}"],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
