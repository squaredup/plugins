{
    "name": "Backup Group",
    "schemaVersion": "1.5",
    "timeframe": "last24hours",
    "variables": ["{{variables.[Backup Group]}}"],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "2ef90cad-1ddb-4a5d-99a6-f6a90d41cd71",
                "x": 0,
                "y": 0,
                "w": 2,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Backup Group Details",
                    "description": "",
                    "activePluginConfigIds": ["{{configId}}"],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "datastream-properties",
                        "name": "properties"
                    },
                    "scope": {
                        "scope": "{{scopes.[Backup Groups]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Backup Group]}}"
                    },
                    "variables": ["{{variables.[Backup Group]}}"],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {},
                            "style": {
                                "richTableTranspose": true
                            }
                        }
                    }
                }
            },
            {
                "i": "baca838d-6a4f-428a-af84-6dabc55b25a0",
                "x": 2,
                "y": 0,
                "w": 2,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Snapshots by Verification State",
                    "description": "",
                    "activePluginConfigIds": ["{{configId}}"],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[pbsGroupSnapshots]}}",
                        "name": "pbsGroupSnapshots",
                        "pluginConfigId": "{{configId}}",
                        "group": {
                            "by": [["verificationState", "uniqueValues"]],
                            "aggregate": [{ "type": "count" }]
                        }
                    },
                    "scope": {
                        "scope": "{{scopes.[Backup Groups]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Backup Group]}}"
                    },
                    "variables": ["{{variables.[Backup Group]}}"],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "pie",
                            "encoding": {
                                "label": {
                                    "field": "verificationState_uniqueValues",
                                    "type": "nominal",
                                    "title": "Verification State"
                                },
                                "value": {
                                    "field": "count",
                                    "type": "quantitative",
                                    "aggregate": "sum",
                                    "title": "Count"
                                }
                            },
                            "style": {
                                "pieInnerRadius": 60,
                                "pieDonutCenterValue": "total",
                                "labelFontSize": 16,
                                "pieSort": "desc",
                                "pieLegendStyle": "table",
                                "mappedColors": {
                                    "critical": "#DE0038",
                                    "error": "#DE0038",
                                    "failed": "#DE0038",
                                    "failure": "#DE0038",
                                    "down": "#DE0038",
                                    "offline": "#DE0038",
                                    "unhealthy": "#DE0038",
                                    "high": "#DE0038",
                                    "warning": "#F59E0B",
                                    "warn": "#F59E0B",
                                    "medium": "#F59E0B",
                                    "moderate": "#F59E0B",
                                    "degraded": "#F59E0B",
                                    "partial": "#F59E0B",
                                    "ok": "#2BB660",
                                    "healthy": "#2BB660",
                                    "success": "#2BB660",
                                    "succeeded": "#2BB660",
                                    "passed": "#2BB660",
                                    "up": "#2BB660",
                                    "online": "#2BB660",
                                    "resolved": "#2BB660",
                                    "low": "#3B82F6",
                                    "info": "#3B82F6",
                                    "informational": "#3B82F6",
                                    "unknown": "#94A3B8",
                                    "unmonitored": "#94A3B8",
                                    "not monitored": "#94A3B8",
                                    "paused": "#94A3B8"
                                }
                            }
                        }
                    }
                }
            },
            {
                "i": "c6df7c70-5b98-400c-990d-f3a8b9c7e184",
                "x": 0,
                "y": 3,
                "w": 4,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Snapshot History",
                    "description": "",
                    "activePluginConfigIds": ["{{configId}}"],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[pbsGroupSnapshots]}}",
                        "name": "pbsGroupSnapshots",
                        "pluginConfigId": "{{configId}}",
                        "sort": { "by": [["time", "desc"]] }
                    },
                    "scope": {
                        "scope": "{{scopes.[Backup Groups]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Backup Group]}}"
                    },
                    "variables": ["{{variables.[Backup Group]}}"],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "time",
                                        "title": "Time",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "size",
                                        "title": "Size",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "protected",
                                        "title": "Protected",
                                        "renderer": {
                                            "type": "boolean",
                                            "trueLabel": "Yes",
                                            "falseLabel": "No",
                                            "trueColor": "inherit",
                                            "falseColor": "inherit"
                                        }
                                    },
                                    {
                                        "field": "verificationState",
                                        "title": "Verification State",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "comment",
                                        "title": "Comment",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    }
                                ]
                            }
                        }
                    }
                }
            }
        ]
    }
}
