                "y": 0,
                "w": 2,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Snapshots by Verification State",
                    "description": "",
                    "activePluginConfigIds": ["{{configId}}"],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[pbsGroupSnapshots]}}",
                        "name": "pbsGroupSnapshots",
                        "pluginConfigId": "{{configId}}",
                        "group": {
                            "by": [["verificationState", "uniqueValues"]],
                            "aggregate": [{ "type": "count" }]
