                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[VM]}}"
                    },
                    "variables": ["{{variables.[VM]}}"],
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "status[Expanded].rawState",
                                        "title": "Status",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "running": "#2BB660",
                                                "stopped": "#DE0038",
                                                "paused": "#F59E0B",
                                                "unknown": "#F59E0B"
                                            }
                                        }
                                    },
                                    {
                                        "field": "cpu",
                                        "title": "CPU Usage",
                                        "renderer": {
                                            "type": "bar",
                                            "max": 100
                                        }
                                    },
                                    {
                                        "field": "cpus",
                                        "title": "CPU Cores",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "mem",
                                        "title": "Memory Used",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "maxmem",
                                        "title": "Memory Total",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "disk",
                                        "title": "Disk Used",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "maxdisk",
                                        "title": "Disk Total",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "uptime",
                                        "title": "Uptime",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "name",
                                        "title": "Name",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "vmid",
                                        "title": "VM ID",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "netin",
                                        "title": "Network In",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "netout",
                                        "title": "Network Out",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableTranspose": true
                            }
                        }
                    }
                }
            },
