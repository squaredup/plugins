{
    "name": "taskClassifications",
    "displayName": "Task Classifications",
    "description": "Share of OpenRouter traffic by task type over the last 7 days, with each task's most used model (from OpenRouter's public rankings)",
    "tags": [
        "Models",
        "Usage"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "classifications/task",
        "paging": {
            "mode": "none"
        },
        "getArgs": [],
        "headers": [],
        "postRequestScript": "taskClassifications.js"
    },
    "matches": "none",
    "metadata": [
        {
            "name": "tag",
            "displayName": "Tag",
            "shape": "string",
            "visible": false
        },
        {
            "name": "task",
            "displayName": "Task",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "category",
            "displayName": "Category",
            "shape": "string"
        },
        {
            "name": "usageShare",
            "displayName": "Request Share",
            "shape": [
                "percent",
                {
                    "asZeroToOne": true
                }
            ],
            "role": "value"
        },
        {
            "name": "tokenShare",
            "displayName": "Token Share",
            "shape": [
                "percent",
                {
                    "asZeroToOne": true
                }
            ]
        },
        {
            "name": "topModel",
            "displayName": "Top Model",
            "shape": "string"
        },
        {
            "name": "topModelUsageShare",
            "displayName": "Top Model Share Of Task Requests",
            "shape": [
                "percent",
                {
                    "asZeroToOne": true
                }
            ]
        },
        {
            "name": "asOf",
            "displayName": "As Of",
            "shape": "date",
            "visible": false
        },
        {
            "name": "citation",
            "displayName": "Citation",
            "shape": "string",
            "visible": false
        }
    ],
    "options": {
        "minimumRequestIntervalSeconds": 86400
    },
    "timeframes": false
}
