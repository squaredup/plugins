{
    "name": "apiKeys",
    "displayName": "API Keys",
    "description": "API keys in a workspace, with spend and limits in USD (requires a management key)",
    "tags": ["API Keys", "Cost"],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "keys",
        "paging": {
            "mode": "offset",
            "offset": {
                "mode": "row",
                "rowCountIn": { "realm": "payloadArraySize", "path": "data" },
                "base": 0
            },
            "out": { "realm": "queryArg", "path": "offset" }
        },
        "getArgs": [
            { "key": "workspace_id", "value": "{{object.rawId}}" },
            { "key": "include_disabled", "value": "true" }
        ],
        "headers": [],
        "pathToData": "data"
    },
    "matches": {
        "sourceType": { "type": "oneOf", "values": ["Workspace"] }
    },
    "metadata": [
        {
            "name": "hash",
            "displayName": "Key Hash",
            "shape": "string"
        },
        {
            "name": "name",
            "displayName": "Name",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "disabled",
            "displayName": "Disabled",
            "shape": "boolean"
        },
        {
            "name": "usage_daily",
            "displayName": "Spend Today",
            "shape": "usd"
        },
        {
            "name": "usage_weekly",
            "displayName": "Spend This Week",
            "shape": "usd"
        },
        {
            "name": "usage_monthly",
            "displayName": "Spend This Month",
            "shape": "usd"
        },
        {
            "name": "usage",
            "displayName": "Total Spend",
            "shape": "usd"
        },
        {
            "name": "limit",
            "displayName": "Limit",
            "shape": "usd"
        },
        {
            "name": "limit_remaining",
            "displayName": "Limit Remaining",
            "shape": "usd"
        },
        {
            "name": "limit_reset",
            "displayName": "Limit Reset",
            "shape": "string"
        },
        {
            "name": "workspace_id",
            "displayName": "Workspace ID",
            "shape": "string"
        },
        {
            "name": "created_at",
            "displayName": "Created",
            "shape": "date"
        },
        {
            "name": "expires_at",
            "displayName": "Expires",
            "shape": "date"
        }
    ],
    "timeframes": false
}
