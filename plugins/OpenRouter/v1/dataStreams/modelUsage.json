{
    "name": "modelUsage",
    "displayName": "Model Usage",
    "description": "Spend, requests, cost per request, and tokens for each model over the timeframe, by canonical slug (requires a management key)",
    "tags": [
        "Usage",
        "Cost"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "post",
        "endpointPath": "analytics/query",
        "paging": {
            "mode": "none"
        },
        "getArgs": [],
        "headers": [],
        "postBody": "{{ (() => { const iso = (d) => new Date(d).toISOString().slice(0, 19) + 'Z'; return JSON.stringify({ metrics: ['total_usage', 'request_count', 'tokens_prompt', 'tokens_completion'], dimensions: ['model'], granularity: 'month', time_range: { start: iso(timeframe.start), end: iso(timeframe.end) } }); })() }}",
        "postRequestScript": "modelUsage.js"
    },
    "matches": "none",
    "metadata": [
        {
            "name": "slug",
            "displayName": "Model",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "spend",
            "displayName": "Spend",
            "shape": "usd",
            "role": "value"
        },
        {
            "name": "requests",
            "displayName": "Requests",
            "shape": "number"
        },
        {
            "name": "costPerRequest",
            "displayName": "Cost Per Request",
            "shape": [
                "usd",
                {
                    "decimalPlaces": 6
                }
            ]
        },
        {
            "name": "promptTokens",
            "displayName": "Prompt Tokens",
            "shape": "number"
        },
        {
            "name": "completionTokens",
            "displayName": "Completion Tokens",
            "shape": "number"
        }
    ],
    "timeframes": [
        "last12hours",
        "last24hours",
        "last7days",
        "last30days",
        "thisMonth",
        "lastMonth",
        "thisQuarter",
        "lastQuarter",
        "thisYear"
    ],
    "defaultShaping": {
        "sort": {
            "by": [
                [
                    "spend",
                    "desc"
                ]
            ]
        }
    }
}
