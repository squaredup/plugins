{
    "name": "usage",
    "displayName": "Usage",
    "description": "Spend, requests, and tokens over time, optionally grouped by model, provider, workspace, API key, or app (requires a management key)",
    "tags": [
        "Usage",
        "Cost"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "post",
        "endpointPath": "analytics/query",
        "paging": {
            "mode": "none"
        },
        "getArgs": [],
        "headers": [],
        "postBody": "{{ (() => { const iso = (d) => new Date(d).toISOString().slice(0, 19) + 'Z'; const days = (new Date(timeframe.end) - new Date(timeframe.start)) / 864e5; const granularity = days <= 2 ? 'hour' : days <= 31 ? 'day' : days <= 92 ? 'week' : 'month'; const selected = typeof filterObjects !== 'undefined' && Array.isArray(filterObjects) ? filterObjects : []; const one = (v) => (Array.isArray(v) ? v[0] : v); const idsOf = (type, ...props) => [...new Set(selected.filter((o) => one(o.sourceType) === type).flatMap((o) => props.map((p) => one(o[p]))).filter(Boolean))]; const rules = [ ['model', idsOf('Model', 'rawId', 'canonical_slug')], ['workspace', idsOf('Workspace', 'rawId')], ['api_key_id', idsOf('API Key', 'rawId')] ]; const filters = rules.filter(([, values]) => values.length).map(([field, value]) => ({ field, operator: 'in', value })); return JSON.stringify({ metrics: [typeof metric !== 'undefined' && metric ? metric : 'total_usage'], dimensions: typeof groupBy !== 'undefined' && groupBy ? [groupBy] : [], filters, granularity, time_range: { start: iso(timeframe.start), end: iso(timeframe.end) } }); })() }}",
        "postRequestScript": "usage.js"
    },
    "matches": "none",
    "ui": [
        {
            "type": "choiceChips",
            "name": "metric",
            "label": "Metric",
            "defaultValue": "total_usage",
            "validation": {
                "required": true
            },
            "options": [
                {
                    "value": "total_usage",
                    "label": "Spend (USD)"
                },
                {
                    "value": "request_count",
                    "label": "Requests"
                },
                {
                    "value": "tokens_total",
                    "label": "Total tokens"
                },
                {
                    "value": "tokens_prompt",
                    "label": "Prompt tokens"
                },
                {
                    "value": "tokens_completion",
                    "label": "Completion tokens"
                },
                {
                    "value": "reasoning_tokens",
                    "label": "Reasoning tokens"
                },
                {
                    "value": "cache_hit_rate",
                    "label": "Cache hit rate"
                }
            ]
        },
        {
            "type": "choiceChips",
            "name": "groupBy",
            "label": "Group by",
            "options": [
                {
                    "value": "model",
                    "label": "Model"
                },
                {
                    "value": "provider",
                    "label": "Provider (31 days max)"
                },
                {
                    "value": "workspace",
                    "label": "Workspace"
                },
                {
                    "value": "api_key_id",
                    "label": "API key"
                },
                {
                    "value": "app",
                    "label": "App"
                }
            ]
        },
        {
            "type": "objects",
            "name": "filterObjects",
            "label": "Filter to objects (optional)",
            "matches": {
                "sourceType": {
                    "type": "oneOf",
                    "values": [
                        "Model",
                        "Workspace",
                        "API Key"
                    ]
                }
            }
        }
    ],
    "metadata": [
        {
            "name": "date",
            "displayName": "Date",
            "shape": "date",
            "role": "timestamp"
        },
        {
            "name": "group",
            "displayName": "Group",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "value",
            "displayName": "Value",
            "shape": [
                "number",
                {
                    "decimalPlaces": 4
                }
            ],
            "role": "value"
        }
    ],
    "timeframes": [
        "last12hours",
        "last24hours",
        "last7days",
        "last30days",
        "thisMonth",
        "lastMonth",
        "thisQuarter",
        "lastQuarter",
        "thisYear"
    ],
    "defaultShaping": {
        "sort": {
            "by": [
                [
                    "date",
                    "asc"
                ]
            ]
        }
    }
}
