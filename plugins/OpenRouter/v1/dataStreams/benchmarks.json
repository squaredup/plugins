{
    "name": "benchmarks",
    "displayName": "Benchmarks",
    "description": "Model benchmark scores from Artificial Analysis, Design Arena, and OpenRouter evals (refreshed daily)",
    "tags": [
        "Models",
        "Benchmarks"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "benchmarks",
        "paging": {
            "mode": "none"
        },
        "getArgs": [
            {
                "key": "source",
                "value": "{{source || null}}"
            }
        ],
        "headers": [],
        "postRequestScript": "benchmarks.js"
    },
    "matches": "none",
    "ui": [
        {
            "type": "choiceChips",
            "name": "source",
            "label": "Source",
            "options": [
                {
                    "value": "artificial-analysis",
                    "label": "Artificial Analysis"
                },
                {
                    "value": "design-arena",
                    "label": "Design Arena"
                },
                {
                    "value": "openrouter",
                    "label": "OpenRouter evals"
                }
            ]
        }
    ],
    "metadata": [
        {
            "name": "model",
            "displayName": "Model",
            "shape": "string"
        },
        {
            "name": "modelName",
            "displayName": "Model Name",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "source",
            "displayName": "Source",
            "shape": "string"
        },
        {
            "name": "benchmark",
            "displayName": "Benchmark",
            "shape": "string"
        },
        {
            "name": "metric",
            "displayName": "Metric",
            "shape": "string"
        },
        {
            "name": "score",
            "displayName": "Score",
            "shape": [
                "number",
                {
                    "decimalPlaces": 2
                }
            ]
        },
        {
            "name": "winRate",
            "displayName": "Win Rate",
            "shape": "percent"
        },
        {
            "name": "tasks",
            "displayName": "Tasks",
            "shape": "number"
        },
        {
            "name": "avgCostPerTask",
            "displayName": "Avg Cost per Task",
            "shape": "usd"
        },
        {
            "name": "avgDurationMs",
            "displayName": "Avg Duration",
            "shape": "milliseconds"
        },
        {
            "name": "lastRun",
            "displayName": "Last Run",
            "shape": "date"
        },
        {
            "name": "asOf",
            "displayName": "As Of",
            "shape": "date",
            "visible": false
        },
        {
            "name": "citation",
            "displayName": "Citation",
            "shape": "string",
            "visible": false
        }
    ],
    "options": {
        "minimumRequestIntervalSeconds": 86400
    },
    "timeframes": false
}
