{
    "name": "credits",
    "displayName": "Credits",
    "description": "Credits purchased, used, and remaining for the account (USD)",
    "tags": ["Cost", "Billing"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "credits",
        "paging": {
            "mode": "none"
        },
        "getArgs": [],
        "headers": [],
        "pathToData": "data"
    },
    "matches": "none",
    "metadata": [
        {
            "name": "total_credits",
            "displayName": "Total Credits",
            "shape": "usd"
        },
        {
            "name": "total_usage",
            "displayName": "Total Usage",
            "shape": "usd"
        },
        {
            "name": "remaining",
            "displayName": "Remaining",
            "shape": "usd",
            "computed": true,
            "valueExpression": "{{ $['total_credits'] - $['total_usage'] }}"
        }
    ],
    "timeframes": false
}
