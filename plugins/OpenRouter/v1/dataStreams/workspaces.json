{
    "name": "workspaces",
    "displayName": "Workspaces",
    "description": "Workspaces in the OpenRouter account, with default models, logging, and budget settings (requires a management key)",
    "tags": ["Workspaces"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "workspaces",
        "paging": {
            "mode": "offset",
            "pageSize": { "realm": "queryArg", "path": "limit", "value": "100" },
            "offset": {
                "mode": "row",
                "rowCountIn": { "realm": "payloadArraySize", "path": "data" },
                "base": 0
            },
            "out": { "realm": "queryArg", "path": "offset" }
        },
        "getArgs": [],
        "headers": [],
        "postRequestScript": "workspaces.js"
    },
    "matches": "none",
    "metadata": [
        {
            "name": "id",
            "displayName": "Workspace ID",
            "shape": "string"
        },
        {
            "name": "name",
            "displayName": "Name",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "slug",
            "displayName": "Slug",
            "shape": "string"
        },
        {
            "name": "description",
            "displayName": "Description",
            "shape": "string"
        },
        {
            "name": "default_text_model",
            "displayName": "Default Text Model",
            "shape": "string"
        },
        {
            "name": "default_image_model",
            "displayName": "Default Image Model",
            "shape": "string"
        },
        {
            "name": "default_provider_sort",
            "displayName": "Default Provider Sort",
            "shape": "string"
        },
        {
            "name": "disabled_server_tools",
            "displayName": "Disabled Server Tools",
            "shape": "string"
        },
        {
            "name": "include_byok_in_budgets",
            "displayName": "BYOK In Budgets",
            "shape": "boolean"
