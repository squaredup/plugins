{
    "name": "workspaces",
    "displayName": "Workspaces",
    "description": "Workspaces in the OpenRouter account (requires a management key)",
    "tags": ["Workspaces"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "workspaces",
        "paging": {
            "mode": "offset",
            "pageSize": { "realm": "queryArg", "path": "limit", "value": "100" },
            "offset": {
                "mode": "row",
                "rowCountIn": { "realm": "payloadArraySize", "path": "data" },
                "base": 0
            },
            "out": { "realm": "queryArg", "path": "offset" }
        },
        "getArgs": [],
        "headers": [],
        "pathToData": "data"
    },
    "matches": "none",
    "metadata": [
        {
            "name": "id",
            "displayName": "Workspace ID",
            "shape": "string"
        },
        {
            "name": "name",
            "displayName": "Name",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "slug",
            "displayName": "Slug",
            "shape": "string"
        }
    ],
    "timeframes": false
}
