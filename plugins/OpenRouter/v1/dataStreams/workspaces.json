    "timeframes": false,
    "ui": [
        {
            "type": "objects",
            "name": "workspaces",
            "label": "Workspace(s)",
            "matches": {
                "sourceType": {
                    "type": "oneOf",
                    "values": [
                        "Workspace"
                    ]
                }
            }
        }
