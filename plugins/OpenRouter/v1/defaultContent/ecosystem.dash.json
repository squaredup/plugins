{
    "name": "OpenRouter Ecosystem",
    "schemaVersion": "1.5",
    "timeframe": "last30days",
    "dashboard": {
        "_type": "layout/grid",
        "columns": 6,
        "version": 1,
        "contents": [
            {
                "i": "adfbf427-f14a-479a-ba73-0992167fb17c",
                "x": 0,
                "y": 0,
                "w": 6,
                "h": 5,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Trending Apps On OpenRouter",
                    "description": "Up to 25 public apps whose tokens grew the most on OpenRouter compared with the three previous periods of the same length, sized by tokens.",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[appRankings]}}",
                        "name": "appRankings",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "rankBy": "trending"
                        },
                        "sort": {
                            "by": [
                                [
                                    "rank",
                                    "asc"
                                ]
                            ],
                            "top": 25
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "treemap",
                            "encoding": {
                                "label": {
                                    "field": "app_name",
                                    "type": "nominal",
                                    "title": "App"
                                },
                                "value": {
                                    "field": "total_tokens",
                                    "type": "quantitative",
                                    "title": "Tokens"
                                }
                            },
                            "style": {
                                "legendPosition": "none"
                            }
                        }
                    },
                    "visualisation": {
                        "type": "data-stream-bar-chart",
                        "config": {
                            "data-stream-bar-chart": {
                                "xAxisData": "app_name",
                                "yAxisData": [
                                    "total_tokens"
                                ],
                                "xAxisGroup": "none",
                                "xAxisLabel": "App",
                                "yAxisLabel": "Tokens",
                                "showXAxisLabel": true,
                                "showYAxisLabel": true,
                                "showLegend": false,
                                "legendPosition": "bottom",
                                "showGrid": true,
                                "horizontalLayout": "horizontal",
                                "displayMode": "actual",
                                "showTotals": false,
                                "showValue": false,
                                "grouping": false,
                                "range": {
                                    "type": "auto"
                                }
                            }
                        }
                    }
                }
            },
            {
                "i": "c0e54f6c-51f5-4708-be03-4b9b4fdb1c2a",
                "x": 0,
                "y": 5,
                "w": 3,
                "h": 4,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Top Apps On OpenRouter",
                    "description": "Public apps with the most tokens on OpenRouter.",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[appRankings]}}",
                        "name": "appRankings",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "rankBy": "popular"
                        },
                        "sort": {
                            "by": [
                                [
                                    "rank",
                                    "asc"
                                ]
                            ],
                            "top": 10
                        }
                    },
                    "visualisation": {
                        "type": "data-stream-bar-chart",
                        "config": {
                            "data-stream-bar-chart": {
                                "xAxisData": "app_name",
                                "yAxisData": [
                                    "total_tokens"
                                ],
                                "xAxisGroup": "none",
                                "xAxisLabel": "App",
                                "yAxisLabel": "Tokens",
                                "showXAxisLabel": true,
                                "showYAxisLabel": true,
                                "showLegend": false,
                                "legendPosition": "bottom",
                                "showGrid": true,
                                "horizontalLayout": "horizontal",
                                "displayMode": "actual",
                                "showTotals": false,
                                "showValue": false,
                                "grouping": false,
                                "range": {
                                    "type": "auto"
                                }
                            }
                        }
                    }
                }
            },
            {
                "i": "51dfb910-bec4-45ea-b9a2-683c1574f00f",
                "x": 0,
                "y": 9,
                "w": 4,
                "h": 5,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Tasks On OpenRouter",
                    "description": "By Share Of Requests",
                    "timeframe": "none",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[taskClassifications]}}",
                        "name": "taskClassifications",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [
                                [
                                    "usageShare",
                                    "desc"
                                ]
                            ]
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "treemap",
                            "encoding": {
                                "parent": {
                                    "field": "category",
                                    "type": "nominal",
                                    "title": "Category"
                                },
                                "label": {
                                    "field": "task",
                                    "type": "nominal",
                                    "title": "Task"
                                },
                                "value": {
                                    "field": "usageShare",
                                    "type": "quantitative",
                                    "title": "Request Share"
                                }
                            }
                        }
                    },
                    "visualisation": {
                        "type": "data-stream-bar-chart",
                        "config": {
                            "data-stream-bar-chart": {
                                "xAxisData": "task",
                                "yAxisData": [
                                    "usageShare"
                                ],
                                "xAxisGroup": "none",
                                "xAxisLabel": "Task",
                                "yAxisLabel": "Request Share",
                                "showXAxisLabel": true,
                                "showYAxisLabel": true,
                                "showLegend": false,
                                "legendPosition": "bottom",
                                "showGrid": true,
                                "horizontalLayout": "horizontal",
                                "displayMode": "actual",
                                "showTotals": false,
                                "showValue": false,
                                "grouping": false,
                                "range": {
                                    "type": "auto"
                                }
                            }
                        }
                    }
                }
            },
            {
                "i": "0472205a-cff6-442b-93ec-2b063b6aa157",
                "x": 4,
                "y": 9,
                "w": 2,
                "h": 5,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Request Share By Task Category",
                    "description": "",
                    "timeframe": "none",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[taskClassifications]}}",
                        "name": "taskClassifications",
                        "pluginConfigId": "{{configId}}",
                        "group": {
                            "by": [
                                [
                                    "category",
                                    "uniqueValues"
                                ]
                            ],
                            "aggregate": [
                                {
                                    "type": "sum",
                                    "names": [
                                        "usageShare"
                                    ]
                                }
                            ]
                        },
                        "sort": {
                            "by": [
                                [
                                    "usageShare_sum",
                                    "desc"
                                ]
                            ]
                        },
                        "metadata": [
                            {
                                "name": "usageShare_sum",
                                "shape": [
                                    "percent",
                                    {
                                        "asZeroToOne": true
                                    }
                                ]
                            },
                            {
                                "pattern": ".*"
                            }
                        ]
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "pie",
                            "encoding": {
                                "label": {
                                    "field": "category_uniqueValues",
                                    "type": "nominal",
                                    "title": "Category"
                                },
                                "value": {
                                    "field": "usageShare_sum",
                                    "type": "quantitative",
                                    "title": "Request Share"
                                }
                            },
                            "style": {
                                "pieInnerRadius": 55,
                                "legendPosition": "bottom"
                            }
                        }
                    },
                    "visualisation": {
                        "type": "data-stream-donut-chart",
                        "config": {
                            "data-stream-donut-chart": {
                                "valueColumn": "usageShare_sum",
                                "labelColumn": "category_uniqueValues",
                                "hideCenterValue": false,
                                "showValuesAsPercentage": true,
                                "legendPosition": "auto",
                                "legendMode": "table"
                            }
                        }
                    }
                }
            },
            {
                "i": "488c8839-874c-4a1e-a32f-5318792e4b68",
                "x": 3,
                "y": 5,
                "w": 3,
                "h": 4,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Providers By Headquarters",
                    "description": "",
                    "timeframe": "none",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[providers]}}",
                        "name": "providers",
                        "pluginConfigId": "{{configId}}",
                        "group": {
                            "by": [
                                [
                                    "headquarters",
                                    "uniqueValues"
                                ]
                            ],
                            "aggregate": [
                                {
                                    "type": "count"
                                }
                            ]
                        },
                        "sort": {
                            "by": [
                                [
                                    "count",
                                    "desc"
                                ]
                            ]
                        },
                        "filter": {
                            "multiOperation": "and",
                            "filters": [
                                {
                                    "column": "headquarters",
                                    "operation": "notempty"
                                }
                            ]
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "pie",
                            "encoding": {
                                "label": {
                                    "field": "headquarters_uniqueValues",
                                    "type": "nominal",
                                    "title": "Headquarters"
                                },
                                "value": {
                                    "field": "count",
                                    "type": "quantitative",
                                    "title": "Providers"
                                }
                            },
                            "style": {
                                "legendPosition": "bottom"
                            }
                        }
                    },
                    "visualisation": {
                        "type": "data-stream-donut-chart",
                        "config": {
                            "data-stream-donut-chart": {
                                "valueColumn": "count",
                                "labelColumn": "headquarters_uniqueValues",
                                "hideCenterValue": false,
                                "showValuesAsPercentage": true,
                                "legendPosition": "auto",
                                "legendMode": "table"
                            }
                        }
                    }
                }
            },
            {
                "i": "84870314-2f06-4a46-af2b-ca3f40bfa2f2",
                "x": 0,
                "y": 14,
                "w": 6,
                "h": 1,
                "config": {
                    "_type": "tile/text",
                    "title": "",
                    "description": "",
                    "visualisation": {
                        "config": {
                            "content": "Apps: OpenRouter ([openrouter.ai/apps](https://openrouter.ai/apps)). Tasks: OpenRouter ([openrouter.ai/rankings](https://openrouter.ai/rankings)), covering the 7 days to yesterday (UTC).  \nLicensed under CC BY 4.0.",
                            "fontSize": 12,
                            "align": "left",
                            "autoSize": true
                        }
                    }
                }
            }
        ]
    }
}
