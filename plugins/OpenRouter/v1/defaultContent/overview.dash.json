                                    "usage_monthly",
                                    "desc"
                                ]
                            ],
                            "top": 10
                        }
                    },
                    "scope": {
                        "scope": "{{scopes.[Workspaces]}}",
                        "workspace": "{{workspaceId}}"
                    },
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": [
                                    "name",
                                    "usage_monthly",
                                    "usage_weekly",
                                    "usage_daily",
                                    "usage",
                                    "limit",
                                    "limit_remaining",
                                    "limit_reset",
                                    "disabled"
                                ],
                                "hiddenColumns": [
                                    "hash",
                                    "workspace_id",
                                    "created_at",
                                    "expires_at"
                                ]
                            }
                        }
                    }
                }
            }
        ]
    }
}
