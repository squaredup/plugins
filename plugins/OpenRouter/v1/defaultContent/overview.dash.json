                "w": 4,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Model Usage",
                    "description": "",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "datastream-sql",
                        "dataSourceConfig": {
                            "version": "2.0",
                            "sql": "WITH by_slug AS (\n    SELECT\n        canonical_slug AS slug,\n        sourceId AS id,\n        name\n    FROM Models\n    QUALIFY row_number() OVER (PARTITION BY canonical_slug ORDER BY length(sourceId), sourceId) = 1\n)\nSELECT\n    m.id,\n    COALESCE(m.name, u.slug) AS name,\n    u.slug,\n    u.spend,\n    u.requests,\n    u.costPerRequest,\n    u.promptTokens,\n    u.completionTokens\nFROM Usage u\nLEFT JOIN by_slug m ON m.slug = u.slug\nORDER BY u.spend DESC",
                            "tables": [
                                {
                                    "tableName": "Usage",
                                    "config": {
                                        "activePluginConfigIds": [
                                            "{{configId}}"
                                        ],
                                        "dataStream": {
                                            "id": "{{dataStreams.[modelUsage]}}",
                                            "name": "modelUsage",
                                            "pluginConfigId": "{{configId}}"
                                        }
                                    }
                                },
                                {
                                    "tableName": "Models",
                                    "config": {
                                        "dataStream": {
                                            "id": "datastream-properties",
                                            "name": "properties"
                                        },
                                        "scope": {
                                            "scope": "{{scopes.[Models]}}",
                                            "workspace": "{{workspaceId}}"
                                        },
                                        "timeframe": "none"
                                    }
                                }
                            ]
                        },
                        "metadata": [
                            {
                                "name": "id",
                                "displayName": "Model ID",
                                "shape": "string",
                                "visible": false
                            },
                            {
                                "name": "name",
                                "displayName": "Model",
                                "shape": "string",
                                "role": "label"
                            },
                            {
                                "sourceId": "id",
                                "sourceType": "Model",
                                "name": "name"
                            },
                            {
                                "name": "slug",
                                "displayName": "Model Slug",
                                "shape": "string",
                                "visible": false
                            },
                            {
                                "name": "spend",
                                "displayName": "Spend",
                                "shape": "usd",
                                "role": "value"
                            },
                            {
                                "name": "requests",
                                "displayName": "Requests",
                                "shape": "number"
                            },
                            {
                                "name": "costPerRequest",
                                "displayName": "Cost Per Request",
                                "shape": [
                                    "usd",
                                    {
                                        "decimalPlaces": 6
                                    }
                                ]
                            },
                            {
                                "name": "promptTokens",
                                "displayName": "Prompt Tokens",
                                "shape": "number"
                            },
                            {
                                "name": "completionTokens",
                                "displayName": "Completion Tokens",
                                "shape": "number"
                            }
                        ]
                    },
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": [
                                    "name",
                                    "spend",
                                    "requests",
                                    "costPerRequest",
                                    "promptTokens",
                                    "completionTokens"
