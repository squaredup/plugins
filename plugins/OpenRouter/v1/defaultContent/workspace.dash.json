{
    "name": "Workspace",
    "schemaVersion": "1.5",
    "timeframe": "last30days",
    "variables": [
        "{{variables.[Workspace]}}"
    ],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "ff915e58-be26-44f9-ac25-6ad57c347e6e",
                "x": 0,
                "y": 0,
                "w": 1,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Properties",
                    "description": "",
                    "timeframe": "none",
                    "dataStream": {
                        "id": "datastream-properties",
                        "name": "properties"
                    },
                    "scope": {
                        "scope": "{{scopes.[Workspaces]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Workspace]}}"
                    },
                    "variables": [
                        "{{variables.[Workspace]}}"
                    ],
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": true,
                                "columnOrder": [
                                    "name",
                                    "slug"
                                ],
                                "hiddenColumns": [
                                    "id",
                                    "links",
                                    "type",
                                    "label",
                                    "sourceId",
                                    "sourceType",
                                    "sourceName",
                                    "rawId"
                                ]
                            }
                        }
                    }
                }
            },
            {
                "i": "4b027f1f-ba96-4972-af3f-5b397fb9496f",
                "x": 1,
                "y": 0,
                "w": 3,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Spend Over Time",
                    "description": "",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[usage]}}",
                        "name": "usage",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "metric": "total_usage",
                            "filterObjects": {
                                "scope": "{{scopes.[Workspaces]}}",
                                "workspace": "{{workspaceId}}",
                                "variable": "{{variables.[Workspace]}}"
                            }
                        },
                        "sort": {
                            "by": [
                                [
                                    "date",
                                    "asc"
                                ]
                            ]
                        },
                        "metadata": [
                            {
                                "name": "value",
                                "shape": [
                                    "currency",
                                    {
                                        "code": "USD",
                                        "decimalPlaces": 2
                                    }
                                ]
                            },
                            {
                                "pattern": ".*"
                            }
                        ]
                    },
                    "variables": [
                        "{{variables.[Workspace]}}"
                    ],
                    "visualisation": {
                        "type": "data-stream-line-graph",
                        "config": {
                            "data-stream-line-graph": {
                                "xAxisColumn": "date",
                                "yAxisColumn": [
                                    "value"
                                ],
                                "seriesColumn": "none",
                                "showLegend": false,
                                "legendPosition": "bottom",
                                "yAxisLabel": "Spend ($)",
                                "showYAxisLabel": true,
                                "showTrendLine": false
                            }
                        }
                    }
                }
            },
            {
                "i": "2ef51ad6-de4b-4059-a907-ea2f57b88309",
                "x": 1,
                "y": 2,
                "w": 3,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Requests Over Time",
                    "description": "",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[usage]}}",
                        "name": "usage",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "metric": "request_count",
                            "filterObjects": {
                                "scope": "{{scopes.[Workspaces]}}",
                                "workspace": "{{workspaceId}}",
                                "variable": "{{variables.[Workspace]}}"
                            }
                        },
                        "sort": {
                            "by": [
                                [
                                    "date",
                                    "asc"
                                ]
                            ]
                        },
                        "metadata": [
                            {
                                "name": "value",
                                "shape": [
                                    "number",
                                    {
                                        "decimalPlaces": 0,
                                        "thousandsSeparator": true
                                    }
                                ]
                            },
                            {
                                "pattern": ".*"
                            }
                        ]
                    },
                    "variables": [
                        "{{variables.[Workspace]}}"
                    ],
                    "visualisation": {
                        "type": "data-stream-line-graph",
                        "config": {
                            "data-stream-line-graph": {
                                "xAxisColumn": "date",
                                "yAxisColumn": [
                                    "value"
                                ],
                                "seriesColumn": "none",
                                "showLegend": false,
                                "legendPosition": "bottom",
                                "yAxisLabel": "Requests",
                                "showYAxisLabel": true,
                                "showTrendLine": false
                            }
                        }
                    }
                }
            },
            {
                "i": "98c1dbfc-ae37-4636-8ea3-8ab5ed8b56e3",
                "x": 0,
                "y": 4,
                "w": 2,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Spend By Model",
                    "description": "",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[usage]}}",
                        "name": "usage",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "metric": "total_usage",
                            "groupBy": "model",
                            "filterObjects": {
                                "scope": "{{scopes.[Workspaces]}}",
                                "workspace": "{{workspaceId}}",
                                "variable": "{{variables.[Workspace]}}"
                            }
                        },
                        "group": {
                            "by": [
                                [
                                    "group",
                                    "uniqueValues"
                                ]
                            ],
                            "aggregate": [
                                {
                                    "type": "sum",
                                    "names": [
                                        "value"
                                    ]
                                }
                            ]
                        },
                        "sort": {
                            "by": [
                                [
                                    "value_sum",
                                    "desc"
                                ]
                            ],
                            "top": 10
                        },
                        "metadata": [
                            {
                                "name": "value_sum",
                                "shape": [
                                    "currency",
                                    {
                                        "code": "USD",
                                        "decimalPlaces": 2
                                    }
                                ]
                            },
                            {
                                "pattern": ".*"
                            }
                        ]
                    },
                    "variables": [
                        "{{variables.[Workspace]}}"
                    ],
                    "visualisation": {
                        "type": "data-stream-bar-chart",
                        "config": {
                            "data-stream-bar-chart": {
                                "xAxisData": "group_uniqueValues",
                                "yAxisData": [
                                    "value_sum"
                                ],
                                "xAxisGroup": "none",
                                "xAxisLabel": "Model",
                                "yAxisLabel": "Spend ($)",
                                "showXAxisLabel": true,
                                "showYAxisLabel": true,
                                "showLegend": false,
                                "legendPosition": "bottom",
                                "showGrid": true,
                                "horizontalLayout": "horizontal",
                                "displayMode": "actual",
                                "showTotals": false,
                                "showValue": false,
                                "grouping": false,
                                "range": {
                                    "type": "auto"
                                }
                            }
                        }
                    }
                }
            },
            {
                "i": "4d208d06-5051-4bfe-8834-ddef5b530eac",
                "x": 2,
                "y": 4,
                "w": 2,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Spend By API Key",
                    "description": "",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[usage]}}",
                        "name": "usage",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "metric": "total_usage",
                            "groupBy": "api_key_id",
                            "filterObjects": {
                                "scope": "{{scopes.[Workspaces]}}",
                                "workspace": "{{workspaceId}}",
                                "variable": "{{variables.[Workspace]}}"
                            }
                        },
                        "group": {
                            "by": [
                                [
                                    "group",
                                    "uniqueValues"
                                ]
                            ],
                            "aggregate": [
                                {
                                    "type": "sum",
                                    "names": [
                                        "value"
                                    ]
                                }
                            ]
                        },
                        "sort": {
                            "by": [
                                [
                                    "value_sum",
                                    "desc"
                                ]
                            ],
                            "top": 10
                        },
                        "metadata": [
                            {
                                "name": "value_sum",
                                "shape": [
                                    "currency",
                                    {
                                        "code": "USD",
                                        "decimalPlaces": 2
                                    }
                                ]
                            },
                            {
                                "pattern": ".*"
                            }
                        ]
                    },
                    "variables": [
                        "{{variables.[Workspace]}}"
                    ],
                    "visualisation": {
                        "type": "data-stream-donut-chart",
                        "config": {
                            "data-stream-donut-chart": {
                                "valueColumn": "value_sum",
                                "labelColumn": "group_uniqueValues",
                                "hideCenterValue": false,
                                "showValuesAsPercentage": true,
                                "legendPosition": "auto",
                                "legendMode": "table"
                            }
                        }
                    }
                }
            },
            {
                "i": "34c93f18-f42c-442f-bd08-2bfba9a897d0",
                "x": 0,
                "y": 7,
                "w": 4,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "API Keys",
                    "description": "",
                    "timeframe": "none",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[apiKeys]}}",
                        "name": "apiKeys",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [
                                [
                                    "usage_monthly",
                                    "desc"
                                ]
                            ]
                        }
                    },
                    "scope": {
                        "scope": "{{scopes.[Workspaces]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Workspace]}}"
                    },
                    "variables": [
                        "{{variables.[Workspace]}}"
                    ],
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": [
                                    "name",
                                    "usage_monthly",
                                    "usage_weekly",
                                    "usage_daily",
                                    "usage",
                                    "limit",
                                    "limit_remaining",
                                    "limit_reset",
                                    "disabled"
                                ],
                                "hiddenColumns": [
                                    "hash",
                                    "workspace_id",
                                    "created_at",
                                    "expires_at"
                                ]
                            }
                        }
                    }
                }
            }
        ]
    }
}
