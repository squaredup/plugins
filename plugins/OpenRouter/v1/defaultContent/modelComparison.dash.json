                "x": 0,
                "y": 7,
                "w": 3,
                "h": 3,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Most Used Models On OpenRouter",
                    "description": "",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[rankings]}}",
                        "name": "rankings",
                        "pluginConfigId": "{{configId}}",
                        "filter": {
                            "multiOperation": "and",
                            "filters": [
                                {
                                    "column": "model_permaslug",
                                    "operation": "notequals",
                                    "value": "other"
                                }
                            ]
                        },
                        "group": {
                            "by": [
                                [
                                    "model_permaslug",
                                    "uniqueValues"
                                ]
                            ],
                            "aggregate": [
                                {
                                    "type": "sum",
                                    "names": [
                                        "total_tokens"
                                    ]
                                }
                            ]
                        },
                        "sort": {
                            "by": [
                                [
                                    "total_tokens_sum",
                                    "desc"
                                ]
                            ],
                            "top": 10
                        },
                        "metadata": [
                            {
                                "name": "total_tokens_sum",
                                "shape": [
                                    "number",
                                    {
                                        "decimalPlaces": 0,
                                        "thousandsSeparator": true
                                    }
                                ]
                            },
                            {
                                "pattern": ".*"
                            }
                        ]
                    },
                    "visualisation": {
                        "type": "data-stream-bar-chart",
                        "config": {
                            "data-stream-bar-chart": {
                                "xAxisData": "model_permaslug_uniqueValues",
