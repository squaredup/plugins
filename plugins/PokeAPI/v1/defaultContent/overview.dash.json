                        "pluginConfigId": "{{configId}}",
                        "group": {
                            "by": [
                                [
                                    "generationName",
                                    "uniqueValues"
                                ],
                                [
                                    "generationId",
                                    "uniqueValues"
                                ]
                            ],
                            "aggregate": [
                                {
                                    "type": "count"
                                }
                            ]
                        },
                        "sort": {
                            "by": [
                                [
                                    "generationId_uniqueValues",
                                    "asc"
                                ]
