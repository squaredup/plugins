{
    "name": "pokemonByType",
    "displayName": "Pokémon by Type",
    "description": "Pokémon that have a type, with whether it is their primary or secondary type",
    "tags": ["Type", "Pokémon"],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/type/{{object.rawId}}",
        "postRequestScript": "pokemonByType.js"
    },
    "matches": { "sourceType": { "type": "oneOf", "values": ["Pokemon Type"] } },
    "timeframes": false,
    "defaultShaping": { "sort": { "by": [["pokedexNumber", "asc"]] } },
    "metadata": [
        { "name": "typeId", "displayName": "Type ID", "shape": "string", "visible": false },
        { "name": "typeName", "displayName": "Type", "shape": "string" },
        { "name": "pokemonId", "displayName": "Pokémon ID", "shape": "string", "sourceType": "Pokemon", "visible": false },
        { "name": "pokemonName", "displayName": "Pokémon", "shape": "string", "role": "label", "sourceId": "pokemonId", "sourceType": "Pokemon", "objectPropertyPath": "name" },
        { "name": "pokedexNumber", "displayName": "Pokédex No.", "shape": ["number", { "thousandsSeparator": false }] },
        { "name": "slot", "displayName": "Slot", "shape": "string" },
        { "sourceId": "pokemonId", "sourceType": "Pokemon", "name": "pokemonName" }
    ]
}
