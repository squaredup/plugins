{
    "name": "typeMatchups",
    "displayName": "Type Matchups",
    "description": "Damage multipliers a type deals to and takes from every other type",
    "tags": ["Type"],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/type/{{object.rawId}}",
        "postRequestScript": "typeMatchups.js"
    },
    "matches": { "sourceType": { "type": "oneOf", "values": ["Pokemon Type"] } },
    "timeframes": false,
    "defaultShaping": { "sort": { "by": [["direction", "asc"], ["multiplier", "desc"]] } },
    "metadata": [
        { "name": "typeId", "displayName": "Type ID", "shape": "string", "visible": false },
        { "name": "typeName", "displayName": "Type", "shape": "string", "role": "label" },
        { "name": "direction", "displayName": "Direction", "shape": "string" },
        { "name": "multiplier", "displayName": "Multiplier", "shape": ["number", { "decimalPlaces": 1 }], "role": "value" },
        { "name": "effectiveness", "displayName": "Effectiveness", "shape": "string" },
        { "name": "relation", "displayName": "Relation", "shape": "string" },
        { "name": "otherTypeId", "displayName": "Other Type ID", "shape": "string", "visible": false },
        { "name": "otherTypeName", "displayName": "Other Type", "shape": "string" },
        { "sourceId": "otherTypeId", "sourceType": "Pokemon Type", "name": "otherTypeName" }
    ]
}
