{
    "name": "pokemonProfile",
    "displayName": "Pokémon Profile",
    "description": "Types, size, abilities, base stat total and artwork for a Pokémon",
    "tags": ["Pokémon"],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/pokemon/{{object.rawId}}",
        "postRequestScript": "pokemonProfile.js"
    },
    "matches": { "sourceType": { "type": "oneOf", "values": ["Pokemon"] } },
    "timeframes": false,
    "metadata": [
        { "name": "pokemonId", "displayName": "ID", "shape": "string", "visible": false },
        { "sourceId": "pokemonId", "sourceType": "Pokemon", "name": "pokemonName" },
        { "name": "pokemonName", "displayName": "Pokémon", "shape": "string", "role": "label" },
        { "name": "pokedexNumber", "displayName": "Pokédex No.", "shape": ["number", { "thousandsSeparator": false }] },
        { "name": "primaryType", "displayName": "Primary Type", "shape": "string" },
        { "name": "secondaryType", "displayName": "Secondary Type", "shape": "string" },
        { "name": "types", "displayName": "Types", "shape": "string" },
        { "name": "heightM", "displayName": "Height (m)", "shape": ["number", { "decimalPlaces": 1 }] },
        { "name": "weightKg", "displayName": "Weight (kg)", "shape": ["number", { "decimalPlaces": 1 }] },
        { "name": "baseExperience", "displayName": "Base Experience", "shape": "number" },
        { "name": "abilities", "displayName": "Abilities", "shape": "string" },
        { "name": "hiddenAbility", "displayName": "Hidden Ability", "shape": "string" },
        { "name": "statTotal", "displayName": "Base Stat Total", "shape": "number", "role": "value" },
        { "name": "artworkUrl", "displayName": "Artwork", "shape": ["url", { "label": "Official artwork" }] },
        { "name": "spriteUrl", "displayName": "Sprite", "shape": ["url", { "label": "Sprite" }] },
        { "name": "cryUrl", "displayName": "Cry", "shape": ["url", { "label": "Cry" }] }
    ]
}
