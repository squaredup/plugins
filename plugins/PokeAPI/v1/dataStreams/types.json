{
    "name": "types",
    "displayName": "Types",
    "description": "Pokémon battle types (excludes Stellar, Unknown and Shadow, which have no Pokémon)",
    "tags": ["Pokémon", "Type"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/type",
        "getArgs": [{ "key": "limit", "value": "100" }],
        "postRequestScript": "types.js"
    },
    "matches": "none",
    "timeframes": false,
    "visibility": { "type": "hidden" },
    "metadata": [
        { "name": "url", "displayName": "URL", "shape": "url", "visible": false },
        { "name": "name", "displayName": "Slug", "shape": "string", "visible": false },
        {
            "name": "id",
            "displayName": "ID",
            "shape": "string",
            "role": "id",
            "computed": true,
            "valueExpression": "{{ $['url'].split('/').filter(Boolean).pop() }}"
        },
        {
            "name": "typeName",
            "displayName": "Type",
            "shape": "string",
            "role": "label",
            "computed": true,
            "valueExpression": "{{ $['name'].charAt(0).toUpperCase() + $['name'].slice(1) }}"
        }
    ]
}
