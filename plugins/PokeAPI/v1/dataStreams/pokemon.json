{
    "name": "pokemon",
    "displayName": "Pokémon",
    "description": "Every Pokémon species in the National Pokédex",
    "tags": ["Pokémon"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/pokemon-species",
        "pathToData": "results",
        "paging": {
            "mode": "nextUrl",
            "pageSize": { "realm": "queryArg", "path": "limit", "value": "200" },
            "in": { "realm": "payload", "path": "next" }
        }
    },
    "matches": "none",
    "timeframes": false,
    "visibility": { "type": "hidden" },
    "metadata": [
        { "name": "url", "displayName": "URL", "shape": "url", "visible": false },
        { "name": "name", "displayName": "Slug", "shape": "string", "visible": false },
        {
            "name": "id",
            "displayName": "Pokédex No.",
            "shape": "string",
            "role": "id",
            "computed": true,
            "valueExpression": "{{ $['url'].split('/').filter(Boolean).pop() }}"
        },
        {
            "name": "pokemonName",
            "displayName": "Pokémon",
            "shape": "string",
            "role": "label",
            "computed": true,
            "valueExpression": "{{ $['name'].split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ') }}"
        }
    ]
}
