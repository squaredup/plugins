{
    "name": "generationSummary",
    "displayName": "Generation Summary",
    "description": "Main region, games and the number of species, moves, abilities and types a generation introduced",
    "tags": ["Generation"],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/generation/{{object.rawId}}",
        "postRequestScript": "generationSummary.js"
    },
    "matches": { "sourceType": { "type": "oneOf", "values": ["Pokemon Generation"] } },
    "timeframes": false,
    "metadata": [
        { "name": "generationId", "displayName": "Generation ID", "shape": "string", "visible": false },
        {
            "name": "generationName",
            "displayName": "Generation",
            "shape": "string",
            "role": "label"
        },
        { "name": "region", "displayName": "Region", "shape": "string" },
        { "name": "games", "displayName": "Games", "shape": "string" },
        { "name": "newSpecies", "displayName": "New Species", "shape": "number", "role": "value" },
        { "name": "newMoves", "displayName": "New Moves", "shape": "number" },
        { "name": "newAbilities", "displayName": "New Abilities", "shape": "number" },
        { "name": "newTypes", "displayName": "New Types", "shape": "number" },
        { "name": "typesIntroduced", "displayName": "Types Introduced", "shape": "string" },
        { "sourceId": "generationId", "sourceType": "Pokemon Generation", "name": "generationName" }
    ]
}
