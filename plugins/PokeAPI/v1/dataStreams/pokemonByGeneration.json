{
    "name": "pokemonByGeneration",
    "displayName": "Pokémon by Generation",
    "description": "Pokémon species introduced in a generation",
    "tags": ["Generation", "Pokémon"],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/generation/{{object.rawId}}",
        "postRequestScript": "pokemonByGeneration.js"
    },
    "matches": { "sourceType": { "type": "oneOf", "values": ["Pokemon Generation"] } },
    "timeframes": false,
    "defaultShaping": { "sort": { "by": [["pokedexNumber", "asc"]] } },
    "metadata": [
        { "name": "generationId", "displayName": "Generation ID", "shape": "string", "visible": false },
        { "name": "generationName", "displayName": "Generation", "shape": "string" },
        { "name": "pokemonId", "displayName": "Pokémon ID", "shape": "string", "visible": false },
        { "name": "pokemonName", "displayName": "Pokémon", "shape": "string", "role": "label" },
        { "name": "pokedexNumber", "displayName": "Pokédex No.", "shape": ["number", { "thousandsSeparator": false }] },
        { "sourceId": "pokemonId", "sourceType": "Pokemon", "name": "pokemonName" }
    ]
}
