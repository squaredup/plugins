{
    "name": "pokemonMoves",
    "displayName": "Pokémon Moves",
    "description": "Moves a Pokémon can learn in the most recent game it appears in, with learn method and level",
    "tags": ["Pokémon", "Moves"],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/pokemon/{{object.rawId}}",
        "postRequestScript": "pokemonMoves.js"
    },
    "matches": { "sourceType": { "type": "oneOf", "values": ["Pokemon"] } },
    "timeframes": false,
    "defaultShaping": { "sort": { "by": [["learnMethod", "asc"], ["level", "asc"]] } },
    "metadata": [
        { "name": "pokemonId", "displayName": "Pokédex No.", "shape": "string", "visible": false },
        { "sourceId": "pokemonId", "sourceType": "Pokemon", "name": "pokemonName" },
        { "name": "pokemonName", "displayName": "Pokémon", "shape": "string" },
        { "name": "move", "displayName": "Move", "shape": "string", "role": "label" },
        { "name": "learnMethod", "displayName": "Learn Method", "shape": "string" },
        { "name": "level", "displayName": "Level", "shape": ["number", { "decimalPlaces": 0 }] },
        { "name": "game", "displayName": "Game", "shape": "string" }
    ]
}
