{
    "name": "pokemonStats",
    "displayName": "Pokémon Stats",
    "description": "Base stats and effort value yield for a Pokémon, one row per stat",
    "tags": ["Pokémon", "Stats"],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/pokemon/{{object.rawId}}",
        "postRequestScript": "pokemonStats.js"
    },
    "matches": { "sourceType": { "type": "oneOf", "values": ["Pokemon"] } },
    "timeframes": false,
    "defaultShaping": { "sort": { "by": [["statOrder", "asc"]] } },
    "metadata": [
        { "name": "pokemonId", "displayName": "Pokédex No.", "shape": "string", "visible": false },
        { "name": "pokemonName", "displayName": "Pokémon", "shape": "string" },
        { "name": "stat", "displayName": "Stat", "shape": "string", "role": "label" },
        { "name": "statOrder", "displayName": "Stat Order", "shape": "number", "visible": false },
        { "name": "baseStat", "displayName": "Base Stat", "shape": ["number", { "decimalPlaces": 0 }], "role": "value" },
        { "name": "effortYield", "displayName": "EV Yield", "shape": ["number", { "decimalPlaces": 0 }] },
        { "sourceId": "pokemonId", "sourceType": "Pokemon", "name": "pokemonName" }
    ]
}
