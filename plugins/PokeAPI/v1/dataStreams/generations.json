{
    "name": "generations",
    "displayName": "Generations",
    "description": "Pokémon game generations, from Generation I onwards",
    "tags": ["Pokémon", "Generation"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "/generation",
        "getArgs": [{ "key": "limit", "value": "100" }],
        "pathToData": "results"
    },
    "matches": "none",
    "timeframes": false,
    "visibility": { "type": "hidden" },
    "metadata": [
        { "name": "url", "displayName": "URL", "shape": "url", "visible": false },
        { "name": "name", "displayName": "Slug", "shape": "string", "visible": false },
        {
            "name": "id",
            "displayName": "ID",
            "shape": "string",
            "role": "id",
            "computed": true,
            "valueExpression": "{{ $['url'].split('/').filter(Boolean).pop() }}"
        },
        {
            "name": "generationName",
            "displayName": "Generation",
            "shape": "string",
            "role": "label",
            "computed": true,
            "valueExpression": "{{ 'Generation ' + $['name'].split('-').pop().toUpperCase() }}"
        }
    ]
}
