{
    "name": "domains",
    "displayName": "Domains",
    "description": "Protected domains with their SaaS Protection customer, licence usage and 24-hour backup coverage",
    "tags": ["Backup"],
    "baseDataSourceName": "httpRequestUnscoped",
    "matches": "none",
    "timeframes": false,
    "config": {
        "httpMethod": "get",
        "endpointPath": "v1/saas/domains",
        "expandInnerObjects": true,
        "paging": { "mode": "none" }
    },
    "defaultShaping": {
        "sort": {
            "by": [["backupStats.backupPercentage", "asc"]]
        }
    },
    "metadata": [
        { "name": "saasCustomerName", "displayName": "Customer", "shape": "string", "role": "label" },
        { "name": "domain", "displayName": "Domain", "shape": "string" },
        { "name": "backupStats.backupPercentage", "displayName": "Backed Up (24h)", "shape": ["percent", { "decimalPlaces": 1 }] },
        { "name": "backupStats.activeServicesWithRecentBackupCount", "displayName": "Services Backed Up", "shape": "number" },
        { "name": "backupStats.activeServicesCount", "displayName": "Active Services", "shape": "number" },
        { "name": "seatsUsed", "displayName": "Licensed Seats", "shape": "number" },
        { "name": "productType", "displayName": "Product", "shape": "string" },
        { "name": "retentionType", "displayName": "Retention", "shape": "string" },
        { "name": "organizationName", "displayName": "Organization", "shape": "string" },
        { "name": "externalSubscriptionId", "displayName": "Subscription ID", "shape": "string", "visible": false },
        { "name": "saasCustomerId", "displayName": "Customer ID", "shape": "string", "visible": false },
        { "name": "organizationId", "displayName": "Organization ID", "shape": "string", "visible": false },
        { "sourceId": "saasCustomerId", "sourceType": "SaaS Customer", "name": "saasCustomerName" },
        { "pattern": ".*" }
    ]
}
