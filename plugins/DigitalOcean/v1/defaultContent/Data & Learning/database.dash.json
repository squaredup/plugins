{
    "name": "Database",
    "schemaVersion": "1.5",
    "timeframe": "last24hours",
    "variables": [
        "{{variables.[Database]}}"
    ],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "501e43ab-f2fe-49d6-a444-c048cc34fc1c",
                "x": 0,
                "y": 0,
                "w": 1,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Properties",
                    "description": "Imported properties of this database cluster",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "datastream-properties",
                        "name": "properties"
                    },
                    "timeframe": "none",
                    "scope": {
                        "scope": "{{scopes.[Databases]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Database]}}"
                    },
                    "variables": [
                        "{{variables.[Database]}}"
                    ],
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": true
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "name",
                                        "title": "Name",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "status",
                                        "title": "Status",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "online": "#22C55E",
                                                "creating": "#F59E0B",
                                                "resizing": "#F59E0B",
                                                "migrating": "#F59E0B",
                                                "forking": "#F59E0B"
                                            },
                                            "defaultColor": "#94A3B8"
                                        }
                                    },
                                    {
                                        "field": "engine",
                                        "title": "Engine",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "pg": "#336791",
                                                "mysql": "#00758F",
                                                "redis": "#DC382D",
                                                "valkey": "#6E2DD4",
                                                "mongodb": "#47A248",
                                                "kafka": "#231F20",
                                                "opensearch": "#005EB8"
                                            },
                                            "defaultColor": "#475569"
                                        }
                                    },
                                    {
                                        "field": "version",
                                        "title": "Version",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "region",
                                        "title": "Region",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "size",
                                        "title": "Size",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "numNodes",
                                        "title": "Nodes",
                                        "renderer": {
                                            "type": "number"
                                        }
                                    },
                                    {
                                        "field": "tagList",
                                        "title": "Tags",
                                        "renderer": {
                                            "type": "tag-list",
                                            "color": "#334155"
                                        }
                                    },
                                    {
                                        "field": "createdAt",
                                        "title": "Created",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableTranspose": true,
                                "richTableCellPadding": 4,
                                "richTableFontSize": 13
                            }
                        }
                    }
                }
            },
            {
                "i": "94aa487f-877e-4f72-88e3-0ebf79a80aaf",
