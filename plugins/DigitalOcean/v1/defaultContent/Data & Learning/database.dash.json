                                    "type": "nominal"
                                },
                                "status": {
                                    "field": "status",
                                    "type": "nominal"
                                }
                            },
                            "style": {
                                "statusGridColumnsPerRow": 1,
                                "statusGridSecondaryTemplate": "{{status}}",
                                "statusGridLabelWrap": true,
                                "mappedColors": {
                                    "online": "#22C55E",
                                    "creating": "#F59E0B",
                                    "resizing": "#F59E0B",
                                    "migrating": "#F59E0B",
                                    "forking": "#F59E0B"
                                }
                            }
                        }
                    }
