                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Invoice History",
                    "description": "Amount of the last 12 issued invoices by billing period, oldest to newest",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[invoices]}}",
                        "name": "invoices",
                        "pluginConfigId": "{{configId}}",
                        "sql": "SELECT \"invoice_period\", \"amount\" FROM (SELECT \"invoice_period\", \"amount\" FROM \"dataset\" WHERE NOT \"preview\" ORDER BY \"invoice_period\" DESC LIMIT 12) ORDER BY \"invoice_period\" ASC"
                    },
                    "timeframe": "none",
                    "visualisation": {
                        "type": "data-stream-bar-chart",
                        "config": {
                            "data-stream-bar-chart": {
                                "xAxisData": "invoice_period",
                                "yAxisData": [
                                    "amount"
                                ],
                                "xAxisGroup": "none",
                                "xAxisLabel": "",
                                "yAxisLabel": "Amount (USD)",
                                "showXAxisLabel": false,
                                "showYAxisLabel": true,
                                "showLegend": false,
                                "legendPosition": "bottom",
                                "showGrid": true,
                                "horizontalLayout": "vertical",
                                "displayMode": "actual",
                                "showTotals": false,
                                "showValue": false,
                                "grouping": false,
                                "range": {
                                    "type": "auto"
                                }
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "invoice_period",
                                    "type": "ordinal",
                                    "title": "Billing Period"
                                },
                                "y": {
                                    "field": "amount",
                                    "type": "quantitative",
                                    "title": "Amount (USD)"
