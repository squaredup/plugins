                                    "type": "average",
                                    "label": "Average",
                                    "color": "#94A3B8"
                                }
                            ],
                            "style": {
                                "cartesianBarBorderRadius": 6,
                                "colors": [
                                    "#8B5CF6"
                                ],
                                "cartesianXAxisLabelRotation": -45,
                                "cartesianShowVerticalGridLines": false
                            }
                        }
                    }
                }
            },
            {
                "i": "5739c63a-5962-45d2-96ec-3bbe6bc86033",
                "x": 2,
                "y": 8,
                "w": 2,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Invoices",
                    "description": "Issued invoices and the current month's preview",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[invoices]}}",
                        "name": "invoices",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [
                                [
                                    "invoice_period",
                                    "desc"
                                ]
                            ]
                        }
                    },
                    "timeframe": "none",
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": [
                                    "invoice_period",
                                    "invoice_id",
                                    "amount",
                                    "preview",
                                    "updated_at"
                                ],
                                "hiddenColumns": [
                                    "invoice_uuid"
                                ]
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "invoice_period",
                                        "title": "Period",
                                        "renderer": {
                                            "type": "text"
                                        },
                                        "width": 90
                                    },
                                    {
                                        "field": "invoice_id",
                                        "title": "Invoice",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "amount",
                                        "title": "Amount",
                                        "renderer": {
                                            "type": "number",
                                            "prefix": "$",
                                            "decimals": 2
                                        },
                                        "align": "right"
                                    },
                                    {
                                        "field": "preview",
                                        "title": "Status",
                                        "renderer": {
                                            "type": "boolean",
                                            "trueLabel": "Preview",
                                            "falseLabel": "Issued",
                                            "trueColor": "#F59E0B",
                                            "falseColor": "#22C55E"
                                        }
                                    },
                                    {
                                        "field": "updated_at",
                                        "title": "Updated",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableSort": {
                                    "field": "invoice_period",
                                    "direction": "desc"
                                },
                                "richTableCellPadding": 5
                            }
                        }
                    }
