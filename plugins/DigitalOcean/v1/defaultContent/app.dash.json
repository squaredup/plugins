{
    "name": "App",
    "schemaVersion": "1.5",
    "timeframe": "last24hours",
    "variables": [
        "{{variables.[App]}}"
    ],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "b80895a6-9a87-4ee8-9b05-f4a6fe79805f",
                "x": 0,
                "y": 0,
                "w": 1,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Properties",
                    "description": "Imported properties of this app",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "datastream-properties",
                        "name": "properties"
                    },
                    "timeframe": "none",
                    "scope": {
                        "scope": "{{scopes.[Apps]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[App]}}"
                    },
                    "variables": [
                        "{{variables.[App]}}"
                    ],
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": true
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "name",
                                        "title": "Name",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "activeDeploymentPhase",
                                        "title": "Active Deployment",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "ACTIVE": "#22C55E",
                                                "ERROR": "#EF4444",
                                                "CANCELED": "#EF4444",
                                                "PENDING_BUILD": "#F59E0B",
                                                "BUILDING": "#F59E0B",
                                                "PENDING_DEPLOY": "#F59E0B",
                                                "DEPLOYING": "#F59E0B",
                                                "SUPERSEDED": "#94A3B8",
                                                "UNKNOWN": "#94A3B8"
                                            },
                                            "defaultColor": "#94A3B8"
                                        }
                                    },
                                    {
                                        "field": "region",
                                        "title": "Region",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "tier",
                                        "title": "Tier",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "liveUrl",
                                        "title": "Live URL",
                                        "renderer": {
                                            "type": "link"
                                        }
                                    },
                                    {
                                        "field": "lastDeploymentAt",
                                        "title": "Last Deployment",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    },
                                    {
                                        "field": "createdAt",
                                        "title": "Created",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableTranspose": true,
                                "richTableCellPadding": 4,
                                "richTableFontSize": 13
                            }
                        }
                    }
                }
            },
            {
                "i": "cc195425-66de-4256-a44c-381be6ea79f1",
                "x": 1,
                "y": 0,
                "w": 3,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Component Health",
                    "description": "Health of each component, with CPU and memory usage",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[appHealth]}}",
                        "name": "appHealth",
                        "pluginConfigId": "{{configId}}"
                    },
                    "timeframe": "none",
                    "scope": {
                        "scope": "{{scopes.[Apps]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[App]}}"
                    },
                    "variables": [
                        "{{variables.[App]}}"
                    ],
                    "visualisation": {
                        "type": "data-stream-blocks",
                        "config": {
                            "data-stream-blocks": {
                                "labelColumn": "name",
                                "stateColumn": "health",
                                "linkColumn": "none",
                                "columns": 3,
                                "sublabel": "state"
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "statusGrid",
                            "encoding": {
                                "label": {
                                    "field": "name",
                                    "type": "nominal"
                                },
                                "status": {
                                    "field": "health",
                                    "type": "nominal"
                                }
                            },
                            "style": {
                                "statusGridColumnsPerRow": 3,
                                "statusGridMaxBlockHeight": 140,
                                "statusGridLabelWrap": true,
                                "statusGridSecondaryTemplate": "{{replicas_ready}}/{{replicas_desired}} ready · CPU {{cpu_usage_percent}} · Mem {{memory_usage_percent}}",
                                "statusGridOrderByField": "name",
                                "statusGridOrderDirection": "asc"
                            }
                        }
                    }
                }
            },
            {
                "i": "741fc7aa-3c23-46e9-866e-5f32c6bb6aa8",
                "x": 0,
                "y": 3,
                "w": 2,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "CPU Usage",
                    "description": "CPU usage of each component instance",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[appMetrics]}}",
                        "name": "appMetrics",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "metric": "cpu_percentage"
                        },
                        "sort": {
                            "by": [
                                [
                                    "timestamp",
                                    "asc"
                                ]
                            ]
                        }
                    },
                    "scope": {
                        "scope": "{{scopes.[Apps]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[App]}}"
                    },
                    "variables": [
                        "{{variables.[App]}}"
                    ],
                    "visualisation": {
                        "type": "data-stream-line-graph",
                        "config": {
                            "data-stream-line-graph": {
                                "xAxisColumn": "timestamp",
                                "yAxisColumn": [
                                    "value"
                                ],
                                "seriesColumn": "instance",
                                "showLegend": true,
                                "legendPosition": "bottom",
                                "yAxisLabel": "CPU (%)",
                                "showYAxisLabel": true,
                                "showTrendLine": false
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "line",
                            "encoding": {
                                "x": {
                                    "field": "timestamp",
                                    "type": "temporal",
                                    "title": "Time"
                                },
                                "y": {
                                    "field": "value",
                                    "type": "quantitative",
                                    "title": "CPU (%)"
                                },
                                "series": {
                                    "field": "instance",
                                    "type": "nominal"
                                }
                            },
                            "markLines": [
                                {
                                    "value": 80,
                                    "label": "80%",
                                    "color": "#EF4444"
                                }
                            ],
                            "style": {
                                "cartesianAreaGradient": true,
                                "cartesianSmooth": true,
                                "cartesianSymbol": "none",
                                "cartesianLineWidth": 2,
                                "cartesianYAxisRangeMode": "percentage",
                                "colors": [
                                    "#0069FF",
                                    "#8B5CF6",
                                    "#06B6D4",
                                    "#EC4899",
                                    "#F59E0B"
                                ],
                                "legendPosition": "bottom",
                                "cartesianShowVerticalGridLines": false
                            }
                        }
                    }
                }
            },
            {
                "i": "4853bc76-d458-4736-b1b5-35faca6d9608",
                "x": 2,
                "y": 3,
                "w": 2,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Memory Usage",
                    "description": "Memory usage of each component instance",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[appMetrics]}}",
                        "name": "appMetrics",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "metric": "memory_percentage"
                        },
                        "sort": {
                            "by": [
                                [
                                    "timestamp",
                                    "asc"
                                ]
                            ]
                        }
                    },
                    "scope": {
                        "scope": "{{scopes.[Apps]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[App]}}"
                    },
                    "variables": [
                        "{{variables.[App]}}"
                    ],
                    "visualisation": {
                        "type": "data-stream-line-graph",
                        "config": {
                            "data-stream-line-graph": {
                                "xAxisColumn": "timestamp",
                                "yAxisColumn": [
                                    "value"
                                ],
                                "seriesColumn": "instance",
                                "showLegend": true,
                                "legendPosition": "bottom",
                                "yAxisLabel": "Memory (%)",
                                "showYAxisLabel": true,
                                "showTrendLine": false
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "line",
                            "encoding": {
                                "x": {
                                    "field": "timestamp",
                                    "type": "temporal",
                                    "title": "Time"
                                },
                                "y": {
                                    "field": "value",
                                    "type": "quantitative",
                                    "title": "Memory (%)"
                                },
                                "series": {
                                    "field": "instance",
                                    "type": "nominal"
                                }
                            },
                            "markLines": [
                                {
                                    "value": 80,
                                    "label": "80%",
                                    "color": "#EF4444"
                                }
                            ],
                            "style": {
                                "cartesianAreaGradient": true,
                                "cartesianSmooth": true,
                                "cartesianSymbol": "none",
                                "cartesianLineWidth": 2,
                                "cartesianYAxisRangeMode": "percentage",
                                "colors": [
                                    "#14B8A6",
                                    "#6366F1",
                                    "#10B981",
                                    "#3B82F6",
                                    "#EC4899"
                                ],
                                "legendPosition": "bottom",
                                "cartesianShowVerticalGridLines": false
                            }
                        }
                    }
                }
            },
            {
                "i": "5c01dd34-6693-41f0-b59a-7a149c2c5ac2",
                "x": 0,
                "y": 5,
                "w": 4,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Recent Deployments",
                    "description": "The 50 most recent deployments of this app",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[appDeployments]}}",
                        "name": "appDeployments",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [
                                [
                                    "created_at",
                                    "desc"
                                ]
                            ]
                        }
                    },
                    "timeframe": "none",
                    "scope": {
                        "scope": "{{scopes.[Apps]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[App]}}"
                    },
                    "variables": [
                        "{{variables.[App]}}"
                    ],
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": [
                                    "created_at",
                                    "health",
                                    "phase",
                                    "cause",
                                    "phase_last_updated_at",
                                    "updated_at"
                                ],
                                "hiddenColumns": [
                                    "id"
                                ]
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "created_at",
                                        "title": "Created",
                                        "renderer": {
                                            "type": "date"
                                        },
                                        "width": 170
                                    },
                                    {
                                        "field": "phase",
                                        "title": "Phase",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "ACTIVE": "#22C55E",
                                                "ERROR": "#EF4444",
                                                "CANCELED": "#EF4444",
                                                "PENDING_BUILD": "#F59E0B",
                                                "BUILDING": "#F59E0B",
                                                "PENDING_DEPLOY": "#F59E0B",
                                                "DEPLOYING": "#F59E0B",
                                                "SUPERSEDED": "#94A3B8",
                                                "UNKNOWN": "#94A3B8"
                                            },
                                            "defaultColor": "#94A3B8"
                                        }
                                    },
                                    {
                                        "field": "cause",
                                        "title": "Cause",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "phase_last_updated_at",
                                        "title": "Phase Updated",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    },
                                    {
                                        "field": "updated_at",
                                        "title": "Updated",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableSort": {
                                    "field": "created_at",
                                    "direction": "desc"
                                },
                                "richTableCellPadding": 6,
                                "richTableWrapText": true
                            }
                        }
                    }
                }
            }
        ]
    }
}
