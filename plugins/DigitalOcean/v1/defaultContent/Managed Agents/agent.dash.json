                                "pieDonutCenterValue": "total",
                                "labelFontSize": 16,
                                "pieLegendStyle": "table",
                                "pieLabels": "none",
                                "pieBorderRadius": 6,
                                "piePadAngle": 2,
                                "mappedColors": {
                                    "INPUT": "#0069FF",
                                    "OUTPUT": "#8B5CF6"
                                }
                            }
                        }
                    }
                }
            },
            {
