                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[agentUsage]}}",
                        "name": "agentUsage",
                        "pluginConfigId": "{{configId}}",
                        "group": {
                            "by": [
                                [
                                    "source",
                                    "uniqueValues"
                                ],
                                [
                                    "usageType",
                                    "uniqueValues"
                                ]
                            ],
                            "aggregate": [
                                {
                                    "type": "sum",
                                    "names": [
                                        "tokens"
                                    ]
                                }
                            ]
                        }
                    },
                    "scope": {
                        "scope": "{{scopes.[Agents]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Agent]}}"
                    },
                    "variables": [
                        "{{variables.[Agent]}}"
                    ],
                    "visualisation": {
                        "type": "data-stream-bar-chart",
                        "config": {
                            "data-stream-bar-chart": {
                                "xAxisData": "source_uniqueValues",
                                "yAxisData": [
                                    "tokens_sum"
                                ],
                                "xAxisGroup": "usageType_uniqueValues",
                                "xAxisLabel": "",
                                "yAxisLabel": "Tokens",
                                "showXAxisLabel": false,
                                "showYAxisLabel": true,
                                "showLegend": true,
                                "legendPosition": "bottom",
                                "showGrid": true,
                                "horizontalLayout": "vertical",
                                "displayMode": "actual",
                                "showTotals": true,
                                "showValue": false,
                                "grouping": false,
                                "range": {
                                    "type": "auto"
                                }
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "source_uniqueValues",
                                    "type": "nominal",
                                    "title": "Usage Source"
                                },
                                "y": {
                                    "field": "tokens_sum",
                                    "type": "quantitative",
                                    "title": "Tokens"
                                },
                                "series": {
