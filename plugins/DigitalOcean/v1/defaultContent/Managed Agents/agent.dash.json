                    ],
                    "visualisation": {
                        "type": "data-stream-donut-chart",
                        "config": {
                            "data-stream-donut-chart": {
                                "valueColumn": "tokens_sum",
                                "labelColumn": "usageType_uniqueValues",
                                "hideCenterValue": false,
                                "showValuesAsPercentage": true,
                                "legendPosition": "auto",
                                "legendMode": "table"
