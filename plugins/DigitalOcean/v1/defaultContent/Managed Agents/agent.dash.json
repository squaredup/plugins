                                            "type": "badge",
                                            "colors": {
                                                "STATUS_RUNNING": "#22C55E",
                                                "STATUS_FAILED": "#EF4444",
                                                "STATUS_UNDEPLOYMENT_FAILED": "#EF4444",
                                                "STATUS_UNKNOWN": "#94A3B8",
                                                "STATUS_DELETED": "#94A3B8"
                                            },
                                            "defaultColor": "#F59E0B"
