                                    },
                                    {
                                        "field": "model",
                                        "title": "Model",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "region",
                                        "title": "Region",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "visibility",
                                        "title": "Visibility",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "url",
                                        "title": "URL",
                                        "renderer": {
                                            "type": "link"
                                        }
                                    },
                                    {
                                        "field": "tagList",
                                        "title": "Tags",
                                        "renderer": {
                                            "type": "tag-list",
                                            "color": "#334155"
                                        }
                                    },
                                    {
                                        "field": "createdAt",
                                        "title": "Created",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableTranspose": true,
                                "richTableCellPadding": 4,
                                "richTableFontSize": 13
                            }
                        }
                    }
                }
            },
