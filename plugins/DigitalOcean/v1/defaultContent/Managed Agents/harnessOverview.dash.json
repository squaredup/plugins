                                "valueColumn": "count",
                                "labelColumn": "agentKind_uniqueValues",
                                "hideCenterValue": false,
                                "showValuesAsPercentage": true,
                                "legendPosition": "auto",
                                "legendMode": "table"
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "pie",
                            "encoding": {
