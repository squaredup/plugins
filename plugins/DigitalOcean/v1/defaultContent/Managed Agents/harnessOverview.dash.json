                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Sessions by Agent",
                    "description": "Harness Runtime sessions by the coding agent they run",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[agentSessions]}}",
                        "name": "agentSessions",
                        "pluginConfigId": "{{configId}}",
                        "group": {
                            "by": [
                                [
                                    "agentKind",
                                    "uniqueValues"
                                ]
                            ],
                            "aggregate": [
                                {
                                    "type": "count"
                                }
                            ]
                        }
