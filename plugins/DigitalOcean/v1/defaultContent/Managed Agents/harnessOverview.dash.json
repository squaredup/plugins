            {
                "i": "5163f0e8-a6f7-44fb-a5c2-6325a03cedc6",
                "x": 0,
                "y": 6,
                "w": 10,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Sessions",
                    "description": "Every Harness Runtime session with its status, agent and last activity",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[agentSessions]}}",
                        "name": "agentSessions",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [
                                [
                                    "lastEventAt",
                                    "desc"
                                ]
                            ]
                        }
                    },
                    "timeframe": "none",
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": [
                                    "name",
                                    "health",
                                    "status",
                                    "agentKind",
                                    "pauseReason",
                                    "warnings",
                                    "keepWarm",
                                    "idleTimeoutSeconds",
                                    "lastEventAt",
                                    "createdAt"
                                ],
                                "hiddenColumns": [
                                    "id",
                                    "configId",
                                    "parentSessionId"
                                ],
                                "rowLinkColumnName": {
                                    "value": "name",
                                    "label": "Name"
                                }
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "name",
                                        "title": "Session",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "status",
                                        "title": "Status",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "READY": "#22C55E",
                                                "PROVISIONING": "#F59E0B",
                                                "DESTROYING": "#F59E0B",
                                                "FAILED": "#EF4444",
                                                "LOCKED": "#EF4444",
                                                "PAUSED": "#94A3B8",
                                                "DETACHED": "#94A3B8"
                                            },
                                            "defaultColor": "#94A3B8"
                                        }
                                    },
                                    {
                                        "field": "agentKind",
                                        "title": "Agent",
                                        "renderer": {
                                            "type": "badge",
                                            "defaultColor": "#1E3A8A"
                                        }
                                    },
                                    {
                                        "field": "pauseReason",
                                        "title": "Pause Reason",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "warnings",
                                        "title": "Warnings",
                                        "renderer": {
                                            "type": "text",
                                            "colors": {
                                                "*": "#F59E0B"
                                            }
                                        }
                                    },
                                    {
                                        "field": "keepWarm",
                                        "title": "Keep Warm",
                                        "renderer": {
                                            "type": "boolean",
                                            "trueLabel": "Yes",
                                            "falseLabel": "No"
                                        },
                                        "align": "center",
                                        "width": 90
                                    },
                                    {
                                        "field": "lastEventAt",
                                        "title": "Last Activity",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    },
                                    {
                                        "field": "createdAt",
                                        "title": "Created",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableSort": {
                                    "field": "lastEventAt",
                                    "direction": "desc"
                                },
                                "richTableCellPadding": 6,
                                "richTableRowHighlight": {
                                    "field": "status",
                                    "colors": {
                                        "FAILED": "rgba(239,68,68,0.15)",
                                        "LOCKED": "rgba(239,68,68,0.15)",
                                        "PROVISIONING": "rgba(245,158,11,0.12)"
                                    }
                                }
                            }
                        }
                    }
                }
            }
