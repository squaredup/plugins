{
    "name": "Trigger",
    "schemaVersion": "1.5",
    "timeframe": "last7days",
    "variables": [
        "{{variables.[Trigger]}}"
    ],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "b7fda4fd-18d3-4cc7-8836-eb635daa514b",
                "x": 0,
                "y": 0,
                "w": 1,
                "h": 6,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Properties",
                    "description": "Imported properties of this trigger",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "datastream-properties",
                        "name": "properties"
                    },
                    "timeframe": "none",
                    "scope": {
                        "scope": "{{scopes.[Triggers]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Trigger]}}"
                    },
                    "variables": [
                        "{{variables.[Trigger]}}"
                    ],
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": true
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "name",
                                        "title": "Name",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "kind",
                                        "title": "Kind",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "cron": "#0069FF",
                                                "webhook": "#8B5CF6"
                                            },
                                            "defaultColor": "#475569"
                                        }
                                    },
                                    {
                                        "field": "status",
                                        "title": "Status",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "active": "#22C55E",
                                                "paused": "#94A3B8"
                                            },
                                            "defaultColor": "#94A3B8"
                                        }
                                    },
                                    {
                                        "field": "schedule",
                                        "title": "Schedule",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "timezone",
                                        "title": "Timezone",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "sessionMode",
                                        "title": "Session Mode",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "createdAt",
                                        "title": "Created",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableTranspose": true,
                                "richTableCellPadding": 4,
                                "richTableFontSize": 13
                            }
                        }
                    }
                }
            },
            {
                "i": "6eed37d4-5dd8-49a1-9fe8-bf8cb4249f20",
                "x": 1,
                "y": 0,
                "w": 3,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Execution History",
                    "description": "Health of each recent execution of this trigger",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[triggerExecutions]}}",
                        "name": "triggerExecutions",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [
                                [
                                    "createdAt",
                                    "asc"
                                ]
                            ]
                        }
                    },
                    "timeframe": "none",
                    "scope": {
                        "scope": "{{scopes.[Triggers]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Trigger]}}"
                    },
                    "variables": [
                        "{{variables.[Trigger]}}"
                    ],
                    "visualisation": {
                        "type": "data-stream-blocks",
                        "config": {
                            "data-stream-blocks": {
                                "labelColumn": "createdAt",
                                "stateColumn": "health",
                                "linkColumn": "none",
                                "columns": 10,
                                "sublabel": "status"
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "healthHistory",
                            "encoding": {
                                "time": {
                                    "field": "createdAt",
                                    "type": "temporal",
                                    "title": "Started"
                                },
                                "status": {
                                    "field": "health",
                                    "type": "nominal",
                                    "title": "Health"
                                }
                            },
                            "style": {
                                "historyShowUptime": true,
                                "historyUptimeLabel": "success rate",
                                "historyShowTimeLabels": true
                            }
                        }
                    }
                }
            },
            {
                "i": "2e742c84-132c-4e2d-9e50-60e411e6e615",
                "x": 1,
                "y": 2,
                "w": 3,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Execution Duration",
                    "description": "How long each execution of this trigger took",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[triggerExecutions]}}",
                        "name": "triggerExecutions",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [
                                [
                                    "createdAt",
                                    "asc"
                                ]
                            ]
                        }
                    },
                    "timeframe": "none",
                    "scope": {
                        "scope": "{{scopes.[Triggers]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Trigger]}}"
                    },
                    "variables": [
                        "{{variables.[Trigger]}}"
                    ],
                    "visualisation": {
                        "type": "data-stream-line-graph",
                        "config": {
                            "data-stream-line-graph": {
                                "xAxisColumn": "createdAt",
                                "yAxisColumn": [
                                    "durationSeconds"
                                ],
                                "seriesColumn": "none",
                                "showLegend": false,
                                "legendPosition": "bottom",
                                "yAxisLabel": "Duration",
                                "showYAxisLabel": true,
                                "showTrendLine": false
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "line",
                            "encoding": {
                                "x": {
                                    "field": "createdAt",
                                    "type": "temporal",
                                    "title": "Started"
                                },
                                "y": {
                                    "field": "durationSeconds",
                                    "type": "quantitative",
                                    "title": "Duration"
                                }
                            },
                            "markLines": [
                                {
                                    "type": "average",
                                    "label": "Average",
                                    "color": "#94A3B8"
                                }
                            ],
                            "style": {
                                "cartesianAreaGradient": true,
                                "cartesianSmooth": true,
                                "cartesianLineWidth": 2,
                                "colors": [
                                    "#0069FF"
                                ],
                                "cartesianConnectNulls": false,
                                "cartesianShowVerticalGridLines": false
                            }
                        }
                    }
                }
            },
            {
                "i": "f2e35209-4e88-4ee1-8cf7-00d88fdce9f0",
                "x": 1,
                "y": 4,
                "w": 3,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Executions",
                    "description": "Every recent execution of this trigger with its status, duration and failure reason",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[triggerExecutions]}}",
                        "name": "triggerExecutions",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [
                                [
                                    "createdAt",
                                    "desc"
                                ]
                            ]
                        }
                    },
                    "timeframe": "none",
                    "scope": {
                        "scope": "{{scopes.[Triggers]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Trigger]}}"
                    },
                    "variables": [
                        "{{variables.[Trigger]}}"
                    ],
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": [
                                    "createdAt",
                                    "health",
                                    "status",
                                    "durationSeconds",
                                    "failureReason",
                                    "outputTruncated",
                                    "updatedAt"
                                ],
                                "hiddenColumns": [
                                    "id",
                                    "sessionId"
                                ]
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "createdAt",
                                        "title": "Started",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    },
                                    {
                                        "field": "status",
                                        "title": "Status",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "succeeded": "#22C55E",
                                                "failed": "#EF4444",
                                                "running": "#F59E0B",
                                                "pending": "#F59E0B"
                                            },
                                            "defaultColor": "#94A3B8"
                                        }
                                    },
                                    {
                                        "field": "durationSeconds",
                                        "title": "Duration",
                                        "renderer": {
                                            "type": "number",
                                            "decimals": 1,
                                            "suffix": " s"
                                        },
                                        "align": "right"
                                    },
                                    {
                                        "field": "failureReason",
                                        "title": "Failure Reason",
                                        "renderer": {
                                            "type": "text",
                                            "colors": {
                                                "*": "#EF4444"
                                            }
                                        }
                                    },
                                    {
                                        "field": "outputTruncated",
                                        "title": "Output Truncated",
                                        "renderer": {
                                            "type": "boolean",
                                            "trueLabel": "Yes",
                                            "falseLabel": "No"
                                        },
                                        "align": "center",
                                        "width": 120
                                    },
                                    {
                                        "field": "updatedAt",
                                        "title": "Updated",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableSort": {
                                    "field": "createdAt",
                                    "direction": "desc"
                                },
                                "richTableCellPadding": 6,
                                "richTableWrapText": true,
                                "richTableRowHighlight": {
                                    "field": "status",
                                    "colors": {
                                        "failed": "rgba(239,68,68,0.15)"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        ]
    }
}
