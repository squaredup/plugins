                                "linkColumn": "name",
                                "columns": 3,
                                "sublabel": "poolName"
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "statusGrid",
                            "encoding": {
                                "label": {
                                    "field": "name",
                                    "type": "nominal"
                                },
                                "status": {
                                    "field": "health",
                                    "type": "nominal"
                                },
                                "group": {
                                    "field": "poolName",
                                    "type": "nominal"
                                }
                            },
                            "style": {
                                "statusGridColumnsPerRow": 4,
                                "statusGridMaxBlockHeight": 110,
                                "statusGridLabelWrap": true,
                                "statusGridOrderByField": "name",
                                "statusGridOrderDirection": "asc"
                            }
                        }
                    }
                }
            },
            {
                "i": "cd9b0b88-3162-4ba9-ae05-012fcabbfdd4",
                "x": 0,
                "y": 5,
                "w": 4,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Nodes",
                    "description": "Worker nodes with their node pool, size and autoscaling limits",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[kubernetesNodes]}}",
                        "name": "kubernetesNodes",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [
                                [
                                    "poolName",
                                    "asc"
                                ],
                                [
                                    "name",
                                    "asc"
                                ]
                            ]
                        }
                    },
                    "timeframe": "none",
                    "scope": {
                        "scope": "{{scopes.[Kubernetes Clusters]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Kubernetes Cluster]}}"
                    },
                    "variables": [
                        "{{variables.[Kubernetes Cluster]}}"
                    ],
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": [
                                    "name",
                                    "health",
                                    "status",
                                    "poolName",
                                    "poolSize",
                                    "autoScale",
                                    "poolCount",
                                    "minNodes",
                                    "maxNodes",
                                    "createdAt",
                                    "updatedAt"
                                ],
                                "hiddenColumns": [
                                    "id",
                                    "dropletId"
                                ],
                                "rowLinkColumnName": {
                                    "value": "name",
                                    "label": "Name"
                                }
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "name",
                                        "title": "Node",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "status",
                                        "title": "State",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "running": "#22C55E",
                                                "provisioning": "#F59E0B",
                                                "draining": "#F59E0B",
                                                "deleting": "#94A3B8"
                                            },
                                            "defaultColor": "#94A3B8"
                                        }
                                    },
                                    {
                                        "field": "poolName",
                                        "title": "Pool",
                                        "renderer": {
                                            "type": "badge",
                                            "defaultColor": "#1E3A8A"
                                        }
                                    },
                                    {
                                        "field": "poolSize",
                                        "title": "Size",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "autoScale",
                                        "title": "Autoscale",
                                        "renderer": {
                                            "type": "boolean"
                                        },
                                        "align": "center"
                                    },
                                    {
                                        "field": "poolCount",
                                        "title": "Pool Nodes",
                                        "renderer": {
                                            "type": "number"
                                        },
                                        "align": "right"
                                    },
                                    {
                                        "field": "minNodes",
                                        "title": "Min",
                                        "renderer": {
                                            "type": "number"
                                        },
                                        "align": "right",
                                        "width": 60
                                    },
                                    {
                                        "field": "maxNodes",
                                        "title": "Max",
                                        "renderer": {
                                            "type": "number"
                                        },
                                        "align": "right",
                                        "width": 60
                                    },
