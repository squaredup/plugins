{
    "name": "Kubernetes Cluster",
    "schemaVersion": "1.5",
    "timeframe": "last24hours",
    "variables": [
        "{{variables.[Kubernetes Cluster]}}"
    ],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "877c4568-cfbb-44bd-adc5-53402d738ea5",
                "x": 0,
                "y": 0,
                "w": 1,
                "h": 5,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Properties",
                    "description": "Imported properties of this kubernetes cluster",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "datastream-properties",
                        "name": "properties"
                    },
                    "timeframe": "none",
                    "scope": {
                        "scope": "{{scopes.[Kubernetes Clusters]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Kubernetes Cluster]}}"
                    },
                    "variables": [
                        "{{variables.[Kubernetes Cluster]}}"
                    ],
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": true
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "name",
                                        "title": "Name",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "status",
                                        "title": "Status",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "active": "#22C55E",
                                                "running": "#22C55E",
                                                "online": "#22C55E",
                                                "new": "#F59E0B",
                                                "off": "#94A3B8",
                                                "archive": "#94A3B8",
                                                "errored": "#EF4444",
                                                "error": "#EF4444"
                                            }
                                        }
                                    },
                                    {
                                        "field": "region",
                                        "title": "Region",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "version",
                                        "title": "Version",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "nodePools",
                                        "title": "Node Pools",
                                        "renderer": {
                                            "type": "number"
                                        }
                                    },
                                    {
                                        "field": "nodes",
                                        "title": "Nodes",
                                        "renderer": {
                                            "type": "number"
                                        }
                                    },
                                    {
                                        "field": "ha",
                                        "title": "High Availability",
                                        "renderer": {
                                            "type": "boolean"
                                        }
                                    },
                                    {
                                        "field": "autoUpgrade",
                                        "title": "Auto Upgrade",
                                        "renderer": {
                                            "type": "boolean"
                                        }
                                    },
                                    {
                                        "field": "tagList",
                                        "title": "Tags",
                                        "renderer": {
                                            "type": "tag-list",
                                            "color": "#334155"
                                        }
                                    },
                                    {
                                        "field": "createdAt",
                                        "title": "Created",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableTranspose": true,
                                "richTableCellPadding": 4,
                                "richTableFontSize": 13
                            }
                        }
                    }
                }
            },
            {
                "i": "e45c4c14-1675-4e72-a62e-77a2d68e2cbd",
