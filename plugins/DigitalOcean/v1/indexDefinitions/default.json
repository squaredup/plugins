{
    "steps": [
        {
            "name": "account",
            "dataStream": {
                "name": "account"
            },
            "timeframe": "none",
            "objectMapping": {
                "id": "team.uuid",
                "name": "team.name",
                "type": {
                    "value": "Account"
                },
                "properties": [
                    {
                        "accountStatus": "status"
                    },
                    {
                        "dropletLimit": "droplet_limit"
                    }
                ]
            }
        },
        {
            "name": "droplets",
            "dataStream": {
                "name": "droplets"
            },
            "timeframe": "none",
            "objectMapping": {
                "id": "id",
                "name": "name",
                "type": {
                    "value": "Droplet"
                },
                "properties": [
                    "status",
                    "region",
                    "sizeSlug",
                    "vcpus",
                    "memory",
                    "disk",
                    "image",
                    "publicIp",
                    "privateIp",
                    "vpcUuid",
                    "tagList",
                    "createdAt",
                    "kubernetesClusterId"
                ]
            }
        },
        {
            "name": "apps",
            "dataStream": {
                "name": "apps"
            },
            "timeframe": "none",
            "objectMapping": {
                "id": "id",
                "name": "name",
                "type": {
                    "value": "App"
                },
                "properties": [
                    "region",
                    "tier",
                    "liveUrl",
                    "defaultIngress",
                    "activeDeploymentPhase",
                    "lastDeploymentAt",
                    "projectId",
                    "createdAt"
                ]
            }
        },
        {
            "name": "kubernetesClusters",
            "dataStream": {
                "name": "kubernetesClusters"
            },
            "timeframe": "none",
            "objectMapping": {
                "id": "id",
                "name": "name",
                "type": {
                    "value": "Kubernetes Cluster"
                },
                "properties": [
                    "status",
                    "region",
                    "version",
                    "nodePools",
                    "nodes",
                    "ha",
                    "autoUpgrade",
                    "vpcUuid",
                    "tagList",
                    "createdAt"
                ]
            }
        },
        {
            "name": "databases",
            "dataStream": {
                "name": "databases"
            },
            "timeframe": "none",
            "objectMapping": {
                "id": "id",
                "name": "name",
                "type": {
                    "value": "Database"
                },
                "properties": [
                    "engine",
                    "version",
                    "status",
                    "region",
                    "size",
                    "numNodes",
                    "projectId",
                    "tagList",
                    "createdAt",
                    "vpcUuid"
                ]
            }
        },
        {
            "name": "loadBalancers",
            "dataStream": {
                "name": "loadBalancers"
            },
            "timeframe": "none",
            "objectMapping": {
                "id": "id",
                "name": "name",
                "type": {
                    "value": "Load Balancer"
                },
                "properties": [
                    "status",
                    "ip",
                    "region",
                    "type",
                    "network",
                    "size",
                    "backendDroplets",
                    "vpcUuid",
                    "createdAt",
                    "primaryBackendDropletId"
                ]
            }
        },
        {
            "name": "agents",
            "dataStream": {
                "name": "agents"
            },
            "timeframe": "none",
            "objectMapping": {
                "id": "id",
                "name": "name",
                "type": {
                    "value": "Agent"
                },
                "properties": [
                    "deploymentStatus",
                    "model",
                    "region",
                    "visibility",
                    "url",
                    "projectId",
                    "tagList",
                    "createdAt"
                ]
            }
        },
        {
            "name": "vpcs",
            "dataStream": {
                "name": "vpcs"
            },
            "timeframe": "none",
            "objectMapping": {
                "id": "id",
                "name": "name",
                "type": {
                    "value": "VPC"
                },
                "properties": [
                    "region",
                    {
                        "ipRange": "ip_range"
                    },
                    {
                        "isDefault": "default"
                    },
                    "description",
                    {
                        "createdAt": "created_at"
                    }
                ]
            }
        },
        {
            "name": "projects",
            "dataStream": {
                "name": "projects"
            },
            "timeframe": "none",
            "objectMapping": {
                "id": "id",
                "name": "name",
                "type": {
                    "value": "Project"
                },
                "properties": [
                    "purpose",
                    "environment",
                    {
                        "isDefault": "is_default"
                    },
                    "description",
                    {
                        "createdAt": "created_at"
                    }
                ]
            }
        },
        {
            "name": "projectResources",
            "dataStream": {
                "name": "projectResources"
            },
            "scope": {
                "query": "g.V().has(\"sourceType\", \"Project\")"
            },
            "timeframe": "none",
            "objectMapping": {
                "id": "id",
                "name": "name",
                "type": {
                    "value": "Project Resource"
                },
                "properties": [
                    "projectId",
                    "resourceType",
                    "resourceId",
                    {
                        "assignedAt": "assignedAt"
                    }
                ]
            },
            "optional": true,
            "dependsOn": [
                "projects"
            ]
        },
        {
            "name": "environments",
            "dataStream": {
                "name": "environments"
            },
            "timeframe": "none",
            "objectMapping": {
                "id": "id",
                "name": "name",
                "type": {
                    "value": "Environment"
                },
                "properties": [
                    {
                        "specVersion": "agentspec_schema_version"
                    },
                    {
                        "createdAt": "created_at"
                    }
                ]
            }
        },
        {
            "name": "agentSessions",
            "dataStream": {
                "name": "agentSessions"
            },
            "timeframe": "none",
            "objectMapping": {
                "id": "id",
                "name": "name",
                "type": {
                    "value": "Agent Session"
                },
                "properties": [
                    "status",
                    "agentKind",
                    "configId",
                    "parentSessionId",
                    "createdAt"
                ]
            }
        },
        {
            "name": "triggers",
            "dataStream": {
                "name": "triggers"
            },
            "timeframe": "none",
            "objectMapping": {
                "id": "id",
                "name": "name",
