{
    "displayName": "Project contains resources",
    "source": {
        "types": ["Droplet", "App", "Kubernetes Cluster", "Database", "Load Balancer", "Agent"]
    },
    "bridge": {
        "types": "Project Resource"
    },
    "target": {
        "types": "Project"
    },
    "sourceConditions": [
        {
            "sourceProperty": "rawId",
            "operator": "equals",
            "targetProperty": "resourceId"
        }
    ],
    "targetConditions": [
        {
            "sourceProperty": "projectId",
            "operator": "equals",
            "targetProperty": "rawId"
        }
    ],
    "labels": {
        "forward": "in project",
        "reverse": "contains"
    }
}
