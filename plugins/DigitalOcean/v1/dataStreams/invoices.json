{
    "name": "invoices",
    "displayName": "Invoices",
    "description": "Issued invoices and the current month's invoice preview with their billing period and amount",
    "tags": [
        "Cost",
        "Billing"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "v2/customers/my/invoices",
        "postRequestScript": "invoices.js",
        "paging": {
            "mode": "nextUrl",
            "pageSize": {
                "realm": "queryArg",
                "path": "per_page",
                "value": "200"
            },
            "in": {
                "realm": "payload",
                "path": "links.pages.next"
            }
        }
    },
    "matches": "none",
    "metadata": [
        {
            "name": "invoice_uuid",
            "displayName": "Invoice UUID",
            "shape": "string",
            "visible": false
        },
        {
            "name": "invoice_id",
            "displayName": "Invoice Number",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "invoice_period",
            "displayName": "Period",
            "shape": "string"
        },
        {
            "name": "amount",
            "displayName": "Amount",
            "shape": [
                "currency",
                {
                    "code": "usd"
                }
            ],
            "role": "value"
        },
        {
            "name": "preview",
            "displayName": "Preview",
            "shape": "boolean"
        },
        {
            "name": "updated_at",
            "displayName": "Updated",
            "shape": "date"
        }
    ],
    "timeframes": false
}
