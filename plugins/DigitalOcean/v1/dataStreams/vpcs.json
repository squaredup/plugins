{
    "name": "vpcs",
    "displayName": "VPCs",
    "description": "VPC networks with their region, IP range and whether they are the default for their region",
    "tags": [
        "Network",
        "Inventory"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "v2/vpcs",
        "pathToData": "vpcs",
        "paging": {
            "mode": "nextUrl",
            "pageSize": {
                "realm": "queryArg",
                "path": "per_page",
                "value": "200"
            },
            "in": {
                "realm": "payload",
                "path": "links.pages.next"
            }
        }
    },
    "matches": "none",
    "metadata": [
        {
            "name": "id",
            "displayName": "ID",
            "shape": "string",
            "visible": false
        },
        {
            "name": "name",
            "displayName": "Name",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "region",
            "displayName": "Region",
            "shape": "string"
        },
        {
            "name": "ip_range",
            "displayName": "IP Range",
            "shape": "string"
        },
        {
            "name": "default",
            "displayName": "Default",
            "shape": "boolean"
        },
        {
            "name": "description",
            "displayName": "Description",
            "shape": "string"
        },
        {
            "name": "urn",
            "displayName": "URN",
            "shape": "string",
            "visible": false
        },
        {
            "name": "created_at",
            "displayName": "Created",
            "shape": "date"
        },
        {
            "sourceId": "id",
            "sourceType": "VPC",
            "name": "name"
        }
    ],
    "timeframes": false
}
