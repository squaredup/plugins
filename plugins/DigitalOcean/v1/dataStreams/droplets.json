{
    "name": "droplets",
    "displayName": "Droplets",
    "description": "Droplets with their status, size, region, image and IP addresses",
    "tags": [
        "Compute",
        "Inventory"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "v2/droplets",
        "postRequestScript": "droplets.js",
        "paging": {
            "mode": "nextUrl",
            "pageSize": {
                "realm": "queryArg",
                "path": "per_page",
                "value": "200"
            },
            "in": {
                "realm": "payload",
                "path": "links.pages.next"
            }
        }
    },
    "matches": "none",
    "metadata": [
        {
            "name": "id",
            "displayName": "ID",
            "shape": "string",
            "visible": false
        },
        {
            "name": "name",
            "displayName": "Name",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "status",
            "displayName": "Status",
            "shape": "string"
        },
        {
            "name": "health",
            "displayName": "Health",
            "computed": true,
            "valueExpression": "{{ $['status'] }}",
            "shape": [
                "state",
                {
                    "map": {
                        "success": [
                            "active"
                        ],
                        "warning": [
                            "new",
                            "off"
                        ],
                        "unknown": [
                            "archive"
                        ]
                    }
                }
            ]
        },
        {
            "name": "region",
            "displayName": "Region",
            "shape": "string"
        },
        {
            "name": "sizeSlug",
            "displayName": "Size",
            "shape": "string"
        },
        {
            "name": "vcpus",
            "displayName": "vCPUs",
            "shape": "number"
        },
        {
            "name": "memory",
            "displayName": "Memory",
            "shape": "megabytes"
        },
        {
            "name": "disk",
            "displayName": "Disk",
            "shape": "gigabytes"
        },
        {
            "name": "image",
            "displayName": "Image",
            "shape": "string"
        },
        {
            "name": "publicIp",
            "displayName": "Public IP",
            "shape": "string"
        },
        {
            "name": "privateIp",
            "displayName": "Private IP",
            "shape": "string"
        },
        {
            "name": "vpcUuid",
            "displayName": "VPC ID",
            "shape": "string",
            "visible": false
        },
        {
            "name": "kubernetesClusterId",
            "displayName": "Kubernetes Cluster ID",
            "shape": "string",
            "visible": false
        },
        {
            "name": "locked",
            "displayName": "Locked",
            "shape": "boolean"
        },
        {
            "name": "tagList",
            "displayName": "Tags",
            "shape": "string"
        },
        {
            "name": "createdAt",
            "displayName": "Created",
            "shape": "date"
        },
        {
            "sourceId": "id",
            "sourceType": "Droplet",
            "name": "name"
        }
    ],
    "timeframes": false,
    "ui": [
        {
            "type": "objects",
            "name": "vpc",
            "label": "VPC (optional)",
            "matches": {
                "sourceType": {
                    "type": "oneOf",
                    "values": [
                        "VPC"
                    ]
                }
            }
        }
    ]
}
