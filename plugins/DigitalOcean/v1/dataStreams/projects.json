{
    "name": "projects",
    "displayName": "Projects",
    "description": "Projects with their purpose, environment and whether they are the default project",
    "tags": ["Inventory"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "projects",
        "pathToData": "projects",
        "paging": {
            "mode": "nextUrl",
            "pageSize": { "realm": "queryArg", "path": "per_page", "value": "200" },
            "in": { "realm": "payload", "path": "links.pages.next" }
        }
    },
    "matches": "none",
    "metadata": [
        { "name": "id", "displayName": "ID", "shape": "string", "visible": false },
        { "name": "name", "displayName": "Name", "shape": "string", "role": "label" },
        { "name": "purpose", "displayName": "Purpose", "shape": "string" },
        { "name": "environment", "displayName": "Environment", "shape": "string" },
        { "name": "is_default", "displayName": "Default", "shape": "boolean" },
        { "name": "description", "displayName": "Description", "shape": "string" },
        { "name": "created_at", "displayName": "Created", "shape": "date" },
        { "name": "updated_at", "displayName": "Updated", "shape": "date" },
        { "sourceId": "id", "sourceType": "Project", "name": "name" }
    ],
    "timeframes": false
}
