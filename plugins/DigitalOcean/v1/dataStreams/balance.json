{
    "name": "balance",
    "displayName": "Balance",
    "description": "Account balance, month-to-date usage and the balance including usage as of the last time it was generated",
    "tags": [
        "Cost",
        "Billing"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "v2/customers/my/balance"
    },
    "matches": "none",
    "metadata": [
        {
            "name": "month_to_date_usage",
            "displayName": "month_to_date_usage",
            "shape": "string",
            "visible": false
        },
        {
            "name": "month_to_date_balance",
            "displayName": "month_to_date_balance",
            "shape": "string",
            "visible": false
        },
        {
            "name": "account_balance",
            "displayName": "account_balance",
            "shape": "string",
            "visible": false
        },
        {
            "name": "usage",
            "displayName": "Month-to-Date Usage",
            "computed": true,
            "valueExpression": "{{ Number($['month_to_date_usage']) }}",
            "shape": [
                "number",
                {
                    "decimalPlaces": 2
                }
            ],
            "role": "value"
        },
        {
            "name": "monthToDateBalance",
            "displayName": "Month-to-Date Balance",
            "computed": true,
            "valueExpression": "{{ Number($['month_to_date_balance']) }}",
            "shape": [
                "number",
                {
                    "decimalPlaces": 2
                }
            ]
        },
        {
            "name": "accountBalance",
            "displayName": "Account Balance",
            "computed": true,
            "valueExpression": "{{ Number($['account_balance']) }}",
            "shape": [
                "number",
                {
                    "decimalPlaces": 2
                }
            ]
        },
        {
            "name": "generated_at",
            "displayName": "Generated",
            "shape": "date"
        }
    ],
    "timeframes": false
}
