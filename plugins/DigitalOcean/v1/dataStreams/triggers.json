{
    "name": "triggers",
    "displayName": "Triggers",
    "description": "Harness Runtime cron and webhook triggers with their status and schedule",
    "tags": [
        "AI",
        "Inventory"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "v2/agents/triggers",
        "postRequestScript": "triggers.js",
        "getArgs": [
            {
                "key": "page_size",
                "value": "200"
            }
        ]
    },
    "matches": "none",
    "metadata": [
        {
            "name": "id",
            "displayName": "ID",
            "shape": "string",
            "visible": false
        },
        {
            "name": "name",
            "displayName": "Name",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "kind",
            "displayName": "Kind",
            "shape": "string"
        },
        {
            "name": "status",
            "displayName": "Status",
            "shape": "string"
        },
        {
            "name": "health",
            "displayName": "Health",
            "computed": true,
            "valueExpression": "{{ $['status'] }}",
            "shape": [
                "state",
                {
                    "map": {
                        "success": [
                            "active"
                        ],
                        "unknown": [
                            "paused"
                        ]
                    }
                }
            ]
        },
        {
            "name": "schedule",
            "displayName": "Schedule",
            "shape": "string"
        },
        {
            "name": "timezone",
            "displayName": "Timezone",
            "shape": "string"
        },
        {
            "name": "nextRunAt",
            "displayName": "Next Run",
            "shape": "date"
        },
        {
            "name": "sessionMode",
            "displayName": "Session Mode",
            "shape": "string"
        },
        {
            "name": "boundSessionId",
            "displayName": "Bound Session ID",
            "shape": "string",
            "visible": false
        },
        {
            "name": "createdAt",
            "displayName": "Created",
            "shape": "date"
        },
        {
            "name": "updatedAt",
            "displayName": "Updated",
            "shape": "date"
        },
        {
            "sourceId": "id",
            "sourceType": "Trigger",
            "name": "name"
        }
    ],
    "timeframes": false
}
