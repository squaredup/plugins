{
    "name": "kubernetesClusters",
    "displayName": "Kubernetes Clusters",
    "description": "DOKS clusters with their state, version, region and node counts",
    "tags": [
        "Kubernetes",
        "Inventory"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "kubernetes/clusters",
        "postRequestScript": "kubernetesClusters.js",
        "paging": {
            "mode": "nextUrl",
            "pageSize": {
                "realm": "queryArg",
                "path": "per_page",
                "value": "200"
            },
            "in": {
                "realm": "payload",
                "path": "links.pages.next"
            }
        }
    },
    "matches": "none",
    "metadata": [
        {
            "name": "id",
            "displayName": "ID",
            "shape": "string",
            "visible": false
        },
        {
            "name": "name",
            "displayName": "Name",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "status",
            "displayName": "Status",
            "shape": "string"
        },
        {
            "name": "health",
            "displayName": "Health",
            "computed": true,
            "valueExpression": "{{ $['status'] }}",
            "shape": [
                "state",
                {
                    "map": {
                        "success": [
                            "running"
                        ],
                        "warning": [
                            "provisioning",
                            "upgrading",
                            "degraded"
                        ],
                        "error": [
                            "error"
                        ],
                        "unknown": [
                            "deleting",
                            "deleted"
                        ]
                    }
                }
            ]
        },
        {
            "name": "statusMessage",
            "displayName": "Status Message",
            "shape": "string"
        },
        {
            "name": "region",
            "displayName": "Region",
            "shape": "string"
        },
        {
            "name": "version",
            "displayName": "Version",
            "shape": "string"
        },
        {
            "name": "nodePools",
            "displayName": "Node Pools",
            "shape": "number"
        },
        {
            "name": "nodes",
            "displayName": "Nodes",
            "shape": "number"
        },
        {
            "name": "ha",
            "displayName": "HA Control Plane",
            "shape": "boolean"
        },
        {
            "name": "autoUpgrade",
            "displayName": "Auto Upgrade",
            "shape": "boolean"
        },
        {
            "name": "endpoint",
            "displayName": "API Endpoint",
            "shape": "string",
            "visible": false
        },
        {
            "name": "vpcUuid",
            "displayName": "VPC ID",
            "shape": "string",
            "visible": false
        },
        {
            "name": "tagList",
            "displayName": "Tags",
            "shape": "string"
        },
        {
            "name": "createdAt",
            "displayName": "Created",
            "shape": "date"
        },
        {
            "name": "updatedAt",
            "displayName": "Updated",
            "shape": "date"
        },
        {
            "sourceId": "id",
            "sourceType": "Kubernetes Cluster",
            "name": "name"
        }
    ],
    "timeframes": false,
    "ui": [
        {
            "type": "objects",
            "name": "vpc",
            "label": "VPC (optional)",
            "matches": {
                "sourceType": {
                    "type": "oneOf",
                    "values": [
                        "VPC"
                    ]
                }
            }
        }
    ]
}
