{
    "name": "environments",
    "displayName": "Environments",
    "description": "Harness Runtime environment configs with their spec schema version and creation date",
    "tags": [
        "AI",
        "Inventory"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "v2/agents/configs",
        "pathToData": "configs",
        "getArgs": [
            {
                "key": "page_size",
                "value": "200"
            }
        ]
    },
    "matches": "none",
    "metadata": [
        {
            "name": "id",
            "displayName": "ID",
            "shape": "string",
            "visible": false
        },
        {
            "name": "name",
            "displayName": "Name",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "agentspec_schema_version",
            "displayName": "Spec Version",
            "shape": "string"
        },
        {
            "name": "created_at",
            "displayName": "Created",
            "shape": "date"
        },
        {
            "name": "updated_at",
            "displayName": "Updated",
            "shape": "date"
        },
        {
            "sourceId": "id",
            "sourceType": "Environment",
            "name": "name"
        }
    ],
    "timeframes": false
}
