{
    "name": "evaluationTestCases",
    "displayName": "Evaluation Test Cases",
    "description": "Gradient AI evaluation test cases with their star metric, success threshold and dataset",
    "tags": ["AI", "Quality"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "gen-ai/evaluation_test_cases",
        "postRequestScript": "evaluationTestCases.js"
    },
    "matches": "none",
    "metadata": [
        { "name": "id", "displayName": "ID", "shape": "string", "visible": false },
        { "name": "name", "displayName": "Name", "shape": "string", "role": "label" },
        { "name": "description", "displayName": "Description", "shape": "string" },
        { "name": "totalRuns", "displayName": "Total Runs", "shape": "number" },
        { "name": "latestVersionRuns", "displayName": "Latest Version Runs", "shape": "number" },
        { "name": "version", "displayName": "Version", "shape": "number" },
        { "name": "starMetric", "displayName": "Star Metric", "shape": "string" },
        { "name": "successThreshold", "displayName": "Success Threshold", "shape": ["number", { "decimalPlaces": 2 }] },
        { "name": "successThresholdPct", "displayName": "Success Threshold (%)", "shape": "number" },
        { "name": "datasetName", "displayName": "Dataset", "shape": "string" },
        { "name": "datasetRows", "displayName": "Dataset Rows", "shape": "number" },
        { "name": "createdAt", "displayName": "Created", "shape": "date" },
        { "name": "updatedAt", "displayName": "Updated", "shape": "date" }
    ],
    "timeframes": false
}
