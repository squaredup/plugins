{
    "name": "projectResources",
    "displayName": "Project Resources",
    "description": "Resources assigned to a project with their type, ID and when they were assigned",
    "tags": ["Inventory"],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "projects/{{object.rawId}}/resources",
        "postRequestScript": "projectResources.js",
        "paging": {
            "mode": "nextUrl",
            "pageSize": { "realm": "queryArg", "path": "per_page", "value": "200" },
            "in": { "realm": "payload", "path": "links.pages.next" }
        }
    },
    "matches": { "sourceType": { "type": "oneOf", "values": ["Project"] } },
    "metadata": [
        { "name": "id", "displayName": "URN", "shape": "string", "visible": false },
        { "name": "name", "displayName": "Resource", "shape": "string", "role": "label" },
        { "name": "resourceType", "displayName": "Type", "shape": "string" },
        { "name": "resourceId", "displayName": "Resource ID", "shape": "string" },
        { "name": "status", "displayName": "Status", "shape": "string" },
        { "name": "assignedAt", "displayName": "Assigned", "shape": "date" },
        { "name": "projectId", "displayName": "Project ID", "shape": "string", "visible": false }
    ],
    "timeframes": false
}
