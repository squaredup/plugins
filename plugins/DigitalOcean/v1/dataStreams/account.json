{
    "name": "account",
    "displayName": "Account",
    "description": "The DigitalOcean account and team the token belongs to, with its status and resource limits",
    "tags": [
        "Account"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "visibility": {
        "type": "hidden"
    },
    "config": {
        "httpMethod": "get",
        "endpointPath": "v2/account",
        "pathToData": "account",
        "expandInnerObjects": true
    },
    "matches": "none",
    "metadata": [
        {
            "name": "team.uuid",
            "displayName": "Team ID",
            "shape": "string",
            "visible": false
        },
        {
            "name": "team.name",
            "displayName": "Team",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "email",
            "displayName": "Email",
            "shape": "string"
        },
        {
            "name": "status",
            "displayName": "Status",
            "shape": "string"
        },
        {
            "name": "health",
            "displayName": "Health",
            "computed": true,
            "valueExpression": "{{ $['status'] }}",
            "shape": [
                "state",
                {
                    "map": {
                        "success": [
                            "active"
                        ],
                        "warning": [
                            "warning"
                        ],
                        "error": [
                            "locked"
                        ]
                    }
                }
            ]
        },
        {
            "name": "status_message",
            "displayName": "Status Message",
            "shape": "string"
        },
        {
            "name": "droplet_limit",
            "displayName": "Droplet Limit",
            "shape": "number"
        },
        {
            "name": "floating_ip_limit",
            "displayName": "Reserved IP Limit",
            "shape": "number"
        },
        {
            "name": "email_verified",
            "displayName": "Email Verified",
            "shape": "boolean"
        },
        {
            "name": "uuid",
            "displayName": "User ID",
            "shape": "string",
            "visible": false
        }
    ],
    "timeframes": false
}
