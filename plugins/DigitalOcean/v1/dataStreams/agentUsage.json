{
    "name": "agentUsage",
    "displayName": "Agent Usage",
    "description": "Token usage of a Gradient AI agent split by usage source and input or output",
    "tags": [
        "AI",
        "Usage"
    ],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "v2/gen-ai/agents/{{object.rawId}}/usage",
        "getArgs": [
            {
                "key": "start",
                "value": "{{timeframe.start}}"
            },
            {
                "key": "stop",
                "value": "{{timeframe.end}}"
            }
        ],
        "postRequestScript": "agentUsage.js"
    },
    "matches": {
        "sourceType": {
            "type": "oneOf",
            "values": [
                "Agent"
            ]
        }
    },
    "metadata": [
        {
            "name": "start",
            "displayName": "Start",
            "shape": "date",
            "role": "timestamp"
        },
        {
            "name": "stop",
            "displayName": "End",
            "shape": "date"
        },
        {
            "name": "source",
            "displayName": "Usage Source",
            "shape": "string"
        },
        {
            "name": "usageType",
            "displayName": "Usage Type",
            "shape": "string"
        },
        {
            "name": "tokens",
            "displayName": "Tokens",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0,
                    "thousandsSeparator": true
                }
            ]
        }
    ],
    "timeframes": true
}
