{
    "name": "digitalocean",
    "displayName": "DigitalOcean",
    "version": "1.0.0",
    "author": {
        "name": "@clarkd",
        "type": "community"
    },
    "description": "Monitor your DigitalOcean Droplets, apps, Kubernetes clusters, databases, load balancers, AI agents and spend.",
    "category": "Cloud Platforms",
    "type": "hybrid",
    "schemaVersion": "2.1",
    "importNotSupported": false,
    "restrictedToPlatforms": [],
    "keywords": [
        "digitalocean",
        "droplets",
        "kubernetes",
        "app platform",
        "databases",
        "load balancers",
        "gradient ai",
        "agents",
        "billing",
        "cloud",
        "vpc",
        "projects"
    ],
    "objectTypes": [
        "Account",
        "Droplet",
        "App",
        "Kubernetes Cluster",
        "Database",
        "Load Balancer",
        "Agent",
        "VPC",
        "Project",
        "Project Resource"
    ],
    "links": [
        {
            "category": "documentation",
            "url": "https://github.com/squaredup/plugins/blob/main/plugins/DigitalOcean/v1/docs/README.md",
            "label": "Help adding this plugin"
        },
        {
            "category": "source",
            "url": "https://github.com/squaredup/plugins/tree/main/plugins/DigitalOcean",
            "label": "Repository"
        }
    ],
    "base": {
        "plugin": "WebAPI",
        "majorVersion": "1",
        "config": {
            "baseUrl": "https://api.digitalocean.com/v2",
            "authMode": "none",
            "headers": [
                {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}"
                }
            ]
        }
    },
    "screenshots": [
        "https://github.com/squaredup/plugins/blob/main/plugins/DigitalOcean/v1/screenshots/overview.png",
        "https://github.com/squaredup/plugins/blob/main/plugins/DigitalOcean/v1/screenshots/billing.png",
        "https://github.com/squaredup/plugins/blob/main/plugins/DigitalOcean/v1/screenshots/project.png",
        "https://github.com/squaredup/plugins/blob/main/plugins/DigitalOcean/v1/screenshots/droplet.png",
        "https://github.com/squaredup/plugins/blob/main/plugins/DigitalOcean/v1/screenshots/app.png",
        "https://github.com/squaredup/plugins/blob/main/plugins/DigitalOcean/v1/screenshots/kubernetes-cluster.png",
        "https://github.com/squaredup/plugins/blob/main/plugins/DigitalOcean/v1/screenshots/load-balancer.png",
        "https://github.com/squaredup/plugins/blob/main/plugins/DigitalOcean/v1/screenshots/vpc.png",
