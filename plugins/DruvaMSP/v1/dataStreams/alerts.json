{
    "name": "alerts",
    "displayName": "Endpoint Alerts",
    "description": "Endpoint alerts with their severity, affected entity and occurrence window (optionally filtered to customers)",
    "tags": ["Backup"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "post",
        "endpointPath": "/msp/reporting/v2/reports/mspEPAlert",
        "postBody": {
            "filters": {
                "pageSize": 500,
                "filterBy": [
                    {
                        "fieldName": "{{ (typeof timeframe === 'undefined' || timeframe.enum === 'none') ? 'lastUpdatedTime' : ((typeof dateField !== 'undefined' && dateField) || 'lastOccurrence') }}",
                        "operator": "GTE",
                        "value": "{{ (typeof timeframe === 'undefined' || timeframe.enum === 'none') ? '2000-01-01T00:00:00Z' : timeframe.start }}"
                    },
                    {
                        "fieldName": "{{ (typeof timeframe === 'undefined' || timeframe.enum === 'none') ? 'lastUpdatedTime' : ((typeof dateField !== 'undefined' && dateField) || 'lastOccurrence') }}",
                        "operator": "LTE",
                        "value": "{{ (typeof timeframe === 'undefined' || timeframe.enum === 'none') ? '2100-01-01T00:00:00Z' : timeframe.end }}"
                    }
                ]
            }
        },
        "paging": {
            "mode": "token",
            "pageSize": { "realm": "none" },
            "in": { "realm": "payload", "path": "nextPageToken" },
            "out": { "realm": "body", "path": "pageToken" }
        },
        "postRequestScript": "alerts.js"
    },
    "matches": "none",
    "ui": [
        {
            "type": "objects",
            "name": "customer",
            "label": "Customer (optional)",
            "placeholder": "Select...",
            "matches": { "sourceType": { "type": "oneOf", "values": ["Customer"] } }
        },
        {
            "type": "switch",
            "name": "dateField",
            "label": "Timeframe applies to",
            "defaultValue": "lastOccurrence",
            "help": "Which alert date the selected timeframe filters on. Set the timeframe to **None** to ignore dates and return all alerts.",
            "options": [
                { "value": "lastOccurrence", "label": "Last occurrence" },
                { "value": "firstOccurrence", "label": "First occurrence" }
            ],
            "tileEditorStep": ["Timeframe"]
        }
    ],
    "metadata": [
        { "name": "dcpUniqueKey", "displayName": "Alert ID", "shape": "string", "role": "id", "visible": false },
        { "name": "alertDetails", "displayName": "Alert", "shape": "string", "role": "label" },
        {
            "name": "severity",
            "displayName": "Severity",
            "shape": [
                "state",
                {
                    "map": {
                        "error": ["Critical"],
                        "warning": ["Warning"],
                        "unknown": ["Information", "Info"]
                    }
                }
            ]
        },
        { "name": "active", "displayName": "Active (raw)", "shape": "string", "visible": false },
        {
            "name": "isActive",
            "displayName": "Active",
            "computed": true,
            "valueExpression": "{{ $['active'] === 'Yes' }}",
            "shape": "boolean"
        },
        { "name": "entity", "displayName": "Entity", "shape": "string" },
        { "name": "customerGlobalId", "displayName": "Customer ID", "shape": "string", "visible": false },
        {
            "name": "customer",
            "displayName": "Customer",
            "sourceId": "customerGlobalId",
            "sourceType": "Customer",
            "objectPropertyPath": "name"
        },
        { "name": "accountName", "displayName": "Account", "shape": "string" },
        { "name": "firstOccurrence", "displayName": "First occurrence", "shape": "date" },
        { "name": "lastOccurrence", "displayName": "Last occurrence", "shape": "date", "role": "timestamp" }
    ],
    "timeframes": true,
    "supportsNoneTimeframe": true
}
