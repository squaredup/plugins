                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Enterprise Workloads Backup Jobs by Status (Last 24 Hours)",
                    "description": "Enterprise Workloads backup jobs for this tenant in the last 24 hours, by status",
                    "timeframe": "last24hours",
                    "variables": [
                        "{{variables.[Druva Tenant]}}"
                    ],
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[backupJobs]}}",
                        "name": "backupJobs",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "customer": [],
                            "tenant": {
                                "variable": "{{variables.[Druva Tenant]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Druva Tenants]}}"
                            }
                        },
                        "group": {
                            "by": [
                                [
                                    "state",
                                    "uniqueValues"
                                ]
                            ],
                            "aggregate": [
                                {
                                    "type": "count"
                                }
                            ]
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "pie",
                            "encoding": {
                                "label": {
                                    "field": "state_uniqueValues",
                                    "type": "nominal"
                                },
                                "value": {
                                    "field": "count",
                                    "type": "quantitative",
                                    "aggregate": "sum"
                                }
                            },
                            "style": {
                                "pieInnerRadius": 60,
                                "pieDonutCenterValue": "total",
                                "labelFontSize": 16,
                                "pieSort": "desc",
                                "pieLegendStyle": "table",
                                "mappedColors": {
                                    "critical": "#DE0038",
                                    "error": "#DE0038",
                                    "failed": "#DE0038",
                                    "failure": "#DE0038",
                                    "down": "#DE0038",
                                    "offline": "#DE0038",
                                    "unhealthy": "#DE0038",
                                    "high": "#DE0038",
                                    "warning": "#F59E0B",
                                    "warn": "#F59E0B",
                                    "medium": "#F59E0B",
                                    "moderate": "#F59E0B",
                                    "degraded": "#F59E0B",
                                    "partial": "#F59E0B",
                                    "ok": "#2BB660",
                                    "healthy": "#2BB660",
                                    "success": "#2BB660",
                                    "succeeded": "#2BB660",
                                    "passed": "#2BB660",
                                    "up": "#2BB660",
                                    "online": "#2BB660",
                                    "resolved": "#2BB660",
                                    "low": "#3B82F6",
                                    "info": "#3B82F6",
                                    "informational": "#3B82F6",
                                    "unknown": "#94A3B8",
                                    "unmonitored": "#94A3B8",
                                    "not monitored": "#94A3B8",
                                    "paused": "#94A3B8"
                                }
                            }
                        }
                    }
                }
            },
            {
                "i": "08a6dd31-704e-41fb-8071-0cf3d9512870",
                "x": 1,
                "y": 4,
                "w": 3,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Failed Enterprise Workloads Backup Jobs (Last 7 Days)",
                    "description": "Enterprise Workloads backup jobs for this tenant that failed, ran out of their window or were cancelled in the last 7 days",
                    "timeframe": "last7days",
                    "variables": [
                        "{{variables.[Druva Tenant]}}"
                    ],
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[backupJobs]}}",
                        "name": "backupJobs",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "customer": [],
                            "tenant": {
                                "variable": "{{variables.[Druva Tenant]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[Druva Tenants]}}"
                            }
                        },
                        "filter": {
                            "multiOperation": "and",
                            "filters": [
                                {
                                    "column": "state",
                                    "operation": "equals",
                                    "value": "error"
                                }
                            ]
                        },
                        "sort": {
                            "by": [
                                [
                                    "started",
                                    "desc"
                                ]
                            ]
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "customer",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "backupSet",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "vm",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "workloads",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "status",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "details",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "started",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    }
                                ]
                            }
                        }
                    }
                }
