                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Daily Storage Consumption by Product Module",
                    "description": "Chargeback consumption reported in TB, bucketed by day",
                    "timeframe": "last7days",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[consumption]}}",
                        "name": "consumption",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "customer": []
                        },
                        "filter": {
                            "multiOperation": "and",
                            "filters": [
                                {
                                    "column": "units",
                                    "operation": "equals",
                                    "value": "TB"
                                }
                            ]
                        },
                        "group": {
                            "by": [
                                [
                                    "date",
                                    "byDay"
                                ],
                                [
                                    "productModule",
                                    "uniqueValues"
                                ]
                            ],
                            "aggregate": [
                                {
                                    "type": "sum",
                                    "names": [
                                        "data"
                                    ]
                                }
                            ]
                        },
                        "sort": {
                            "by": [
                                [
                                    "date_byDay",
                                    "asc"
                                ]
                            ]
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "line",
                            "encoding": {
                                "x": {
                                    "field": "date_byDay",
                                    "type": "temporal"
                                },
                                "y": {
                                    "field": "data_sum",
                                    "type": "quantitative"
                                },
                                "series": {
                                    "field": "productModule_uniqueValues",
                                    "type": "nominal"
                                }
                            },
                            "style": {
                                "legendPosition": "bottom",
                                "cartesianShowYAxisTitle": true,
                                "cartesianYAxisTitle": "TB",
                                "cartesianYAxisRangeMode": "fit",
                                "cartesianSymbol": "none",
                                "cartesianAreaGradient": true
                            }
                        }
                    }
                }
            },
