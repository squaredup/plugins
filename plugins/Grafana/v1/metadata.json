{
    "name": "grafana",
    "displayName": "Grafana",
    "version": "1.0.0",
    "author": {
        "name": "@WaynePlummer",
        "type": "community"
    },
    "description": "Monitor your Grafana dashboards and alert rules in SquaredUp.",
    "category": "Monitoring",
    "type": "cloud",
    "restrictedToPlatforms": [],
    "importNotSupported": false,
    "schemaVersion": "2.0",
    "base": {
        "plugin": "WebAPI",
        "majorVersion": "1",
        "config": {
            "headers": [
                {
                    "key": "Authorization",
                    "value": "Bearer {{serviceAccountToken}}"
                },
                {
                    "key": "Accept",
                    "value": "application/json"
                }
            ],
            "queryArgs": [],
            "authMode": "none",
            "baseUrl": "{{baseUrl}}"
        }
    },
    "keywords": ["grafana", "monitoring", "dashboards", "alerts", "observability"],
    "links": [
        {
            "category": "documentation",
            "url": "https://github.com/squaredup/plugins/blob/main/plugins/Grafana/v1/docs/README.md",
            "label": "Help adding this plugin"
        },
        {
            "category": "source",
            "url": "https://github.com/squaredup/plugins/tree/main/plugins/Grafana/v1",
            "label": "Repository"
        }
    ]
}
