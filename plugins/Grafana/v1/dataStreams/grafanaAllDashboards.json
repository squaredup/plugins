{
    "name": "grafanaAllDashboards",
    "displayName": "Dashboards",
    "description": "All dashboards in the Grafana instance",
    "tags": ["Dashboards"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "paging": {
            "mode": "none"
        },
        "endpointPath": "api/search",
        "pathToData": "",
        "getArgs": [
            { "key": "type", "value": "dash-db" },
            { "key": "limit", "value": "5000" }
        ],
        "headers": []
    },
    "metadata": [
        {
            "name": "uid",
            "shape": "string",
            "visible": false
        },
        {
            "name": "id",
            "shape": "number",
            "visible": false
        },
        {
            "name": "title",
            "displayName": "Title",
            "shape": "string"
        },
        {
            "name": "url",
            "displayName": "URL",
            "shape": "string"
        },
        {
            "name": "folderTitle",
            "displayName": "Folder",
            "shape": "string"
        },
        {
            "name": "folderUid",
            "shape": "string",
            "visible": false
        },
        {
            "name": "tags",
            "displayName": "Tags",
            "shape": "string"
        },
        {
            "name": "isStarred",
            "displayName": "Starred",
            "shape": "string"
        },
        {
            "pattern": ".*"
        }
    ],
    "timeframes": false
}
