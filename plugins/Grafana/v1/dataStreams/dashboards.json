{
    "name": "dashboards",
    "displayName": "Dashboards",
    "description": "All dashboards in the Grafana instance",
    "tags": ["Dashboards"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "paging": {
            "mode": "offset",
            "pageSize": {
                "realm": {
                    "value": "queryArg",
                    "label": "Query parameter"
                },
                "path": "limit",
                "value": "500"
            },
            "offset": {
                "rowCountIn": {
                    "realm": {
                        "value": "payloadArraySize",
                        "label": "Body array size"
                    },
                    "path": "."
                },
                "mode": "page",
                "base": 1
            },
            "out": {
                "realm": {
                    "value": "queryArg",
                    "label": "queryArg"
                },
                "path": "page"
            }
        },
        "endpointPath": "api/search",
        "pathToData": "",
        "getArgs": [
            { "key": "type", "value": "dash-db" },
            { "key": "limit", "value": "5000" }
        ],
        "headers": []
    },
    "metadata": [
        {
            "name": "uid",
            "shape": "string",
            "visible": false
        },
        {
            "name": "id",
            "shape": "number",
            "visible": false
        },
        {
            "name": "title",
            "displayName": "Title",
            "shape": "string"
        },
        {
            "name": "url",
            "displayName": "URL",
            "shape": "string"
        },
        {
            "name": "folderTitle",
            "displayName": "Folder",
            "shape": "string"
        },
        {
            "name": "folderUid",
            "shape": "string",
            "visible": false
        },
        {
            "name": "tags",
            "displayName": "Tags",
            "shape": "string"
        },
        {
            "name": "isStarred",
            "displayName": "Starred",
            "shape": "string"
        },
        {
            "pattern": ".*"
        }
    ],
    "timeframes": false
}
