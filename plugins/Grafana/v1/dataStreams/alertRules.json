{
    "name": "alertRules",
    "displayName": "Alert Rules",
    "description": "All Grafana alerting rules, flattened from rule groups for import",
    "tags": ["Alerts"],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "paging": {
            "mode": "token",
            "pageSize": {
                "realm": {
                    "value": "queryArg",
                    "label": "Query parameter"
                },
                "path": "group_limit",
                "value": "100"
            },
            "in": {
                "realm": {
                    "value": "payload",
                    "label": "payload"
                },
                "path": "data.groupNextToken"
            },
            "out": {
                "realm": {
                    "value": "queryArg",
                    "label": "queryArg"
                },
                "path": "group_next_token"
            }
        },
        "endpointPath": "api/prometheus/grafana/api/v1/rules",
        "getArgs": [
            { "key": "exclude_alerts", "value": "true" }
        ],
        "postRequestScript": "importAlertRules.js"
    },
    "metadata": [
        { "name": "sourceId", "shape": "string", "visible": false },
        { "name": "name", "displayName": "Rule Name", "shape": "string" },
        { "name": "groupName", "displayName": "Group", "shape": "string" },
        { "name": "namespace", "displayName": "Namespace", "shape": "string" },
        { "name": "query", "displayName": "Query", "shape": "string" },
        { "name": "duration", "displayName": "Duration (s)", "shape": "number" },
        { "name": "labels", "displayName": "Labels", "shape": "string" },
        { "name": "annotations", "displayName": "Annotations", "shape": "string" }
    ],
    "timeframes": false
}
