{
    "name": "activeAlertsForDashboards",
    "displayName": "Dashboard Active Alerts",
    "description": "Currently firing alert instances for alert rules linked to selected Grafana dashboards",
    "tags": ["Alerts"],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "api/prometheus/grafana/api/v1/rules",
        "getArgs": [
            { "key": "dashboard_uid", "value": "{{object.rawId}}" }
        ],
        "postRequestScript": "activeAlerts.js"
    },
    "matches": {
        "sourceType": { "type": "oneOf", "values": ["Grafana Dashboard"] }
    },
    "timeframes": false
}
