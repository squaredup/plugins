{
    "name": "grafanaDashboardHealth",
    "displayName": "Dashboard Health",
    "description": "Recent alert state changes for a specific Grafana dashboard, showing which panels are alerting, pending, or OK",
    "tags": ["Health", "Alerts"],
    "baseDataSourceName": "httpRequestScopedSingle",
    "matches": {
        "sourceType": {
            "type": "equals",
            "value": "Grafana Dashboard"
        }
    },
    "config": {
        "httpMethod": "get",
        "paging": {
            "mode": "none"
        },
        "endpointPath": "api/annotations",
        "pathToData": "",
        "getArgs": [
            { "key": "dashboardUID", "value": "{{objects[0].dashboardUid}}" },
            { "key": "type", "value": "alert" },
            { "key": "limit", "value": "100" }
        ],
        "headers": []
    },
    "metadata": [
        {
            "name": "id",
            "shape": "number",
            "visible": false
        },
        {
            "name": "alertId",
            "shape": "number",
            "visible": false
        },
        {
            "name": "dashboardUID",
            "shape": "string",
            "visible": false
        },
        {
            "name": "panelId",
            "displayName": "Panel ID",
            "shape": "number"
        },
        {
            "name": "time",
            "displayName": "Timestamp",
            "shape": ["date", { "timeZone": "Etc/UTC" }]
        },
        {
            "name": "text",
            "displayName": "State",
            "shape": ["state", {
                "map": {
                    "success": ["OK", "Normal"],
                    "error": ["Alerting"],
                    "warning": ["Pending", "No Data"],
                    "unknown": [],
                    "unmonitored": []
                }
            }]
        },
        {
            "name": "tags",
            "displayName": "Tags",
            "shape": "string"
        },
        {
            "pattern": ".*"
        }
    ],
    "timeframes": false
}
