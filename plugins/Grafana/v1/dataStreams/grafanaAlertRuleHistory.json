{
    "name": "grafanaAlertRuleHistory",
    "displayName": "Alert History",
    "description": "State transition history for selected Grafana alert rules",
    "tags": ["Alerts"],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "api/v1/rules/history",
        "getArgs": [
            { "key": "ruleUID", "value": "{{object.ruleUID}}" },
            { "key": "from", "value": "{{timeframe.unixStart}}" },
            { "key": "to", "value": "{{timeframe.unixEnd}}" },
            { "key": "limit", "value": "5000" }
        ],
        "postRequestScript": "grafanaAlertRuleHistory.js"
    },
    "matches": {
        "sourceType": { "type": "oneOf", "values": ["Grafana Alert Rule"] }
    },
    "metadata": [
        { "name": "time", "displayName": "Time", "shape": "date", "role": "timestamp" },
        {
            "name": "current",
            "displayName": "State",
            "shape": ["state", {
                "map": {
                    "error": ["alerting", "Alerting", "firing", "Firing", "error", "Error"],
                    "warning": ["pending", "Pending", "nodata", "NoData"],
                    "success": ["inactive", "Inactive", "normal", "Normal", "normal (updated)", "Normal (Updated)", "resolved", "Resolved"]
                }
            }]
        },
        {
            "name": "previous",
            "displayName": "Previous State",
            "shape": ["state", {
                "map": {
                    "error": ["alerting", "Alerting", "firing", "Firing", "error", "Error"],
                    "warning": ["pending", "Pending", "nodata", "NoData"],
                    "success": ["inactive", "Inactive", "normal", "Normal", "normal (updated)", "Normal (Updated)", "resolved", "Resolved"]
                }
            }]
        },
        { "name": "condition", "displayName": "Condition", "shape": "string" },
        { "name": "conditionValue", "displayName": "Value", "shape": "number" },
        { "name": "dashboardName", "displayName": "Dashboard", "sourceId": "dashboardUID", "sourceType": "Grafana Dashboard", "objectPropertyPath": "name" },
        { "name": "currentInt", "displayName": "State (int)", "shape": "number", "role": "value", "visible": false },
        { "name": "previousInt", "displayName": "Previous State (int)", "shape": "number", "role": "value", "visible": false },
        { "name": "dashboardUID", "displayName": "Dashboard UID", "shape": "string", "visible": false }
        { "name": "dashboardUID", "displayName": "Dashboard UID", "shape": "string", "visible": false } 
    ],
    "timeframes": true
}
