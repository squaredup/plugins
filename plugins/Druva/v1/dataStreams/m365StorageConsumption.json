{
    "name": "m365StorageConsumption",
    "displayName": "Microsoft 365 Storage Consumption",
    "description": "Microsoft 365 backup storage consumption per customer, account and workload",
    "tags": [
        "Storage",
        "Customers"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "post",
        "endpointPath": "/msp/reporting/v2/reports/mspM365StorageConsumption",
        "postBody": {
            "filters": {
                "pageSize": 500
            }
        },
        "paging": {
            "mode": "token",
            "pageSize": {
                "realm": "none"
            },
            "in": {
                "realm": "payload",
                "path": "nextPageToken"
            },
            "out": {
                "realm": "body",
                "path": "pageToken"
            }
        },
        "postRequestScript": "m365StorageConsumption.js"
    },
    "matches": "none",
    "ui": [
        {
            "type": "objects",
            "name": "customer",
            "label": "Customer (optional)",
            "matches": {
                "sourceType": {
                    "type": "oneOf",
                    "values": [
                        "Customer"
                    ]
                }
            }
        }
    ],
    "metadata": [
        {
            "pattern": ".*"
        }
    ],
    "timeframes": false
}
