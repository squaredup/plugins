{
    "name": "m365StorageConsumption",
    "displayName": "Microsoft 365 Storage Consumption",
    "description": "Microsoft 365 backup storage consumption per customer, account and workload (optionally filtered to customers)",
    "tags": [
        "Storage",
        "Customers"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "post",
        "endpointPath": "/msp/reporting/v2/reports/mspM365StorageConsumption",
        "postBody": {
            "filters": {
                "pageSize": 500
            }
        },
        "paging": {
            "mode": "token",
            "pageSize": {
                "realm": "none"
            },
            "in": {
                "realm": "payload",
                "path": "nextPageToken"
            },
            "out": {
                "realm": "body",
                "path": "pageToken"
            }
        },
        "postRequestScript": "m365StorageConsumption.js"
    },
    "matches": "none",
    "ui": [
        {
            "type": "objects",
            "name": "customer",
            "label": "Customer (optional)",
            "matches": {
                "sourceType": {
                    "type": "oneOf",
                    "values": [
                        "Customer"
                    ]
                }
            }
        }
    ],
    "metadata": [
        {
            "name": "dcpUniqueKey",
            "displayName": "Record Key",
            "shape": "string",
            "visible": false
        },
        {
            "name": "customerGlobalId",
            "displayName": "Customer ID",
            "shape": "string",
            "visible": false
        },
        {
            "name": "customerName",
            "displayName": "Customer",
            "sourceId": "customerGlobalId",
            "sourceType": "Customer",
            "objectPropertyPath": "name"
        },
        {
            "name": "accountName",
            "displayName": "Account",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "workloadName",
            "displayName": "Workload",
            "shape": "string"
        },
        {
            "name": "resourceCount",
            "displayName": "Resources",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0,
                    "thousandsSeparator": true
                }
            ]
        },
        {
            "name": "enabled",
            "displayName": "Enabled Resources",
            "shape": [
                "number",
                {
                    "decimalPlaces": 0,
                    "thousandsSeparator": true
                }
            ]
        },
        {
            "name": "totalBackupData",
            "displayName": "Total Backup Data",
            "shape": "bytes",
            "role": "value"
        },
        {
            "name": "totalBackupDataGb",
            "displayName": "Total Backup Data (GiB)",
            "shape": [
                "number",
                {
                    "decimalPlaces": 4,
                    "thousandsSeparator": true
                }
            ]
        }
    ],
    "timeframes": false
}
