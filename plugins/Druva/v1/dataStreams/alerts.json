{
    "name": "alerts",
    "displayName": "Alerts",
    "description": "Endpoint alerts with their severity, entity and occurrence window (optionally filtered to customers)",
    "tags": [
        "Alerts",
        "Customers"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "post",
        "endpointPath": "/msp/reporting/v2/reports/mspEPAlert",
        "postBody": {
            "filters": {
                "pageSize": 500
            }
        },
        "paging": {
            "mode": "token",
            "pageSize": {
                "realm": "none"
            },
            "in": {
                "realm": "payload",
                "path": "nextPageToken"
            },
            "out": {
                "realm": "body",
                "path": "pageToken"
            }
        },
        "postRequestScript": "alerts.js"
    },
    "matches": "none",
    "metadata": [
        {
            "pattern": ".*"
        }
    ],
    "timeframes": false
}
