{
    "name": "druva",
    "displayName": "Druva",
    "version": "1.0.0",
    "author": { "name": "@vincentbabin", "type": "community" },
    "description": "Monitor Druva MSP customers, product tenants, consumption, backup activity and alerts.",
    "category": "Monitoring",
    "type": "hybrid",
    "schemaVersion": "2.1",
    "importNotSupported": false,
    "restrictedToPlatforms": [],
    "keywords": ["backup", "data protection", "msp", "managed services center", "druva", "phoenix", "insync"],
    "objectTypes": ["Customer", "Tenant"],
    "links": [
        {
            "category": "documentation",
            "url": "https://github.com/squaredup/plugins/blob/main/plugins/Druva/v1/docs/README.md",
            "label": "Help adding this plugin"
        },
        {
            "category": "source",
            "url": "https://github.com/squaredup/plugins/tree/main/plugins/Druva/v1",
            "label": "Repository"
        }
    ],
    "base": {
        "plugin": "WebAPI",
        "majorVersion": "1",
        "config": {
            "baseUrl": "https://apis.druva.com",
            "authMode": "oauth2",
            "oauth2GrantType": "clientCredentials",
            "oauth2TokenUrl": "https://apis.druva.com/msp/auth/v1/token",
            "oauth2ClientId": "{{clientId}}",
            "oauth2ClientSecret": "{{clientSecret}}",
            "oauth2ClientSecretLocationDuringAuth": "header",
            "headers": [{ "key": "Accept", "value": "application/json" }],
            "queryArgs": []
        }
    }
}
