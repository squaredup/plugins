{
    "name": "runbooks",
    "displayName": "Runbooks",
    "description": "Runbooks in a space, with their project and environment scope",
    "tags": [
        "Inventory"
    ],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "api/{{object.rawId}}/runbooks",
        "paging": {
            "mode": "offset",
            "pageSize": {
                "realm": "queryArg",
                "path": "take",
                "value": "250"
            },
            "offset": {
                "mode": "row",
                "base": 0,
                "rowCountIn": {
                    "realm": "payloadArraySize",
                    "path": "Items"
                }
            },
            "out": {
                "realm": "queryArg",
                "path": "skip"
            }
        },
        "pathToData": "Items"
    },
    "matches": {
        "sourceType": {
            "type": "oneOf",
            "values": [
                "Space"
            ]
        }
    },
    "visibility": {
        "type": "hidden"
    },
    "metadata": [
        {
            "name": "Id",
            "displayName": "ID",
            "shape": "string",
            "role": "id"
        },
        {
            "name": "Name",
            "displayName": "Name",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "Description",
            "displayName": "Description",
            "shape": "string"
        },
        {
            "name": "ProjectId",
            "displayName": "Project ID",
            "shape": "string"
        },
        {
            "name": "EnvironmentScope",
            "displayName": "Environment Scope",
            "shape": "string"
        },
        {
            "name": "MultiTenancyMode",
            "displayName": "Multi-Tenancy Mode",
            "shape": "string"
        },
        {
            "name": "PublishedRunbookSnapshotId",
            "displayName": "Published Snapshot ID",
            "shape": "string"
        },
        {
            "name": "SpaceId",
            "displayName": "Space ID",
            "shape": "string"
        },
        {
            "sourceId": "Id",
            "sourceType": "Runbook",
            "name": "Name"
        }
    ],
    "timeframes": false
}
