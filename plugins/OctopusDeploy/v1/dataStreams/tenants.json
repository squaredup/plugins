{
    "name": "tenants",
    "displayName": "Tenants",
    "description": "Tenants in a space, with tags and disabled status",
    "tags": [
        "Inventory"
    ],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "api/{{object.rawId}}/tenants",
        "paging": {
            "mode": "offset",
            "pageSize": {
                "realm": "queryArg",
                "path": "take",
                "value": "250"
            },
            "offset": {
                "mode": "row",
                "base": 0,
                "rowCountIn": {
                    "realm": "payloadArraySize",
                    "path": "Items"
                }
            },
            "out": {
                "realm": "queryArg",
                "path": "skip"
            }
        },
        "postRequestScript": "tenants.js"
    },
    "matches": {
        "sourceType": {
            "type": "oneOf",
            "values": [
                "Space"
            ]
        }
    },
    "visibility": {
        "type": "hidden"
    },
    "metadata": [
        {
            "name": "Id",
            "displayName": "ID",
            "shape": "string",
            "role": "id"
        },
        {
            "name": "Name",
            "displayName": "Name",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "Description",
            "displayName": "Description",
            "shape": "string"
        },
        {
            "name": "IsDisabled",
            "displayName": "Disabled",
            "shape": "boolean"
        },
        {
            "name": "TenantTags",
            "displayName": "Tags",
            "shape": ["array", { "itemShape": "string" }]
        },
        {
            "name": "SpaceId",
            "displayName": "Space ID",
            "shape": "string"
        },
        {
            "sourceId": "Id",
            "sourceType": "Tenant",
            "name": "Name"
        }
    ],
    "timeframes": false
}
