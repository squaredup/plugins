{
    "name": "projects",
    "displayName": "Projects",
    "description": "Projects in a space, with project group, lifecycle and disabled status",
    "tags": [
        "Inventory"
    ],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "api/{{object.rawId}}/projects",
        "paging": {
            "mode": "offset",
            "pageSize": {
                "realm": "queryArg",
                "path": "take",
                "value": "250"
            },
            "offset": {
                "mode": "row",
                "base": 0,
                "rowCountIn": {
                    "realm": "payloadArraySize",
                    "path": "Items"
                }
            },
            "out": {
                "realm": "queryArg",
                "path": "skip"
            }
        },
        "pathToData": "Items"
    },
    "matches": {
        "sourceType": {
            "type": "oneOf",
            "values": [
                "Space"
            ]
        }
    },
    "visibility": {
        "type": "hidden"
    },
    "metadata": [
        {
            "name": "Id",
            "displayName": "ID",
            "shape": "string",
            "role": "id"
        },
        {
            "name": "Name",
            "displayName": "Name",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "Slug",
            "displayName": "Slug",
            "shape": "string"
        },
        {
            "name": "Description",
            "displayName": "Description",
            "shape": "string"
        },
        {
            "name": "IsDisabled",
            "displayName": "Disabled",
            "shape": "boolean"
        },
        {
            "name": "ProjectGroupId",
            "displayName": "Project Group ID",
            "shape": "string"
        },
        {
            "name": "LifecycleId",
            "displayName": "Lifecycle ID",
            "shape": "string"
        },
        {
            "name": "SpaceId",
            "displayName": "Space ID",
            "shape": "string"
        },
        {
            "sourceId": "Id",
            "sourceType": "Project",
            "name": "Name"
        }
    ],
    "timeframes": false
}
