{
    "name": "environments",
    "displayName": "Environments",
    "description": "Environments in a space, in lifecycle sort order",
    "tags": [
        "Inventory"
    ],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "api/{{object.rawId}}/environments",
        "paging": {
            "mode": "offset",
            "pageSize": {
                "realm": "queryArg",
                "path": "take",
                "value": "250"
            },
            "offset": {
                "mode": "row",
                "base": 0,
                "rowCountIn": {
                    "realm": "payloadArraySize",
                    "path": "Items"
                }
            },
            "out": {
                "realm": "queryArg",
                "path": "skip"
            }
        },
        "pathToData": "Items"
    },
    "matches": {
        "sourceType": {
            "type": "oneOf",
            "values": [
                "Space"
            ]
        }
    },
    "visibility": {
        "type": "hidden"
    },
    "metadata": [
        {
            "name": "Id",
            "displayName": "ID",
            "shape": "string",
            "role": "id"
        },
        {
            "name": "Name",
            "displayName": "Name",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "Description",
            "displayName": "Description",
            "shape": "string"
        },
        {
            "name": "SortOrder",
            "displayName": "Sort Order",
            "shape": "number"
        },
        {
            "name": "UseGuidedFailure",
            "displayName": "Guided Failure",
            "shape": "boolean"
        },
        {
            "name": "SpaceId",
            "displayName": "Space ID",
            "shape": "string"
        },
        {
            "sourceId": "Id",
            "sourceType": "Environment",
            "name": "Name"
        }
    ],
    "timeframes": false
}
