{
    "name": "deploymentFreezes",
    "displayName": "Deployment Freezes",
    "description": "Deployment freezes that are active now or scheduled, with the projects, environments and tenants they block [expired freezes are excluded]",
    "tags": [
        "Deployments"
    ],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "get",
        "endpointPath": "api/deploymentfreezes",
        "postRequestScript": "deploymentFreezes.js",
        "getArgs": [
            {
                "key": "skip",
                "value": "0"
            },
            {
                "key": "take",
                "value": "1000"
            }
        ]
    },
    "matches": {
        "sourceType": {
            "type": "oneOf",
            "values": [
                "Space",
                "Project",
                "Environment",
                "Tenant"
            ]
        }
    },
    "metadata": [
        {
            "name": "name",
            "displayName": "Name",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "freezeState",
            "displayName": "Freeze State",
            "shape": [
                "state",
                {
                    "map": {
                        "error": [
                            "Active"
                        ],
                        "warning": [
                            "Scheduled"
                        ],
                        "success": [
                            "Expired"
                        ]
                    }
                }
            ]
        },
        {
            "name": "status",
            "displayName": "Status",
            "shape": "string"
        },
        {
            "name": "description",
            "displayName": "Description",
            "shape": "string"
        },
        {
            "name": "start",
            "displayName": "Start",
            "shape": "date"
        },
        {
            "name": "end",
            "displayName": "End",
            "shape": "date",
            "role": "timestamp"
        },
        {
            "name": "hoursRemaining",
            "displayName": "Hours Remaining",
            "shape": [
                "number",
                {
                    "decimalPlaces": 1
                }
            ]
        },
        {
            "name": "startsInHours",
            "displayName": "Starts In (Hours)",
            "shape": [
                "number",
                {
                    "decimalPlaces": 1
                }
            ]
        },
        {
            "name": "recurring",
            "displayName": "Recurring",
            "shape": "boolean"
        },
        {
            "name": "schedule",
            "displayName": "Schedule",
            "shape": "string"
        },
        {
            "name": "projectCount",
            "displayName": "Projects",
            "shape": "number"
        },
        {
            "name": "environmentCount",
            "displayName": "Environments",
            "shape": "number"
        },
        {
            "name": "tenantCount",
            "displayName": "Tenants",
            "shape": "number"
        },
        {
            "name": "scopeSummary",
            "displayName": "Scope",
            "shape": "string"
        },
        {
            "name": "id",
            "displayName": "ID",
            "shape": "string",
            "role": "id",
            "visible": false
        }
    ],
    "timeframes": false
}
