{
    "name": "octopus-deploy",
    "displayName": "Octopus Deploy",
    "version": "1.0.0",
    "author": {
        "name": "@clarkd",
        "type": "community"
    },
    "description": "Track deployment status, release history, task queues and deployment target health across your Octopus Deploy spaces.",
    "category": "CI/CD Tools",
    "type": "hybrid",
    "schemaVersion": "2.1",
    "importNotSupported": false,
    "restrictedToPlatforms": [],
    "keywords": [
        "octopus",
        "octopus deploy",
        "deployment",
        "release",
        "continuous delivery",
        "cd",
        "devops",
        "runbook",
        "tentacle",
        "worker",
        "certificate",
        "deployment freeze",
        "audit"
    ],
    "objectTypes": [
        "Space",
        "Project",
        "Environment",
        "Deployment Target",
        "Tenant",
        "Runbook",
        "Worker Pool",
        "Worker"
    ],
    "links": [
        {
            "category": "documentation",
            "url": "https://github.com/squaredup/plugins/blob/main/plugins/OctopusDeploy/v1/docs/README.md",
            "label": "Help adding this plugin"
        },
        {
            "category": "source",
            "url": "https://github.com/squaredup/plugins/tree/main/plugins/OctopusDeploy/v1",
            "label": "Repository"
        }
    ],
    "base": {
        "plugin": "WebAPI",
        "majorVersion": "1",
        "config": {
            "baseUrl": "{{ serverUrl.trim().replace(/[/]+$/, '').replace(/[/]api$/i, '') }}",
            "authMode": "none",
            "headers": [
                {
                    "key": "X-Octopus-ApiKey",
                    "value": "{{ apiKey.trim() }}"
                },
                {
                    "key": "Accept",
                    "value": "application/json"
                }
            ],
            "queryArgs": []
        }
    },
    "screenshots": [
        "https://github.com/squaredup/plugins/blob/main/plugins/OctopusDeploy/v1/screenshots/overview.png",
        "https://github.com/squaredup/plugins/blob/main/plugins/OctopusDeploy/v1/screenshots/tasks.png",
        "https://github.com/squaredup/plugins/blob/main/plugins/OctopusDeploy/v1/screenshots/infrastructure.png",
        "https://github.com/squaredup/plugins/blob/main/plugins/OctopusDeploy/v1/screenshots/project.png",
        "https://github.com/squaredup/plugins/blob/main/plugins/OctopusDeploy/v1/screenshots/runbook.png"
    ]
}
