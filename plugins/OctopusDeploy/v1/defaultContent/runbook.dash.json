                                "status": {
                                    "field": "status",
                                    "type": "nominal"
                                },
                                "value": {
                                    "field": "detail",
                                    "type": "nominal"
                                }
                            },
                            "style": {
                                "statusGridColumnsPerRow": 6,
                                "statusGridBlockGap": 8,
                                "statusGridMaxBlockHeight": 110,
                                "statusGridOrderByField": "environmentSortOrder",
                                "statusGridOrderDirection": "asc"
                            }
                        }
                    }
                }
            },
            {
