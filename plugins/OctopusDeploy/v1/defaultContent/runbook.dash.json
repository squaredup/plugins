                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[runbookStatus]}}",
                        "name": "runbookStatus",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Octopus Runbooks]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Octopus Runbook]}}"
                    },
                    "variables": [
                        "{{variables.[Octopus Runbook]}}"
                    ],
