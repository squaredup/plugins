            {
                "i": "503138d4-fe67-4eba-aa1c-61600628426d",
                "x": 2,
                "y": 2,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Failed Runs",
                    "description": "",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[tasks]}}",
                        "name": "tasks",
                        "pluginConfigId": "{{configId}}",
                        "filter": {
                            "multiOperation": "or",
                            "filters": [
                                {
                                    "column": "State",
                                    "operation": "equals",
                                    "value": "Failed"
                                },
                                {
                                    "column": "State",
                                    "operation": "equals",
                                    "value": "TimedOut"
                                }
                            ]
                        },
                        "group": {
                            "by": [],
                            "aggregate": [
                                {
                                    "type": "count"
                                }
                            ]
                        }
                    },
                    "scope": {
                        "scope": "{{scopes.[Octopus Runbooks]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Octopus Runbook]}}"
                    },
                    "variables": [
                        "{{variables.[Octopus Runbook]}}"
                    ],
                    "visualisation": {
                        "type": "data-stream-scalar",
                        "config": {
                            "data-stream-scalar": {
                                "value": "count",
                                "comparisonColumn": "none",
                                "label": "Failed"
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    {
                                        "field": "count",
                                        "type": "quantitative",
                                        "title": "Failed"
                                    }
                                ]
                            },
                            "style": {
                                "scalarLabelText": "Failed",
                                "scalarValueColor": "#d63939"
                            }
                        }
                    }
                }
            },
            {
                "i": "28959f49-1123-4645-aa88-91b072444d5e",
                "x": 3,
                "y": 2,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Mean Duration",
                    "description": "",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[tasks]}}",
                        "name": "tasks",
                        "pluginConfigId": "{{configId}}",
                        "group": {
                            "by": [],
                            "aggregate": [
                                {
                                    "type": "mean",
                                    "names": [
                                        "durationSeconds"
                                    ]
                                }
                            ]
                        }
                    },
                    "scope": {
                        "scope": "{{scopes.[Octopus Runbooks]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Octopus Runbook]}}"
                    },
                    "variables": [
                        "{{variables.[Octopus Runbook]}}"
                    ],
                    "visualisation": {
                        "type": "data-stream-scalar",
                        "config": {
                            "data-stream-scalar": {
                                "value": "durationSeconds_mean",
                                "comparisonColumn": "none",
                                "label": "Mean duration"
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    {
                                        "field": "durationSeconds_mean",
                                        "type": "quantitative",
                                        "title": "Mean duration"
                                    }
                                ]
                            },
                            "style": {
                                "scalarLabelText": "Mean duration"
                            }
                        }
                    }
                }
            },
            {
                "i": "0a73d975-b3ca-4b10-a11c-0399121a35ee",
                "x": 0,
                "y": 4,
                "w": 4,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Runs Over Time",
                    "description": "",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[tasks]}}",
                        "name": "tasks",
                        "pluginConfigId": "{{configId}}",
                        "group": {
                            "by": [
                                [
                                    "QueueTime",
                                    "byDay"
                                ],
                                [
                                    "State",
                                    "uniqueValues"
                                ]
                            ],
                            "aggregate": [
                                {
                                    "type": "count"
                                }
                            ]
                        }
                    },
                    "scope": {
                        "scope": "{{scopes.[Octopus Runbooks]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Octopus Runbook]}}"
                    },
                    "variables": [
                        "{{variables.[Octopus Runbook]}}"
                    ],
                    "visualisation": {
                        "type": "data-stream-bar-chart",
                        "config": {
                            "data-stream-bar-chart": {
                                "xAxisData": "QueueTime_byDay",
                                "yAxisData": [
                                    "count"
                                ],
                                "xAxisGroup": "none",
                                "xAxisLabel": "",
                                "yAxisLabel": "",
                                "showXAxisLabel": false,
                                "showYAxisLabel": false,
                                "showLegend": false,
                                "legendPosition": "bottom",
                                "showGrid": true,
                                "horizontalLayout": "vertical",
                                "displayMode": "actual",
                                "showTotals": false,
                                "showValue": false,
                                "grouping": false,
                                "range": {
                                    "type": "auto"
                                }
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "QueueTime_byDay",
                                    "type": "temporal",
                                    "title": "Day"
                                },
                                "y": {
                                    "field": "count",
                                    "type": "quantitative",
                                    "title": "Runs"
                                },
                                "series": {
                                    "field": "State_uniqueValues",
                                    "type": "nominal",
                                    "title": "Outcome"
                                }
                            },
                            "style": {
                                "cartesianStack": "on",
                                "cartesianBarBorderRadius": 4,
                                "mappedColors": {
                                    "Success": "#2fb344",
                                    "Failed": "#d63939",
                                    "TimedOut": "#d63939",
                                    "Canceled": "#f59f00",
                                    "Cancelling": "#f59f00",
                                    "Queued": "#6b7280",
                                    "Executing": "#2F93E0"
                                },
                                "legendPosition": "bottom"
                            }
                        }
                    }
                }
            },
            {
                "i": "520a21ce-3328-447d-98b1-50c1b0305514",
                "x": 0,
                "y": 7,
                "w": 4,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Recent Runs",
                    "description": "",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[tasks]}}",
                        "name": "tasks",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [
                                [
                                    "QueueTime",
                                    "desc"
                                ]
                            ]
                        }
                    },
                    "scope": {
                        "scope": "{{scopes.[Octopus Runbooks]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Octopus Runbook]}}"
                    },
                    "variables": [
                        "{{variables.[Octopus Runbook]}}"
                    ],
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": [
                                    "QueueTime",
                                    "Description",
                                    "Name",
                                    "status",
                                    "durationSeconds"
                                ]
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "QueueTime",
                                        "title": "Queued",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    },
                                    {
                                        "field": "Description",
                                        "title": "Task",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "State",
                                        "title": "State",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "Success": "#2fb344",
                                                "Failed": "#d63939",
                                                "TimedOut": "#d63939",
                                                "Canceled": "#f59f00",
                                                "Cancelling": "#f59f00",
                                                "Queued": "#6b7280",
                                                "Executing": "#2F93E0"
                                            },
                                            "defaultColor": "#6b7280"
                                        }
                                    },
                                    {
                                        "field": "queuedSeconds",
                                        "title": "Waited",
                                        "renderer": {
                                            "type": "number",
                                            "suffix": " s",
                                            "decimals": 0
                                        }
                                    },
                                    {
                                        "field": "durationSeconds",
                                        "title": "Duration",
                                        "renderer": {
                                            "type": "bar",
                                            "color": "#2F93E0"
                                        }
                                    },
                                    {
                                        "field": "HasPendingInterruptions",
                                        "title": "Needs Input",
                                        "renderer": {
                                            "type": "boolean",
                                            "trueLabel": "Yes",
                                            "falseLabel": "",
                                            "trueColor": "#f59f00"
                                        }
                                    },
                                    {
                                        "field": "ErrorMessage",
                                        "title": "Error",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableCellPadding": 6
                            }
                        }
                    }
                }
            },
            {
                "i": "8fd17983-7672-4567-8e3f-dc0db7c8e6c4",
                "x": 0,
                "y": 11,
                "w": 4,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Audit Trail",
                    "description": "Edits, snapshots and runs of this runbook",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[auditEvents]}}",
                        "name": "auditEvents",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [
                                [
                                    "Occurred",
                                    "desc"
                                ]
                            ]
                        }
                    },
                    "scope": {
                        "scope": "{{scopes.[Octopus Runbooks]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Octopus Runbook]}}"
                    },
                    "variables": [
                        "{{variables.[Octopus Runbook]}}"
                    ],
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": [
                                    "Occurred",
                                    "Username",
                                    "Category",
                                    "Message"
                                ]
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "Occurred",
                                        "title": "When",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    },
                                    {
                                        "field": "Username",
                                        "title": "User",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "Category",
                                        "title": "Category",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "*Failed": "#d63939",
                                                "Deleted": "#d63939",
                                                "Created": "#2fb344",
                                                "Modified": "#2F93E0",
                                                "*Succeeded": "#2fb344"
                                            },
                                            "defaultColor": "#6b7280"
                                        }
                                    },
                                    {
                                        "field": "Message",
                                        "title": "Event",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "IpAddress",
                                        "title": "IP Address",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableCellPadding": 6,
                                "richTableWrapText": true
                            }
                        }
                    }
                }
            }
        ]
    }
}
