{
    "name": "Deployment Target",
    "schemaVersion": "1.5",
    "timeframe": "last24hours",
    "variables": [
        "{{variables.[Octopus Deployment Target]}}"
    ],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "d27a1891-9856-4f1a-ac09-de51a39433a0",
                "x": 0,
                "y": 0,
                "w": 1,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Target Properties",
                    "description": "",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "datastream-properties",
                        "name": "properties",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Octopus Deployment Targets]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Octopus Deployment Target]}}"
                    },
                    "variables": [
                        "{{variables.[Octopus Deployment Target]}}"
                    ],
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": true,
                                "columnOrder": [
                                    "name"
                                ],
                                "hiddenColumns": [
                                    "id",
                                    "links",
                                    "type",
                                    "label",
                                    "sourceId",
                                    "sourceType",
                                    "spaceId"
                                ]
                            }
                        }
                    }
                }
            },
            {
                "i": "042fa868-6f44-423e-964c-4c018ad99587",
                "x": 1,
                "y": 0,
                "w": 1,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Health",
                    "description": "",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[deploymentTargets]}}",
                        "name": "deploymentTargets",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Octopus Deployment Targets]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Octopus Deployment Target]}}"
                    },
                    "variables": [
                        "{{variables.[Octopus Deployment Target]}}"
                    ],
                    "visualisation": {
                        "type": "data-stream-blocks",
                        "config": {
                            "data-stream-blocks": {
                                "labelColumn": "Name",
                                "stateColumn": "health",
                                "sublabel": "HealthStatus",
                                "linkColumn": "none",
                                "columns": 4
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "statusGrid",
                            "encoding": {
                                "label": {
                                    "field": "Name",
                                    "type": "nominal"
                                },
                                "status": {
                                    "field": "health",
                                    "type": "nominal"
                                },
                                "value": {
                                    "field": "HealthStatus",
                                    "type": "nominal"
                                }
                            },
                            "style": {
                                "statusGridColumnsPerRow": 1,
                                "statusGridBlockGap": 8,
                                "statusGridMaxBlockHeight": 110
                            }
                        }
                    }
                }
            },
            {
                "i": "a8deeab4-488a-4616-af1b-2831de3448f2",
                "x": 2,
                "y": 0,
                "w": 2,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Target Details",
                    "description": "",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[deploymentTargets]}}",
                        "name": "deploymentTargets",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Octopus Deployment Targets]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Octopus Deployment Target]}}"
                    },
                    "variables": [
                        "{{variables.[Octopus Deployment Target]}}"
                    ],
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": true,
                                "columnOrder": [
                                    "Name",
                                    "health",
                                    "StatusSummary",
                                    "Roles",
                                    "CommunicationStyle",
                                    "OperatingSystem"
                                ]
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "health",
                                        "title": "Health",
                                        "renderer": {
                                            "type": "status"
                                        }
                                    },
                                    {
                                        "field": "StatusSummary",
                                        "title": "Status",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "Roles",
                                        "title": "Target Tags",
                                        "renderer": {
                                            "type": "tag-list",
                                            "separator": ",",
                                            "color": "#2F93E0"
                                        }
                                    },
                                    {
                                        "field": "CommunicationStyle",
                                        "title": "Communication",
                                        "renderer": {
                                            "type": "badge",
                                            "defaultColor": "#6b7280"
                                        }
                                    },
                                    {
                                        "field": "OperatingSystem",
                                        "title": "Operating System",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "ShellName",
                                        "title": "Shell",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "IsDisabled",
                                        "title": "Disabled",
                                        "renderer": {
                                            "type": "boolean",
                                            "trueLabel": "Yes",
                                            "falseLabel": "No"
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableCellPadding": 6,
                                "richTableTranspose": true,
                                "richTableWrapText": true
                            }
                        }
                    }
                }
            }
        ]
    }
}
