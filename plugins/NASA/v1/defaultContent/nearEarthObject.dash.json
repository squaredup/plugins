                                            "trueLabel": "Yes",
                                            "falseLabel": "No",
                                            "trueColor": "inherit",
                                            "falseColor": "inherit"
                                        }
                                    },
                                    {
                                        "field": "is_sentry_object",
                                        "title": "Sentry Object",
                                        "renderer": {
                                            "type": "boolean",
                                            "trueLabel": "Yes",
                                            "falseLabel": "No",
                                            "trueColor": "inherit",
                                            "falseColor": "inherit"
                                        }
                                    },
                                    {
                                        "field": "estimated_diameter_min_km",
                                        "title": "Est. Diameter Min (km)",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "estimated_diameter_max_km",
                                        "title": "Est. Diameter Max (km)",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "close_approach_count",
                                        "title": "Close Approach Count",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableTranspose": true
                            }
                        }
                    }
                }
            },
            {
                "i": "ad14ea42-cb61-4276-a8aa-c8650a49abed",
