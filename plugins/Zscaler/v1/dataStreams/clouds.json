{
    "name": "clouds",
    "displayName": "Clouds",
    "description": "Zscaler clouds listed on the selected Trust portal",
    "tags": [
        "Status"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "api/global",
        "pathToData": "data.clouds",
        "paging": {
            "mode": "none"
        }
    },
    "matches": "none",
    "visibility": {
        "type": "hidden"
    },
    "metadata": [
        {
            "name": "title",
            "displayName": "Cloud",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "machine_name",
            "displayName": "Cloud Code",
            "shape": "string"
        },
        {
            "name": "domain",
            "displayName": "Domain",
            "shape": "string"
        },
        {
            "name": "value",
            "displayName": "Value",
            "computed": true,
            "valueExpression": "{{ $['machine_name'] + '|' + $['domain'] }}",
            "shape": "string",
            "role": "value",
            "visible": false
        },
        {
            "name": "type",
            "displayName": "Product",
            "shape": "string"
        }
    ],
    "timeframes": false
}
