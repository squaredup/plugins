{
    "name": "Virtual Machine",
    "schemaVersion": "1.5",
    "timeframe": "last30days",
    "variables": [
        "{{variables.[NetBox Virtual Machine]}}"
    ],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "c503a756-16b7-42c7-9984-7c51b9348e52",
                "x": 0,
                "y": 0,
                "w": 1,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Virtual Machine Properties",
                    "description": "",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "datastream-properties",
                        "name": "properties",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[NetBox Virtual Machines]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[NetBox Virtual Machine]}}"
                    },
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": true,
                                "columnOrder": [
                                    "name"
                                ],
                                "hiddenColumns": [
                                    "id",
                                    "links",
                                    "type",
                                    "label",
                                    "sourceId",
                                    "sourceType",
                                    "siteId",
                                    "rackId",
                                    "vrfId"
                                ]
                            }
                        }
                    },
                    "variables": [
                        "{{variables.[NetBox Virtual Machine]}}"
                    ]
                }
            },
            {
                "i": "e2d657f2-5dcb-492a-bee7-dd1673bdcdca",
                "x": 1,
                "y": 0,
                "w": 3,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "IP Addresses",
                    "description": "",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[ipAddresses]}}",
                        "name": "ipAddresses",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "virtualMachine": {
                                "variable": "{{variables.[NetBox Virtual Machine]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[NetBox Virtual Machines]}}"
                            }
                        },
                        "sort": {
                            "by": [
                                [
                                    "address",
                                    "asc"
                                ]
                            ]
                        }
                    },
                    "variables": [
                        "{{variables.[NetBox Virtual Machine]}}"
                    ],
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": [
                                    "address",
                                    "status.label",
                                    "vrfName",
                                    "dns_name",
                                    "assignedTo",
                                    "tenant.name",
                                    "description",
                                    "display_url"
                                ],
                                "hiddenColumns": [
                                    "display",
                                    "created",
                                    "family.label",
                                    "assigned",
                                    "role.label"
                                ]
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "display_url",
                                        "title": "Address",
                                        "renderer": {
                                            "type": "link",
                                            "labelField": "address"
                                        }
                                    },
                                    {
                                        "field": "status.label",
                                        "title": "Status",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "Active": "#2fb344",
                                                "Reserved": "#17a2b8",
                                                "Deprecated": "#d63939",
                                                "DHCP": "#2fb344",
                                                "SLAAC": "#2fb344"
                                            }
                                        }
                                    },
                                    {
                                        "field": "vrfName",
                                        "title": "VRF",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "dns_name",
                                        "title": "DNS Name",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "assignedTo",
                                        "title": "Assigned To",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "tenant.name",
                                        "title": "Tenant",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "description",
                                        "title": "Description",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    }
                                ]
                            }
                        }
                    }
                }
            },
            {
                "i": "26dcc49b-a0e9-4fee-8ce1-87892ec65583",
                "x": 0,
                "y": 4,
                "w": 4,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Change Log",
                    "description": "Changes recorded against this virtual machine",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[objectChanges]}}",
                        "name": "objectChanges",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "object": {
                                "variable": "{{variables.[NetBox Virtual Machine]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[NetBox Virtual Machines]}}"
                            }
                        },
                        "sort": {
                            "by": [
                                [
                                    "time",
                                    "desc"
                                ]
                            ]
                        }
                    },
                    "variables": [
                        "{{variables.[NetBox Virtual Machine]}}"
                    ],
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": [
                                    "time",
                                    "user_name",
                                    "action.label",
                                    "object_repr",
                                    "message"
                                ],
                                "hiddenColumns": [
                                    "changed_object_type"
                                ]
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "time",
                                        "title": "Time",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    },
                                    {
                                        "field": "user_name",
                                        "title": "User",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "action.label",
                                        "title": "Action",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "Created": "#2fb344",
                                                "Updated": "#206bc4",
                                                "Deleted": "#d63939"
                                            }
                                        }
                                    },
                                    {
                                        "field": "object_repr",
                                        "title": "Object",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "message",
                                        "title": "Message",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    }
                                ]
                            }
                        }
                    }
                }
            }
        ]
    }
}
