{
    "name": "Prefix",
    "schemaVersion": "1.5",
    "timeframe": "last30days",
    "variables": [
        "{{variables.[NetBox Prefix]}}"
    ],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "9881a921-a9e3-4856-be7b-7f26ef11ec5c",
                "x": 0,
                "y": 0,
                "w": 1,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Prefix Properties",
                    "description": "",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "datastream-properties",
                        "name": "properties",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[NetBox Prefixes]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[NetBox Prefix]}}"
                    },
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": true,
                                "columnOrder": [
                                    "name"
                                ],
                                "hiddenColumns": [
                                    "id",
                                    "links",
                                    "type",
                                    "label",
                                    "sourceId",
                                    "sourceType",
                                    "siteId",
                                    "rackId",
                                    "vrfId"
                                ]
                            }
                        }
                    },
                    "variables": [
                        "{{variables.[NetBox Prefix]}}"
                    ]
                }
            },
            {
                "i": "bf430aa6-68da-4fd3-90db-d202d90cbab1",
                "x": 1,
                "y": 0,
                "w": 1,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Prefix Utilization",
                    "description": "",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[prefixUtilization]}}",
                        "name": "prefixUtilization",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[NetBox Prefixes]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[NetBox Prefix]}}"
                    },
                    "visualisation": {
                        "type": "data-stream-gauge",
                        "config": {
                            "data-stream-gauge": {
                                "value": {
                                    "type": "mean",
                                    "columns": [
                                        "utilization"
                                    ]
                                },
                                "label": "Utilization (%)",
                                "minimum": 0,
                                "maximum": 100
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "gauge",
                            "encoding": {
                                "value": {
                                    "field": "utilization",
                                    "type": "quantitative",
                                    "title": "Utilization"
                                }
                            },
                            "style": {
                                "gaugeLabelText": "Utilization",
                                "gaugeBands": [
                                    {
                                        "to": 0.8,
                                        "color": "#2fb344"
                                    },
                                    {
                                        "to": 0.9,
                                        "color": "#f59f00"
                                    },
                                    {
                                        "to": 1,
                                        "color": "#d63939"
                                    }
                                ]
                            }
                        }
                    },
                    "variables": [
                        "{{variables.[NetBox Prefix]}}"
                    ]
                }
            },
            {
                "i": "b2b3dfa7-52c7-4065-8198-23466cb00eb0",
                "x": 2,
                "y": 0,
                "w": 2,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Address Space",
                    "description": "",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[prefixUtilization]}}",
                        "name": "prefixUtilization",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[NetBox Prefixes]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[NetBox Prefix]}}"
                    },
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": true,
                                "columnOrder": [
                                    "prefix",
                                    "vrf",
                                    "status",
                                    "size",
                                    "used",
                                    "utilization",
                                    "netboxUrl"
                                ],
                                "hiddenColumns": []
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "scalar",
                            "encoding": {
                                "values": [
                                    {
                                        "field": "size",
                                        "type": "quantitative",
                                        "title": "Addresses"
                                    },
                                    {
                                        "field": "used",
                                        "type": "quantitative",
                                        "title": "Used"
                                    },
                                    {
                                        "field": "utilization",
                                        "type": "quantitative",
                                        "title": "Utilization"
                                    }
                                ]
                            },
                            "style": {
                                "scalarBoxWidth": 300,
                                "scalarBoxHeight": 220,
                                "scalarFontSize": 56
                            }
                        }
                    },
                    "variables": [
                        "{{variables.[NetBox Prefix]}}"
                    ]
                }
            },
            {
                "i": "17000eb1-6f73-4ba6-981f-b9bacd2d6ff4",
                "x": 0,
                "y": 3,
                "w": 4,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "IP Addresses in Prefix",
                    "description": "",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[ipAddresses]}}",
                        "name": "ipAddresses",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "prefix": {
                                "variable": "{{variables.[NetBox Prefix]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[NetBox Prefixes]}}"
                            }
                        },
                        "sort": {
                            "by": [
                                [
                                    "address",
                                    "asc"
                                ]
                            ]
                        }
                    },
                    "variables": [
                        "{{variables.[NetBox Prefix]}}"
                    ],
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": [
                                    "address",
                                    "status.label",
                                    "vrfName",
                                    "dns_name",
                                    "assignedTo",
                                    "tenant.name",
                                    "description",
                                    "display_url"
                                ],
                                "hiddenColumns": [
                                    "display",
                                    "created",
                                    "family.label",
                                    "assigned",
                                    "role.label"
                                ]
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "display_url",
                                        "title": "Address",
                                        "renderer": {
                                            "type": "link",
                                            "labelField": "address"
                                        }
                                    },
                                    {
                                        "field": "status.label",
                                        "title": "Status",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "Active": "#2fb344",
                                                "Reserved": "#17a2b8",
                                                "Deprecated": "#d63939",
                                                "DHCP": "#2fb344",
                                                "SLAAC": "#2fb344"
                                            }
                                        }
                                    },
                                    {
                                        "field": "vrfName",
                                        "title": "VRF",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "dns_name",
                                        "title": "DNS Name",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "assignedTo",
                                        "title": "Assigned To",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "tenant.name",
                                        "title": "Tenant",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "description",
                                        "title": "Description",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    }
                                ]
                            }
                        }
                    }
                }
            },
            {
                "i": "892f873a-2e86-400d-9414-d1d02025fe83",
                "x": 0,
                "y": 7,
                "w": 4,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Change Log",
                    "description": "Changes recorded against this prefix",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[objectChanges]}}",
                        "name": "objectChanges",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "object": {
                                "variable": "{{variables.[NetBox Prefix]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[NetBox Prefixes]}}"
                            }
                        },
                        "sort": {
                            "by": [
                                [
                                    "time",
                                    "desc"
                                ]
                            ]
                        }
                    },
                    "variables": [
                        "{{variables.[NetBox Prefix]}}"
                    ],
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": [
                                    "time",
                                    "user_name",
                                    "action.label",
                                    "object_repr",
                                    "message"
                                ],
                                "hiddenColumns": [
                                    "changed_object_type"
                                ]
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "time",
                                        "title": "Time",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    },
                                    {
                                        "field": "user_name",
                                        "title": "User",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "action.label",
                                        "title": "Action",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "Created": "#2fb344",
                                                "Updated": "#206bc4",
                                                "Deleted": "#d63939"
                                            }
                                        }
                                    },
                                    {
                                        "field": "object_repr",
                                        "title": "Object",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "message",
                                        "title": "Message",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    }
                                ]
                            }
                        }
                    }
                }
            }
        ]
    }
}
