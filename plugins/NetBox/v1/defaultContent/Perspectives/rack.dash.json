                                "hiddenColumns": [
                                    "rack",
                                    "site",
                                    "isTopUnit",
                                    "occupied"
                                ]
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "unit",
                                        "title": "Unit",
                                        "renderer": {
                                            "type": "number"
                                        },
                                        "align": "right",
                                        "width": 70
                                    },
                                    {
                                        "field": "device",
                                        "title": "Device",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "role",
                                        "title": "Role",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "deviceType",
                                        "title": "Device Type",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "manufacturer",
                                        "title": "Manufacturer",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "face",
                                        "title": "Face",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "deviceHeight",
                                        "title": "Height (U)",
                                        "renderer": {
                                            "type": "number"
                                        },
                                        "align": "right"
                                    },
                                    {
                                        "field": "unitsLabel",
                                        "title": "Device Units",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableCellPadding": 4
                            }
                        }
                    }
                }
            },
