                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Devices by Role in Rack",
                    "description": "",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[devices]}}",
                        "name": "devices",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "rack": {
                                "variable": "{{variables.[NetBox Rack]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[NetBox Racks]}}"
                            }
                        },
                        "group": {
                            "by": [
                                [
                                    "role.name",
                                    "uniqueValues"
                                ]
                            ],
                            "aggregate": [
                                {
                                    "type": "count"
                                }
                            ]
                        },
                        "sort": {
                            "by": [
                                [
                                    "count",
                                    "desc"
                                ]
                            ]
                        }
                    },
                    "variables": [
                        "{{variables.[NetBox Rack]}}"
                    ],
                    "visualisation": {
                        "type": "data-stream-bar-chart",
                        "config": {
                            "data-stream-bar-chart": {
                                "xAxisData": "role.name_uniqueValues",
                                "yAxisData": [
                                    "count"
                                ],
                                "xAxisGroup": "none",
                                "xAxisLabel": "",
                                "yAxisLabel": "",
                                "showXAxisLabel": false,
                                "showYAxisLabel": false,
                                "showLegend": false,
                                "legendPosition": "bottom",
                                "showGrid": true,
                                "horizontalLayout": "horizontal",
                                "displayMode": "actual",
                                "showTotals": false,
                                "showValue": false,
                                "grouping": false,
                                "range": {
                                    "type": "auto"
                                }
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "role.name_uniqueValues",
                                    "type": "nominal",
                                    "title": "Role"
                                },
                                "y": {
                                    "field": "count",
                                    "type": "quantitative",
                                    "title": "Devices"
                                }
                            },
                            "style": {
                                "cartesianHorizontal": true
                            }
                        }
                    }
                }
            },
            {
                "i": "16624438-7872-4cf0-a871-44954036cc69",
                "x": 0,
                "y": 6,
                "w": 4,
                "h": 9,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Rack Elevation",
                    "description": "Each rack unit from the top down, with the device mounted at it. Empty units are listed; 0U, child and unracked devices follow the units.",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[rackElevation]}}",
                        "name": "rackElevation",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "rack": {
                                "variable": "{{variables.[NetBox Rack]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[NetBox Racks]}}"
                            }
                        },
                        "sort": {
                            "by": [
                                [
                                    "order",
                                    "asc"
                                ]
                            ]
                        }
                    },
                    "variables": [
                        "{{variables.[NetBox Rack]}}"
                    ],
                    "visualisation": {
                        "type": "data-stream-table",
