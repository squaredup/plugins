{
    "name": "Circuit",
    "schemaVersion": "1.5",
    "timeframe": "last30days",
    "variables": [
        "{{variables.[NetBox Circuit]}}"
    ],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "783841cf-dd6e-4715-9a54-7b8479b8c2a3",
                "x": 0,
                "y": 0,
                "w": 1,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Circuit Properties",
                    "description": "",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "datastream-properties",
                        "name": "properties",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[NetBox Circuits]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[NetBox Circuit]}}"
                    },
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": true,
                                "columnOrder": [
                                    "name"
                                ],
                                "hiddenColumns": [
                                    "id",
                                    "links",
                                    "type",
                                    "label",
                                    "sourceId",
                                    "sourceType",
                                    "siteId",
                                    "rackId",
                                    "vrfId"
                                ]
                            }
                        }
                    },
                    "variables": [
                        "{{variables.[NetBox Circuit]}}"
                    ]
                }
            },
            {
                "i": "af52a83e-2c86-4c5b-a474-42ac34a20a27",
                "x": 1,
                "y": 0,
                "w": 3,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Change Log",
                    "description": "Changes recorded against this circuit",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[objectChanges]}}",
                        "name": "objectChanges",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "object": {
                                "variable": "{{variables.[NetBox Circuit]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[NetBox Circuits]}}"
                            }
                        },
                        "sort": {
                            "by": [
                                [
                                    "time",
                                    "desc"
                                ]
                            ]
                        }
                    },
                    "variables": [
                        "{{variables.[NetBox Circuit]}}"
                    ],
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": [
                                    "time",
                                    "user_name",
                                    "action.label",
                                    "object_repr",
                                    "message"
                                ],
                                "hiddenColumns": [
                                    "changed_object_type"
                                ]
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "time",
                                        "title": "Time",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    },
                                    {
                                        "field": "user_name",
                                        "title": "User",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "action.label",
                                        "title": "Action",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "Created": "#2fb344",
                                                "Updated": "#206bc4",
                                                "Deleted": "#d63939"
                                            }
                                        }
                                    },
                                    {
                                        "field": "object_repr",
                                        "title": "Object",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "message",
                                        "title": "Message",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    }
                                ]
                            }
                        }
                    }
                }
            }
        ]
    }
}
