{
    "name": "Device",
    "schemaVersion": "1.5",
    "timeframe": "last30days",
    "variables": [
        "{{variables.[NetBox Device]}}"
    ],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "5d69700a-0cfb-401a-a8f1-a384fe86db5f",
                "x": 0,
                "y": 0,
                "w": 1,
                "h": 5,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Device Properties",
                    "description": "",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "datastream-properties",
                        "name": "properties",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[NetBox Devices]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[NetBox Device]}}"
                    },
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": true,
                                "columnOrder": [
                                    "name"
                                ],
                                "hiddenColumns": [
                                    "id",
                                    "links",
                                    "type",
                                    "label",
                                    "sourceId",
                                    "sourceType",
                                    "siteId",
                                    "rackId",
                                    "vrfId"
                                ]
                            }
                        }
                    },
                    "variables": [
                        "{{variables.[NetBox Device]}}"
                    ]
                }
            },
            {
                "i": "586308e3-ef01-4c2b-8937-ce3081b02164",
                "x": 1,
                "y": 0,
                "w": 3,
                "h": 5,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Interfaces",
                    "description": "",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[deviceInterfaces]}}",
                        "name": "deviceInterfaces",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [
                                [
                                    "name",
                                    "asc"
                                ]
                            ]
                        }
                    },
                    "scope": {
                        "scope": "{{scopes.[NetBox Devices]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[NetBox Device]}}"
                    },
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": [
                                    "name",
                                    "type.label",
                                    "enabled",
                                    "speed",
                                    "mode.label",
                                    "untagged_vlan.display",
                                    "connectedTo",
                                    "cabled",
                                    "mac_address",
                                    "count_ipaddresses",
                                    "description",
                                    "display_url"
                                ],
                                "hiddenColumns": [
                                    "device.name",
                                    "label",
                                    "mgmt_only",
                                    "mtu",
                                    "duplex.label",
                                    "lag.name",
                                    "parent.name",
                                    "taggedVlanCount",
                                    "vrf.name",
                                    "connected_endpoints_reachable",
                                    "last_updated"
                                ]
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "display_url",
                                        "title": "Interface",
                                        "renderer": {
                                            "type": "link",
                                            "labelField": "name"
                                        }
                                    },
                                    {
                                        "field": "type.label",
                                        "title": "Type",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "enabled",
                                        "title": "Enabled",
                                        "renderer": {
                                            "type": "boolean",
                                            "trueLabel": "Yes",
                                            "falseLabel": "No"
                                        },
                                        "align": "center"
                                    },
                                    {
                                        "field": "speed",
                                        "title": "Speed",
                                        "renderer": {
                                            "type": "number",
                                            "compact": true,
                                            "suffix": " Kbps"
                                        },
                                        "align": "right"
                                    },
                                    {
                                        "field": "mode.label",
                                        "title": "Mode",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "untagged_vlan.display",
                                        "title": "Untagged VLAN",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "connectedTo",
                                        "title": "Connected To",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "cabled",
                                        "title": "Cabled",
                                        "renderer": {
                                            "type": "boolean",
                                            "trueLabel": "Yes",
                                            "falseLabel": "No"
                                        },
                                        "align": "center"
                                    },
                                    {
                                        "field": "mac_address",
                                        "title": "MAC Address",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "count_ipaddresses",
                                        "title": "IPs",
                                        "renderer": {
                                            "type": "number"
                                        },
                                        "align": "right"
                                    },
                                    {
                                        "field": "description",
                                        "title": "Description",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    }
                                ]
                            }
                        }
                    },
                    "variables": [
                        "{{variables.[NetBox Device]}}"
                    ]
                }
            },
            {
                "i": "522b3b38-1fcd-455a-ab00-78544c606f98",
                "x": 0,
                "y": 5,
                "w": 4,
                "h": 3,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "IP Addresses",
                    "description": "",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[ipAddresses]}}",
                        "name": "ipAddresses",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "device": {
                                "variable": "{{variables.[NetBox Device]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[NetBox Devices]}}"
                            }
                        },
                        "sort": {
                            "by": [
                                [
                                    "address",
                                    "asc"
                                ]
                            ]
                        }
                    },
                    "variables": [
                        "{{variables.[NetBox Device]}}"
                    ],
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": [
                                    "address",
                                    "status.label",
                                    "vrfName",
                                    "dns_name",
                                    "assignedTo",
                                    "tenant.name",
                                    "description",
                                    "display_url"
                                ],
                                "hiddenColumns": [
                                    "display",
                                    "created",
                                    "family.label",
                                    "assigned",
                                    "role.label"
                                ]
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "display_url",
                                        "title": "Address",
                                        "renderer": {
                                            "type": "link",
                                            "labelField": "address"
                                        }
                                    },
                                    {
                                        "field": "status.label",
                                        "title": "Status",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "Active": "#2fb344",
                                                "Reserved": "#17a2b8",
                                                "Deprecated": "#d63939",
                                                "DHCP": "#2fb344",
                                                "SLAAC": "#2fb344"
                                            }
                                        }
                                    },
                                    {
                                        "field": "vrfName",
                                        "title": "VRF",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "dns_name",
                                        "title": "DNS Name",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "assignedTo",
                                        "title": "Assigned To",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "tenant.name",
                                        "title": "Tenant",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "description",
                                        "title": "Description",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    }
                                ]
                            }
                        }
                    }
                }
            },
            {
                "i": "20a1a299-769e-464d-8731-20eec0a996b7",
                "x": 0,
                "y": 8,
                "w": 4,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Change Log",
                    "description": "Changes recorded against this device",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[objectChanges]}}",
                        "name": "objectChanges",
                        "pluginConfigId": "{{configId}}",
                        "dataSourceConfig": {
                            "object": {
                                "variable": "{{variables.[NetBox Device]}}",
                                "workspace": "{{workspaceId}}",
                                "scope": "{{scopes.[NetBox Devices]}}"
                            }
                        },
                        "sort": {
                            "by": [
                                [
                                    "time",
                                    "desc"
                                ]
                            ]
                        }
                    },
                    "variables": [
                        "{{variables.[NetBox Device]}}"
                    ],
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": [
                                    "time",
                                    "user_name",
                                    "action.label",
                                    "object_repr",
                                    "message"
                                ],
                                "hiddenColumns": [
                                    "changed_object_type"
                                ]
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "time",
                                        "title": "Time",
                                        "renderer": {
                                            "type": "date",
                                            "relative": true
                                        }
                                    },
                                    {
                                        "field": "user_name",
                                        "title": "User",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "action.label",
                                        "title": "Action",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "Created": "#2fb344",
                                                "Updated": "#206bc4",
                                                "Deleted": "#d63939"
                                            }
                                        }
                                    },
                                    {
                                        "field": "object_repr",
                                        "title": "Object",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "message",
                                        "title": "Message",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    }
                                ]
                            }
                        }
                    }
                }
            }
        ]
    }
}
