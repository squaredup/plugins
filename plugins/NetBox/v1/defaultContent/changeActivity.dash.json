                    "title": "Objects Created",
                    "description": "",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "dataStream": {
                        "id": "{{dataStreams.[objectChanges]}}",
                        "name": "objectChanges",
                        "pluginConfigId": "{{configId}}",
                        "filter": {
                            "multiOperation": "and",
                            "filters": [
                                {
                                    "column": "action.value",
                                    "operation": "equals",
                                    "value": "create"
                                }
                            ]
                        },
                        "group": {
                            "by": [],
                            "aggregate": [
                                {
                                    "type": "count"
                                }
                            ]
                        }
                    },
                    "visualisation": {
                        "type": "data-stream-scalar",
                        "config": {
                            "data-stream-scalar": {
                                "value": "count",
                                "comparisonColumn": "none",
                                "label": "Created"
                            }
                        }
                    }
                }
            },
