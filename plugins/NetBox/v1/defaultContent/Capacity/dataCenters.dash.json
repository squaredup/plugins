                            "chartType": "bar",
                            "encoding": {
                                "x": {
                                    "field": "region.name_uniqueValues",
                                    "type": "nominal",
                                    "title": "Region"
                                },
                                "y": {
                                    "field": "count",
                                    "type": "quantitative",
                                    "title": "Sites"
                                }
                            },
                            "style": {
                                "cartesianHorizontal": true
                            }
                        }
                    }
