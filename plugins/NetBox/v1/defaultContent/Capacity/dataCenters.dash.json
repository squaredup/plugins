                "config": {
                    "_type": "tile/data-stream",
                    "title": "Site Map",
                    "description": "Sites plotted by latitude and longitude, coloured by status. Sites without coordinates are not shown.",
                    "activePluginConfigIds": [
                        "{{configId}}"
                    ],
                    "timeframe": "none",
                    "dataStream": {
                        "id": "{{dataStreams.[sites]}}",
                        "name": "sites",
                        "pluginConfigId": "{{configId}}",
                        "sort": {
                            "by": [
                                [
                                    "display",
                                    "asc"
                                ]
                            ]
                        }
                    },
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": [
                                    "display",
                                    "status.label",
                                    "region.name",
                                    "facility",
                                    "physical_address",
                                    "latitude",
                                    "longitude",
                                    "display_url"
                                ],
                                "hiddenColumns": [
                                    "group.name",
                                    "tenant.name",
                                    "time_zone",
                                    "device_count",
                                    "rack_count",
                                    "prefix_count",
                                    "vlan_count",
                                    "circuit_count",
                                    "virtualmachine_count",
                                    "description",
                                    "created",
                                    "last_updated"
                                ]
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "geoMap",
                            "encoding": {
                                "latitude": {
                                    "field": "latitude",
                                    "type": "quantitative",
                                    "title": "Latitude"
                                },
                                "longitude": {
                                    "field": "longitude",
                                    "type": "quantitative",
                                    "title": "Longitude"
                                },
                                "label": {
                                    "field": "display",
                                    "type": "nominal",
                                    "title": "Site"
                                },
                                "status": {
                                    "field": "status.value",
                                    "type": "nominal",
                                    "title": "Status"
                                },
                                "details": [
                                    {
                                        "field": "status.label",
                                        "type": "nominal",
                                        "title": "Status"
                                    },
                                    {
                                        "field": "region.name",
                                        "type": "nominal",
                                        "title": "Region"
                                    },
                                    {
                                        "field": "facility",
                                        "type": "nominal",
                                        "title": "Facility"
                                    },
                                    {
                                        "field": "tenant.name",
                                        "type": "nominal",
                                        "title": "Tenant"
                                    },
                                    {
                                        "field": "rack_count",
                                        "type": "quantitative",
                                        "title": "Racks"
                                    },
                                    {
                                        "field": "device_count",
                                        "type": "quantitative",
                                        "title": "Devices"
                                    }
                                ]
                            },
                            "style": {
                                "geoMapBase": "auto",
                                "geoMapStatusMap": {
                                    "active": "success",
                                    "planned": "unknown",
                                    "staging": "warning",
                                    "decommissioning": "warning",
                                    "retired": "unknown"
                                },
