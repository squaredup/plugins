                        "scope": "{{scopes.[NetBox Prefixes]}}",
                        "workspace": "{{workspaceId}}"
                    },
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": [
                                    "prefix",
                                    "vrf",
                                    "status",
                                    "size",
                                    "used",
                                    "utilization",
                                    "netboxUrl"
                                ],
                                "hiddenColumns": []
                            }
                        }
                    },
                    "vizSpec": {
                        "version": "1.0",
                        "visualization": {
                            "chartType": "richTable",
                            "encoding": {
                                "columns": [
                                    {
                                        "field": "netboxUrl",
                                        "title": "Prefix",
                                        "renderer": {
                                            "type": "link",
                                            "labelField": "prefix"
                                        }
                                    },
                                    {
                                        "field": "vrf",
                                        "title": "VRF",
                                        "renderer": {
                                            "type": "text"
                                        }
                                    },
                                    {
                                        "field": "status",
                                        "title": "Status",
                                        "renderer": {
                                            "type": "badge",
                                            "colors": {
                                                "Active": "#2fb344",
                                                "Container": "#9ba3af",
                                                "Reserved": "#17a2b8",
                                                "Deprecated": "#d63939"
                                            }
                                        }
                                    },
                                    {
                                        "field": "size",
                                        "title": "Size",
                                        "renderer": {
                                            "type": "number"
                                        },
                                        "align": "right"
                                    },
                                    {
                                        "field": "used",
                                        "title": "Used",
                                        "renderer": {
                                            "type": "number"
                                        },
                                        "align": "right"
                                    },
                                    {
                                        "field": "utilization",
                                        "title": "Utilization",
                                        "renderer": {
                                            "type": "progress",
                                            "max": 100
                                        }
                                    }
                                ]
                            },
                            "style": {
                                "richTableRowHighlight": {
                                    "field": "utilization",
                                    "thresholds": [
                                        {
                                            "to": 79.99,
                                            "color": "rgba(0,0,0,0)"
                                        },
                                        {
                                            "to": 89.99,
                                            "color": "rgba(245,158,11,0.12)"
                                        },
                                        {
                                            "to": 100,
                                            "color": "rgba(239,68,68,0.15)"
                                        }
                                    ]
                                }
                            }
                        }
                    }
                }
