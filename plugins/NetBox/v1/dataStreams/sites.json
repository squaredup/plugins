{
    "name": "sites",
    "displayName": "Sites",
    "description": "All sites with status, region, tenant and object counts",
    "tags": [
        "Inventory",
        "Network"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "api/dcim/sites/",
        "getArgs": [
            {
                "key": "fields",
                "value": "id,display,display_url,status,region,group,tenant,facility,time_zone,description,physical_address,latitude,longitude,device_count,rack_count,prefix_count,vlan_count,circuit_count,virtualmachine_count,created,last_updated,tags,custom_fields"
            },
            {
                "key": "id",
                "value": "{{ (typeof site !== 'undefined' && site && site.length) ? site.map(o => [].concat(o.rawId)[0]) : null }}"
            },
            {
                "key": "tag",
                "value": "{{ (typeof tag !== 'undefined' && tag && tag.length) ? [].concat(tag).flatMap(t => (t && typeof t === 'object') ? [t.value] : String(t).split(',')).map(t => String(t).trim()).filter(Boolean) : null }}"
            }
        ],
        "paging": {
            "mode": "offset",
            "pageSize": {
                "realm": "queryArg",
                "path": "limit",
                "value": "250"
            },
            "offset": {
                "mode": "row",
                "base": 0,
                "rowCountIn": {
                    "realm": "payloadArraySize",
                    "path": "results"
                }
            },
            "out": {
                "realm": "queryArg",
                "path": "offset"
            }
        },
        "pathToData": "results",
        "expandInnerObjects": true
    },
    "matches": "none",
    "ui": [
        {
            "type": "objects",
            "name": "site",
            "label": "Site(s) (optional)",
            "matches": {
                "sourceType": {
                    "type": "oneOf",
                    "values": [
                        "Site"
                    ]
                }
            }
        },
        {
            "type": "autocomplete",
            "name": "tag",
            "label": "Tag(s) (optional)",
            "help": "Returns only objects that have all the selected tags",
            "isMulti": true,
            "allowCustomValues": true,
            "data": {
                "source": "dataStream",
                "dataStreamName": "tags",
                "dataSourceConfig": {}
            }
        }
    ],
    "metadata": [
        {
            "name": "id",
            "visible": false
        },
        {
            "name": "display",
            "displayName": "Name",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "status.label",
            "displayName": "Status",
            "shape": "string"
        },
        {
            "name": "status.value",
            "visible": false
        },
        {
            "name": "region.name",
            "displayName": "Region",
            "shape": "string"
        },
        {
            "name": "group.name",
            "displayName": "Site Group",
            "shape": "string"
        },
        {
            "name": "tenant.name",
            "displayName": "Tenant",
            "shape": "string"
        },
        {
            "name": "facility",
            "displayName": "Facility",
            "shape": "string"
        },
        {
            "name": "time_zone",
            "displayName": "Time Zone",
            "shape": "string"
        },
        {
            "name": "physical_address",
            "displayName": "Address",
            "shape": "string"
        },
        {
            "name": "latitude",
            "displayName": "Latitude",
            "shape": "number"
        },
        {
            "name": "longitude",
            "displayName": "Longitude",
            "shape": "number"
        },
        {
            "name": "device_count",
            "displayName": "Devices",
            "shape": "number"
        },
        {
            "name": "rack_count",
            "displayName": "Racks",
            "shape": "number"
        },
        {
            "name": "prefix_count",
            "displayName": "Prefixes",
            "shape": "number"
        },
        {
            "name": "vlan_count",
            "displayName": "VLANs",
            "shape": "number"
        },
        {
            "name": "circuit_count",
            "displayName": "Circuits",
            "shape": "number"
        },
        {
            "name": "virtualmachine_count",
            "displayName": "Virtual Machines",
            "shape": "number"
        },
        {
            "name": "description",
            "displayName": "Description",
            "shape": "string"
        },
        {
            "name": "created",
            "displayName": "Created",
            "shape": "date"
        },
        {
            "name": "last_updated",
            "displayName": "Last Updated",
            "shape": "date"
        },
        {
            "pattern": "^tags[.].*",
            "visible": false
        },
        {
            "name": "tags.0.display",
            "displayName": "Tags",
            "shape": [
                "array",
                {
                    "itemShape": "string"
                }
            ],
            "valueExpression": "{{ (() => { const out = []; for (let i = 0; i < 100; i++) { const n = $['tags.' + i + '.name']; if (typeof n !== 'string' || !n) break; out.push(n); } return out.length ? JSON.stringify(out) : null; })() }}"
        },
        {
            "name": "display_url",
            "displayName": "Link",
            "shape": [
                "url",
                {
                    "label": "Open in NetBox"
                }
            ]
        },
        {
            "sourceId": "id",
            "sourceType": "Site",
            "name": "display"
        },
        {
            "pattern": "^custom_fields[.].*"
        }
    ],
    "timeframes": false
}
