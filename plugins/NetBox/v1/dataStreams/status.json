{
    "name": "status",
    "displayName": "Instance Status",
    "description": "NetBox version, installed plugins and background worker count for the connected instance",
    "tags": [
        "Status"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "api/status/"
    },
    "matches": "none",
    "metadata": [
        {
            "name": "netbox-version",
            "displayName": "NetBox Version",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "netbox-full-version",
            "displayName": "Full Version",
            "shape": "string"
        },
        {
            "name": "django-version",
            "displayName": "Django Version",
            "shape": "string"
        },
        {
            "name": "python-version",
            "displayName": "Python Version",
            "shape": "string"
        },
        {
            "name": "rq-workers-running",
            "displayName": "Workers Running",
            "shape": "number",
            "role": "value"
        },
        {
            "name": "hostname",
            "displayName": "Hostname",
            "shape": "string"
        },
        {
            "name": "plugins",
            "visible": false
        },
        {
            "name": "pluginCount",
            "displayName": "Plugins Installed",
            "computed": true,
            "valueExpression": "{{ Object.keys($['plugins'] || {}).length }}",
            "shape": "number"
        }
    ],
    "timeframes": false
}
