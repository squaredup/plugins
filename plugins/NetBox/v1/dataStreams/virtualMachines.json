{
    "name": "virtualMachines",
    "displayName": "Virtual Machines",
    "description": "All virtual machines with status, cluster, site, resources and primary IP",
    "tags": [
        "Inventory",
        "Virtualization"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "api/virtualization/virtual-machines/",
        "getArgs": [
            {
                "key": "fields",
                "value": "id,display,display_url,status,site,cluster,device,role,tenant,platform,primary_ip,vcpus,memory,disk,description,created,last_updated,tags,custom_fields"
            },
            {
                "key": "id",
                "value": "{{ (typeof virtualMachine !== 'undefined' && virtualMachine && virtualMachine.length) ? virtualMachine.map(o => [].concat(o.rawId)[0]) : null }}"
            },
            {
                "key": "site_id",
                "value": "{{ (typeof site !== 'undefined' && site && site.length) ? site.map(s => [].concat(s.rawId)[0]) : null }}"
            },
            {
                "key": "tag",
                "value": "{{ (typeof tag !== 'undefined' && tag && tag.length) ? [].concat(tag).flatMap(t => (t && typeof t === 'object') ? [t.value] : String(t).split(',')).map(t => String(t).trim()).filter(Boolean) : null }}"
            }
        ],
        "paging": {
            "mode": "offset",
            "pageSize": {
                "realm": "queryArg",
                "path": "limit",
                "value": "250"
            },
            "offset": {
                "mode": "row",
                "base": 0,
                "rowCountIn": {
                    "realm": "payloadArraySize",
                    "path": "results"
                }
            },
            "out": {
                "realm": "queryArg",
                "path": "offset"
            }
        },
        "pathToData": "results",
        "expandInnerObjects": true
    },
    "matches": "none",
    "ui": [
        {
            "type": "objects",
            "name": "virtualMachine",
            "label": "Virtual machine(s) (optional)",
            "matches": {
                "sourceType": {
                    "type": "oneOf",
                    "values": [
                        "Virtual Machine"
                    ]
                }
            }
        },
        {
            "type": "objects",
            "name": "site",
            "label": "Site (optional)",
            "matches": {
                "sourceType": {
                    "type": "oneOf",
                    "values": [
                        "Site"
                    ]
                }
            }
        },
        {
            "type": "autocomplete",
            "name": "tag",
            "label": "Tag(s) (optional)",
            "help": "Returns only objects that have all the selected tags",
            "isMulti": true,
            "allowCustomValues": true,
            "data": {
                "source": "dataStream",
                "dataStreamName": "tags",
                "dataSourceConfig": {}
            }
        }
    ],
    "metadata": [
        {
            "name": "id",
            "visible": false
        },
        {
            "name": "display",
            "displayName": "Name",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "status.label",
            "displayName": "Status",
            "shape": "string"
        },
        {
            "name": "status.value",
            "visible": false
        },
        {
            "name": "cluster.name",
            "displayName": "Cluster",
            "shape": "string"
        },
        {
            "name": "site.name",
            "displayName": "Site",
            "shape": "string"
        },
        {
            "name": "site.id",
            "visible": false
        },
        {
            "name": "site.url",
            "visible": false,
            "valueExpression": "{{ typeof $['site.id'] === 'number' ? String($['site.id']) : null }}"
        },
        {
            "name": "device.name",
            "displayName": "Host Device",
            "shape": "string"
        },
        {
            "name": "role.name",
            "displayName": "Role",
            "shape": "string"
        },
        {
            "name": "tenant.name",
            "displayName": "Tenant",
            "shape": "string"
        },
        {
            "name": "platform.name",
            "displayName": "Platform",
            "shape": "string"
        },
        {
            "name": "primary_ip.address",
            "visible": false
        },
        {
            "name": "primary_ip.display",
            "displayName": "Primary IP",
            "shape": "string",
            "valueExpression": "{{ typeof $['primary_ip.address'] === 'string' && $['primary_ip.address'] ? $['primary_ip.address'].split('/')[0] : null }}"
        },
        {
            "name": "vcpus",
            "displayName": "vCPUs",
            "shape": "number"
        },
        {
            "name": "memory",
            "displayName": "Memory",
            "shape": "megabytes"
        },
        {
            "name": "disk",
            "displayName": "Disk",
            "shape": "megabytes"
        },
        {
            "name": "description",
            "displayName": "Description",
            "shape": "string"
        },
        {
            "name": "created",
            "displayName": "Created",
            "shape": "date"
        },
        {
            "name": "last_updated",
            "displayName": "Last Updated",
            "shape": "date"
        },
        {
            "pattern": "^tags[.].*",
            "visible": false
        },
        {
            "name": "tags.0.display",
            "displayName": "Tags",
            "shape": [
                "array",
                {
                    "itemShape": "string"
                }
            ],
            "valueExpression": "{{ (() => { const out = []; for (let i = 0; i < 100; i++) { const n = $['tags.' + i + '.name']; if (typeof n !== 'string' || !n) break; out.push(n); } return out.length ? JSON.stringify(out) : null; })() }}"
        },
        {
            "name": "display_url",
            "displayName": "Link",
            "shape": [
                "url",
                {
                    "label": "Open in NetBox"
                }
            ]
        },
        {
            "sourceId": "id",
            "sourceType": "Virtual Machine",
            "name": "display"
        },
        {
            "pattern": "^custom_fields[.].*"
        }
    ],
    "timeframes": false
}
