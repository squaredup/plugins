{
    "name": "netbox",
    "displayName": "NetBox",
    "version": "1.0.0",
    "author": {
        "name": "@shawn149",
        "type": "community"
    },
    "description": "Visualize your NetBox inventory, IP address capacity, data quality, circuits and change activity.",
    "category": "Network",
    "type": "hybrid",
    "schemaVersion": "2.1",
    "importNotSupported": false,
    "restrictedToPlatforms": [],
    "keywords": [
        "netbox",
        "netbox labs",
        "source of truth",
        "dcim",
        "ipam",
        "network",
        "inventory",
        "data center",
        "racks",
        "prefixes",
        "circuits",
        "cmdb"
    ],
    "objectTypes": [
        "Site",
        "Rack",
        "Device",
        "Virtual Machine",
        "Prefix",
        "Circuit"
    ],
    "links": [
        {
            "category": "documentation",
            "url": "https://github.com/squaredup/plugins/blob/main/plugins/NetBox/v1/docs/README.md",
            "label": "Help adding this plugin"
        },
        {
            "category": "source",
            "url": "https://github.com/squaredup/plugins/tree/main/plugins/NetBox/v1",
            "label": "Repository"
        }
    ],
    "base": {
        "plugin": "WebAPI",
        "majorVersion": "1",
        "config": {
            "baseUrl": "{{ netboxUrl.trim().replace(/[/]+$/, '').replace(/[/]api$/i, '') }}",
            "authMode": "none",
            "headers": [
                {
                    "key": "Accept",
                    "value": "application/json"
                }
            ],
            "queryArgs": [],
            "ignoreCertificateErrors": "{{ignoreCertificateErrors}}",
            "showScripting": true,
            "scriptingVariables": [
                {
                    "key": "tokenVersion",
                    "value": "{{tokenVersion}}"
                },
                {
                    "key": "v1Token",
                    "value": "{{v1Token}}"
                },
                {
                    "key": "v2Token",
                    "value": "{{v2Token}}"
                },
                {
                    "key": "v2Key",
                    "value": "{{v2Key}}"
                }
            ],
            "preRequestScript": "preRequest.js"
        }
    }
}
