{
    "name": "alerts",
    "displayName": "Alerts",
    "description": "",
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "errorHandling": {
            "type": "default"
        },
        "paging": {
            "mode": "none"
        },
        "expandInnerObjects": true,
        "endpointPath": "v7/alerts",
        "getArgs": [
            {
                "key": "startDate",
                "value": "{{timeframe.start}}"
            },
            {
                "key": "endDate",
                "value": "{{timeframe.end}}"
            },
            {
                "key": "state",
                "value": "{{alertState}}"
            }
        ],
        "postRequestScript": "alerts-post.js",
        "headers": []
    },
    "providesPluginDiagnostics": true,
    "timeframes": [
        "last1hour",
        "last12hours",
        "last24hours",
        "last7days",
        "last30days",
        "thisMonth",
        "thisQuarter",
        "thisYear",
        "lastMonth",
        "lastQuarter",
        "lastYear"
    ],
    "tags": [],
    "ui": [
        {
            "isMulti": false,
            "data": {
                "source": "fixed",
                "values": [
                    {
                        "value": "trigger",
                        "label": "Trigger"
                    },
                    {
                        "value": "clear",
                        "label": "Clear"
                    },
                    {
                        "value": "",
                        "label": "All"
                    }
                ]
            },
            "defaultValue": "trigger",
            "name": "alertState",
            "label": "Alert State",
            "type": "autocomplete",
            "isClearable": false
        }
    ]
}