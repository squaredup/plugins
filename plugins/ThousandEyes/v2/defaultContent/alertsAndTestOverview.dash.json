            {
                "x": 0,
                "h": 2,
                "i": "1111b0cf-5013-4ff6-90b5-ba44338f752c",
                "y": 6,
                "config": {
                    "_type": "tile/data-stream",
                    "description": "",
                    "title": "SQL Query",
                    "dataStream": {
                        "dataSourceConfig": {
                            "version": "2.0",
                            "tables": [
                                {
                                    "config": {
                                        "timeframe": "none",
                                        "activePluginConfigIds": [
                                            "{{configId}}"
                                        ],
                                        "dataStream": {
                                            "name": "tests",
                                            "id": "{{dataStreams.tests}}",
                                            "pluginConfigId": "{{configId}}"
                                        }
                                    },
                                    "tableName": "dataset1"
                                },
                                {
                                    "config": {
                                        "activePluginConfigIds": [
                                            "{{configId}}"
                                        ],
                                        "dataStream": {
                                            "name": "alerts",
                                            "id": "{{dataStreams.alerts}}",
                                            "pluginConfigId": "{{configId}}"
                                        }
                                    },
                                    "tableName": "dataset2"
                                }
                            ],
                            "sql": "WITH\r\n    alert_counts AS (\r\n        SELECT\r\n            \"d1\".\"testId\" AS test_id,\r\n            \"d1\".\"testName\" AS test_name,\r\n            COUNT(\"d2\".\"id\") AS alert_count\r\n        FROM\r\n            \"dataset1\" \"d1\"\r\n            LEFT JOIN \"dataset2\" \"d2\" ON \"d1\".\"testId\" = \"d2\".\"testId\"\r\n        GROUP BY\r\n            \"d1\".\"testId\",\r\n            \"d1\".\"testName\"\r\n    )\r\nSELECT\r\n    \"test_id\",\r\n    \"test_name\",\r\n    \"alert_count\",\r\n    CASE\r\n        WHEN \"alert_count\" = 0 THEN 'No alerts'\r\n        ELSE CONCAT(\"alert_count\", ' alerts')\r\n    END as alert_subtitle,\r\n    CASE\r\n        WHEN \"alert_count\" = 0 THEN 'success'\r\n        ELSE 'error'\r\n    END AS status\r\nFROM\r\n    alert_counts\r\nORDER BY\r\n    status ASC"
                        },
                        "id": "datastream-sql"
                    },
                    "visualisation": {
                        "type": "data-stream-blocks",
                        "config": {
                            "data-stream-blocks": {
                                "stateColumn": "status",
                                "linkColumn": "none",
                                "sublabel": "alert_subtitle",
                                "labelColumn": "test_name"
                            }
                        }
                    }
                },
                "w": 4
            }
        ],
        "version": 14,
        "columns": 4
    }
