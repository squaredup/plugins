{
    "name": "streamFieldValues",
    "displayName": "Stream Field Values",
    "description": "Values of a log stream field in matching logs",
    "tags": [
        "Metadata"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "select/logsql/query",
        "getArgs": [
            {
                "key": "query",
                "value": "{{'(' + (query || '*') + ') | top ' + Math.min(Math.max(Number(limit) || 100, 1), 1000) + ' by (' + JSON.stringify(String(field).trim()) + ')'}}"
            },
            {
                "key": "start",
                "value": "{{timeframe.unixStart}}"
            },
            {
                "key": "end",
                "value": "{{Math.min(timeframe.unixEnd, Math.floor(Date.now() / 1000))}}"
            },
            {
                "key": "extra_filters",
                "value": "{{Array.isArray(scope) && scope.length ? ([...new Set(scope.flatMap(o => [].concat(o.selector || [])).filter(s => typeof s === 'string' && s.trim().startsWith('(') && s.indexOf('resource_attr:') < 0))].join(' or ') || '\"__squaredup_no_match__\":=\"1\"') : null}}"
            }
        ],
        "postRequestScript": "topValues.js",
        "paging": {
            "mode": "none"
        }
    },
    "ui": [
        {
            "type": "text",
            "name": "query",
            "label": "Query (optional)",
            "placeholder": "*",
            "help": "LogsQL filter selecting the logs to inspect."
        },
        {
            "type": "text",
            "name": "field",
            "label": "Field",
            "help": "Field name, e.g. `service.name`.",
            "validation": {
                "required": true
            }
        },
        {
            "type": "number",
            "name": "limit",
            "label": "Limit (optional)",
            "help": "Return the values with the most logs, up to 1,000.",
            "defaultValue": 100,
            "validation": {
                "min": 1,
                "max": {
                    "value": 1000,
                    "message": "At most 1,000 values can be returned"
                }
            }
        },
        {
            "type": "objects",
            "name": "scope",
            "label": "Objects (optional)",
            "help": "Only include logs from the selected objects. Leave empty to search all logs.",
            "matches": {
                "sourceName": {
                    "type": "equals",
                    "value": "VictoriaLogs"
                },
                "selector": {
                    "type": "any"
                }
            }
        }
    ],
    "manualConfigApply": true,
    "matches": "none",
    "metadata": [
        {
            "name": "label",
            "displayName": "Value",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "value",
            "displayName": "Value (raw)",
            "shape": "string",
            "role": "value",
            "visible": false
        },
        {
            "name": "hits",
            "displayName": "Logs",
            "shape": "number"
        }
    ],
    "timeframes": true,
    "visibility": {
        "type": "hidden"
    }
}
