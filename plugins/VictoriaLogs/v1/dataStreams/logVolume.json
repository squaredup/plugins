{
    "name": "logVolume",
    "displayName": "Log Volume",
    "description": "Number of logs matching a LogsQL query over time, optionally split by a field and limited to selected objects",
    "tags": [
        "Logs",
        "LogsQL"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "select/logsql/hits",
        "getArgs": [
            {
                "key": "query",
                "value": "{{query || '*'}}"
            },
            {
                "key": "start",
                "value": "{{timeframe.unixStart}}"
            },
            {
                "key": "end",
                "value": "{{Math.min(timeframe.unixEnd, Math.floor(Date.now() / 1000))}}"
            },
            {
                "key": "step",
                "value": "{{step || Math.max(60, Math.ceil((timeframe.unixEnd - timeframe.unixStart) / 120)) + 's'}}"
            },
            {
                "key": "field",
                "value": "{{field || null}}"
            },
            {
                "key": "fields_limit",
                "value": "{{field ? (fieldsLimit || 10) : null}}"
            },
            {
                "key": "extra_filters",
                "value": "{{Array.isArray(scope) && scope.length ? scope.map(o => [].concat(o.selector || [])[0]).filter(s => s).join(' or ') || null : null}}"
            }
        ],
        "postRequestScript": "logVolume.js",
        "paging": {
            "mode": "none"
        }
    },
    "ui": [
        {
            "type": "code",
            "name": "query",
            "label": "Query",
            "language": "sql",
            "defaultValue": "*",
            "help": "A LogsQL filter selecting the logs to count, e.g. `*` or `error`."
        },
        {
            "type": "objects",
            "name": "scope",
            "label": "Objects (optional)",
            "help": "Only include logs from the selected objects. Leave empty to search all logs.",
            "matches": {
                "sourceType": {
                    "type": "oneOf",
                    "values": [
                        "Kubernetes Cluster",
                        "Kubernetes Node",
                        "Kubernetes Namespace",
                        "Kubernetes Pod",
                        "Kubernetes Container",
                        "Kubernetes Deployment",
                        "Kubernetes StatefulSet",
                        "Kubernetes DaemonSet",
                        "Kubernetes ReplicaSet",
                        "Kubernetes Job",
                        "Kubernetes CronJob",
                        "Service",
                        "Host",
                        "Deployment Environment"
                    ]
                }
            }
        },
        {
            "type": "text",
            "name": "field",
            "label": "Split by field (optional)",
            "placeholder": "e.g. service.name",
            "help": "Count each value of this field separately."
        },
        {
            "type": "number",
            "name": "fieldsLimit",
            "label": "Top values",
            "defaultValue": 10,
            "help": "When splitting by a field, the number of values to keep; the rest are combined into one series."
        },
        {
            "type": "text",
            "name": "step",
            "label": "Step (optional)",
            "placeholder": "e.g. 5m",
            "help": "Bucket size. Defaults to about 120 buckets across the timeframe."
        }
    ],
    "manualConfigApply": true,
    "matches": "none",
    "metadata": [
        {
            "name": "timestamp",
            "displayName": "Timestamp",
            "shape": "date",
            "role": "timestamp"
        },
        {
            "name": "logs",
            "displayName": "Logs",
            "shape": "number",
            "role": "value"
        },
        {
            "name": "series",
            "displayName": "Series",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "ContainerLink",
            "displayName": "Container",
            "shape": "string",
            "sourceId": "ContainerLinkId",
            "sourceType": "Kubernetes Container"
        },
        {
            "name": "ContainerLinkId",
            "displayName": "Container ID",
            "shape": "string",
            "visible": false
        },
        {
            "name": "PodLink",
            "displayName": "Pod",
            "shape": "string",
            "sourceId": "PodLinkId",
            "sourceType": "Kubernetes Pod"
        },
        {
            "name": "PodLinkId",
            "displayName": "Pod ID",
            "shape": "string",
            "visible": false
        },
        {
            "name": "DeploymentLink",
            "displayName": "Deployment",
            "shape": "string",
            "sourceId": "DeploymentLinkId",
            "sourceType": "Kubernetes Deployment"
        },
        {
            "name": "DeploymentLinkId",
