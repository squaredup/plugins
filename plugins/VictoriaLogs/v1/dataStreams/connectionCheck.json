{
    "name": "connectionCheck",
    "displayName": "Connection Check",
    "description": "Number of stream fields seen in the last hour, used to validate the connection",
    "tags": [
        "Metadata"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "select/logsql/stream_field_names",
        "getArgs": [
            {
                "key": "query",
                "value": "*"
            },
            {
                "key": "start",
                "value": "1h"
            }
        ],
        "postRequestScript": "connectionCheck.js",
        "paging": {
            "mode": "none"
        }
    },
    "matches": "none",
    "metadata": [
        {
            "name": "connected",
            "displayName": "Connected",
            "shape": "boolean"
        },
        {
            "name": "streamFields",
            "displayName": "Stream fields",
            "shape": "number",
            "role": "value"
        }
    ],
    "timeframes": false,
    "visibility": {
        "type": "hidden"
    }
}
