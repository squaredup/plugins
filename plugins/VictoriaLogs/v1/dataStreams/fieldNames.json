{
    "name": "fieldNames",
    "displayName": "Field Names",
    "description": "Field names present in matching logs, with the number of logs containing each",
    "tags": [
        "Metadata"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "select/logsql/field_names",
        "getArgs": [
            {
                "key": "query",
                "value": "{{query || '*'}}"
            },
            {
                "key": "start",
                "value": "{{timeframe.unixStart}}"
            },
            {
                "key": "end",
                "value": "{{Math.min(timeframe.unixEnd, Math.floor(Date.now() / 1000))}}"
            },
            {
                "key": "extra_filters",
                "value": "{{Array.isArray(scope) && scope.length ? ([...new Set(scope.flatMap(o => [].concat(o.selector || [])).filter(s => typeof s === 'string' && s.trim().startsWith('(') && s.indexOf('resource_attr:') < 0))].join(' or ') || '\"__squaredup_no_match__\":=\"1\"') : null}}"
            }
        ],
        "postRequestScript": "values.js",
        "paging": {
            "mode": "none"
        }
    },
    "ui": [
        {
            "type": "text",
            "name": "query",
            "label": "Query (optional)",
            "placeholder": "*",
            "help": "LogsQL filter selecting the logs to inspect."
        },
        {
            "type": "objects",
            "name": "scope",
            "label": "Objects (optional)",
            "help": "Only include logs from the selected objects. Leave empty to search all logs.",
            "matches": {
                "sourceName": {
                    "type": "equals",
                    "value": "VictoriaLogs"
                },
                "selector": {
                    "type": "any"
                }
            }
        }
    ],
    "manualConfigApply": true,
    "matches": "none",
    "metadata": [
        {
            "name": "label",
            "displayName": "Value",
            "shape": "string",
            "role": "label"
        },
        {
            "name": "value",
            "displayName": "Value (raw)",
            "shape": "string",
            "role": "value",
            "visible": false
        },
        {
            "name": "hits",
            "displayName": "Logs",
            "shape": "number"
        }
    ],
    "timeframes": true,
    "visibility": {
        "type": "hidden"
    }
}
