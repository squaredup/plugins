{
    "name": "logs",
    "displayName": "Logs",
    "description": "Log entries matching a LogsQL query in the timeframe, newest first, optionally limited to selected objects",
    "tags": [
        "Logs",
        "LogsQL"
    ],
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "endpointPath": "select/logsql/query",
        "getArgs": [
            {
                "key": "query",
                "value": "{{query || '*'}}"
            },
            {
                "key": "limit",
                "value": "{{Math.min(Number(limit) || 200, 500)}}"
            },
            {
                "key": "start",
                "value": "{{timeframe.unixStart}}"
            },
            {
                "key": "end",
                "value": "{{Math.min(timeframe.unixEnd, Math.floor(Date.now() / 1000))}}"
            },
            {
                "key": "extra_filters",
                "value": "{{Array.isArray(scope) && scope.length ? ([...new Set(scope.flatMap(o => [].concat(o.selector || [])).filter(s => typeof s === 'string' && s.trim().startsWith('(') && s.indexOf('resource_attr:') < 0))].join(' or ') || '\"__squaredup_no_match__\":=\"1\"') : null}}"
            }
        ],
        "postRequestScript": "logs.js",
        "paging": {
            "mode": "none"
        }
    },
    "ui": [
        {
            "type": "code",
            "name": "query",
            "label": "Query",
            "language": "sql",
            "defaultValue": "*",
            "help": "A [LogsQL](https://docs.victoriametrics.com/victorialogs/logsql/) query, e.g. `error` or `service.name:=my-service level:in(error, warn)`. The tile's timeframe is applied automatically."
        },
        {
            "type": "objects",
            "name": "scope",
            "label": "Objects (optional)",
            "help": "Only include logs from the selected objects. Leave empty to search all logs.",
            "matches": {
                "sourceName": {
                    "type": "equals",
                    "value": "VictoriaLogs"
                },
                "selector": {
                    "type": "any"
                }
            }
        },
        {
            "type": "number",
            "name": "limit",
            "label": "Limit",
            "defaultValue": 200,
            "help": "Maximum number of log entries to return, newest first (up to 500).",
            "validation": {
                "min": 1,
                "max": {
                    "value": 500,
                    "message": "At most 500 log entries can be returned"
                }
            }
        },
        {
            "type": "text",
            "name": "columns",
            "label": "Columns (optional)",
            "placeholder": "e.g. trace_id, http.route",
            "help": "Comma-separated log fields to show as their own columns. All other fields are available in the **Fields** column."
        }
    ],
    "manualConfigApply": true,
    "matches": "none",
