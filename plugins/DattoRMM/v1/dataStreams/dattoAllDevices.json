{
    "name": "dattoAllDevices",
    "displayName": "Datto all devices",
    "baseDataSourceName": "httpRequestUnscoped",
    "config": {
        "httpMethod": "get",
        "paging": {
            "mode": "nextUrl",
            "pageSize": {
                "realm": {
                    "value": "none",
                    "label": "none"
                }
            },
            "in": {
                "realm": {
